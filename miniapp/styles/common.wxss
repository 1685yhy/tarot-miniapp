/* ============================================================
   柔光星辰 — Soft Starlight Design System
   Theme: Lying on grass, gazing at a starry night sky
   Target: Women 20-35, self-discovery, spiritual warmth
   Inspired by: Planetarium observatory, campfire glow,
   distant galaxies, cosmic intimacy
   ============================================================ */

/* -----------------------------------------------------------
   1. DESIGN TOKENS (CSS Custom Properties)
   ----------------------------------------------------------- */

page {
  /* --- Color Palette --- */
  --color-bg: #1A1A3E;
  --color-bg-gradient: linear-gradient(180deg, #1A1A3E 0%, #1E1E45 40%, #22224D 100%);
  --color-surface: #252550;
  --color-card: #2A2A5A;
  --color-card-hover: #313165;
  --color-card-border: rgba(244, 212, 140, 0.12);
  --color-card-border-hover: rgba(244, 212, 140, 0.25);
  --color-surface-hover: #2D2D60;
  --color-surface-gradient: linear-gradient(145deg, #252550 0%, #2A2A5A 100%);

  /* -- Accents -- */
  --color-gold: #F4D48C;
  --color-gold-light: #FADE9E;
  --color-gold-dark: #D4B06A;
  --color-gold-glow: rgba(244, 212, 140, 0.15);
  --color-gold-glow-strong: rgba(244, 212, 140, 0.30);
  --color-lavender: #B8A9E0;
  --color-lavender-light: #D0C4EE;
  --color-lavender-dark: #9A8CC8;
  --color-lavender-glow: rgba(184, 169, 224, 0.15);

  /* -- Text -- */
  --color-text-primary: #F0EDE8;
  --color-text-secondary: #B8A9E0;
  --color-text-tertiary: #A098C0;
  --color-text-inverse: #1A1A3E;
  --color-text-link: #F4D48C;
  --color-text-link-hover: #FADE9E;

  /* -- Status Colors -- */
  --color-success: #7BC6A0;
  --color-warning: #E8C87A;
  --color-error: #E87A8A;
  --color-info: #7AB8E8;
  --color-success-bg: rgba(123, 198, 160, 0.12);
  --color-warning-bg: rgba(232, 200, 122, 0.12);
  --color-error-bg: rgba(232, 122, 138, 0.12);
  --color-info-bg: rgba(122, 184, 232, 0.12);

  /* -- Overlay & Shadows -- */
  --color-overlay: rgba(10, 10, 30, 0.60);
  --color-overlay-light: rgba(10, 10, 30, 0.35);
  --shadow-card: 0 2rpx 8rpx rgba(0, 0, 0, 0.30), 0 0 30rpx rgba(244, 212, 140, 0.06);
  --shadow-elevated: 0 8rpx 40rpx rgba(0, 0, 0, 0.35), 0 0 60rpx rgba(244, 212, 140, 0.10);
  --shadow-glow-gold: 0 0 30rpx rgba(244, 212, 140, 0.15);
  --shadow-gold-button: 0 4rpx 20rpx rgba(244, 212, 140, 0.25);
  --shadow-card-press: 0 2rpx 12rpx rgba(0, 0, 0, 0.35), 0 0 40rpx rgba(244, 212, 140, 0.12);

  /* -- Typography Scale -- */
  --font-size-xs: 20rpx;            /* 极小文字 */
  --font-size-caption: 24rpx;       /* 从22调整为24 */
  --font-size-body: 30rpx;          /* 从28调整为30 */
  --font-size-subhead: 36rpx;       /* 从34调整为36 */
  --font-size-title: 44rpx;         /* 保持不变 */
  --font-size-display: 56rpx;       /* 从60调整为56 */
  --line-height-tight: 1.3;
  --line-height-base: 1.6;
  --line-height-loose: 1.7;
  --font-weight-normal: 400;
  --font-weight-medium: 500;
  --font-weight-semibold: 600;
  --font-weight-bold: 700;

  /* -- Spacing Scale -- */
  --spacing-xxs: 8rpx;
  --spacing-xs: 12rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 48rpx;
  --spacing-2xl: 64rpx;
  --spacing-3xl: 80rpx;
  --spacing-4xl: 96rpx;
  --spacing-5xl: 128rpx;

  /* -- Border Radius -- */
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-full: 50%;
  --radius-pill: 999rpx;

  /* -- Animation -- */
  --duration-instant: 0s;
  --duration-fast: 0.2s;
  --duration-base: 0.4s;
  --duration-slow: 0.6s;
  --duration-cosmic: 0.8s;
  --ease-in: cubic-bezier(0.4, 0, 1, 1);
  --ease-out: cubic-bezier(0, 0, 0.2, 1);
  --ease-in-out: cubic-bezier(0.4, 0, 0.2, 1);
  --ease-soft: cubic-bezier(0.25, 0.46, 0.45, 0.94);

  /* -- Layout -- */
  --page-padding: 32rpx;
  --page-padding-wide: 48rpx;
  --page-max-width: 750rpx;
  --safe-area-bottom: env(safe-area-inset-bottom, 0px);

  /* -- Z-Index Scale -- */
  --z-base: 1;
  --z-card: 10;
  --z-sticky: 100;
  --z-overlay: 500;
  --z-modal: 1000;
  --z-toast: 2000;

  /* --- Apply to page --- */
  background: var(--color-bg);
  background-image: var(--color-bg-gradient);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: var(--font-size-body);
  line-height: var(--line-height-base);
  color: var(--color-text-primary);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* -----------------------------------------------------------
   2. STARFIELD — Decorative twinkling dots
   ----------------------------------------------------------- */

.starfield {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  overflow: hidden;
  z-index: 0;
}

.star {
  position: absolute;
  width: 3rpx;
  height: 3rpx;
  background: rgba(244, 212, 140, 0.60);
  border-radius: var(--radius-pill);
  animation: star-twinkle 4s ease-in-out infinite;
}

.star--dim {
  width: 2rpx;
  height: 2rpx;
  background: rgba(184, 169, 224, 0.40);
  animation-duration: 5s;
  animation-delay: -1s;
}

.star--bright {
  width: 4rpx;
  height: 4rpx;
  background: rgba(244, 212, 140, 0.85);
  animation-duration: 3s;
  animation-delay: -2s;
  box-shadow: 0 0 6rpx rgba(244, 212, 140, 0.30);
}

@keyframes star-twinkle {
  0%,
  100% {
    opacity: 0.30;
    transform: scale(1);
  }
  30% {
    opacity: 0.15;
    transform: scale(0.80);
  }
  60% {
    opacity: 0.55;
    transform: scale(1.10);
  }
}


/* -----------------------------------------------------------
   3. RADIAL GLOW — Hero backdrop
   ----------------------------------------------------------- */

.glow-hero {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 500rpx;
  height: 500rpx;
  margin-left: -250rpx;
  margin-top: -250rpx;
  background: radial-gradient(
    circle at center,
    rgba(244, 212, 140, 0.10) 0%,
    rgba(244, 212, 140, 0.04) 30%,
    transparent 70%
  );
  pointer-events: none;
  z-index: 0;
}

.glow-hero--lavender {
  background: radial-gradient(
    circle at center,
    rgba(184, 169, 224, 0.10) 0%,
    rgba(184, 169, 224, 0.04) 30%,
    transparent 70%
  );
}

.glow-bottom {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 300rpx;
  background: linear-gradient(
    to top,
    rgba(244, 212, 140, 0.06) 0%,
    transparent 100%
  );
  pointer-events: none;
  z-index: 0;
}

/* -----------------------------------------------------------
   4. TYPOGRAPHY
   ----------------------------------------------------------- */

.heading-1 {
  font-size: var(--font-size-display);
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
  line-height: var(--line-height-tight);
  letter-spacing: 2rpx;
}

.heading-2 {
  font-size: var(--font-size-title);
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
  line-height: var(--line-height-tight);
  letter-spacing: 1rpx;
}

.heading-3 {
  font-size: var(--font-size-subhead);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  line-height: var(--line-height-base);
  letter-spacing: 1rpx;
}

.heading-4 {
  font-size: var(--font-size-subhead);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  line-height: var(--line-height-base);
  letter-spacing: 1rpx;
}

.title-lg {
  font-size: var(--font-size-title);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  line-height: var(--line-height-tight);
}

.title-md {
  font-size: var(--font-size-subhead);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  line-height: var(--line-height-tight);
}

.body-text {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-normal);
  color: var(--color-text-primary);
  line-height: var(--line-height-loose);
}

.body-text--secondary {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-normal);
  color: var(--color-text-secondary);
  line-height: var(--line-height-loose);
}

.body-small {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-normal);
  color: var(--color-text-secondary);
  line-height: var(--line-height-base);
}

.caption {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-normal);
  color: var(--color-text-tertiary);
  line-height: var(--line-height-base);
  letter-spacing: 1rpx;
}

.label {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  line-height: var(--line-height-tight);
}

/* --- Number / Data Highlight --- */
.number-gold {
  font-size: var(--font-size-title);
  font-weight: var(--font-weight-bold);
  color: var(--color-gold);
  line-height: var(--line-height-tight);
  text-shadow: 0 0 20rpx rgba(244, 212, 140, 0.15);
}

.number-gold-lg {
  font-size: var(--font-size-display);
  font-weight: var(--font-weight-bold);
  color: var(--color-gold);
  line-height: var(--line-height-tight);
  text-shadow: 0 0 20rpx rgba(244, 212, 140, 0.15);
}

.number-lavender {
  font-size: var(--font-size-title);
  font-weight: var(--font-weight-bold);
  color: var(--color-lavender);
  line-height: var(--line-height-tight);
}

/* --- Decorative dividers --- */
.divider {
  height: 1rpx;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(244, 212, 140, 0.20) 15%,
    rgba(244, 212, 140, 0.30) 50%,
    rgba(244, 212, 140, 0.20) 85%,
    transparent 100%
  );
  margin: var(--spacing-lg) 0;
  border: none;
}

.divider--lavender {
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(184, 169, 224, 0.20) 15%,
    rgba(184, 169, 224, 0.30) 50%,
    rgba(184, 169, 224, 0.20) 85%,
    transparent 100%
  );
}

.divider--vertical {
  width: 1rpx;
  height: 100%;
  background: linear-gradient(
    180deg,
    transparent 0%,
    rgba(244, 212, 140, 0.20) 20%,
    rgba(244, 212, 140, 0.30) 50%,
    rgba(244, 212, 140, 0.20) 80%,
    transparent 100%
  );
  margin: 0 var(--spacing-md);
  border: none;
}

/* -----------------------------------------------------------
   5. BUTTONS
   ----------------------------------------------------------- */

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-medium);
  line-height: var(--line-height-tight);
  border-radius: var(--radius-pill);
  padding: 24rpx 48rpx;
  transition: all var(--duration-fast) var(--ease-out);
  position: relative;
  overflow: hidden;
}

/* Primary — Golden glow */
.btn-primary {
  background: linear-gradient(135deg, #F4D48C 0%, #E8C67A 50%, #D4B06A 100%);
  color: var(--color-text-inverse);
  box-shadow: var(--shadow-gold-button);
}

.btn-primary:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 12rpx rgba(244, 212, 140, 0.20);
  opacity: 0.92;
}

.btn-primary--disabled,
.btn-primary[disabled] {
  background: rgba(244, 212, 140, 0.20);
  color: rgba(26, 26, 62, 0.35);
  box-shadow: none;
  pointer-events: none;
}

/* Secondary — Lavender outline */
.btn-secondary {
  background: transparent;
  color: var(--color-lavender);
  border: 1rpx solid rgba(184, 169, 224, 0.35);
  box-shadow: none;
}

.btn-secondary:active {
  background: rgba(184, 169, 224, 0.08);
  border-color: rgba(184, 169, 224, 0.55);
  transform: scale(0.97);
}

.btn-secondary--disabled,
.btn-secondary[disabled] {
  border-color: rgba(184, 169, 224, 0.12);
  color: rgba(184, 169, 224, 0.30);
  pointer-events: none;
}

/* Ghost — Subtle text button */
.btn-ghost {
  background: transparent;
  color: var(--color-text-secondary);
  border: none;
  padding: 16rpx 24rpx;
  min-height: 88rpx;
  box-shadow: none;
}

.btn-ghost:active {
  color: var(--color-gold);
  background: rgba(244, 212, 140, 0.06);
}

/* Special — Glowing gold outline */
.btn-glow {
  background: transparent;
  color: var(--color-gold);
  border: 1rpx solid rgba(244, 212, 140, 0.30);
  box-shadow: 0 0 20rpx rgba(244, 212, 140, 0.08);
}

.btn-glow:active {
  background: rgba(244, 212, 140, 0.08);
  border-color: rgba(244, 212, 140, 0.50);
  box-shadow: 0 0 30rpx rgba(244, 212, 140, 0.15);
  transform: scale(0.97);
}

/* Variants */
.btn--full {
  width: 100%;
}

.btn--sm {
  font-size: var(--font-size-caption);
  padding: 16rpx 32rpx;
  min-height: 88rpx;
}

.btn--lg {
  font-size: var(--font-size-subhead);
  padding: 32rpx 48rpx;
}

.btn--icon {
  padding: 24rpx;
  min-width: 88rpx;
  min-height: 88rpx;
  border-radius: var(--radius-pill);
}

/* -----------------------------------------------------------
   6. CARDS
   ----------------------------------------------------------- */

.card {
  background: var(--color-surface-gradient);
  border: 1.5rpx solid rgba(244, 212, 140, 0.12);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  box-shadow: var(--shadow-card);
  transition: all var(--duration-fast) var(--ease-out);
  position: relative;
  overflow: hidden;
}

/* Subtle inset highlight — premium surface depth */
.card::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.04), transparent);
  pointer-events: none;
  border-radius: var(--radius-md) var(--radius-md) 0 0;
}

.card:active {
  background: var(--color-card-hover);
  border-color: rgba(244, 212, 140, 0.20);
  box-shadow: var(--shadow-card-press);
  transform: scale(0.97);
}

.card--glass {
  background: linear-gradient(145deg, rgba(37, 37, 80, 0.70) 0%, rgba(42, 42, 90, 0.70) 100%);
  border: 1.5rpx solid rgba(244, 212, 140, 0.15);
}

.card--elevated {
  background: var(--color-surface-gradient);
  box-shadow: var(--shadow-elevated);
}

.card--glow {
  border-color: rgba(244, 212, 140, 0.25);
  box-shadow: var(--shadow-card), 0 0 30rpx rgba(244, 212, 140, 0.08);
}

.card--compact {
  padding: var(--spacing-sm);
}

.card--spacious {
  padding: var(--spacing-lg);
}

.card--no-pad {
  padding: 0;
}

/* Card header */
.card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-sm);
}

.card__title {
  font-size: var(--font-size-subhead);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.card__subtitle {
  font-size: var(--font-size-caption);
  color: var(--color-text-secondary);
  margin-top: var(--spacing-xxs);
}

.card__body {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  line-height: var(--line-height-loose);
}

.card__footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: var(--spacing-sm);
  padding-top: var(--spacing-sm);
  border-top: 1rpx solid rgba(244, 212, 140, 0.08);
}

/* -----------------------------------------------------------
   7. FORM ELEMENTS
   ----------------------------------------------------------- */

.input-wrapper {
  position: relative;
  width: 100%;
}

.input {
  width: 100%;
  height: 88rpx;
  background: var(--color-surface);
  border: 1rpx solid rgba(244, 212, 140, 0.12);
  border-radius: var(--radius-md);
  padding: 0 var(--spacing-md);
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  line-height: var(--line-height-tight);
  transition: all var(--duration-fast) var(--ease-soft);
  box-sizing: border-box;
}

.input::placeholder {
  color: var(--color-text-tertiary);
}

.input:focus {
  border-color: rgba(244, 212, 140, 0.40);
  box-shadow: 0 0 0 2rpx rgba(244, 212, 140, 0.08);
  background: var(--color-surface);
}

.input--error {
  border-color: rgba(232, 122, 138, 0.40);
  box-shadow: 0 0 0 2rpx rgba(232, 122, 138, 0.08);
}

.input--success {
  border-color: rgba(123, 198, 160, 0.40);
  box-shadow: 0 0 0 2rpx rgba(123, 198, 160, 0.08);
}

.input--textarea {
  height: 200rpx;
  padding: var(--spacing-md);
  line-height: var(--line-height-loose);
}

.input--pill {
  border-radius: var(--radius-pill);
  padding-left: var(--spacing-lg);
  padding-right: var(--spacing-lg);
}

.input-label {
  display: block;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-xs);
}

.input-hint {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  margin-top: var(--spacing-xxs);
  line-height: var(--line-height-base);
}

.input-hint--error {
  color: var(--color-error);
}

/* --- Select / Picker --- */
.picker {
  width: 100%;
  height: 88rpx;
  background: var(--color-surface);
  border: 1rpx solid rgba(244, 212, 140, 0.12);
  border-radius: var(--radius-md);
  padding: 0 var(--spacing-md);
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  line-height: 88rpx;
  transition: all var(--duration-fast) var(--ease-soft);
  box-sizing: border-box;
  position: relative;
}

.picker:active {
  background: var(--color-surface);
  border-color: rgba(244, 212, 140, 0.30);
}

.picker--placeholder {
  color: var(--color-text-tertiary);
}

/* --- Checkbox / Radio --- */
.check-group {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
}

.check-item {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  min-height: 88rpx;
  background: var(--color-surface);
  border: 1rpx solid rgba(244, 212, 140, 0.10);
  border-radius: var(--radius-pill);
  font-size: var(--font-size-caption);
  color: var(--color-text-secondary);
  transition: all var(--duration-fast) var(--ease-soft);
}

.check-item:active {
  border-color: rgba(244, 212, 140, 0.35);
  color: var(--color-text-primary);
}

.check-item--active {
  background: rgba(244, 212, 140, 0.10);
  border-color: rgba(244, 212, 140, 0.35);
  color: var(--color-gold);
}

/* -----------------------------------------------------------
   8. LAYOUT & CONTAINERS
   ----------------------------------------------------------- */

.page {
  min-height: 100vh;
  padding: var(--page-padding);
  padding-bottom: calc(var(--page-padding) + var(--safe-area-bottom));
  position: relative;
  z-index: var(--z-base);
  background: var(--color-bg);
  background-image: var(--color-bg-gradient);
}

.page--wide {
  padding-left: var(--page-padding-wide);
  padding-right: var(--page-padding-wide);
}

.page--no-pad {
  padding: 0;
}

.section {
  margin-bottom: var(--spacing-xl);
}

.section--last {
  margin-bottom: 0;
}

.section__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-md);
}

.section__title {
  font-size: var(--font-size-subhead);
  font-weight: var(--font-weight-semibold);
  color: var(--color-gold);
  letter-spacing: 1rpx;
}

.section__action {
  font-size: var(--font-size-caption);
  color: var(--color-gold);
  font-weight: var(--font-weight-medium);
}

.section__action:active {
  opacity: 0.70;
}

/* --- Grid / Flex Utilities --- */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-wrap {
  flex-wrap: wrap;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-around {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.flex-1 {
  flex: 1;
}

.gap-xs {
  gap: var(--spacing-xs);
}

.gap-sm {
  gap: var(--spacing-sm);
}

.gap-md {
  gap: var(--spacing-md);
}

.gap-lg {
  gap: var(--spacing-lg);
}

/* --- Grid (2-column) --- */
.grid-2 {
  display: flex;
  flex-flow: row wrap;
  margin: calc(-1 * var(--spacing-xs));
}

.grid-2 > view {
  width: calc(50% - var(--spacing-xs) * 2);
  margin: var(--spacing-xs);
}

/* --- Hero Area --- */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: var(--spacing-3xl) var(--spacing-md);
  position: relative;
  min-height: 400rpx;
}

.hero__title {
  font-size: var(--font-size-display);
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
  line-height: var(--line-height-tight);
  letter-spacing: 3rpx;
  margin-bottom: var(--spacing-sm);
  text-shadow: 0 0 40rpx rgba(244, 212, 140, 0.08);
}

.hero__subtitle {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  line-height: var(--line-height-loose);
  max-width: 600rpx;
}

.hero__accent {
  color: var(--color-gold);
}

.hero__icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: var(--spacing-lg);
  opacity: 0.85;
}

/* -----------------------------------------------------------
   9. NAVIGATION
   ----------------------------------------------------------- */

/* Bottom Tab Bar */
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: calc(100rpx + var(--safe-area-bottom));
  padding-bottom: var(--safe-area-bottom);
  background: rgba(37, 37, 80, 0.92);
  border-top: 1rpx solid rgba(244, 212, 140, 0.08);
  z-index: var(--z-sticky);
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 100%;
  padding: 8rpx 0;
  position: relative;
}

.tab-item__icon {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 8rpx;
  opacity: 0.45;
  transition: all var(--duration-fast) var(--ease-soft);
}

.tab-item__label {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  line-height: 1.2;
  transition: all var(--duration-fast) var(--ease-soft);
}

.tab-item--active .tab-item__icon {
  opacity: 1;
}

.tab-item--active .tab-item__label {
  color: var(--color-gold);
  font-weight: var(--font-weight-medium);
}

.tab-item--active::after {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  width: 40rpx;
  height: 3rpx;
  background: var(--color-gold);
  border-radius: var(--radius-sm);
  margin-left: -20rpx;
  box-shadow: 0 0 10rpx rgba(244, 212, 140, 0.30);
}

/* Nav Bar (top) */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 var(--page-padding);
  position: relative;
  z-index: var(--z-sticky);
}

.nav-bar__title {
  font-size: var(--font-size-subhead);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
}

.nav-bar__back {
  display: flex;
  align-items: center;
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  padding: 20rpx 16rpx;
  min-height: 88rpx;
}

.nav-bar__back:active {
  color: var(--color-gold);
}

.nav-bar__right {
  display: flex;
  align-items: center;
  gap: var(--spacing-xs);
}

/* -----------------------------------------------------------
   10. TOASTS & NOTIFICATIONS
   ----------------------------------------------------------- */

.toast {
  position: fixed;
  top: 120rpx;
  left: 50%;
  transform: translateX(-50%);
  min-width: 200rpx;
  max-width: 600rpx;
  padding: 24rpx 32rpx;
  background: var(--color-card);
  border: 1rpx solid rgba(244, 212, 140, 0.20);
  border-radius: var(--radius-pill);
  font-size: var(--font-size-caption);
  color: var(--color-text-primary);
  text-align: center;
  box-shadow: var(--shadow-elevated);
  z-index: var(--z-toast);
}

.toast--success {
  border-color: rgba(123, 198, 160, 0.30);
  color: var(--color-success);
}

.toast--error {
  border-color: rgba(232, 122, 138, 0.30);
  color: var(--color-error);
}

/* Badge / Tag */
.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 16rpx;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-medium);
  line-height: 1.2;
  border-radius: var(--radius-pill);
  color: var(--color-text-primary);
  background: var(--color-surface);
  border: 1rpx solid rgba(244, 212, 140, 0.15);
}

.badge--gold {
  background: rgba(244, 212, 140, 0.12);
  color: var(--color-gold);
  border-color: rgba(244, 212, 140, 0.20);
}

.badge--lavender {
  background: rgba(184, 169, 224, 0.12);
  color: var(--color-lavender);
  border-color: rgba(184, 169, 224, 0.20);
}

.badge--success {
  background: var(--color-success-bg);
  color: var(--color-success);
  border-color: transparent;
}

.badge--warning {
  background: var(--color-warning-bg);
  color: var(--color-warning);
  border-color: transparent;
}

.badge--error {
  background: var(--color-error-bg);
  color: var(--color-error);
  border-color: transparent;
}

.badge--dot {
  width: 12rpx;
  height: 12rpx;
  padding: 0;
  border-radius: var(--radius-pill);
  min-width: 0;
}

.badge--dot.badge--gold {
  box-shadow: 0 0 6rpx rgba(244, 212, 140, 0.40);
}

/* -----------------------------------------------------------
   11. LIST / MENU ITEMS
   ----------------------------------------------------------- */

.list-item {
  display: flex;
  align-items: center;
  padding: var(--spacing-md);
  background: var(--color-surface-gradient);
  border: 1.5rpx solid rgba(244, 212, 140, 0.12);
  border-radius: var(--radius-md);
  transition: all var(--duration-fast) var(--ease-out);
}

.list-item:active {
  background: var(--color-card-hover);
  border-color: rgba(244, 212, 140, 0.20);
  transform: scale(0.97);
}

.list-item + .list-item {
  margin-top: var(--spacing-xs);
}

.list-item__icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: var(--spacing-sm);
  flex-shrink: 0;
}

.list-item__content {
  flex: 1;
  min-width: 0;
}

.list-item__title {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  line-height: var(--line-height-tight);
}

.list-item__desc {
  font-size: var(--font-size-caption);
  color: var(--color-text-secondary);
  line-height: var(--line-height-base);
  margin-top: 4rpx;
}

.list-item__right {
  flex-shrink: 0;
  margin-left: var(--spacing-sm);
}

.list-item__arrow {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.30;
}

/* -----------------------------------------------------------
   12. LOADING & EMPTY STATES
   ----------------------------------------------------------- */

.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-3xl) 0;
}

.loading__spinner {
  width: 64rpx;
  height: 64rpx;
  border: 3rpx solid rgba(244, 212, 140, 0.10);
  border-top-color: var(--color-gold);
  border-radius: var(--radius-pill);
  animation: spin 0.6s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading__text {
  margin-top: var(--spacing-md);
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
}

/* Skeleton */
.skeleton {
  background: linear-gradient(
    90deg,
    var(--color-surface) 25%,
    var(--color-surface) 37%,
    var(--color-surface) 63%
  );
  background-size: 400% 100%;
  animation: shimmer-sweep 1.8s ease-in-out infinite;
  border-radius: var(--radius-sm);
}

@keyframes shimmer-sweep {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}

.skeleton--text {
  height: 28rpx;
  width: 100%;
  margin-bottom: var(--spacing-xs);
}

.skeleton--title {
  height: 36rpx;
  width: 60%;
  margin-bottom: var(--spacing-sm);
}

.skeleton--avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-pill);
}

.skeleton--card {
  height: 200rpx;
  border-radius: var(--radius-md);
}

/* 新增变体 */
.skeleton--circle {
  width: 100rpx; height: 100rpx;
  border-radius: 50%;
}
.skeleton--block {
  height: 200rpx;
  border-radius: var(--radius-md);
}
.skeleton--text-sm {
  height: 24rpx;
  width: 100%;
  margin-bottom: var(--spacing-xs);
}
.skeleton--text-lg {
  height: 36rpx;
  width: 100%;
  margin-bottom: var(--spacing-sm);
}
.skeleton--btn {
  height: 80rpx;
  width: 200rpx;
  border-radius: var(--radius-pill);
}
.skeleton--card-sm {
  height: 140rpx;
  border-radius: var(--radius-md);
}

/* Empty State */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-4xl) var(--spacing-lg);
  text-align: center;
}

.empty__icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: var(--spacing-lg);
  opacity: 0.40;
}

.empty__title {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-secondary);
  margin-bottom: var(--spacing-xs);
}

.empty__desc {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  line-height: var(--line-height-base);
  max-width: 500rpx;
}

/* -----------------------------------------------------------
   13. MODAL & OVERLAY
   ----------------------------------------------------------- */

.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--color-overlay);
  z-index: var(--z-overlay);
}

.modal {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--color-surface);
  border-radius: var(--radius-md) var(--radius-md) 0 0;
  z-index: var(--z-modal);
  padding: var(--spacing-lg) var(--page-padding) calc(var(--spacing-xl) + var(--safe-area-bottom));
  padding-bottom: calc(var(--spacing-xl) + var(--safe-area-bottom));
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.30);
}

.modal--center {
  top: 50%;
  bottom: auto;
  left: 50%;
  right: auto;
  width: 600rpx;
  border-radius: var(--radius-md);
  padding: var(--spacing-xl);
  padding-bottom: var(--spacing-xl);
}

.modal__handle {
  width: 64rpx;
  height: 6rpx;
  background: rgba(106, 101, 136, 0.35);
  border-radius: var(--radius-pill);
  margin: 0 auto var(--spacing-md);
}

.modal__header {
  text-align: center;
  margin-bottom: var(--spacing-md);
}

.modal__title {
  font-size: var(--font-size-title);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.modal__body {
  margin-bottom: var(--spacing-lg);
}

.modal__footer {
  display: flex;
  gap: var(--spacing-sm);
}

/* -----------------------------------------------------------
   14. AVATAR
   ----------------------------------------------------------- */

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-pill);
  border: 2rpx solid rgba(244, 212, 140, 0.15);
  overflow: hidden;
  flex-shrink: 0;
  background: var(--color-surface);
}

.avatar--sm {
  width: 56rpx;
  height: 56rpx;
}

.avatar--lg {
  width: 120rpx;
  height: 120rpx;
}

.avatar--glow {
  border-color: rgba(244, 212, 140, 0.30);
  box-shadow: 0 0 16rpx rgba(244, 212, 140, 0.12);
}

.avatar--ring {
  border-width: 3rpx;
  border-color: var(--color-gold);
  box-shadow: 0 0 20rpx rgba(244, 212, 140, 0.15);
}

/* -----------------------------------------------------------
   15. PROGRESS BAR
   ----------------------------------------------------------- */

.progress {
  width: 100%;
  height: 8rpx;
  background: rgba(106, 101, 136, 0.20);
  border-radius: var(--radius-pill);
  overflow: hidden;
}

.progress__fill {
  height: 100%;
  background: linear-gradient(90deg, var(--color-gold-dark) 0%, var(--color-gold) 50%, var(--color-gold-light) 100%);
  border-radius: var(--radius-pill);
  transition: width var(--duration-slow) var(--ease-out);
  box-shadow: 0 0 10rpx rgba(244, 212, 140, 0.15);
}

.progress--lavender .progress__fill {
  background: linear-gradient(90deg, var(--color-lavender-dark) 0%, var(--color-lavender) 50%, var(--color-lavender-light) 100%);
  box-shadow: 0 0 10rpx rgba(184, 169, 224, 0.15);
}

/* -----------------------------------------------------------
   16. PAGE TRANSITIONS
   ----------------------------------------------------------- */

@keyframes fade-up {
  0% {
    opacity: 0;
    transform: translateY(24rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fade-in {
  0% { opacity: 0; }
  100% { opacity: 1; }
}

.anim-fade-up {
  animation: fade-up var(--duration-base) var(--ease-soft) forwards;
}

.anim-fade-in {
  animation: fade-in var(--duration-base) var(--ease-soft) forwards;
}

/* Staggered children — manual classes for simplicity */
.anim-stagger-1 { animation-delay: 0.05s; }
.anim-stagger-2 { animation-delay: 0.10s; }
.anim-stagger-3 { animation-delay: 0.15s; }
.anim-stagger-4 { animation-delay: 0.20s; }
.anim-stagger-5 { animation-delay: 0.25s; }
.anim-stagger-6 { animation-delay: 0.30s; }
.anim-stagger-7 { animation-delay: 0.35s; }
.anim-stagger-8 { animation-delay: 0.40s; }
.anim-stagger-9 { animation-delay: 0.45s; }
.anim-stagger-10 { animation-delay: 0.50s; }

/* -----------------------------------------------------------
   17. SPACING UTILITIES
   ----------------------------------------------------------- */

.mt-xxs { margin-top: var(--spacing-xxs); }
.mt-xs { margin-top: var(--spacing-xs); }
.mt-sm { margin-top: var(--spacing-sm); }
.mt-md { margin-top: var(--spacing-md); }
.mt-lg { margin-top: var(--spacing-lg); }
.mt-xl { margin-top: var(--spacing-xl); }
.mt-2xl { margin-top: var(--spacing-2xl); }

.mb-xxs { margin-bottom: var(--spacing-xxs); }
.mb-xs { margin-bottom: var(--spacing-xs); }
.mb-sm { margin-bottom: var(--spacing-sm); }
.mb-md { margin-bottom: var(--spacing-md); }
.mb-lg { margin-bottom: var(--spacing-lg); }
.mb-xl { margin-bottom: var(--spacing-xl); }
.mb-2xl { margin-bottom: var(--spacing-2xl); }

.pt-xxs { padding-top: var(--spacing-xxs); }
.pt-xs { padding-top: var(--spacing-xs); }
.pt-sm { padding-top: var(--spacing-sm); }
.pt-md { padding-top: var(--spacing-md); }
.pt-lg { padding-top: var(--spacing-lg); }
.pt-xl { padding-top: var(--spacing-xl); }

.pb-xxs { padding-bottom: var(--spacing-xxs); }
.pb-xs { padding-bottom: var(--spacing-xs); }
.pb-sm { padding-bottom: var(--spacing-sm); }
.pb-md { padding-bottom: var(--spacing-md); }
.pb-lg { padding-bottom: var(--spacing-lg); }
.pb-xl { padding-bottom: var(--spacing-xl); }

.p-sm { padding: var(--spacing-sm); }
.p-md { padding: var(--spacing-md); }
.p-lg { padding: var(--spacing-lg); }
.p-xl { padding: var(--spacing-xl); }

/* -----------------------------------------------------------
   18. TEXT ALIGNMENT & STYLING
   ----------------------------------------------------------- */

.text-left { text-align: left; }
.text-center { text-align: center; }
.text-right { text-align: right; }

.text-primary { color: var(--color-text-primary); }
.text-secondary { color: var(--color-text-secondary); }
.text-tertiary { color: var(--color-text-tertiary); }
.text-gold { color: var(--color-gold); text-shadow: 0 0 20rpx rgba(244, 212, 140, 0.15); }
.text-lavender { color: var(--color-lavender); }
.text-success { color: var(--color-success); }
.text-warning { color: var(--color-warning); }
.text-error { color: var(--color-error); }

.text-bold { font-weight: var(--font-weight-bold); }
.text-semibold { font-weight: var(--font-weight-semibold); }
.text-medium { font-weight: var(--font-weight-medium); }
.text-normal { font-weight: var(--font-weight-normal); }

.text-sm { font-size: var(--font-size-caption); }
.text-base { font-size: var(--font-size-body); }
.text-md { font-size: var(--font-size-body); }
.text-lg { font-size: var(--font-size-subhead); }
.text-xl { font-size: var(--font-size-title); }

.text-truncate {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.text-2lines {
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* -----------------------------------------------------------
   19. VISIBILITY & POSITIONING
   ----------------------------------------------------------- */

.hidden {
  display: none !important;
}

.invisible {
  opacity: 0;
  pointer-events: none;
}

.relative {
  position: relative;
}

.absolute {
  position: absolute;
}

.fixed {
  position: fixed;
}

.full-width {
  width: 100%;
}

.full-height {
  height: 100%;
}

.overflow-hidden {
  overflow: hidden;
}

.z-1 { z-index: var(--z-base); }
.z-card { z-index: var(--z-card); }
.z-sticky { z-index: var(--z-sticky); }
.z-overlay { z-index: var(--z-overlay); }
.z-modal { z-index: var(--z-modal); }

/* -----------------------------------------------------------
   20. SCROLLBAR STYLING
   ----------------------------------------------------------- */

::-webkit-scrollbar {
  width: 4rpx;
  height: 4rpx;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: rgba(106, 101, 136, 0.30);
  border-radius: var(--radius-sm);
}

::-webkit-scrollbar-thumb:active {
  background: rgba(106, 101, 136, 0.50);
}

/* -----------------------------------------------------------
   21. SAFE AREA & BOTTOM SPACING
   ----------------------------------------------------------- */

.safe-bottom {
  padding-bottom: var(--safe-area-bottom);
}

.safe-top {
  padding-top: var(--status-bar-height, 44rpx);
}

/* -----------------------------------------------------------
   22. MISC COMPOSITION HELPERS
   ----------------------------------------------------------- */

/* Floating action button style */
.fab {
  position: fixed;
  right: var(--page-padding);
  bottom: calc(120rpx + var(--safe-area-bottom));
  width: 100rpx;
  height: 100rpx;
  border-radius: var(--radius-pill);
  background: linear-gradient(135deg, #F4D48C 0%, #E8C67A 100%);
  box-shadow: 0 4rpx 24rpx rgba(244, 212, 140, 0.30);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: var(--z-card);
  transition: all var(--duration-fast) var(--ease-soft);
}

.fab:active {
  transform: scale(0.92);
  box-shadow: 0 2rpx 12rpx rgba(244, 212, 140, 0.20);
}

.fab__icon {
  width: 44rpx;
  height: 44rpx;
}

/* Top-right decorative dot — like a distant planet */
.planet-dot {
  position: absolute;
  top: 60rpx;
  right: 60rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: var(--radius-pill);
  background: var(--color-lavender);
  opacity: 0.20;
  box-shadow: 0 0 20rpx rgba(184, 169, 224, 0.10);
}

/* Reading queue indicator */
.reading-progress {
  width: 100%;
  height: 3rpx;
  background: rgba(106, 101, 136, 0.15);
  border-radius: var(--radius-sm);
  overflow: hidden;
}

.reading-progress__fill {
  height: 100%;
  background: var(--color-gold);
  border-radius: var(--radius-sm);
  transition: width var(--duration-slow) var(--ease-out);
}

/* Image placeholder for loading */
.img-placeholder {
  background: linear-gradient(
    135deg,
    var(--color-surface) 0%,
    var(--color-surface) 100%
  );
  display: flex;
  align-items: center;
  justify-content: center;
}

.img-placeholder__icon {
  width: 48rpx;
  height: 48rpx;
  opacity: 0.20;
}

/* ============================================================
   23. ANIMATION LIBRARY
       WXSS-compatible: opacity, transform, box-shadow, background-position only
   ============================================================ */

/* -----------------------------------------------------------
   23-A. CARD & SURFACE KEYFRAMES
   ----------------------------------------------------------- */

/* Card appears to rise up from below with opacity (0.5s) */
@keyframes card-rise {
  0% {
    opacity: 0;
    transform: translateY(40rpx) scale(0.97);
  }
  60% {
    opacity: 1;
    transform: translateY(-6rpx) scale(1);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* -----------------------------------------------------------
   23-B. GLOW & BREATHING KEYFRAMES
   ----------------------------------------------------------- */

/* Box-shadow pulse in golden tones (2.5s cycle) */
@keyframes glow-pulse-gold {
  0%,
  100% {
    box-shadow: 0 0 10rpx rgba(244, 212, 140, 0.08), 0 0 30rpx rgba(244, 212, 140, 0.04);
  }
  50% {
    box-shadow: 0 0 20rpx rgba(244, 212, 140, 0.25), 0 0 50rpx rgba(244, 212, 140, 0.10);
  }
}

/* Very gentle scale oscillation (1->1.02->1, 4s cycle) — daily card breathing border */
@keyframes card-breathe {
  0%,
  100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.02);
  }
}

/* -----------------------------------------------------------
   23-C. ANIMATION UTILITY CLASSES
   ----------------------------------------------------------- */

/* --- Breathing --- */
.anim-breathe {
  animation: card-breathe 4s ease-in-out infinite;
}

/* --- Entrance Classes (one-shot, use forwards) --- */
.anim-rise {
  animation: card-rise var(--duration-base) cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
}

/* --- Glow Classes (infinite) --- */
.anim-glow-gold {
  animation: glow-pulse-gold 2.5s ease-in-out infinite;
}

/* -----------------------------------------------------------
   23-D. STAGGERED ENTRANCE (card-rise with increasing delays)
   ----------------------------------------------------------- */

.anim-rise-1 {
  animation: card-rise var(--duration-base) cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
  animation-delay: 0.05s;
}

.anim-rise-2 {
  animation: card-rise var(--duration-base) cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
  animation-delay: 0.12s;
}

.anim-rise-3 {
  animation: card-rise var(--duration-base) cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
  animation-delay: 0.20s;
}

.anim-rise-4 {
  animation: card-rise var(--duration-base) cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
  animation-delay: 0.30s;
}

.anim-rise-5 {
  animation: card-rise var(--duration-base) cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
  animation-delay: 0.42s;
}

/* -----------------------------------------------------------
   24. TASTE-INFORMED ENTRANCE & EMPHASIS ANIMATIONS
   Feedback: 50-150ms | Orientation: 200-400ms | Emphasis: 300-600ms
   Always ease-out arrival, ease-in departure. Never linear.
   WXSS-compatible: opacity + transform only.
   ----------------------------------------------------------- */

/* Card enter: scale(0.92)->scale(1) + opacity(0->1), 0.4s ease-out (Orientation) */
@keyframes cardEnter {
  0% {
    opacity: 0;
    transform: scale(0.92);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}

/* Slide up: translateY(30rpx->0) + opacity(0->1), 0.35s ease-out (Orientation) */
@keyframes slideUp {
  0% {
    opacity: 0;
    transform: translateY(30rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Gentle pulse: scale(1->1.03->1), 2s ease-in-out infinite (Emphasis, use sparingly) */
@keyframes gentlePulse {
  0%,
  100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.03);
  }
}

/* Utility classes */
.anim-card-enter {
  opacity: 0;
  animation: cardEnter 0.4s ease-out forwards;
}

.anim-slide-up {
  opacity: 0;
  animation: slideUp 0.35s ease-out forwards;
}

.anim-gentle-pulse {
  animation: gentlePulse 2s ease-in-out infinite;
}

/* Pulse once on appearance for stats / data highlights */
.anim-pulse-once {
  animation: gentlePulse 2s ease-in-out 1;
}


/* ================================================================
   Card Image Loading — skeleton → fade-in → error fallback
   ================================================================ */
.card-img-wrap {
  position: relative;
  overflow: hidden;
  background: var(--color-surface);
  /* shimmer skeleton while image loads */
}

.card-img-wrap::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(244, 212, 140, 0.04) 40%,
    rgba(244, 212, 140, 0.06) 50%,
    rgba(244, 212, 140, 0.04) 60%,
    transparent 100%
  );
  animation: shimmer-sweep 1.8s ease-in-out infinite;
  z-index: 0;
  pointer-events: none;
  opacity: 1;
  transition: opacity 0.3s ease-out;
}

/* When image is loaded, hide skeleton */
.card-img-wrap--loaded::before {
  opacity: 0;
  animation: none;
}

/* When image failed, show fallback icon but hide shimmer */
.card-img-wrap--error::before {
  opacity: 0;
  animation: none;
}

.card-img-wrap .card-img-inner {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
  opacity: 0;
  transition: opacity 0.4s ease-out;
}

.card-img-wrap--loaded .card-img-inner {
  opacity: 1;
}

/* Error fallback: centered icon */
.card-img-fallback {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 0;
  opacity: 0;
  pointer-events: none;
}

.card-img-wrap--error .card-img-fallback {
  opacity: 1;
}

.card-img-fallback-icon {
  font-size: 48rpx;
  opacity: 0.4;
  color: var(--color-text-tertiary);
}

/* ============================================================
   AI DISCLAIMER — Trust signal across all reading pages
   Subtle, honest, not defensive
   ============================================================ */
.ai-disclaimer {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-sm, 16rpx);
  padding: var(--spacing-lg, 32rpx) var(--spacing-md, 24rpx);
  margin-top: var(--spacing-sm, 16rpx);
}

.disc-line {
  flex: 1;
  height: 1rpx;
  max-width: 60rpx;
  background: rgba(160, 152, 192, 0.12);
}

.disc-text {
  font-size: var(--font-size-xs, 20rpx);
  color: var(--color-text-tertiary, #A098C0);
  letter-spacing: 1rpx;
  opacity: 0.55;
  text-align: center;
  line-height: 1.5;
}
