/* ============================================================
   Modern Wellness Sanctuary — Complete Design Language
   Warm, airy, feminine, calm — like a boutique spa journal
   Total redesign from dark mystical to light sanctuary
   ============================================================ */

/* ===== 1. CSS Custom Properties (Design Tokens) ===== */
page {
  /* ---- Color System: Warm Earth + Gentle Botanicals ---- */

  /* Backgrounds — warm cream / ivory, like fine art paper */
  --color-bg-cream: #FAF5EF;
  --color-bg-page: #FBF7F2;
  --color-bg-warm: #F8F1E9;
  --color-bg-card: #FFFFFF;
  --color-bg-card-elevated: #FFFFFF;
  --color-bg-card-warm: #FFFCF9;
  --color-bg-soft: #F5EDE6;

  /* Rose / Terracotta — primary accent, warm feminine energy */
  --color-rose: #D4836A;
  --color-rose-light: #E8A87C;
  --color-rose-dark: #BF6D55;
  --color-rose-glow: rgba(212, 131, 106, 0.18);
  --color-rose-subtle: rgba(212, 131, 106, 0.08);
  --color-rose-pale: #F2D3C6;
  --color-rose-wash: rgba(212, 131, 106, 0.04);

  /* Sage Green — secondary accent, natural, grounding */
  --color-sage: #B7C9B1;
  --color-sage-light: #D4E0CF;
  --color-sage-dark: #9AAD94;
  --color-sage-glow: rgba(183, 201, 177, 0.20);
  --color-sage-subtle: rgba(183, 201, 177, 0.08);
  --color-sage-pale: #E5EDE1;

  /* Warm Gold — for special highlights, subtle elegance */
  --color-gold: #C9A96E;
  --color-gold-light: #E0C9A0;
  --color-gold-dark: #B08D52;
  --color-gold-glow: rgba(201, 169, 110, 0.16);
  --color-gold-subtle: rgba(201, 169, 110, 0.07);
  --color-gold-bright: #D4B87A;
  --color-gold-wash: rgba(201, 169, 110, 0.04);

  /* Additional warm neutrals */
  --color-rose-gold: #DBA8A8;
  --color-rose-gold-subtle: rgba(219, 168, 168, 0.10);
  --color-amber: #D4893A;
  --color-amber-light: #E8A85E;
  --color-amber-glow: rgba(212, 137, 58, 0.15);
  --color-amber-subtle: rgba(212, 137, 58, 0.06);

  /* Semantic colors — softer, muted */
  --color-success: #7DBF8A;
  --color-warning: #D4A85C;
  --color-danger: #D47878;

  /* Text — warm charcoal, never pure black */
  --color-text-primary: #3D3535;
  --color-text-secondary: #7A706E;
  --color-text-dim: #A59B98;
  --color-text-muted: #C5BCB8;
  --color-text-on-rose: #FFFFFF;
  --color-text-on-sage: #3D3535;
  --color-text-on-gold: #3D3535;

  /* Borders / Dividers — warm, delicate */
  --color-border-subtle: rgba(61, 53, 53, 0.06);
  --color-border-light: rgba(61, 53, 53, 0.10);
  --color-border-rose: rgba(212, 131, 106, 0.18);
  --color-border-sage: rgba(183, 201, 177, 0.25);
  --color-divider: rgba(61, 53, 53, 0.05);
  --color-divider-warm: #E8E0D8;

  /* ---- Gradients: warm, watercolor-like ---- */
  --gradient-rose: linear-gradient(135deg, #D4836A, #E8A87C);
  --gradient-rose-reverse: linear-gradient(135deg, #E8A87C, #D4836A);
  --gradient-sage: linear-gradient(135deg, #B7C9B1, #D4E0CF);
  --gradient-cream: linear-gradient(180deg, #FBF7F2 0%, #F5EDE6 100%);
  --gradient-card-soft: linear-gradient(145deg,
    #FFFCF9 0%, #FFFFFF 50%, #FFF8F0 100%);
  --gradient-rose-to-cream: linear-gradient(135deg,
    rgba(212, 131, 106, 0.06) 0%, rgba(255, 252, 249, 0.9) 100%);
  --gradient-sage-to-cream: linear-gradient(135deg,
    rgba(183, 201, 177, 0.08) 0%, rgba(255, 252, 249, 0.9) 100%);
  --gradient-warm-radial: radial-gradient(
    ellipse at 50% 0%,
    rgba(212, 131, 106, 0.04) 0%,
    rgba(232, 168, 124, 0.02) 40%,
    transparent 70%
  );
  --gradient-sage-radial: radial-gradient(
    ellipse at 50% 100%,
    rgba(183, 201, 177, 0.05) 0%,
    transparent 60%
  );
  --gradient-top-accent: linear-gradient(180deg,
    rgba(212, 131, 106, 0.03) 0%, transparent 100%);
  --gradient-ambient-warm: radial-gradient(
    ellipse 80% 40% at 50% 0%,
    rgba(232, 168, 124, 0.03) 0%,
    transparent 100%
  );

  /* ---- Typography ---- */
  --font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC',
    'Hiragino Sans GB', 'Microsoft YaHei', 'Noto Serif SC', sans-serif;
  --font-family-display: 'Noto Serif SC', 'PingFang SC', 'Hiragino Sans GB',
    'Georgia', serif;
  --font-family-body: -apple-system, BlinkMacSystemFont, 'PingFang SC',
    'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;

  /* Font sizes — generously scaled, elegant hierarchy */
  --fs-caption: 22rpx;
  --fs-small: 24rpx;
  --fs-body-small: 26rpx;
  --fs-body: 28rpx;
  --fs-body-large: 30rpx;
  --fs-h4: 34rpx;
  --fs-h3: 40rpx;
  --fs-h2: 50rpx;
  --fs-h1: 60rpx;
  --fs-display: 72rpx;

  /* Font weights — lighter, more delicate */
  --fw-light: 300;
  --fw-regular: 400;
  --fw-medium: 500;
  --fw-semibold: 600;
  --fw-bold: 700;

  /* Line heights — generous and airy */
  --lh-tight: 1.2;
  --lh-normal: 1.6;
  --lh-loose: 1.8;
  --lh-xl: 2.0;

  /* Letter spacing — subtle, refined */
  --ls-heading: 2rpx;
  --ls-display: 4rpx;
  --ls-body: 0.8rpx;
  --ls-caption: 1rpx;

  /* ---- Spacing — MUCH more generous ---- */
  --space-xxs: 6rpx;
  --space-xs: 10rpx;
  --space-sm: 16rpx;
  --space-md: 20rpx;
  --space-lg: 28rpx;
  --space-xl: 36rpx;
  --space-xxl: 48rpx;
  --space-xxxl: 60rpx;
  --space-huge: 72rpx;
  --space-massive: 88rpx;
  --space-section: 80rpx;

  /* ---- Border Radius — soft, pillowy ---- */
  --radius-sm: 10rpx;
  --radius-md: 14rpx;
  --radius-lg: 18rpx;
  --radius-xl: 24rpx;
  --radius-xxl: 32rpx;
  --radius-round: 48rpx;
  --radius-full: 50%;
  --radius-card: 28rpx;
  --radius-button: 50rpx;
  --radius-pill: 100rpx;

  /* ---- Shadows — warm, paper-like, never black ---- */
  --shadow-card: 0 4rpx 24rpx rgba(61, 53, 53, 0.06),
    0 2rpx 8rpx rgba(61, 53, 53, 0.04);
  --shadow-card-elevated: 0 8rpx 40rpx rgba(61, 53, 53, 0.08),
    0 4rpx 16rpx rgba(61, 53, 53, 0.04);
  --shadow-card-rose: 0 4rpx 24rpx rgba(212, 131, 106, 0.08),
    0 2rpx 8rpx rgba(212, 131, 106, 0.04);
  --shadow-card-sage: 0 4rpx 24rpx rgba(183, 201, 177, 0.10),
    0 2rpx 8rpx rgba(183, 201, 177, 0.05);
  --shadow-rose: 0 4rpx 16rpx rgba(212, 131, 106, 0.15);
  --shadow-rose-strong: 0 6rpx 24rpx rgba(212, 131, 106, 0.20);
  --shadow-sage: 0 4rpx 16rpx rgba(183, 201, 177, 0.15);
  --shadow-gold: 0 4rpx 16rpx rgba(201, 169, 110, 0.12);
  --shadow-button: 0 4rpx 16rpx rgba(212, 131, 106, 0.18);
  --shadow-ambient-rose: 0 8rpx 48rpx rgba(212, 131, 106, 0.03);

  /* ---- Animations — slow, breathing, meditative ---- */
  --duration-fast: 0.3s;
  --duration-normal: 0.45s;
  --duration-slow: 0.6s;
  --duration-xslow: 0.8s;
  --duration-breath: 4s;
  --duration-shimmer: 3s;
  --ease-out-smooth: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-in-out-smooth: cubic-bezier(0.65, 0, 0.35, 1);
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);

  /* ---- Z-index layers ---- */
  --z-base: 1;
  --z-card: 10;
  --z-modal: 100;
  --z-toast: 1000;

  /* ---- Page Base ---- */
  background-color: var(--color-bg-page);
  background-image:
    var(--gradient-warm-radial),
    var(--gradient-sage-radial);
  color: var(--color-text-primary);
  font-family: var(--font-family-body);
  font-size: var(--fs-body);
  line-height: var(--lh-loose);
  letter-spacing: var(--ls-body);
}


/* ===== 2. Global Keyframes — slow, breath-like, meditative ===== */

/* 2.1 Gentle fade up — like a deep breath in */
@keyframes wellness-fade-up {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 2.2 Soft fade in */
@keyframes wellness-fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* 2.3 Breath pulse — like a slow exhale/inhale */
@keyframes breath-pulse {
  0%, 100% { opacity: 0.7; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.03); }
}

/* 2.4 Gentle float — suspended, weightless */
@keyframes gentle-float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-6rpx); }
}

/* 2.5 Warm glow pulse — candle-light breathing */
@keyframes warm-glow {
  0%, 100% { box-shadow: 0 0 12rpx var(--color-rose-glow); }
  50% { box-shadow: 0 0 24rpx var(--color-rose-glow), 0 0 40rpx var(--color-rose-subtle); }
}

/* 2.6 Sage shimmer — slow, flowing */
@keyframes sage-shimmer {
  0% { background-position: -200% center; }
  100% { background-position: 200% center; }
}

/* 2.7 Gentle rotate — for meditative elements */
@keyframes gentle-spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 2.8 Scale reveal — for cards entering */
@keyframes scale-in {
  from { opacity: 0; transform: scale(0.92); }
  to { opacity: 1; transform: scale(1); }
}

/* 2.9 Soft slide up — for modals and sheets */
@keyframes slide-up-soft {
  from { transform: translateY(100%); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

/* 2.10 Border glow flow */
@keyframes border-warm-flow {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

/* 2.11 Delicate shimmer sweep — like light on silk */
@keyframes silk-shimmer {
  0% { transform: translateX(-100%) skewX(-15deg); opacity: 0; }
  20% { opacity: 0.08; }
  100% { transform: translateX(200%) skewX(-15deg); opacity: 0; }
}

/* 2.12 Watercolor ripple */
@keyframes ripple-soft {
  0% { transform: scale(1); opacity: 0.08; }
  50% { transform: scale(1.04); opacity: 0.15; }
  100% { transform: scale(1); opacity: 0.08; }
}

/* 2.13 Cursor blink for text areas */
@keyframes cursor-soft-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

/* 2.14 Gentle sway — like a leaf */
@keyframes gentle-sway {
  0%, 100% { transform: rotate(0deg); }
  25% { transform: rotate(1deg); }
  75% { transform: rotate(-1deg); }
}

/* 2.15 Card flip */
@keyframes card-flip {
  0% { transform: perspective(800rpx) rotateY(0deg); }
  100% { transform: perspective(800rpx) rotateY(180deg); }
}

/* ===== Backward-compatible keyframes (re-mapped) ===== */
@keyframes twinkle {
  0%, 100% { opacity: 0.3; transform: scale(0.8); }
  50% { opacity: 0.8; transform: scale(1.1); }
}
@keyframes glow-pulse {
  0%, 100% { box-shadow: 0 0 10rpx var(--color-rose-glow); }
  50% { box-shadow: 0 0 20rpx var(--color-rose-glow), 0 0 30rpx var(--color-rose-subtle); }
}
@keyframes shimmer {
  0% { background-position: -200% center; }
  100% { background-position: 200% center; }
}
@keyframes fade-in-up {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-6rpx); }
}
@keyframes breathe {
  0%, 100% { opacity: 0.6; }
  50% { opacity: 1; }
}
@keyframes pulse-scale {
  0%, 100% { transform: scale(1); opacity: 0.7; }
  50% { transform: scale(1.03); opacity: 1; }
}
@keyframes candle-flicker {
  0%, 100% { opacity: 0.8; transform: scale(1); }
  25% { opacity: 0.9; transform: scale(1.01); }
  50% { opacity: 0.7; transform: scale(0.99); }
  75% { opacity: 0.85; transform: scale(1.005); }
}
@keyframes halo-breathe {
  0%, 100% { box-shadow: 0 0 6rpx var(--color-rose-glow); }
  50% { box-shadow: 0 0 14rpx var(--color-rose-glow), 0 0 28rpx var(--color-rose-subtle); }
}
@keyframes card-shimmer {
  0% { transform: translateX(-100%) skewX(-15deg); opacity: 0; }
  20% { opacity: 0.06; }
  100% { transform: translateX(200%) skewX(-15deg); opacity: 0; }
}
@keyframes mystic-spin {
  0% { transform: rotate(0deg) scale(1); }
  100% { transform: rotate(360deg) scale(1); }
}
@keyframes border-flow {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}
@keyframes mystic-wave {
  0%, 100% { transform: scale(1); opacity: 0.06; }
  50% { transform: scale(1.03); opacity: 0.12; }
}
@keyframes cursor-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}


/* ===== 3. Page Containers ===== */

.page {
  min-height: 100vh;
  padding: var(--space-xl);
  padding-bottom: calc(env(safe-area-inset-bottom) + var(--space-massive));
  background: var(--color-bg-page);
  background-image:
    var(--gradient-warm-radial),
    var(--gradient-sage-radial);
}

.page-full {
  min-height: 100vh;
  background: var(--color-bg-page);
  background-image:
    var(--gradient-warm-radial),
    var(--gradient-sage-radial);
}


/* ===== 4. Card Surfaces ===== */

/* 4.1 Base card — warm white, soft shadow, gentle corners */
.card {
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  padding: var(--space-xxl);
  border: 1rpx solid var(--color-border-light);
  box-shadow: var(--shadow-card);
  position: relative;
  overflow: hidden;
}

/* 4.2 Glass card — subtle frosted effect */
.card-glass {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
  border-radius: var(--radius-card);
  padding: var(--space-xxl);
  border: 1rpx solid var(--color-border-light);
  box-shadow: var(--shadow-card);
}

/* 4.3 Premium card — elevated, with warm rose accent */
.card-premium {
  background: var(--gradient-card-soft);
  border-radius: var(--radius-card);
  padding: var(--space-xxl);
  border: 1rpx solid var(--color-border-rose);
  box-shadow: var(--shadow-card-elevated), 0 0 40rpx var(--color-rose-wash);
  position: relative;
  overflow: hidden;
}

/* 4.4 Premium card top accent — warm rose glow */
.card-premium::before {
  content: '';
  position: absolute;
  top: -30%;
  left: -30%;
  width: 160%;
  height: 160%;
  background: radial-gradient(circle at 30% 20%,
    rgba(212, 131, 106, 0.04), rgba(232, 168, 124, 0.02) 50%, transparent 60%);
  pointer-events: none;
}

/* 4.5 Card with gradient border — rose-to-cream */
.card-gradient-border {
  position: relative;
  border-radius: var(--radius-card);
  background: var(--color-bg-card);
  background-clip: padding-box;
  z-index: 1;
}
.card-gradient-border::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  border-radius: var(--radius-card);
  padding: 2rpx;
  background: linear-gradient(135deg,
    rgba(212, 131, 106, 0.25), rgba(183, 201, 177, 0.15), rgba(201, 169, 110, 0.10));
  background-size: 200% 200%;
  animation: border-warm-flow 8s var(--ease-in-out-smooth) infinite;
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  pointer-events: none;
  z-index: -1;
}

/* 4.6 Clickable card */
.card-clickable {
  transition: all var(--duration-normal) var(--ease-out-smooth);
}
.card-clickable:active {
  transform: scale(0.98);
  border-color: var(--color-border-rose);
  box-shadow: var(--shadow-card-rose);
}

/* 4.7 Card silk sweep decoration */
.card::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 60rpx;
  height: 100%;
  background: linear-gradient(90deg,
    transparent,
    rgba(232, 168, 124, 0.02),
    transparent);
  transform: translateX(-100%) skewX(-15deg);
  pointer-events: none;
}
.card:hover::after {
  animation: silk-shimmer 3s var(--ease-in-out-smooth);
}


/* ===== 5. Button System ===== */

/* 5.1 Primary button — warm rose gradient, pill-shaped, soft shadow */
.btn-primary {
  width: 100%;
  background: var(--gradient-rose);
  color: var(--color-text-on-rose);
  font-size: var(--fs-h4);
  font-weight: var(--fw-medium);
  border-radius: var(--radius-button);
  padding: 28rpx 0;
  border: none;
  box-shadow: var(--shadow-button);
  transition: all var(--duration-normal) var(--ease-out-smooth);
  position: relative;
  overflow: hidden;
  letter-spacing: var(--ls-caption);
}

.btn-primary:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 8rpx rgba(212, 131, 106, 0.12);
}

/* 5.2 Shimmer button — rose gradient with flowing light */
.btn-shimmer {
  width: 100%;
  background: var(--gradient-rose);
  background-size: 200% 100%;
  animation: sage-shimmer var(--duration-shimmer) ease-in-out infinite;
  color: var(--color-text-on-rose);
  font-size: var(--fs-h4);
  font-weight: var(--fw-medium);
  border-radius: var(--radius-button);
  padding: 28rpx 0;
  border: none;
  box-shadow: var(--shadow-button);
  position: relative;
  overflow: hidden;
}

.btn-shimmer:active {
  transform: scale(0.97);
}

/* 5.3 Glow pulse button */
.btn-glow-pulse {
  width: 100%;
  background: var(--gradient-rose);
  color: var(--color-text-on-rose);
  font-size: var(--fs-h4);
  font-weight: var(--fw-medium);
  border-radius: var(--radius-button);
  padding: 28rpx 0;
  border: none;
  animation: warm-glow var(--duration-breath) var(--ease-in-out-smooth) infinite;
}

.btn-glow-pulse:active {
  transform: scale(0.97);
}

/* 5.4 Secondary button — outlined in rose */
.btn-secondary {
  width: 100%;
  background: transparent;
  color: var(--color-rose);
  font-size: var(--fs-body-large);
  font-weight: var(--fw-medium);
  border-radius: var(--radius-button);
  padding: 24rpx 0;
  border: 2rpx solid var(--color-rose);
  transition: all var(--duration-normal) var(--ease-out-smooth);
}

.btn-secondary:active {
  background: var(--color-rose-subtle);
  transform: scale(0.97);
}

/* 5.5 Ghost button */
.btn-ghost {
  background: transparent;
  color: var(--color-text-secondary);
  font-size: var(--fs-body);
  border: none;
  padding: var(--space-sm) var(--space-lg);
  border-radius: var(--radius-round);
  transition: all var(--duration-fast);
}

.btn-ghost:active {
  background: var(--color-rose-wash);
  color: var(--color-rose);
}

/* 5.6 Text button */
.btn-text {
  background: none;
  border: none;
  color: var(--color-rose);
  font-size: var(--fs-body);
  padding: var(--space-xs);
  display: inline-block;
  transition: color var(--duration-fast);
}

.btn-text:active {
  color: var(--color-rose-dark);
  text-decoration: underline;
}

/* 5.7 Small button */
.btn-small {
  font-size: var(--fs-body-small);
  padding: 16rpx 36rpx;
  border-radius: var(--radius-lg);
}

/* 5.8 Mystical button — redesigned as elegant wellness */
.btn-mystical {
  width: 100%;
  background: var(--gradient-card-soft);
  color: var(--color-rose);
  font-size: var(--fs-h4);
  font-weight: var(--fw-medium);
  border-radius: var(--radius-button);
  padding: 28rpx 0;
  border: 1.5rpx solid var(--color-border-rose);
  box-shadow: var(--shadow-card),
    inset 0 0 30rpx rgba(212, 131, 106, 0.03);
  position: relative;
  overflow: hidden;
  transition: all var(--duration-normal) var(--ease-out-smooth);
  letter-spacing: var(--ls-caption);
}

.btn-mystical::before,
.btn-mystical::after {
  content: '~';
  position: absolute;
  font-size: 20rpx;
  color: var(--color-rose-light);
  opacity: 0.4;
}

.btn-mystical::before {
  top: 10rpx;
  left: var(--space-lg);
}

.btn-mystical::after {
  bottom: 10rpx;
  right: var(--space-lg);
  transform: scaleX(-1);
}

.btn-mystical:active {
  transform: scale(0.97);
  background: var(--color-rose-wash);
}


/* ===== 6. Typography — elegant, spacious, editorial ===== */

.heading-1 {
  font-size: var(--fs-h1);
  font-weight: var(--fw-light);
  color: var(--color-text-primary);
  line-height: var(--lh-tight);
  letter-spacing: var(--ls-display);
  font-family: var(--font-family-display);
}

.heading-2 {
  font-size: var(--fs-h2);
  font-weight: var(--fw-light);
  color: var(--color-text-primary);
  line-height: var(--lh-tight);
  letter-spacing: var(--ls-heading);
  font-family: var(--font-family-display);
}

.heading-3 {
  font-size: var(--fs-h3);
  font-weight: var(--fw-medium);
  color: var(--color-text-primary);
  line-height: var(--lh-tight);
  letter-spacing: var(--ls-heading);
}

.heading-4 {
  font-size: var(--fs-h4);
  font-weight: var(--fw-medium);
  color: var(--color-text-primary);
  line-height: var(--lh-normal);
}

.text-body {
  font-size: var(--fs-body);
  color: var(--color-text-primary);
  line-height: var(--lh-xl);
}

.text-secondary {
  font-size: var(--fs-body);
  color: var(--color-text-secondary);
  line-height: var(--lh-loose);
}

.text-dim {
  font-size: var(--fs-body-small);
  color: var(--color-text-dim);
}

.text-caption {
  font-size: var(--fs-caption);
  color: var(--color-text-dim);
  letter-spacing: var(--ls-caption);
}

.text-gold {
  color: var(--color-gold);
}

.text-gold-bright {
  color: var(--color-gold-bright);
}

.text-rose-gold {
  color: var(--color-rose-gold);
}

/* Keep for compatibility but re-map to warm tones */
.text-gold-aged {
  color: var(--color-gold-dark);
}

.text-center {
  text-align: center;
}


/* ===== 7. Star Field — reimagined as gentle floating particles ===== */

.star-field {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
}

.star-particle {
  position: absolute;
  width: 4rpx;
  height: 4rpx;
  background: var(--color-rose-light);
  border-radius: var(--radius-full);
  animation: twinkle 5s ease-in-out infinite;
  opacity: 0.3;
}

.star-particle:nth-child(1) { top: 10%; left: 15%; animation-delay: 0s; width: 3rpx; height: 3rpx; }
.star-particle:nth-child(2) { top: 25%; left: 80%; animation-delay: 0.8s; width: 5rpx; height: 5rpx; }
.star-particle:nth-child(3) { top: 45%; left: 5%; animation-delay: 1.6s; }
.star-particle:nth-child(4) { top: 60%; left: 90%; animation-delay: 0.4s; width: 3rpx; height: 3rpx; }
.star-particle:nth-child(5) { top: 75%; left: 20%; animation-delay: 2.2s; width: 4rpx; height: 4rpx; }
.star-particle:nth-child(6) { top: 85%; left: 70%; animation-delay: 1s; width: 6rpx; height: 6rpx; }
.star-particle:nth-child(7) { top: 15%; left: 50%; animation-delay: 0.6s; width: 3rpx; height: 3rpx; }
.star-particle:nth-child(8) { top: 50%; left: 75%; animation-delay: 1.8s; }
.star-particle:nth-child(9) { top: 35%; left: 35%; animation-delay: 0.3s; width: 5rpx; height: 5rpx; }
.star-particle:nth-child(10) { top: 70%; left: 50%; animation-delay: 2.5s; width: 3rpx; height: 3rpx; }


/* ===== 8. Glow & Decorative Effects ===== */

.glow-gold {
  box-shadow: 0 0 20rpx rgba(201, 169, 110, 0.12);
}

.glow-amber {
  box-shadow: 0 0 20rpx rgba(212, 137, 58, 0.10);
}

.glow-purple {
  box-shadow: 0 0 20rpx rgba(147, 112, 219, 0.08);
}

.glow-border {
  position: relative;
}
.glow-border::after {
  content: '';
  position: absolute;
  top: -2rpx;
  left: -2rpx;
  right: -2rpx;
  bottom: -2rpx;
  border-radius: inherit;
  background: linear-gradient(135deg, var(--color-rose), var(--color-sage));
  opacity: 0;
  z-index: -1;
  transition: opacity var(--duration-normal);
}
.glow-border:hover::after {
  opacity: 0.15;
}

/* Top ambient orb — warm rose glow */
.orb-top {
  position: fixed;
  top: -200rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 600rpx;
  height: 600rpx;
  border-radius: var(--radius-full);
  background: radial-gradient(circle,
    rgba(212, 131, 106, 0.05) 0%,
    rgba(232, 168, 124, 0.03) 30%,
    rgba(183, 201, 177, 0.02) 50%,
    transparent 70%);
  pointer-events: none;
  z-index: 0;
}

/* Bottom ambient orb — soft sage */
.orb-bottom {
  position: fixed;
  bottom: -300rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 600rpx;
  height: 600rpx;
  border-radius: var(--radius-full);
  background: radial-gradient(circle,
    rgba(183, 201, 177, 0.06) 0%,
    rgba(212, 131, 106, 0.02) 40%,
    transparent 60%);
  pointer-events: none;
  z-index: 0;
}


/* ===== 9. Loading & Reading Animations ===== */

/* 9.1 Reading / loading page */
.mystic-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: var(--space-xxl);
  background: var(--color-bg-page);
}

.mystic-loading-symbol {
  font-size: 72rpx;
  color: var(--color-rose);
  animation: gentle-spin 6s var(--ease-in-out-smooth) infinite;
  display: block;
  margin-bottom: var(--space-xxl);
  opacity: 0.8;
}

.mystic-loading-title {
  font-size: var(--fs-h4);
  color: var(--color-rose);
  font-weight: var(--fw-medium);
  animation: breath-pulse var(--duration-breath) ease-in-out infinite;
}

.mystic-loading-sub {
  font-size: var(--fs-body);
  color: var(--color-text-secondary);
  margin-top: var(--space-md);
}

/* 9.2 Card flip container */
.card-flip-container {
  perspective: 1000rpx;
  width: 300rpx;
  height: 420rpx;
}

.card-flip-inner {
  position: relative;
  width: 100%;
  height: 100%;
  transition: transform var(--duration-xslow) var(--ease-out-smooth);
  transform-style: preserve-3d;
}

.card-flip-inner.flipped {
  transform: rotateY(180deg);
}

.card-flip-front,
.card-flip-back {
  position: absolute;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  border-radius: var(--radius-card);
}

.card-flip-front {
  background: var(--gradient-rose);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-card-rose);
}

.card-flip-back {
  background: var(--color-bg-card);
  border: 1.5rpx solid var(--color-border-rose);
  box-shadow: var(--shadow-card-rose);
  transform: rotateY(180deg);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}


/* ===== 10. Section Titles & Layout ===== */

.section-block {
  margin-bottom: var(--space-section);
}

.section-title {
  font-size: var(--fs-h4);
  font-weight: var(--fw-medium);
  color: var(--color-text-primary);
  display: block;
  margin-bottom: var(--space-xl);
  position: relative;
  padding-left: var(--space-xxl);
  letter-spacing: var(--ls-heading);
  font-family: var(--font-family-display);
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 6rpx;
  bottom: 6rpx;
  width: 3rpx;
  background: linear-gradient(
    180deg,
    var(--color-rose) 0%,
    var(--color-rose-light) 50%,
    var(--color-sage) 100%
  );
  border-radius: 3rpx;
}

.section-title::after {
  content: '~';
  position: absolute;
  left: -5rpx;
  top: 0;
  font-size: 18rpx;
  color: var(--color-rose-light);
  opacity: 0.5;
}

.section-title-center {
  font-size: var(--fs-h4);
  font-weight: var(--fw-medium);
  color: var(--color-rose);
  font-family: var(--font-family-display);
  display: block;
  text-align: center;
  margin-bottom: var(--space-xl);
  letter-spacing: var(--ls-heading);
}

/* 10.2 Ritual circle — reimagined as gentle wellness ring */
.ritual-circle {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  border: 1.5rpx solid var(--color-rose-subtle);
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
}

.ritual-circle::before {
  content: '';
  position: absolute;
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(212, 131, 106, 0.08);
  pointer-events: none;
}

.ritual-circle::after {
  content: '';
  position: absolute;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(183, 201, 177, 0.10);
  animation: gentle-spin 25s linear infinite;
  pointer-events: none;
}

/* 10.3 Drop cap — elegant serif first letter */
.drop-cap::first-letter {
  font-size: 64rpx;
  font-weight: var(--fw-light);
  color: var(--color-rose);
  float: left;
  margin-right: 10rpx;
  line-height: 1;
  font-family: var(--font-family-display);
}

/* 10.4 Soft cloth / texture background */
.cloth-bg {
  position: relative;
  background:
    radial-gradient(ellipse at 50% 0%, rgba(212, 131, 106, 0.03), transparent 60%),
    radial-gradient(ellipse at 50% 100%, rgba(183, 201, 177, 0.04), transparent 50%),
    linear-gradient(180deg, #FBF7F2, #F5EDE6);
  border-radius: var(--radius-card);
  border: 1rpx solid var(--color-border-subtle);
  overflow: hidden;
}

.cloth-bg::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: repeating-linear-gradient(
    0deg,
    transparent,
    transparent 3rpx,
    rgba(61, 53, 53, 0.003) 3rpx,
    rgba(61, 53, 53, 0.003) 4rpx
  );
  pointer-events: none;
}

/* 10.5 Symbol divider — warm, delicate */
.divider-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-md);
  margin: var(--space-xxl) 0;
  color: var(--color-rose-light);
  font-size: var(--fs-caption);
  opacity: 0.4;
}

.divider-symbol::before,
.divider-symbol::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, var(--color-divider-warm), transparent);
}


/* ===== 11. Forms & Inputs ===== */

.input-box {
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  padding: var(--space-xl);
  border: 1.5rpx solid var(--color-border-light);
  transition: border-color var(--duration-normal), box-shadow var(--duration-normal);
  box-shadow: var(--shadow-card);
}

.input-box:focus-within {
  border-color: var(--color-rose);
  box-shadow: var(--shadow-card-rose);
}

.input-label {
  font-size: var(--fs-body);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--space-sm);
  letter-spacing: var(--ls-body);
}

.input-field {
  width: 100%;
  min-height: 160rpx;
  background: transparent;
  font-size: var(--fs-body);
  color: var(--color-text-primary);
  line-height: var(--lh-xl);
  border: none;
  outline: none;
  padding: 0;
  caret-color: var(--color-rose);
}

.input-count {
  font-size: var(--fs-caption);
  color: var(--color-text-dim);
  text-align: right;
  display: block;
  margin-top: var(--space-xs);
}


/* ===== 12. Tags / Badges ===== */

.badge {
  display: inline-block;
  font-size: var(--fs-caption);
  padding: 6rpx 20rpx;
  border-radius: var(--radius-pill);
  letter-spacing: var(--ls-caption);
}

.badge-gold {
  background: var(--color-gold-subtle);
  color: var(--color-gold-dark);
}

.badge-purple {
  background: rgba(147, 112, 219, 0.08);
  color: #7B5BA1;
}

.badge-premium {
  background: var(--gradient-rose);
  color: var(--color-text-on-rose);
  font-weight: var(--fw-medium);
  padding: 8rpx 24rpx;
}

.badge-rose-gold {
  background: var(--color-rose-gold-subtle);
  color: var(--color-rose-gold);
}

.badge-success {
  background: rgba(125, 191, 138, 0.12);
  color: var(--color-success);
}

.badge-danger {
  background: rgba(212, 120, 120, 0.12);
  color: var(--color-danger);
}


/* ===== 13. Dividers ===== */

.divider {
  height: 1rpx;
  background: var(--color-divider-warm);
  margin: var(--space-xl) 0;
}

.divider-gold {
  height: 1rpx;
  background: linear-gradient(90deg,
    transparent, var(--color-divider-warm), transparent);
  margin: var(--space-xl) 0;
}


/* ===== 14. Dots / Indicators ===== */

.dots {
  display: flex;
  justify-content: center;
  gap: var(--space-md);
  padding: var(--space-lg) 0;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: var(--radius-full);
  background: var(--color-text-muted);
  transition: all var(--duration-normal);
  opacity: 0.4;
}

.dot-active {
  width: 32rpx;
  border-radius: var(--radius-round);
  background: var(--color-rose);
  opacity: 1;
}


/* ===== 15. Animation Utility Classes ===== */

.anim-fade-in {
  animation: wellness-fade-in var(--duration-slow) var(--ease-out-smooth) forwards;
}

.anim-fade-in-up {
  animation: wellness-fade-up var(--duration-slow) var(--ease-out-smooth) forwards;
}

.anim-fade-in-up-1 { animation: wellness-fade-up 0.6s var(--ease-out-smooth) 0.1s both; }
.anim-fade-in-up-2 { animation: wellness-fade-up 0.6s var(--ease-out-smooth) 0.2s both; }
.anim-fade-in-up-3 { animation: wellness-fade-up 0.6s var(--ease-out-smooth) 0.3s both; }
.anim-fade-in-up-4 { animation: wellness-fade-up 0.6s var(--ease-out-smooth) 0.4s both; }
.anim-fade-in-up-5 { animation: wellness-fade-up 0.6s var(--ease-out-smooth) 0.5s both; }

.anim-float {
  animation: gentle-float 5s var(--ease-in-out-smooth) infinite;
}

.anim-breathe {
  animation: breath-pulse 4s var(--ease-in-out-smooth) infinite;
}

.anim-glow-pulse {
  animation: warm-glow 3s var(--ease-in-out-smooth) infinite;
}

.anim-pulse-scale {
  animation: pulse-scale 2.5s var(--ease-in-out-smooth) infinite;
}

.anim-candle-flicker {
  animation: candle-flicker 7s var(--ease-in-out-smooth) infinite;
}

.anim-halo-breathe {
  animation: warm-glow 4s var(--ease-in-out-smooth) infinite;
}

.anim-delay-1  { animation-delay: 0.1s; }
.anim-delay-2  { animation-delay: 0.2s; }
.anim-delay-3  { animation-delay: 0.3s; }
.anim-delay-4  { animation-delay: 0.4s; }
.anim-delay-5  { animation-delay: 0.5s; }


/* ===== 16. Spacing Utility Classes ===== */

.mt-xs { margin-top: var(--space-xs); }
.mt-sm { margin-top: var(--space-sm); }
.mt-md { margin-top: var(--space-md); }
.mt-lg { margin-top: var(--space-lg); }
.mt-xl { margin-top: var(--space-xl); }
.mt-xxl { margin-top: var(--space-xxl); }
.mt-xxxl { margin-top: var(--space-xxxl); }

.mb-xs { margin-bottom: var(--space-xs); }
.mb-sm { margin-bottom: var(--space-sm); }
.mb-md { margin-bottom: var(--space-md); }
.mb-lg { margin-bottom: var(--space-lg); }
.mb-xl { margin-bottom: var(--space-xl); }
.mb-xxl { margin-bottom: var(--space-xxl); }
.mb-xxxl { margin-bottom: var(--space-xxxl); }

.p-xs { padding: var(--space-xs); }
.p-sm { padding: var(--space-sm); }
.p-md { padding: var(--space-md); }
.p-lg { padding: var(--space-lg); }
.p-xl { padding: var(--space-xl); }
.p-xxl { padding: var(--space-xxl); }
.p-xxxl { padding: var(--space-xxxl); }

.px-lg { padding-left: var(--space-lg); padding-right: var(--space-lg); }
.px-xl { padding-left: var(--space-xl); padding-right: var(--space-xl); }
.py-lg { padding-top: var(--space-lg); padding-bottom: var(--space-lg); }
.py-xl { padding-top: var(--space-xl); padding-bottom: var(--space-xl); }


/* ===== 17. Modal / Bottom Sheet ===== */

.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(61, 53, 53, 0.50);
  backdrop-filter: blur(4rpx);
  -webkit-backdrop-filter: blur(4rpx);
  display: flex;
  align-items: flex-end;
  z-index: var(--z-modal);
}

.modal-content {
  width: 100%;
  background: var(--color-bg-card);
  border-radius: var(--radius-xxl) var(--radius-xxl) 0 0;
  padding: var(--space-xxxl) var(--space-xxl) calc(var(--space-massive) + env(safe-area-inset-bottom));
  max-height: 80vh;
  overflow-y: auto;
  animation: slide-up-soft 0.5s var(--ease-out-smooth);
  box-shadow: 0 -8rpx 40rpx rgba(61, 53, 53, 0.06);
}

.modal-title {
  font-size: var(--fs-h4);
  font-weight: var(--fw-medium);
  color: var(--color-rose);
  font-family: var(--font-family-display);
  display: block;
  text-align: center;
  margin-bottom: var(--space-xxl);
}


/* ===== 18. Option Selector ===== */

.options-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
}

.option-item {
  padding: 16rpx var(--space-xl);
  border-radius: var(--radius-round);
  font-size: var(--fs-body);
  background: var(--color-bg-card);
  color: var(--color-text-secondary);
  border: 1.5rpx solid var(--color-border-light);
  transition: all var(--duration-normal) var(--ease-out-smooth);
  box-shadow: var(--shadow-card);
}

.option-item.selected {
  border-color: var(--color-rose);
  color: var(--color-rose);
  background: var(--color-rose-wash);
  box-shadow: var(--shadow-card-rose);
}

.option-item:active {
  transform: scale(0.96);
}


/* ===== 19. Empty State ===== */

.empty-state {
  text-align: center;
  padding: var(--space-massive) 0;
}

.empty-icon {
  font-size: 64rpx;
  display: block;
  margin-bottom: var(--space-lg);
  opacity: 0.4;
}

.empty-text {
  font-size: var(--fs-body);
  color: var(--color-text-secondary);
  display: block;
}

.empty-hint {
  font-size: var(--fs-body-small);
  color: var(--color-text-dim);
  display: block;
  margin-top: var(--space-sm);
}


/* ===== 20. Loading Placeholder ===== */

.loading-placeholder {
  text-align: center;
  padding: 200rpx 0;
  color: var(--color-text-secondary);
}


/* ===== 21. Premium / VIP Badge Border ===== */

.premium-border {
  border: 2rpx solid transparent;
  background-clip: padding-box;
  position: relative;
}
.premium-border::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  border-radius: inherit;
  padding: 2rpx;
  background: linear-gradient(135deg, var(--color-rose), var(--color-sage), var(--color-gold));
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  pointer-events: none;
}


/* ===== 22. Reading / Interpretation Results ===== */

.interpretation-scroll {
  max-height: 600rpx;
  overflow: hidden;
  position: relative;
}

.interpretation-scroll.expanded {
  max-height: none;
}

.interpretation-scroll:not(.expanded)::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: linear-gradient(transparent, var(--color-bg-card));
  pointer-events: none;
}

.interpretation-text {
  font-size: var(--fs-body);
  color: var(--color-text-primary);
  line-height: var(--lh-xl);
  white-space: pre-wrap;
}

.expand-hint {
  display: block;
  text-align: center;
  color: var(--color-rose);
  font-size: var(--fs-body);
  padding: var(--space-md) 0;
}


/* ===== Action Bar ===== */

.action-bar {
  display: flex;
  justify-content: center;
  gap: var(--space-huge);
  margin-top: var(--space-sm);
}

.action-link {
  font-size: var(--fs-body);
  color: var(--color-text-dim);
  padding: var(--space-sm) 0;
  background: none;
  border: none;
  transition: color var(--duration-fast);
}

.action-link:active {
  color: var(--color-rose);
}


/* ===== 23. Utility Classes ===== */

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.gap-sm { gap: var(--space-sm); }
.gap-md { gap: var(--space-md); }
.gap-lg { gap: var(--space-lg); }
.gap-xl { gap: var(--space-xl); }

.relative {
  position: relative;
}

.overflow-hidden {
  overflow: hidden;
}
