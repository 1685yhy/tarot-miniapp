/* ============================================================
   「星光映照」Design System v5.0
   Editorial Minimal — clean, bold, sophisticated
   ============================================================ */

/* ===== Design Tokens ===== */
page {
  /* Colors */
  --color-bg: #F8F6F2;
  --color-bg-warm: #F3EFE8;
  --color-surface: #FFFFFF;
  --color-surface-warm: #FDFCF9;
  --color-border: #E8E3DB;
  --color-border-light: #F0ECE6;

  /* Accent */
  --color-accent: #8B6F5C;
  --color-accent-light: #B8A393;
  --color-accent-dark: #5C463A;

  /* Text */
  --color-text: #2C2416;
  --color-text-secondary: #6B5F52;
  --color-text-tertiary: #A0988C;
  --color-text-inverse: #FFFFFF;

  /* Semantic */
  --color-tag-warm: #F5EDE4;
  --color-tag-cool: #ECF0ED;
  --color-tag-text: #8B6F5C;

  /* Shadows */
  --shadow-sm: 0 1rpx 4rpx rgba(44,36,22,0.04);
  --shadow-md: 0 4rpx 16rpx rgba(44,36,22,0.06);
  --shadow-lg: 0 8rpx 32rpx rgba(44,36,22,0.08);

  /* Typography */
  --font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
  --fs-xs: 20rpx;
  --fs-sm: 24rpx;
  --fs-base: 28rpx;
  --fs-md: 32rpx;
  --fs-lg: 36rpx;
  --fs-xl: 44rpx;
  --fs-2xl: 56rpx;
  --fs-3xl: 68rpx;
  --fw-normal: 400;
  --fw-medium: 500;
  --fw-semibold: 600;
  --lh-tight: 1.25;
  --lh-normal: 1.6;
  --lh-relaxed: 1.8;

  /* Spacing */
  --sp-2xs: 4rpx;
  --sp-xs: 8rpx;
  --sp-sm: 12rpx;
  --sp-md: 16rpx;
  --sp-lg: 24rpx;
  --sp-xl: 32rpx;
  --sp-2xl: 40rpx;
  --sp-3xl: 56rpx;
  --sp-4xl: 72rpx;

  /* Radius */
  --radius-sm: 6rpx;
  --radius-md: 12rpx;
  --radius-lg: 20rpx;
  --radius-xl: 28rpx;
  --radius-full: 999rpx;

  /* Transitions */
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);
  --dur-fast: 0.15s;
  --dur-normal: 0.25s;
  --dur-slow: 0.4s;

  background: var(--color-bg);
  color: var(--color-text);
  font-family: var(--font-family);
  font-size: var(--fs-base);
  line-height: var(--lh-normal);
}

/* ===== Animations ===== */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes fadeInScale {
  from { opacity: 0; transform: scale(0.95); }
  to { opacity: 1; transform: scale(1); }
}
@keyframes pulse-light {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.6; }
}
@keyframes shimmer {
  0% { background-position: -200% center; }
  100% { background-position: 200% center; }
}

.anim-fade-in { animation: fadeIn var(--dur-slow) var(--ease-out) forwards; }
.anim-fade-in-up { animation: fadeInUp 0.5s var(--ease-out) forwards; }
.anim-fade-in-up-1 { animation: fadeInUp 0.5s var(--ease-out) 0.05s both; }
.anim-fade-in-up-2 { animation: fadeInUp 0.5s var(--ease-out) 0.15s both; }
.anim-fade-in-up-3 { animation: fadeInUp 0.5s var(--ease-out) 0.25s both; }
.anim-fade-in-up-4 { animation: fadeInUp 0.5s var(--ease-out) 0.35s both; }
.anim-fade-in-up-5 { animation: fadeInUp 0.5s var(--ease-out) 0.45s both; }
.anim-pulse { animation: pulse-light 2s var(--ease-in-out) infinite; }

/* ===== Page ===== */
.page {
  min-height: 100vh;
  padding: var(--sp-lg);
  padding-bottom: calc(env(safe-area-inset-bottom) + 100rpx);
  background: var(--color-bg);
}

/* ===== Card Surfaces ===== */
.card {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: var(--sp-lg);
  box-shadow: var(--shadow-sm);
}
.card-warm { background: var(--color-surface-warm); }
.card-press { transition: transform var(--dur-fast) var(--ease-out); }
.card-press:active { transform: scale(0.98); }

/* ===== Typography ===== */
.title-1 {
  font-size: var(--fs-3xl);
  font-weight: var(--fw-semibold);
  line-height: var(--lh-tight);
  letter-spacing: 2rpx;
}
.title-2 {
  font-size: var(--fs-2xl);
  font-weight: var(--fw-semibold);
  line-height: var(--lh-tight);
}
.title-3 { font-size: var(--fs-xl); font-weight: var(--fw-medium); }
.title-4 { font-size: var(--fs-lg); font-weight: var(--fw-medium); }
.body-text { font-size: var(--fs-base); color: var(--color-text-secondary); line-height: var(--lh-relaxed); }
.body-sm { font-size: var(--fs-sm); color: var(--color-text-tertiary); }
.caption { font-size: var(--fs-xs); color: var(--color-text-tertiary); letter-spacing: 4rpx; }
.accent-text { color: var(--color-accent); }

/* ===== Buttons ===== */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-base);
  font-weight: var(--fw-medium);
  border-radius: var(--radius-full);
  padding: var(--sp-md) var(--sp-2xl);
  transition: transform var(--dur-fast);
  border: none;
}
.btn:active { transform: scale(0.97); }
.btn-primary { background: var(--color-text); color: var(--color-text-inverse); }
.btn-accent { background: var(--color-accent); color: var(--color-text-inverse); }
.btn-outline { background: transparent; border: 1.5rpx solid var(--color-border); color: var(--color-text); }
.btn-ghost { background: transparent; color: var(--color-text-secondary); padding: var(--sp-sm) var(--sp-md); }
.btn-block { width: 100%; }
.btn-lg { padding: var(--sp-lg) var(--sp-3xl); font-size: var(--fs-md); }

/* ===== Tags ===== */
.tag {
  display: inline-flex;
  font-size: var(--fs-xs);
  padding: var(--sp-2xs) var(--sp-sm);
  border-radius: var(--radius-full);
}
.tag-warm { background: var(--color-tag-warm); color: var(--color-accent); }
.tag-cool { background: var(--color-tag-cool); color: var(--color-accent-light); }
.tag-dark { background: var(--color-text); color: var(--color-text-inverse); }

/* ===== Input ===== */
.input-field {
  width: 100%;
  background: var(--color-surface);
  border: 1.5rpx solid var(--color-border);
  border-radius: var(--radius-md);
  padding: var(--sp-md) var(--sp-lg);
  font-size: var(--fs-base);
  color: var(--color-text);
}

/* ===== Section ===== */
.section { margin-bottom: var(--sp-3xl); }
.section-title {
  font-size: var(--fs-md);
  font-weight: var(--fw-semibold);
  margin-bottom: var(--sp-lg);
}
.section-title-center {
  font-size: var(--fs-lg);
  font-weight: var(--fw-semibold);
  text-align: center;
  margin-bottom: var(--sp-lg);
}

/* ===== Divider ===== */
.divider { height: 1rpx; background: var(--color-border); margin: var(--sp-lg) 0; }

/* ===== Flex/Spacing Utils ===== */
.flex { display: flex; }
.flex-col { flex-direction: column; }
.flex-center { align-items: center; justify-content: center; }
.flex-between { justify-content: space-between; }
.items-center { align-items: center; }
.gap-sm { gap: var(--sp-sm); }
.gap-md { gap: var(--sp-md); }
.gap-lg { gap: var(--sp-lg); }
.flex-1 { flex: 1; }
.text-center { text-align: center; }
.text-right { text-align: right; }

.mt-xs { margin-top: var(--sp-xs); }
.mt-sm { margin-top: var(--sp-sm); }
.mt-md { margin-top: var(--sp-md); }
.mt-lg { margin-top: var(--sp-lg); }
.mt-xl { margin-top: var(--sp-xl); }
.mt-2xl { margin-top: var(--sp-2xl); }
.mb-sm { margin-bottom: var(--sp-sm); }
.mb-md { margin-bottom: var(--sp-md); }
.mb-lg { margin-bottom: var(--sp-lg); }
.mb-xl { margin-bottom: var(--sp-xl); }
.mb-2xl { margin-bottom: var(--sp-2xl); }
.mb-3xl { margin-bottom: var(--sp-3xl); }

/* ===== Skeleton ===== */
.skeleton {
  background: linear-gradient(90deg, var(--color-bg-warm) 25%, var(--color-border) 50%, var(--color-bg-warm) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
  border-radius: var(--radius-sm);
}
.skeleton-text { height: 28rpx; margin-bottom: var(--sp-sm); }
.skeleton-text-sm { height: 20rpx; width: 60%; }
.skeleton-block { height: 200rpx; border-radius: var(--radius-md); }
.skeleton-circle { width: 96rpx; height: 96rpx; border-radius: var(--radius-full); }

/* ===== Error / Empty ===== */
.error-state { text-align: center; padding: var(--sp-4xl) var(--sp-2xl); }
.error-icon { font-size: 56rpx; margin-bottom: var(--sp-lg); opacity: 0.5; display: block; }
.error-text { font-size: var(--fs-base); color: var(--color-text-secondary); margin-bottom: var(--sp-sm); display: block; }
.error-hint { font-size: var(--fs-sm); color: var(--color-text-tertiary); margin-bottom: var(--sp-xl); display: block; }

.empty-state { text-align: center; padding: var(--sp-4xl) var(--sp-2xl); }
.empty-icon { font-size: 48rpx; margin-bottom: var(--sp-md); opacity: 0.4; display: block; }
.empty-text { font-size: var(--fs-base); color: var(--color-text-secondary); display: block; }
.empty-hint { font-size: var(--fs-sm); color: var(--color-text-tertiary); margin-top: var(--sp-xs); display: block; }

/* ===== Modal ===== */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(44,36,22,0.5);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}
.modal-content {
  width: 100%;
  background: var(--color-surface);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  padding: var(--sp-2xl) var(--sp-xl) calc(var(--sp-3xl) + env(safe-area-inset-bottom));
  max-height: 80vh;
  overflow-y: auto;
  animation: fadeInUp 0.3s var(--ease-out);
}
.modal-title {
  font-size: var(--fs-lg);
  font-weight: var(--fw-semibold);
  text-align: center;
  margin-bottom: var(--sp-xl);
  display: block;
}

/* ===== Filter Pills ===== */
.filter-row { display: flex; gap: var(--sp-sm); flex-wrap: wrap; }
.filter-pill {
  font-size: var(--fs-sm);
  padding: var(--sp-xs) var(--sp-lg);
  border-radius: var(--radius-full);
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  color: var(--color-text-secondary);
}
.filter-pill-active {
  background: var(--color-text);
  color: var(--color-text-inverse);
  border-color: var(--color-text);
}

/* ===== Badge ===== */
.badge {
  display: inline-block;
  font-size: var(--fs-xs);
  padding: 2rpx var(--sp-sm);
  border-radius: var(--radius-full);
}
.badge-gold { background: var(--color-tag-warm); color: var(--color-accent); }
.badge-success { background: var(--color-tag-cool); color: var(--color-accent-light); }
.badge-danger { background: #F5E8E8; color: #C06050; }

/* ===== Utilities ===== */
.relative { position: relative; }
.overflow-hidden { overflow: hidden; }
