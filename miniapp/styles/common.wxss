/* ---------- Drift keyframes for parallax effect ---------- */
@keyframes cosmic-drift-distant {
  0%   { transform: translate(0, 0); }
  25%  { transform: translate(6rpx, -10rpx); }
  50%  { transform: translate(-4rpx, 6rpx); }
  75%  { transform: translate(8rpx, -4rpx); }
  100% { transform: translate(0, 0); }
}

@keyframes cosmic-drift-mid {
  0%   { transform: translate(0, 0); }
  25%  { transform: translate(-12rpx, 8rpx); }
  50%  { transform: translate(10rpx, -15rpx); }
  75%  { transform: translate(-6rpx, 12rpx); }
  100% { transform: translate(0, 0); }
}

@keyframes cosmic-drift-close {
  0%   { transform: translate(0, 0); }
  25%  { transform: translate(18rpx, -12rpx); }
  50%  { transform: translate(-15rpx, 22rpx); }
  75%  { transform: translate(12rpx, -18rpx); }
  100% { transform: translate(0, 0); }
}

/* ---------- Shooting star ---------- */
.shooting-star {
  position: fixed;
  width: 160rpx;
  height: 2rpx;
  background: linear-gradient(to left, transparent, rgba(244, 212, 140, 0.70));
  border-radius: 1rpx;
  box-shadow: 0 0 8rpx rgba(244, 212, 140, 0.30), 0 0 24rpx rgba(244, 212, 140, 0.08);
  pointer-events: none;
  z-index: 1;
  animation: shooting-star 18s ease-out infinite;
}

/* Staggered delays spread shooting stars across the cycle (~ every 3-6s) */
.shooting-star--n2 { animation-delay: 4.5s; }
.shooting-star--n3 { animation-delay: 9s; }
.shooting-star--n4 { animation-delay: 13.5s; }
.shooting-star--n5 { animation-delay: 2s; }
.shooting-star--n6 { animation-delay: 7s; }
.shooting-star--n7 { animation-delay: 11s; }
.shooting-star--n8 { animation-delay: 16s; }

@keyframes shooting-star {
  0% {
    transform: translate(800rpx, -30rpx) rotate(-35deg);
    opacity: 0;
  }
  3% {
    opacity: 1;
  }
  8% {
    opacity: 0.90;
  }
  12% {
    transform: translate(-60rpx, 600rpx) rotate(-35deg);
    opacity: 0;
  }
  100% {
    transform: translate(-60rpx, 600rpx) rotate(-35deg);
    opacity: 0;
  }
}

/* ---------- Nebula glow ---------- */
.cosmic-nebula {
  position: fixed;
  top: -300rpx;
  right: -300rpx;
  width: 800rpx;
  height: 800rpx;
  background: radial-gradient(
    circle at 35% 35%,
    rgba(184, 169, 224, 0.06) 0%,
    rgba(244, 212, 140, 0.03) 20%,
    transparent 55%
  );
  pointer-events: none;
  z-index: 0;
  animation: rotate-nebula 45s ease-in-out infinite;
}

@keyframes rotate-nebula {
  0%   { transform: rotate(0deg) scale(1); }
  50%  { transform: rotate(180deg) scale(1.08); }
  100% { transform: rotate(360deg) scale(1); }
}

/* -----------------------------------------------------------
   3. RADIAL GLOW — Hero backdrop
   ----------------------------------------------------------- */

.glow-hero {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 500rpx;
  height: 500rpx;
  margin-left: -250rpx;
  margin-top: -250rpx;
  background: radial-gradient(
    circle at center,
    rgba(244, 212, 140, 0.10) 0%,
    rgba(244, 212, 140, 0.04) 30%,
    transparent 70%
  );
  pointer-events: none;
  z-index: 0;
}

.glow-hero--lavender {
  background: radial-gradient(
    circle at center,
    rgba(184, 169, 224, 0.10) 0%,
    rgba(184, 169, 224, 0.04) 30%,
    transparent 70%
  );
}

.glow-bottom {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 300rpx;
  background: linear-gradient(
    to top,
    rgba(244, 212, 140, 0.06) 0%,
    transparent 100%
  );
  pointer-events: none;
  z-index: 0;
}

