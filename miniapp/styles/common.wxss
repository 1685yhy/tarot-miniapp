/* ============================================================
   Warm Paper — Luxury Stationery Design System
   Palette: Warm ivory paper, deep rose accent, sage subtle
   Tone: Textured, restrained, confident. No dark mode.
   Inspired by: High-end letterpress, archival paper,
   Italian stationery brands, warm editorial
   ============================================================ */

/* -----------------------------------------------------------
   1. DESIGN TOKENS (CSS Custom Properties)
   ----------------------------------------------------------- */

page {
  /* --- Color Palette (MAX 6 semantic colors) --- */
  --color-bg: #FBF8F4;              /* Warm ivory — page background */
  --color-surface: #FFFDFA;         /* Slightly lighter — card surface */
  --color-text-primary: #3D3228;    /* Warm dark brown — primary text */
  --color-text-secondary: #8B7E6E;  /* Warm taupe — secondary text */
  --color-accent: #B06650;          /* Deep rose — single accent */
  --color-subtle: #A3B5A6;          /* Warm sage — secondary accent */

  /* --- Status Colors (functional, not decorative) --- */
  --color-success: #7AA58A;
  --color-warning: #C4A46C;
  --color-error: #B06650;
  --color-info: #7A9BB8;
  --color-success-bg: rgba(122, 165, 138, 0.10);
  --color-warning-bg: rgba(196, 164, 108, 0.10);
  --color-error-bg: rgba(176, 102, 80, 0.10);
  --color-info-bg: rgba(122, 155, 184, 0.10);

  /* --- Overlay --- */
  --color-overlay: rgba(61, 50, 40, 0.50);
  --color-overlay-light: rgba(61, 50, 40, 0.25);

  /* --- Shadows (warm brown tones, 3 levels) --- */
  --shadow-subtle: 0 2rpx 4rpx rgba(61, 50, 40, 0.06);
  --shadow-medium: 0 4rpx 16rpx rgba(61, 50, 40, 0.08);
  --shadow-deep: 0 8rpx 48rpx rgba(61, 50, 40, 0.12);

  /* --- Typography (MAX 4 sizes) --- */
  --font-size-body: 26rpx;
  --font-size-body-large: 30rpx;
  --font-size-subhead: 36rpx;
  --font-size-display: 52rpx;
  --line-height-body: 1.5;
  --line-height-heading: 1.3;
  --font-weight-normal: 400;
  --font-weight-medium: 500;
  --font-weight-semibold: 600;
  --font-weight-bold: 700;
  --letter-spacing-display: 2rpx;
  --letter-spacing-none: 0;

  /* --- Spacing Scale (4-base: 4, 8, 12, 16, 24, 32, 48, 64) --- */
  --spacing-1: 4rpx;
  --spacing-2: 8rpx;
  --spacing-3: 12rpx;
  --spacing-4: 16rpx;
  --spacing-5: 24rpx;
  --spacing-6: 32rpx;
  --spacing-7: 48rpx;
  --spacing-8: 64rpx;

  /* --- Border Radius (EXACTLY 3 values) --- */
  --radius-small: 8rpx;
  --radius-medium: 16rpx;
  --radius-pill: 999rpx;

  /* --- Animation Timing (ONLY 3 tokens) --- */
  --duration-feedback: 150ms;
  --duration-navigation: 300ms;
  --duration-emphasis: 500ms;

  /* --- Layout --- */
  --page-padding: 32rpx;
  --page-padding-wide: 48rpx;
  --page-max-width: 750rpx;
  --safe-area-bottom: env(safe-area-inset-bottom, 0px);

  /* --- Z-Index Scale --- */
  --z-base: 1;
  --z-card: 10;
  --z-sticky: 100;
  --z-overlay: 500;
  --z-modal: 1000;
  --z-toast: 2000;

  /* --- Apply to page --- */
  background: var(--color-bg);
  font-family: -apple-system, BlinkMacSystemFont, 'Noto Serif SC', 'PingFang SC', 'Songti SC', serif;
  font-size: var(--font-size-body);
  line-height: var(--line-height-body);
  color: var(--color-text-primary);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* -----------------------------------------------------------
   2. DECORATIVE ELEMENTS — stripped to minimal skeletons
   (class names preserved for compatibility)
   ----------------------------------------------------------- */

.starfield {
  display: none;
}

.star {
  display: none;
}

.star--dim {
  display: none;
}

.star--bright {
  display: none;
}

.cosmic-layer-distant,
.cosmic-layer-mid,
.cosmic-layer-close {
  display: none;
}

.shooting-star {
  display: none;
}

.shooting-star--n2,
.shooting-star--n3,
.shooting-star--n4,
.shooting-star--n5,
.shooting-star--n6,
.shooting-star--n7,
.shooting-star--n8 {
  display: none;
}

.cosmic-nebula {
  display: none;
}

.glow-hero {
  display: none;
}

.glow-hero--lavender {
  display: none;
}

.glow-bottom {
  display: none;
}

/* -----------------------------------------------------------
   3. TYPOGRAPHY
   ----------------------------------------------------------- */

.heading-1 {
  font-size: var(--font-size-display);
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
  line-height: var(--line-height-heading);
  letter-spacing: var(--letter-spacing-display);
}

.heading-2 {
  font-size: var(--font-size-subhead);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  line-height: var(--line-height-heading);
  letter-spacing: var(--letter-spacing-none);
}

.heading-3 {
  font-size: var(--font-size-body-large);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  line-height: var(--line-height-heading);
  letter-spacing: var(--letter-spacing-none);
}

.heading-4 {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  line-height: var(--line-height-body);
  letter-spacing: var(--letter-spacing-none);
}

.title-lg {
  font-size: var(--font-size-subhead);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  line-height: var(--line-height-heading);
  letter-spacing: var(--letter-spacing-none);
}

.title-md {
  font-size: var(--font-size-body-large);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  line-height: var(--line-height-body);
  letter-spacing: var(--letter-spacing-none);
}

.body-text {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-normal);
  color: var(--color-text-primary);
  line-height: var(--line-height-body);
  letter-spacing: var(--letter-spacing-none);
}

.body-text--secondary {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-normal);
  color: var(--color-text-secondary);
  line-height: var(--line-height-body);
  letter-spacing: var(--letter-spacing-none);
}

.body-small {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-normal);
  color: var(--color-text-secondary);
  line-height: var(--line-height-body);
  letter-spacing: var(--letter-spacing-none);
}

.caption {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-normal);
  color: var(--color-text-secondary);
  line-height: var(--line-height-body);
  letter-spacing: var(--letter-spacing-none);
}

.label {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  line-height: var(--line-height-heading);
  letter-spacing: var(--letter-spacing-none);
}

/* Number / Data Highlight */
.number-gold {
  font-size: var(--font-size-subhead);
  font-weight: var(--font-weight-bold);
  color: var(--color-accent);
  line-height: var(--line-height-heading);
}

.number-gold-lg {
  font-size: var(--font-size-display);
  font-weight: var(--font-weight-bold);
  color: var(--color-accent);
  line-height: var(--line-height-heading);
}

.number-lavender {
  font-size: var(--font-size-subhead);
  font-weight: var(--font-weight-bold);
  color: var(--color-subtle);
  line-height: var(--line-height-heading);
}

/* Decorative dividers */
.divider {
  height: 1rpx;
  background: var(--color-text-secondary);
  opacity: 0.15;
  margin: var(--spacing-6) 0;
  border: none;
}

.divider--lavender {
  background: var(--color-subtle);
  opacity: 0.15;
}

.divider--vertical {
  width: 1rpx;
  height: 100%;
  background: var(--color-text-secondary);
  opacity: 0.15;
  margin: 0 var(--spacing-5);
  border: none;
}

/* -----------------------------------------------------------
   4. BUTTONS
   ----------------------------------------------------------- */

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-medium);
  line-height: var(--line-height-heading);
  border-radius: var(--radius-pill);
  padding: var(--spacing-5) var(--spacing-7);
  transition: all var(--duration-feedback) ease;
  position: relative;
  overflow: hidden;
}

/* Primary — Solid accent */
.btn-primary {
  background: var(--color-accent);
  color: var(--color-surface);
  box-shadow: var(--shadow-subtle);
}

.btn-primary:active {
  transform: scale(0.97);
  box-shadow: var(--shadow-subtle);
  opacity: 0.90;
}

.btn-primary--disabled,
.btn-primary[disabled] {
  background: rgba(176, 102, 80, 0.15);
  color: var(--color-text-secondary);
  box-shadow: none;
  pointer-events: none;
}

/* Secondary — Outline */
.btn-secondary {
  background: transparent;
  color: var(--color-accent);
  border: 1rpx solid var(--color-accent);
  box-shadow: none;
}

.btn-secondary:active {
  background: rgba(176, 102, 80, 0.06);
  transform: scale(0.97);
}

.btn-secondary--disabled,
.btn-secondary[disabled] {
  border-color: rgba(176, 102, 80, 0.15);
  color: rgba(176, 102, 80, 0.30);
  pointer-events: none;
}

/* Ghost — Subtle text button */
.btn-ghost {
  background: transparent;
  color: var(--color-text-secondary);
  border: none;
  padding: var(--spacing-4) var(--spacing-5);
  box-shadow: none;
}

.btn-ghost:active {
  color: var(--color-accent);
  background: rgba(176, 102, 80, 0.04);
}

/* Special — Outline accent */
.btn-glow {
  background: transparent;
  color: var(--color-accent);
  border: 1rpx solid rgba(176, 102, 80, 0.25);
  box-shadow: none;
}

.btn-glow:active {
  background: rgba(176, 102, 80, 0.06);
  border-color: var(--color-accent);
  transform: scale(0.97);
}

/* Variants */
.btn--full {
  width: 100%;
}

.btn--sm {
  font-size: var(--font-size-body);
  padding: var(--spacing-3) var(--spacing-5);
}

.btn--lg {
  font-size: var(--font-size-body-large);
  padding: var(--spacing-6) var(--spacing-8);
}

.btn--icon {
  padding: var(--spacing-4);
  min-width: 80rpx;
  min-height: 80rpx;
  border-radius: var(--radius-medium);
}

/* -----------------------------------------------------------
   5. CARDS
   ----------------------------------------------------------- */

.card {
  background: var(--color-surface);
  border: 1rpx solid rgba(139, 126, 110, 0.12);
  border-radius: var(--radius-medium);
  padding: var(--spacing-5);
  box-shadow: var(--shadow-subtle);
  transition: all var(--duration-navigation) ease;
}

.card:active {
  border-color: rgba(176, 102, 80, 0.20);
  box-shadow: var(--shadow-medium);
  transform: translateY(-2rpx);
}

.card--glass {
  background: rgba(255, 253, 250, 0.80);
  border: 1rpx solid rgba(139, 126, 110, 0.10);
}

.card--elevated {
  box-shadow: var(--shadow-medium);
}

.card--glow {
  border-color: rgba(176, 102, 80, 0.15);
  box-shadow: var(--shadow-medium);
}

.card--compact {
  padding: var(--spacing-4);
}

.card--spacious {
  padding: var(--spacing-6);
}

.card--no-pad {
  padding: 0;
}

/* Card header */
.card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-4);
}

.card__title {
  font-size: var(--font-size-body-large);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.card__subtitle {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  margin-top: var(--spacing-2);
}

.card__body {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  line-height: var(--line-height-body);
}

.card__footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: var(--spacing-4);
  padding-top: var(--spacing-4);
  border-top: 1rpx solid rgba(139, 126, 110, 0.10);
}

/* -----------------------------------------------------------
   6. FORM ELEMENTS
   ----------------------------------------------------------- */

.input-wrapper {
  position: relative;
  width: 100%;
}

.input {
  width: 100%;
  height: 88rpx;
  background: var(--color-surface);
  border: 1rpx solid rgba(139, 126, 110, 0.20);
  border-radius: var(--radius-small);
  padding: 0 var(--spacing-5);
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  line-height: var(--line-height-heading);
  transition: border-color var(--duration-feedback) ease, box-shadow var(--duration-feedback) ease;
  box-sizing: border-box;
}

.input::placeholder {
  color: var(--color-text-secondary);
  opacity: 0.50;
}

.input:focus {
  border-color: var(--color-accent);
  box-shadow: 0 0 0 2rpx rgba(176, 102, 80, 0.10);
}

.input--error {
  border-color: var(--color-error);
  box-shadow: 0 0 0 2rpx rgba(176, 102, 80, 0.10);
}

.input--success {
  border-color: var(--color-success);
  box-shadow: 0 0 0 2rpx rgba(122, 165, 138, 0.10);
}

.input--textarea {
  height: 200rpx;
  padding: var(--spacing-5);
  line-height: var(--line-height-body);
}

.input--pill {
  border-radius: var(--radius-pill);
  padding-left: var(--spacing-6);
  padding-right: var(--spacing-6);
}

.input-label {
  display: block;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-3);
}

.input-hint {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  margin-top: var(--spacing-2);
  line-height: var(--line-height-body);
}

.input-hint--error {
  color: var(--color-error);
}

/* Select / Picker */
.picker {
  width: 100%;
  height: 88rpx;
  background: var(--color-surface);
  border: 1rpx solid rgba(139, 126, 110, 0.20);
  border-radius: var(--radius-small);
  padding: 0 var(--spacing-5);
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  line-height: 88rpx;
  transition: border-color var(--duration-feedback) ease;
  box-sizing: border-box;
  position: relative;
}

.picker:active {
  border-color: rgba(176, 102, 80, 0.25);
}

.picker--placeholder {
  color: var(--color-text-secondary);
  opacity: 0.50;
}

/* Checkbox / Radio */
.check-group {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-4);
}

.check-item {
  display: flex;
  align-items: center;
  padding: var(--spacing-3) var(--spacing-4);
  background: var(--color-surface);
  border: 1rpx solid rgba(139, 126, 110, 0.12);
  border-radius: var(--radius-pill);
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  transition: all var(--duration-feedback) ease;
}

.check-item:active {
  border-color: var(--color-accent);
  color: var(--color-text-primary);
}

.check-item--active {
  background: rgba(176, 102, 80, 0.06);
  border-color: var(--color-accent);
  color: var(--color-accent);
}

/* -----------------------------------------------------------
   7. LAYOUT & CONTAINERS
   ----------------------------------------------------------- */

.page {
  min-height: 100vh;
  padding: var(--page-padding);
  padding-bottom: calc(var(--page-padding) + var(--safe-area-bottom));
  position: relative;
  z-index: var(--z-base);
  background: var(--color-bg);
}

.page--wide {
  padding-left: var(--page-padding-wide);
  padding-right: var(--page-padding-wide);
}

.page--no-pad {
  padding: 0;
}

.section {
  margin-bottom: var(--spacing-7);
}

.section--last {
  margin-bottom: 0;
}

.section__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-5);
}

.section__title {
  font-size: var(--font-size-body-large);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.section__action {
  font-size: var(--font-size-body);
  color: var(--color-accent);
  font-weight: var(--font-weight-medium);
}

.section__action:active {
  opacity: 0.70;
}

/* Flex Utilities */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-wrap {
  flex-wrap: wrap;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-around {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.flex-1 {
  flex: 1;
}

.gap-xs {
  gap: var(--spacing-3);
}

.gap-sm {
  gap: var(--spacing-4);
}

.gap-md {
  gap: var(--spacing-5);
}

.gap-lg {
  gap: var(--spacing-6);
}

/* Grid (2-column) */
.grid-2 {
  display: flex;
  flex-flow: row wrap;
  margin: calc(-1 * var(--spacing-3));
}

.grid-2 > view {
  width: calc(50% - var(--spacing-3) * 2);
  margin: var(--spacing-3);
}

/* Hero Area */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: var(--spacing-7) var(--spacing-5);
  position: relative;
  min-height: 400rpx;
}

.hero__title {
  font-size: var(--font-size-display);
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
  line-height: var(--line-height-heading);
  letter-spacing: var(--letter-spacing-display);
  margin-bottom: var(--spacing-4);
}

.hero__subtitle {
  font-size: var(--font-size-body-large);
  color: var(--color-text-secondary);
  line-height: var(--line-height-body);
  max-width: 600rpx;
}

.hero__accent {
  color: var(--color-accent);
}

.hero__icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: var(--spacing-6);
  opacity: 0.80;
}

/* -----------------------------------------------------------
   8. NAVIGATION
   ----------------------------------------------------------- */

/* Bottom Tab Bar */
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: calc(100rpx + var(--safe-area-bottom));
  padding-bottom: var(--safe-area-bottom);
  background: var(--color-surface);
  border-top: 1rpx solid rgba(139, 126, 110, 0.12);
  z-index: var(--z-sticky);
  box-shadow: 0 -2rpx 8rpx rgba(61, 50, 40, 0.04);
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 100%;
  padding: var(--spacing-2) 0;
  position: relative;
}

.tab-item__icon {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 6rpx;
  opacity: 0.40;
  transition: opacity var(--duration-navigation) ease;
}

.tab-item__label {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  line-height: 1.2;
  transition: color var(--duration-navigation) ease;
}

.tab-item--active .tab-item__icon {
  opacity: 1;
}

.tab-item--active .tab-item__label {
  color: var(--color-accent);
  font-weight: var(--font-weight-medium);
}

.tab-item--active::after {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  width: 40rpx;
  height: 2rpx;
  background: var(--color-accent);
  border-radius: 1rpx;
  margin-left: -20rpx;
}

/* Nav Bar (top) */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 var(--page-padding);
  position: relative;
  z-index: var(--z-sticky);
  border-bottom: 1rpx solid rgba(139, 126, 110, 0.08);
}

.nav-bar__title {
  font-size: var(--font-size-body-large);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
}

.nav-bar__back {
  display: flex;
  align-items: center;
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  padding: var(--spacing-2);
}

.nav-bar__back:active {
  color: var(--color-accent);
}

.nav-bar__right {
  display: flex;
  align-items: center;
  gap: var(--spacing-3);
}

/* -----------------------------------------------------------
   9. TOASTS & NOTIFICATIONS
   ----------------------------------------------------------- */

.toast {
  position: fixed;
  top: 120rpx;
  left: 50%;
  transform: translateX(-50%);
  min-width: 200rpx;
  max-width: 600rpx;
  padding: var(--spacing-4) var(--spacing-6);
  background: var(--color-surface);
  border: 1rpx solid rgba(139, 126, 110, 0.15);
  border-radius: var(--radius-pill);
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  text-align: center;
  box-shadow: var(--shadow-medium);
  z-index: var(--z-toast);
  animation: fade-up var(--duration-navigation) ease forwards;
  letter-spacing: var(--letter-spacing-none);
}

.toast--success {
  border-color: rgba(122, 165, 138, 0.30);
  color: var(--color-success);
}

.toast--error {
  border-color: rgba(176, 102, 80, 0.30);
  color: var(--color-error);
}

/* Badge / Tag */
.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 4rpx var(--spacing-4);
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-medium);
  line-height: 1.3;
  border-radius: var(--radius-pill);
  color: var(--color-text-secondary);
  background: var(--color-surface);
  border: 1rpx solid rgba(139, 126, 110, 0.15);
}

.badge--gold {
  background: rgba(176, 102, 80, 0.08);
  color: var(--color-accent);
  border-color: rgba(176, 102, 80, 0.15);
}

.badge--lavender {
  background: rgba(163, 181, 166, 0.10);
  color: var(--color-subtle);
  border-color: rgba(163, 181, 166, 0.18);
}

.badge--success {
  background: var(--color-success-bg);
  color: var(--color-success);
  border-color: transparent;
}

.badge--warning {
  background: var(--color-warning-bg);
  color: var(--color-warning);
  border-color: transparent;
}

.badge--error {
  background: var(--color-error-bg);
  color: var(--color-error);
  border-color: transparent;
}

.badge--dot {
  width: 12rpx;
  height: 12rpx;
  padding: 0;
  border-radius: var(--radius-pill);
  min-width: 0;
}

/* -----------------------------------------------------------
   10. LIST / MENU ITEMS
   ----------------------------------------------------------- */

.list-item {
  display: flex;
  align-items: center;
  padding: var(--spacing-5);
  background: var(--color-surface);
  border: 1rpx solid rgba(139, 126, 110, 0.10);
  border-radius: var(--radius-small);
  transition: all var(--duration-feedback) ease;
}

.list-item:active {
  border-color: rgba(176, 102, 80, 0.15);
  box-shadow: var(--shadow-subtle);
}

.list-item + .list-item {
  margin-top: var(--spacing-3);
}

.list-item__icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: var(--spacing-4);
  flex-shrink: 0;
}

.list-item__content {
  flex: 1;
  min-width: 0;
}

.list-item__title {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  line-height: var(--line-height-heading);
}

.list-item__desc {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  line-height: var(--line-height-body);
  margin-top: var(--spacing-1);
}

.list-item__right {
  flex-shrink: 0;
  margin-left: var(--spacing-4);
}

.list-item__arrow {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.25;
}

/* -----------------------------------------------------------
   11. LOADING & EMPTY STATES
   ----------------------------------------------------------- */

.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-7) 0;
}

.loading__spinner {
  width: 48rpx;
  height: 48rpx;
  border: 2rpx solid rgba(139, 126, 110, 0.15);
  border-top-color: var(--color-accent);
  border-radius: var(--radius-pill);
  animation: spin var(--duration-emphasis) linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading__text {
  margin-top: var(--spacing-5);
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
}

/* Skeleton */
.skeleton {
  background: rgba(139, 126, 110, 0.08);
  border-radius: var(--radius-small);
  animation: pulse-soft 1500ms ease-in-out infinite;
}

@keyframes pulse-soft {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.40; }
}

.skeleton--text {
  height: 26rpx;
  width: 100%;
  margin-bottom: var(--spacing-3);
}

.skeleton--title {
  height: 32rpx;
  width: 60%;
  margin-bottom: var(--spacing-4);
}

.skeleton--avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-pill);
}

.skeleton--card {
  height: 200rpx;
  border-radius: var(--radius-medium);
}

/* Empty State */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-8) var(--spacing-5);
  text-align: center;
}

.empty__icon {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: var(--spacing-6);
  opacity: 0.30;
}

.empty__title {
  font-size: var(--font-size-body-large);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-secondary);
  margin-bottom: var(--spacing-3);
}

.empty__desc {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  opacity: 0.70;
  line-height: var(--line-height-body);
  max-width: 500rpx;
}

/* -----------------------------------------------------------
   12. MODAL & OVERLAY
   ----------------------------------------------------------- */

.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--color-overlay);
  z-index: var(--z-overlay);
  animation: fade-in var(--duration-navigation) ease forwards;
}

@keyframes fade-in {
  0% { opacity: 0; }
  100% { opacity: 1; }
}

.modal {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--color-surface);
  border-radius: var(--radius-medium) var(--radius-medium) 0 0;
  z-index: var(--z-modal);
  padding: var(--spacing-6) var(--page-padding) calc(var(--spacing-7) + var(--safe-area-bottom));
  animation: slide-in var(--duration-navigation) ease forwards;
  box-shadow: 0 -4rpx 24rpx rgba(61, 50, 40, 0.10);
}

@keyframes slide-in {
  0% {
    transform: translateY(100%);
  }
  100% {
    transform: translateY(0);
  }
}

.modal--center {
  top: 50%;
  bottom: auto;
  left: 50%;
  right: auto;
  width: 600rpx;
  border-radius: var(--radius-medium);
  padding: var(--spacing-7);
  opacity: 0;
  animation: fade-in var(--duration-navigation) ease forwards;
}

.modal__handle {
  width: 48rpx;
  height: 4rpx;
  background: rgba(139, 126, 110, 0.20);
  border-radius: var(--radius-pill);
  margin: 0 auto var(--spacing-5);
}

.modal__header {
  text-align: center;
  margin-bottom: var(--spacing-5);
}

.modal__title {
  font-size: var(--font-size-subhead);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.modal__body {
  margin-bottom: var(--spacing-6);
}

.modal__footer {
  display: flex;
  gap: var(--spacing-4);
}

/* -----------------------------------------------------------
   13. AVATAR
   ----------------------------------------------------------- */

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-pill);
  border: 2rpx solid rgba(139, 126, 110, 0.12);
  overflow: hidden;
  flex-shrink: 0;
  background: var(--color-surface);
}

.avatar--sm {
  width: 56rpx;
  height: 56rpx;
}

.avatar--lg {
  width: 120rpx;
  height: 120rpx;
}

.avatar--glow {
  border-color: rgba(176, 102, 80, 0.20);
}

.avatar--ring {
  border-width: 2rpx;
  border-color: var(--color-accent);
}

/* -----------------------------------------------------------
   14. PROGRESS BAR
   ----------------------------------------------------------- */

.progress {
  width: 100%;
  height: 6rpx;
  background: rgba(139, 126, 110, 0.12);
  border-radius: var(--radius-pill);
  overflow: hidden;
}

.progress__fill {
  height: 100%;
  background: var(--color-accent);
  border-radius: var(--radius-pill);
  transition: width var(--duration-emphasis) ease;
}

.progress--lavender .progress__fill {
  background: var(--color-subtle);
}

/* -----------------------------------------------------------
   15. ANIMATION KEYFRAMES & UTILITY CLASSES
   MAX 8 keyframe definitions total
   ONLY 3 timing tokens: 150ms, 300ms, 500ms
   KEPT: fade-in, fade-up, scale-press, gentle-breath, slide-in
   ----------------------------------------------------------- */

/* 1. fade-in — already defined above in Modal section */
/* 2. fade-up */
@keyframes fade-up {
  0% {
    opacity: 0;
    transform: translateY(12rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 3. scale-press — feedback for press interactions */
@keyframes scale-press {
  0% { transform: scale(1); }
  50% { transform: scale(0.96); }
  100% { transform: scale(1); }
}

/* 4. gentle-breath — subtle scale pulse for cards */
@keyframes gentle-breath {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.01); }
}

/* 5. slide-in — already defined above for modal */
/* 6. spin — already defined above for loading spinner */
/* 7. pulse-soft — already defined above for skeleton */
/* 8. modal-center-in — already defined above */

/* Animation Utility Classes */

.anim-fade-up {
  animation: fade-up var(--duration-navigation) ease forwards;
}

.anim-fade-in {
  animation: fade-in var(--duration-navigation) ease forwards;
}

.anim-breathe {
  animation: gentle-breath 3000ms ease-in-out infinite;
}

/* Scale press — for tap feedback on cards */
.anim-scale-press:active {
  animation: scale-press var(--duration-feedback) ease;
}

/* Entrance — Slide up from below */
.anim-slide-up {
  animation: slide-in var(--duration-navigation) ease forwards;
}

/* Staggered children delays */
.anim-stagger-1 { animation-delay: 50ms; }
.anim-stagger-2 { animation-delay: 100ms; }
.anim-stagger-3 { animation-delay: 150ms; }
.anim-stagger-4 { animation-delay: 200ms; }
.anim-stagger-5 { animation-delay: 250ms; }
.anim-stagger-6 { animation-delay: 300ms; }
.anim-stagger-7 { animation-delay: 350ms; }
.anim-stagger-8 { animation-delay: 400ms; }
.anim-stagger-9 { animation-delay: 450ms; }
.anim-stagger-10 { animation-delay: 500ms; }

/* Legacy anim classes preserved as compat shims */
.anim-pulse-glow,
.anim-glow-gold,
.anim-glow-lav {
  display: none;
}

.anim-shimmer,
.anim-float,
.anim-drift,
.anim-rotate-cosmic,
.anim-bounce-in,
.anim-rise,
.anim-reveal,
.anim-ripple,
.anim-ripple--lav,
.anim-twinkle-fast,
.anim-star-burst,
.anim-count-pulse,
.anim-rise-1,
.anim-rise-2,
.anim-rise-3,
.anim-rise-4,
.anim-rise-5 {
  /* Preserved for compatibility — no decorative animations */
}

/* Page-level transitions */
.page-skeleton-exit {
  opacity: 0;
  transition: opacity var(--duration-navigation) ease;
  pointer-events: none;
}

.page-content-entering {
  opacity: 0;
  animation: fade-up var(--duration-emphasis) ease forwards;
}

/* Tab shimmer — simplified to a subtle fade */
.tab-shimmer {
  animation: fade-in var(--duration-navigation) ease;
}

/* Error animations */
.error-shake {
  animation: fade-in var(--duration-feedback) ease reverse;
}

.error-fade-out {
  animation: fade-in var(--duration-navigation) ease reverse forwards;
}

.content-slide-in {
  animation: fade-up var(--duration-emphasis) ease forwards;
}

/* Empty state icon */
.empty-icon-animated {
  animation: gentle-breath 3000ms ease-in-out infinite;
}

/* List entrance */
.list-entrance-item {
  opacity: 0;
  animation: fade-up var(--duration-emphasis) ease forwards;
}

.list-entrance-item:nth-child(1)  { animation-delay: 40ms; }
.list-entrance-item:nth-child(2)  { animation-delay: 80ms; }
.list-entrance-item:nth-child(3)  { animation-delay: 120ms; }
.list-entrance-item:nth-child(4)  { animation-delay: 160ms; }
.list-entrance-item:nth-child(5)  { animation-delay: 200ms; }
.list-entrance-item:nth-child(6)  { animation-delay: 240ms; }
.list-entrance-item:nth-child(7)  { animation-delay: 280ms; }
.list-entrance-item:nth-child(8)  { animation-delay: 320ms; }
.list-entrance-item:nth-child(9)  { animation-delay: 360ms; }
.list-entrance-item:nth-child(10) { animation-delay: 400ms; }
.list-entrance-item:nth-child(11) { animation-delay: 440ms; }
.list-entrance-item:nth-child(12) { animation-delay: 480ms; }

/* -----------------------------------------------------------
   16. SPACING UTILITIES
   Spacing scale: 4, 8, 12, 16, 24, 32, 48, 64
   ----------------------------------------------------------- */

.mt-xxs { margin-top: var(--spacing-2); }
.mt-xs { margin-top: var(--spacing-3); }
.mt-sm { margin-top: var(--spacing-4); }
.mt-md { margin-top: var(--spacing-5); }
.mt-lg { margin-top: var(--spacing-6); }
.mt-xl { margin-top: var(--spacing-7); }
.mt-2xl { margin-top: var(--spacing-8); }

.mb-xxs { margin-bottom: var(--spacing-2); }
.mb-xs { margin-bottom: var(--spacing-3); }
.mb-sm { margin-bottom: var(--spacing-4); }
.mb-md { margin-bottom: var(--spacing-5); }
.mb-lg { margin-bottom: var(--spacing-6); }
.mb-xl { margin-bottom: var(--spacing-7); }
.mb-2xl { margin-bottom: var(--spacing-8); }

.pt-xxs { padding-top: var(--spacing-2); }
.pt-xs { padding-top: var(--spacing-3); }
.pt-sm { padding-top: var(--spacing-4); }
.pt-md { padding-top: var(--spacing-5); }
.pt-lg { padding-top: var(--spacing-6); }
.pt-xl { padding-top: var(--spacing-7); }

.pb-xxs { padding-bottom: var(--spacing-2); }
.pb-xs { padding-bottom: var(--spacing-3); }
.pb-sm { padding-bottom: var(--spacing-4); }
.pb-md { padding-bottom: var(--spacing-5); }
.pb-lg { padding-bottom: var(--spacing-6); }
.pb-xl { padding-bottom: var(--spacing-7); }

.p-sm { padding: var(--spacing-4); }
.p-md { padding: var(--spacing-5); }
.p-lg { padding: var(--spacing-6); }
.p-xl { padding: var(--spacing-7); }

/* -----------------------------------------------------------
   17. TEXT ALIGNMENT & STYLING UTILITIES
   ----------------------------------------------------------- */

.text-left { text-align: left; }
.text-center { text-align: center; }
.text-right { text-align: right; }

.text-primary { color: var(--color-text-primary); }
.text-secondary { color: var(--color-text-secondary); }
.text-tertiary { color: var(--color-text-secondary); opacity: 0.60; }
.text-gold { color: var(--color-accent); }
.text-lavender { color: var(--color-subtle); }
.text-success { color: var(--color-success); }
.text-warning { color: var(--color-warning); }
.text-error { color: var(--color-error); }

.text-bold { font-weight: var(--font-weight-bold); }
.text-semibold { font-weight: var(--font-weight-semibold); }
.text-medium { font-weight: var(--font-weight-medium); }
.text-normal { font-weight: var(--font-weight-normal); }

.text-sm { font-size: var(--font-size-body); }
.text-base { font-size: var(--font-size-body); }
.text-md { font-size: var(--font-size-body-large); }
.text-lg { font-size: var(--font-size-subhead); }
.text-xl { font-size: var(--font-size-display); }

.text-truncate {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.text-2lines {
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* -----------------------------------------------------------
   18. VISIBILITY & POSITIONING
   ----------------------------------------------------------- */

.hidden {
  display: none !important;
}

.invisible {
  opacity: 0;
  pointer-events: none;
}

.relative {
  position: relative;
}

.absolute {
  position: absolute;
}

.fixed {
  position: fixed;
}

.full-width {
  width: 100%;
}

.full-height {
  height: 100%;
}

.overflow-hidden {
  overflow: hidden;
}

.z-1 { z-index: var(--z-base); }
.z-card { z-index: var(--z-card); }
.z-sticky { z-index: var(--z-sticky); }
.z-overlay { z-index: var(--z-overlay); }
.z-modal { z-index: var(--z-modal); }

/* -----------------------------------------------------------
   19. SCROLLBAR STYLING
   ----------------------------------------------------------- */

::-webkit-scrollbar {
  width: 4rpx;
  height: 4rpx;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: rgba(139, 126, 110, 0.15);
  border-radius: 2rpx;
}

::webkit-scrollbar-thumb:active {
  background: rgba(139, 126, 110, 0.30);
}

/* -----------------------------------------------------------
   20. SAFE AREA & BOTTOM SPACING
   ----------------------------------------------------------- */

.safe-bottom {
  padding-bottom: var(--safe-area-bottom);
}

.safe-top {
  padding-top: var(--status-bar-height, 44rpx);
}

/* -----------------------------------------------------------
   21. MISC COMPOSITION HELPERS
   ----------------------------------------------------------- */

/* Floating action button */
.fab {
  position: fixed;
  right: var(--page-padding);
  bottom: calc(120rpx + var(--safe-area-bottom));
  width: 100rpx;
  height: 100rpx;
  border-radius: var(--radius-pill);
  background: var(--color-accent);
  box-shadow: var(--shadow-medium);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: var(--z-card);
  transition: transform var(--duration-feedback) ease, box-shadow var(--duration-feedback) ease;
}

.fab:active {
  transform: scale(0.94);
  box-shadow: var(--shadow-subtle);
}

.fab__icon {
  width: 44rpx;
  height: 44rpx;
}

/* Planet dot — preserved as empty for compatibility */
.planet-dot {
  display: none;
}

/* Reading progress indicator */
.reading-progress {
  width: 100%;
  height: 2rpx;
  background: rgba(139, 126, 110, 0.12);
  border-radius: 1rpx;
  overflow: hidden;
}

.reading-progress__fill {
  height: 100%;
  background: var(--color-accent);
  border-radius: 1rpx;
  transition: width var(--duration-emphasis) ease;
}

/* Image placeholder */
.img-placeholder {
  background: rgba(139, 126, 110, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
}

.img-placeholder__icon {
  width: 48rpx;
  height: 48rpx;
  opacity: 0.15;
}
