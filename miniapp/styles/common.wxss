/* --- Decorative dividers --- */
.divider {
  height: 1rpx;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(244, 212, 140, 0.20) 15%,
    rgba(244, 212, 140, 0.30) 50%,
    rgba(244, 212, 140, 0.20) 85%,
    transparent 100%
  );
  margin: var(--spacing-lg) 0;
  border: none;
}

.divider--lavender {
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(184, 169, 224, 0.20) 15%,
    rgba(184, 169, 224, 0.30) 50%,
    rgba(184, 169, 224, 0.20) 85%,
    transparent 100%
  );
}

.divider--vertical {
  width: 1rpx;
  height: 100%;
  background: linear-gradient(
    180deg,
    transparent 0%,
    rgba(244, 212, 140, 0.20) 20%,
    rgba(244, 212, 140, 0.30) 50%,
    rgba(244, 212, 140, 0.20) 80%,
    transparent 100%
  );
  margin: 0 var(--spacing-md);
  border: none;
}

/* -----------------------------------------------------------
   5. BUTTONS
   ----------------------------------------------------------- */

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-medium);
  line-height: var(--line-height-tight);
  border-radius: var(--radius-pill);
  padding: 24rpx 48rpx;
  transition: all var(--duration-base) var(--ease-soft);
  position: relative;
  overflow: hidden;
}

/* Primary — Golden glow */
.btn-primary {
  background: linear-gradient(135deg, #F4D48C 0%, #E8C67A 50%, #D4B06A 100%);
  color: var(--color-text-inverse);
  box-shadow: var(--shadow-gold-button);
}

.btn-primary:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 12rpx rgba(244, 212, 140, 0.20);
  opacity: 0.92;
}

.btn-primary--disabled,
.btn-primary[disabled] {
  background: rgba(244, 212, 140, 0.20);
  color: rgba(26, 26, 62, 0.35);
  box-shadow: none;
  pointer-events: none;
}

/* Secondary — Lavender outline */
.btn-secondary {
  background: transparent;
  color: var(--color-lavender);
  border: 1rpx solid rgba(184, 169, 224, 0.35);
  box-shadow: none;
}

.btn-secondary:active {
  background: rgba(184, 169, 224, 0.08);
  border-color: rgba(184, 169, 224, 0.55);
  transform: scale(0.97);
}

.btn-secondary--disabled,
.btn-secondary[disabled] {
  border-color: rgba(184, 169, 224, 0.12);
  color: rgba(184, 169, 224, 0.30);
  pointer-events: none;
}

/* Ghost — Subtle text button */
.btn-ghost {
  background: transparent;
  color: var(--color-text-secondary);
  border: none;
  padding: 16rpx 24rpx;
  box-shadow: none;
}

.btn-ghost:active {
  color: var(--color-gold);
  background: rgba(244, 212, 140, 0.06);
}

/* Special — Glowing gold outline */
.btn-glow {
  background: transparent;
  color: var(--color-gold);
  border: 1rpx solid rgba(244, 212, 140, 0.30);
  box-shadow: 0 0 20rpx rgba(244, 212, 140, 0.08);
}

.btn-glow:active {
  background: rgba(244, 212, 140, 0.08);
  border-color: rgba(244, 212, 140, 0.50);
  box-shadow: 0 0 30rpx rgba(244, 212, 140, 0.15);
  transform: scale(0.97);
}

/* Variants */
.btn--full {
  width: 100%;
}

.btn--sm {
  font-size: var(--font-size-sm);
  padding: 16rpx 32rpx;
}

.btn--lg {
  font-size: var(--font-size-lg);
  padding: 28rpx 56rpx;
}

.btn--icon {
  padding: 20rpx;
  min-width: 80rpx;
  min-height: 80rpx;
  border-radius: var(--radius-full);
}

/* -----------------------------------------------------------
   6. CARDS
   ----------------------------------------------------------- */

.card {
  background: var(--color-card);
  border: 1rpx solid var(--color-card-border);
  border-radius: var(--radius-lg);
  padding: var(--spacing-md);
  box-shadow: var(--shadow-card);
  transition: all var(--duration-base) var(--ease-soft);
}

.card:active {
  background: var(--color-card-hover);
  border-color: var(--color-card-border-hover);
  box-shadow: var(--shadow-elevated);
  transform: translateY(-2rpx);
}

.card--glass {
  background: rgba(42, 42, 90, 0.70);
  border: 1rpx solid rgba(244, 212, 140, 0.15);
}

.card--elevated {
  box-shadow: var(--shadow-elevated);
}

.card--glow {
  border-color: rgba(244, 212, 140, 0.25);
  box-shadow: 0 0 30rpx rgba(244, 212, 140, 0.06), 0 4rpx 20rpx rgba(0, 0, 0, 0.25);
}

.card--compact {
  padding: var(--spacing-sm);
}

.card--spacious {
  padding: var(--spacing-lg);
}

.card--no-pad {
  padding: 0;
}

/* Card header */
.card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-sm);
}

.card__title {
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.card__subtitle {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  margin-top: var(--spacing-xxs);
}

.card__body {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  line-height: var(--line-height-loose);
}

.card__footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: var(--spacing-sm);
  padding-top: var(--spacing-sm);
  border-top: 1rpx solid rgba(244, 212, 140, 0.08);
}

/* -----------------------------------------------------------
   7. FORM ELEMENTS
   ----------------------------------------------------------- */

.input-wrapper {
  position: relative;
  width: 100%;
}

.input {
  width: 100%;
  height: 88rpx;
  background: var(--color-surface);
  border: 1rpx solid rgba(244, 212, 140, 0.12);
  border-radius: var(--radius-md);
  padding: 0 var(--spacing-md);
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  line-height: var(--line-height-tight);
  transition: all var(--duration-base) var(--ease-soft);
  box-sizing: border-box;
}

.input::placeholder {
  color: var(--color-text-tertiary);
}

.input:focus {
  border-color: rgba(244, 212, 140, 0.40);
  box-shadow: 0 0 0 2rpx rgba(244, 212, 140, 0.08);
  background: var(--color-surface-hover);
}

.input--error {
  border-color: rgba(232, 122, 138, 0.40);
  box-shadow: 0 0 0 2rpx rgba(232, 122, 138, 0.08);
}

.input--success {
  border-color: rgba(123, 198, 160, 0.40);
  box-shadow: 0 0 0 2rpx rgba(123, 198, 160, 0.08);
}

.input--textarea {
  height: 200rpx;
  padding: var(--spacing-md);
  line-height: var(--line-height-loose);
}

.input--pill {
  border-radius: var(--radius-pill);
  padding-left: var(--spacing-lg);
  padding-right: var(--spacing-lg);
}

.input-label {
  display: block;
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-xs);
}

.input-hint {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  margin-top: var(--spacing-xxs);
  line-height: var(--line-height-base);
}

.input-hint--error {
  color: var(--color-error);
}

/* --- Select / Picker --- */
.picker {
  width: 100%;
  height: 88rpx;
  background: var(--color-surface);
  border: 1rpx solid rgba(244, 212, 140, 0.12);
  border-radius: var(--radius-md);
  padding: 0 var(--spacing-md);
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  line-height: 88rpx;
  transition: all var(--duration-base) var(--ease-soft);
  box-sizing: border-box;
  position: relative;
}

.picker:active {
  background: var(--color-surface-hover);
  border-color: rgba(244, 212, 140, 0.30);
}

.picker--placeholder {
  color: var(--color-text-tertiary);
}

/* --- Checkbox / Radio --- */
.check-group {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
}

.check-item {
  display: flex;
  align-items: center;
  padding: 12rpx 20rpx;
  background: var(--color-surface);
  border: 1rpx solid rgba(244, 212, 140, 0.10);
  border-radius: var(--radius-pill);
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  transition: all var(--duration-fast) var(--ease-soft);
}

.check-item:active {
  border-color: rgba(244, 212, 140, 0.35);
  color: var(--color-text-primary);
}

.check-item--active {
  background: rgba(244, 212, 140, 0.10);
  border-color: rgba(244, 212, 140, 0.35);
  color: var(--color-gold);
}

/* -----------------------------------------------------------
   8. LAYOUT & CONTAINERS
   ----------------------------------------------------------- */

.page {
  min-height: 100vh;
  padding: var(--page-padding);
  padding-bottom: calc(var(--page-padding) + var(--safe-area-bottom));
  position: relative;
  z-index: var(--z-base);
  background: var(--color-bg);
  background-image: var(--color-bg-gradient);
}

.page--wide {
  padding-left: var(--page-padding-wide);
  padding-right: var(--page-padding-wide);
}

.page--no-pad {
  padding: 0;
}

.section {
  margin-bottom: var(--spacing-xl);
}

.section--last {
  margin-bottom: 0;
}

.section__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-md);
}

.section__title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.section__action {
  font-size: var(--font-size-sm);
  color: var(--color-gold);
  font-weight: var(--font-weight-medium);
}

.section__action:active {
  opacity: 0.70;
}

/* --- Grid / Flex Utilities --- */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-wrap {
  flex-wrap: wrap;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-around {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.flex-1 {
  flex: 1;
}

.gap-xs {
  gap: var(--spacing-xs);
}

.gap-sm {
  gap: var(--spacing-sm);
}

.gap-md {
  gap: var(--spacing-md);
}

.gap-lg {
  gap: var(--spacing-lg);
}

/* --- Grid (2-column) --- */
.grid-2 {
  display: flex;
  flex-flow: row wrap;
  margin: calc(-1 * var(--spacing-xs));
}

.grid-2 > view {
  width: calc(50% - var(--spacing-xs) * 2);
  margin: var(--spacing-xs);
}

/* --- Hero Area --- */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: var(--spacing-3xl) var(--spacing-md);
  position: relative;
  min-height: 400rpx;
}

.hero__title {
  font-size: var(--font-size-4xl);
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
  line-height: var(--line-height-tight);
  letter-spacing: 3rpx;
  margin-bottom: var(--spacing-sm);
  text-shadow: 0 0 40rpx rgba(244, 212, 140, 0.08);
}

.hero__subtitle {
  font-size: var(--font-size-md);
  color: var(--color-text-secondary);
  line-height: var(--line-height-loose);
  max-width: 600rpx;
}

.hero__accent {
  color: var(--color-gold);
}

.hero__icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: var(--spacing-lg);
  opacity: 0.85;
}

/* -----------------------------------------------------------
   9. NAVIGATION
   ----------------------------------------------------------- */

/* Bottom Tab Bar */
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: calc(100rpx + var(--safe-area-bottom));
  padding-bottom: var(--safe-area-bottom);
  background: rgba(37, 37, 80, 0.92);
  border-top: 1rpx solid rgba(244, 212, 140, 0.08);
  z-index: var(--z-sticky);
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 100%;
  padding: 8rpx 0;
  position: relative;
}

.tab-item__icon {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 6rpx;
  opacity: 0.45;
  transition: all var(--duration-base) var(--ease-soft);
}

.tab-item__label {
  font-size: 18rpx;
  color: var(--color-text-tertiary);
  line-height: 1.2;
  transition: all var(--duration-base) var(--ease-soft);
}

.tab-item--active .tab-item__icon {
  opacity: 1;
}

.tab-item--active .tab-item__label {
  color: var(--color-gold);
  font-weight: var(--font-weight-medium);
}

.tab-item--active::after {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  width: 40rpx;
  height: 3rpx;
  background: var(--color-gold);
  border-radius: 2rpx;
  margin-left: -20rpx;
  box-shadow: 0 0 10rpx rgba(244, 212, 140, 0.30);
}

/* Nav Bar (top) */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 var(--page-padding);
  position: relative;
  z-index: var(--z-sticky);
}

.nav-bar__title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
}

.nav-bar__back {
  display: flex;
  align-items: center;
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  padding: 8rpx;
}

.nav-bar__back:active {
  color: var(--color-gold);
}

.nav-bar__right {
  display: flex;
  align-items: center;
  gap: var(--spacing-xs);
}

/* -----------------------------------------------------------
   10. TOASTS & NOTIFICATIONS
   ----------------------------------------------------------- */

.toast {
  position: fixed;
  top: 120rpx;
  left: 50%;
  transform: translateX(-50%);
  min-width: 200rpx;
  max-width: 600rpx;
  padding: 20rpx 36rpx;
  background: var(--color-card);
  border: 1rpx solid rgba(244, 212, 140, 0.20);
  border-radius: var(--radius-pill);
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
  text-align: center;
  box-shadow: var(--shadow-elevated);
  z-index: var(--z-toast);
  animation: toast-in var(--duration-base) var(--ease-soft) forwards;
}

.toast--success {
  border-color: rgba(123, 198, 160, 0.30);
  color: var(--color-success);
}

.toast--error {
  border-color: rgba(232, 122, 138, 0.30);
  color: var(--color-error);
}

@keyframes toast-in {
  0% {
    opacity: 0;
    transform: translateX(-50%) translateY(-20rpx);
  }
  100% {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
}

/* Badge / Tag */
.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx 16rpx;
  font-size: 18rpx;
  font-weight: var(--font-weight-medium);
  line-height: 1.2;
  border-radius: var(--radius-pill);
  color: var(--color-text-primary);
  background: var(--color-surface);
  border: 1rpx solid rgba(244, 212, 140, 0.15);
}

.badge--gold {
  background: rgba(244, 212, 140, 0.12);
  color: var(--color-gold);
  border-color: rgba(244, 212, 140, 0.20);
}

.badge--lavender {
  background: rgba(184, 169, 224, 0.12);
  color: var(--color-lavender);
  border-color: rgba(184, 169, 224, 0.20);
}

.badge--success {
  background: var(--color-success-bg);
  color: var(--color-success);
  border-color: transparent;
}

.badge--warning {
  background: var(--color-warning-bg);
  color: var(--color-warning);
  border-color: transparent;
}

.badge--error {
  background: var(--color-error-bg);
  color: var(--color-error);
  border-color: transparent;
}

.badge--dot {
  width: 12rpx;
  height: 12rpx;
  padding: 0;
  border-radius: var(--radius-full);
  min-width: 0;
}

.badge--dot.badge--gold {
  box-shadow: 0 0 6rpx rgba(244, 212, 140, 0.40);
}

/* -----------------------------------------------------------
   11. LIST / MENU ITEMS
   ----------------------------------------------------------- */

.list-item {
  display: flex;
  align-items: center;
  padding: var(--spacing-md);
  background: var(--color-card);
  border: 1rpx solid var(--color-card-border);
  border-radius: var(--radius-md);
  transition: all var(--duration-fast) var(--ease-soft);
}

.list-item:active {
  background: var(--color-card-hover);
  border-color: var(--color-card-border-hover);
}

.list-item + .list-item {
  margin-top: var(--spacing-xs);
}

.list-item__icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: var(--spacing-sm);
  flex-shrink: 0;
}

.list-item__content {
  flex: 1;
  min-width: 0;
}

.list-item__title {
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  line-height: var(--line-height-tight);
}

.list-item__desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  line-height: var(--line-height-base);
  margin-top: 4rpx;
}

.list-item__right {
  flex-shrink: 0;
  margin-left: var(--spacing-sm);
}

.list-item__arrow {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.30;
}

/* -----------------------------------------------------------
   12. LOADING & EMPTY STATES
   ----------------------------------------------------------- */

.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-3xl) 0;
}

.loading__spinner {
  width: 64rpx;
  height: 64rpx;
  border: 3rpx solid rgba(244, 212, 140, 0.10);
  border-top-color: var(--color-gold);
  border-radius: var(--radius-full);
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading__text {
  margin-top: var(--spacing-md);
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
}

/* Skeleton */
.skeleton {
  background: linear-gradient(
    90deg,
    var(--color-surface) 25%,
    var(--color-surface-hover) 37%,
    var(--color-surface) 63%
  );
  background-size: 400% 100%;
  animation: skeleton-shimmer 1.8s ease-in-out infinite;
  border-radius: var(--radius-sm);
}

@keyframes skeleton-shimmer {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}

.skeleton--text {
  height: 28rpx;
  width: 100%;
  margin-bottom: var(--spacing-xs);
}

.skeleton--title {
  height: 36rpx;
  width: 60%;
  margin-bottom: var(--spacing-sm);
}

.skeleton--avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-full);
}

.skeleton--card {
  height: 200rpx;
  border-radius: var(--radius-lg);
}

/* Empty State */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-4xl) var(--spacing-lg);
  text-align: center;
}

.empty__icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: var(--spacing-lg);
  opacity: 0.40;
}

.empty__title {
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-secondary);
  margin-bottom: var(--spacing-xs);
}

.empty__desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
  line-height: var(--line-height-base);
  max-width: 500rpx;
}

/* -----------------------------------------------------------
   13. MODAL & OVERLAY
   ----------------------------------------------------------- */

.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--color-overlay);
  z-index: var(--z-overlay);
  animation: overlay-in var(--duration-base) var(--ease-soft) forwards;
}

@keyframes overlay-in {
  0% { opacity: 0; }
  100% { opacity: 1; }
}

.modal {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--color-surface);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  z-index: var(--z-modal);
  padding: var(--spacing-lg) var(--page-padding) calc(var(--spacing-xl) + var(--safe-area-bottom));
  padding-bottom: calc(var(--spacing-xl) + var(--safe-area-bottom));
  animation: modal-in var(--duration-slow) var(--ease-soft) forwards;
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.30);
}

@keyframes modal-in {
  0% {
    transform: translateY(100%);
    opacity: 0;
  }
  100% {
    transform: translateY(0);
    opacity: 1;
  }
}

.modal--center {
  top: 50%;
  bottom: auto;
  left: 50%;
  right: auto;
  width: 600rpx;
  border-radius: var(--radius-xl);
  padding: var(--spacing-xl);
  transform: translate(-50%, -50%) scale(0.90);
  opacity: 0;
  animation: modal-center-in var(--duration-slow) var(--ease-soft) forwards;
  padding-bottom: var(--spacing-xl);
}

@keyframes modal-center-in {
  0% {
    transform: translate(-50%, -50%) scale(0.90);
    opacity: 0;
  }
  100% {
    transform: translate(-50%, -50%) scale(1);
    opacity: 1;
  }
}

.modal__handle {
  width: 64rpx;
  height: 6rpx;
  background: rgba(106, 101, 136, 0.35);
  border-radius: var(--radius-pill);
  margin: 0 auto var(--spacing-md);
}

.modal__header {
  text-align: center;
  margin-bottom: var(--spacing-md);
}

.modal__title {
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.modal__body {
  margin-bottom: var(--spacing-lg);
}

.modal__footer {
  display: flex;
  gap: var(--spacing-sm);
}

/* -----------------------------------------------------------
   14. AVATAR
   ----------------------------------------------------------- */

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-full);
  border: 2rpx solid rgba(244, 212, 140, 0.15);
  overflow: hidden;
  flex-shrink: 0;
  background: var(--color-surface);
}

.avatar--sm {
  width: 56rpx;
  height: 56rpx;
}

.avatar--lg {
  width: 120rpx;
  height: 120rpx;
}

.avatar--glow {
  border-color: rgba(244, 212, 140, 0.30);
  box-shadow: 0 0 16rpx rgba(244, 212, 140, 0.12);
}

.avatar--ring {
  border-width: 3rpx;
  border-color: var(--color-gold);
  box-shadow: 0 0 20rpx rgba(244, 212, 140, 0.15);
}

/* -----------------------------------------------------------
   15. PROGRESS BAR
   ----------------------------------------------------------- */

.progress {
  width: 100%;
  height: 8rpx;
  background: rgba(106, 101, 136, 0.20);
  border-radius: var(--radius-pill);
  overflow: hidden;
}

.progress__fill {
  height: 100%;
  background: linear-gradient(90deg, var(--color-gold-dark) 0%, var(--color-gold) 50%, var(--color-gold-light) 100%);
  border-radius: var(--radius-pill);
  transition: width var(--duration-slow) var(--ease-out);
  box-shadow: 0 0 10rpx rgba(244, 212, 140, 0.15);
}

.progress--lavender .progress__fill {
  background: linear-gradient(90deg, var(--color-lavender-dark) 0%, var(--color-lavender) 50%, var(--color-lavender-light) 100%);
  box-shadow: 0 0 10rpx rgba(184, 169, 224, 0.15);
}

/* -----------------------------------------------------------
   16. PAGE TRANSITIONS
   ----------------------------------------------------------- */

@keyframes fade-up {
  0% {
    opacity: 0;
    transform: translateY(24rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fade-in {
  0% { opacity: 0; }
  100% { opacity: 1; }
}

@keyframes pulse-glow {
  0%,
  100% {
    opacity: 0.60;
    box-shadow: 0 0 10rpx rgba(244, 212, 140, 0.08);
  }
  50% {
    opacity: 1;
    box-shadow: 0 0 25rpx rgba(244, 212, 140, 0.20);
  }
}

.anim-fade-up {
  animation: fade-up var(--duration-slow) var(--ease-soft) forwards;
}

.anim-fade-in {
  animation: fade-in var(--duration-base) var(--ease-soft) forwards;
}

.anim-pulse-glow {
  animation: pulse-glow 3s ease-in-out infinite;
}

/* Staggered children — manual classes for simplicity */
.anim-stagger-1 { animation-delay: 0.05s; }
.anim-stagger-2 { animation-delay: 0.10s; }
.anim-stagger-3 { animation-delay: 0.15s; }
.anim-stagger-4 { animation-delay: 0.20s; }
.anim-stagger-5 { animation-delay: 0.25s; }
.anim-stagger-6 { animation-delay: 0.30s; }
.anim-stagger-7 { animation-delay: 0.35s; }
.anim-stagger-8 { animation-delay: 0.40s; }
.anim-stagger-9 { animation-delay: 0.45s; }
.anim-stagger-10 { animation-delay: 0.50s; }

/* -----------------------------------------------------------
   17. SPACING UTILITIES
   ----------------------------------------------------------- */

.mt-xxs { margin-top: var(--spacing-xxs); }
.mt-xs { margin-top: var(--spacing-xs); }
.mt-sm { margin-top: var(--spacing-sm); }
.mt-md { margin-top: var(--spacing-md); }
.mt-lg { margin-top: var(--spacing-lg); }
.mt-xl { margin-top: var(--spacing-xl); }
.mt-2xl { margin-top: var(--spacing-2xl); }

.mb-xxs { margin-bottom: var(--spacing-xxs); }
.mb-xs { margin-bottom: var(--spacing-xs); }
.mb-sm { margin-bottom: var(--spacing-sm); }
.mb-md { margin-bottom: var(--spacing-md); }
.mb-lg { margin-bottom: var(--spacing-lg); }
.mb-xl { margin-bottom: var(--spacing-xl); }
.mb-2xl { margin-bottom: var(--spacing-2xl); }

.pt-xxs { padding-top: var(--spacing-xxs); }
.pt-xs { padding-top: var(--spacing-xs); }
.pt-sm { padding-top: var(--spacing-sm); }
.pt-md { padding-top: var(--spacing-md); }
.pt-lg { padding-top: var(--spacing-lg); }
.pt-xl { padding-top: var(--spacing-xl); }

.pb-xxs { padding-bottom: var(--spacing-xxs); }
.pb-xs { padding-bottom: var(--spacing-xs); }
.pb-sm { padding-bottom: var(--spacing-sm); }
.pb-md { padding-bottom: var(--spacing-md); }
.pb-lg { padding-bottom: var(--spacing-lg); }
.pb-xl { padding-bottom: var(--spacing-xl); }

.p-sm { padding: var(--spacing-sm); }
.p-md { padding: var(--spacing-md); }
.p-lg { padding: var(--spacing-lg); }
.p-xl { padding: var(--spacing-xl); }

/* -----------------------------------------------------------
   18. TEXT ALIGNMENT & STYLING
   ----------------------------------------------------------- */

.text-left { text-align: left; }
.text-center { text-align: center; }
.text-right { text-align: right; }

.text-primary { color: var(--color-text-primary); }
.text-secondary { color: var(--color-text-secondary); }
.text-tertiary { color: var(--color-text-tertiary); }
.text-gold { color: var(--color-gold); }
.text-lavender { color: var(--color-lavender); }
.text-success { color: var(--color-success); }
.text-warning { color: var(--color-warning); }
.text-error { color: var(--color-error); }

.text-bold { font-weight: var(--font-weight-bold); }
.text-semibold { font-weight: var(--font-weight-semibold); }
.text-medium { font-weight: var(--font-weight-medium); }
.text-normal { font-weight: var(--font-weight-normal); }

.text-sm { font-size: var(--font-size-sm); }
.text-base { font-size: var(--font-size-base); }
.text-md { font-size: var(--font-size-md); }
.text-lg { font-size: var(--font-size-lg); }
.text-xl { font-size: var(--font-size-xl); }

.text-truncate {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.text-2lines {
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* -----------------------------------------------------------
   19. VISIBILITY & POSITIONING
   ----------------------------------------------------------- */

.hidden {
  display: none !important;
}

.invisible {
  opacity: 0;
  pointer-events: none;
}

.relative {
  position: relative;
}

.absolute {
  position: absolute;
}

.fixed {
  position: fixed;
}

.full-width {
  width: 100%;
}

.full-height {
  height: 100%;
}

.overflow-hidden {
  overflow: hidden;
}

.z-1 { z-index: var(--z-base); }
.z-card { z-index: var(--z-card); }
.z-sticky { z-index: var(--z-sticky); }
.z-overlay { z-index: var(--z-overlay); }
.z-modal { z-index: var(--z-modal); }

/* -----------------------------------------------------------
   20. SCROLLBAR STYLING
   ----------------------------------------------------------- */

::-webkit-scrollbar {
  width: 4rpx;
  height: 4rpx;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: rgba(106, 101, 136, 0.30);
  border-radius: 4rpx;
}

::-webkit-scrollbar-thumb:active {
  background: rgba(106, 101, 136, 0.50);
}

/* -----------------------------------------------------------
   21. SAFE AREA & BOTTOM SPACING
   ----------------------------------------------------------- */

.safe-bottom {
  padding-bottom: var(--safe-area-bottom);
}

.safe-top {
  padding-top: var(--status-bar-height, 44rpx);
}

/* -----------------------------------------------------------
   22. MISC COMPOSITION HELPERS
   ----------------------------------------------------------- */

/* Floating action button style */
.fab {
  position: fixed;
  right: var(--page-padding);
  bottom: calc(120rpx + var(--safe-area-bottom));
  width: 100rpx;
  height: 100rpx;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, #F4D48C 0%, #E8C67A 100%);
  box-shadow: 0 4rpx 24rpx rgba(244, 212, 140, 0.30);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: var(--z-card);
  transition: all var(--duration-base) var(--ease-soft);
}

.fab:active {
  transform: scale(0.92);
  box-shadow: 0 2rpx 12rpx rgba(244, 212, 140, 0.20);
}

.fab__icon {
  width: 44rpx;
  height: 44rpx;
}

/* Top-right decorative dot — like a distant planet */
.planet-dot {
  position: absolute;
  top: 60rpx;
  right: 60rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: var(--radius-full);
  background: var(--color-lavender);
  opacity: 0.20;
  box-shadow: 0 0 20rpx rgba(184, 169, 224, 0.10);
}

/* Reading queue indicator */
.reading-progress {
  width: 100%;
  height: 3rpx;
  background: rgba(106, 101, 136, 0.15);
  border-radius: 2rpx;
  overflow: hidden;
}

.reading-progress__fill {
  height: 100%;
  background: var(--color-gold);
  border-radius: 2rpx;
  transition: width var(--duration-slow) var(--ease-out);
}

/* Image placeholder for loading */
.img-placeholder {
  background: linear-gradient(
    135deg,
    var(--color-surface) 0%,
    var(--color-surface-hover) 100%
  );
  display: flex;
  align-items: center;
  justify-content: center;
}

.img-placeholder__icon {
  width: 48rpx;
  height: 48rpx;
  opacity: 0.20;
}

/* ============================================================
   23. ANIMATION LIBRARY — Professional Keyframes & Utility Classes
       WXSS-compatible: opacity, transform, box-shadow, background-position only
   ============================================================ */

/* -----------------------------------------------------------
   23-A. STAR & SPARKLE KEYFRAMES
   ----------------------------------------------------------- */

/* Quick magical twinkle for sparkle effects (0.4s cycle) */
@keyframes star-twinkle-fast {
  0%,
  100% {
    opacity: 1;
    transform: scale(1) rotate(0deg);
  }
  25% {
    opacity: 0.30;
    transform: scale(0.60) rotate(90deg);
  }
  50% {
    opacity: 0.90;
    transform: scale(1.15) rotate(180deg);
  }
  75% {
    opacity: 0.40;
    transform: scale(0.70) rotate(270deg);
  }
}

/* Rapid scale+opacity burst for magical moments (0.5s) */
@keyframes star-burst {
  0% {
    opacity: 0;
    transform: scale(0.20);
  }
  30% {
    opacity: 1;
    transform: scale(1.40);
  }
  60% {
    opacity: 0.85;
    transform: scale(1.10);
  }
  100% {
    opacity: 0;
    transform: scale(0.80);
  }
}

/* -----------------------------------------------------------
   23-B. FLOATING & DRIFT KEYFRAMES
   ----------------------------------------------------------- */

/* Slow vertical float with subtle rotation (4s cycle) */
@keyframes float-gentle {
  0%,
  100% {
    transform: translateY(0) rotate(0deg);
  }
  25% {
    transform: translateY(-12rpx) rotate(1deg);
  }
  50% {
    transform: translateY(-20rpx) rotate(0deg);
  }
  75% {
    transform: translateY(-8rpx) rotate(-1deg);
  }
}

/* Horizontal+vertical drift like a constellation (6s cycle) */
@keyframes float-drift {
  0%,
  100% {
    transform: translate(0, 0) rotate(0deg);
  }
  20% {
    transform: translate(10rpx, -8rpx) rotate(0.50deg);
  }
  40% {
    transform: translate(-6rpx, -16rpx) rotate(-0.50deg);
  }
  60% {
    transform: translate(14rpx, -20rpx) rotate(0.30deg);
  }
  80% {
    transform: translate(4rpx, -10rpx) rotate(-0.30deg);
  }
}

/* -----------------------------------------------------------
   23-C. CARD & SURFACE KEYFRAMES
   ----------------------------------------------------------- */

/* Background-position sweep for light glint effect (2s) */
@keyframes card-shimmer {
  0% {
    background-position: -200% 0;
  }
  100% {
    background-position: 200% 0;
  }
}

/* Card appears to rise up from below with opacity (0.5s) */
@keyframes card-rise {
  0% {
    opacity: 0;
    transform: translateY(40rpx) scale(0.97);
  }
  60% {
    opacity: 1;
    transform: translateY(-6rpx) scale(1);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* Dramatic scale+opacity reveal (0.8->1 scale, 0->1 opacity, 0.45s) */
@keyframes card-reveal {
  0% {
    opacity: 0;
    transform: scale(0.80);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}

/* -----------------------------------------------------------
   23-D. GLOW & BREATHING KEYFRAMES
   ----------------------------------------------------------- */

/* Box-shadow pulse in golden tones (2.5s cycle) */
@keyframes glow-pulse-gold {
  0%,
  100% {
    box-shadow: 0 0 10rpx rgba(244, 212, 140, 0.08), 0 0 30rpx rgba(244, 212, 140, 0.04);
  }
  50% {
    box-shadow: 0 0 20rpx rgba(244, 212, 140, 0.25), 0 0 50rpx rgba(244, 212, 140, 0.10);
  }
}

/* Box-shadow pulse in lavender tones (2.5s cycle) */
@keyframes glow-pulse-lavender {
  0%,
  100% {
    box-shadow: 0 0 10rpx rgba(184, 169, 224, 0.08), 0 0 30rpx rgba(184, 169, 224, 0.04);
  }
  50% {
    box-shadow: 0 0 20rpx rgba(184, 169, 224, 0.25), 0 0 50rpx rgba(184, 169, 224, 0.10);
  }
}

/* Very gentle scale oscillation (1->1.02->1, 4s cycle) */
@keyframes breathing-subtle {
  0%,
  100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.02);
  }
}

/* Ultra-slow rotation (360deg over 30s, for background elements) */
@keyframes rotate-cosmic {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

/* -----------------------------------------------------------
   23-E. SHIMMER SWEEP KEYFRAME
   ----------------------------------------------------------- */

/* Fast shimmer sweep using background-position (1.2s) */
@keyframes shimmer-sweep {
  0% {
    background-position: -100% 50%;
  }
  100% {
    background-position: 200% 50%;
  }
}

/* -----------------------------------------------------------
   23-F. INTERACTION KEYFRAMES
   ----------------------------------------------------------- */

/* Scale+opacity outward like a water ripple (0.4s) */
@keyframes ripple-expand {
  0% {
    transform: scale(0.85);
    opacity: 0.60;
  }
  50% {
    opacity: 0.80;
  }
  100% {
    transform: scale(1.15);
    opacity: 0;
  }
}

/* Playful overshoot entrance (scale 0->1.05->0.97->1, 0.5s) */
@keyframes bounce-in {
  0% {
    opacity: 0;
    transform: scale(0);
  }
  50% {
    opacity: 1;
    transform: scale(1.05);
  }
  70% {
    transform: scale(0.97);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}

/* Elegant entrance from below (0.45s) */
@keyframes slide-up-fade {
  0% {
    opacity: 0;
    transform: translateY(30rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

/* -----------------------------------------------------------
   23-G. DATA / NUMBER KEYFRAMES
   ----------------------------------------------------------- */

/* Brief scale bump for number changes (0.35s) */
@keyframes count-up-pulse {
  0% {
    transform: scale(1);
  }
  30% {
    transform: scale(1.20);
  }
  60% {
    transform: scale(0.95);
  }
  100% {
    transform: scale(1);
  }
}

/* -----------------------------------------------------------
   23-H. ANIMATION UTILITY CLASSES
   ----------------------------------------------------------- */

/* --- Floating / Drifting --- */
.anim-float {
  animation: float-gentle 4s ease-in-out infinite;
}

.anim-drift {
  animation: float-drift 6s ease-in-out infinite;
}

.anim-rotate-cosmic {
  animation: rotate-cosmic 30s linear infinite;
}

/* --- Shimmer on card surfaces --- */
.anim-shimmer {
  background: linear-gradient(
    90deg,
    rgba(255, 255, 255, 0) 0%,
    rgba(244, 212, 140, 0.06) 45%,
    rgba(244, 212, 140, 0.10) 50%,
    rgba(244, 212, 140, 0.06) 55%,
    rgba(255, 255, 255, 0) 100%
  );
  background-size: 200% 100%;
  animation: shimmer-sweep 1.2s ease-in-out infinite;
  pointer-events: none;
}

/* --- Breathing --- */
.anim-breathe {
  animation: breathing-subtle 4s ease-in-out infinite;
}

/* --- Entrance Classes (one-shot, use forwards) --- */
.anim-bounce-in {
  animation: bounce-in 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

.anim-rise {
  animation: card-rise 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
}

.anim-reveal {
  animation: card-reveal 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
}

.anim-slide-up {
  animation: slide-up-fade 0.45s cubic-bezier(0, 0, 0.2, 1) forwards;
}

/* --- Glow Classes (infinite) --- */
.anim-glow-gold {
  animation: glow-pulse-gold 2.5s ease-in-out infinite;
}

.anim-glow-lav {
  animation: glow-pulse-lavender 2.5s ease-in-out infinite;
}

/* --- Interaction Classes --- */
.anim-ripple {
  position: relative;
  overflow: hidden;
}

.anim-ripple:active::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 100rpx;
  height: 100rpx;
  margin-left: -50rpx;
  margin-top: -50rpx;
  border-radius: 100%;
  background: rgba(244, 212, 140, 0.20);
  animation: ripple-expand 0.4s ease-out forwards;
  pointer-events: none;
}

.anim-ripple--lav:active::after {
  background: rgba(184, 169, 224, 0.20);
}

/* --- Star / Sparkle (one-shot or infinite via forwards/infinite) --- */
.anim-twinkle-fast {
  animation: star-twinkle-fast 0.4s ease-in-out infinite;
}

.anim-star-burst {
  animation: star-burst 0.5s ease-out forwards;
}

/* --- Data / Count --- */
.anim-count-pulse {
  animation: count-up-pulse 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* -----------------------------------------------------------
   23-I. STAGGERED ENTRANCE (card-rise with increasing delays)
   ----------------------------------------------------------- */

.anim-rise-1 {
  animation: card-rise 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
  animation-delay: 0.05s;
}

.anim-rise-2 {
  animation: card-rise 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
  animation-delay: 0.12s;
}

.anim-rise-3 {
  animation: card-rise 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
  animation-delay: 0.20s;
}

.anim-rise-4 {
  animation: card-rise 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
  animation-delay: 0.30s;
}

.anim-rise-5 {
  animation: card-rise 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
  animation-delay: 0.42s;
}

/* ============================================================
   24. PAGE-LEVEL ANIMATIONS
       Skeleton→Content, Tab Shimmer, Error→Retry,
       Empty State, List Entrance
   ============================================================ */

/* -----------------------------------------------------------
   24-A. SKELETON → CONTENT TRANSITION
   ----------------------------------------------------------- */

/* When pageLoading becomes false, apply to skeleton wrapper */
.page-skeleton-exit {
  opacity: 0;
  transition: opacity 0.3s ease-out;
  pointer-events: none;
}

/* Content enters with fade + slight rise */
.page-content-entering {
  opacity: 0;
  animation: content-rise-in 0.4s cubic-bezier(0, 0, 0.2, 1) forwards;
}

@keyframes content-rise-in {
  0% {
    opacity: 0;
    transform: translateY(10rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

/* -----------------------------------------------------------
   24-B. TAB SWITCH SHIMMER
   ----------------------------------------------------------- */

/* Apply to the new tab page container on switch */
.tab-shimmer {
  position: relative;
  overflow: hidden;
}

.tab-shimmer::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 200%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(244, 212, 140, 0.04) 40%,
    rgba(244, 212, 140, 0.08) 50%,
    rgba(244, 212, 140, 0.04) 60%,
    transparent 100%
  );
  background-size: 50% 100%;
  animation: tab-shimmer-sweep 0.8s ease-out forwards;
  pointer-events: none;
  z-index: 1;
}

@keyframes tab-shimmer-sweep {
  0% {
    background-position: 200% 50%;
  }
  100% {
    background-position: -100% 50%;
  }
}

/* -----------------------------------------------------------
   24-C. ERROR → RETRY TRANSITION
   ----------------------------------------------------------- */

/* Shake the error container when retry is triggered */
.error-shake {
  animation: error-shake-key 0.4s ease-out;
}

@keyframes error-shake-key {
  0%,
  100% {
    transform: translateX(0);
  }
  15% {
    transform: translateX(-12rpx);
  }
  30% {
    transform: translateX(10rpx);
  }
  45% {
    transform: translateX(-8rpx);
  }
  60% {
    transform: translateX(6rpx);
  }
  75% {
    transform: translateX(-4rpx);
  }
  90% {
    transform: translateX(2rpx);
  }
}

/* Error fades out after shake (triggered simultaneously or after delay) */
.error-fade-out {
  animation: error-fade-out-key 0.35s ease-in forwards;
}

@keyframes error-fade-out-key {
  0% {
    opacity: 1;
    transform: scale(1);
  }
  100% {
    opacity: 0;
    transform: scale(0.95);
  }
}

/* Content slides in from below after error resolves */
.content-slide-in {
  animation: content-slide-in-key 0.45s cubic-bezier(0, 0, 0.2, 1) forwards;
}

@keyframes content-slide-in-key {
  0% {
    opacity: 0;
    transform: translateY(30rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

/* -----------------------------------------------------------
   24-D. EMPTY STATE ANIMATION
   ----------------------------------------------------------- */

/* Gentle floating up and down for empty state icon */
.empty-icon-animated {
  animation: empty-float 3s ease-in-out infinite;
}

@keyframes empty-float {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-12rpx);
  }
}

/* -----------------------------------------------------------
   24-E. LIST ITEM ENTRANCE (Staggered Rise)
   ----------------------------------------------------------- */

/* Container — children animate on mount */
.list-entrance {
  /* Children will be animated; no transform on container itself */
}

.list-entrance-item {
  opacity: 0;
  animation: list-item-rise 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
}

/* Stagger delays for up to 12 items */
.list-entrance-item:nth-child(1)  { animation-delay: 0.04s; }
.list-entrance-item:nth-child(2)  { animation-delay: 0.08s; }
.list-entrance-item:nth-child(3)  { animation-delay: 0.12s; }
.list-entrance-item:nth-child(4)  { animation-delay: 0.16s; }
.list-entrance-item:nth-child(5)  { animation-delay: 0.20s; }
.list-entrance-item:nth-child(6)  { animation-delay: 0.24s; }
.list-entrance-item:nth-child(7)  { animation-delay: 0.28s; }
.list-entrance-item:nth-child(8)  { animation-delay: 0.32s; }
.list-entrance-item:nth-child(9)  { animation-delay: 0.36s; }
.list-entrance-item:nth-child(10) { animation-delay: 0.40s; }
.list-entrance-item:nth-child(11) { animation-delay: 0.44s; }
.list-entrance-item:nth-child(12) { animation-delay: 0.48s; }

@keyframes list-item-rise {
  0% {
    opacity: 0;
    transform: translateY(20rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}
