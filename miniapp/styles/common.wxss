/* ============================================================
   星光映照 - 薄暮圣殿主题样式系统 (Twilight Sanctuary)
   Redesign v4.0 - Warm Indigo + Candlelight Glow
   ============================================================ */

/* ===== 1. CSS 自定义属性 (Design Tokens) ===== */
page {
  /* ---- 色彩系统 ---- */

  /* 背景 — 暖调深靛蓝：像黄昏时分的冥想室 */
  --color-bg-deep: #0d0d2b;
  --color-bg: #10102e;
  --color-bg-mid: #16163a;
  --color-bg-card: #1c1c40;
  --color-bg-card-elevated: #252550;
  --color-bg-card-glass: rgba(28, 28, 64, 0.88);

  /* 暖调卡片表面 — 带有一丝烛光暖意 */
  --color-bg-card-warm: #1e1e44;
  --color-bg-card-candle: rgba(30, 28, 50, 0.92);

  /* 金色系 — 主强调色 (Sanctuary Gold) */
  --color-gold: #ddb847;
  --color-gold-light: #f0d68a;
  --color-gold-dark: #c4a035;
  --color-gold-glow: rgba(221, 184, 71, 0.30);
  --color-gold-subtle: rgba(221, 184, 71, 0.10);

  /* 金色系扩展 */
  --color-gold-bright: #f5df90;
  --color-gold-aged: #7a5e1a;
  --color-gold-pale: #c9ad50;
  --color-rose-gold: #dba8a8;
  --color-rose-gold-subtle: rgba(219, 168, 168, 0.10);

  /* 烛光暖色 — 新辅助色 (Candlelight Warmth) */
  --color-amber: #d4893a;
  --color-amber-light: #e8a85e;
  --color-amber-glow: rgba(212, 137, 58, 0.25);
  --color-amber-subtle: rgba(212, 137, 58, 0.08);
  --color-candle-core: rgba(255, 200, 120, 0.04);
  --color-candle-glow: radial-gradient(
    ellipse 80% 50% at 50% 8%,
    rgba(255, 200, 120, 0.06) 0%,
    rgba(212, 137, 58, 0.03) 40%,
    transparent 100%
  );

  /* 紫色系 — 辅助色 (Mystic Purple) */
  --color-purple: #9370db;
  --color-purple-light: #b39af0;
  --color-purple-dark: #5a3f9a;
  --color-purple-glow: rgba(147, 112, 219, 0.35);
  --color-purple-subtle: rgba(147, 112, 219, 0.10);

  /* 神秘辉光色 */
  --color-mystic-glow: rgba(147, 112, 219, 0.12);

  /* 卡牌边框色 */
  --color-card-border: rgba(221, 184, 71, 0.20);

  /* 星辰 / 月白 */
  --color-starlight: #ece4d6;
  --color-star-subtle: rgba(236, 228, 214, 0.06);

  /* 语义色 */
  --color-success: #5cd6a0;
  --color-warning: #e8b84b;
  --color-danger: #e85757;

  /* 文字色 — 提高对比度，减少灰色感 */
  --color-text-primary: #efeff6;
  --color-text-secondary: #a8a8cc;
  --color-text-dim: #6868a0;
  --color-text-muted: #404070;
  --color-text-on-gold: #1c1c40;
  --color-text-on-amber: #1a1a30;

  /* 边框 / 分割线 */
  --color-border-subtle: rgba(221, 184, 71, 0.06);
  --color-border-light: rgba(221, 184, 71, 0.12);
  --color-border-glow: rgba(221, 184, 71, 0.22);
  --color-divider: rgba(255, 255, 255, 0.03);

  /* ---- 渐变 ---- */
  --gradient-gold: linear-gradient(135deg, #ddb847, #f0d68a);
  --gradient-gold-reverse: linear-gradient(135deg, #f0d68a, #ddb847);
  --gradient-purple: linear-gradient(135deg, #5a3f9a, #9370db);
  --gradient-mystic: linear-gradient(135deg, #16163a, #1c1c40);
  --gradient-card-border: linear-gradient(135deg,
    rgba(221, 184, 71, 0.22), rgba(147, 112, 219, 0.12), rgba(221, 184, 71, 0.04));
  --gradient-glass: linear-gradient(135deg,
    rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.01));
  --gradient-bg-radial: radial-gradient(ellipse at 50% 0%,
    rgba(147, 112, 219, 0.06) 0%, transparent 70%);
  --gradient-bg-radial-gold: radial-gradient(ellipse at 50% 100%,
    rgba(221, 184, 71, 0.04) 0%, transparent 60%);

  /* 烛光环境光渐变 */
  --gradient-candle-ambient: radial-gradient(
    ellipse 70% 40% at 50% 6%,
    rgba(212, 137, 58, 0.07) 0%,
    rgba(221, 184, 71, 0.03) 50%,
    transparent 100%
  );

  /* ---- 排版 ---- */
  --font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC',
    'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  --font-family-display: 'PingFang SC', 'Hiragino Sans GB',
    'Microsoft YaHei', serif;

  /* 字号 — 增大标题比例，创造更清晰的层次感 */
  --fs-caption: 20rpx;
  --fs-small: 22rpx;
  --fs-body-small: 24rpx;
  --fs-body: 28rpx;
  --fs-body-large: 30rpx;
  --fs-h4: 34rpx;
  --fs-h3: 38rpx;
  --fs-h2: 46rpx;
  --fs-h1: 56rpx;
  --fs-display: 64rpx;

  /* 字重 */
  --fw-regular: 400;
  --fw-medium: 500;
  --fw-semibold: 600;
  --fw-bold: 700;

  /* 行高 */
  --lh-tight: 1.2;
  --lh-normal: 1.6;
  --lh-loose: 1.9;

  /* 字间距 — 新：用于庄严感 */
  --ls-heading: 2rpx;
  --ls-display: 4rpx;
  --ls-body: 0.5rpx;

  /* ---- 间距 — 全面增大，给呼吸空间 ---- */
  --space-xxs: 4rpx;
  --space-xs: 8rpx;
  --space-sm: 12rpx;
  --space-md: 16rpx;
  --space-lg: 24rpx;
  --space-xl: 32rpx;
  --space-xxl: 40rpx;
  --space-xxxl: 48rpx;
  --space-huge: 56rpx;
  --space-massive: 72rpx;
  --space-section: 64rpx;

  /* ---- 圆角 ---- */
  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 16rpx;
  --radius-xl: 20rpx;
  --radius-xxl: 24rpx;
  --radius-round: 48rpx;
  --radius-full: 50%;
  --radius-card: 24rpx;
  --radius-button: 48rpx;

  /* ---- 阴影 — 更深邃、更有戏剧性 ---- */
  --shadow-card: 0 6rpx 32rpx rgba(0, 0, 0, 0.35);
  --shadow-card-elevated: 0 12rpx 52rpx rgba(0, 0, 0, 0.45);
  --shadow-glow: 0 0 20rpx rgba(221, 184, 71, 0.12);
  --shadow-glow-gold: 0 0 20rpx rgba(221, 184, 71, 0.18);
  --shadow-glow-amber: 0 0 30rpx rgba(212, 137, 58, 0.15);
  --shadow-glow-purple: 0 0 24rpx rgba(147, 112, 219, 0.18);
  --shadow-button: 0 4rpx 16rpx rgba(221, 184, 71, 0.22);
  --shadow-card-warm: 0 6rpx 32rpx rgba(0, 0, 0, 0.35),
    0 0 40rpx rgba(212, 137, 58, 0.04);

  /* ---- 动画 — 放慢，营造沉思冥想感 ---- */
  --duration-fast: 0.3s;
  --duration-normal: 0.45s;
  --duration-slow: 0.7s;
  --duration-shimmer: 3s;
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);
  --ease-mystical: cubic-bezier(0.4, 0, 0.2, 1);

  /* ---- Z 轴层级 ---- */
  --z-base: 1;
  --z-card: 10;
  --z-modal: 100;
  --z-toast: 1000;

  /* ---- 页面基础 ---- */
  background-color: var(--color-bg);
  background-image:
    /* 星尘粒子 — 更柔和 */
    radial-gradient(1rpx 1rpx at 22% 15%, rgba(236,228,214,0.025), transparent),
    radial-gradient(1rpx 1rpx at 65% 25%, rgba(221,184,71,0.02), transparent),
    radial-gradient(1rpx 1rpx at 82% 72%, rgba(147,112,219,0.018), transparent),
    radial-gradient(1rpx 1rpx at 38% 78%, rgba(236,228,214,0.018), transparent),
    radial-gradient(1rpx 1rpx at 12% 62%, rgba(221,184,71,0.012), transparent),
    radial-gradient(1rpx 1rpx at 55% 45%, rgba(236,228,214,0.012), transparent),
    /* 顶部环境光 — 烛光暖晕 */
    radial-gradient(ellipse 70% 30% at 50% 0%,
      rgba(255, 200, 120, 0.04) 0%,
      rgba(212, 137, 58, 0.02) 40%,
      transparent 100%),
    /* 原有渐变 — 降低透明度协调 */
    var(--gradient-bg-radial),
    var(--gradient-bg-radial-gold);
  color: var(--color-text-primary);
  font-family: var(--font-family);
  font-size: var(--fs-body);
  line-height: var(--lh-normal);
  letter-spacing: var(--ls-body);
}


/* ===== 2. 全局动画关键帧 ===== */
/*    核心原则：放慢节奏，营造沉思冥想的视觉氛围 */

/* 2.1 星尘粒子闪烁 — 更缓、更柔 */
@keyframes twinkle {
  0%, 100% { opacity: 0.15; transform: scale(0.6); }
  50% { opacity: 1; transform: scale(1.1); }
}

/* 2.2 金色光芒脉冲 (按钮发光) — 更慢的呼吸感 */
@keyframes glow-pulse {
  0%, 100% { box-shadow: 0 0 6rpx var(--color-gold-glow), 0 0 0rpx transparent; }
  50% { box-shadow: 0 0 20rpx var(--color-gold-glow), 0 0 40rpx var(--color-gold-subtle); }
}

/* 2.3 金色流光 (shimmer) */
@keyframes shimmer {
  0% { background-position: -200% center; }
  100% { background-position: 200% center; }
}

/* 2.4 淡入上升 — 更从容 */
@keyframes fade-in-up {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 2.5 淡入 */
@keyframes fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* 2.6 卡片翻转 */
@keyframes card-flip {
  0% { transform: perspective(800rpx) rotateY(0deg); }
  100% { transform: perspective(800rpx) rotateY(180deg); }
}

/* 2.7 神秘旋转 — 更缓慢庄重 */
@keyframes mystic-spin {
  0% { transform: rotate(0deg) scale(1); }
  50% { transform: rotate(180deg) scale(1.08); }
  100% { transform: rotate(360deg) scale(1); }
}

/* 2.8 呼吸发光 — 更深长的呼吸 */
@keyframes breathe {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}

/* 2.9 渐变边框流动 */
@keyframes border-flow {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

/* 2.10 浮动 */
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8rpx); }
}

/* 2.11 脉冲缩放 */
@keyframes pulse-scale {
  0%, 100% { transform: scale(1); opacity: 0.6; }
  50% { transform: scale(1.04); opacity: 1; }
}

/* 2.12 卡牌扫光特效 */
@keyframes card-shimmer {
  0% { transform: translateX(-100%) skewX(-15deg); opacity: 0; }
  20% { opacity: 0.5; }
  100% { transform: translateX(200%) skewX(-15deg); opacity: 0; }
}

/* 2.13 紫色神秘波动 */
@keyframes mystic-wave {
  0%, 100% { transform: scale(1); opacity: 0.10; }
  50% { transform: scale(1.06); opacity: 0.25; }
}

/* 2.14 文字光标闪烁 */
@keyframes cursor-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

/* 2.15 烛光摇曳 — 新：环境光微动 */
@keyframes candle-flicker {
  0%, 100% { opacity: 0.6; transform: scale(1); }
  25% { opacity: 0.8; transform: scale(1.02); }
  50% { opacity: 0.5; transform: scale(0.98); }
  75% { opacity: 0.7; transform: scale(1.01); }
}

/* 2.16 光圈呼吸 — 新：用于聚焦元素 */
@keyframes halo-breathe {
  0%, 100% { box-shadow: 0 0 8rpx var(--color-gold-glow), 0 0 16rpx var(--color-gold-subtle); }
  50% { box-shadow: 0 0 16rpx var(--color-gold-glow), 0 0 40rpx var(--color-gold-subtle); }
}


/* ===== 3. 页面容器 ===== */

.page {
  min-height: 100vh;
  padding: var(--space-xl);
  padding-bottom: calc(env(safe-area-inset-bottom) + var(--space-massive));
  background: var(--color-bg);
  background-image:
    var(--gradient-candle-ambient),
    var(--gradient-bg-radial),
    var(--gradient-bg-radial-gold);
}

.page-full {
  min-height: 100vh;
  background: var(--color-bg);
  background-image:
    var(--gradient-candle-ambient),
    var(--gradient-bg-radial),
    var(--gradient-bg-radial-gold);
}


/* ===== 4. 卡片表面 ===== */

/* 4.1 基础卡片 — 暖调底色 + 深沉阴影 */
.card {
  background: var(--color-bg-card-warm);
  border-radius: var(--radius-card);
  padding: var(--space-xl);
  border: 1rpx solid var(--color-border-subtle);
  box-shadow: var(--shadow-card-warm);
  position: relative;
  overflow: hidden;
}

/* 4.2 毛玻璃卡片 */
.card-glass {
  background: var(--color-bg-card-glass);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: var(--radius-card);
  padding: var(--space-xl);
  border: 1rpx solid var(--color-border-light);
  box-shadow: var(--shadow-card);
}

/* 4.3 高级金属感卡片 — 暖色光晕更明显 */
.card-premium {
  background: linear-gradient(145deg,
    rgba(30, 28, 50, 0.95), rgba(37, 37, 80, 0.85));
  border-radius: var(--radius-card);
  padding: var(--space-xxl);
  border: 1rpx solid var(--color-border-glow);
  box-shadow: var(--shadow-card-elevated), var(--shadow-glow-gold);
  position: relative;
  overflow: hidden;
}

/* 4.4 卡片顶部装饰光晕 — 从金色变为暖金混合 */
.card-premium::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle at 30% 20%,
    rgba(221, 184, 71, 0.05), rgba(212, 137, 58, 0.03) 50%, transparent 60%);
  pointer-events: none;
}

/* 4.5 渐变边框卡片 */
.card-gradient-border {
  position: relative;
  border-radius: var(--radius-card);
  background: var(--color-bg-card-warm);
  background-clip: padding-box;
  z-index: 1;
}
.card-gradient-border::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  border-radius: var(--radius-card);
  padding: 2rpx;
  background: var(--gradient-card-border);
  background-size: 200% 200%;
  animation: border-flow 6s var(--ease-in-out) infinite;
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  pointer-events: none;
  z-index: -1;
}

/* 4.6 可点击卡片 */
.card-clickable {
  transition: all var(--duration-normal) var(--ease-out);
}
.card-clickable:active {
  transform: scale(0.97);
  border-color: var(--color-border-glow);
}

/* 4.7 卡片扫光装饰 */
.card::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 60rpx;
  height: 100%;
  background: linear-gradient(90deg,
    transparent,
    rgba(255, 255, 255, 0.03),
    transparent);
  transform: translateX(-100%) skewX(-15deg);
  pointer-events: none;
}
.card:hover::after {
  animation: card-shimmer 2.5s var(--ease-in-out);
}


/* ===== 5. 按钮系统 ===== */

/* 5.1 主按钮 */
.btn-primary {
  width: 100%;
  background: var(--gradient-gold);
  color: var(--color-text-on-gold);
  font-size: var(--fs-h4);
  font-weight: var(--fw-bold);
  border-radius: var(--radius-button);
  padding: 28rpx 0;
  border: none;
  box-shadow: var(--shadow-button);
  transition: all var(--duration-normal) var(--ease-out);
  position: relative;
  overflow: hidden;
}

.btn-primary:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 8rpx var(--color-gold-glow);
}

/* 5.2 流光按钮 */
.btn-shimmer {
  width: 100%;
  background: var(--gradient-gold);
  background-size: 200% 100%;
  animation: shimmer var(--duration-shimmer) ease-in-out infinite;
  color: var(--color-text-on-gold);
  font-size: var(--fs-h4);
  font-weight: var(--fw-bold);
  border-radius: var(--radius-button);
  padding: 28rpx 0;
  border: none;
  box-shadow: var(--shadow-button);
  position: relative;
  overflow: hidden;
}

.btn-shimmer:active {
  transform: scale(0.97);
}

/* 5.3 辉光脉冲按钮 */
.btn-glow-pulse {
  width: 100%;
  background: var(--gradient-gold);
  color: var(--color-text-on-gold);
  font-size: var(--fs-h4);
  font-weight: var(--fw-bold);
  border-radius: var(--radius-button);
  padding: 28rpx 0;
  border: none;
  animation: glow-pulse 3s var(--ease-in-out) infinite;
}

.btn-glow-pulse:active {
  transform: scale(0.97);
}

/* 5.4 二级按钮 */
.btn-secondary {
  width: 100%;
  background: transparent;
  color: var(--color-gold);
  font-size: var(--fs-body-large);
  font-weight: var(--fw-semibold);
  border-radius: var(--radius-button);
  padding: 24rpx 0;
  border: 2rpx solid var(--color-gold);
  transition: all var(--duration-normal) var(--ease-out);
}

.btn-secondary:active {
  background: var(--color-gold-subtle);
  transform: scale(0.97);
}

/* 5.5 幽灵按钮 */
.btn-ghost {
  background: transparent;
  color: var(--color-text-secondary);
  font-size: var(--fs-body);
  border: none;
  padding: var(--space-sm) var(--space-lg);
  border-radius: var(--radius-round);
  transition: all var(--duration-fast);
}

.btn-ghost:active {
  background: var(--color-star-subtle);
  color: var(--color-text-primary);
}

/* 5.6 文字按钮 */
.btn-text {
  background: none;
  border: none;
  color: var(--color-gold);
  font-size: var(--fs-body);
  padding: var(--space-xs);
  display: inline-block;
}

/* 5.7 小号按钮 */
.btn-small {
  font-size: var(--fs-body-small);
  padding: 16rpx 32rpx;
  border-radius: var(--radius-xl);
}


/* ===== 6. 文字排版 — 增强层次感 ===== */

.heading-1 {
  font-size: var(--fs-h1);
  font-weight: var(--fw-bold);
  color: var(--color-gold-light);
  line-height: var(--lh-tight);
  letter-spacing: var(--ls-heading);
  text-shadow: 0 0 40rpx rgba(221, 184, 71, 0.15);
}

.heading-2 {
  font-size: var(--fs-h2);
  font-weight: var(--fw-bold);
  color: var(--color-gold);
  line-height: var(--lh-tight);
  letter-spacing: var(--ls-heading);
}

.heading-3 {
  font-size: var(--fs-h3);
  font-weight: var(--fw-semibold);
  color: var(--color-text-primary);
  line-height: var(--lh-tight);
  letter-spacing: var(--ls-heading);
}

.heading-4 {
  font-size: var(--fs-h4);
  font-weight: var(--fw-semibold);
  color: var(--color-text-primary);
  line-height: var(--lh-tight);
}

.text-body {
  font-size: var(--fs-body);
  color: var(--color-text-primary);
  line-height: var(--lh-loose);
}

.text-secondary {
  font-size: var(--fs-body);
  color: var(--color-text-secondary);
}

.text-dim {
  font-size: var(--fs-body-small);
  color: var(--color-text-dim);
}

.text-caption {
  font-size: var(--fs-caption);
  color: var(--color-text-dim);
}

.text-gold {
  color: var(--color-gold);
}

.text-gold-bright {
  color: var(--color-gold-bright);
}

.text-rose-gold {
  color: var(--color-rose-gold);
}

.text-gold-aged {
  color: var(--color-gold-aged);
}

.text-center {
  text-align: center;
}


/* ===== 7. 星尘粒子背景 ===== */

.star-field {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
}

.star-particle {
  position: absolute;
  width: 4rpx;
  height: 4rpx;
  background: var(--color-starlight);
  border-radius: var(--radius-full);
  animation: twinkle 4s ease-in-out infinite;
}

.star-particle:nth-child(1) { top: 10%; left: 15%; animation-delay: 0s; width: 3rpx; height: 3rpx; }
.star-particle:nth-child(2) { top: 25%; left: 80%; animation-delay: 0.8s; width: 5rpx; height: 5rpx; }
.star-particle:nth-child(3) { top: 45%; left: 5%; animation-delay: 1.6s; }
.star-particle:nth-child(4) { top: 60%; left: 90%; animation-delay: 0.4s; width: 3rpx; height: 3rpx; }
.star-particle:nth-child(5) { top: 75%; left: 20%; animation-delay: 2.2s; width: 4rpx; height: 4rpx; }
.star-particle:nth-child(6) { top: 85%; left: 70%; animation-delay: 1s; width: 6rpx; height: 6rpx; }
.star-particle:nth-child(7) { top: 15%; left: 50%; animation-delay: 0.6s; width: 3rpx; height: 3rpx; }
.star-particle:nth-child(8) { top: 50%; left: 75%; animation-delay: 1.8s; }
.star-particle:nth-child(9) { top: 35%; left: 35%; animation-delay: 0.3s; width: 5rpx; height: 5rpx; }
.star-particle:nth-child(10) { top: 70%; left: 50%; animation-delay: 2.5s; width: 3rpx; height: 3rpx; }


/* ===== 8. 发光与装饰效果 ===== */

.glow-gold {
  box-shadow: var(--shadow-glow-gold);
}

.glow-amber {
  box-shadow: var(--shadow-glow-amber);
}

.glow-purple {
  box-shadow: var(--shadow-glow-purple);
}

.glow-border {
  position: relative;
}
.glow-border::after {
  content: '';
  position: absolute;
  top: -2rpx;
  left: -2rpx;
  right: -2rpx;
  bottom: -2rpx;
  border-radius: inherit;
  background: var(--gradient-gold);
  opacity: 0;
  z-index: -1;
  transition: opacity var(--duration-normal);
}
.glow-border:hover::after {
  opacity: 0.3;
}

/* 顶部光晕 — 暖色烛光感 */
.orb-top {
  position: fixed;
  top: -200rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 600rpx;
  height: 600rpx;
  border-radius: var(--radius-full);
  background: radial-gradient(circle,
    rgba(212, 137, 58, 0.06) 0%,
    rgba(221, 184, 71, 0.03) 30%,
    rgba(147, 112, 219, 0.02) 50%,
    transparent 70%);
  pointer-events: none;
  z-index: 0;
}

/* 底部光晕 */
.orb-bottom {
  position: fixed;
  bottom: -300rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 600rpx;
  height: 600rpx;
  border-radius: var(--radius-full);
  background: radial-gradient(circle,
    rgba(221, 184, 71, 0.05) 0%,
    rgba(212, 137, 58, 0.02) 40%,
    transparent 60%);
  pointer-events: none;
  z-index: 0;
}


/* ===== 9. 加载与占卜动画 ===== */

/* 9.1 占卜加载页 */
.mystic-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: var(--space-xxl);
  background: var(--color-bg);
}

.mystic-loading-symbol {
  font-size: 80rpx;
  color: var(--color-gold);
  animation: mystic-spin 5s var(--ease-in-out) infinite;
  display: block;
  margin-bottom: var(--space-xxl);
}

.mystic-loading-title {
  font-size: var(--fs-h4);
  color: var(--color-gold);
  font-weight: var(--fw-semibold);
  animation: breathe 3s ease-in-out infinite;
}

.mystic-loading-sub {
  font-size: var(--fs-body);
  color: var(--color-text-secondary);
  margin-top: var(--space-sm);
}

/* 9.2 卡片翻转动画 */
.card-flip-container {
  perspective: 1000rpx;
  width: 300rpx;
  height: 420rpx;
}

.card-flip-inner {
  position: relative;
  width: 100%;
  height: 100%;
  transition: transform var(--duration-slow) var(--ease-out);
  transform-style: preserve-3d;
}

.card-flip-inner.flipped {
  transform: rotateY(180deg);
}

.card-flip-front,
.card-flip-back {
  position: absolute;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  border-radius: var(--radius-card);
}

.card-flip-front {
  background: var(--gradient-purple);
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-flip-back {
  background: var(--color-bg-card-warm);
  border: 2rpx solid var(--color-gold);
  transform: rotateY(180deg);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}


/* ===== 10. 分段标题与布局 ===== */

.section-block {
  margin-bottom: var(--space-section);
}

.section-title {
  font-size: var(--fs-h4);
  font-weight: var(--fw-semibold);
  color: var(--color-text-primary);
  display: block;
  margin-bottom: var(--space-lg);
  position: relative;
  padding-left: var(--space-xxl);
  letter-spacing: var(--ls-heading);
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 4rpx;
  bottom: 4rpx;
  width: 4rpx;
  background: linear-gradient(
    180deg,
    var(--color-gold-bright) 0%,
    var(--color-gold) 40%,
    var(--color-purple-light) 70%,
    transparent 100%
  );
  border-radius: 4rpx;
}

.section-title::after {
  content: '✦';
  position: absolute;
  left: -6rpx;
  top: 0;
  font-size: 16rpx;
  color: var(--color-gold-bright);
  opacity: 0.6;
}

.section-title-center {
  font-size: var(--fs-h4);
  font-weight: var(--fw-semibold);
  color: var(--color-gold);
  display: block;
  text-align: center;
  margin-bottom: var(--space-xl);
  letter-spacing: var(--ls-heading);
}

/* 10.2 符文神秘按钮 */
.btn-mystical {
  width: 100%;
  background: linear-gradient(135deg, #1e1e44, #16163a);
  color: var(--color-gold-bright);
  font-size: var(--fs-h4);
  font-weight: var(--fw-bold);
  border-radius: var(--radius-button);
  padding: 28rpx 0;
  border: 2rpx solid var(--color-gold);
  box-shadow: var(--shadow-button),
    inset 0 0 40rpx rgba(221, 184, 71, 0.03);
  position: relative;
  overflow: hidden;
  transition: all var(--duration-normal) var(--ease-out);
  letter-spacing: 3rpx;
}

.btn-mystical::before,
.btn-mystical::after {
  content: '◈';
  position: absolute;
  font-size: 18rpx;
  color: var(--color-gold);
  opacity: 0.35;
}

.btn-mystical::before {
  top: 8rpx;
  left: var(--space-lg);
}

.btn-mystical::after {
  bottom: 8rpx;
  right: var(--space-lg);
  transform: scaleX(-1);
}

.btn-mystical:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 8rpx var(--color-gold-glow);
}

/* 10.3 仪式圆环装饰 */
.ritual-circle {
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  border: 2rpx solid var(--color-gold-subtle);
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
}

.ritual-circle::before {
  content: '';
  position: absolute;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(221, 184, 71, 0.08);
  pointer-events: none;
}

.ritual-circle::after {
  content: '';
  position: absolute;
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(221, 184, 71, 0.05);
  animation: mystic-spin 20s linear infinite;
  pointer-events: none;
}

/* 10.4 首字下沉 */
.drop-cap::first-letter {
  font-size: 60rpx;
  font-weight: var(--fw-bold);
  color: var(--color-gold);
  float: left;
  margin-right: 8rpx;
  line-height: 1;
  font-family: var(--font-family-display);
}

/* 10.5 天鹅绒布面背景 — 更暖、更深邃 */
.cloth-bg {
  position: relative;
  background:
    radial-gradient(ellipse at 50% 0%, rgba(60, 20, 80, 0.10), transparent 60%),
    radial-gradient(ellipse at 50% 100%, rgba(221, 184, 71, 0.03), transparent 50%),
    linear-gradient(180deg, #12122e, #10102e);
  border-radius: var(--radius-card);
  border: 1rpx solid var(--color-border-subtle);
  overflow: hidden;
}

.cloth-bg::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: repeating-linear-gradient(
    0deg,
    transparent,
    transparent 3rpx,
    rgba(255, 255, 255, 0.002) 3rpx,
    rgba(255, 255, 255, 0.002) 4rpx
  );
  pointer-events: none;
}

/* 10.6 符号分隔线 */
.divider-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-md);
  margin: var(--space-xxl) 0;
  color: var(--color-gold);
  font-size: var(--fs-caption);
  opacity: 0.5;
}

.divider-symbol::before,
.divider-symbol::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, var(--color-gold-subtle), transparent);
}


/* ===== 11. 表单与输入 ===== */

.input-box {
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  padding: var(--space-xl);
  border: 1rpx solid var(--color-border-subtle);
  transition: border-color var(--duration-normal);
}

.input-box:focus-within {
  border-color: var(--color-gold);
  box-shadow: var(--shadow-glow-gold);
}

.input-label {
  font-size: var(--fs-body);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--space-sm);
}

.input-field {
  width: 100%;
  min-height: 160rpx;
  background: transparent;
  font-size: var(--fs-body);
  color: var(--color-text-primary);
  line-height: var(--lh-loose);
  border: none;
  outline: none;
  padding: 0;
}

.input-count {
  font-size: var(--fs-caption);
  color: var(--color-text-dim);
  text-align: right;
  display: block;
  margin-top: var(--space-xs);
}


/* ===== 12. 标签 / Badge ===== */

.badge {
  display: inline-block;
  font-size: var(--fs-caption);
  padding: 4rpx 16rpx;
  border-radius: var(--radius-round);
}

.badge-gold {
  background: var(--color-gold-subtle);
  color: var(--color-gold);
}

.badge-purple {
  background: var(--color-purple-subtle);
  color: var(--color-purple);
}

.badge-premium {
  background: var(--gradient-gold);
  color: var(--color-text-on-gold);
  font-weight: var(--fw-semibold);
  padding: 6rpx 20rpx;
}

.badge-rose-gold {
  background: var(--color-rose-gold-subtle);
  color: var(--color-rose-gold);
}

.badge-success {
  background: rgba(92, 214, 160, 0.15);
  color: var(--color-success);
}

.badge-danger {
  background: rgba(232, 87, 87, 0.15);
  color: var(--color-danger);
}


/* ===== 13. 分隔线 ===== */

.divider {
  height: 1rpx;
  background: var(--color-divider);
  margin: var(--space-lg) 0;
}

.divider-gold {
  height: 1rpx;
  background: linear-gradient(90deg,
    transparent, var(--color-gold-subtle), transparent);
  margin: var(--space-lg) 0;
}


/* ===== 14. 点 / 指示器 ===== */

.dots {
  display: flex;
  justify-content: center;
  gap: var(--space-md);
  padding: var(--space-md) 0;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: var(--radius-full);
  background: var(--color-border-subtle);
  transition: all var(--duration-normal);
}

.dot-active {
  width: 36rpx;
  border-radius: var(--radius-round);
  background: var(--color-gold);
}


/* ===== 15. 动画实用类 ===== */

.anim-fade-in {
  animation: fade-in var(--duration-slow) var(--ease-out) forwards;
}

.anim-fade-in-up {
  animation: fade-in-up var(--duration-slow) var(--ease-out) forwards;
}

.anim-fade-in-up-1 { animation: fade-in-up 0.7s var(--ease-out) 0.1s both; }
.anim-fade-in-up-2 { animation: fade-in-up 0.7s var(--ease-out) 0.2s both; }
.anim-fade-in-up-3 { animation: fade-in-up 0.7s var(--ease-out) 0.3s both; }
.anim-fade-in-up-4 { animation: fade-in-up 0.7s var(--ease-out) 0.4s both; }
.anim-fade-in-up-5 { animation: fade-in-up 0.7s var(--ease-out) 0.5s both; }

.anim-float {
  animation: float 4s var(--ease-in-out) infinite;
}

.anim-breathe {
  animation: breathe 4s var(--ease-in-out) infinite;
}

.anim-glow-pulse {
  animation: glow-pulse 3s var(--ease-in-out) infinite;
}

.anim-pulse-scale {
  animation: pulse-scale 2s var(--ease-in-out) infinite;
}

.anim-candle-flicker {
  animation: candle-flicker 6s var(--ease-in-out) infinite;
}

.anim-halo-breathe {
  animation: halo-breathe 4s var(--ease-in-out) infinite;
}

.anim-delay-1  { animation-delay: 0.1s; }
.anim-delay-2  { animation-delay: 0.2s; }
.anim-delay-3  { animation-delay: 0.3s; }
.anim-delay-4  { animation-delay: 0.4s; }
.anim-delay-5  { animation-delay: 0.5s; }


/* ===== 16. 间距实用类 ===== */

.mt-xs { margin-top: var(--space-xs); }
.mt-sm { margin-top: var(--space-sm); }
.mt-md { margin-top: var(--space-md); }
.mt-lg { margin-top: var(--space-lg); }
.mt-xl { margin-top: var(--space-xl); }
.mt-xxl { margin-top: var(--space-xxl); }
.mt-xxxl { margin-top: var(--space-xxxl); }

.mb-xs { margin-bottom: var(--space-xs); }
.mb-sm { margin-bottom: var(--space-sm); }
.mb-md { margin-bottom: var(--space-md); }
.mb-lg { margin-bottom: var(--space-lg); }
.mb-xl { margin-bottom: var(--space-xl); }
.mb-xxl { margin-bottom: var(--space-xxl); }
.mb-xxxl { margin-bottom: var(--space-xxxl); }

.p-xs { padding: var(--space-xs); }
.p-sm { padding: var(--space-sm); }
.p-md { padding: var(--space-md); }
.p-lg { padding: var(--space-lg); }
.p-xl { padding: var(--space-xl); }
.p-xxl { padding: var(--space-xxl); }
.p-xxxl { padding: var(--space-xxxl); }

.px-lg { padding-left: var(--space-lg); padding-right: var(--space-lg); }
.px-xl { padding-left: var(--space-xl); padding-right: var(--space-xl); }
.py-lg { padding-top: var(--space-lg); padding-bottom: var(--space-lg); }
.py-xl { padding-top: var(--space-xl); padding-bottom: var(--space-xl); }


/* ===== 17. 弹出层 / Modal ===== */

.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.75);
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
  display: flex;
  align-items: flex-end;
  z-index: var(--z-modal);
}

.modal-content {
  width: 100%;
  background: var(--color-bg-card-warm);
  border-radius: var(--radius-xxl) var(--radius-xxl) 0 0;
  padding: var(--space-xxxl) var(--space-xxl) calc(var(--space-massive) + env(safe-area-inset-bottom));
  max-height: 80vh;
  overflow-y: auto;
  animation: fade-in-up 0.5s var(--ease-out);
}

.modal-title {
  font-size: var(--fs-h4);
  font-weight: var(--fw-bold);
  color: var(--color-gold);
  display: block;
  text-align: center;
  margin-bottom: var(--space-xxl);
}


/* ===== 18. 选项选择器 ===== */

.options-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
}

.option-item {
  padding: 14rpx var(--space-xl);
  border-radius: var(--radius-round);
  font-size: var(--fs-body);
  background: var(--color-bg-card);
  color: var(--color-text-secondary);
  border: 2rpx solid transparent;
  transition: all var(--duration-normal);
}

.option-item.selected {
  border-color: var(--color-gold);
  color: var(--color-gold);
  background: var(--color-gold-subtle);
  box-shadow: var(--shadow-glow-gold);
}

.option-item:active {
  transform: scale(0.95);
}


/* ===== 19. 空状态 ===== */

.empty-state {
  text-align: center;
  padding: var(--space-massive) 0;
}

.empty-icon {
  font-size: 72rpx;
  display: block;
  margin-bottom: var(--space-md);
  opacity: 0.6;
}

.empty-text {
  font-size: var(--fs-body);
  color: var(--color-text-secondary);
  display: block;
}

.empty-hint {
  font-size: var(--fs-body-small);
  color: var(--color-text-dim);
  display: block;
  margin-top: var(--space-xs);
}


/* ===== 20. 加载占位 ===== */

.loading-placeholder {
  text-align: center;
  padding: 200rpx 0;
  color: var(--color-text-secondary);
}


/* ===== 21. 会员/高级标记 ===== */

.premium-border {
  border: 2rpx solid transparent;
  background-clip: padding-box;
  position: relative;
}
.premium-border::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  border-radius: inherit;
  padding: 2rpx;
  background: var(--gradient-gold);
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  pointer-events: none;
}


/* ===== 22. 占卜结果页专用 ===== */

.interpretation-scroll {
  max-height: 600rpx;
  overflow: hidden;
  position: relative;
}

.interpretation-scroll.expanded {
  max-height: none;
}

.interpretation-scroll:not(.expanded)::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: linear-gradient(transparent, var(--color-bg-card-warm));
  pointer-events: none;
}

.interpretation-text {
  font-size: var(--fs-body);
  color: var(--color-text-primary);
  line-height: var(--lh-loose);
  white-space: pre-wrap;
}

.expand-hint {
  display: block;
  text-align: center;
  color: var(--color-gold);
  font-size: var(--fs-body);
  padding: var(--space-md) 0;
}


/* ===== 操作栏 ===== */

.action-bar {
  display: flex;
  justify-content: center;
  gap: var(--space-huge);
  margin-top: var(--space-xs);
}

.action-link {
  font-size: var(--fs-body);
  color: var(--color-text-dim);
  padding: var(--space-sm) 0;
  background: none;
  border: none;
}

.action-link:active {
  color: var(--color-gold);
}


/* ===== 23. 工具类 ===== */

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.gap-sm { gap: var(--space-sm); }
.gap-md { gap: var(--space-md); }
.gap-lg { gap: var(--space-lg); }
.gap-xl { gap: var(--space-xl); }

.relative {
  position: relative;
}

.overflow-hidden {
  overflow: hidden;
}
