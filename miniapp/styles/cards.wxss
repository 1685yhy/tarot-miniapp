/* ============================================================
   Card System — 3 variants (Design Council PRD 5.5)
   card-default | card-interactive | card-featured
   ------------------------------------------------------------
   Consolidates the previous 7 variants
   (warm, teaching, press, reveal, rise, float, shimmer) into 3.

   WXSS has no `composes` / `@extend`, so each variant repeats
   the base card styles explicitly. Values stay consistent via
   the design tokens in styles/common.wxss.

   NOTE: .card-interactive deliberately mirrors the .card base
   (styles/common.wxss) so `card card-interactive` renders
   identically to the previous pressable card pattern —
   no visual regression.
   ============================================================ */

/* -----------------------------------------------------------
   card-default — base card for info display
   ----------------------------------------------------------- */
.card-default {
  background: linear-gradient(145deg, #FFFDF8 0%, #F7F0E3 40%, #F4EDE0 100%);
  border: 1.5rpx solid rgba(201, 169, 124, 0.30);
  border-radius: 16rpx;
  padding: var(--spacing-md);
  box-shadow: 0 4rpx 24rpx rgba(61, 58, 54, 0.10);
}

/* -----------------------------------------------------------
   card-interactive — tappable card with press feedback
   (base styles copied from card-default, aligned to the .card
   base in common.wxss to preserve existing appearance)
   ----------------------------------------------------------- */
.card-interactive {
  background: var(--color-surface-gradient);
  border: 1.5rpx solid var(--color-card-border);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  box-shadow: var(--shadow-card);
  position: relative;
  overflow: hidden;
  transition: transform var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out), box-shadow var(--duration-fast) var(--ease-out);
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}

.card-interactive:active {
  transform: scale(0.97);
  border-color: rgba(201, 169, 124, 0.70) !important;
  box-shadow: var(--shadow-pressed);
}

/* -----------------------------------------------------------
   card-featured — daily card only, breathing glow border
   (the breathing glow overlay itself is page-scoped in
   pages/index/index.wxss — see .card-ready .card-featured)
   ----------------------------------------------------------- */
.card-featured {
  background: linear-gradient(145deg, #FFFDF8 0%, #F7F0E3 40%, #F4EDE0 100%);
  border: 1.5rpx solid rgba(201, 169, 124, 0.45);
  border-radius: 16rpx;
  padding: var(--spacing-md);
  box-shadow: 0 4rpx 24rpx rgba(61, 58, 54, 0.10), 0 0 50rpx rgba(201, 169, 124, 0.08);
  position: relative;
  overflow: hidden;
}
