/* ============================================================
   星光名片落地页 — E3 奶油疗愈明亮主题
   奶油米白 #FAF6EF · 表面 #FFFDF8 · 细金 #C9A97C · 金深 #8A6B3D
   墨 #3D3A36 · 深灰紫 #6E6A96
   ============================================================ */

.cl-page {
  min-height: 100vh;
  background: var(--color-bg-gradient, linear-gradient(180deg, #FAF6EF 0%, #F7F0E3 40%, #F2ECDF 100%));
  padding: var(--spacing-2xl, 64rpx) var(--page-padding, 32rpx) calc(var(--safe-area-bottom, 0px) + 64rpx);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* ── 顶部装饰星 ── */
.cl-sky {
  position: relative;
  width: 100%;
  height: 120rpx;
  margin-bottom: var(--spacing-md, 24rpx);
}

.cl-star {
  position: absolute;
  color: var(--color-gold, #C9A97C);
  font-size: 28rpx;
  opacity: 0.7;
}

.cl-star-1 { top: 8rpx;  left: 14%; font-size: 24rpx; }
.cl-star-2 { top: 40rpx; left: 78%; font-size: 30rpx; color: var(--color-lavender-deep, #6E6A96); opacity: 0.5; }
.cl-star-3 { top: 80rpx; left: 30%; font-size: 20rpx; opacity: 0.45; }
.cl-star-4 { top: 6rpx;  left: 62%; font-size: 22rpx; opacity: 0.5; }

/* ── 加载 / 错误状态 ── */
.cl-state {
  margin-top: 30vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-md, 24rpx);
}

.cl-state-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid var(--color-gold-light, #D9BC8F);
  border-top-color: var(--color-gold-deep-ink, #8A6B3D);
  border-radius: var(--radius-full, 50%);
  animation: cl-spin 0.9s linear infinite;
}

@keyframes cl-spin {
  to { transform: rotate(360deg); }
}

.cl-state-text {
  color: var(--color-text-tertiary, #6E6A96);
  font-size: var(--font-size-body, 30rpx);
}

.cl-state-text--err {
  color: var(--color-error, #E87A8A);
}

/* ── 名片卡面 ── */
.cl-wrap {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cl-card {
  width: 100%;
  max-width: 620rpx;
  background: var(--color-surface, #FFFDF8);
  border: 2rpx solid var(--color-card-border, rgba(201, 169, 124, 0.28));
  border-radius: var(--radius-lg, 24rpx);
  box-shadow: var(--shadow-elevated, 0 8rpx 30rpx rgba(61, 58, 54, 0.10));
  padding: var(--spacing-2xl, 64rpx) var(--spacing-lg, 32rpx) var(--spacing-xl, 48rpx);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cl-card-brand {
  color: var(--color-gold-deep-ink, #8A6B3D);
  font-size: var(--font-size-subhead, 36rpx);
  font-weight: var(--font-weight-bold, 700);
  letter-spacing: 6rpx;
}

.cl-avatar {
  margin-top: var(--spacing-xl, 48rpx);
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--radius-full, 50%);
  background: var(--color-gold-glow-strong, rgba(201, 169, 124, 0.22));
  border: 2rpx solid var(--color-gold, #C9A97C);
  color: var(--color-gold-deep-ink, #8A6B3D);
  font-size: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cl-name {
  margin-top: var(--spacing-lg, 32rpx);
  color: var(--color-text-primary, #3D3A36);
  font-size: var(--font-size-title, 44rpx);
  font-weight: var(--font-weight-semibold, 600);
  max-width: 90%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ── 星阶徽章 + 星光数 chips ── */
.cl-tags {
  margin-top: var(--spacing-lg, 32rpx);
  display: flex;
  gap: var(--spacing-sm, 16rpx);
}

.cl-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 28rpx;
  border-radius: var(--radius-pill, 999rpx);
  border: 1rpx solid var(--color-card-border-hover, rgba(201, 169, 124, 0.45));
  background: rgba(255, 253, 248, 0.9);
  color: var(--color-gold-deep-ink, #8A6B3D);
  font-size: var(--font-size-caption, 24rpx);
}

.cl-tag--tier {
  color: var(--color-text-primary, #3D3A36);
  font-weight: var(--font-weight-medium, 500);
}

.cl-tag-icon {
  color: var(--color-gold, #C9A97C);
  font-size: 22rpx;
}

/* ── 分隔线 ── */
.cl-divider {
  margin: var(--spacing-xl, 48rpx) auto var(--spacing-xl, 48rpx);
  width: 220rpx;
  height: 2rpx;
  background: rgba(201, 169, 124, 0.45);
}

.cl-cta {
  color: var(--color-gold-deep-ink, #8A6B3D);
  font-size: var(--font-size-subhead, 36rpx);
  font-weight: var(--font-weight-semibold, 600);
  letter-spacing: 4rpx;
}

.cl-cta-sub {
  margin-top: var(--spacing-xs, 12rpx);
  color: var(--color-text-tertiary, #6E6A96);
  font-size: var(--font-size-caption, 24rpx);
}

/* ── CTA 按钮 ── */
.cl-btn {
  margin-top: var(--spacing-2xl, 64rpx);
  width: 100%;
  max-width: 620rpx;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: var(--radius-pill, 999rpx);
  background: linear-gradient(135deg, #D9BC8F 0%, #C9A97C 100%);
  color: #FFFDF8;
  font-size: var(--font-size-subhead, 36rpx);
  font-weight: var(--font-weight-semibold, 600);
  letter-spacing: 2rpx;
  box-shadow: var(--shadow-gold-button, 0 4rpx 14rpx rgba(201, 169, 124, 0.25));
}

.cl-btn::after {
  border: none;
}

.cl-btn:active {
  opacity: 0.88;
  transform: translateY(2rpx);
}

/* ── 底部小字 ── */
.cl-foot {
  margin-top: var(--spacing-lg, 32rpx);
  color: var(--color-text-tertiary, #6E6A96);
  font-size: var(--font-size-caption, 24rpx);
  opacity: 0.8;
}
