/* ===== 百科 - 新艺术运动 "古董书卷" 主题 ===== *
 * 灵感：新艺术运动（Art Nouveau）、穆夏风格、    *
 * 古董标本柜、植物铜版画册                        *
 * 翻阅收藏级植物图鉴的沉静仪式感                 *
 * 色调：象牙暖白 / 铜锈褐 / 翡翠绿              *
 * ============================================= */

/* ===== 搜索栏 - 象牙书卷感 ===== */
.search-bar {
  display: flex;
  align-items: center;
  background: #f7f2ea;
  border-radius: 60rpx;
  padding: 20rpx 44rpx;
  margin-bottom: 44rpx;
  border: 1.5rpx solid rgba(180, 150, 120, 0.2);
  transition: all 0.5s ease;
  position: relative;
  box-shadow:
    0 3rpx 16rpx rgba(160, 130, 100, 0.06),
    inset 0 1rpx 0 rgba(255, 248, 240, 0.9);
}

/* 聚焦时 - 雅致铜色边框 + 植物纹饰角 */
.search-bar:focus-within {
  border-color: #c4943a;
  box-shadow:
    0 0 0 4rpx rgba(196, 148, 58, 0.1),
    0 4rpx 28rpx rgba(196, 148, 58, 0.12);
}

/* 搜索框左侧植物装饰 - 卷须线条 */
.search-bar::before {
  content: '';
  position: absolute;
  left: -6rpx;
  top: 50%;
  width: 14rpx;
  height: 32rpx;
  transform: translateY(-50%);
  background:
    radial-gradient(circle at 0 50%, transparent 4rpx, #c4943a 4rpx, #c4943a 5rpx, transparent 5rpx),
    radial-gradient(circle at 100% 50%, transparent 4rpx, #3ca882 4rpx, #3ca882 5rpx, transparent 5rpx);
  opacity: 0;
  transition: opacity 0.5s ease;
}

.search-bar:focus-within::before {
  opacity: 1;
}

/* ===== 分类标签 - 珐琅 pill 形态 ===== */
.tab-bar {
  white-space: nowrap;
  margin-bottom: 44rpx;
  height: 72rpx;
  padding: 0 4rpx;
  position: relative;
}

/* 标签栏底部装饰线 - 新艺术波浪 */
.tab-bar::after {
  content: '';
  position: absolute;
  bottom: -8rpx;
  left: 4rpx;
  right: 4rpx;
  height: 2rpx;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(196, 148, 58, 0.08) 10%,
    rgba(45, 138, 110, 0.12) 30%,
    rgba(196, 148, 58, 0.12) 50%,
    rgba(45, 138, 110, 0.12) 70%,
    rgba(196, 148, 58, 0.08) 90%,
    transparent 100%
  );
  border-radius: 1rpx;
}

.tab-item {
  display: inline-flex;
  align-items: center;
  padding: 14rpx 40rpx;
  margin-right: 14rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: rgba(130, 110, 90, 0.55);
  background: rgba(247, 242, 234, 0.5);
  border: 1rpx solid rgba(180, 155, 130, 0.12);
  transition: all 0.4s ease;
  letter-spacing: 1.5rpx;
  font-weight: 350;
  position: relative;
  overflow: hidden;
}

/* 悬停时 - 铜色微光 */
.tab-item:active {
  background: rgba(196, 148, 58, 0.06);
  color: rgba(180, 130, 70, 0.7);
  border-color: rgba(196, 148, 58, 0.15);
  transform: translateY(-1rpx);
}

/* 活跃标签 - 铜色珐琅 */
.tab-active {
  background: linear-gradient(145deg, #c4943a, #b8862e);
  color: #fefcf7;
  font-weight: 500;
  border-color: transparent;
  box-shadow:
    0 4rpx 18rpx rgba(196, 148, 58, 0.25),
    inset 0 1rpx 0 rgba(255, 248, 235, 0.3);
  letter-spacing: 2rpx;
}

/* 不活跃标签 - 翡翠绿珐琅 */
.tab-inactive {
  background: rgba(45, 138, 110, 0.06);
  color: rgba(45, 138, 110, 0.55);
  border-color: rgba(45, 138, 110, 0.12);
}

/* ===== 卡片网格 - 呼吸感间距 ===== */
.card-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 4rpx;
}

/* ===== 卡片 - 象牙书卷 ===== */
.card-item {
  width: calc(50% - 28rpx);
  background: #fcf9f5;
  border-radius: 20rpx;
  padding: 36rpx 32rpx 42rpx;
  margin-bottom: 40rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(196, 148, 58, 0.12);
  transition: all 0.45s ease;
  position: relative;
  box-shadow:
    0 6rpx 32rpx rgba(160, 130, 100, 0.06),
    0 2rpx 8rpx rgba(160, 130, 100, 0.04);
  overflow: visible;
}

/* 新艺术装饰角 - 左上卷须 */
.card-item::before {
  content: '';
  position: absolute;
  top: -1rpx;
  left: -1rpx;
  width: 48rpx;
  height: 48rpx;
  border-top: 2rpx solid rgba(196, 148, 58, 0.2);
  border-left: 2rpx solid rgba(196, 148, 58, 0.2);
  border-radius: 8rpx 0 0 0;
  pointer-events: none;
  transition: all 0.45s ease;
}

/* 新艺术装饰角 - 右下呼应 */
.card-item::after {
  content: '';
  position: absolute;
  bottom: -1rpx;
  right: -1rpx;
  width: 48rpx;
  height: 48rpx;
  border-bottom: 2rpx solid rgba(45, 138, 110, 0.15);
  border-right: 2rpx solid rgba(45, 138, 110, 0.15);
  border-radius: 0 0 8rpx 0;
  pointer-events: none;
  transition: all 0.45s ease;
}

/* 卡片顶部中央 - 铜色弧线装饰 */
.card-item .card-ornament {
  display: block;
  width: 40rpx;
  height: 3rpx;
  margin: 0 auto 16rpx;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(196, 148, 58, 0.3) 20%,
    rgba(196, 148, 58, 0.5) 50%,
    rgba(196, 148, 58, 0.3) 80%,
    transparent
  );
  border-radius: 2rpx;
}

/* 交互态 - 轻微抬升 + 铜影加深 */
.card-item:active {
  border-color: rgba(196, 148, 58, 0.18);
  transform: translateY(-4rpx);
  box-shadow:
    0 12rpx 40rpx rgba(196, 148, 58, 0.12),
    0 4rpx 12rpx rgba(196, 148, 58, 0.06);
}

.card-item:active::before {
  border-top-color: rgba(196, 148, 58, 0.4);
  border-left-color: rgba(196, 148, 58, 0.4);
  width: 56rpx;
  height: 56rpx;
}

.card-item:active::after {
  border-bottom-color: rgba(45, 138, 110, 0.3);
  border-right-color: rgba(45, 138, 110, 0.3);
  width: 56rpx;
  height: 56rpx;
}

/* 卡片编号 - 铜版印刷体 */
.card-item .text-gold {
  font-size: 22rpx;
  font-weight: 400;
  display: inline-block;
  letter-spacing: 3rpx;
  color: rgba(180, 130, 70, 0.5);
  text-transform: uppercase;
}

/* 卡片标题 - 优雅衬线感 */
.card-item .card-title {
  font-size: 30rpx;
  font-weight: 450;
  color: #3d322a;
  margin-top: 16rpx;
  line-height: 1.35;
  letter-spacing: 1.5rpx;
}

/* 卡片副标题 - 植物标本说明 */
.card-item .card-subtitle {
  font-size: 24rpx;
  color: rgba(130, 110, 90, 0.45);
  margin-top: 12rpx;
  line-height: 1.5;
  letter-spacing: 0.8rpx;
  font-style: italic;
}

/* 卡片底部 - 分隔细线 + 植物叶饰 */
.card-item .card-footer-line {
  display: block;
  width: 60%;
  height: 1rpx;
  margin: 18rpx auto 0;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(196, 148, 58, 0.1) 20%,
    rgba(45, 138, 110, 0.08) 50%,
    rgba(196, 148, 58, 0.1) 80%,
    transparent
  );
}

/* ===== 计数栏 - 植物图鉴页码 ===== */
.count-bar {
  text-align: center;
  padding: 48rpx 0;
  font-size: 24rpx;
  color: rgba(180, 155, 130, 0.3);
  letter-spacing: 3rpx;
  position: relative;
}

/* 两侧植物装饰点 */
.count-bar::before,
.count-bar::after {
  content: '';
  display: inline-block;
  width: 16rpx;
  height: 16rpx;
  border: 1.5rpx solid rgba(45, 138, 110, 0.15);
  border-radius: 50%;
  margin: 0 18rpx;
  vertical-align: middle;
  position: relative;
}

.count-bar::before {
  border-color: rgba(196, 148, 58, 0.2);
}

/* 底部波浪装饰线 */
.count-bar .count-underline {
  display: block;
  width: 80rpx;
  height: 2rpx;
  margin: 12rpx auto 0;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(196, 148, 58, 0.2) 30%,
    rgba(45, 138, 110, 0.15) 70%,
    transparent
  );
  border-radius: 1rpx;
}

/* ===== 加载骨架屏 - 铜版纸质感 ===== */
.skeleton-search {
  height: 76rpx;
  border-radius: 60rpx;
  background: linear-gradient(135deg, #f2ece3, #ece5da);
  margin-bottom: 44rpx;
  animation: art-nouveau-pulse 2s ease-in-out infinite;
  position: relative;
  overflow: hidden;
}

.skeleton-tabs {
  display: flex;
  gap: 14rpx;
  margin-bottom: 44rpx;
}

.skeleton-tab {
  width: 140rpx;
  height: 60rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #f2ece3, #ece5da);
  animation: art-nouveau-pulse 2s ease-in-out infinite;
}

.skeleton-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.skeleton-card {
  width: calc(50% - 28rpx);
  height: 220rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #f2ece3, #ece5da);
  margin-bottom: 40rpx;
  animation: art-nouveau-pulse 2s ease-in-out infinite;
}

/* ===== 错误状态 ===== */
.error-state {
  text-align: center;
  padding: 140rpx 48rpx;
  position: relative;
}

/* 顶部装饰框 */
.error-state::before {
  content: '';
  position: absolute;
  top: 100rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 120rpx;
  height: 2rpx;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(196, 148, 58, 0.2),
    rgba(45, 138, 110, 0.15),
    transparent
  );
}

.error-icon {
  font-size: 96rpx;
  display: block;
  margin-bottom: 28rpx;
  opacity: 0.3;
}

.error-text {
  font-size: 28rpx;
  color: rgba(130, 110, 90, 0.5);
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.error-hint {
  font-size: 24rpx;
  color: rgba(180, 155, 130, 0.3);
  display: block;
  margin-bottom: 60rpx;
  letter-spacing: 1.5rpx;
  font-style: italic;
}

/* ===== 新艺术风格动画 ===== */
@keyframes art-nouveau-pulse {
  0%, 100% {
    opacity: 0.4;
  }
  50% {
    opacity: 0.75;
  }
}

/* ===== 空状态提示 ===== */
.empty-state {
  text-align: center;
  padding: 100rpx 48rpx;
}

.empty-ornament {
  display: block;
  width: 60rpx;
  height: 60rpx;
  margin: 0 auto 24rpx;
  border: 1.5rpx solid rgba(196, 148, 58, 0.15);
  border-radius: 50%;
  position: relative;
}

.empty-ornament::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 20rpx;
  height: 20rpx;
  border: 1rpx solid rgba(45, 138, 110, 0.2);
  border-radius: 50%;
}

.empty-text {
  font-size: 28rpx;
  color: rgba(130, 110, 90, 0.4);
  letter-spacing: 2rpx;
  display: block;
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: rgba(180, 155, 130, 0.3);
  letter-spacing: 1.5rpx;
  font-style: italic;
}
