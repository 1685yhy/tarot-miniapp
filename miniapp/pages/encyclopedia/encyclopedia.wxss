/* ============================================================
   百科 · Star Catalog / Constellation Map
   柔光星辰 — Deep indigo sky, warm golden starlight

   Card grid: 3-column with thumbnails + names
   Search bar: dark indigo bg, golden border, cream text
   Filter pills: dark pills, gold active, lavender inactive
   ============================================================ */

/* ============================================================
   SEARCH BAR — Dark indigo field, golden border
   ============================================================ */
.search-bar {
  display: flex;
  align-items: center;
  background: var(--color-surface);
  border-radius: var(--radius-pill);
  padding: 20rpx var(--spacing-lg);
  margin-bottom: var(--spacing-xl);
  border: 1.5rpx solid rgba(244, 212, 140, 0.15);
  transition: border-color var(--duration-base) var(--ease-soft),
              box-shadow var(--duration-base) var(--ease-soft);
}

.search-bar:focus-within {
  border-color: rgba(244, 212, 140, 0.45);
  box-shadow: 0 0 0 4rpx rgba(244, 212, 140, 0.06),
              0 0 30rpx rgba(244, 212, 140, 0.04);
}

.search-input {
  flex: 1;
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  background: transparent;
}

/* ============================================================
   TAB / FILTER PILLS — Constellation filter row
   ============================================================ */
.filter-bar {
  white-space: nowrap;
  margin-bottom: var(--spacing-xl);
  height: 76rpx;
  padding: 0 2rpx;
}

.filter-item {
  display: inline-flex;
  align-items: center;
  padding: var(--spacing-xs) var(--spacing-lg);
  margin-right: var(--spacing-sm);
  border-radius: var(--radius-pill);
  font-size: var(--font-size-sm);
  color: #F0EDE8;
  background: var(--color-surface);
  border: 1rpx solid rgba(184, 169, 224, 0.12);
  transition: all var(--duration-fast) var(--ease-soft);
  letter-spacing: 1rpx;
}

.filter-item:active {
  transform: translateY(-1rpx);
}

/* Active pill — golden background, dark text */
.filter-active {
  background: var(--color-gold);
  color: var(--color-text-inverse);
  border-color: var(--color-gold);
  font-weight: var(--font-weight-semibold);
  box-shadow: 0 0 20rpx rgba(244, 212, 140, 0.15);
}

/* ============================================================
   CARD GRID — 3-column star catalog
   Each card: thumbnail image top, name below
   ============================================================ */
.card-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-md);
}

.card-item {
  width: calc((100% - 48rpx) / 3);
  background: var(--color-card);
  border: 1rpx solid rgba(244, 212, 140, 0.15);
  border-radius: var(--radius-lg);
  padding: var(--spacing-md) var(--spacing-sm) var(--spacing-lg);
  box-sizing: border-box;
  box-shadow: var(--shadow-card);
  transition: transform var(--duration-fast) var(--ease-soft),
              border-color var(--duration-fast) var(--ease-soft);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.card-item:active {
  transform: scale(0.97);
  border-color: rgba(244, 212, 140, 0.35);
  box-shadow: var(--shadow-elevated);
}

/* ---- Card Thumbnail Image ---- */

.card-thumb {
  width: 160rpx;
  height: 224rpx;
  border-radius: var(--radius-md);
  border: 1.5rpx solid rgba(244, 212, 140, 0.18);
  flex-shrink: 0;
  margin-bottom: var(--spacing-sm);
  background: var(--color-surface);
}

.card-thumb-placeholder {
  width: 160rpx;
  height: 224rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid rgba(244, 212, 140, 0.08);
  flex-shrink: 0;
  margin-bottom: var(--spacing-sm);
  background: linear-gradient(
    145deg,
    var(--color-surface) 0%,
    var(--color-card-hover) 100%
  );
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-thumb-placeholder::after {
  content: '🃏';
  font-size: 48rpx;
  opacity: 0.30;
}

/* ---- Card Number — subtle golden label ---- */

.card-number {
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-medium);
  letter-spacing: 3rpx;
  color: var(--color-gold);
  opacity: 0.90;
  margin-bottom: var(--spacing-xxs);
}

/* ---- Card Name ---- */

.card-name {
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  line-height: var(--line-height-tight);
  letter-spacing: 1rpx;
  margin-bottom: var(--spacing-xxs);
  text-overflow: ellipsis;
  overflow: hidden;
  white-space: nowrap;
  max-width: 100%;
}

.card-name-en {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  margin-bottom: var(--spacing-sm);
  line-height: 1.2;
  text-overflow: ellipsis;
  overflow: hidden;
  white-space: nowrap;
  max-width: 100%;
}

/* ---- Badges inside card ---- */

.card-badges {
  display: flex;
  justify-content: center;
  gap: var(--spacing-xs);
  flex-wrap: wrap;
  width: 100%;
}

.badge-purple {
  background: var(--color-lavender-glow);
  color: var(--color-lavender);
  border-color: rgba(184, 169, 224, 0.18);
}

.badge-gold {
  background: var(--color-gold-glow);
  color: var(--color-gold);
  border-color: rgba(184, 169, 224, 0.18);
}

/* ============================================================
   COUNT BAR — Stars counted
   ============================================================ */
.count-bar {
  text-align: center;
  padding: var(--spacing-xl) 0 var(--spacing-3xl);
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
  letter-spacing: 3rpx;
}

/* ============================================================
   ERROR STATE
   ============================================================ */
.error-state {
  text-align: center;
  padding: var(--spacing-4xl) var(--spacing-xl);
}

.error-icon {
  font-size: 72rpx;
  display: block;
  margin-bottom: var(--spacing-md);
  opacity: 0.50;
}

.error-text {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--spacing-xs);
}

.error-hint {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
  display: block;
  margin-bottom: var(--spacing-xl);
}

/* ============================================================
   EMPTY STATE — No matching stars
   ============================================================ */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-4xl) var(--spacing-lg);
  text-align: center;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: var(--spacing-md);
  opacity: 0.35;
}

.empty-text {
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-secondary);
  margin-bottom: var(--spacing-xs);
}

.empty-hint {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
}

/* ============================================================
   SKELETON LOADING
   ============================================================ */
.skeleton-search {
  height: 76rpx;
  border-radius: var(--radius-pill);
  background: linear-gradient(90deg, var(--color-surface) 25%, var(--color-surface-hover) 50%, var(--color-surface) 75%);
  background-size: 400% 100%;
  animation: skeleton-shimmer 1.8s ease-in-out infinite;
  margin-bottom: var(--spacing-xl);
}

.skeleton-tabs {
  display: flex;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-xl);
}

.skeleton-tab {
  width: 140rpx;
  height: 60rpx;
  border-radius: var(--radius-pill);
  background: linear-gradient(90deg, var(--color-surface) 25%, var(--color-surface-hover) 50%, var(--color-surface) 75%);
  background-size: 400% 100%;
  animation: skeleton-shimmer 1.8s ease-in-out infinite;
}

.skeleton-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-md);
}

.skeleton-card {
  width: calc((100% - 48rpx) / 3);
  height: 340rpx;
  border-radius: var(--radius-lg);
  background: linear-gradient(90deg, var(--color-surface) 25%, var(--color-surface-hover) 50%, var(--color-surface) 75%);
  background-size: 400% 100%;
  animation: skeleton-shimmer 1.8s ease-in-out infinite;
}

@keyframes skeleton-shimmer {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}

/* ============================================================
   SMALL BUTTON (for error retry)
   ============================================================ */
.btn-small {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  border-radius: var(--radius-pill);
  padding: var(--spacing-xs) var(--spacing-lg);
  margin-top: var(--spacing-sm);
}

/* ============================================================
   UTILITY OVERRIDES for stagger animation delay
   ============================================================ */
.anim-fade-in-up-1 { animation: fade-up var(--duration-slow) var(--ease-soft) forwards; animation-delay: 0.05s; }
.anim-fade-in-up-2 { animation: fade-up var(--duration-slow) var(--ease-soft) forwards; animation-delay: 0.12s; }
.anim-fade-in-up-3 { animation: fade-up var(--duration-slow) var(--ease-soft) forwards; animation-delay: 0.20s; }

@keyframes fade-up {
  0% { opacity: 0; transform: translateY(24rpx); }
  100% { opacity: 1; transform: translateY(0); }
}
