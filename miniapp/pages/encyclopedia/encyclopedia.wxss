/* ===== 百科 - Editorial Minimal =====
 * Clean, editorial typography on warm beige.
 * Uses var() tokens from common.wxss design system.
 * No decorative CSS, no gradients, no glows, no complex borders.
 * ================================================== */

/* ===== Back-compat variable aliases for WXML inline styles ===== */
page {
  --space-sm: var(--sp-sm);
  --space-xs: var(--sp-xs);
  --fs-body: var(--fs-base);
  --fs-caption: var(--fs-xs);
  --color-text-primary: var(--color-text);
  --color-star-subtle: var(--color-tag-warm);
}

/* ===== Search Bar ===== */
.search-bar {
  display: flex;
  align-items: center;
  background: var(--color-surface);
  border-radius: var(--radius-full);
  padding: 18rpx var(--sp-2xl);
  margin-bottom: var(--sp-2xl);
  border: 1.5rpx solid var(--color-border);
  transition: border-color var(--dur-normal) var(--ease-out),
              box-shadow var(--dur-normal) var(--ease-out);
}
.search-bar:focus-within {
  border-color: var(--color-accent-light);
  box-shadow: 0 0 0 4rpx rgba(139,111,92,0.08);
}

/* ===== Tab Bar (Pill Filters) ===== */
.tab-bar {
  white-space: nowrap;
  margin-bottom: var(--sp-2xl);
  height: 72rpx;
  padding: 0 2rpx;
}

.tab-item {
  display: inline-flex;
  align-items: center;
  padding: var(--sp-sm) var(--sp-xl);
  margin-right: var(--sp-sm);
  border-radius: var(--radius-full);
  font-size: var(--fs-sm);
  color: var(--color-text-secondary);
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  transition: all var(--dur-fast) var(--ease-out);
}
.tab-item:active {
  transform: translateY(-1rpx);
}

.tab-active {
  background: var(--color-text);
  color: var(--color-text-inverse);
  border-color: var(--color-text);
  font-weight: var(--fw-medium);
}

/* ===== Card Grid (3 columns) ===== */
.card-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-md);
}

/* ===== Card Item ===== */
.card-item {
  width: calc((100% - 32rpx) / 3);
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: var(--sp-lg) var(--sp-md) var(--sp-xl);
  box-sizing: border-box;
  box-shadow: var(--shadow-sm);
  transition: transform var(--dur-fast) var(--ease-out),
              box-shadow var(--dur-fast) var(--ease-out);
}
.card-item:active {
  transform: scale(0.97);
  box-shadow: var(--shadow-md);
}

/* ===== Card Typography (backstops for inline styles) ===== */
.text-gold {
  color: var(--color-accent);
}
.card-item .text-gold {
  font-size: var(--fs-xs);
  font-weight: var(--fw-medium);
  display: inline-block;
  letter-spacing: 2rpx;
  color: var(--color-accent-light);
}

.heading-4 {
  font-size: var(--fs-md);
  font-weight: var(--fw-medium);
  color: var(--color-text);
  line-height: var(--lh-tight);
}

.text-dim {
  font-size: var(--fs-sm);
  color: var(--color-text-tertiary);
}

/* ===== Badges ===== */
.badge-purple {
  background: var(--color-tag-warm);
  color: var(--color-accent);
}

/* ===== Count Bar ===== */
.count-bar {
  text-align: center;
  padding: var(--sp-2xl) 0 var(--sp-3xl);
  font-size: var(--fs-sm);
  color: var(--color-text-tertiary);
  letter-spacing: 2rpx;
}

/* ===== Skeleton Loading ===== */
.skeleton-search {
  height: 72rpx;
  border-radius: var(--radius-full);
  background: linear-gradient(90deg, var(--color-bg-warm) 25%, var(--color-border) 50%, var(--color-bg-warm) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
  margin-bottom: var(--sp-2xl);
}

.skeleton-tabs {
  display: flex;
  gap: var(--sp-sm);
  margin-bottom: var(--sp-2xl);
}

.skeleton-tab {
  width: 130rpx;
  height: 56rpx;
  border-radius: var(--radius-full);
  background: linear-gradient(90deg, var(--color-bg-warm) 25%, var(--color-border) 50%, var(--color-bg-warm) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
}

.skeleton-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-md);
}

.skeleton-card {
  width: calc((100% - 32rpx) / 3);
  height: 220rpx;
  border-radius: var(--radius-lg);
  background: linear-gradient(90deg, var(--color-bg-warm) 25%, var(--color-border) 50%, var(--color-bg-warm) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
}

/* ===== Small Button (for error retry) ===== */
.btn-small {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-sm);
  font-weight: var(--fw-medium);
  border-radius: var(--radius-full);
  padding: var(--sp-xs) var(--sp-lg);
  margin-top: var(--sp-sm);
}
