/* ============================================================
   百科 · Star Catalog / Constellation Map
   柔光星辰 — Deep indigo sky, warm golden starlight

   Card grid: 2-column with larger thumbnails + golden names
   Search bar: dark indigo bg, golden border, cream text
   Filter pills: dark pills, gold active with dark text, lavender inactive
   ============================================================ */

/* ============================================================
   今日之牌 — Personal daily card highlight
   Gold-bordered hero card at the top of the encyclopedia
   ============================================================ */
.daily-card {
  display: flex;
  flex-direction: column;
  background: linear-gradient(135deg, rgba(244, 212, 140, 0.10) 0%, rgba(244, 212, 140, 0.03) 100%);
  border: 2rpx solid var(--color-gold);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg) var(--spacing-xl);
  margin-bottom: var(--spacing-xl);
  box-shadow: 0 0 30rpx rgba(244, 212, 140, 0.10);
  transition: all var(--duration-fast) var(--ease-out);
}
.daily-card:active {
  transform: scale(0.98);
  box-shadow: 0 0 40rpx rgba(244, 212, 140, 0.18);
}
.daily-card-label {
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-semibold);
  letter-spacing: 4rpx;
  color: var(--color-gold);
  margin-bottom: var(--spacing-sm);
  text-transform: uppercase;
}
.daily-card-body {
  display: flex;
  align-items: center;
  gap: var(--spacing-lg);
}
.daily-card-thumb {
  width: 100rpx;
  height: 140rpx;
  border-radius: var(--radius-sm);
  border: 1.5rpx solid rgba(244, 212, 140, 0.25);
  flex-shrink: 0;
  background: var(--color-surface);
}
.daily-card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--spacing-xxs);
}
.daily-card-name {
  font-size: var(--font-size-subhead);
  font-weight: var(--font-weight-semibold);
  color: var(--color-gold);
  line-height: var(--line-height-tight);
  letter-spacing: 1rpx;
}
.daily-card-name-en {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  line-height: 1.2;
}
.daily-card-cta {
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-medium);
  color: var(--color-lavender);
  margin-top: var(--spacing-xxs);
}

/* ---- Prompt when no daily card drawn ---- */
.daily-card-prompt {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-sm);
  padding: var(--spacing-lg) var(--spacing-xl);
  margin-bottom: var(--spacing-xl);
  border-radius: var(--radius-lg);
  background: var(--color-surface);
  border: 1.5rpx dashed rgba(184, 169, 224, 0.20);
  transition: all var(--duration-fast) var(--ease-out);
}
.daily-card-prompt:active {
  background: var(--color-surface-hover);
  transform: scale(0.98);
}
.daily-card-prompt-icon {
  font-size: var(--font-size-subhead);
  opacity: 0.60;
}
.daily-card-prompt-text {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  letter-spacing: 1rpx;
}

/* ============================================================
   SEARCH BAR — Dark indigo field, golden border
   ============================================================ */
.search-bar {
  display: flex;
  align-items: center;
  background: var(--color-surface);
  border-radius: var(--radius-pill);
  padding: 20rpx var(--spacing-lg);
  margin-bottom: var(--spacing-xl);
  border: 1.5rpx solid rgba(244, 212, 140, 0.15);
  transition: border-color var(--duration-base) var(--ease-soft),
              box-shadow var(--duration-base) var(--ease-soft);
}

.search-bar:focus-within {
  border-color: rgba(244, 212, 140, 0.45);
  box-shadow: 0 0 0 4rpx rgba(244, 212, 140, 0.06),
              0 0 30rpx rgba(244, 212, 140, 0.04);
}

.search-input {
  flex: 1;
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  background: transparent;
}

/* ============================================================
   TAB / FILTER PILLS — Constellation filter row
   ============================================================ */
.filter-bar {
  white-space: nowrap;
  margin-bottom: var(--spacing-2xl);
  height: 76rpx;
  padding: 0 2rpx;
}

.filter-item {
  display: inline-flex;
  align-items: center;
  padding: var(--spacing-xs) var(--spacing-lg);
  margin-right: var(--spacing-sm);
  border-radius: var(--radius-pill);
  font-size: var(--font-size-caption);
  color: var(--color-text-primary);
  background: var(--color-surface);
  border: 1rpx solid rgba(184, 169, 224, 0.12);
  transition: all var(--duration-fast) var(--ease-soft);
  letter-spacing: 1rpx;
}

.filter-item:active {
  transform: translateY(-1rpx);
}

/* Active pill — golden background, dark text */
.filter-active {
  background: var(--color-gold);
  color: var(--color-text-inverse);
  border-color: var(--color-gold);
  font-weight: var(--font-weight-semibold);
  box-shadow: 0 0 20rpx rgba(244, 212, 140, 0.15);
}

/* ============================================================
   CARD GRID — 2-column star catalog
   Each card: larger thumbnail top, golden name below, badges for arcana/element
   ============================================================ */
.card-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 28rpx;
}

.card-item {
  width: calc((100% - 28rpx) / 2);
  background: var(--color-surface-gradient);
  border: 1.5rpx solid rgba(244, 212, 140, 0.12);
  border-radius: var(--radius-md);
  padding: var(--spacing-lg) var(--spacing-lg) var(--spacing-xl);
  box-sizing: border-box;
  box-shadow: var(--shadow-card);
  transition: all var(--duration-fast) var(--ease-out);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.card-item:active {
  transform: scale(0.97);
  border-color: rgba(244, 212, 140, 0.20);
  box-shadow: var(--shadow-card-press);
}

/* ---- Card Thumbnail Image ---- */

.card-thumb {
  width: 200rpx;
  height: 280rpx;
  border-radius: var(--radius-md);
  border: 1.5rpx solid rgba(244, 212, 140, 0.18);
  flex-shrink: 0;
  margin-bottom: var(--spacing-sm);
  background: var(--color-surface);
}

.card-thumb-placeholder {
  width: 200rpx;
  height: 280rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid rgba(244, 212, 140, 0.08);
  flex-shrink: 0;
  margin-bottom: var(--spacing-sm);
  background: linear-gradient(
    145deg,
    var(--color-surface) 0%,
    var(--color-card-hover) 100%
  );
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-thumb-placeholder::after {
  content: '🃏';
  font-size: var(--font-size-title);
  opacity: 0.30;
}

/* ---- Card Number — subtle golden label ---- */

.card-number {
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-medium);
  letter-spacing: 3rpx;
  color: var(--color-gold);
  opacity: 0.90;
  margin-bottom: var(--spacing-xxs);
}

/* ---- Card Name ---- */

.card-name {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-semibold);
  color: var(--color-gold);
  line-height: var(--line-height-tight);
  letter-spacing: 1rpx;
  margin-bottom: var(--spacing-xxs);
  text-overflow: ellipsis;
  overflow: hidden;
  white-space: nowrap;
  max-width: 100%;
}

.card-name-en {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  margin-bottom: var(--spacing-sm);
  line-height: 1.2;
  text-overflow: ellipsis;
  overflow: hidden;
  white-space: nowrap;
  max-width: 100%;
}

/* ---- Badges inside card ---- */

.card-badges {
  display: flex;
  justify-content: center;
  gap: var(--spacing-xs);
  flex-wrap: wrap;
  width: 100%;
}

.badge-purple {
  background: var(--color-lavender-glow);
  color: var(--color-lavender);
  border-color: rgba(184, 169, 224, 0.18);
}

.badge-gold {
  background: var(--color-gold-glow);
  color: var(--color-gold);
  border-color: rgba(184, 169, 224, 0.18);
}

/* ============================================================
   COUNT BAR — Stars counted
   ============================================================ */
.count-bar {
  text-align: center;
  padding: var(--spacing-xl) 0 var(--spacing-3xl);
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  letter-spacing: 3rpx;
}

/* ============================================================
   ERROR STATE
   ============================================================ */
.error-state {
  text-align: center;
  padding: var(--spacing-4xl) var(--spacing-xl);
}

.error-icon {
  font-size: calc(var(--font-size-display) + 16rpx);
  display: block;
  margin-bottom: var(--spacing-md);
  opacity: 0.50;
}

.error-text {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--spacing-xs);
}

.error-hint {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  display: block;
  margin-bottom: var(--spacing-xl);
}

/* ============================================================
   EMPTY STATE — No matching stars
   ============================================================ */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-4xl) var(--spacing-lg);
  text-align: center;
}

.empty-icon {
  font-size: calc(var(--font-size-display) + 16rpx);
  margin-bottom: var(--spacing-md);
  opacity: 0.35;
}

.empty-text {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-secondary);
  margin-bottom: var(--spacing-xs);
}

.empty-hint {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
}

/* ============================================================
   SKELETON LOADING — Shapes only (shimmer from common.wxss)
   ============================================================ */
.skeleton-search {
  height: 76rpx;
  border-radius: var(--radius-pill);
  background-image: linear-gradient(90deg, var(--color-surface) 25%, var(--color-surface-hover) 50%, var(--color-surface) 75%);
  margin-bottom: var(--spacing-xl);
}

.skeleton-tabs {
  display: flex;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-xl);
}

.skeleton-tab {
  width: 140rpx;
  height: 60rpx;
  border-radius: var(--radius-pill);
  background-image: linear-gradient(90deg, var(--color-surface) 25%, var(--color-surface-hover) 50%, var(--color-surface) 75%);
}

.skeleton-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-md);
}

.skeleton-card {
  width: calc((100% - 24rpx) / 2);
  height: 400rpx;
  border-radius: var(--radius-lg);
  background-image: linear-gradient(90deg, var(--color-surface) 25%, var(--color-surface-hover) 50%, var(--color-surface) 75%);
}

/* ============================================================
   SMALL BUTTON (for error retry)
   ============================================================ */
.btn-small {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-medium);
  border-radius: var(--radius-pill);
  padding: var(--spacing-xs) var(--spacing-lg);
  margin-top: var(--spacing-sm);
}

/* ============================================================
   UTILITY OVERRIDES for stagger animation delay
   ============================================================ */
.anim-fade-in-up-1 { animation: fade-up var(--duration-slow) var(--ease-soft) forwards; animation-delay: 0.05s; }
.anim-fade-in-up-2 { animation: fade-up var(--duration-slow) var(--ease-soft) forwards; animation-delay: 0.12s; }
.anim-fade-in-up-3 { animation: fade-up var(--duration-slow) var(--ease-soft) forwards; animation-delay: 0.20s; }
