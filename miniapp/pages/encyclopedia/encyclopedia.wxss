/* pages/encyclopedia/encyclopedia.wxss */
.container {
  padding: 16rpx 24rpx;
  background: var(--color-bg);
  min-height: 100vh;
}

/* Search */
.search-bar {
  display: flex;
  align-items: center;
  background: var(--color-bg-card);
  border-radius: 40rpx;
  padding: 16rpx 28rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(201, 169, 110, 0.2);
}
.search-icon { font-size: 28rpx; margin-right: 12rpx; }
.search-input { flex: 1; font-size: 28rpx; color: var(--color-text-primary); }

/* Tabs */
.tab-bar {
  white-space: nowrap;
  margin-bottom: 24rpx;
  height: 64rpx;
}
.tab-item {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 28rpx;
  margin-right: 12rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  background: var(--color-bg-card);
  transition: all 0.2s;
}
.tab-active {
  background: linear-gradient(135deg, var(--color-gold), var(--color-gold-light));
  color: #1a1a2e;
  font-weight: 600;
}

/* Card grid */
.card-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.card-item {
  width: calc(50% - 10rpx);
  background: var(--color-bg-card);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(201, 169, 110, 0.1);
  transition: all 0.2s;
}
.card-item:active {
  border-color: var(--color-gold);
  transform: scale(0.97);
}
.card-number {
  font-size: 22rpx;
  color: var(--color-gold);
  margin-bottom: 8rpx;
}
.card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: 4rpx;
}
.card-en {
  font-size: 20rpx;
  color: var(--color-text-dim);
  display: block;
  margin-bottom: 12rpx;
}
.card-tags { display: flex; flex-wrap: wrap; gap: 8rpx; }
.tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.arcana-tag { background: rgba(123, 104, 238, 0.2); color: var(--color-purple); }
.suit-tag { background: rgba(201, 169, 110, 0.15); color: var(--color-gold); }
.element-tag { background: rgba(136, 136, 170, 0.15); color: var(--color-text-secondary); }

/* Empty & Loading */
.empty, .loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.empty-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.empty-text, .loading-text { font-size: 28rpx; color: var(--color-text-secondary); }

/* Count bar */
.count-bar {
  text-align: center;
  padding: 24rpx 0;
  font-size: 24rpx;
  color: var(--color-text-dim);
}
