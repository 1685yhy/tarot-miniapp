/* ===== 百科 - "花语画廊" 柔美 boutique 主题 ===== *
 * 灵感：精致画廊、法式花店、晨光柔和、轻奢质感  *
 * 像翻阅一本装帧精美的塔罗图鉴               *
 * =========================================== */

/* ===== 搜索栏 ===== */
.search-bar {
  display: flex;
  align-items: center;
  background: #fefcf9;
  border-radius: 60rpx;
  padding: 18rpx 40rpx;
  margin-bottom: 40rpx;
  border: 1.5rpx solid rgba(200, 160, 160, 0.25);
  transition: all 0.4s ease;
  position: relative;
  box-shadow:
    0 2rpx 12rpx rgba(180, 140, 140, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
}

.search-bar:focus-within {
  border-color: rgba(210, 150, 160, 0.5);
  box-shadow:
    0 0 0 4rpx rgba(210, 150, 160, 0.08),
    0 2rpx 20rpx rgba(210, 150, 160, 0.12);
}

/* ===== 分类标签栏 ===== */
.tab-bar {
  white-space: nowrap;
  margin-bottom: 40rpx;
  height: 66rpx;
  padding: 0 2rpx;
}

.tab-item {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 36rpx;
  margin-right: 12rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: rgba(140, 120, 120, 0.6);
  background: #fcf8f5;
  border: 1rpx solid rgba(200, 175, 175, 0.15);
  transition: all 0.35s ease;
  letter-spacing: 1rpx;
}

.tab-item:active {
  background: #f9f0ed;
  color: rgba(180, 130, 140, 0.8);
  transform: translateY(-1rpx);
}

.tab-active {
  background: #fff5f2;
  color: #b5807a;
  font-weight: 500;
  border-color: rgba(200, 150, 150, 0.3);
  box-shadow:
    0 2rpx 12rpx rgba(180, 130, 140, 0.10),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.7);
}

/* ===== 卡片网格 ===== */
.card-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 2rpx;
}

/* ===== 单张卡片 ===== */
.card-item {
  width: calc(50% - 20rpx);
  background: #ffffff;
  border-radius: 32rpx;
  padding: 32rpx 30rpx 38rpx;
  margin-bottom: 32rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(210, 185, 185, 0.18);
  transition: all 0.4s ease;
  position: relative;
  box-shadow:
    0 4rpx 24rpx rgba(160, 130, 130, 0.07),
    0 1rpx 4rpx rgba(160, 130, 130, 0.04);
}

/* 顶部细玫瑰线 */
.card-item::after {
  content: '';
  position: absolute;
  top: 0;
  left: 20%;
  width: 60%;
  height: 2rpx;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(200, 160, 160, 0.25) 20%,
    rgba(210, 165, 165, 0.40) 50%,
    rgba(200, 160, 160, 0.25) 80%,
    transparent
  );
  border-radius: 1rpx;
  pointer-events: none;
}

.card-item:active {
  border-color: rgba(210, 160, 165, 0.25);
  transform: scale(0.97);
  box-shadow:
    0 2rpx 12rpx rgba(210, 160, 165, 0.08);
}

/* 卡片编号 */
.card-item .text-gold {
  font-size: 22rpx;
  font-weight: 500;
  display: inline-block;
  letter-spacing: 2rpx;
  color: rgba(180, 140, 145, 0.55);
}

/* 卡片标题 */
.card-item .card-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #4a3a3a;
  margin-top: 14rpx;
  line-height: 1.35;
  letter-spacing: 1rpx;
}

/* 卡片描述 */
.card-item .card-subtitle {
  font-size: 24rpx;
  color: rgba(140, 120, 120, 0.55);
  margin-top: 10rpx;
  line-height: 1.45;
  letter-spacing: 0.5rpx;
}

/* ===== 计数栏 ===== */
.count-bar {
  text-align: center;
  padding: 40rpx 0;
  font-size: 24rpx;
  color: rgba(180, 155, 155, 0.35);
  letter-spacing: 2rpx;
  position: relative;
}

.count-bar::before,
.count-bar::after {
  content: '·';
  display: inline-block;
  margin: 0 14rpx;
  font-size: 18rpx;
  color: rgba(200, 170, 170, 0.2);
  vertical-align: middle;
}

/* ===== 加载骨架屏 ===== */
.skeleton-search {
  height: 72rpx;
  border-radius: 60rpx;
  background: linear-gradient(135deg, #f8f2ee, #f5ede8);
  margin-bottom: 40rpx;
  animation: pulse-soft 1.6s ease-in-out infinite;
}

.skeleton-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 40rpx;
}

.skeleton-tab {
  width: 130rpx;
  height: 56rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #f8f2ee, #f5ede8);
  animation: pulse-soft 1.6s ease-in-out infinite;
}

.skeleton-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.skeleton-card {
  width: calc(50% - 20rpx);
  height: 200rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #f8f2ee, #f5ede8);
  margin-bottom: 32rpx;
  animation: pulse-soft 1.6s ease-in-out infinite;
}

/* ===== 错误状态 ===== */
.error-state {
  text-align: center;
  padding: 120rpx 40rpx;
}

.error-icon {
  font-size: 88rpx;
  display: block;
  margin-bottom: 24rpx;
  opacity: 0.35;
}

.error-text {
  font-size: 28rpx;
  color: rgba(140, 120, 120, 0.55);
  display: block;
  margin-bottom: 10rpx;
  letter-spacing: 1rpx;
}

.error-hint {
  font-size: 24rpx;
  color: rgba(180, 155, 155, 0.35);
  display: block;
  margin-bottom: 60rpx;
  letter-spacing: 1rpx;
}

/* ===== 骨架动画 ===== */
@keyframes pulse-soft {
  0%, 100% {
    opacity: 0.5;
  }
  50% {
    opacity: 0.8;
  }
}
