/* ============================================================
   百科 — Warm Paper Design System
   Card grid with thumbnails, search bar, filter pills
   Warm ivory base, deep rose accent, sage subtle
   ============================================================ */

/* -----------------------------------------------------------
   1. SEARCH BAR
   ----------------------------------------------------------- */

.search-bar {
  display: flex;
  align-items: center;
  background: var(--color-surface);
  border: 1rpx solid rgba(139, 126, 110, 0.20);
  border-radius: var(--radius-pill);
  padding: 0 var(--spacing-5);
  height: 80rpx;
  margin-bottom: var(--spacing-6);
  transition: border-color var(--duration-feedback) ease, box-shadow var(--duration-feedback) ease;
}

.search-bar:focus-within {
  border-color: var(--color-accent);
  box-shadow: 0 0 0 2rpx rgba(176, 102, 80, 0.10);
}

.search-input {
  flex: 1;
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  background: transparent;
  height: 100%;
  line-height: 80rpx;
}

.search-input::placeholder {
  color: var(--color-text-secondary);
  opacity: 0.50;
}

/* -----------------------------------------------------------
   2. FILTER PILLS
   ----------------------------------------------------------- */

.filter-bar {
  white-space: nowrap;
  margin-bottom: var(--spacing-6);
  height: 72rpx;
  padding: 0 2rpx;
}

.filter-item {
  display: inline-flex;
  align-items: center;
  padding: var(--spacing-3) var(--spacing-5);
  margin-right: var(--spacing-3);
  border-radius: var(--radius-pill);
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  background: var(--color-surface);
  border: 1rpx solid rgba(139, 126, 110, 0.12);
  transition: all var(--duration-feedback) ease;
  letter-spacing: var(--letter-spacing-none);
}

.filter-item:active {
  border-color: var(--color-accent);
  color: var(--color-accent);
}

.filter-active {
  background: rgba(176, 102, 80, 0.08);
  color: var(--color-accent);
  border-color: var(--color-accent);
  font-weight: var(--font-weight-medium);
}

/* -----------------------------------------------------------
   3. CARD GRID — 3-column
   ----------------------------------------------------------- */

.card-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-4);
}

.card-item {
  width: calc((100% - 32rpx) / 3);
  background: var(--color-surface);
  border: 1rpx solid rgba(139, 126, 110, 0.12);
  border-radius: var(--radius-medium);
  padding: var(--spacing-4) var(--spacing-3) var(--spacing-5);
  box-sizing: border-box;
  box-shadow: var(--shadow-subtle);
  transition: all var(--duration-navigation) ease;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.card-item:active {
  border-color: rgba(176, 102, 80, 0.20);
  box-shadow: var(--shadow-medium);
  transform: translateY(-2rpx);
}

.card-thumb {
  width: 140rpx;
  height: 196rpx;
  border-radius: var(--radius-small);
  border: 1rpx solid rgba(139, 126, 110, 0.12);
  flex-shrink: 0;
  margin-bottom: var(--spacing-4);
  background: rgba(139, 126, 110, 0.06);
}

.card-thumb-placeholder {
  width: 140rpx;
  height: 196rpx;
  border-radius: var(--radius-small);
  border: 1rpx solid rgba(139, 126, 110, 0.08);
  flex-shrink: 0;
  margin-bottom: var(--spacing-4);
  background: rgba(139, 126, 110, 0.04);
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-thumb-placeholder::after {
  content: '';
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid rgba(139, 126, 110, 0.15);
  border-radius: var(--radius-small);
  opacity: 0.25;
}

.card-number {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-medium);
  letter-spacing: var(--letter-spacing-display);
  color: var(--color-accent);
  opacity: 0.70;
  margin-bottom: var(--spacing-2);
  display: block;
}

.card-name {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  line-height: var(--line-height-heading);
  margin-bottom: var(--spacing-2);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  max-width: 100%;
  display: block;
}

.card-name-en {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  margin-bottom: var(--spacing-3);
  line-height: 1.2;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  max-width: 100%;
  display: block;
}

.card-badges {
  display: flex;
  justify-content: center;
  gap: var(--spacing-3);
  flex-wrap: wrap;
  width: 100%;
}

/* -----------------------------------------------------------
   4. COUNT BAR
   ----------------------------------------------------------- */

.count-bar {
  text-align: center;
  padding: var(--spacing-6) 0 var(--spacing-7);
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  letter-spacing: var(--letter-spacing-display);
}

/* -----------------------------------------------------------
   5. ERROR STATE
   ----------------------------------------------------------- */

.error-state {
  text-align: center;
  padding: var(--spacing-8) var(--spacing-6);
}

.error-icon {
  width: 72rpx;
  height: 72rpx;
  display: block;
  margin: 0 auto var(--spacing-5);
  opacity: 0.30;
}

.error-text {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--spacing-3);
}

.error-hint {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--spacing-6);
  opacity: 0.70;
}

/* -----------------------------------------------------------
   6. EMPTY STATE
   ----------------------------------------------------------- */

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-8) var(--spacing-5);
  text-align: center;
}

.empty-icon {
  width: 72rpx;
  height: 72rpx;
  margin-bottom: var(--spacing-5);
  opacity: 0.25;
}

.empty-text {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  margin-bottom: var(--spacing-3);
}

.empty-hint {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  opacity: 0.70;
}

/* -----------------------------------------------------------
   7. SKELETON LOADING
   ----------------------------------------------------------- */

.skeleton-search {
  height: 80rpx;
  border-radius: var(--radius-pill);
  background: rgba(139, 126, 110, 0.08);
  animation: pulse-soft 1500ms ease-in-out infinite;
  margin-bottom: var(--spacing-6);
}

.skeleton-tabs {
  display: flex;
  gap: var(--spacing-3);
  margin-bottom: var(--spacing-6);
}

.skeleton-tab {
  width: 140rpx;
  height: 60rpx;
  border-radius: var(--radius-pill);
  background: rgba(139, 126, 110, 0.08);
  animation: pulse-soft 1500ms ease-in-out infinite;
}

.skeleton-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-4);
}

.skeleton-card {
  width: calc((100% - 32rpx) / 3);
  height: 320rpx;
  border-radius: var(--radius-medium);
  background: rgba(139, 126, 110, 0.08);
  animation: pulse-soft 1500ms ease-in-out infinite;
}

/* -----------------------------------------------------------
   8. ENTRANCE ANIMATIONS
   ----------------------------------------------------------- */

.anim-fade-in-up-1 { opacity: 0; animation: fade-up var(--duration-emphasis) ease 0.05s forwards; }
.anim-fade-in-up-2 { opacity: 0; animation: fade-up var(--duration-emphasis) ease 0.12s forwards; }
.anim-fade-in-up-3 { opacity: 0; animation: fade-up var(--duration-emphasis) ease 0.20s forwards; }

/* -----------------------------------------------------------
   9. MISC HELPERS
   ----------------------------------------------------------- */

.btn-small {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-medium);
  border-radius: var(--radius-pill);
  padding: var(--spacing-3) var(--spacing-5);
  margin-top: var(--spacing-3);
}
