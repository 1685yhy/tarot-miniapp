<!-- pages/encyclopedia/encyclopedia.wxml -->
<view class="page">
  <!-- ===== 加载骨架 ===== -->
  <view wx:if="{{pageLoading}}">
    <view class="skeleton skeleton-search"></view>
    <view class="skeleton-tabs">
      <view class="skeleton skeleton-tab"></view>
      <view class="skeleton skeleton-tab"></view>
      <view class="skeleton skeleton-tab"></view>
      <view class="skeleton skeleton-tab"></view>
    </view>
    <view class="skeleton-grid">
      <view class="skeleton skeleton-card"></view>
      <view class="skeleton skeleton-card"></view>
      <view class="skeleton skeleton-card"></view>
      <view class="skeleton skeleton-card"></view>
      <view class="skeleton skeleton-card"></view>
      <view class="skeleton skeleton-card"></view>
    </view>
  </view>

  <!-- ===== 错误状态 ===== -->
  <view wx:elif="{{pageError}}" class="error-state">
    <text class="error-text">卡牌档案馆暂时打不开</text>
    <text class="error-hint">{{pageError}}</text>
    <button class="btn-primary btn-small" bindtap="onRetry">重新加载</button>
  </view>

  <!-- ===== 主内容 ===== -->
  <view wx:else>
    <!-- ===== 今日之牌 — Personal entry point ===== -->
    <view wx:if="{{dailyCard}}" class="daily-card anim-fade-up anim-stagger-1" bindtap="onDailyCardTap" role="button" aria-label="查看今日之牌详情">
      <view class="daily-card-label">今日之牌</view>
      <view class="daily-card-body">
        <view class="card-img-wrap daily-card-thumb {{dailyCardImgLoaded ? 'card-img-wrap--loaded' : ''}} {{dailyCardImgError ? 'card-img-wrap--error' : ''}}">
          <image class="card-img-inner" src="{{dailyCard.imagePath}}" mode="aspectFill" lazy-load bindload="onDailyCardImgLoad" binderror="onDailyCardImgError" wx:if="{{dailyCard.imagePath && !dailyCardImgError}}" aria-label="{{dailyCard.name_zh}}，今日之牌" />
          <view class="card-img-fallback">
            <image class="card-img-fallback-icon" src="/images/icons/card_back_64.png" mode="aspectFit" aria-label="卡牌背面" />
          </view>
        </view>
        <view class="daily-card-info">
          <text class="daily-card-name">{{dailyCard.name_zh}}</text>
          <text class="daily-card-name-en">{{dailyCard.name_en}}</text>
          <text class="daily-card-cta">查看详情 →</text>
        </view>
      </view>
    </view>
    <view wx:else class="daily-card-prompt anim-fade-up anim-stagger-1" bindtap="onDailyCardPromptTap" role="button" aria-label="抽取今日卡牌">
      <image class="daily-card-prompt-icon" src="/images/icons/sparkle_64.png" mode="aspectFit" aria-label="抽取今日卡牌" />
      <text class="daily-card-prompt-text">抽取今日卡牌，解锁你的专属卡片</text>
    </view>

    <!-- ===== 今日塔罗故事 — Date-seeded random card teaching ===== -->
    <view class="daily-story-card anim-fade-up anim-stagger-1" wx:if="{{dailyStoryCard}}" bindtap="onGoCardDetail" data-id="{{dailyStoryCard.id}}" role="button" aria-label="查看今日塔罗故事">
      <text class="dsc-label">今日塔罗故事</text>
      <text class="dsc-title">{{dailyStoryCard.name_zh}}</text>
      <text class="dsc-story">{{dailyStoryCard.story_preview}}...</text>
      <text class="dsc-cta">探索这张牌 ✦</text>
    </view>

    <!-- Search bar -->
    <view class="search-bar anim-fade-up anim-stagger-1">
      <image class="search-icon" src="/images/icons/theme_general_64.png" mode="aspectFit" style="width:32rpx;height:32rpx;margin-right:var(--spacing-sm)" aria-label="搜索" />
      <input
        class="search-input"
        style="flex:1;font-size:var(--font-size-body);color:var(--color-text-primary);background:transparent"
        placeholder="搜索卡牌名称..."
        placeholder-style="color:var(--color-text-tertiary)"
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
      />
    </view>

    <!-- Tab bar -->
    <scroll-view class="filter-bar anim-fade-up anim-stagger-2" scroll-x>
      <view
        class="filter-item {{activeTab === item.key ? 'filter-active' : ''}}"
        wx:for="{{tabs}}" wx:key="key"
        data-key="{{item.key}}"
        bindtap="onTabTap" role="button" aria-label="筛选{{item.label}}卡牌"
      >
        <text>{{item.label}}</text>
      </view>
    </scroll-view>

    <!-- Card grid -->
    <view class="card-grid">
      <view
        class="card-item anim-card-enter anim-stagger-{{index + 1}}"
        wx:for="{{filteredCards}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onCardTap" role="button" aria-label="查看{{item.name_zh}}卡牌详情"
      >
        <!-- 收藏星标 -->
        <view class="card-favorite {{item.favorited ? 'favorited' : ''}}"
          catchtap="onToggleFavorite" data-card-id="{{item.id}}">
          <image class="fav-icon" src="/images/icons/{{item.favorited ? 'star_filled_64' : 'star_outline_64'}}.png" mode="aspectFit" aria-label="{{item.favorited ? '取消收藏' : '收藏'}}" />
        </view>
        <!-- 图片区：已激活 → 加载真实图；未激活 → 纯骨架 -->
        <view class="card-img-wrap card-thumb {{item._imgLoaded ? 'card-img-wrap--loaded' : ''}} {{item._imgError ? 'card-img-wrap--error' : ''}}" data-index="{{index}}">
          <image wx:if="{{item._active && item.imagePath && !item._imgError}}"
            class="card-img-inner" src="{{item.imagePath}}" mode="aspectFill" lazy-load
            bindload="onCardImgLoad" binderror="onCardImgError" data-index="{{index}}" aria-label="{{item.name_zh}} — {{item.arcana === 'major' ? '大牌' : '小牌'}}" />
          <view class="card-img-fallback" wx:if="{{!item.imagePath || item._imgError}}">
            <image class="card-img-fallback-icon" src="/images/icons/card_back_64.png" mode="aspectFit" aria-label="{{item.name_zh}}（无图）" />
          </view>
        </view>
        <text class="card-number">{{item.card_number}}</text>
        <text class="card-name">{{item.name_zh}}</text>
        <text class="card-name-en">{{item.name_en}}</text>
        <view class="card-badges">
          <text class="badge badge-purple">{{item.arcana === 'major' ? '大牌' : '小牌'}}</text>
          <text class="badge badge-gold" wx:if="{{item.suit}}">{{item.suitZh}}</text>
          <text class="badge" style="background:rgba(184,169,224,0.10);color:var(--color-lavender)" wx:if="{{item.element}}">{{item.element}}</text>
        </view>
      </view>
    </view>

    <!-- Empty state -->
    <view wx:if="{{!pageLoading && filteredCards.length === 0 && emptyStateType === 'favorites'}}" class="empty-state">
      <text class="empty-text">还没有收藏任何牌</text>
      <text class="empty-hint">✦ 点击卡牌上的星标即可收藏</text>
    </view>
    <view wx:elif="{{!pageLoading && filteredCards.length === 0}}" class="empty-state">
      <text class="empty-text">没有找到匹配的牌</text>
      <text class="empty-hint">试试换个关键词吧</text>
    </view>

    <!-- Card count -->
    <view class="count-bar" wx:if="{{filteredCards.length > 0}}">
      <text>共 {{filteredCards.length}} 张牌</text>
    </view>
  </view>
</view>
