<!-- pages/encyclopedia/encyclopedia.wxml -->
<view class="page">
  <!-- ===== 加载骨架 ===== -->
  <view wx:if="{{pageLoading}}">
    <view class="skeleton-search"></view>
    <view class="skeleton-tabs">
      <view class="skeleton-tab"></view>
      <view class="skeleton-tab"></view>
      <view class="skeleton-tab"></view>
      <view class="skeleton-tab"></view>
    </view>
    <view class="skeleton-grid">
      <view class="skeleton-card"></view>
      <view class="skeleton-card"></view>
      <view class="skeleton-card"></view>
      <view class="skeleton-card"></view>
      <view class="skeleton-card"></view>
      <view class="skeleton-card"></view>
    </view>
  </view>

  <!-- ===== 错误状态 ===== -->
  <view wx:elif="{{pageError}}" class="error-state">
    <text class="error-text">卡牌档案馆暂时打不开</text>
    <text class="error-hint">{{pageError}}</text>
    <button class="btn-primary btn-small" bindtap="onRetry">重新加载</button>
  </view>

  <!-- ===== 主内容 ===== -->
  <view wx:else>
    <!-- ===== 今日之牌 — Personal entry point ===== -->
    <view wx:if="{{dailyCard}}" class="daily-card anim-fade-in-up-1" bindtap="onDailyCardTap">
      <view class="daily-card-label">今日之牌</view>
      <view class="daily-card-body">
        <image class="daily-card-thumb" src="{{dailyCard.imagePath}}" mode="aspectFill" wx:if="{{dailyCard.imagePath}}"></image>
        <view class="daily-card-info">
          <text class="daily-card-name">{{dailyCard.name_zh}}</text>
          <text class="daily-card-name-en">{{dailyCard.name_en}}</text>
          <text class="daily-card-cta">查看详情 →</text>
        </view>
      </view>
    </view>
    <view wx:else class="daily-card-prompt anim-fade-in-up-1" bindtap="onDailyCardPromptTap">
      <text class="daily-card-prompt-icon">✨</text>
      <text class="daily-card-prompt-text">抽取今日卡牌，解锁你的专属卡片</text>
    </view>

    <!-- Search bar -->
    <view class="search-bar anim-fade-in-up-1">
      <image class="search-icon" src="/images/icons/theme_general_64.png" mode="aspectFit" style="width:32rpx;height:32rpx;margin-right:var(--space-sm)" />
      <input
        class="search-input"
        style="flex:1;font-size:var(--fs-body);color:var(--color-text-primary);background:transparent"
        placeholder="搜索卡牌名称..."
        placeholder-style="color:#8A85A8"
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
      />
    </view>

    <!-- Tab bar -->
    <scroll-view class="filter-bar anim-fade-in-up-2" scroll-x>
      <view
        class="filter-item {{activeTab === item.key ? 'filter-active' : ''}}"
        wx:for="{{tabs}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onTabTap"
      >
        <text>{{item.label}}</text>
      </view>
    </scroll-view>

    <!-- Card grid -->
    <view class="card-grid">
      <view
        class="card-item anim-card-enter anim-stagger-{{index + 1}}"
        wx:for="{{filteredCards}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onCardTap"
      >
        <image class="card-thumb" src="{{item.imagePath}}" mode="aspectFill" wx:if="{{item.imagePath}}"></image>
        <view class="card-thumb-placeholder" wx:else></view>
        <text class="card-number">{{item.card_number}}</text>
        <text class="card-name">{{item.name_zh}}</text>
        <text class="card-name-en">{{item.name_en}}</text>
        <view class="card-badges">
          <text class="badge badge-purple">{{item.arcana === 'major' ? '大牌' : '小牌'}}</text>
          <text class="badge badge-gold" wx:if="{{item.suit}}">{{item.suitZh}}</text>
          <text class="badge" style="background:rgba(184,169,224,0.10);color:var(--color-lavender)" wx:if="{{item.element}}">{{item.element}}</text>
        </view>
      </view>
    </view>

    <!-- Empty state -->
    <view wx:if="{{!pageLoading && filteredCards.length === 0}}" class="empty-state">
      <text class="empty-text">没有找到匹配的牌</text>
      <text class="empty-hint">试试换个关键词吧</text>
    </view>

    <!-- Card count -->
    <view class="count-bar" wx:if="{{filteredCards.length > 0}}">
      <text>共 {{filteredCards.length}} 张牌</text>
    </view>
  </view>
</view>
