/* ============================================================
   星灵学堂主页 — E3 奶油疗愈 token（styles/common.wxss）
   星空书卷：78 星点环（与手账夜空同语言）+ 四路径 + 计划设置
   ============================================================ */

page {
  --e3-cream: #FAF6EF;
  --e3-cream-hi: #FFFDF8;
  --e3-paper: #F2ECDF;
  --e3-pink: #E8C4BE;
  --e3-pink-ink: #B08A82;
  --e3-gold: #C9A97C;
  --e3-gold-deep: #8A6B3D;
  --e3-line: rgba(201, 169, 124, 0.28);
  --e3-line-soft: rgba(201, 169, 124, 0.38);
  --e3-lav: #D8D2E4;
  --e3-ink: #3D3A36;
  --e3-ink-soft: #8A8478;
  --e3-ink-faint: #6E6A96;
  --e3-shadow: 0 2rpx 8rpx rgba(61, 58, 54, 0.08);
  --e3-hi: inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
  --e3-serif: 'Songti SC', 'STSong', 'SimSun', 'Noto Serif CJK SC', 'Noto Serif SC', serif;
}

.academy-page {
  position: relative;
  padding: 0 32rpx calc(60rpx + env(safe-area-inset-bottom, 0px));
  min-height: 100vh;
  z-index: 1;
  background: var(--color-bg-gradient);
}

/* 氛围光斑（与今日屏同款 E3 底色） */
.wash {
  position: absolute;
  border-radius: 50%;
  filter: blur(60rpx);
  opacity: 0.55;
  pointer-events: none;
  z-index: 0;
}
.wash-pink {
  width: 420rpx;
  height: 420rpx;
  top: -120rpx;
  right: -140rpx;
  background: rgba(232, 196, 190, 0.35);
}
.wash-gold {
  width: 480rpx;
  height: 480rpx;
  bottom: 120rpx;
  left: -180rpx;
  background: rgba(201, 169, 124, 0.22);
}

/* ============================================================
   页头
   ============================================================ */
.page-header {
  text-align: center;
  padding: 40rpx 0 32rpx;
  position: relative;
  z-index: 1;
}

.page-title {
  font-size: var(--font-size-subhead);
  font-weight: 500;
  font-family: var(--e3-serif, 'Songti SC', serif);
  color: var(--e3-ink, #3D3A36);
  letter-spacing: 8rpx;
  display: block;
  margin-bottom: 12rpx;
}

.page-subtitle {
  font-size: var(--font-size-caption);
  color: var(--e3-ink-soft, #8A8478);
  letter-spacing: 3rpx;
  display: block;
}

/* ============================================================
   卡片通用
   ============================================================ */
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-sm);
}

.section-title {
  font-family: var(--e3-serif, 'Songti SC', serif);
  font-size: var(--font-size-body);
  font-weight: 500;
  color: var(--e3-ink, #3D3A36);
  letter-spacing: 4rpx;
}

.section-badge {
  display: flex;
  gap: 8rpx;
}

.section-badge-text {
  font-size: 20rpx;
  color: var(--e3-gold-deep, #8A6B3D);
  background: rgba(201, 169, 124, 0.14);
  border: 1rpx solid rgba(201, 169, 124, 0.30);
  border-radius: var(--radius-pill);
  padding: 4rpx 16rpx;
  letter-spacing: 1rpx;
}

/* ============================================================
   我的星图卡（78 星点环）
   ============================================================ */
.star-map-card {
  background: linear-gradient(145deg, var(--e3-cream-hi, #FFFDF8) 0%, var(--e3-paper, #F2ECDF) 100%);
  border: 1rpx solid var(--e3-line, rgba(201, 169, 124, 0.28));
  border-radius: 28rpx;
  padding: var(--spacing-md) var(--spacing-md) var(--spacing-lg);
  box-shadow: var(--e3-shadow, 0 2rpx 8rpx rgba(61, 58, 54, 0.08)), var(--e3-hi, inset 0 1rpx 0 rgba(255, 255, 255, 0.6));
  margin-bottom: var(--spacing-md);
  position: relative;
  z-index: 1;
}

.star-ring {
  position: relative;
  width: 100%;
  height: 560rpx;
}

.ring-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 420rpx;
  height: 420rpx;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: radial-gradient(circle, rgba(201, 169, 124, 0.10) 0%, rgba(201, 169, 124, 0.04) 40%, transparent 70%);
  pointer-events: none;
}

.academy-star {
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  transition: opacity 0.5s ease-out, box-shadow 0.5s ease-out, transform 0.5s ease-out;
}

.academy-star--major {
  width: 14rpx;
  height: 14rpx;
}

/* 已学：点亮 + 柔光呼吸（与手账夜空「星点=星光」同语言） */
.academy-star--lit {
  opacity: 1;
  box-shadow: 0 0 10rpx rgba(201, 169, 124, 0.45);
  animation: star-breathe 3.2s ease-in-out infinite;
}

.academy-star--dust {
  opacity: 0.32;
  box-shadow: none;
  animation: none;
}

@keyframes star-breathe {
  0%, 100% { transform: translate(-50%, -50%) scale(1); }
  50% { transform: translate(-50%, -50%) scale(1.25); }
}

.ring-center {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ring-center-num {
  font-family: var(--e3-serif, 'Songti SC', serif);
  font-size: 64rpx;
  font-weight: 500;
  color: var(--e3-gold-deep, #8A6B3D);
  line-height: 1.1;
  text-shadow: 0 0 24rpx rgba(201, 169, 124, 0.25);
}

.ring-center-label {
  font-size: var(--font-size-xs);
  color: var(--e3-ink-soft, #8A8478);
  letter-spacing: 2rpx;
  margin-top: 6rpx;
}

/* 进度文案（verbatim） */
.progress-line {
  margin-top: var(--spacing-sm);
}

.progress-text {
  display: block;
  text-align: center;
  font-family: var(--e3-serif, 'Songti SC', serif);
  font-size: var(--font-size-caption);
  color: var(--e3-ink, #3D3A36);
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.progress-bar {
  width: 70%;
  height: 8rpx;
  margin: 0 auto;
  background: rgba(61, 58, 54, 0.10);
  border-radius: var(--radius-pill);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--e3-gold, #C9A97C) 0%, var(--e3-gold-deep, #8A6B3D) 100%);
  border-radius: var(--radius-pill);
  transition: width 0.6s ease-out;
  box-shadow: 0 0 10rpx rgba(201, 169, 124, 0.25);
}

/* 空态（verbatim） */
.empty-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-top: var(--spacing-md);
}

.empty-hint-icon {
  font-size: var(--font-size-caption);
  color: var(--e3-gold, #C9A97C);
}

.empty-hint-text {
  font-family: var(--e3-serif, 'Songti SC', serif);
  font-size: var(--font-size-caption);
  color: var(--e3-pink-ink, #B08A82);
  letter-spacing: 2rpx;
}

/* 图例 */
.star-legend {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
  margin-top: var(--spacing-md);
  padding-top: var(--spacing-sm);
  border-top: 1rpx solid rgba(201, 169, 124, 0.14);
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.legend-text {
  font-size: var(--font-size-xs);
  color: var(--e3-ink-soft, #8A8478);
  letter-spacing: 1rpx;
}

/* ============================================================
   今日学牌卡
   ============================================================ */
.today-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, rgba(201, 169, 124, 0.10) 0%, rgba(216, 210, 228, 0.10) 100%);
  border: 1.5rpx solid var(--e3-line-soft, rgba(201, 169, 124, 0.38));
  border-radius: var(--radius-lg);
  padding: var(--spacing-md) var(--spacing-lg);
  margin-bottom: var(--spacing-md);
  transition: transform 0.15s ease-out, background 0.15s ease-out;
  position: relative;
  z-index: 1;
}

.today-card--press {
  background: rgba(201, 169, 124, 0.14);
  transform: scale(0.98);
}

.today-card-left {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  min-width: 0;
}

.today-card-icon {
  font-size: 36rpx;
  color: var(--e3-gold-deep, #8A6B3D);
  line-height: 1;
}

.today-card-texts {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.today-card-title {
  font-size: var(--font-size-body);
  font-weight: 600;
  color: var(--e3-gold-deep, #8A6B3D);
  letter-spacing: 2rpx;
}

.today-card-sub {
  font-size: var(--font-size-xs);
  color: var(--e3-ink-soft, #8A8478);
  letter-spacing: 1rpx;
}

.today-card-arrow {
  font-size: 44rpx;
  color: var(--e3-gold-deep, #8A6B3D);
  opacity: 0.7;
  padding-left: var(--spacing-sm);
}

/* ============================================================
   四路径卡
   ============================================================ */
.paths-section {
  margin-bottom: var(--spacing-md);
  position: relative;
  z-index: 1;
}

.paths-title {
  display: block;
  font-family: var(--e3-serif, 'Songti SC', serif);
  font-size: var(--font-size-body);
  font-weight: 500;
  color: var(--e3-ink, #3D3A36);
  letter-spacing: 4rpx;
  margin-bottom: var(--spacing-sm);
}

.paths-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
}

.path-card {
  flex: 0 0 calc(50% - var(--spacing-sm) / 2);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  background: linear-gradient(145deg, var(--e3-cream-hi, #FFFDF8) 0%, var(--e3-paper, #F2ECDF) 100%);
  border: 1.5rpx solid var(--e3-line, rgba(201, 169, 124, 0.28));
  border-radius: 22rpx;
  padding: var(--spacing-md);
  box-shadow: var(--e3-shadow, 0 2rpx 8rpx rgba(61, 58, 54, 0.08));
  transition: transform 0.15s ease-out, border-color 0.15s ease-out, box-shadow 0.15s ease-out;
}

.path-card--active {
  border-color: rgba(201, 169, 124, 0.55);
  box-shadow: 0 0 20rpx rgba(201, 169, 124, 0.14);
}

.path-card--press {
  transform: scale(0.97);
  border-color: rgba(201, 169, 124, 0.55);
}

.path-emoji {
  font-size: 40rpx;
  line-height: 1;
  margin-bottom: 10rpx;
}

.path-name {
  font-family: var(--e3-serif, 'Songti SC', serif);
  font-size: var(--font-size-body);
  font-weight: 500;
  color: var(--e3-ink, #3D3A36);
  letter-spacing: 2rpx;
  margin-bottom: 6rpx;
}

.path-sub {
  font-size: 18rpx;
  color: var(--e3-ink-soft, #8A8478);
  letter-spacing: 1rpx;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.path-progress {
  width: 100%;
  margin-bottom: 10rpx;
}

.path-progress-text {
  display: block;
  font-size: var(--font-size-xs);
  color: var(--e3-gold-deep, #8A6B3D);
  letter-spacing: 1rpx;
  margin-bottom: 6rpx;
}

.path-bar {
  width: 100%;
  height: 6rpx;
  background: rgba(61, 58, 54, 0.08);
  border-radius: var(--radius-pill);
  overflow: hidden;
}

.path-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--e3-gold, #C9A97C) 0%, var(--e3-gold-deep, #8A6B3D) 100%);
  border-radius: var(--radius-pill);
  transition: width 0.5s ease-out;
}

.path-go {
  font-size: var(--font-size-xs);
  color: var(--e3-pink-ink, #B08A82);
  letter-spacing: 1rpx;
}

/* ============================================================
   计划设置面板
   ============================================================ */
.plan-panel {
  background: linear-gradient(145deg, var(--e3-cream-hi, #FFFDF8) 0%, var(--e3-paper, #F2ECDF) 100%);
  border: 1rpx solid var(--e3-line, rgba(201, 169, 124, 0.28));
  border-radius: 24rpx;
  padding: var(--spacing-md) var(--spacing-md) var(--spacing-lg);
  box-shadow: var(--e3-shadow, 0 2rpx 8rpx rgba(61, 58, 54, 0.08));
  margin-bottom: var(--spacing-lg);
  position: relative;
  z-index: 1;
}

.plan-title {
  display: block;
  font-family: var(--e3-serif, 'Songti SC', serif);
  font-size: var(--font-size-body);
  font-weight: 500;
  color: var(--e3-ink, #3D3A36);
  letter-spacing: 4rpx;
  margin-bottom: var(--spacing-md);
}

.plan-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--spacing-md);
}

.plan-row + .plan-row {
  margin-top: var(--spacing-md);
  padding-top: var(--spacing-md);
  border-top: 1rpx solid rgba(201, 169, 124, 0.14);
}

.plan-label {
  font-size: var(--font-size-caption);
  font-weight: 500;
  color: var(--e3-ink, #3D3A36);
  letter-spacing: 2rpx;
  flex-shrink: 0;
}

.plan-counts {
  display: flex;
  gap: var(--spacing-xs);
}

.plan-count {
  min-width: 96rpx;
  text-align: center;
  padding: 12rpx 20rpx;
  border-radius: var(--radius-pill);
  font-size: var(--font-size-caption);
  color: var(--e3-ink-soft, #8A8478);
  background: rgba(201, 169, 124, 0.06);
  border: 1rpx solid rgba(201, 169, 124, 0.16);
  transition: all 0.15s ease-out;
}

.plan-count--press {
  transform: scale(0.95);
}

.plan-count--active {
  background: rgba(201, 169, 124, 0.16);
  border-color: rgba(201, 169, 124, 0.55);
  color: var(--e3-gold-deep, #8A6B3D);
  font-weight: 500;
}

.plan-row--switch {
  align-items: flex-start;
}

.plan-switch-texts {
  flex: 1;
  min-width: 0;
}

.plan-hint {
  display: block;
  font-size: 20rpx;
  color: var(--e3-ink-faint, #6E6A96);
  line-height: 1.6;
  letter-spacing: 1rpx;
  margin-top: 6rpx;
}

.plan-switch {
  flex-shrink: 0;
  transform: scale(0.85);
  transform-origin: right center;
}

/* ============================================================
   页脚
   ============================================================ */
.page-foot {
  text-align: center;
  padding: var(--spacing-sm) 0 var(--spacing-lg);
  position: relative;
  z-index: 1;
}

.page-foot-text {
  font-size: var(--font-size-xs);
  color: var(--e3-ink-faint, #6E6A96);
  letter-spacing: 3rpx;
  opacity: 0.75;
}

/* ============================================================
   加载骨架 / 错误状态
   ============================================================ */
.skeleton-wrap {
  padding: var(--spacing-xl) 0;
  position: relative;
  z-index: 1;
}

.skeleton-header-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-xl);
}

.skeleton-line {
  height: 30rpx;
  border-radius: var(--radius-sm);
}

.skeleton-line.wide { width: 280rpx; }
.skeleton-line.medium { width: 200rpx; }

.skeleton-ring {
  width: 100%;
  height: 560rpx;
  border-radius: 28rpx;
  margin-bottom: var(--spacing-md);
}

.skeleton-block {
  width: 100%;
  height: 320rpx;
  border-radius: 24rpx;
}

.error-state {
  padding: 120rpx 0;
  text-align: center;
  position: relative;
  z-index: 1;
}

.error-card {
  background: var(--color-surface);
  border: 1rpx solid rgba(232, 122, 138, 0.20);
  border-radius: var(--radius-lg);
  padding: var(--spacing-xl) var(--spacing-lg);
}

.error-title {
  font-family: var(--e3-serif, 'Songti SC', serif);
  font-size: var(--font-size-body);
  color: var(--e3-ink, #3D3A36);
  letter-spacing: 3rpx;
  display: block;
  margin-bottom: 12rpx;
}

.error-desc {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  display: block;
  margin-bottom: 36rpx;
  line-height: 1.6;
}

.btn-retry {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  background: rgba(201, 169, 124, 0.10);
  color: var(--color-gold-dark);
  font-size: var(--font-size-caption);
  font-weight: 500;
  border: 1rpx solid rgba(201, 169, 124, 0.20);
  border-radius: var(--radius-pill);
  padding: var(--spacing-sm) var(--spacing-xl);
}

.btn-retry:active {
  background: rgba(201, 169, 124, 0.18);
}

/* ============================================================
   订阅授权引导弹层
   ============================================================ */
.guide-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(61, 58, 54, 0.45);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fade-in 0.25s ease-out forwards;
}

.guide-modal {
  width: 600rpx;
  box-sizing: border-box;
  background: var(--e3-cream, #FAF6EF);
  border: 1rpx solid var(--e3-line-soft, rgba(201, 169, 124, 0.38));
  border-radius: 28rpx;
  padding: var(--spacing-xl) var(--spacing-lg) var(--spacing-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 12rpx 60rpx rgba(61, 58, 54, 0.16);
  animation: sheet-up 0.35s cubic-bezier(0.22, 1, 0.36, 1);
}

.guide-icon {
  font-size: 56rpx;
  color: var(--e3-gold, #C9A97C);
  text-shadow: 0 0 20rpx rgba(201, 169, 124, 0.4);
  margin-bottom: var(--spacing-sm);
}

.guide-title {
  font-family: var(--e3-serif, 'Songti SC', serif);
  font-size: var(--font-size-body);
  font-weight: 500;
  color: var(--e3-ink, #3D3A36);
  letter-spacing: 3rpx;
  margin-bottom: var(--spacing-sm);
}

.guide-desc {
  font-size: var(--font-size-caption);
  color: var(--e3-ink-soft, #8A8478);
  line-height: 1.8;
  letter-spacing: 1rpx;
  text-align: center;
  margin-bottom: var(--spacing-lg);
}

.guide-actions {
  display: flex;
  gap: var(--spacing-sm);
  width: 100%;
}

.guide-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  font-size: var(--font-size-caption);
  border-radius: var(--radius-pill);
  border: none;
  letter-spacing: 2rpx;
}

.guide-btn::after { border: none; }

.guide-btn--ghost {
  background: transparent;
  color: var(--e3-ink-soft, #8A8478);
  border: 1rpx solid rgba(201, 169, 124, 0.30);
}

.guide-btn--primary {
  background: linear-gradient(135deg, #C9A97C 0%, #B08F52 50%, #A98B5F 100%);
  color: var(--e3-cream-hi, #FFFDF8);
  font-weight: 600;
  box-shadow: 0 4rpx 20rpx rgba(201, 169, 124, 0.25);
}

.guide-btn--primary:active { transform: scale(0.96); }

@keyframes sheet-up {
  0% { transform: translateY(60rpx); opacity: 0; }
  100% { transform: translateY(0); opacity: 1; }
}

@media (prefers-reduced-motion: reduce) {
  .academy-star--lit { animation: none; }
}
