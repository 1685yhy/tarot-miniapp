<!-- pages/reading-result/reading-result.wxml -->
<!-- 加载中 -->
<view class="page" wx:if="{{pageLoading}}">
  <view class="loading-box">
    <view class="loading-spinner"></view>
    <text class="loading-title">星光解读中</text>
    <text class="loading-sub">请稍候…</text>
    <text class="loading-quote">{{loadingQuote}}</text>
    <view class="loading-dots">
      <text class="ldot {{loadingStage>=1?'active':''}}">●</text>
      <text class="ldot {{loadingStage>=2?'active':''}}">●</text>
      <text class="ldot {{loadingStage>=3?'active':''}}">●</text>
    </view>
  </view>
</view>

<!-- 错误 -->
<view class="page" wx:elif="{{pageError}}">
  <view class="error-state">
    <text class="error-text">加载失败</text>
    <text class="error-hint">{{pageError}}</text>
    <button class="btn-retry" bindtap="onRetry">重新加载</button>
  </view>
</view>

<!-- 结果 -->
<view class="page" wx:elif="{{reading}}">
  <!-- 抽到的牌 -->
  <view class="cards-area">
    <swiper class="card-swiper" current="{{activeCardIndex}}" bindchange="onCardSwiperChange" indicator-dots="{{true}}">
      <swiper-item wx:for="{{reading.drawn_cards}}" wx:key="id">
        <view class="card-wrapper">
          <tarot-card
            nameZh="{{item.card_name}}"
            positionName="{{item.position_name}}"
            isReversed="{{item.is_reversed}}"
          />
        </view>
      </swiper-item>
    </swiper>
  </view>

  <!-- AI 解读 -->
  <view class="interp-area">
    <text class="interp-title">✦ 解读</text>
    <view class="interp-scroll {{showFullInterpretation ? 'expanded' : ''}}">
      <text class="interp-text">{{reading.interpretation}}</text>
    </view>
    <text class="interp-toggle" wx:if="{{reading.interpretation && reading.interpretation.length > 300}}" bindtap="onToggleFull">展开全部</text>
  </view>

  <!-- 操作 -->
  <view class="actions">
    <button class="btn-ask" bindtap="onAskMore">追问更多</button>
    <button class="btn-redo" bindtap="onNewReading">重新解读</button>
    <text class="btn-back" bindtap="onBackHome">回到首页</text>
  </view>
</view>

<!-- 解读失败 -->
<view class="page" wx:else>
  <view class="error-state">
    <text class="error-text">解读生成失败</text>
    <button class="btn-retry" bindtap="onRetry">重新生成</button>
  </view>
</view>