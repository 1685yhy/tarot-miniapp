<!-- ============================================================
     Tarot Reading Result — "A Personal Letter from the Cosmos"
     Warm, intimate, magical. Three-card spread reveal.
     ============================================================ -->

<!-- ===== LOADING STATE ===== -->
<view class="page" wx:if="{{pageLoading}}">
  <view class="loading-box">

    <!-- Quick mode (default): lightweight skeleton — 800ms, then results -->
    <block wx:if="{{isQuick}}">
      <view class="quick-skeleton">
        <view class="qs-card-row">
          <view class="qs-card"></view>
          <view class="qs-card"></view>
          <view class="qs-card"></view>
        </view>
        <view class="qs-line qs-line-w60"></view>
        <view class="qs-line qs-line-w90"></view>
        <view class="qs-line qs-line-w80"></view>
        <!-- 墨色加载文案 + 三点呼吸动画（避免用户以为卡死） -->
        <view class="quick-loading-row">
          <text class="quick-loading-text">星光正在为你洗牌</text>
          <view class="breath-dots">
            <view class="breath-dot"></view>
            <view class="breath-dot"></view>
            <view class="breath-dot"></view>
          </view>
        </view>
      </view>
    </block>

    <!-- Immersive mode (opt-in): single pulsing state, max 2s -->
    <block wx:else>
      <view class="stage">
        <view class="loading-pulse">
          <view class="pulse-ring pulse-ring-1"></view>
          <view class="pulse-ring pulse-ring-2"></view>
          <view class="pulse-core"></view>
        </view>
        <text class="stage-title">正在解读...</text>
        <text class="stage-sub">{{loadingStage === 1 ? '星光正在洗牌' : (loadingStage === 2 ? '星塔罗师正在凝思' : '解读正在落笔成文')}}</text>
      </view>
    </block>

  </view>
</view>

<!-- ===== ERROR STATE ===== -->
<view class="page" wx:elif="{{pageError}}">
  <view class="error-state">
    <text class="error-text">星辰之力暂时中断</text>
    <text class="error-hint">{{pageError}}</text>
    <button class="btn-retry" bindtap="onRetry">重新加载</button>
  </view>
</view>

<!-- ===== MAIN CONTENT ===== -->
<view class="page" wx:elif="{{reading}}">
  <!-- E3 奶油底色氛围光斑（与首页气质统一） -->
  <view class="wash wash-pink"></view>
  <view class="wash wash-gold"></view>
  <scroll-view class="content-scroll" scroll-y enhanced show-scrollbar="{{false}}">

    <view class="inner-wrap">

      <!-- ==========================================================
           1. PERSONA — Interpreter identity bar (top, prominent)
           ========================================================== -->
      <view class="persona-badge" wx:if="{{personaDisplay}}">
        <text class="pb-icon">{{personaDisplay.icon}}</text>
        <view class="pb-info">
          <text class="pb-label">正在为你解读</text>
          <text class="pb-name">{{personaDisplay.name}}</text>
        </view>
      </view>

      <!-- ==========================================================
           2. CARD REVEAL — Three-card spread on a table
           ========================================================== -->
      <view class="card-default">

        <!-- Warm glow behind the center (present) card -->
        <view class="center-glow"></view>

        <!-- Three overlapping cards with images -->
        <view class="card-row">
          <view class="card-item {{enlargedCardIndex >= 0 && enlargedCardIndex !== index ? 'dimmed' : ''}} {{enlargedCardIndex === index ? 'card-active' : ''}}" wx:for="{{reading.drawn_cards}}" wx:for-item="card" wx:key="id" animation="{{cardAnimData[index]}}" data-index="{{index}}" bindtap="onCardTap" role="button" aria-label="点击放大查看卡牌 {{card.card_name}}">
            <tarot-card
              nameZh="{{card.card_name}}"
              positionName="{{card.position_name}}"
              isReversed="{{card.is_reversed}}"
              cardNumber="{{card.card_number}}"
              imagePath="{{card.imagePath}}"
            />
          </view>
        </view>

        <!-- Spread type -->
        <text class="spread-type">{{spreadTypeName}}</text>

        <!-- Immersive mode badge -->
        <text class="mode-badge" wx:if="{{isImmersive}}">✨ 沉浸解读</text>

      </view>

      <!-- ==========================================================
           3. DIVIDER — Quiet breathing room
           ========================================================== -->
      <view class="divider">
        <view class="divider-line"></view>
      </view>

      <!-- ==========================================================
           4. TL;DR — Key insight summary (before the full letter)
           ========================================================== -->
      <view class="tldr-card" wx:if="{{tldr && tldr.length > 0}}">
        <view class="tldr-badge-row">
          <text class="tldr-badge">✦ 要点</text>
        </view>
        <view class="tldr-item" wx:for="{{tldr}}" wx:for-item="line" wx:key="*this">
          <view class="tldr-dot"></view>
          <text class="tldr-text">{{line}}</text>
        </view>
      </view>

      <!-- ==========================================================
           5. LETTER — The interpretation as personal prose (hero)
           （纯文本字段 · 仅做视觉分隔线，不改内容结构）
           ========================================================== -->
      <view class="letter-section">
        <view class="letter-divider">
          <view class="letter-divider-line"></view>
          <text class="letter-divider-star">✦</text>
          <view class="letter-divider-line"></view>
        </view>
        <view class="letter-body">
          <text class="letter-text">{{reading.interpretation}}</text>
        </view>
      </view>

      <!-- 开发 03：今日能量关联 — 解读与今日能量同频（一行小字 · 接口失败隐藏） -->
      <view class="energy-link" wx:if="{{energyLink}}">
        <text class="energy-link-text">☾ {{energyLink}}</text>
      </view>


      <!-- ==========================================================
           6. ACTION SUGGESTIONS — Actionable checklist cards
           ========================================================== -->
      <action-cards
        wx:if="{{reading.action_items && reading.action_items.length > 0}}"
        items="{{reading.action_items}}"
        readingId="{{reading.id}}"
        bind:allchecked="onAllActionsChecked"
      />

      <!-- ===== Step 3 guidance hint ===== -->
      <view class="onboarding-hint {{showOnboarding && onboardingStep === 3 ? 'hint-visible' : ''}}">
        <text class="hint-text">✓ 勾选完成行动建议，星光会记住你的进步</text>
      </view>

      <!-- ==========================================================
           7. TEACHING — Card depth analysis (collapsible)
           ========================================================== -->
      <view class="teaching-section" wx:if="{{hasTeachingData}}">
        <view class="teaching-toggle" bindtap="onToggleTeaching" role="button" aria-label="切换牌面深度解析">
          <image class="teaching-toggle-icon" src="/images/icons/sparkle_64.png" mode="aspectFit" aria-label="牌面深度解析" />
          <text class="teaching-toggle-text">牌面深度解析</text>
          <text class="teaching-toggle-arrow">{{showTeaching ? '收起 ▲' : '展开 ▼'}}</text>
        </view>
        <view class="teaching-body {{showTeaching ? 'teaching-expanded' : ''}}">
          <view class="teaching-card" wx:for="{{teachingCards}}" wx:for-item="tc" wx:key="card_id">
            <view class="teaching-card-header">
              <text class="teaching-card-name">{{tc.card_name}}</text>
            </view>
            <view wx:if="{{tc.symbols && tc.symbols.length > 0}}" class="teaching-symbols">
              <text class="teaching-label">牌面符号</text>
              <view class="teaching-symbol-item" wx:for="{{tc.symbols}}" wx:for-item="sym" wx:key="symbol">
                <text class="teaching-symbol-name">{{sym.symbol}}</text>
                <text class="teaching-symbol-meaning">— {{sym.meaning}}</text>
              </view>
            </view>
            <view wx:if="{{tc.life_connection}}" class="teaching-connection">
              <text class="teaching-label">生活启示</text>
              <text class="teaching-connection-text">{{tc.life_connection}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- ==========================================================
           7b. DEEP READING PAYWALL — 阅读后置（读完再卖）
           A/B 价格逻辑不动：¥9.9 vs ¥19.9 (Task 2.7)
           ========================================================== -->
      <view class="deep-paywall" wx:if="{{!isMember}}">
        <view class="divider">
          <view class="divider-line"></view>
        </view>
        <view class="deep-paywall-card">
          <image class="dpw-icon" src="/images/icons/lock_64.png" mode="aspectFit" aria-label="解锁深度解读" />
          <text class="dpw-label">想要更深层的指引？</text>
          <text class="dpw-title">解锁深度解读 ¥{{priceTestBucket}}</text>
          <text class="dpw-desc">专属塔罗师解读 · 无限追问 · 更深入的牌面剖析</text>
          <button class="dpw-btn" bindtap="onUnlockDeepReading" disabled="{{purchasingDeep}}" aria-label="解锁深度解读，价格{{priceTestBucket}}元">{{purchasingDeep ? '解锁中...' : '立即解锁'}}</button>
        </view>
      </view>

      <!-- ==========================================================
           8. REFLECTION CARD — Guide user to diary journaling
           ========================================================== -->
      <view wx:if="{{reflectionQuestion}}" class="reflection-card">
        <view class="reflection-card-glow"></view>
        <text class="reflection-card-icon">📝</text>
        <text class="reflection-card-label">将这份启示写进日记</text>
        <text class="reflection-card-question">{{reflectionQuestion}}</text>
        <button class="reflection-card-btn" bindtap="onGoDiaryFromReading">
          <text>记录今日感悟 ✦</text>
        </button>
      </view>

      <!-- ==========================================================
           9. BOTTOM ACTIONS — 分级：追问解读师（主）/ 分享海报（次）
           送牌 / 保存 / 写日记 收进一行小图标按钮（保留原 bindtap）
           ========================================================== -->
      <view class="ask-share-row">
        <button class="ask-primary-btn" bindtap="onAskMore" aria-label="追问解读师，与塔罗师继续对话">追问解读师 ✦</button>
        <button class="share-secondary-btn" bindtap="onOpenSharePoster" aria-label="分享解读海报">分享海报</button>
      </view>
      <view class="mini-action-row">
        <button class="mini-action-btn" bindtap="onSendCardToFriend" aria-label="送好友一张牌，好友扫码后双方各得一次免费深度解读">🎁 送好友一张牌</button>
        <button class="mini-action-btn" bindtap="{{isSaved ? 'onUnsaveReading' : 'onSaveReading'}}" aria-label="{{isSaved ? '取消保存解读' : '保存解读到收藏'}}">{{isSaved ? '已保存' : '保存解读'}}</button>
        <button class="mini-action-btn" bindtap="onGoDiaryFromReading" aria-label="写日记记录感悟">📝 写日记</button>
      </view>

      <!-- Secondary exit link -->
      <view class="bottom-back">
        <text class="bottom-back-link" bindtap="onBackHome" role="button" aria-label="回到首页">回到首页</text>
      </view>

      <!-- ===== AI Disclaimer ===== -->
      <view class="ai-disclaimer">
        <view class="disc-line"></view>
        <text class="disc-text">✨ AI生成 · 塔罗是镜子而非预言 · 仅供参考</text>
        <view class="disc-line"></view>
      </view>

    </view>

  </scroll-view>

  <!-- ===== ENLARGED CARD OVERLAY ===== -->
  <view class="enlarged-overlay {{isAnimatingExit ? 'exiting' : 'active'}}" wx:if="{{enlargedCardIndex >= 0}}"
    bindtouchstart="onOverlayTouchStart"
    bindtouchmove="onOverlayTouchMove"
    bindtouchend="onOverlayTouchEnd"
    catchtap="onOverlayTap"
    role="button" aria-label="关闭放大视图">

    <!-- Enlarged card container -->
    <view class="enlarged-card-wrap {{isAnimatingExit ? 'exit' : 'enter'}}">
      <view class="enlarged-card {{flipState}}" catchtap="onEnlargedCardTap" role="button" aria-label="翻转查看卡牌详情">

        <!-- Front: card image -->
        <view class="enlarged-front" wx:if="{{!isFlipped}}">
          <view class="card-img-wrap enlarged-img {{enlargedImgLoaded ? 'card-img-wrap--loaded' : ''}} {{enlargedImgError ? 'card-img-wrap--error' : ''}}">
            <image class="card-img-inner" src="{{reading.drawn_cards[enlargedCardIndex].imagePath}}" mode="aspectFill" lazy-load wx:if="{{reading.drawn_cards[enlargedCardIndex].imagePath && !enlargedImgError}}" bindload="onEnlargedImgLoad" binderror="onEnlargedImgError" aria-label="{{reading.drawn_cards[enlargedCardIndex].card_name}} · 第{{enlargedCardIndex + 1}}张 · {{reading.drawn_cards[enlargedCardIndex].position_name || ''}}位" />
            <view class="card-img-fallback" wx:if="{{!reading.drawn_cards[enlargedCardIndex].imagePath || enlargedImgError}}">
              <text class="fallback-name-text">{{reading.drawn_cards[enlargedCardIndex].card_name}}</text>
            </view>
          </view>
        </view>

        <!-- Back: card details -->
        <view class="enlarged-back" wx:else>
          <text class="back-position">{{reading.drawn_cards[enlargedCardIndex].position_name}}</text>
          <text class="back-card-name">{{reading.drawn_cards[enlargedCardIndex].card_name}}</text>
          <view class="back-divider"></view>
          <text class="back-label">关键词</text>
          <text class="back-keywords">{{reading.drawn_cards[enlargedCardIndex].keywords || ''}}</text>
          <view class="back-divider"></view>
          <text class="back-label">逆位含义</text>
          <text class="back-desc">{{reading.drawn_cards[enlargedCardIndex].reversed_meaning || ''}}</text>
        </view>

      </view>
      <text class="enlarged-hint">轻点翻牌 · 点击背景关闭</text>
    </view>
  </view>
</view>

<!-- ===== SHARE POSTER ===== -->
<share-poster
  wx:if="{{reading}}"
  visible="{{showSharePoster}}"
  cardImagePath="{{shareCardImage}}"
  cardName="{{shareCardName}}"
  keyInsight="{{shareKeyInsight}}"
  nickname="{{userNickname}}"
  bind:close="onCloseSharePoster"
  bind:share="onSharePosterToFriend"
/>

<!-- ===== INVITE POSTER — "送好友一张牌": QR carries the inviter's code ===== -->
<share-poster
  wx:if="{{reading}}"
  mode="invite"
  visible="{{showInvitePoster}}"
  inviteCode="{{inviteCode}}"
  cardImagePath="{{shareCardImage}}"
  cardName="{{shareCardName}}"
  keyInsight="{{shareKeyInsight}}"
  nickname="{{userNickname}}"
  bind:close="onCloseInvitePoster"
  bind:share="onSharePosterToFriend"
/>

<!-- ===== EMPTY STATE ===== -->
<view class="page" wx:else>
  <view class="error-state">
    <text class="error-text">解读尚未生成</text>
    <button class="btn-retry" bindtap="onRetry">重新生成</button>
  </view>
</view>
