<!-- ============================================================
     Tarot Reading Result — "A Personal Letter from the Cosmos"
     Warm, intimate, magical. Three-card spread reveal.
     ============================================================ -->

<!-- ===== LOADING STATE: 3-Stage Anticipation ===== -->
<view class="page" wx:if="{{pageLoading}}">
  <view class="loading-box">

    <!-- Stage 1: 洗牌中 ... -->
    <view class="stage" wx:if="{{loadingStage === 1}}">
      <view class="shuffle-icon">
        <view class="card-shuffle card-left"></view>
        <view class="card-shuffle card-right"></view>
      </view>
      <text class="stage-title">洗牌中...</text>
      <text class="stage-sub">命运之轮缓缓转动</text>
    </view>

    <!-- Stage 2: 翻牌中 ... -->
    <view class="stage" wx:elif="{{loadingStage === 2}}">
      <view class="flip-icon">
        <view class="card-flip-inner"></view>
      </view>
      <text class="stage-title">翻牌中...</text>
      <text class="stage-sub">牌面渐渐浮现</text>
    </view>

    <!-- Stage 3: 星光解读中 ... with progress feedback -->
    <view class="stage" wx:elif="{{loadingStage === 3}}">
      <view class="loading-candle">
        <view class="candle-flame"></view>
      </view>
      <text class="stage-title">星光解读中...</text>
      <text class="stage-sub">答案正在凝聚</text>

      <!-- Progress step indicator: 3 dots -->
      <view class="dot-row">
        <view class="dot {{loadingDotCount >= 1 ? 'lit' : ''}}"></view>
        <view class="dot {{loadingDotCount >= 2 ? 'lit' : ''}}"></view>
        <view class="dot {{loadingDotCount >= 3 ? 'lit' : ''}}"></view>
      </view>

      <!-- Dynamic time-status text -->
      <text class="stage-time" wx:if="{{loadingTimeText}}">{{loadingTimeText}}</text>

      <!-- Wait timeout: user decision -->
      <view class="wait-options" wx:if="{{showWaitOptions}}">
        <text class="wait-hint">可能网络不稳定，是否继续等待？</text>
        <view class="wait-btns">
          <button class="btn-wait-yes" bindtap="onContinueWaiting">继续等待</button>
          <text class="btn-wait-no" bindtap="onCheckLater">稍后查看</text>
        </view>
      </view>
    </view>

  </view>
</view>

<!-- ===== ERROR STATE ===== -->
<view class="page" wx:elif="{{pageError}}">
  <view class="error-state">
    <text class="error-text">星辰之力暂时中断</text>
    <text class="error-hint">{{pageError}}</text>
    <button class="btn-retry" bindtap="onRetry">重新加载</button>
  </view>
</view>

<!-- ===== MAIN CONTENT ===== -->
<view class="page" wx:elif="{{reading}}">
  <scroll-view class="content-scroll" scroll-y enhanced show-scrollbar="{{false}}">

    <view class="inner-wrap">

      <!-- ==========================================================
           1. CARD REVEAL — Three-card spread on a table
           ========================================================== -->
      <view class="card-reveal">

        <!-- Warm glow behind the center (present) card -->
        <view class="center-glow"></view>

        <!-- Three overlapping cards with images -->
        <view class="card-row">
          <view class="card-item {{enlargedCardIndex >= 0 && enlargedCardIndex !== index ? 'dimmed' : ''}} {{enlargedCardIndex === index ? 'card-active' : ''}}" wx:for="{{reading.drawn_cards}}" wx:for-item="card" wx:key="id" animation="{{cardAnimData[index]}}" data-index="{{index}}" bindtap="onCardTap">
            <tarot-card
              nameZh="{{card.card_name}}"
              positionName="{{card.position_name}}"
              isReversed="{{card.is_reversed}}"
              cardNumber="{{card.card_number}}"
              imagePath="{{card.imagePath}}"
            />
          </view>
        </view>

        <!-- Spread type -->
        <text class="spread-type">{{spreadTypeName}}</text>

      </view>

      <!-- ==========================================================
           2. DIVIDER — Quiet breathing room
           ========================================================== -->
      <view class="divider">
        <view class="divider-line"></view>
      </view>

      <!-- ==========================================================
           3. LETTER — The interpretation as personal prose
           ========================================================== -->
      <view class="letter-section">
        <view class="letter-body {{showFullInterpretation ? 'expanded' : 'collapsed'}}">
          <text class="letter-text">{{reading.interpretation}}</text>
        </view>
        <view class="letter-toggle" wx:if="{{reading.interpretation && reading.interpretation.length > 300}}">
          <text class="toggle-btn" bindtap="onToggleFull">
            {{showFullInterpretation ? '收起' : '展开全部'}}
          </text>
        </view>
      </view>

      <!-- ==========================================================
           4. ACTION SUGGESTIONS — Actionable checklist cards
           ========================================================== -->
      <action-cards
        wx:if="{{reading.action_items && reading.action_items.length > 0}}"
        items="{{reading.action_items}}"
        readingId="{{reading.id}}"
        bind:allchecked="onAllActionsChecked"
      />

      <!-- ===== Step 3 引导提示 ===== -->
      <view class="onboarding-hint {{showOnboarding && onboardingStep === 3 ? 'hint-visible' : ''}}">
        <text class="hint-text">✓ 勾选完成行动建议，星光会记住你的进步</text>
      </view>

      <!-- ==========================================================
           5. ACTIONS — Warm, minimal, intentional
           ========================================================== -->
      <view class="actions-section">
        <button class="btn-ask" bindtap="onAskMore">追问更多</button>
        <button class="btn-share" bindtap="onOpenSharePoster">分享海报</button>
        <button class="btn-redo" bindtap="onNewReading">再来一次</button>
        <text class="btn-back" bindtap="onBackHome">回到首页</text>

        <!-- Save reading — small lavender link -->
        <view class="save-reading-wrap">
          <text class="btn-save" wx:if="{{!isSaved}}" bindtap="onSaveReading">✦ 收藏本次解读</text>
          <text class="btn-saved" wx:else bindtap="onUnsaveReading">✦ 已收藏</text>
        </view>
      </view>

      <!-- Undo bar — allow user to retract and re-draw -->
      <view class="undo-bar" wx:if="{{showUndo && !pageLoading}}" bindtap="onUndoReading">
        <text class="undo-text">↩ 重新抽牌</text>
      </view>

    </view>

  </scroll-view>

  <!-- ===== ENLARGED CARD OVERLAY ===== -->
  <view class="enlarged-overlay {{isAnimatingExit ? 'exiting' : 'active'}}" wx:if="{{enlargedCardIndex >= 0}}"
    bindtouchstart="onOverlayTouchStart"
    bindtouchmove="onOverlayTouchMove"
    bindtouchend="onOverlayTouchEnd"
    catchtap="onOverlayTap">

    <!-- Enlarged card container -->
    <view class="enlarged-card-wrap {{isAnimatingExit ? 'exit' : 'enter'}}">
      <view class="enlarged-card {{flipState}}" catchtap="onEnlargedCardTap">

        <!-- Front: card image -->
        <view class="enlarged-front" wx:if="{{!isFlipped}}">
          <view class="card-img-wrap enlarged-img {{enlargedImgLoaded ? 'card-img-wrap--loaded' : ''}}">
            <image class="card-img-inner" src="{{reading.drawn_cards[enlargedCardIndex].imagePath}}" mode="aspectFill" lazy-load wx:if="{{reading.drawn_cards[enlargedCardIndex].imagePath}}" bindload="onEnlargedImgLoad" />
            <view class="card-img-fallback" wx:if="{{!reading.drawn_cards[enlargedCardIndex].imagePath}}">
              <image class="card-img-fallback-icon" src="/images/icons/card_back_64.png" mode="aspectFit" />
            </view>
          </view>
        </view>

        <!-- Back: card details -->
        <view class="enlarged-back" wx:else>
          <text class="back-position">{{reading.drawn_cards[enlargedCardIndex].position_name}}</text>
          <text class="back-card-name">{{reading.drawn_cards[enlargedCardIndex].card_name}}</text>
          <view class="back-divider"></view>
          <text class="back-label">关键词</text>
          <text class="back-keywords">{{reading.drawn_cards[enlargedCardIndex].keywords || ''}}</text>
          <view class="back-divider"></view>
          <text class="back-label">逆位含义</text>
          <text class="back-desc">{{reading.drawn_cards[enlargedCardIndex].reversed_meaning || ''}}</text>
        </view>

      </view>
      <text class="enlarged-hint">轻点翻牌 · 点击背景关闭</text>
    </view>
  </view>
</view>

<!-- ===== SHARE POSTER ===== -->
<share-poster
  wx:if="{{reading}}"
  visible="{{showSharePoster}}"
  cardImagePath="{{shareCardImage}}"
  cardName="{{shareCardName}}"
  quote="{{shareQuote}}"
  spreadType="{{reading.spread_type}}"
  bind:close="onCloseSharePoster"
  bind:share="onSharePosterToFriend"
/>

<!-- ===== EMPTY STATE ===== -->
<view class="page" wx:else>
  <view class="error-state">
    <text class="error-text">解读尚未生成</text>
    <button class="btn-retry" bindtap="onRetry">重新生成</button>
  </view>
</view>
