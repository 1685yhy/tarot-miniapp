/* ==========================================
   reading-result · Editorial Minimal
   Clean white cards · Warm accents
   ========================================== */

/* -------- Cards section -------- */
.cards-section {
  margin-bottom: var(--space-xxl);
  position: relative;
  border-radius: 16rpx;
  padding: var(--space-xl) var(--space-md);
  background: #ffffff;
  box-shadow: 0 2rpx 12rpx rgba(160, 130, 100, 0.06);
  border: 1rpx solid rgba(180, 140, 110, 0.06);
}

.card-swiper {
  height: 480rpx;
}

.swiper-card-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
}

.drawn-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  background: #ffffff;
  border-radius: 16rpx;
  margin: 0 var(--space-lg);
  padding: var(--space-xxl);
  box-sizing: border-box;
  box-shadow: 0 4rpx 20rpx rgba(160, 130, 100, 0.08);
  border: 1rpx solid rgba(180, 140, 110, 0.06);
  transition: all 0.35s cubic-bezier(0.22, 1, 0.36, 1);
}

.card-name {
  font-size: var(--fs-body-large);
  font-weight: var(--fw-bold);
  color: #3d3228;
  letter-spacing: 2rpx;
}

.card-suit {
  font-size: var(--fs-caption);
  color: rgba(120, 100, 85, 0.4);
  letter-spacing: 2rpx;
  margin-top: 6rpx;
}

.drawn-card.reversed {
  background: #fcfaf8;
}

/* -------- Dots -------- */
.dots {
  display: flex;
  justify-content: center;
  gap: 10rpx;
  margin-top: var(--space-md);
}

.dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: rgba(180, 140, 110, 0.15);
  transition: all var(--duration-normal);
}

.dot-active {
  background: #d4a574;
  width: 24rpx;
  border-radius: 6rpx;
}

/* -------- Interpretation -------- */
.interpretation-section {
  margin-bottom: var(--space-xxl);
}

.interpretation-scroll {
  max-height: 600rpx;
  overflow: hidden;
  position: relative;
  background: #ffffff;
  border-radius: 16rpx;
  border: 1rpx solid rgba(180, 140, 110, 0.06);
  padding: var(--space-lg) var(--space-xl);
  box-shadow: 0 2rpx 12rpx rgba(160, 130, 100, 0.06);
}

.interpretation-scroll.expanded {
  max-height: none;
  overflow: visible;
}

/* Gradient fade at bottom when collapsed */
.interpretation-scroll:not(.expanded)::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 80rpx;
  background: linear-gradient(transparent, #ffffff);
  pointer-events: none;
}

.interpretation-text {
  font-size: var(--fs-body);
  color: #3d3228;
  line-height: 1.9;
  white-space: pre-wrap;
  letter-spacing: 1rpx;
  display: block;
  text-align: justify;
}

.interpretation-text::first-letter {
  font-size: 48rpx;
  font-weight: 600;
  color: #b8865a;
  float: left;
  margin-right: 6rpx;
  line-height: 1;
}

.interpretation-card {
  text-align: center;
  padding: var(--space-xl);
}

/* -------- Loading stages -------- */
.loading-stages {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: var(--space-xxl);
}

.stage-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  opacity: 0.3;
  transition: opacity 0.5s ease;
}

.stage-item.stage-done {
  opacity: 1;
}

.stage-icon {
  font-size: 24rpx;
}

.stage-text {
  font-size: var(--fs-caption);
  color: rgba(120, 100, 85, 0.5);
  white-space: nowrap;
  letter-spacing: 1rpx;
}

.stage-arrow {
  font-size: 20rpx;
  color: rgba(180, 140, 110, 0.15);
  margin-top: -20rpx;
}

/* -------- Actions -------- */
.actions {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  padding-top: var(--space-lg);
  border-top: 1rpx solid rgba(180, 140, 110, 0.08);
}

.action-row {
  display: flex;
  justify-content: center;
  gap: var(--space-huge);
  margin-top: var(--space-xs);
}

.action-link {
  font-size: var(--fs-body-small);
  color: rgba(120, 100, 85, 0.5);
  letter-spacing: 1rpx;
}

/* -------- Loading page -------- */
.loading-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  background: #faf8f6;
}

/* -------- Error state -------- */
.error-state {
  text-align: center;
  padding: var(--space-massive) var(--space-xl);
}

.error-icon {
  font-size: 72rpx;
  display: block;
  margin-bottom: var(--space-md);
  opacity: 0.4;
}

.error-text {
  font-size: var(--fs-body);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--space-xs);
  letter-spacing: 1rpx;
}

.error-hint {
  font-size: var(--fs-body-small);
  color: var(--color-text-dim);
  display: block;
  margin-bottom: var(--space-xxl);
}
