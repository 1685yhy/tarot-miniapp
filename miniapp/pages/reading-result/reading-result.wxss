/* ================================================================
   Tarot Reading Result — "A Personal Letter from the Cosmos"
   Theme: Starlight (deep indigo, warm gold, intimate prose)
   Palette:
     var(--color-bg) — cosmic night / page background
     var(--color-surface) — card surface (dark indigo)
     var(--color-gold) — warm gold (accent, light, emphasis)
     var(--color-gold-dark) — deeper gold (gradient stop)
     var(--color-lavender) — lavender (secondary, link, soft)
     var(--color-text-primary) — warm cream (body text)
     var(--color-text-tertiary) — muted lavender (tertiary, subtle)
   ================================================================ */

/* ===== 0. Page Base ===== */
.page {
  min-height: 100vh;
  background: var(--color-bg);
  display: flex;
  flex-direction: column;
}

/* Native nav bar (~44px = 88rpx) is drawn on top of the viewport,
   so 100vh extends past the visible area and pushes the bottom
   action bar off-screen. Subtract the nav bar height. */
.content-scroll {
  height: calc(100vh - 88rpx);
}

.inner-wrap {
  padding: var(--spacing-2xl) 40rpx 100rpx;
  box-sizing: border-box;
}

/* ================================================================
   LOADING STATE — quick skeleton (default) / single pulse (immersive)
   ================================================================ */
.loading-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
}

/* ---- Stage Container (fade-in entry) ---- */
.stage {
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: stage-enter 0.4s ease-out both;
}

@keyframes stage-enter {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ---- Stage Icons Base ---- */
.stage-title {
  font-size: var(--font-size-subhead);
  color: var(--color-gold);
  font-weight: 500;
  margin-bottom: 12rpx;
  letter-spacing: 3rpx;
}

.stage-sub {
  font-size: var(--font-size-caption);
  color: var(--color-lavender);
  letter-spacing: 4rpx;
  opacity: 0.7;
}

/* ================================================================
   QUICK MODE (default) — Lightweight skeleton
   800ms minimum, then results the moment the API returns
   ================================================================ */
.quick-skeleton {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 70%;
}

.qs-card-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 48rpx;
}

.qs-card {
  width: 140rpx;
  height: 200rpx;
  border-radius: 16rpx;
  background: rgba(244, 212, 140, 0.08);
  border: 1.5rpx solid rgba(244, 212, 140, 0.14);
}

.qs-line {
  width: 100%;
  height: 24rpx;
  border-radius: 999rpx;
  background: rgba(244, 212, 140, 0.08);
  margin-bottom: 20rpx;
}

.qs-line-w60 { width: 60%; }
.qs-line-w90 { width: 90%; }
.qs-line-w80 { width: 80%; }

.quick-loading-text {
  margin-top: 24rpx;
  font-size: var(--font-size-caption);
  color: var(--color-lavender);
  letter-spacing: 3rpx;
  opacity: 0.7;
  animation: qs-text-pulse 1.6s ease-in-out infinite;
}

@keyframes qs-text-pulse {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 0.9; }
}

/* ================================================================
   IMMERSIVE MODE (opt-in) — Single pulsing state, max 2s
   ================================================================ */
.loading-pulse {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  margin-bottom: var(--spacing-xl);
  display: flex;
  align-items: center;
  justify-content: center;
}

.pulse-core {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: radial-gradient(
    circle at 35% 35%,
    rgba(255, 235, 190, 0.9) 0%,
    rgba(244, 212, 140, 0.35) 60%,
    rgba(244, 212, 140, 0) 100%
  );
  box-shadow: 0 0 40rpx rgba(244, 212, 140, 0.35);
  animation: pulse-core 2s ease-in-out infinite;
}

.pulse-ring {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 50%;
  border: 2rpx solid rgba(244, 212, 140, 0.25);
  animation: pulse-ring 2s ease-out infinite;
}

.pulse-ring-2 {
  animation-delay: 0.6s;
}

@keyframes pulse-ring {
  0% {
    transform: scale(0.5);
    opacity: 0.8;
  }
  100% {
    transform: scale(1);
    opacity: 0;
  }
}

@keyframes pulse-core {
  0%, 100% {
    transform: scale(0.85);
    opacity: 0.7;
  }
  50% {
    transform: scale(1.1);
    opacity: 1;
  }
}

/* ================================================================
   ERROR / EMPTY STATE
   ================================================================ */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 0 var(--spacing-xl);
}

.error-text {
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
}

.error-hint {
  font-size: var(--font-size-caption);
  color: var(--color-lavender);
  margin-bottom: 44rpx;
  letter-spacing: 1rpx;
}

.btn-retry {
  background: rgba(244, 212, 140, 0.12);
  color: var(--color-gold);
  border: 1rpx solid rgba(244, 212, 140, 0.25);
  border-radius: var(--radius-pill);
  padding: var(--spacing-sm) 56rpx;
  font-size: var(--font-size-body);
  letter-spacing: 2rpx;
  font-weight: 500;
}

.btn-retry::after {
  border: none;
}

/* ================================================================
   1. CARD REVEAL — Three-card spread
   ================================================================ */
/* Spread stage container. This element is a layout wrapper, not an
   info card, so it neutralizes the global .card-default base
   visuals (styles/cards.wxss) and keeps the container layout. */
.card-default {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 24rpx 0 0;
  background: none;
  border: none;
  border-radius: 0;
  box-shadow: none;
}

/* Warm gold glow behind the center card */
.center-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 320rpx;
  height: 320rpx;
  background: radial-gradient(
    circle,
    rgba(244, 212, 140, 0.10) 0%,
    rgba(244, 212, 140, 0.04) 40%,
    transparent 70%
  );
  pointer-events: none;
}

/* ---- Card Row (horizontal spread) ---- */
.card-row {
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
  z-index: 1;
}

/* ---- Individual Card (image-based layout) ---- */
.card-item {
  flex-shrink: 0;
  width: 160rpx;
  position: relative;
  transition: transform 0.2s ease-out;
}

/* Overlap: every card after the first slides left */
.card-item + .card-item {
  margin-left: -20rpx;
}

/* Card stacking order: past (1), present (2, elevated), future (3) */
.card-item:nth-child(1) {
  z-index: 1;
}

.card-item:nth-child(2) {
  z-index: 3;
  transform: translateY(-18rpx);
}

.card-item:nth-child(3) {
  z-index: 1;
}

/* ---- Card Image ---- */
.card-img {
  width: 160rpx;
  height: 224rpx;
  border-radius: var(--radius-sm);
  border: 2rpx solid rgba(244, 212, 140, 0.55);
  box-shadow:
    0 0 20rpx rgba(244, 212, 140, 0.12),
    0 4rpx 12rpx rgba(0, 0, 0, 0.3);
  background: var(--color-surface);
  display: block;
}

/* Center card image gets a stronger glow */
.card-item:nth-child(2) .card-img {
  border-color: rgba(244, 212, 140, 0.8);
  box-shadow:
    0 0 36rpx rgba(244, 212, 140, 0.30),
    0 0 16rpx rgba(244, 212, 140, 0.12),
    0 4rpx 20rpx rgba(0, 0, 0, 0.35);
}

/* ---- Card Inner (position relative for overlay) ---- */
.card-inner {
  position: relative;
  z-index: 1;
  border-radius: var(--radius-sm);
  overflow: hidden;
}

/* ---- Card Overlay (semi-transparent dark bg at bottom) ---- */
.card-label {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(26, 26, 62, 0.80);
  backdrop-filter: blur(2rpx);
  -webkit-backdrop-filter: blur(2rpx);
  padding: 8rpx 6rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.card-pos {
  display: block;
  font-size: var(--font-size-xs);
  color: var(--color-gold);
  letter-spacing: 3rpx;
  font-weight: 500;
  opacity: 0.88;
  white-space: nowrap;
  line-height: 1.4;
}

.card-name {
  display: block;
  font-size: var(--font-size-xs);
  color: var(--color-text-primary);
  font-weight: 500;
  letter-spacing: 1rpx;
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 144rpx;
  margin-top: 2rpx;
}

/* ---- Spread Type Label ---- */
.spread-type {
  display: block;
  margin-top: 32rpx;
  font-size: var(--font-size-xs);
  color: var(--color-lavender);
  letter-spacing: 5rpx;
  font-weight: 400;
  opacity: 0.5;
}

/* ---- Mode Badge ---- */
.mode-badge {
  display: inline-block;
  margin-top: 16rpx;
  padding: 8rpx 24rpx;
  background: rgba(244, 212, 140, 0.10);
  border: 1rpx solid rgba(244, 212, 140, 0.20);
  border-radius: 999rpx;
  font-size: var(--font-size-caption);
  color: var(--color-gold);
  letter-spacing: 3rpx;
  font-weight: 500;
  text-align: center;
}

/* ================================================================
   4. TL;DR CARD — 三行结论卡片
   ================================================================ */
.tldr-card {
  background: rgba(37, 37, 80, 0.35);
  border-left: 4rpx solid var(--color-gold, #F4D48C);
  border-radius: var(--radius-md, 16rpx);
  padding: var(--spacing-lg, 28rpx) var(--spacing-lg, 28rpx) var(--spacing-md, 24rpx);
  margin-bottom: var(--spacing-xl, 48rpx);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.15);
}

.tldr-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
  line-height: 1.6;
}

.tldr-item:last-child {
  margin-bottom: 0;
}

.tldr-dot {
  flex-shrink: 0;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-gold, #F4D48C);
  margin-top: 10rpx;
  margin-right: 16rpx;
  box-shadow: 0 0 8rpx rgba(244, 212, 140, 0.4);
}

.tldr-text {
  font-size: var(--font-size-caption, 26rpx);
  color: var(--color-text-primary, #F0EDE8);
  letter-spacing: 1rpx;
  line-height: 1.6;
  flex: 1;
}

.tldr-expand {
  display: flex;
  justify-content: center;
  margin-top: 20rpx;
  padding-top: 16rpx;
  cursor: pointer;
}

.tldr-expand text {
  font-size: var(--font-size-caption, 26rpx);
  color: var(--color-lavender, #B8A9E0);
  letter-spacing: 2rpx;
  padding: 8rpx 24rpx;
  border-radius: var(--radius-pill, 999rpx);
  border: 1rpx solid rgba(180, 169, 224, 0.18);
  transition: opacity 0.2s, border-color 0.2s;
}

.tldr-expand:active text {
  opacity: 0.7;
  border-color: rgba(180, 169, 224, 0.4);
  background: rgba(180, 169, 224, 0.05);
}

/* ================================================================
   1. PERSONA BAR — Interpreter identity (prominent, page header)
   ================================================================ */
.persona-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-2xl);
  padding: 28rpx 48rpx;
  background: linear-gradient(135deg, rgba(244, 212, 140, 0.16) 0%, rgba(244, 212, 140, 0.05) 100%);
  border: 1.5rpx solid rgba(244, 212, 140, 0.35);
  border-radius: var(--radius-pill);
  width: fit-content;
  margin-left: auto;
  margin-right: auto;
  box-shadow:
    0 0 36rpx rgba(244, 212, 140, 0.14),
    inset 0 0 24rpx rgba(244, 212, 140, 0.04);
}

.pb-icon {
  font-size: 56rpx;
  line-height: 1;
  color: var(--color-gold);
  flex-shrink: 0;
  text-shadow: 0 0 24rpx rgba(244, 212, 140, 0.55);
}

.pb-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.pb-label {
  font-size: var(--font-size-caption);
  color: var(--color-lavender);
  letter-spacing: 4rpx;
  opacity: 0.9;
  line-height: 1.3;
}

.pb-name {
  font-size: 40rpx;
  color: var(--color-gold);
  letter-spacing: 4rpx;
  font-weight: var(--font-weight-bold);
  line-height: 1.3;
  text-shadow: 0 0 20rpx rgba(244, 212, 140, 0.35);
}

.pb-desc {
  font-size: 20rpx;
  color: var(--color-lavender);
  letter-spacing: 2rpx;
  opacity: 0.7;
  line-height: 1.3;
  margin-top: 2rpx;
}

/* ================================================================
   3. DIVIDER — Quiet, thin, centered gold line
   ================================================================ */
.divider {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: var(--spacing-xl) 0 var(--spacing-lg);
}

.divider-line {
  width: 160rpx;
  height: 1rpx;
  background: linear-gradient(
    to right,
    transparent,
    rgba(244, 212, 140, 0.25),
    transparent
  );
}

/* ================================================================
   5. LETTER — The interpretation (hero section)
   ================================================================ */
.letter-section {
  margin-bottom: var(--spacing-xl);
}

/* ---- Letter Body Container — hero card ---- */
.letter-body {
  background: rgba(37, 37, 80, 0.45);
  border-radius: var(--radius-md);
  padding: var(--spacing-xl) var(--spacing-lg);
  position: relative;
  border: 1rpx solid rgba(244, 212, 140, 0.14);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.20);
}

/* Subtle top light wash */
.letter-body::before {
  content: '';
  position: absolute;
  top: 0;
  left: 32rpx;
  right: 32rpx;
  height: 1rpx;
  background: linear-gradient(
    to right,
    transparent,
    rgba(244, 212, 140, 0.12),
    transparent
  );
}

/* ---- Letter Text — primary visual weight on the page ---- */
.letter-text {
  font-size: 32rpx;   /* between body (30) and subhead (36) — the hero */
  color: var(--color-text-primary);
  line-height: 1.95;
  letter-spacing: 1.5rpx;
  white-space: pre-wrap;
  word-break: break-word;
  display: block;
}

/* ---- Staggered Text Fade-In ---- */
@keyframes textFadeIn {
  0% { opacity: 0; transform: translateY(12rpx); }
  100% { opacity: 1; transform: translateY(0); }
}
/* nth-child animations on .letter-text are non-functional in WXSS
   (WXSS does not support animation-delay on <text> with nth-child).
   Kept as reference for possible future JS-based stagger implementation. */

/* ================================================================
   3b. DEEP READING PAYWALL — first-paid upgrade (A/B test price)
   ================================================================ */
.deep-paywall {
  margin-top: var(--spacing-md, 24rpx);
}

.deep-paywall-card {
  position: relative;
  margin: var(--spacing-lg) var(--spacing-md);
  padding: var(--spacing-lg);
  background: linear-gradient(135deg, rgba(180,140,200,0.10) 0%, rgba(244,212,140,0.08) 100%);
  border: 1.5rpx solid rgba(244,212,140,0.20);
  border-radius: var(--radius-lg, 24rpx);
  text-align: center;
  overflow: hidden;
}

.dpw-icon {
  display: block;
  width: 64rpx;
  height: 64rpx;
  margin: 0 auto 12rpx;
}

.dpw-label {
  display: block;
  font-size: var(--font-size-caption, 24rpx);
  color: var(--color-lavender, #B8A9E0);
  letter-spacing: 2rpx;
  margin-bottom: 10rpx;
}

.dpw-title {
  display: block;
  font-size: var(--font-size-subhead, 36rpx);
  color: var(--color-gold, #F4D48C);
  font-weight: 700;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.dpw-desc {
  display: block;
  font-size: var(--font-size-caption, 24rpx);
  color: var(--color-text-secondary, rgba(255,255,255,0.6));
  line-height: 1.6;
  margin-bottom: 28rpx;
}

.dpw-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 56rpx;
  background: linear-gradient(135deg, #F4D48C 0%, #D4B06A 100%);
  border-radius: var(--radius-pill, 999rpx);
  color: #1A1A3E;
  font-size: var(--font-size-body, 30rpx);
  font-weight: 600;
  letter-spacing: 2rpx;
  border: none;
}

.dpw-btn::after {
  border: none;
}

.dpw-btn[disabled] {
  opacity: 0.6;
}

/* ================================================================
   4. ACTIONS
   ================================================================ */
.actions-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-sm);
  padding: var(--spacing-md) 0 calc(var(--safe-area-bottom) + var(--spacing-lg));
}

/* ---- Primary: "追问更多" gold pill ---- */
.btn-ask {
  width: 100%;
  background: linear-gradient(135deg, var(--color-gold) 0%, var(--color-gold-dark) 100%);
  color: var(--color-bg);
  font-weight: 700;
  font-size: var(--font-size-body);
  border-radius: var(--radius-pill);
  padding: var(--spacing-md) 0;
  border: none;
  letter-spacing: 5rpx;
  box-shadow:
    0 6rpx 28rpx rgba(244, 212, 140, 0.25),
    0 2rpx 8rpx rgba(244, 212, 140, 0.12);
  transition: opacity 0.2s;
  position: relative;
  overflow: hidden;
}

.btn-ask::after {
  border: none;
}

.btn-ask:active {
  opacity: 0.85;
}

/* ---- Share: outlined gold pill (between primary and secondary) ---- */
.btn-share {
  width: 100%;
  background: transparent;
  color: var(--color-gold);
  font-weight: 500;
  font-size: var(--font-size-body);
  border-radius: var(--radius-pill);
  padding: var(--spacing-md) 0;
  border: 1.5rpx solid rgba(244, 212, 140, 0.3);
  letter-spacing: 4rpx;
  transition: border-color 0.2s, background 0.2s;
}

.btn-share::after {
  border: none;
}

.btn-share:active {
  border-color: rgba(244, 212, 140, 0.6);
  background: rgba(244, 212, 140, 0.06);
}

/* ---- Secondary: "再来一次" outlined pill ---- */
.btn-redo {
  width: 100%;
  background: transparent;
  color: var(--color-gold);
  font-weight: 500;
  font-size: var(--font-size-body);
  border-radius: var(--radius-pill);
  padding: var(--spacing-md) 0;
  border: 1.5rpx solid rgba(244, 212, 140, 0.3);
  letter-spacing: 4rpx;
  transition: border-color 0.2s, background 0.2s;
}

.btn-redo::after {
  border: none;
}

.btn-redo:active {
  border-color: rgba(244, 212, 140, 0.6);
  background: rgba(244, 212, 140, 0.06);
}

/* ---- Tertiary: "回到首页" outlined pill ---- */
.btn-back {
  display: block;
  width: 100%;
  text-align: center;
  background: transparent;
  color: var(--color-text-secondary);
  font-size: var(--font-size-body);
  font-weight: 500;
  letter-spacing: 2rpx;
  border-radius: var(--radius-pill);
  padding: var(--spacing-md) 0;
  border: 1.5rpx solid rgba(160, 152, 192, 0.25);
  margin-top: 8rpx;
  transition: border-color 0.2s, background 0.2s, color 0.2s;
}

.btn-back::after { border: none; }

.btn-back:active {
  border-color: rgba(160, 152, 192, 0.55);
  background: rgba(160, 152, 192, 0.08);
  color: var(--color-text-primary);
}

/* ---- Save reading link with button styling ---- */
.save-reading-wrap {
  display: flex;
  justify-content: center;
  padding-top: 12rpx;
}

.btn-save {
  display: inline-block;
  font-size: var(--font-size-caption);
  color: var(--color-lavender);
  letter-spacing: 2rpx;
  opacity: 0.65;
  padding: var(--spacing-sm) var(--spacing-xl);
  border-radius: var(--radius-pill);
  border: 1rpx solid rgba(180, 169, 224, 0.2);
  transition: opacity 0.2s, border-color 0.2s, background 0.2s;
}

.btn-save::after { border: none; }

.btn-save:active {
  opacity: 1;
  color: var(--color-gold);
  border-color: rgba(244, 212, 140, 0.35);
  background: rgba(244, 212, 140, 0.06);
}

.btn-saved {
  display: inline-block;
  font-size: var(--font-size-caption);
  color: var(--color-gold);
  letter-spacing: 2rpx;
  opacity: 0.75;
  padding: var(--spacing-sm) var(--spacing-xl);
  border-radius: var(--radius-pill);
  border: 1rpx solid rgba(244, 212, 140, 0.3);
  transition: opacity 0.2s;
}

.btn-saved::after { border: none; }

.btn-saved:active {
  opacity: 1;
}

/* ================================================================
   5. INTERACTIVE CARD — Dimmed state for non-selected cards
   ================================================================ */
.card-item {
  cursor: pointer;
  transition: opacity 0.15s ease-out, transform 0.15s ease-out;
}

.card-item.dimmed {
  opacity: 0.2 !important;
  pointer-events: none;
}

/* ================================================================
   6. ENLARGED CARD OVERLAY — Full screen, dark backdrop
   ================================================================ */
.enlarged-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(10, 10, 30, 0.85);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(6rpx);
  -webkit-backdrop-filter: blur(6rpx);
}

.enlarged-overlay.active {
  animation: overlay-fade-in 0.3s ease-out;
}

.enlarged-overlay.exiting {
  animation: overlay-fade-out 0.3s ease-out;
  pointer-events: none;
}

@keyframes overlay-fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes overlay-fade-out {
  from { opacity: 1; }
  to { opacity: 0; }
}

/* ---- Enlarged Card Wrapper ---- */
.enlarged-card-wrap {
  width: 70vw;
  max-width: 500rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.enlarged-card-wrap.enter {
  animation: card-enter 0.3s ease-out;
}

.enlarged-card-wrap.exit {
  animation: card-exit 0.3s ease-out;
}

@keyframes card-enter {
  from {
    transform: scale(0.6) translateY(40rpx);
    opacity: 0;
  }
  to {
    transform: scale(1) translateY(0);
    opacity: 1;
  }
}

@keyframes card-exit {
  from {
    transform: scale(1) translateY(0);
    opacity: 1;
  }
  to {
    transform: scale(0.6) translateY(40rpx);
    opacity: 0;
  }
}

/* ---- The Enlarged Card Itself ---- */
.enlarged-card {
  width: 100%;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: var(--color-surface);
  border: 2rpx solid rgba(244, 212, 140, 0.6);
  box-shadow:
    0 0 60rpx rgba(244, 212, 140, 0.20),
    0 0 30rpx rgba(244, 212, 140, 0.08),
    0 8rpx 40rpx rgba(0, 0, 0, 0.5);
  cursor: pointer;
}

/* Flip animation stages */
.enlarged-card.flip-out {
  animation: flip-out 0.3s ease-out forwards;
}

.enlarged-card.flip-in {
  animation: flip-in 0.3s ease-out forwards;
}

@keyframes flip-out {
  0% { transform: scaleX(1); }
  100% { transform: scaleX(0.05); }
}

@keyframes flip-in {
  0% { transform: scaleX(0.05); }
  100% { transform: scaleX(1); }
}

/* ---- Front: card image ---- */
.enlarged-img {
  width: 100%;
  height: auto;
  aspect-ratio: 5 / 7;
  display: block;
}

/* Fallback name text when enlarged card image fails to load */
.fallback-name-text {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  min-height: 200rpx;
  padding: var(--spacing-lg);
  font-size: var(--font-size-subhead);
  font-weight: var(--font-weight-medium);
  color: var(--color-lavender-light);
  text-align: center;
  letter-spacing: 3rpx;
  line-height: 1.5;
  text-shadow: 0 0 8rpx rgba(212, 168, 83, 0.30);
  box-sizing: border-box;
}

/* ---- Back: card details ---- */
.enlarged-back {
  padding: var(--spacing-xl) var(--spacing-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 200rpx;
}

.back-position {
  font-size: var(--font-size-caption);
  color: var(--color-gold);
  letter-spacing: 4rpx;
  opacity: 0.7;
  margin-bottom: 12rpx;
}

.back-card-name {
  font-size: var(--font-size-subhead);
  color: var(--color-text-primary);
  font-weight: 600;
  letter-spacing: 2rpx;
  text-align: center;
  line-height: 1.3;
}

.back-divider {
  width: 80rpx;
  height: 1rpx;
  background: linear-gradient(to right, transparent, rgba(244, 212, 140, 0.3), transparent);
  margin: var(--spacing-md) 0;
}

.back-label {
  font-size: var(--font-size-xs);
  color: var(--color-lavender);
  letter-spacing: 3rpx;
  opacity: 0.6;
  margin-bottom: 8rpx;
}

.back-keywords {
  font-size: var(--font-size-caption);
  color: var(--color-text-primary);
  text-align: center;
  line-height: 1.6;
  letter-spacing: 1rpx;
  opacity: 0.85;
}

.back-desc {
  font-size: var(--font-size-caption);
  color: var(--color-text-primary);
  text-align: center;
  line-height: 1.7;
  letter-spacing: 1rpx;
  opacity: 0.75;
}

/* ---- Hint text below the enlarged card ---- */
.enlarged-hint {
  font-size: var(--font-size-caption);
  color: var(--color-lavender);
  letter-spacing: 2rpx;
  opacity: 0.4;
  margin-top: 32rpx;
}

/* ============================================================
   ONBOARDING HINT — Step 3 lightweight guidance
   ============================================================ */
.onboarding-hint {
  padding: 20rpx 28rpx;
  margin: 24rpx 0 8rpx;
  background: rgba(26, 26, 62, 0.95);
  border: 1.5rpx solid var(--color-gold, #F4D48C);
  border-radius: 16rpx;
  text-align: center;
  opacity: 0;
  transform: translateY(-8rpx);
  transition: opacity 0.3s ease, transform 0.3s ease;
  pointer-events: none;
}

.onboarding-hint.hint-visible {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.onboarding-hint .hint-text {
  display: block;
  font-size: var(--font-size-caption, 24rpx);
  color: var(--color-text-primary);
  line-height: 1.6;
  letter-spacing: 1rpx;
  opacity: 0.85;
}

/* ============================================================
   Membership unlock CTA — post-reading soft upsell
   ============================================================ */
.unlock-cta { padding: 48rpx 32rpx; text-align: center; }
.unlock-divider { display: flex; align-items: center; margin-bottom: 32rpx; }
.unlock-divider-line { flex: 1; height: 1rpx; background: rgba(244, 212, 140, 0.15); }
.unlock-divider-star { margin: 0 16rpx; color: var(--color-gold); font-size: 24rpx; }
.unlock-title { display: block; font-size: 32rpx; color: var(--color-gold); font-weight: 600; margin-bottom: 12rpx; }
.unlock-desc { display: block; font-size: 26rpx; color: var(--color-text-secondary); margin-bottom: 32rpx; }
.unlock-btn {
  background: linear-gradient(135deg, var(--color-gold), var(--color-gold-dark));
  color: var(--color-text-inverse); font-size: 28rpx; font-weight: 600;
  border-radius: 48rpx; padding: 20rpx 56rpx; border: none;
}

/* ============================================================
   Teaching Section — Collapsible card-depth analytics
   ============================================================ */
.teaching-section {
  margin: var(--spacing-lg) 0;
  position: relative;
  z-index: 1;
}

.teaching-toggle {
  display: flex;
  align-items: center;
  gap: var(--spacing-xs, 12rpx);
  padding: var(--spacing-sm, 16rpx) var(--spacing-md, 24rpx);
  background: rgba(244, 212, 140, 0.06);
  border: 1.5rpx solid rgba(244, 212, 140, 0.15);
  border-radius: var(--radius-md, 16rpx);
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
  transition: background var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out);
}

.teaching-toggle:active {
  background: rgba(244, 212, 140, 0.10);
  border-color: rgba(244, 212, 140, 0.30);
}

.teaching-toggle-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.teaching-toggle-text {
  flex: 1;
  font-size: var(--font-size-caption, 26rpx);
  font-weight: 600;
  color: var(--color-gold, #F4D48C);
  letter-spacing: 2rpx;
}

.teaching-toggle-arrow {
  font-size: var(--font-size-xs, 20rpx);
  color: var(--color-lavender, #B8A9E0);
  flex-shrink: 0;
  letter-spacing: 1rpx;
}

/* Collapsible body */
.teaching-body {
  max-height: 0;
  overflow: hidden;
  transition: opacity 0.4s ease-out;
  opacity: 0;
}

.teaching-body.teaching-expanded {
  max-height: 2000rpx;
  opacity: 1;
}

/* Individual teaching card */
.teaching-card {
  margin-top: var(--spacing-sm, 16rpx);
  padding: var(--spacing-md, 24rpx);
  background: rgba(37, 37, 80, 0.35);
  border: 1rpx solid rgba(244, 212, 140, 0.10);
  border-radius: var(--radius-md, 16rpx);
  border-left: 4rpx solid var(--color-gold, #F4D48C);
}

.teaching-card-header {
  margin-bottom: var(--spacing-sm, 16rpx);
}

.teaching-card-name {
  font-size: var(--font-size-body, 30rpx);
  font-weight: 600;
  color: var(--color-gold, #F4D48C);
  letter-spacing: 2rpx;
}

.teaching-label {
  display: block;
  font-size: var(--font-size-xs, 20rpx);
  font-weight: 500;
  color: var(--color-lavender, #B8A9E0);
  letter-spacing: 2rpx;
  margin-bottom: var(--spacing-xs, 12rpx);
  opacity: 0.8;
}

.teaching-symbols {
  margin-bottom: var(--spacing-sm, 16rpx);
}

.teaching-symbol-item {
  display: flex;
  align-items: baseline;
  gap: var(--spacing-xxs, 8rpx);
  padding: 6rpx 0;
}

.teaching-symbol-name {
  font-size: var(--font-size-caption, 24rpx);
  font-weight: 500;
  color: var(--color-text-primary, #F0EDE8);
  letter-spacing: 1rpx;
  flex-shrink: 0;
}

.teaching-symbol-meaning {
  font-size: var(--font-size-caption, 24rpx);
  color: var(--color-lavender, #B8A9E0);
  letter-spacing: 1rpx;
  line-height: 1.6;
}

.teaching-connection {
  padding-top: var(--spacing-xs, 12rpx);
  border-top: 1rpx solid rgba(244, 212, 140, 0.08);
}

.teaching-connection-text {
  display: block;
  font-size: var(--font-size-caption, 24rpx);
  color: var(--color-text-primary, #F0EDE8);
  line-height: 1.7;
  letter-spacing: 1rpx;
  opacity: 0.9;
}

/* ============================================================
   Share CTA — Tasteful share prompt card after interpretation
   ============================================================ */
.share-cta-wrap {
  margin: var(--spacing-lg) 0;
  transition: max-height 0.3s ease-out, opacity 0.3s ease-out, margin 0.3s ease-out;
  max-height: 600rpx;
  opacity: 1;
  overflow: hidden;
}
.share-cta-wrap.dismissed {
  max-height: 0;
  opacity: 0;
  margin: 0;
  pointer-events: none;
}
.share-cta-card {
  position: relative;
  background: linear-gradient(145deg, rgba(42,42,90,0.7) 0%, rgba(53,53,112,0.5) 100%);
  border: 1.5rpx solid rgba(244, 212, 140, 0.2);
  border-radius: 24rpx;
  padding: var(--spacing-lg) var(--spacing-lg) var(--spacing-md);
  text-align: center;
  overflow: hidden;
}
.share-cta-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(244,212,140,0.3), transparent);
  pointer-events: none;
}
.share-cta-close {
  position: absolute;
  top: 12rpx;
  right: 20rpx;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: var(--color-text-tertiary);
  font-size: 26rpx;
  opacity: 0.5;
  cursor: pointer;
  transition: opacity 0.2s, background 0.2s;
}
.share-cta-close:active {
  opacity: 0.8;
  background: rgba(255,255,255,0.05);
}
.share-cta-icon {
  font-size: 44rpx;
  color: var(--color-gold);
  display: block;
  margin-bottom: var(--spacing-xs);
  text-shadow: 0 0 20rpx rgba(244,212,140,0.3);
}
.share-cta-title {
  font-size: var(--font-size-subhead);
  font-weight: 700;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: 6rpx;
  letter-spacing: 2rpx;
}
.share-cta-desc {
  font-size: var(--font-size-caption);
  color: var(--color-lavender);
  display: block;
  margin-bottom: var(--spacing-md);
  letter-spacing: 1rpx;
  line-height: 1.5;
}
.share-cta-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 320rpx;
  padding: var(--spacing-sm) 56rpx;
  background: linear-gradient(135deg, #F4D48C 0%, #E8C67A 50%, #D4B06A 100%);
  color: #1A1A3E;
  font-size: var(--font-size-body);
  font-weight: 700;
  border: none;
  border-radius: var(--radius-pill);
  letter-spacing: 3rpx;
  box-shadow: 0 4rpx 28rpx rgba(244, 212, 140, 0.25);
  transition: transform 0.15s ease-out, box-shadow 0.15s ease-out;
}
.share-cta-btn::after {
  border: none;
}
.share-cta-btn:active {
  transform: scale(0.96);
  box-shadow: 0 2rpx 12rpx rgba(244, 212, 140, 0.15);
}

/* ============================================================
   REFLECTION CARD — Diary journaling prompt card
   ============================================================ */
.reflection-card {
  position: relative;
  margin: var(--spacing-lg) var(--spacing-md);
  padding: var(--spacing-lg);
  background: linear-gradient(135deg, rgba(180,140,200,0.10) 0%, rgba(244,212,140,0.08) 100%);
  border: 1.5rpx solid rgba(244,212,140,0.20);
  border-radius: var(--radius-lg, 24rpx);
  text-align: center;
  overflow: hidden;
}

.reflection-card-glow {
  position: absolute;
  top: -40rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 200rpx;
  height: 80rpx;
  background: radial-gradient(ellipse, rgba(244,212,140,0.15) 0%, transparent 70%);
  pointer-events: none;
}

.reflection-card-icon {
  display: block;
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.reflection-card-label {
  display: block;
  font-size: var(--font-size-caption, 24rpx);
  color: var(--color-gold);
  font-weight: 600;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.reflection-card-question {
  display: block;
  font-size: var(--font-size-body, 30rpx);
  color: var(--color-text-primary);
  line-height: 1.7;
  margin-bottom: 24rpx;
  font-weight: 400;
}

.reflection-card-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 48rpx;
  background: linear-gradient(135deg, #F4D48C 0%, #D4B06A 100%);
  border-radius: var(--radius-pill, 999rpx);
  color: #1A1A3E;
  font-size: var(--font-size-body, 30rpx);
  font-weight: 600;
  letter-spacing: 2rpx;
  border: none;
}

.reflection-card-btn::after {
  border: none;
}

/* ============================================================
   BOTTOM BAR — Gift + Share + Save + Diary, evenly spaced row
   ============================================================ */
.bottom-bar {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
  padding: var(--spacing-md, 24rpx) 0 var(--spacing-sm, 16rpx);
}

/* Equal-width buttons spanning the full row — evenly spaced */
.bottom-bar-btn {
  flex: 1;
  min-width: 0;
  background: transparent;
  color: var(--color-gold, #F4D48C);
  font-size: 22rpx;
  font-weight: 500;
  border-radius: var(--radius-pill, 999rpx);
  padding: var(--spacing-md, 24rpx) 4rpx;
  border: 1.5rpx solid rgba(244, 212, 140, 0.3);
  letter-spacing: 1rpx;
  text-align: center;
  transition: border-color 0.2s, background 0.2s;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bottom-bar-btn::after {
  border: none;
}

.bottom-bar-btn:active {
  border-color: rgba(244, 212, 140, 0.6);
  background: rgba(244, 212, 140, 0.06);
}

/* ---- Secondary exit link (below the action row) ---- */
.bottom-back {
  display: flex;
  justify-content: center;
  padding: 8rpx 0 var(--spacing-lg, 32rpx);
}

.bottom-back-link {
  font-size: var(--font-size-caption, 24rpx);
  color: var(--color-lavender, #B8A9E0);
  letter-spacing: 3rpx;
  opacity: 0.65;
  padding: 12rpx 40rpx;
  transition: opacity 0.2s, color 0.2s;
}

.bottom-back-link:active {
  opacity: 1;
  color: var(--color-gold, #F4D48C);
}

/* ============================================================
   PERSONA FIRST SECTION — Styles for reading page
   ============================================================ */
.persona-first-section {
  padding: var(--spacing-xl, 32rpx) 0;
}

.persona-first-section .selected-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: var(--spacing-lg, 28rpx);
}

.persona-first-label {
  display: block;
  font-size: var(--font-size-subhead, 32rpx);
  color: var(--color-gold, #F4D48C);
  font-weight: 600;
  text-align: center;
  letter-spacing: 3rpx;
  margin-bottom: var(--spacing-xs, 12rpx);
}

.persona-first-sub {
  display: block;
  font-size: var(--font-size-caption, 24rpx);
  color: var(--color-text-tertiary);
  text-align: center;
  letter-spacing: 2rpx;
  margin-bottom: var(--spacing-lg, 28rpx);
}

.persona-first-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-sm, 16rpx);
  margin-top: var(--spacing-lg, 28rpx);
}

.divider-persona {
  display: flex;
  justify-content: center;
  padding: var(--spacing-lg, 28rpx) 0;
}

.divider-persona-line {
  width: 120rpx;
  height: 1rpx;
  background: linear-gradient(to right, transparent, rgba(244, 212, 140, 0.2), transparent);
}

/* ============================================================
   ACCESSIBILITY: Reduced Motion
   ============================================================ */
@media (prefers-reduced-motion: reduce) {
  view, text, image, button, scroll-view, swiper, swiper-item, canvas {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}
