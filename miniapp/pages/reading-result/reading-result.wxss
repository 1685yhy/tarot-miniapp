/* ==============================
   柔光星辰 — Reading Result
   Cards as stars in the night sky
   Dark indigo + warm golden starlight
   ============================== */

/* ----- CSS Variables ----- */
page {
  --bg-deep: #0d0b1a;
  --bg-card: #161329;
  --bg-elevated: #201d3e;
  --gold: #d4af37;
  --gold-light: #f0d68a;
  --gold-glow: rgba(212, 175, 55, 0.35);
  --gold-dim: rgba(212, 175, 55, 0.15);
  --text-primary: #e8e4f0;
  --text-secondary: #b8b0d0;
  --text-dim: #7b7299;
  --text-gold: #e8c84a;
  --fs-caption: 22rpx;
  --fs-body-small: 24rpx;
  --fs-body: 28rpx;
  --fs-body-large: 32rpx;
  --space-xs: 6rpx;
  --space-sm: 12rpx;
  --space-md: 20rpx;
  --space-lg: 28rpx;
  --space-xl: 36rpx;
  --space-xxl: 48rpx;
  --space-xxxl: 64rpx;
  --radius-card: 24rpx;
  --radius-sm: 12rpx;
  --radius-round: 999rpx;
  font-family: system-ui, -apple-system, 'PingFang SC', 'Noto Sans SC', sans-serif;
  background: var(--bg-deep);
  color: var(--text-primary);
  font-size: var(--fs-body);
  line-height: 1.6;
  min-height: 100vh;
  overflow-x: hidden;
}

/* ==============================
   Star-field background
   ============================== */
.star-field {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
}

.star-particle {
  position: absolute;
  width: 4rpx;
  height: 4rpx;
  background: var(--gold-light);
  border-radius: 50%;
  box-shadow: 0 0 6rpx 2rpx var(--gold-glow);
  animation: starTwinkle 3s ease-in-out infinite alternate;
}

/* Standard stars */
.star-particle:nth-child(1) { top: 8%; left: 12%; animation-name: starTwinkle; }
.star-particle:nth-child(2) { top: 20%; left: 78%; width: 2rpx; height: 2rpx; animation-name: starTwinkleSlow; animation-delay: 0.4s; opacity: 0.5; }
.star-particle:nth-child(3) { top: 35%; left: 5%; width: 5rpx; height: 5rpx; animation-name: starTwinkleFast; animation-delay: 0.8s; }
.star-particle:nth-child(4) { top: 50%; left: 88%; animation-name: starTwinkleSlow; animation-delay: 1.2s; opacity: 0.7; }
.star-particle:nth-child(5) { top: 65%; left: 22%; width: 3rpx; height: 3rpx; animation-name: starTwinkle; animation-delay: 1.6s; }
.star-particle:nth-child(6) { top: 78%; left: 60%; animation-name: starTwinkleSlow; animation-delay: 2s; opacity: 0.5; }
.star-particle:nth-child(7) { top: 12%; left: 45%; width: 6rpx; height: 6rpx; animation-name: starTwinkleFast; animation-delay: 0.2s; }
.star-particle:nth-child(8) { top: 45%; left: 55%; width: 2rpx; height: 2rpx; animation-name: starTwinkle; animation-delay: 1s; }
.star-particle:nth-child(9) { top: 85%; left: 42%; animation-name: starTwinkleFast; animation-delay: 0.6s; }
.star-particle:nth-child(10) { top: 55%; left: 95%; width: 3rpx; height: 3rpx; animation-name: starTwinkleSlow; animation-delay: 1.8s; opacity: 0.4; }
.star-particle:nth-child(11) { top: 3%; left: 90%; width: 3rpx; height: 3rpx; animation-name: starTwinkle; animation-delay: 0.3s; }
.star-particle:nth-child(12) { top: 72%; left: 80%; width: 2rpx; height: 2rpx; animation-name: starTwinkleFast; animation-delay: 1.4s; opacity: 0.4; }
.star-particle:nth-child(13) { top: 30%; left: 70%; width: 4rpx; height: 4rpx; animation-name: starTwinkleSlow; animation-delay: 0.9s; }
.star-particle:nth-child(14) { top: 92%; left: 15%; animation-name: starTwinkle; animation-delay: 2.2s; opacity: 0.5; }
.star-particle:nth-child(15) { top: 15%; left: 55%; width: 3rpx; height: 3rpx; animation-name: starTwinkleFast; animation-delay: 0.1s; }

/* Three twinkle variants for organic depth */
@keyframes starTwinkle {
  0% { opacity: 0.2; transform: scale(0.8); }
  100% { opacity: 1; transform: scale(1.2); }
}

@keyframes starTwinkleSlow {
  0% { opacity: 0.12; transform: scale(0.6); }
  100% { opacity: 0.7; transform: scale(1.1); }
}

@keyframes starTwinkleFast {
  0% { opacity: 0.4; transform: scale(0.9); }
  50% { opacity: 1; transform: scale(1.3); }
  100% { opacity: 0.5; transform: scale(0.95); }
}

/* ==============================
   Orbs
   ============================== */
.orb-top {
  position: fixed;
  top: -200rpx;
  right: -150rpx;
  width: 500rpx;
  height: 500rpx;
  border-radius: 50%;
  background: radial-gradient(circle at center, rgba(212,175,55,0.12) 0%, transparent 70%);
  z-index: 0;
  pointer-events: none;
}

.orb-bottom {
  position: fixed;
  bottom: -250rpx;
  left: -180rpx;
  width: 600rpx;
  height: 600rpx;
  border-radius: 50%;
  background: radial-gradient(circle at center, rgba(100,80,180,0.10) 0%, transparent 70%);
  z-index: 0;
  pointer-events: none;
}

/* ==============================
   Page wrapper
   ============================== */
.page {
  position: relative;
  z-index: 1;
  padding: var(--space-xxl) var(--space-xl) 80rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ==============================
   Dramatic Reveal Animations

   Stagger cascade:
   1. Cards section fades in
   2. Individual cards rise + shimmer (0.3s / 0.6s / 0.9s)
   3. Cards settle into subtle float
   4. Interpretation text rises + fades in
   5. Section header underline extends
   6. Buttons bounce in
   ============================== */

/* -- Section entry (container fade + rise) -- */

.anim-fade-in-up-1 {
  animation: sectionRise 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
}
.anim-fade-in-up-2 {
  animation: sectionRise 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.4s both;
}
.anim-fade-in-up-3 {
  animation: sectionRise 0.3s cubic-bezier(0.22, 1, 0.36, 1) 0.8s both;
}

@keyframes sectionRise {
  0% { opacity: 0; transform: translateY(40rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

/* -- Card staggered rise + golden shimmer -- */

.card-enter {
  animation: cardRise 0.8s cubic-bezier(0.22, 1, 0.36, 1) both,
             cardShimmer 1.2s ease 0.3s forwards;
  position: relative;
  overflow: hidden;
}

.card-enter-0 { animation-delay: 0s, 0.3s; }
.card-enter-1 { animation-delay: 0.15s, 0.45s; }
.card-enter-2 { animation-delay: 0.3s, 0.6s; }
.card-enter-3 { animation-delay: 0.45s, 0.75s; }
.card-enter-4 { animation-delay: 0.6s, 0.9s; }
.card-enter-5 { animation-delay: 0.75s, 1.05s; }
.card-enter-6 { animation-delay: 0.9s, 1.2s; }
.card-enter-7 { animation-delay: 1.05s, 1.35s; }
.card-enter-8 { animation-delay: 1.2s, 1.5s; }
.card-enter-9 { animation-delay: 1.35s, 1.65s; }

@keyframes cardRise {
  0% { opacity: 0; transform: translateY(80rpx) scale(0.92); }
  60% { transform: translateY(-8rpx) scale(1.01); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes cardShimmer {
  0% { box-shadow: 0 0 10rpx rgba(212,175,55,0.06); }
  25% { box-shadow: 0 0 40rpx rgba(212,175,55,0.20), 0 0 80rpx rgba(212,175,55,0.08); }
  50% { box-shadow: 0 0 8rpx rgba(212,175,55,0.04); }
  75% { box-shadow: 0 0 30rpx rgba(212,175,55,0.15), 0 0 60rpx rgba(212,175,55,0.05); }
  100% { box-shadow: 0 0 10rpx rgba(212,175,55,0.06); }
}

/* Shimmer sweep overlay on cards */
.swiper-card-wrapper::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(
    105deg,
    transparent 20%,
    rgba(212, 175, 55, 0.15) 45%,
    rgba(240, 214, 138, 0.25) 50%,
    rgba(212, 175, 55, 0.15) 55%,
    transparent 80%
  );
  background-size: 200% 100%;
  animation: shimmerSweep 1.2s ease 0.3s forwards;
  pointer-events: none;
  border-radius: inherit;
}

@keyframes shimmerSweep {
  0% { background-position: 200% 0; opacity: 1; }
  60% { background-position: -80% 0; opacity: 1; }
  100% { background-position: -80% 0; opacity: 0; }
}

/* -- Floating animation after settling -- */

.card-enter .swiper-card-wrapper {
  animation: cardFloat 4s ease-in-out 1s infinite;
}

@keyframes cardFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-6rpx); }
}

/* ==============================
   Interpretation text animations
   ============================== */

/* First letter golden glow that fades */
.interpretation-section .interpretation-text::first-letter {
  animation: firstLetterGlow 2s ease 1.2s both;
}

@keyframes firstLetterGlow {
  0% { color: #f5e6a0; text-shadow: 0 0 20rpx rgba(212,175,55,0.8), 0 0 40rpx rgba(212,175,55,0.4); }
  50% { color: #f5e6a0; text-shadow: 0 0 20rpx rgba(212,175,55,0.8), 0 0 40rpx rgba(212,175,55,0.4); }
  100% { color: var(--gold); text-shadow: none; }
}

/* Section header golden underline that extends */
.section-header-underline {
  position: relative;
  display: inline-block !important;
  overflow: hidden;
  padding-bottom: 6rpx;
}

.section-header-underline::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  width: 0;
  height: 3rpx;
  background: linear-gradient(90deg, transparent, var(--gold), transparent);
  border-radius: 2rpx;
  animation: underlineExtend 1s cubic-bezier(0.22, 1, 0.36, 1) 0.7s both;
}

@keyframes underlineExtend {
  0% { width: 0; left: 50%; opacity: 0; }
  100% { width: 70%; left: 15%; opacity: 1; }
}

/* ==============================
   Button animations
   ============================== */

/* Bounce-in for action buttons */
.actions .btn-primary,
.actions .btn-secondary {
  animation: bounceIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}
.actions .btn-primary { animation-delay: 1s; }
.actions .btn-secondary { animation-delay: 1.12s; }
.actions .action-link:nth-child(1) { animation: bounceIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 1.25s both; }
.actions .action-link:nth-child(2) { animation: bounceIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 1.35s both; }

@keyframes bounceIn {
  0% { opacity: 0; transform: scale(0.5) translateY(20rpx); }
  50% { transform: scale(1.06) translateY(-4rpx); }
  75% { transform: scale(0.97); }
  100% { opacity: 1; transform: scale(1) translateY(0); }
}

/* "追问" glow pulse */
.btn-glow-pulse {
  animation: glowPulse 2.5s ease-in-out 1.5s infinite !important;
}

@keyframes glowPulse {
  0%, 100% {
    box-shadow: 0 4rpx 24rpx var(--gold-glow);
  }
  50% {
    box-shadow: 0 4rpx 48rpx rgba(212, 175, 55, 0.55),
                0 0 80rpx rgba(212, 175, 55, 0.15);
  }
}

/* "分享" lavender shimmer */
.btn-lavender-shimmer {
  position: relative;
  overflow: hidden;
  border-color: rgba(180, 160, 220, 0.25) !important;
}

.btn-lavender-shimmer::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(180, 160, 220, 0.10) 30%,
    rgba(200, 180, 240, 0.18) 50%,
    rgba(180, 160, 220, 0.10) 70%,
    transparent 100%
  );
  background-size: 200% 100%;
  animation: lavenderShimmer 3s ease-in-out 2.5s infinite;
  pointer-events: none;
  border-radius: inherit;
}

@keyframes lavenderShimmer {
  0% { background-position: -200% 0; opacity: 0.3; }
  50% { background-position: 100% 0; opacity: 0.9; }
  100% { background-position: 300% 0; opacity: 0.3; }
}

/* ==============================
   Typography helpers
   ============================== */
.text-center { text-align: center; }
.text-secondary { color: var(--text-secondary); }
.text-dim { color: var(--text-dim); }
.text-gold { color: var(--text-gold); }
.text-caption { font-size: var(--fs-caption); }

.mt-xs { margin-top: var(--space-xs); }
.mt-sm { margin-top: var(--space-sm); }
.mt-md { margin-top: var(--space-md); }
.mb-md { margin-bottom: var(--space-md); }
.mb-xxl { margin-bottom: var(--space-xxl); }

/* ==============================
   Loading page — mystic
   ============================== */
.loading-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  position: relative;
  z-index: 1;
}

.mystic-loading {
  text-align: center;
  padding: var(--space-xl);
}

.mystic-loading-symbol {
  font-size: 72rpx;
  color: var(--gold);
  display: block;
  margin-bottom: var(--space-lg);
  animation: rotateSymbol 3s ease-in-out infinite;
}

@keyframes rotateSymbol {
  0% { transform: rotate(0deg) scale(1); opacity: 0.6; }
  50% { transform: rotate(180deg) scale(1.15); opacity: 1; }
  100% { transform: rotate(360deg) scale(1); opacity: 0.6; }
}

.mystic-loading-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: var(--space-xs);
}

.mystic-loading-sub {
  font-size: var(--fs-body-small);
  color: var(--text-dim);
  display: block;
}

/* Loading stages */
.loading-stages {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: var(--space-xxxl);
}

.stage-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  opacity: 0.25;
  transition: opacity 0.5s ease;
}

.stage-item.stage-done {
  opacity: 1;
}

.stage-icon {
  font-size: 24rpx;
}

.stage-text {
  font-size: var(--fs-caption);
  color: var(--text-secondary);
  white-space: nowrap;
}

.stage-arrow {
  font-size: 20rpx;
  color: var(--gold-dim);
  margin-top: -20rpx;
}

/* ==============================
   Error state
   ============================== */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx var(--space-xl);
  text-align: center;
  position: relative;
  z-index: 1;
}

.error-icon {
  font-size: 72rpx;
  margin-bottom: var(--space-lg);
  display: block;
}

.error-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: var(--space-sm);
  display: block;
}

.error-hint {
  font-size: var(--fs-body-small);
  color: var(--text-dim);
  margin-bottom: var(--space-xxl);
  display: block;
  word-break: break-all;
}

/* Buttons */
.btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-sm);
  padding: 20rpx 48rpx;
  border: none;
  border-radius: var(--radius-round);
  font-size: var(--fs-body);
  font-weight: 600;
  color: #0d0b1a;
  background: linear-gradient(135deg, var(--gold-light), var(--gold));
  box-shadow: 0 4rpx 24rpx var(--gold-glow);
  transition: all 0.25s;
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  transform: scale(0.96);
}

.btn-small {
  padding: 16rpx 36rpx;
  font-size: var(--fs-body-small);
}

.btn-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-sm);
  width: 100%;
  padding: 22rpx 0;
  border: 1.5rpx solid var(--gold-dim);
  border-radius: var(--radius-round);
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--gold-light);
  background: transparent;
  transition: all 0.25s;
}

.btn-secondary::after {
  border: none;
}

.btn-secondary:active {
  background: rgba(212,175,55,0.08);
  border-color: var(--gold);
}

/* ==============================
   Cards section — night sky
   ============================== */
.cards-section {
  margin-bottom: var(--space-xxl);
  position: relative;
  border-radius: var(--radius-card);
  padding: var(--space-xl) var(--space-md);
  background: var(--bg-card);
  border: 1.5rpx solid var(--gold-dim);
  box-shadow: 0 0 40rpx rgba(212,175,55,0.06), inset 0 0 60rpx rgba(212,175,55,0.03);
}

.card-swiper {
  height: 480rpx;
}

.swiper-card-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  position: relative;
}

/* Swiper indicator overrides */
.card-swiper .wx-swiper-dots {
  margin-top: 8rpx;
}

/* ==============================
   Dot navigation
   ============================== */
.dots {
  display: flex;
  justify-content: center;
  gap: 10rpx;
  margin-top: var(--space-md);
}

.dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: rgba(212,175,55,0.15);
  transition: all 0.35s;
}

.dot-active {
  background: var(--gold);
  width: 28rpx;
  border-radius: var(--radius-round);
  box-shadow: 0 0 12rpx var(--gold-glow);
}

/* ==============================
   Interpretation — starlight reading
   ============================== */
.interpretation-section {
  margin-bottom: var(--space-xxl);
}

.interpretation-scroll {
  max-height: 600rpx;
  overflow: hidden;
  position: relative;
  background: var(--bg-card);
  border-radius: var(--radius-card);
  border: 1.5rpx solid var(--gold-dim);
  padding: var(--space-lg) var(--space-xl);
  box-shadow: 0 0 30rpx rgba(212,175,55,0.05);
}

.interpretation-scroll.expanded {
  max-height: none;
  overflow: visible;
}

/* Gradient fade at bottom when collapsed */
.interpretation-scroll:not(.expanded)::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 80rpx;
  background: linear-gradient(transparent, var(--bg-card));
  pointer-events: none;
}

.interpretation-text {
  font-size: var(--fs-body);
  color: var(--text-primary);
  line-height: 1.9;
  white-space: pre-wrap;
  display: block;
  text-align: justify;
}

.interpretation-text::first-letter {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--gold);
  float: left;
  margin-right: 6rpx;
  line-height: 1;
}

.interpretation-card {
  text-align: center;
  padding: var(--space-xl);
  background: var(--bg-card);
  border-radius: var(--radius-card);
  border: 1.5rpx solid var(--gold-dim);
}

/* ==============================
   Actions
   ============================== */
.actions {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  padding-top: var(--space-lg);
  border-top: 1rpx solid var(--gold-dim);
}

.action-row {
  display: flex;
  justify-content: center;
  gap: var(--space-xxxl);
  margin-top: var(--space-xs);
}

.action-link {
  font-size: var(--fs-body-small);
  color: var(--text-dim);
  cursor: pointer;
  transition: color 0.2s;
}

.action-link:active {
  color: var(--gold);
}

/* ==============================
   Expand/collapse toggle
   ============================== */
.btn-text {
  font-size: var(--fs-body);
  color: var(--text-dim);
  cursor: pointer;
  transition: color 0.2s;
  padding: var(--space-sm) 0;
}

.btn-text:active {
  color: var(--gold);
}

/* ==============================
   Scrollbar hidden
   ============================== */
::-webkit-scrollbar {
  width: 0;
  height: 0;
}
