/* ===== 占卜结果页 · 温暖星光解读 ===== */

/* -------- 全局装饰 ------- */
@keyframes shimmer-soft {
  0%, 100% { opacity: 0.5; }
  50%      { opacity: 0.8; }
}

/* -------- 已抽卡牌 · 温暖台面 -------- */
.cards-section {
  margin-bottom: var(--space-xxl);
  position: relative;
  border-radius: 24rpx;
  padding: var(--space-xl) var(--space-md);
  background: linear-gradient(
    160deg,
    #fdf5f0 0%,
    #fcf0ea 30%,
    #faece5 60%,
    #fbf3ee 100%
  );
  box-shadow:
    0 2rpx 12rpx rgba(180, 130, 120, 0.06),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.7);
  border: 1rpx solid rgba(200, 160, 150, 0.1);
}

.card-swiper {
  height: 520rpx;
}

.swiper-card-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  transition: transform var(--duration-normal) var(--ease-out);
}

.drawn-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  background: #ffffff;
  border-radius: 22rpx;
  margin: 0 var(--space-lg);
  padding: var(--space-xxl);
  box-sizing: border-box;
  box-shadow:
    0 6rpx 28rpx rgba(160, 120, 115, 0.1),
    0 2rpx 8rpx rgba(160, 120, 115, 0.06);
  border: 1rpx solid rgba(200, 160, 150, 0.06);
  transition: all 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  position: relative;
}

.card-name {
  font-size: var(--fs-body-large);
  font-weight: var(--fw-bold);
  color: #4a3535;
  letter-spacing: 2rpx;
  position: relative;
  z-index: 1;
}

.card-suit {
  font-size: var(--fs-caption);
  color: rgba(160, 120, 125, 0.5);
  letter-spacing: 2rpx;
  margin-top: 6rpx;
  position: relative;
  z-index: 1;
}

.reversed-indicator {
  margin-top: var(--space-sm);
  font-size: 20rpx;
  color: rgba(160, 120, 155, 0.45);
  letter-spacing: 3rpx;
  position: relative;
  z-index: 1;
}

.drawn-card.reversed {
  background: #fcf8fa;
  box-shadow:
    0 6rpx 28rpx rgba(150, 110, 130, 0.08),
    0 2rpx 8rpx rgba(150, 110, 130, 0.04);
  border-color: rgba(180, 140, 160, 0.08);
}

/* -------- 加载阶段指示器 -------- */
.loading-stages {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-top: var(--space-xxl);
  padding: 0 var(--space-lg);
}

.stage-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  opacity: 0.3;
  transition: opacity 0.5s ease;
}

.stage-item.stage-done {
  opacity: 1;
}

.stage-icon {
  font-size: 28rpx;
}

.stage-text {
  font-size: var(--fs-caption, 20rpx);
  color: rgba(140, 110, 115, 0.55);
  white-space: nowrap;
  letter-spacing: 1rpx;
}

.stage-arrow {
  font-size: 24rpx;
  color: rgba(180, 140, 145, 0.2);
  margin-top: -24rpx;
}

/* -------- 解读区 -------- */
.interpretation-section {
  margin-bottom: var(--space-xxl);
  position: relative;
}

/* Section divider */
.interpretation-section::before {
  content: '';
  display: block;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(200, 150, 155, 0.2), transparent);
  margin-bottom: var(--space-lg);
}

/* AI label — 星光解读 */
.ai-label {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: #c8889a;
  letter-spacing: 2rpx;
  margin-bottom: var(--space-md);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  background: rgba(210, 140, 155, 0.06);
}

/* The interpretation scrollable container */
.interpretation-scroll {
  max-height: 600rpx;
  overflow: hidden;
  position: relative;
  background: #fefafa;
  border-radius: 18rpx;
  border: 1rpx solid rgba(200, 160, 165, 0.08);
  padding: var(--space-lg) var(--space-xxl);
  box-shadow: inset 0 0 20rpx rgba(180, 130, 130, 0.03);
}

.interpretation-scroll.expanded {
  max-height: none;
  overflow: visible;
}

/* Gradient fade at bottom when collapsed */
.interpretation-scroll:not(.expanded)::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: linear-gradient(transparent, #fefafa);
  pointer-events: none;
}

/* The actual text block */
.interpretation-text {
  font-size: var(--fs-body);
  color: #4a3a3a;
  line-height: 2;
  white-space: pre-wrap;
  letter-spacing: 1.5rpx;
  display: block;
  text-align: justify;
  font-feature-settings: 'kern' 1, 'liga' 1;
}

/* Drop cap */
.interpretation-text::first-letter {
  font-size: 56rpx;
  font-weight: 600;
  color: #c8889a;
  float: left;
  margin-right: 8rpx;
  margin-top: 4rpx;
  line-height: 1;
  font-family: serif;
}

/* Paragraph spacing */
.interpretation-text p,
.interpretation-text div:not(:last-child) {
  margin-bottom: var(--space-md);
  padding-bottom: var(--space-sm);
  position: relative;
}

/* Thin rose divider between paragraphs */
.interpretation-text p::after,
.interpretation-text > div:not(:last-child)::after {
  content: '';
  display: block;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(200, 150, 155, 0.12), transparent);
  margin-top: var(--space-md);
}

/* Error / empty state in interpretation */
.interpretation-card {
  text-align: center;
  padding: var(--space-xxl);
  color: rgba(120, 90, 95, 0.45);
  font-style: italic;
  letter-spacing: 1rpx;
}

/* -------- 操作按钮区 -------- */
.actions {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  position: relative;
}

/* Thin sage divider above actions */
.actions::before {
  content: '';
  display: block;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(150, 185, 145, 0.2), transparent);
  margin-bottom: var(--space-md);
}

.action-row {
  display: flex;
  justify-content: center;
  gap: var(--space-huge);
  margin-top: var(--space-xs);
}

/* Soft rose outline buttons */
.btn-outline-rose {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-md) var(--space-xxl);
  border-radius: 40rpx;
  font-size: var(--fs-body);
  color: #c8889a;
  background: #ffffff;
  border: 1rpx solid rgba(200, 140, 155, 0.2);
  letter-spacing: 2rpx;
  transition: all 0.3s ease;
  box-shadow: 0 2rpx 8rpx rgba(200, 130, 140, 0.04);
}

.btn-outline-rose:active {
  background: rgba(210, 140, 155, 0.04);
  border-color: rgba(200, 140, 155, 0.35);
}

/* -------- 加载页 -------- */
.loading-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  background: linear-gradient(180deg, #fef8f5, #fcf0ea);
}

.loading-animation {
  margin-bottom: var(--space-xxl);
  position: relative;
}

/* -------- 错误状态 -------- */
.error-state {
  text-align: center;
  padding: var(--space-massive) var(--space-xl);
}

.error-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: var(--space-md);
  opacity: 0.35;
}

.error-text {
  font-size: var(--fs-body);
  color: rgba(120, 90, 95, 0.5);
  display: block;
  margin-bottom: var(--space-xs);
  letter-spacing: 1rpx;
}

.error-hint {
  font-size: var(--fs-body-small);
  color: rgba(120, 90, 95, 0.3);
  display: block;
  margin-bottom: var(--space-xxl);
  font-style: italic;
}

/* -------- '展开全文' 按钮 -------- */
.expand-btn {
  display: block;
  width: 100%;
  text-align: center;
  padding: var(--space-sm) 0;
  font-size: var(--fs-body-small);
  color: rgba(180, 130, 140, 0.5);
  letter-spacing: 2rpx;
  position: relative;
  background: none;
  border: none;
  transition: color 0.3s;
}

.expand-btn:active {
  color: rgba(200, 130, 140, 0.75);
}
