/* ================================================================
   Tarot Reading Result — "A Personal Letter from the Cosmos"
   Theme: Starlight (deep indigo, warm gold, intimate prose)
   Palette:
     #1A1A3E — cosmic night / page background
     #252550 — card surface (dark indigo)
     #F4D48C — warm gold (accent, light, emphasis)
     #D4B06A — deeper gold (gradient stop)
     #B8A9E0 — lavender (secondary, link, soft)
     #F0EDE8 — warm cream (body text)
     #6B6599 — muted lavender (tertiary, subtle)
   ================================================================ */

/* ===== 0. Page Base ===== */
.page {
  min-height: 100vh;
  background: #1A1A3E;
  display: flex;
  flex-direction: column;
}

.content-scroll {
  height: 100vh;
}

.inner-wrap {
  padding: 64rpx 40rpx 100rpx;
  box-sizing: border-box;
}

/* ================================================================
   LOADING STATE — 3-Stage Anticipation
   ================================================================ */
.loading-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
}

/* ---- Stage Container (fade-in entry) ---- */
.stage {
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: stage-enter 0.5s ease both;
}

@keyframes stage-enter {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ---- Stage Icons Base ---- */
.stage-title {
  font-size: 34rpx;
  color: #F4D48C;
  font-weight: 500;
  margin-bottom: 12rpx;
  letter-spacing: 3rpx;
}

.stage-sub {
  font-size: 24rpx;
  color: #B8A9E0;
  letter-spacing: 4rpx;
  opacity: 0.7;
}

/* ================================================================
   STAGE 1 — Shuffle Icon
   Two cards sliding past each other
   ================================================================ */
.shuffle-icon {
  width: 140rpx;
  height: 100rpx;
  position: relative;
  margin-bottom: 48rpx;
}

.card-shuffle {
  position: absolute;
  width: 64rpx;
  height: 90rpx;
  border: 1.5rpx solid rgba(244, 212, 140, 0.35);
  border-radius: 8rpx;
  background: rgba(37, 37, 80, 0.4);
  top: 5rpx;
}

.card-left {
  left: 6rpx;
  animation: shuffle-left 0.7s ease-in-out infinite alternate;
}

.card-right {
  right: 6rpx;
  animation: shuffle-right 0.7s ease-in-out infinite alternate;
}

@keyframes shuffle-left {
  0% {
    transform: translateX(0) rotate(0deg);
  }
  100% {
    transform: translateX(36rpx) rotate(-6deg);
    border-color: rgba(244, 212, 140, 0.6);
  }
}

@keyframes shuffle-right {
  0% {
    transform: translateX(0) rotate(0deg);
  }
  100% {
    transform: translateX(-36rpx) rotate(6deg);
    border-color: rgba(244, 212, 140, 0.6);
  }
}

/* ================================================================
   STAGE 2 — Flip Icon
   A card rotating on its Y axis (3D flip)
   ================================================================ */
.flip-icon {
  width: 80rpx;
  height: 112rpx;
  perspective: 500rpx;
  margin-bottom: 48rpx;
}

.card-flip-inner {
  width: 100%;
  height: 100%;
  border: 1.5rpx solid rgba(244, 212, 140, 0.35);
  border-radius: 8rpx;
  background: rgba(37, 37, 80, 0.4);
  animation: card-flip 1.5s ease-in-out infinite;
}

@keyframes card-flip {
  0% {
    transform: rotateY(0deg);
    border-color: rgba(244, 212, 140, 0.35);
  }
  25% {
    border-color: rgba(244, 212, 140, 0.7);
  }
  50% {
    transform: rotateY(180deg);
    border-color: rgba(244, 212, 140, 0.9);
    background: rgba(37, 37, 80, 0.7);
  }
  75% {
    border-color: rgba(244, 212, 140, 0.7);
  }
  100% {
    transform: rotateY(360deg);
    border-color: rgba(244, 212, 140, 0.35);
  }
}

/* ================================================================
   STAGE 3 — Candle / Starlight + Progress Dots
   ================================================================ */

/* Flame-inspired spinner (reused from original) */
.loading-candle {
  width: 6rpx;
  height: 80rpx;
  background: linear-gradient(to top, rgba(244, 212, 140, 0.15), rgba(244, 212, 140, 0.4));
  border-radius: 3rpx;
  position: relative;
  margin-bottom: 48rpx;
}

.candle-flame {
  position: absolute;
  top: -20rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 20rpx;
  height: 40rpx;
  background: radial-gradient(
    ellipse at center top,
    rgba(255, 235, 190, 1) 0%,
    rgba(244, 212, 140, 0.6) 40%,
    rgba(244, 212, 140, 0) 80%
  );
  border-radius: 50%;
  animation: flame-dance 1.6s ease-in-out infinite alternate;
}

@keyframes flame-dance {
  0% {
    transform: translateX(-50%) scaleY(1) scaleX(1);
    opacity: 0.7;
  }
  50% {
    transform: translateX(-50%) scaleY(1.2) scaleX(0.85);
    opacity: 1;
  }
  100% {
    transform: translateX(-50%) scaleY(0.9) scaleX(1.1);
    opacity: 0.8;
  }
}

/* ---- Progress Step Indicator: 3 dots ---- */
.dot-row {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
  margin-bottom: 16rpx;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: rgba(37, 37, 80, 0.6);
  border: 1.5rpx solid rgba(244, 212, 140, 0.3);
  transition: background 0.6s ease, box-shadow 0.6s ease, border-color 0.6s ease;
}

.dot.lit {
  background: #F4D48C;
  border-color: #F4D48C;
  box-shadow: 0 0 14rpx rgba(244, 212, 140, 0.5);
}

/* ---- Dynamic Status Text ---- */
.stage-time {
  font-size: 22rpx;
  color: #B8A9E0;
  letter-spacing: 2rpx;
  opacity: 0.6;
  margin-top: 8rpx;
}

/* ================================================================
   STAGE 3 — Wait Timeout Options
   ================================================================ */
.wait-options {
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: stage-enter 0.4s ease both;
}

.wait-hint {
  font-size: 24rpx;
  color: #B8A9E0;
  letter-spacing: 2rpx;
  opacity: 0.7;
  margin-bottom: 28rpx;
  text-align: center;
  line-height: 1.5;
}

.wait-btns {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.btn-wait-yes {
  background: rgba(244, 212, 140, 0.12);
  color: #F4D48C;
  border: 1rpx solid rgba(244, 212, 140, 0.25);
  border-radius: 48rpx;
  padding: 18rpx 56rpx;
  font-size: 26rpx;
  letter-spacing: 3rpx;
  font-weight: 500;
  transition: background 0.2s;
}

.btn-wait-yes::after {
  border: none;
}

.btn-wait-yes:active {
  background: rgba(244, 212, 140, 0.22);
}

.btn-wait-no {
  font-size: 22rpx;
  color: #6B6599;
  letter-spacing: 2rpx;
  opacity: 0.55;
  padding: 12rpx 40rpx;
  transition: opacity 0.2s;
}

.btn-wait-no:active {
  opacity: 0.85;
}

/* ================================================================
   ERROR / EMPTY STATE
   ================================================================ */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  padding: 0 48rpx;
}

.error-text {
  font-size: 30rpx;
  color: #F0EDE8;
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
}

.error-hint {
  font-size: 24rpx;
  color: #B8A9E0;
  margin-bottom: 44rpx;
  letter-spacing: 1rpx;
}

.btn-retry {
  background: rgba(244, 212, 140, 0.12);
  color: #F4D48C;
  border: 1rpx solid rgba(244, 212, 140, 0.25);
  border-radius: 48rpx;
  padding: 20rpx 56rpx;
  font-size: 28rpx;
  letter-spacing: 2rpx;
  font-weight: 500;
}

.btn-retry::after {
  border: none;
}

/* ================================================================
   1. CARD REVEAL — Three-card spread
   ================================================================ */
.card-reveal {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 16rpx;
  padding-top: 24rpx;
}

/* Warm gold glow behind the center card */
.center-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 320rpx;
  height: 320rpx;
  background: radial-gradient(
    circle,
    rgba(244, 212, 140, 0.10) 0%,
    rgba(244, 212, 140, 0.04) 40%,
    transparent 70%
  );
  pointer-events: none;
}

/* ---- Card Row (horizontal spread) ---- */
.card-row {
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
  z-index: 1;
}

/* ---- Individual Card (image-based layout) ---- */
.card-item {
  flex-shrink: 0;
  width: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  transition: transform 0.2s ease;
}

/* Overlap: every card after the first slides left */
.card-item + .card-item {
  margin-left: -16rpx;
}

/* Card stacking order: past (1), present (2, elevated), future (3) */
.card-item:nth-child(1) {
  z-index: 1;
}

.card-item:nth-child(2) {
  z-index: 3;
  transform: translateY(-14rpx);
}

.card-item:nth-child(3) {
  z-index: 1;
}

/* ---- Card Image ---- */
.card-img {
  width: 120rpx;
  height: 168rpx;
  border-radius: 10rpx;
  border: 2rpx solid rgba(244, 212, 140, 0.55);
  box-shadow:
    0 0 20rpx rgba(244, 212, 140, 0.12),
    0 4rpx 12rpx rgba(0, 0, 0, 0.3);
  background: #252550;
  display: block;
}

/* Center card image gets a stronger glow */
.card-item:nth-child(2) .card-img {
  border-color: rgba(244, 212, 140, 0.8);
  box-shadow:
    0 0 28rpx rgba(244, 212, 140, 0.25),
    0 0 12rpx rgba(244, 212, 140, 0.10),
    0 4rpx 16rpx rgba(0, 0, 0, 0.3);
}

/* ---- Card Content ---- */
.card-inner {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.card-pos {
  display: block;
  font-size: 20rpx;
  color: #F4D48C;
  letter-spacing: 4rpx;
  font-weight: 500;
  opacity: 0.75;
  margin-bottom: 10rpx;
  white-space: nowrap;
}

.card-name {
  display: block;
  font-size: 24rpx;
  color: #F4D48C;
  font-weight: 500;
  letter-spacing: 2rpx;
  line-height: 1.3;
  word-break: break-word;
  margin-top: 10rpx;
  max-width: 130rpx;
}

/* ---- Spread Type Label ---- */
.spread-type {
  display: block;
  margin-top: 32rpx;
  font-size: 20rpx;
  color: #B8A9E0;
  letter-spacing: 5rpx;
  font-weight: 400;
  opacity: 0.5;
}

/* ================================================================
   2. DIVIDER — Quiet, thin, centered gold line
   ================================================================ */
.divider {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0 36rpx;
}

.divider-line {
  width: 160rpx;
  height: 1rpx;
  background: linear-gradient(
    to right,
    transparent,
    rgba(244, 212, 140, 0.25),
    transparent
  );
}

/* ================================================================
   3. LETTER — The interpretation
   ================================================================ */
.letter-section {
  margin-bottom: 48rpx;
}

/* ---- Letter Body Container ---- */
.letter-body {
  background: rgba(37, 37, 80, 0.30);
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  position: relative;
  border: 1rpx solid rgba(244, 212, 140, 0.06);
  overflow: hidden;
  transition: max-height 0.4s ease;
}

/* Subtle top light wash */
.letter-body::before {
  content: '';
  position: absolute;
  top: 0;
  left: 32rpx;
  right: 32rpx;
  height: 1rpx;
  background: linear-gradient(
    to right,
    transparent,
    rgba(244, 212, 140, 0.12),
    transparent
  );
}

/* Collapsed: show first portion */
.letter-body.collapsed {
  max-height: 800rpx;
  overflow: hidden;
}

/* Expanded: full height */
.letter-body.expanded {
  max-height: none;
  overflow: visible;
}

/* ---- Letter Text ---- */
.letter-text {
  font-size: 28rpx;
  color: #F0EDE8;
  line-height: 1.9;
  letter-spacing: 1rpx;
  white-space: pre-wrap;
  word-break: break-word;
  display: block;
}

/* ---- Toggle ---- */
.letter-toggle {
  display: flex;
  justify-content: center;
  margin-top: 12rpx;
}

.toggle-btn {
  font-size: 24rpx;
  color: #B8A9E0;
  letter-spacing: 2rpx;
  opacity: 0.6;
  padding: 16rpx 40rpx;
}

.toggle-btn:active {
  opacity: 1;
}

/* ================================================================
   4. ACTIONS
   ================================================================ */
.actions-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding-top: 24rpx;
}

/* ---- Primary: "追问更多" gold pill ---- */
.btn-ask {
  width: 100%;
  background: linear-gradient(135deg, #F4D48C 0%, #D4B06A 100%);
  color: #1A1A3E;
  font-weight: 700;
  font-size: 30rpx;
  border-radius: 50rpx;
  padding: 28rpx 0;
  border: none;
  letter-spacing: 5rpx;
  box-shadow:
    0 6rpx 28rpx rgba(244, 212, 140, 0.25),
    0 2rpx 8rpx rgba(244, 212, 140, 0.12);
  transition: opacity 0.2s;
  position: relative;
  overflow: hidden;
}

.btn-ask::after {
  border: none;
}

.btn-ask:active {
  opacity: 0.85;
}

/* ---- Share: outlined gold pill (between primary and secondary) ---- */
.btn-share {
  width: 100%;
  background: transparent;
  color: #F4D48C;
  font-weight: 500;
  font-size: 28rpx;
  border-radius: 50rpx;
  padding: 24rpx 0;
  border: 1.5rpx solid rgba(244, 212, 140, 0.3);
  letter-spacing: 4rpx;
  transition: border-color 0.2s, background 0.2s;
}

.btn-share::after {
  border: none;
}

.btn-share:active {
  border-color: rgba(244, 212, 140, 0.6);
  background: rgba(244, 212, 140, 0.06);
}

/* ---- Secondary: "再来一次" outlined pill ---- */
.btn-redo {
  width: 100%;
  background: transparent;
  color: #F4D48C;
  font-weight: 500;
  font-size: 28rpx;
  border-radius: 50rpx;
  padding: 24rpx 0;
  border: 1.5rpx solid rgba(244, 212, 140, 0.3);
  letter-spacing: 4rpx;
  transition: border-color 0.2s, background 0.2s;
}

.btn-redo::after {
  border: none;
}

.btn-redo:active {
  border-color: rgba(244, 212, 140, 0.6);
  background: rgba(244, 212, 140, 0.06);
}

/* ---- Tertiary: "回到首页" lavender link ---- */
.btn-back {
  color: #6B6599;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  opacity: 0.55;
  padding: 20rpx 0 8rpx;
  display: block;
  text-align: center;
  transition: opacity 0.2s;
}

.btn-back:active {
  opacity: 0.85;
}

/* ---- Save reading link ---- */
.save-reading-wrap {
  display: flex;
  justify-content: center;
  padding-top: 8rpx;
}

.btn-save {
  font-size: 24rpx;
  color: #B8A9E0;
  letter-spacing: 2rpx;
  opacity: 0.55;
  padding: 16rpx 32rpx;
  transition: opacity 0.2s;
}

.btn-save:active {
  opacity: 0.9;
  color: #F4D48C;
}

.btn-saved {
  font-size: 24rpx;
  color: #F4D48C;
  letter-spacing: 2rpx;
  opacity: 0.6;
  padding: 16rpx 32rpx;
  transition: opacity 0.2s;
}

.btn-saved:active {
  opacity: 1;
}
