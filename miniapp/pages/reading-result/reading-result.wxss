/* ================================================================
   Tarot Reading Result — "A Personal Letter from the Cosmos"
   Theme: Starlight (deep indigo, warm gold, intimate prose)
   Palette:
     var(--color-bg) — cosmic night / page background
     var(--color-surface) — card surface (dark indigo)
     var(--color-gold) — warm gold (accent, light, emphasis)
     var(--color-gold-dark) — deeper gold (gradient stop)
     var(--color-lavender) — lavender (secondary, link, soft)
     var(--color-text-primary) — warm cream (body text)
     var(--color-text-tertiary) — muted lavender (tertiary, subtle)
   ================================================================ */

/* ===== 0. Page Base ===== */
.page {
  min-height: 100vh;
  background: var(--color-bg);
  display: flex;
  flex-direction: column;
}

.content-scroll {
  height: 100vh;
}

/* ================================================================
   UNDO BAR — Subtle, non-intrusive retract link at the bottom
   ================================================================ */
.undo-bar {
  display: flex;
  justify-content: center;
  padding: var(--spacing-md) 0 calc(env(safe-area-inset-bottom) + var(--spacing-lg));
  cursor: pointer;
  transition: opacity 0.2s;
}

.undo-bar:active {
  opacity: 0.6;
}

.undo-text {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  letter-spacing: 2rpx;
  padding: var(--spacing-sm) var(--spacing-xl);
  border: 1rpx solid rgba(160, 152, 192, 0.2);
  border-radius: var(--radius-pill);
  transition: all var(--duration-fast) var(--ease-out);
  display: inline-block;
}

.undo-text:active {
  border-color: rgba(160, 152, 192, 0.4);
  background: rgba(160, 152, 192, 0.05);
}

.inner-wrap {
  padding: var(--spacing-2xl) 40rpx 100rpx;
  box-sizing: border-box;
}

/* ================================================================
   LOADING STATE — 3-Stage Anticipation
   ================================================================ */
.loading-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
}

/* ---- Stage Container (fade-in entry) ---- */
.stage {
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: stage-enter 0.4s ease-out both;
}

@keyframes stage-enter {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ---- Stage Icons Base ---- */
.stage-title {
  font-size: var(--font-size-subhead);
  color: var(--color-gold);
  font-weight: 500;
  margin-bottom: 12rpx;
  letter-spacing: 3rpx;
}

.stage-sub {
  font-size: var(--font-size-caption);
  color: var(--color-lavender);
  letter-spacing: 4rpx;
  opacity: 0.7;
}

/* ================================================================
   STAGE 1 — Shuffle Icon
   Two cards sliding past each other
   ================================================================ */
.shuffle-icon {
  width: 140rpx;
  height: 100rpx;
  position: relative;
  margin-bottom: var(--spacing-xl);
}

.card-shuffle {
  position: absolute;
  width: 64rpx;
  height: 90rpx;
  border: 1.5rpx solid rgba(244, 212, 140, 0.35);
  border-radius: 8rpx;
  background: rgba(37, 37, 80, 0.4);
  top: 5rpx;
}

.card-left {
  left: 6rpx;
  animation: shuffle-left 0.7s ease-in-out infinite alternate;
}

.card-right {
  right: 6rpx;
  animation: shuffle-right 0.7s ease-in-out infinite alternate;
}

@keyframes shuffle-left {
  0% {
    transform: translateX(0) rotate(0deg);
  }
  100% {
    transform: translateX(36rpx) rotate(-6deg);
    border-color: rgba(244, 212, 140, 0.6);
  }
}

@keyframes shuffle-right {
  0% {
    transform: translateX(0) rotate(0deg);
  }
  100% {
    transform: translateX(-36rpx) rotate(6deg);
    border-color: rgba(244, 212, 140, 0.6);
  }
}

/* ================================================================
   STAGE 2 — Flip Icon
   A card rotating on its Y axis (3D flip)
   ================================================================ */
.flip-icon {
  width: 80rpx;
  height: 112rpx;
  perspective: 500rpx;
  margin-bottom: var(--spacing-xl);
}

.card-flip-inner {
  width: 100%;
  height: 100%;
  border: 1.5rpx solid rgba(244, 212, 140, 0.35);
  border-radius: 8rpx;
  background: rgba(37, 37, 80, 0.4);
  animation: card-flip 1.5s ease-in-out infinite;
}

@keyframes card-flip {
  0% {
    transform: rotateY(0deg);
    border-color: rgba(244, 212, 140, 0.35);
  }
  25% {
    border-color: rgba(244, 212, 140, 0.7);
  }
  50% {
    transform: rotateY(180deg);
    border-color: rgba(244, 212, 140, 0.9);
    background: rgba(37, 37, 80, 0.7);
  }
  75% {
    border-color: rgba(244, 212, 140, 0.7);
  }
  100% {
    transform: rotateY(360deg);
    border-color: rgba(244, 212, 140, 0.35);
  }
}

/* ================================================================
   STAGE 3 — Candle / Starlight + Progress Dots
   ================================================================ */

/* Flame-inspired spinner (reused from original) */
.loading-candle {
  width: 6rpx;
  height: 80rpx;
  background: linear-gradient(to top, rgba(244, 212, 140, 0.15), rgba(244, 212, 140, 0.4));
  border-radius: 3rpx;
  position: relative;
  margin-bottom: var(--spacing-xl);
}

.candle-flame {
  position: absolute;
  top: -20rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 20rpx;
  height: 40rpx;
  background: radial-gradient(
    ellipse at center top,
    rgba(255, 235, 190, 1) 0%,
    rgba(244, 212, 140, 0.6) 40%,
    rgba(244, 212, 140, 0) 80%
  );
  border-radius: 50%;
  animation: flame-dance 1.6s ease-in-out infinite alternate;
}

@keyframes flame-dance {
  0% {
    transform: translateX(-50%) scaleY(1) scaleX(1);
    opacity: 0.7;
  }
  50% {
    transform: translateX(-50%) scaleY(1.2) scaleX(0.85);
    opacity: 1;
  }
  100% {
    transform: translateX(-50%) scaleY(0.9) scaleX(1.1);
    opacity: 0.8;
  }
}

/* ---- Progress Step Indicator: 3 dots ---- */
.dot-row {
  display: flex;
  gap: var(--spacing-sm);
  margin-top: 28rpx;
  margin-bottom: 16rpx;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: rgba(37, 37, 80, 0.6);
  border: 1.5rpx solid rgba(244, 212, 140, 0.3);
  transition: background 0.2s ease-out, box-shadow 0.2s ease-out, border-color 0.2s ease-out;
}

.dot.lit {
  background: var(--color-gold);
  border-color: var(--color-gold);
  box-shadow: 0 0 14rpx rgba(244, 212, 140, 0.5);
}

/* ---- Dynamic Status Text ---- */
.stage-time {
  font-size: var(--font-size-caption);
  color: var(--color-lavender);
  letter-spacing: 2rpx;
  opacity: 0.6;
  margin-top: 8rpx;
}

/* ================================================================
   STAGE 3 — Wait Timeout Options
   ================================================================ */
.wait-options {
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: stage-enter 0.4s ease-out both;
}

.wait-hint {
  font-size: var(--font-size-caption);
  color: var(--color-lavender);
  letter-spacing: 2rpx;
  opacity: 0.7;
  margin-bottom: 28rpx;
  text-align: center;
  line-height: 1.5;
}

.wait-btns {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-sm);
}

.btn-wait-yes {
  background: rgba(244, 212, 140, 0.12);
  color: var(--color-gold);
  border: 1rpx solid rgba(244, 212, 140, 0.25);
  border-radius: var(--radius-pill);
  padding: var(--spacing-md) 56rpx;
  min-height: 88rpx;
  font-size: var(--font-size-caption);
  letter-spacing: 3rpx;
  font-weight: 500;
  transition: background 0.2s;
}

.btn-wait-yes::after {
  border: none;
}

.btn-wait-yes:active {
  background: rgba(244, 212, 140, 0.22);
}

.btn-wait-no {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  letter-spacing: 2rpx;
  padding: 24rpx 48rpx;
  border: 1rpx solid rgba(160, 152, 192, 0.2);
  border-radius: var(--radius-pill);
  display: inline-block;
  transition: opacity 0.2s, border-color 0.2s;
}

.btn-wait-no:active {
  opacity: 0.85;
  border-color: rgba(160, 152, 192, 0.4);
}

/* ================================================================
   ERROR / EMPTY STATE
   ================================================================ */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  padding: 0 var(--spacing-xl);
}

.error-text {
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
}

.error-hint {
  font-size: var(--font-size-caption);
  color: var(--color-lavender);
  margin-bottom: 44rpx;
  letter-spacing: 1rpx;
}

.btn-retry {
  background: rgba(244, 212, 140, 0.12);
  color: var(--color-gold);
  border: 1rpx solid rgba(244, 212, 140, 0.25);
  border-radius: var(--radius-pill);
  padding: var(--spacing-sm) 56rpx;
  font-size: var(--font-size-body);
  letter-spacing: 2rpx;
  font-weight: 500;
}

.btn-retry::after {
  border: none;
}

/* ================================================================
   1. CARD REVEAL — Three-card spread
   ================================================================ */
.card-reveal {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 16rpx;
  padding-top: 24rpx;
}

/* Warm gold glow behind the center card */
.center-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 320rpx;
  height: 320rpx;
  background: radial-gradient(
    circle,
    rgba(244, 212, 140, 0.10) 0%,
    rgba(244, 212, 140, 0.04) 40%,
    transparent 70%
  );
  pointer-events: none;
}

/* ---- Card Row (horizontal spread) ---- */
.card-row {
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
  z-index: 1;
}

/* ---- Individual Card (image-based layout) ---- */
.card-item {
  flex-shrink: 0;
  width: 160rpx;
  position: relative;
  transition: transform 0.2s ease-out;
}

/* Overlap: every card after the first slides left */
.card-item + .card-item {
  margin-left: -20rpx;
}

/* Card stacking order: past (1), present (2, elevated), future (3) */
.card-item:nth-child(1) {
  z-index: 1;
}

.card-item:nth-child(2) {
  z-index: 3;
  transform: translateY(-18rpx);
}

.card-item:nth-child(3) {
  z-index: 1;
}

/* ---- Card Image ---- */
.card-img {
  width: 160rpx;
  height: 224rpx;
  border-radius: var(--radius-sm);
  border: 2rpx solid rgba(244, 212, 140, 0.55);
  box-shadow:
    0 0 20rpx rgba(244, 212, 140, 0.12),
    0 4rpx 12rpx rgba(0, 0, 0, 0.3);
  background: var(--color-surface);
  display: block;
}

/* Center card image gets a stronger glow */
.card-item:nth-child(2) .card-img {
  border-color: rgba(244, 212, 140, 0.8);
  box-shadow:
    0 0 36rpx rgba(244, 212, 140, 0.30),
    0 0 16rpx rgba(244, 212, 140, 0.12),
    0 4rpx 20rpx rgba(0, 0, 0, 0.35);
}

/* ---- Card Inner (position relative for overlay) ---- */
.card-inner {
  position: relative;
  z-index: 1;
  border-radius: var(--radius-sm);
  overflow: hidden;
}

/* ---- Card Overlay (semi-transparent dark bg at bottom) ---- */
.card-label {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(26, 26, 62, 0.80);
  backdrop-filter: blur(2rpx);
  -webkit-backdrop-filter: blur(2rpx);
  padding: 8rpx 6rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.card-pos {
  display: block;
  font-size: var(--font-size-xs);
  color: var(--color-gold);
  letter-spacing: 3rpx;
  font-weight: 500;
  opacity: 0.88;
  white-space: nowrap;
  line-height: 1.4;
}

.card-name {
  display: block;
  font-size: var(--font-size-xs);
  color: var(--color-text-primary);
  font-weight: 500;
  letter-spacing: 1rpx;
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 144rpx;
  margin-top: 2rpx;
}

/* ---- Spread Type Label ---- */
.spread-type {
  display: block;
  margin-top: 32rpx;
  font-size: var(--font-size-xs);
  color: var(--color-lavender);
  letter-spacing: 5rpx;
  font-weight: 400;
  opacity: 0.5;
}

/* ================================================================
   2. DIVIDER — Quiet, thin, centered gold line
   ================================================================ */
.divider {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: var(--spacing-xl) 0 var(--spacing-lg);
}

.divider-line {
  width: 160rpx;
  height: 1rpx;
  background: linear-gradient(
    to right,
    transparent,
    rgba(244, 212, 140, 0.25),
    transparent
  );
}

/* ================================================================
   3. LETTER — The interpretation
   ================================================================ */
.letter-section {
  margin-bottom: var(--spacing-xl);
}

/* ---- Letter Body Container ---- */
.letter-body {
  background: rgba(37, 37, 80, 0.30);
  border-radius: var(--radius-md);
  padding: var(--spacing-xl) var(--spacing-lg);
  position: relative;
  border: 1rpx solid rgba(244, 212, 140, 0.06);
  overflow: hidden;
  transition: max-height 0.4s ease-out;
}

/* Subtle top light wash */
.letter-body::before {
  content: '';
  position: absolute;
  top: 0;
  left: 32rpx;
  right: 32rpx;
  height: 1rpx;
  background: linear-gradient(
    to right,
    transparent,
    rgba(244, 212, 140, 0.12),
    transparent
  );
}

/* Collapsed: show first portion */
.letter-body.collapsed {
  max-height: 800rpx;
  overflow: hidden;
}

/* Expanded: full height */
.letter-body.expanded {
  max-height: none;
  overflow: visible;
}

/* ---- Letter Text ---- */
.letter-text {
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  line-height: 1.9;
  letter-spacing: 1rpx;
  white-space: pre-wrap;
  word-break: break-word;
  display: block;
}

/* ---- Staggered Text Fade-In ---- */
@keyframes textFadeIn {
  0% { opacity: 0; transform: translateY(12rpx); }
  100% { opacity: 1; transform: translateY(0); }
}
.letter-text {
  animation: textFadeIn 0.4s ease-out both;
}
.letter-text:nth-child(1) { animation-delay: 0.05s; }
.letter-text:nth-child(2) { animation-delay: 0.1s; }
.letter-text:nth-child(3) { animation-delay: 0.15s; }
.letter-text:nth-child(4) { animation-delay: 0.2s; }
.letter-text:nth-child(5) { animation-delay: 0.25s; }
.letter-text:nth-child(6) { animation-delay: 0.3s; }
.letter-text:nth-child(7) { animation-delay: 0.35s; }
.letter-text:nth-child(8) { animation-delay: 0.4s; }
.letter-text:nth-child(9) { animation-delay: 0.45s; }
.letter-text:nth-child(10) { animation-delay: 0.5s; }

/* ---- Toggle ---- */
.letter-toggle {
  display: flex;
  justify-content: center;
  margin-top: 12rpx;
}

.toggle-btn {
  font-size: var(--font-size-caption);
  color: var(--color-lavender);
  letter-spacing: 2rpx;
  padding: var(--spacing-md) var(--spacing-xl);
  border: 1rpx solid rgba(180, 169, 224, 0.18);
  border-radius: var(--radius-pill);
  display: inline-block;
  transition: opacity 0.2s, border-color 0.2s, background 0.2s;
}

.toggle-btn:active {
  opacity: 1;
  border-color: rgba(180, 169, 224, 0.4);
  background: rgba(180, 169, 224, 0.05);
}

/* ================================================================
   4. ACTIONS
   ================================================================ */
.actions-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-sm);
  padding: var(--spacing-md) 0 calc(env(safe-area-inset-bottom) + var(--spacing-lg));
}

/* ---- Primary: "追问更多" gold pill ---- */
.btn-ask {
  width: 100%;
  background: linear-gradient(135deg, var(--color-gold) 0%, var(--color-gold-dark) 100%);
  color: var(--color-bg);
  font-weight: 700;
  font-size: var(--font-size-body);
  border-radius: var(--radius-pill);
  padding: var(--spacing-md) 0;
  border: none;
  letter-spacing: 5rpx;
  box-shadow:
    0 6rpx 28rpx rgba(244, 212, 140, 0.25),
    0 2rpx 8rpx rgba(244, 212, 140, 0.12);
  transition: opacity 0.2s;
  position: relative;
  overflow: hidden;
}

.btn-ask::after {
  border: none;
}

.btn-ask:active {
  opacity: 0.85;
}

/* ---- Share: outlined gold pill (between primary and secondary) ---- */
.btn-share {
  width: 100%;
  background: transparent;
  color: var(--color-gold);
  font-weight: 500;
  font-size: var(--font-size-body);
  border-radius: var(--radius-pill);
  padding: var(--spacing-md) 0;
  border: 1.5rpx solid rgba(244, 212, 140, 0.3);
  letter-spacing: 4rpx;
  transition: border-color 0.2s, background 0.2s;
}

.btn-share::after {
  border: none;
}

.btn-share:active {
  border-color: rgba(244, 212, 140, 0.6);
  background: rgba(244, 212, 140, 0.06);
}

/* ---- Secondary: "再来一次" outlined pill ---- */
.btn-redo {
  width: 100%;
  background: transparent;
  color: var(--color-gold);
  font-weight: 500;
  font-size: var(--font-size-body);
  border-radius: var(--radius-pill);
  padding: var(--spacing-md) 0;
  border: 1.5rpx solid rgba(244, 212, 140, 0.3);
  letter-spacing: 4rpx;
  transition: border-color 0.2s, background 0.2s;
}

.btn-redo::after {
  border: none;
}

.btn-redo:active {
  border-color: rgba(244, 212, 140, 0.6);
  background: rgba(244, 212, 140, 0.06);
}

/* ---- Tertiary: "回到首页" outlined pill ---- */
.btn-back {
  display: block;
  width: 100%;
  text-align: center;
  background: transparent;
  color: var(--color-text-secondary);
  font-size: var(--font-size-body);
  font-weight: 500;
  letter-spacing: 2rpx;
  border-radius: var(--radius-pill);
  padding: var(--spacing-md) 0;
  border: 1.5rpx solid rgba(160, 152, 192, 0.25);
  margin-top: 8rpx;
  transition: border-color 0.2s, background 0.2s, color 0.2s;
}

.btn-back::after { border: none; }

.btn-back:active {
  border-color: rgba(160, 152, 192, 0.55);
  background: rgba(160, 152, 192, 0.08);
  color: var(--color-text-primary);
}

/* ---- Save reading link with button styling ---- */
.save-reading-wrap {
  display: flex;
  justify-content: center;
  padding-top: 12rpx;
}

.btn-save {
  display: inline-block;
  font-size: var(--font-size-caption);
  color: var(--color-lavender);
  letter-spacing: 2rpx;
  opacity: 0.65;
  padding: var(--spacing-sm) var(--spacing-xl);
  border-radius: var(--radius-pill);
  border: 1rpx solid rgba(180, 169, 224, 0.2);
  transition: opacity 0.2s, border-color 0.2s, background 0.2s;
}

.btn-save::after { border: none; }

.btn-save:active {
  opacity: 1;
  color: var(--color-gold);
  border-color: rgba(244, 212, 140, 0.35);
  background: rgba(244, 212, 140, 0.06);
}

.btn-saved {
  display: inline-block;
  font-size: var(--font-size-caption);
  color: var(--color-gold);
  letter-spacing: 2rpx;
  opacity: 0.75;
  padding: var(--spacing-sm) var(--spacing-xl);
  border-radius: var(--radius-pill);
  border: 1rpx solid rgba(244, 212, 140, 0.3);
  transition: opacity 0.2s;
}

.btn-saved::after { border: none; }

.btn-saved:active {
  opacity: 1;
}

/* ================================================================
   5. INTERACTIVE CARD — Dimmed state for non-selected cards
   ================================================================ */
.card-item {
  cursor: pointer;
  transition: opacity 0.15s ease-out, transform 0.15s ease-out;
}

.card-item.dimmed {
  opacity: 0.2 !important;
  pointer-events: none;
}

/* ================================================================
   6. ENLARGED CARD OVERLAY — Full screen, dark backdrop
   ================================================================ */
.enlarged-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(10, 10, 30, 0.85);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(6rpx);
  -webkit-backdrop-filter: blur(6rpx);
}

.enlarged-overlay.active {
  animation: overlay-fade-in 0.3s ease-out;
}

.enlarged-overlay.exiting {
  animation: overlay-fade-out 0.3s ease-in;
  pointer-events: none;
}

@keyframes overlay-fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes overlay-fade-out {
  from { opacity: 1; }
  to { opacity: 0; }
}

/* ---- Enlarged Card Wrapper ---- */
.enlarged-card-wrap {
  width: 70vw;
  max-width: 500rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.enlarged-card-wrap.enter {
  animation: card-enter 0.3s ease-out;
}

.enlarged-card-wrap.exit {
  animation: card-exit 0.3s ease-in;
}

@keyframes card-enter {
  from {
    transform: scale(0.6) translateY(40rpx);
    opacity: 0;
  }
  to {
    transform: scale(1) translateY(0);
    opacity: 1;
  }
}

@keyframes card-exit {
  from {
    transform: scale(1) translateY(0);
    opacity: 1;
  }
  to {
    transform: scale(0.6) translateY(40rpx);
    opacity: 0;
  }
}

/* ---- The Enlarged Card Itself ---- */
.enlarged-card {
  width: 100%;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: var(--color-surface);
  border: 2rpx solid rgba(244, 212, 140, 0.6);
  box-shadow:
    0 0 60rpx rgba(244, 212, 140, 0.20),
    0 0 30rpx rgba(244, 212, 140, 0.08),
    0 8rpx 40rpx rgba(0, 0, 0, 0.5);
  cursor: pointer;
}

/* Flip animation stages */
.enlarged-card.flip-out {
  animation: flip-out 0.3s ease-out forwards;
}

.enlarged-card.flip-in {
  animation: flip-in 0.3s ease-out forwards;
}

@keyframes flip-out {
  0% { transform: scaleX(1); }
  100% { transform: scaleX(0); }
}

@keyframes flip-in {
  0% { transform: scaleX(0); }
  100% { transform: scaleX(1); }
}

/* ---- Front: card image ---- */
.enlarged-img {
  width: 100%;
  height: auto;
  aspect-ratio: 5 / 7;
  display: block;
}

/* ---- Back: card details ---- */
.enlarged-back {
  padding: var(--spacing-xl) var(--spacing-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 200rpx;
}

.back-position {
  font-size: var(--font-size-caption);
  color: var(--color-gold);
  letter-spacing: 4rpx;
  opacity: 0.7;
  margin-bottom: 12rpx;
}

.back-card-name {
  font-size: var(--font-size-subhead);
  color: var(--color-text-primary);
  font-weight: 600;
  letter-spacing: 2rpx;
  text-align: center;
  line-height: 1.3;
}

.back-divider {
  width: 80rpx;
  height: 1rpx;
  background: linear-gradient(to right, transparent, rgba(244, 212, 140, 0.3), transparent);
  margin: var(--spacing-md) 0;
}

.back-label {
  font-size: var(--font-size-xs);
  color: var(--color-lavender);
  letter-spacing: 3rpx;
  opacity: 0.6;
  margin-bottom: 8rpx;
}

.back-keywords {
  font-size: var(--font-size-caption);
  color: var(--color-text-primary);
  text-align: center;
  line-height: 1.6;
  letter-spacing: 1rpx;
  opacity: 0.85;
}

.back-desc {
  font-size: var(--font-size-caption);
  color: var(--color-text-primary);
  text-align: center;
  line-height: 1.7;
  letter-spacing: 1rpx;
  opacity: 0.75;
}

/* ---- Hint text below the enlarged card ---- */
.enlarged-hint {
  font-size: var(--font-size-caption);
  color: var(--color-lavender);
  letter-spacing: 2rpx;
  opacity: 0.4;
  margin-top: 32rpx;
}

/* ============================================================
   ONBOARDING HINT — Step 3 lightweight guidance
   ============================================================ */
.onboarding-hint {
  padding: 20rpx 28rpx;
  margin: 24rpx 0 8rpx;
  background: rgba(26, 26, 62, 0.95);
  border: 1.5rpx solid var(--color-gold, #F4D48C);
  border-radius: 16rpx;
  text-align: center;
  opacity: 0;
  transform: translateY(-8rpx);
  transition: opacity 0.3s ease, transform 0.3s ease;
  pointer-events: none;
}

.onboarding-hint.hint-visible {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.onboarding-hint .hint-text {
  display: block;
  font-size: var(--font-size-caption, 24rpx);
  color: #ffffff;
  line-height: 1.6;
  letter-spacing: 1rpx;
  opacity: 0.85;
}
