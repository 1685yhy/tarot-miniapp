/* ============================================
   Tarot Reading Result — Starlight Theme
   Colors: #1A1A3E bg | #F4D48C gold | #B8A9E0 lavender
           #252550 cards  | #F0EDE8 text
   ============================================ */

/* ---- Page Base ---- */
.page {
  min-height: 100vh;
  background: #1A1A3E;
  display: flex;
  flex-direction: column;
}

.content-scroll {
  height: 100vh;
}

.inner-wrap {
  padding: 56rpx 36rpx 80rpx;
  box-sizing: border-box;
}

/* ============================================
   Loading State
   ============================================ */
.loading-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 3rpx solid rgba(244, 212, 140, 0.12);
  border-top-color: #F4D48C;
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
  margin-bottom: 40rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-title {
  font-size: 36rpx;
  color: #F4D48C;
  font-weight: 600;
  margin-bottom: 16rpx;
  letter-spacing: 4rpx;
}

.loading-sub {
  font-size: 26rpx;
  color: #B8A9E0;
  letter-spacing: 2rpx;
}

/* ============================================
   Error / Empty State
   ============================================ */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  padding: 0 40rpx;
}

.error-text {
  font-size: 30rpx;
  color: #F0EDE8;
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
}

.error-hint {
  font-size: 24rpx;
  color: #B8A9E0;
  margin-bottom: 40rpx;
  letter-spacing: 1rpx;
}

.btn-retry {
  background: rgba(244, 212, 140, 0.15);
  color: #F4D48C;
  border: 1rpx solid rgba(244, 212, 140, 0.3);
  border-radius: 48rpx;
  padding: 20rpx 56rpx;
  font-size: 28rpx;
  letter-spacing: 2rpx;
  font-weight: 500;
}

.btn-retry::after {
  border: none;
}

/* ============================================
   Timeline — Cards Display
   ============================================ */
.timeline-section {
  position: relative;
  padding-left: 56rpx;
  margin-bottom: 64rpx;
}

/* Vertical gold line connecting all three cards */
.timeline-section::before {
  content: '';
  position: absolute;
  left: 24rpx;
  top: 28rpx;
  bottom: 28rpx;
  width: 2rpx;
  background: linear-gradient(
    to bottom,
    rgba(244, 212, 140, 0.6) 0%,
    rgba(244, 212, 140, 0.35) 50%,
    rgba(244, 212, 140, 0.1) 100%
  );
}

/* ---- Individual Card ---- */
.card-item {
  position: relative;
  margin-bottom: 32rpx;
}

.card-item:last-child {
  margin-bottom: 0;
}

/* Gold dot on the timeline */
.card-item::before {
  content: '';
  position: absolute;
  left: -44rpx;
  top: 36rpx;
  width: 12rpx;
  height: 12rpx;
  background: #F4D48C;
  border-radius: 50%;
  box-shadow:
    0 0 12rpx rgba(244, 212, 140, 0.5),
    0 0 24rpx rgba(244, 212, 140, 0.15);
  z-index: 2;
}

/* Card body — dark indigo with gold border */
.card-body {
  background: #252550;
  border-radius: 18rpx;
  padding: 32rpx 28rpx;
  border: 1rpx solid rgba(244, 212, 140, 0.2);
  position: relative;
  overflow: hidden;
}

/* Warm inner glow on left edge */
.card-glow-edge {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: linear-gradient(to bottom, #F4D48C, rgba(244, 212, 140, 0.2));
  border-radius: 18rpx 0 0 18rpx;
  opacity: 0.8;
}

/* Card content */
.card-content {
  position: relative;
  z-index: 1;
}

.card-pos {
  display: block;
  font-size: 22rpx;
  color: #B8A9E0;
  margin-bottom: 10rpx;
  letter-spacing: 3rpx;
  font-weight: 500;
}

.card-name {
  display: block;
  font-size: 36rpx;
  color: #F4D48C;
  font-weight: 600;
  letter-spacing: 2rpx;
}

/* ============================================
   Interpretation Section
   ============================================ */
.interp-section {
  margin-bottom: 48rpx;
}

/* ---- Clean Divider ---- */
.interp-divider {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 36rpx;
}

.interp-line {
  width: 120rpx;
  height: 1rpx;
  background: linear-gradient(
    to right,
    transparent,
    rgba(244, 212, 140, 0.5),
    transparent
  );
  margin-bottom: 14rpx;
}

.interp-label {
  font-size: 22rpx;
  color: #F4D48C;
  letter-spacing: 4rpx;
  font-weight: 500;
}

/* ---- Interpretation Body ---- */
.interp-body {
  background: rgba(37, 37, 80, 0.45);
  border-radius: 18rpx;
  padding: 36rpx 28rpx;
  position: relative;
  border: 1rpx solid rgba(244, 212, 140, 0.08);
}

/* Subtle top border highlight */
.interp-body::before {
  content: '';
  position: absolute;
  top: 0;
  left: 40rpx;
  right: 40rpx;
  height: 1rpx;
  background: linear-gradient(
    to right,
    transparent,
    rgba(244, 212, 140, 0.2),
    transparent
  );
}

/* ---- Interpretation Text ---- */
.interp-text {
  font-size: 28rpx;
  color: #F0EDE8;
  line-height: 1.8;
  letter-spacing: 1rpx;
  white-space: pre-wrap;
  word-break: break-word;
  display: block;
}

/* Gold drop-cap on the first character */
.interp-text::first-letter {
  font-size: 56rpx;
  color: #F4D48C;
  font-weight: 700;
  float: left;
  margin-right: 10rpx;
  margin-top: 8rpx;
  line-height: 1;
  font-family: "Georgia", "Noto Serif SC", serif;
  text-shadow: 0 0 20rpx rgba(244, 212, 140, 0.2);
}

/* ============================================
   Action Buttons
   ============================================ */
.actions-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  align-items: center;
  padding-top: 40rpx;
  border-top: 1rpx solid rgba(244, 212, 140, 0.1);
}

/* Primary: gold pill "追问更多" */
.btn-ask {
  width: 100%;
  background: linear-gradient(135deg, #F4D48C 0%, #D4B06A 100%);
  color: #1A1A3E;
  font-weight: 700;
  font-size: 30rpx;
  border-radius: 50rpx;
  padding: 26rpx 0;
  border: none;
  letter-spacing: 4rpx;
  box-shadow:
    0 8rpx 32rpx rgba(244, 212, 140, 0.3),
    0 2rpx 8rpx rgba(244, 212, 140, 0.15);
  transition: opacity 0.2s;
}

.btn-ask::after {
  border: none;
}

.btn-ask:active {
  opacity: 0.85;
}

/* Text link: lavender "再来一次" */
.btn-redo {
  color: #B8A9E0;
  font-size: 28rpx;
  letter-spacing: 3rpx;
  font-weight: 500;
  text-align: center;
  padding: 16rpx 0 8rpx;
  display: block;
  opacity: 0.8;
  background: none;
  border: none;
}

.btn-redo::after {
  border: none;
}

.btn-redo:active {
  opacity: 1;
}

/* Subtle secondary "回到首页" */
.btn-back {
  color: #6B6599;
  font-size: 24rpx;
  padding: 12rpx 0 8rpx;
  display: block;
  text-align: center;
  letter-spacing: 2rpx;
  opacity: 0.6;
}

.btn-back:active {
  opacity: 0.85;
}
