/* ============================================================
   Reading Result — Warm Paper Design System
   Warm ivory base, deep rose accent, sage subtle
   Card swiper, interpretation text, action buttons
   ============================================================ */

/* -----------------------------------------------------------
   1. PAGE LAYOUT
   ----------------------------------------------------------- */

.page {
  padding: var(--page-padding);
  padding-bottom: calc(var(--page-padding) + var(--safe-area-bottom));
  min-height: 100vh;
  position: relative;
  z-index: var(--z-base);
}

/* -----------------------------------------------------------
   2. TYPOGRAPHY HELPERS
   ----------------------------------------------------------- */

.text-center { text-align: center; }
.text-secondary { color: var(--color-text-secondary); }
.text-dim { color: var(--color-text-secondary); opacity: 0.70; }
.text-accent { color: var(--color-accent); }
.text-caption { font-size: var(--font-size-body); }

.mt-xs { margin-top: var(--spacing-3); }
.mt-sm { margin-top: var(--spacing-4); }
.mt-md { margin-top: var(--spacing-5); }
.mb-md { margin-bottom: var(--spacing-5); }
.mb-xxl { margin-bottom: var(--spacing-7); }

/* -----------------------------------------------------------
   3. ENTRANCE ANIMATIONS
   ----------------------------------------------------------- */

.anim-fade-in-up-1 { opacity: 0; animation: fade-up var(--duration-emphasis) ease 0s forwards; }
.anim-fade-in-up-2 { opacity: 0; animation: fade-up var(--duration-emphasis) ease 0.4s forwards; }
.anim-fade-in-up-3 { opacity: 0; animation: fade-up var(--duration-emphasis) ease 0.8s forwards; }

/* -----------------------------------------------------------
   4. LOADING PAGE
   ----------------------------------------------------------- */

.loading-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: var(--spacing-6);
  position: relative;
  z-index: var(--z-base);
}

.mystic-loading {
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-5);
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 2rpx solid rgba(139, 126, 110, 0.15);
  border-top-color: var(--color-accent);
  border-radius: var(--radius-pill);
  animation: spin var(--duration-emphasis) linear infinite;
}

.loading-shimmer-text {
  font-size: var(--font-size-subhead);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  letter-spacing: var(--letter-spacing-display);
}

.loading-sub-text {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
}

/* Progress dots */
.loading-progress-dots {
  display: flex;
  gap: var(--spacing-5);
  margin-top: var(--spacing-4);
}

.progress-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: var(--radius-pill);
  background: rgba(139, 126, 110, 0.15);
  transition: all var(--duration-navigation) ease;
}

.progress-dot.dot-lit {
  background: var(--color-accent);
  opacity: 1;
}

/* -----------------------------------------------------------
   5. CARDS SECTION
   ----------------------------------------------------------- */

.cards-section {
  margin-bottom: var(--spacing-7);
  position: relative;
  border-radius: var(--radius-medium);
  padding: var(--spacing-6) var(--spacing-4);
  background: var(--color-surface);
  border: 1rpx solid rgba(139, 126, 110, 0.12);
  box-shadow: var(--shadow-subtle);
}

.card-swiper-container {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  position: relative;
}

.card-swiper {
  height: 480rpx;
  flex: 1;
  min-width: 0;
}

.swiper-nav-arrow {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  opacity: 0.50;
  transition: opacity var(--duration-feedback) ease;
  z-index: var(--z-card);
}

.swiper-nav-arrow:active {
  opacity: 1;
}

.swiper-card-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  position: relative;
}

/* Dot navigation */
.dots {
  display: flex;
  justify-content: center;
  gap: var(--spacing-3);
  margin-top: var(--spacing-4);
}

.dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: var(--radius-pill);
  background: rgba(139, 126, 110, 0.15);
  transition: all var(--duration-navigation) ease;
}

.dot-active {
  background: var(--color-accent);
  width: 28rpx;
}

/* -----------------------------------------------------------
   6. INTERPRETATION SECTION
   ----------------------------------------------------------- */

.interpretation-section {
  margin-bottom: var(--spacing-7);
}

.interpretation-scroll {
  max-height: 600rpx;
  overflow: hidden;
  position: relative;
  background: var(--color-surface);
  border-radius: var(--radius-medium);
  border: 1rpx solid rgba(139, 126, 110, 0.12);
  padding: var(--spacing-5) var(--spacing-6);
  box-shadow: var(--shadow-subtle);
}

.interpretation-scroll.expanded {
  max-height: none;
  overflow: visible;
}

/* Gradient fade at bottom when collapsed */
.interpretation-scroll:not(.expanded)::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 80rpx;
  background: linear-gradient(transparent, var(--color-surface));
  pointer-events: none;
}

.interpretation-text {
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  line-height: var(--line-height-body);
  white-space: pre-wrap;
  display: block;
}

.interpretation-text::first-letter {
  font-size: var(--font-size-body-large);
  font-weight: var(--font-weight-bold);
  color: var(--color-accent);
}

.interpretation-card {
  text-align: center;
  padding: var(--spacing-6);
  background: var(--color-surface);
  border-radius: var(--radius-medium);
  border: 1rpx solid rgba(139, 126, 110, 0.12);
  box-shadow: var(--shadow-subtle);
}

/* -----------------------------------------------------------
   7. SECTION ORNAMENT HEADER
   ----------------------------------------------------------- */

.section-ornament-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-3);
  margin-bottom: var(--spacing-4);
}

.ornament-line {
  width: 48rpx;
  height: 1rpx;
  background: rgba(139, 126, 110, 0.20);
}

.ornament-diamond {
  width: 8rpx;
  height: 8rpx;
  background: var(--color-accent);
  transform: rotate(45deg);
  opacity: 0.60;
}

.section-label {
  display: block;
  text-align: center;
  margin-bottom: var(--spacing-4);
  font-size: var(--font-size-body);
  letter-spacing: var(--letter-spacing-none);
  color: var(--color-text-secondary);
}

/* -----------------------------------------------------------
   8. ACTIONS
   ----------------------------------------------------------- */

.actions {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-4);
  padding-top: var(--spacing-5);
  border-top: 1rpx solid rgba(139, 126, 110, 0.10);
}

.action-row {
  display: flex;
  justify-content: center;
  gap: var(--spacing-7);
  margin-top: var(--spacing-3);
}

.action-link {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  transition: color var(--duration-feedback) ease;
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
}

.action-link:active {
  color: var(--color-accent);
}

/* -----------------------------------------------------------
   9. BUTTONS
   ----------------------------------------------------------- */

.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-3);
  padding: var(--spacing-5) var(--spacing-7);
  border: none;
  border-radius: var(--radius-pill);
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-semibold);
  color: var(--color-surface);
  background: var(--color-accent);
  box-shadow: var(--shadow-subtle);
  transition: all var(--duration-feedback) ease;
}

.btn-primary:active {
  transform: scale(0.97);
  opacity: 0.90;
}

.btn-small {
  padding: var(--spacing-4) var(--spacing-6);
  font-size: var(--font-size-body);
}

.btn-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-3);
  width: 100%;
  padding: var(--spacing-5) 0;
  border: 1rpx solid rgba(176, 102, 80, 0.25);
  border-radius: var(--radius-pill);
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-semibold);
  color: var(--color-accent);
  background: transparent;
  transition: all var(--duration-feedback) ease;
}

.btn-secondary:active {
  background: rgba(176, 102, 80, 0.06);
  border-color: var(--color-accent);
}

.btn-glow-pulse {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-3);
  padding: var(--spacing-5) var(--spacing-7);
  border: none;
  border-radius: var(--radius-pill);
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-semibold);
  color: var(--color-surface);
  background: var(--color-accent);
  box-shadow: var(--shadow-subtle);
  transition: all var(--duration-feedback) ease;
}

.btn-glow-pulse:active {
  transform: scale(0.97);
  opacity: 0.90;
}

.btn-glow-pulse[disabled] {
  opacity: 0.30;
  box-shadow: none;
  pointer-events: none;
}

.btn-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.btn-toggle-text {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-2);
}

.toggle-arrow {
  font-size: var(--font-size-body);
  color: var(--color-accent);
  opacity: 0.60;
}

.link-icon {
  width: 24rpx;
  height: 24rpx;
  vertical-align: middle;
  margin-right: 4rpx;
}

.btn-text {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  transition: color var(--duration-feedback) ease;
  padding: var(--spacing-3) 0;
}

.btn-text:active {
  color: var(--color-accent);
}

/* -----------------------------------------------------------
   10. ERROR STATE
   ----------------------------------------------------------- */

.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-8) var(--spacing-6);
  text-align: center;
  position: relative;
  z-index: var(--z-base);
}

.error-icon {
  width: 72rpx;
  height: 72rpx;
  margin-bottom: var(--spacing-5);
  display: block;
  opacity: 0.30;
}

.error-text {
  font-size: var(--font-size-body-large);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-3);
  display: block;
}

.error-hint {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  margin-bottom: var(--spacing-6);
  display: block;
  word-break: break-all;
}

/* -----------------------------------------------------------
   11. SCROLLBAR
   ----------------------------------------------------------- */

::-webkit-scrollbar {
  width: 0;
  height: 0;
}
