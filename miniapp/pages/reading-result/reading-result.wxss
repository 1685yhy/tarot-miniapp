.page{min-height:100vh;background:#1A1A3E;padding:48rpx 32rpx}
.loading-box{display:flex;flex-direction:column;align-items:center;padding-top:200rpx}
.loading-spinner{width:48rpx;height:48rpx;border:3rpx solid rgba(244,212,140,.15);border-top-color:#F4D48C;border-radius:50%;animation:spin .8s linear infinite;margin-bottom:32rpx}
@keyframes spin{to{transform:rotate(360deg)}}
.loading-title{font-size:36rpx;color:#F0EDE8;font-weight:600;margin-bottom:8rpx}
.loading-sub{font-size:26rpx;color:#9A95B8;margin-bottom:32rpx}
.loading-quote{font-size:24rpx;color:#F4D48C;text-align:center;line-height:1.6;padding:0 32rpx;margin-bottom:32rpx;max-width:500rpx}
.loading-dots{display:flex;gap:16rpx}
.ldot{font-size:16rpx;color:rgba(244,212,140,.2)}.ldot.active{color:#F4D48C}
.error-state{display:flex;flex-direction:column;align-items:center;padding-top:200rpx;text-align:center}
.error-text{font-size:32rpx;color:#F0EDE8;margin-bottom:12rpx}
.error-hint{font-size:24rpx;color:#9A95B8;margin-bottom:32rpx}
.btn-retry{background:rgba(244,212,140,.15);color:#F4D48C;border:1rpx solid rgba(244,212,140,.3);border-radius:40rpx;padding:16rpx 48rpx;font-size:28rpx}
.cards-area{margin-bottom:40rpx}
.card-swiper{height:480rpx}
.card-wrapper{display:flex;justify-content:center;align-items:center;height:100%}
.interp-area{margin-bottom:40rpx}
.interp-title{font-size:32rpx;color:#F4D48C;display:block;margin-bottom:16rpx}
.interp-scroll{max-height:500rpx;overflow:hidden}.interp-scroll.expanded{max-height:none}
.interp-text{font-size:28rpx;color:#D0C8E0;line-height:1.7;white-space:pre-wrap}
.interp-toggle{display:block;text-align:center;color:#F4D48C;font-size:26rpx;padding:16rpx 0}
.actions{display:flex;flex-direction:column;gap:16rpx;align-items:center;padding-top:32rpx;border-top:1rpx solid rgba(255,255,255,.06)}
.btn-ask{width:100%;background:linear-gradient(135deg,#F4D48C,#D4B06A);color:#1A1A3E;font-weight:600;font-size:30rpx;border-radius:48rpx;padding:24rpx 0;border:none}
.btn-redo{width:100%;background:transparent;color:#F4D48C;border:1.5rpx solid rgba(244,212,140,.3);border-radius:48rpx;padding:20rpx 0;font-size:28rpx}
.btn-back{color:#9A95B8;font-size:26rpx;padding:12rpx 0;display:block;text-align:center}
.card-list{display:flex;gap:16rpx;justify-content:center;flex-wrap:wrap}
.card-item{background:#252550;border-radius:16rpx;padding:24rpx 32rpx;text-align:center;min-width:180rpx}
.card-pos{font-size:22rpx;color:#9A95B8;display:block;margin-bottom:8rpx}
.card-name{font-size:28rpx;color:#F4D48C;display:block}
