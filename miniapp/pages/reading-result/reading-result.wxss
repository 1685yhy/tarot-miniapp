/* ================================================================
   Tarot Reading Result — "A Personal Letter from the Cosmos"
   Theme: Starlight (deep indigo, warm gold, intimate prose)
   Palette:
     #1A1A3E — cosmic night / page background
     #252550 — card surface (dark indigo)
     #F4D48C — warm gold (accent, light, emphasis)
     #D4B06A — deeper gold (gradient stop)
     #B8A9E0 — lavender (secondary, link, soft)
     #F0EDE8 — warm cream (body text)
     #6B6599 — muted lavender (tertiary, subtle)
   ================================================================ */

/* ===== 0. Page Base ===== */
.page {
  min-height: 100vh;
  background: #1A1A3E;
  display: flex;
  flex-direction: column;
}

.content-scroll {
  height: 100vh;
}

.inner-wrap {
  padding: 64rpx 40rpx 100rpx;
  box-sizing: border-box;
}

/* ================================================================
   LOADING STATE — Anticipation, like a candle being lit
   ================================================================ */
.loading-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
}

/* Flame-inspired spinner */
.loading-candle {
  width: 6rpx;
  height: 80rpx;
  background: linear-gradient(to top, rgba(244, 212, 140, 0.15), rgba(244, 212, 140, 0.4));
  border-radius: 3rpx;
  position: relative;
  margin-bottom: 48rpx;
}

.candle-flame {
  position: absolute;
  top: -20rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 20rpx;
  height: 40rpx;
  background: radial-gradient(
    ellipse at center top,
    rgba(255, 235, 190, 1) 0%,
    rgba(244, 212, 140, 0.6) 40%,
    rgba(244, 212, 140, 0) 80%
  );
  border-radius: 50%;
  animation: flame-dance 1.6s ease-in-out infinite alternate;
}

@keyframes flame-dance {
  0% {
    transform: translateX(-50%) scaleY(1) scaleX(1);
    opacity: 0.7;
  }
  50% {
    transform: translateX(-50%) scaleY(1.2) scaleX(0.85);
    opacity: 1;
  }
  100% {
    transform: translateX(-50%) scaleY(0.9) scaleX(1.1);
    opacity: 0.8;
  }
}

.loading-title {
  font-size: 34rpx;
  color: #F4D48C;
  font-weight: 500;
  margin-bottom: 12rpx;
  letter-spacing: 3rpx;
}

.loading-sub {
  font-size: 24rpx;
  color: #B8A9E0;
  letter-spacing: 4rpx;
  opacity: 0.7;
}

/* ================================================================
   ERROR / EMPTY STATE
   ================================================================ */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  padding: 0 48rpx;
}

.error-text {
  font-size: 30rpx;
  color: #F0EDE8;
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
}

.error-hint {
  font-size: 24rpx;
  color: #B8A9E0;
  margin-bottom: 44rpx;
  letter-spacing: 1rpx;
}

.btn-retry {
  background: rgba(244, 212, 140, 0.12);
  color: #F4D48C;
  border: 1rpx solid rgba(244, 212, 140, 0.25);
  border-radius: 48rpx;
  padding: 20rpx 56rpx;
  font-size: 28rpx;
  letter-spacing: 2rpx;
  font-weight: 500;
}

.btn-retry::after {
  border: none;
}

/* ================================================================
   1. CARD REVEAL — Three-card spread
   ================================================================ */
.card-reveal {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 16rpx;
  padding-top: 24rpx;
}

/* Warm gold glow behind the center card */
.center-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 320rpx;
  height: 320rpx;
  background: radial-gradient(
    circle,
    rgba(244, 212, 140, 0.10) 0%,
    rgba(244, 212, 140, 0.04) 40%,
    transparent 70%
  );
  pointer-events: none;
}

/* ---- Card Row (horizontal spread) ---- */
.card-row {
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
  z-index: 1;
}

/* ---- Individual Card ---- */
.card-item {
  flex-shrink: 0;
  width: 200rpx;
  height: 284rpx;
  background: #252550;
  border: 1.5rpx solid rgba(244, 212, 140, 0.45);
  border-radius: 16rpx;
  position: relative;
  overflow: hidden;
  transition: transform 0.2s ease;
}

/* Overlap: every card after the first slides left */
.card-item + .card-item {
  margin-left: -32rpx;
}

/* Card stacking order: past (1), present (2, elevated), future (3) */
.card-item:nth-child(1) {
  z-index: 1;
}

.card-item:nth-child(2) {
  z-index: 3;
  transform: translateY(-14rpx);
  box-shadow:
    0 4rpx 24rpx rgba(244, 212, 140, 0.08),
    0 0 0 1.5rpx rgba(244, 212, 140, 0.6);
}

.card-item:nth-child(3) {
  z-index: 1;
}

/* Subtle edge highlight on left side of each card */
.card-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 4rpx;
  background: linear-gradient(
    to bottom,
    rgba(244, 212, 140, 0.3) 0%,
    rgba(244, 212, 140, 0.05) 60%,
    transparent 100%
  );
  border-radius: 16rpx 0 0 16rpx;
}

/* ---- Card Content ---- */
.card-inner {
  position: relative;
  z-index: 1;
  padding: 32rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  height: 100%;
  box-sizing: border-box;
}

.card-pos {
  display: block;
  font-size: 20rpx;
  color: #F4D48C;
  letter-spacing: 4rpx;
  font-weight: 500;
  opacity: 0.75;
  margin-bottom: 14rpx;
}

.card-name {
  display: block;
  font-size: 30rpx;
  color: #F4D48C;
  font-weight: 600;
  letter-spacing: 2rpx;
  line-height: 1.3;
  word-break: break-word;
}

/* ---- Spread Type Label ---- */
.spread-type {
  display: block;
  margin-top: 32rpx;
  font-size: 20rpx;
  color: #B8A9E0;
  letter-spacing: 5rpx;
  font-weight: 400;
  opacity: 0.5;
}

/* ================================================================
   2. DIVIDER — Quiet, thin, centered gold line
   ================================================================ */
.divider {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0 36rpx;
}

.divider-line {
  width: 160rpx;
  height: 1rpx;
  background: linear-gradient(
    to right,
    transparent,
    rgba(244, 212, 140, 0.25),
    transparent
  );
}

/* ================================================================
   3. LETTER — The interpretation
   ================================================================ */
.letter-section {
  margin-bottom: 48rpx;
}

/* ---- Letter Body Container ---- */
.letter-body {
  background: rgba(37, 37, 80, 0.30);
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  position: relative;
  border: 1rpx solid rgba(244, 212, 140, 0.06);
  overflow: hidden;
  transition: max-height 0.4s ease;
}

/* Subtle top light wash */
.letter-body::before {
  content: '';
  position: absolute;
  top: 0;
  left: 32rpx;
  right: 32rpx;
  height: 1rpx;
  background: linear-gradient(
    to right,
    transparent,
    rgba(244, 212, 140, 0.12),
    transparent
  );
}

/* Collapsed: show first ~12 lines then fade */
.letter-body.collapsed {
  max-height: 560rpx;
  -webkit-mask-image: linear-gradient(to bottom, black 60%, transparent 95%);
  mask-image: linear-gradient(to bottom, black 60%, transparent 95%);
}

/* Expanded: full height */
.letter-body.expanded {
  max-height: none;
  -webkit-mask-image: none;
  mask-image: none;
}

/* ---- Letter Text ---- */
.letter-text {
  font-size: 28rpx;
  color: #F0EDE8;
  line-height: 1.9;
  letter-spacing: 1rpx;
  white-space: pre-wrap;
  word-break: break-word;
  display: block;
}

/* ---- Toggle ---- */
.letter-toggle {
  display: flex;
  justify-content: center;
  margin-top: 12rpx;
}

.toggle-btn {
  font-size: 24rpx;
  color: #B8A9E0;
  letter-spacing: 2rpx;
  opacity: 0.6;
  padding: 16rpx 40rpx;
}

.toggle-btn:active {
  opacity: 1;
}

/* ================================================================
   4. ACTIONS
   ================================================================ */
.actions-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding-top: 24rpx;
}

/* ---- Primary: "追问更多" gold pill ---- */
.btn-ask {
  width: 100%;
  background: linear-gradient(135deg, #F4D48C 0%, #D4B06A 100%);
  color: #1A1A3E;
  font-weight: 700;
  font-size: 30rpx;
  border-radius: 50rpx;
  padding: 28rpx 0;
  border: none;
  letter-spacing: 5rpx;
  box-shadow:
    0 6rpx 28rpx rgba(244, 212, 140, 0.25),
    0 2rpx 8rpx rgba(244, 212, 140, 0.12);
  transition: opacity 0.2s;
  position: relative;
  overflow: hidden;
}

.btn-ask::after {
  border: none;
}

.btn-ask:active {
  opacity: 0.85;
}

/* ---- Secondary: "再来一次" outlined pill ---- */
.btn-redo {
  width: 100%;
  background: transparent;
  color: #F4D48C;
  font-weight: 500;
  font-size: 28rpx;
  border-radius: 50rpx;
  padding: 24rpx 0;
  border: 1.5rpx solid rgba(244, 212, 140, 0.3);
  letter-spacing: 4rpx;
  transition: border-color 0.2s, background 0.2s;
}

.btn-redo::after {
  border: none;
}

.btn-redo:active {
  border-color: rgba(244, 212, 140, 0.6);
  background: rgba(244, 212, 140, 0.06);
}

/* ---- Tertiary: "回到首页" lavender link ---- */
.btn-back {
  color: #6B6599;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  opacity: 0.55;
  padding: 20rpx 0 8rpx;
  display: block;
  text-align: center;
  transition: opacity 0.2s;
}

.btn-back:active {
  opacity: 0.85;
}
