/* pages/reading-result/reading-result.wxss */
.container {
  padding: 24rpx;
  background: var(--color-bg);
  min-height: 100vh;
  padding-bottom: 80rpx;
}

.section-label {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: 16rpx;
  text-align: center;
}

/* Cards swiper */
.cards-section {
  margin-bottom: 32rpx;
}
.card-swiper {
  height: 360rpx;
}
.drawn-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  background: var(--color-bg-card);
  border-radius: 24rpx;
  margin: 0 16rpx;
  border: 2rpx solid rgba(201, 169, 110, 0.15);
  padding: 32rpx;
  box-sizing: border-box;
}
.drawn-card.reversed {
  border-color: rgba(123, 104, 238, 0.3);
}
.card-position-badge {
  font-size: 22rpx;
  color: var(--color-gold);
  background: rgba(201, 169, 110, 0.12);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}
.card-main {
  text-align: center;
}
.card-name {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: 16rpx;
}
.direction-badge {
  font-size: 26rpx;
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
}
.direction-badge.up {
  background: rgba(201, 169, 110, 0.15);
  color: var(--color-gold);
}
.direction-badge.rev {
  background: rgba(123, 104, 238, 0.15);
  color: var(--color-purple);
}

/* Card dots */
.card-dots {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-top: 20rpx;
}
.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: rgba(201, 169, 110, 0.2);
}
.dot-active {
  background: var(--color-gold);
}

/* Interpretation */
.interpretation-section {
  margin-bottom: 32rpx;
}
.interpretation-card {
  background: var(--color-bg-card);
  border-radius: 20rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(201, 169, 110, 0.1);
  max-height: 600rpx;
  overflow: hidden;
  position: relative;
}
.interpretation-card.expanded {
  max-height: none;
}
.interpretation-card:not(.expanded)::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: linear-gradient(transparent, var(--color-bg-card));
}
.interpretation-text {
  font-size: 28rpx;
  color: var(--color-text-primary);
  line-height: 1.9;
  white-space: pre-wrap;
}
.expand-btn {
  display: block;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-gold);
  padding: 16rpx 0;
}

/* Actions */
.actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.action-btn {
  width: 100%;
  border-radius: 48rpx;
  padding: 24rpx 0;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}
.ask-btn {
  background: linear-gradient(135deg, var(--color-gold), var(--color-gold-light));
  color: #1a1a2e;
}
.share-btn {
  background: transparent;
  color: var(--color-gold);
  border: 2rpx solid var(--color-gold);
}
.action-row {
  display: flex;
  justify-content: center;
  gap: 48rpx;
  margin-top: 8rpx;
}
.action-link {
  font-size: 26rpx;
  color: var(--color-text-dim);
  padding: 12rpx 0;
}

/* Loading page */
.loading-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  background: var(--color-bg);
}
.loading-animation {
  margin-bottom: 32rpx;
}
.mystic-symbol {
  font-size: 80rpx;
  color: var(--color-gold);
  animation: mysticSpin 3s linear infinite;
  display: block;
}
@keyframes mysticSpin {
  0% { transform: rotate(0deg) scale(1); }
  50% { transform: rotate(180deg) scale(1.3); }
  100% { transform: rotate(360deg) scale(1); }
}
.loading-title {
  font-size: 32rpx;
  color: var(--color-gold);
  font-weight: 600;
}
.loading-sub {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-top: 12rpx;
}
