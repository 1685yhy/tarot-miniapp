/* ===== 占卜结果 - 至尊神秘主题 ===== */

/* Cards swiper */
.cards-section {
  margin-bottom: var(--space-xxl);
  position: relative;
  background:
    radial-gradient(ellipse at 50% 0%, rgba(50, 20, 70, 0.08), transparent 60%),
    radial-gradient(ellipse at 50% 100%, rgba(212, 175, 55, 0.03), transparent 50%);
  border-radius: var(--radius-card);
  padding: var(--space-md) 0;
}

.card-swiper {
  height: 520rpx;
}

.swiper-card-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  transition: transform var(--duration-normal) var(--ease-out);
}

/* Loading stages indicator */
.loading-stages {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-top: var(--space-xxl);
  padding: 0 var(--space-lg);
}

.stage-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  opacity: 0.4;
  transition: opacity 0.4s ease;
}

.stage-item.stage-done {
  opacity: 1;
}

.stage-icon {
  font-size: 28rpx;
}

.stage-text {
  font-size: var(--fs-caption, 20rpx);
  color: var(--color-text-secondary);
  white-space: nowrap;
}

.stage-arrow {
  font-size: 24rpx;
  color: var(--color-text-dim);
  opacity: 0.5;
  margin-top: -24rpx;
}

.drawn-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  background: linear-gradient(145deg, var(--color-bg-card), var(--color-bg-card-elevated));
  border-radius: var(--radius-card);
  margin: 0 var(--space-md);
  border: 2rpx solid var(--color-border-glow);
  padding: var(--space-xxl);
  box-sizing: border-box;
  box-shadow:
    var(--shadow-glow),
    0 0 40rpx rgba(212, 175, 55, 0.06),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.04);
  transition: all var(--duration-normal) var(--ease-out);
}

.drawn-card.reversed {
  border-color: var(--color-purple-glow);
  box-shadow:
    var(--shadow-glow-purple),
    0 0 40rpx rgba(147, 112, 219, 0.06),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.04);
}

/* Interpretation */
.interpretation-section {
  margin-bottom: var(--space-xxl);
}

.interpretation-text {
  font-size: var(--fs-body);
  color: var(--color-text-primary);
  line-height: var(--lh-loose);
  white-space: pre-wrap;
  letter-spacing: 1rpx;
  display: block;
}

/* Drop cap for first letter of interpretation */
.interpretation-text::first-letter {
  font-size: 52rpx;
  font-weight: var(--fw-bold);
  color: var(--color-gold);
  float: left;
  margin-right: 6rpx;
  line-height: 1.1;
}

/* Scrollable interpretation container - enhanced card styling */
.interpretation-scroll {
  max-height: 600rpx;
  overflow: hidden;
  position: relative;
}
.interpretation-scroll.expanded {
  max-height: none;
  overflow: visible;
}
/* Gradient fade at bottom when collapsed */
.interpretation-scroll:not(.expanded)::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: linear-gradient(transparent, var(--color-bg-card));
  pointer-events: none;
}
/* Error state card */
.interpretation-card {
  text-align: center;
  padding: var(--space-xxl);
}

/* Interpretation card with enhanced border */
.interpretation-scroll.card {
  border-color: var(--color-border-glow);
  background: linear-gradient(180deg, var(--color-bg-card), rgba(26, 26, 46, 0.9));
}

/* Actions */
.actions {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}

.action-row {
  display: flex;
  justify-content: center;
  gap: var(--space-huge);
  margin-top: var(--space-xs);
}

/* ===== Loading (占卜加载页) ===== */
.loading-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  background: var(--color-bg);
}

.loading-animation {
  margin-bottom: var(--space-xxl);
}

/* ===== 错误状态 ===== */
.error-state {
  text-align: center;
  padding: var(--space-massive) var(--space-xl);
}

.error-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: var(--space-md);
  opacity: 0.6;
}

.error-text {
  font-size: var(--fs-body);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--space-xs);
}

.error-hint {
  font-size: var(--fs-body-small);
  color: var(--color-text-dim);
  display: block;
  margin-bottom: var(--space-xxl);
}
