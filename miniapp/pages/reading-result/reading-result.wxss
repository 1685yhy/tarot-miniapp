/* ===== 占卜结果页 · 圣仪解读 ===== */

/* -------- 全局装饰 ------- */
@keyframes velvet-shimmer {
  0%   { background-position: 0% 50%; }
  50%  { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

@keyframes gold-gleam {
  0%, 100% { opacity: 0.3; }
  50%      { opacity: 0.6; }
}

@keyframes candle-flicker {
  0%, 100% { opacity: 0.7; transform: scaleY(1); }
  25%      { opacity: 0.9; transform: scaleY(1.03); }
  50%      { opacity: 0.6; transform: scaleY(0.97); }
  75%      { opacity: 0.85; transform: scaleY(1.02); }
}

/* -------- 已抽卡牌 · 天鹅绒台面 -------- */
.cards-section {
  margin-bottom: var(--space-xxl);
  position: relative;
  border-radius: 24rpx;
  padding: var(--space-md) 0;
  background:
    radial-gradient(ellipse at 50% 20%, rgba(90, 40, 60, 0.25), transparent 70%),
    radial-gradient(ellipse at 50% 80%, rgba(212, 175, 55, 0.04), transparent 50%),
    linear-gradient(
      170deg,
      rgba(35, 15, 40, 0.5) 0%,
      rgba(55, 22, 45, 0.6) 30%,
      rgba(40, 12, 35, 0.7) 60%,
      rgba(30, 10, 35, 0.5) 100%
    );
  background-size: 200% 200%;
  animation: velvet-shimmer 12s ease-in-out infinite;
  box-shadow:
    inset 0 0 60rpx rgba(90, 20, 60, 0.15),
    inset 0 1rpx 0 rgba(212, 175, 55, 0.06);
  border: 1rpx solid rgba(212, 175, 55, 0.08);
}

/* Velvet texture overlay */
.cards-section::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background:
    repeating-linear-gradient(
      0deg,
      transparent,
      transparent 4rpx,
      rgba(255, 255, 255, 0.008) 4rpx,
      transparent 8rpx
    );
  pointer-events: none;
  opacity: 0.5;
}

/* Top decorative border */
.cards-section::after {
  content: '✧ ──── ✧ ──── ✧';
  position: absolute;
  top: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 16rpx;
  color: rgba(212, 175, 55, 0.1);
  letter-spacing: 10rpx;
  white-space: nowrap;
  pointer-events: none;
}

.card-swiper {
  height: 520rpx;
}

.swiper-card-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  transition: transform var(--duration-normal) var(--ease-out);
}

.drawn-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  background: linear-gradient(
    160deg,
    rgba(60, 35, 65, 0.7) 0%,
    rgba(45, 25, 55, 0.85) 40%,
    rgba(35, 18, 45, 0.9) 100%
  );
  border-radius: 22rpx;
  margin: 0 var(--space-md);
  border: 1rpx solid rgba(212, 175, 55, 0.15);
  padding: var(--space-xxl);
  box-sizing: border-box;
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.35),
    0 0 60rpx rgba(212, 175, 55, 0.04),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.03),
    inset 0 -1rpx 0 rgba(212, 175, 55, 0.06);
  transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  position: relative;
  overflow: hidden;
}

/* Decorative inner border */
.drawn-card::before {
  content: '';
  position: absolute;
  inset: 6rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.06);
  pointer-events: none;
}

/* Card name glow */
.card-name {
  font-size: var(--fs-body-large);
  font-weight: var(--fw-bold);
  color: rgba(230, 220, 240, 0.95);
  letter-spacing: 3rpx;
  position: relative;
  z-index: 1;
  text-shadow: 0 0 20rpx rgba(212, 175, 55, 0.1);
}

.card-suit {
  font-size: var(--fs-caption);
  color: rgba(212, 175, 55, 0.5);
  letter-spacing: 2rpx;
  margin-top: 6rpx;
  position: relative;
  z-index: 1;
}

.reversed-indicator {
  margin-top: var(--space-sm);
  font-size: 20rpx;
  color: rgba(180, 140, 220, 0.5);
  letter-spacing: 4rpx;
  position: relative;
  z-index: 1;
}

.drawn-card.reversed {
  border-color: rgba(160, 120, 200, 0.2);
  background: linear-gradient(
    160deg,
    rgba(50, 25, 65, 0.7) 0%,
    rgba(40, 18, 55, 0.85) 40%,
    rgba(30, 12, 45, 0.9) 100%
  );
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.35),
    0 0 60rpx rgba(160, 120, 200, 0.04),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.02);
}

.drawn-card.reversed::before {
  border-color: rgba(160, 120, 200, 0.08);
}

/* -------- 加载阶段指示器 -------- */
.loading-stages {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-top: var(--space-xxl);
  padding: 0 var(--space-lg);
}

.stage-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  opacity: 0.3;
  transition: opacity 0.5s ease;
}

.stage-item.stage-done {
  opacity: 1;
}

.stage-icon {
  font-size: 28rpx;
  filter: drop-shadow(0 0 6rpx rgba(212, 175, 55, 0.15));
}

.stage-text {
  font-size: var(--fs-caption, 20rpx);
  color: rgba(200, 190, 210, 0.6);
  white-space: nowrap;
  letter-spacing: 1rpx;
}

.stage-arrow {
  font-size: 24rpx;
  color: rgba(200, 190, 210, 0.25);
  margin-top: -24rpx;
}

/* -------- 解读区 · 圣典书卷 -------- */
.interpretation-section {
  margin-bottom: var(--space-xxl);
  position: relative;
}

/* Section title divider */
.interpretation-section::before {
  content: '┅ ✦ ┅ ✦ ┅ ✦ ┅';
  display: block;
  text-align: center;
  font-size: 16rpx;
  color: rgba(212, 175, 55, 0.1);
  letter-spacing: 6rpx;
  margin-bottom: var(--space-lg);
}

/* The interpretation scrollable container */
.interpretation-scroll {
  max-height: 600rpx;
  overflow: hidden;
  position: relative;
  background: linear-gradient(
    180deg,
    rgba(45, 28, 55, 0.5) 0%,
    rgba(38, 22, 48, 0.6) 100%
  );
  border-radius: 18rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.08);
  padding: var(--space-lg) var(--space-xxl);
  box-shadow:
    inset 0 0 40rpx rgba(0, 0, 0, 0.2),
    inset 0 1rpx 0 rgba(212, 175, 55, 0.04);
}

.interpretation-scroll.expanded {
  max-height: none;
  overflow: visible;
}

/* Gradient fade at bottom when collapsed */
.interpretation-scroll:not(.expanded)::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: linear-gradient(transparent, rgba(38, 22, 48, 0.9));
  pointer-events: none;
}

/* The actual text block */
.interpretation-text {
  font-size: var(--fs-body);
  color: rgba(225, 215, 235, 0.88);
  line-height: 1.9;
  white-space: pre-wrap;
  letter-spacing: 1.5rpx;
  display: block;
  text-align: justify;
  font-feature-settings: 'kern' 1, 'liga' 1;
}

/* Drop cap — illuminated manuscript style */
.interpretation-text::first-letter {
  font-size: 64rpx;
  font-weight: 700;
  color: #d4af37;
  float: left;
  margin-right: 10rpx;
  margin-top: 4rpx;
  line-height: 1;
  text-shadow:
    0 0 20rpx rgba(212, 175, 55, 0.2),
    2rpx 2rpx 0 rgba(0, 0, 0, 0.1);
  font-family: serif;
}

/* Gold paragraph dividers via paragraph spacing */
.interpretation-text p,
.interpretation-text div:not(:last-child) {
  margin-bottom: var(--space-lg);
  padding-bottom: var(--space-md);
  position: relative;
}

/* Gold ornament between paragraphs — only when there are multiple */
.interpretation-text p::after,
.interpretation-text > div:not(:last-child)::after {
  content: '✦ ✦ ✦';
  display: block;
  text-align: center;
  font-size: 14rpx;
  color: rgba(212, 175, 55, 0.15);
  letter-spacing: 12rpx;
  margin-top: var(--space-lg);
  padding-top: var(--space-sm);
  animation: gold-gleam 4s ease-in-out infinite;
}

/* Error / empty state in interpretation */
.interpretation-card {
  text-align: center;
  padding: var(--space-xxl);
  color: rgba(200, 190, 210, 0.5);
  font-style: italic;
  letter-spacing: 1rpx;
}

/* -------- 操作按钮区 -------- */
.actions {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  position: relative;
}

/* Decorative top border */
.actions::before {
  content: '✧ ──── ✧ ──── ✧';
  display: block;
  text-align: center;
  font-size: 16rpx;
  color: rgba(212, 175, 55, 0.08);
  letter-spacing: 8rpx;
  margin-bottom: var(--space-sm);
}

.action-row {
  display: flex;
  justify-content: center;
  gap: var(--space-huge);
  margin-top: var(--space-xs);
}

/* -------- 加载页 · 占卜仪式中 -------- */
.loading-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  background:
    radial-gradient(ellipse at 50% 40%, rgba(60, 25, 55, 0.2), transparent),
    var(--color-bg);
}

.loading-animation {
  margin-bottom: var(--space-xxl);
  position: relative;
}

.loading-animation::after {
  content: '✦ ✦ ✦';
  position: absolute;
  bottom: -40rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 20rpx;
  color: rgba(212, 175, 55, 0.15);
  letter-spacing: 16rpx;
  animation: gold-gleam 3s ease-in-out infinite;
}

/* -------- 错误状态 -------- */
.error-state {
  text-align: center;
  padding: var(--space-massive) var(--space-xl);
}

.error-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: var(--space-md);
  opacity: 0.4;
  filter: grayscale(0.3);
}

.error-text {
  font-size: var(--fs-body);
  color: rgba(200, 190, 210, 0.55);
  display: block;
  margin-bottom: var(--space-xs);
  letter-spacing: 1rpx;
}

.error-hint {
  font-size: var(--fs-body-small);
  color: rgba(200, 190, 210, 0.3);
  display: block;
  margin-bottom: var(--space-xxl);
  font-style: italic;
}

/* -------- '展开全文' 按钮 -------- */
.expand-btn {
  display: block;
  width: 100%;
  text-align: center;
  padding: var(--space-sm) 0;
  font-size: var(--fs-body-small);
  color: rgba(212, 175, 55, 0.5);
  letter-spacing: 2rpx;
  position: relative;
  background: none;
  border: none;
  transition: color 0.3s;
}

.expand-btn:active {
  color: rgba(212, 175, 55, 0.8);
}

.expand-btn::before {
  content: '┅';
  display: block;
  text-align: center;
  font-size: 14rpx;
  color: rgba(212, 175, 55, 0.1);
  margin-bottom: 4rpx;
}
