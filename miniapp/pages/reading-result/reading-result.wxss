/* ========================================================
   占卜结果页 · 新艺术画廊（Art Nouveau Gallery）
   画廊墙面展陈 · 铜色点缀 · 有机曲线分割
   ======================================================== */

/* -------- 全局装饰 -------- */
@keyframes float-gentle {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-6rpx); }
}

@keyframes shimmer-warm {
  0%, 100% { opacity: 0.4; }
  50%      { opacity: 0.7; }
}

/* ========================================================
   卡牌展区 · 画廊墙面
   ======================================================== */
.cards-section {
  margin-bottom: var(--space-xxxl);
  position: relative;
  border-radius: 24rpx;
  padding: var(--space-xxl) var(--space-lg);
  background: linear-gradient(
    165deg,
    #faf5ec 0%,
    #f8f0e6 35%,
    #f5ece0 65%,
    #faf5ec 100%
  );
  box-shadow:
    0 4rpx 20rpx rgba(160, 130, 100, 0.05),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
  border: 1rpx solid rgba(180, 155, 130, 0.08);
}

/* 画廊上沿装饰线 — 新艺术风格弧形 */
.cards-section::before {
  content: '';
  position: absolute;
  top: -1rpx;
  left: 10%;
  right: 10%;
  height: 2rpx;
  background:
    radial-gradient(ellipse at 20% 50%, rgba(180, 155, 130, 0.20) 0%, transparent 70%),
    radial-gradient(ellipse at 80% 50%, rgba(180, 155, 130, 0.20) 0%, transparent 70%);
  pointer-events: none;
}

.card-swiper {
  height: 540rpx;
  padding: var(--space-sm) 0;
}

.swiper-card-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  transition: transform var(--duration-normal) var(--ease-out);
}

/* 单张卡牌 — 如同装裱画作 */
.drawn-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  background: #ffffff;
  border-radius: 18rpx;
  margin: 0 var(--space-xl);
  padding: var(--space-xxl) var(--space-lg);
  box-sizing: border-box;
  box-shadow:
    0 8rpx 32rpx rgba(140, 115, 95, 0.08),
    0 2rpx 12rpx rgba(140, 115, 95, 0.04),
    0 0 0 1rpx rgba(180, 155, 130, 0.04);
  border: 1rpx solid rgba(180, 155, 130, 0.06);
  transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  position: relative;
}

/* 画框内角装饰 */
.drawn-card::before {
  content: '';
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 20rpx;
  height: 20rpx;
  border-top: 2rpx solid rgba(180, 155, 130, 0.08);
  border-right: 2rpx solid rgba(180, 155, 130, 0.08);
  pointer-events: none;
}

.drawn-card::after {
  content: '';
  position: absolute;
  bottom: 12rpx;
  left: 12rpx;
  width: 20rpx;
  height: 20rpx;
  border-bottom: 2rpx solid rgba(180, 155, 130, 0.08);
  border-left: 2rpx solid rgba(180, 155, 130, 0.08);
  pointer-events: none;
}

.card-name {
  font-size: var(--fs-body-large);
  font-weight: var(--fw-bold);
  color: #4a3d30;
  letter-spacing: 3rpx;
  position: relative;
  z-index: 1;
}

.card-suit {
  font-size: var(--fs-caption);
  color: rgba(160, 140, 120, 0.45);
  letter-spacing: 3rpx;
  margin-top: 8rpx;
  position: relative;
  z-index: 1;
}

.reversed-indicator {
  margin-top: var(--space-sm);
  font-size: 20rpx;
  color: rgba(150, 130, 140, 0.40);
  letter-spacing: 4rpx;
  position: relative;
  z-index: 1;
}

.drawn-card.reversed {
  background: #fcf8f2;
  box-shadow:
    0 8rpx 32rpx rgba(140, 115, 105, 0.06),
    0 2rpx 12rpx rgba(140, 115, 105, 0.03);
  border-color: rgba(180, 155, 140, 0.06);
}

/* ========================================================
   加载阶段指示器
   ======================================================== */
.loading-stages {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin-top: var(--space-xxl);
  padding: 0 var(--space-lg);
}

.stage-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  opacity: 0.25;
  transition: opacity 0.5s ease;
}

.stage-item.stage-done {
  opacity: 1;
}

.stage-icon {
  font-size: 28rpx;
}

.stage-text {
  font-size: var(--fs-caption, 20rpx);
  color: rgba(140, 120, 105, 0.50);
  white-space: nowrap;
  letter-spacing: 2rpx;
}

.stage-arrow {
  font-size: 24rpx;
  color: rgba(180, 155, 130, 0.15);
  margin-top: -24rpx;
}

/* ========================================================
   解读区 · 典雅衬线风格
   ======================================================== */
.interpretation-section {
  margin-bottom: var(--space-xxl);
  position: relative;
}

/* —— 有机曲线分割线（替代直线） —— */
.interpretation-section::before {
  content: '';
  display: block;
  height: 20rpx;
  margin-bottom: var(--space-lg);
  background:
    /* 蜿蜒曲线 — 新艺术风格 whiplash */
    radial-gradient(ellipse at 15% 50%, rgba(180, 155, 130, 0.12) 0%, transparent 60%),
    radial-gradient(ellipse at 40% 50%, rgba(180, 155, 130, 0.08) 0%, transparent 50%),
    radial-gradient(ellipse at 65% 50%, rgba(180, 155, 130, 0.12) 0%, transparent 60%),
    radial-gradient(ellipse at 90% 50%, rgba(180, 155, 130, 0.06) 0%, transparent 50%);
  pointer-events: none;
}

/* —— 「星光解读」铜色药丸标签 —— */
.ai-label {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #a67c5b;
  letter-spacing: 3rpx;
  margin-bottom: var(--space-md);
  padding: 6rpx 20rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, rgba(200, 170, 140, 0.10), rgba(200, 170, 140, 0.04));
  border: 1rpx solid rgba(200, 170, 140, 0.15);
  position: relative;
}

/* 铜色小圆点 */
.ai-label::before {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 35%, #d4a574, #b8865a);
  flex-shrink: 0;
}

/* —— 解读文本容器 —— */
.interpretation-scroll {
  max-height: 600rpx;
  overflow: hidden;
  position: relative;
  background: #fcf8f2;
  border-radius: 20rpx;
  border: 1rpx solid rgba(180, 155, 130, 0.06);
  padding: var(--space-lg) var(--space-xxl);
  box-shadow: inset 0 0 24rpx rgba(160, 130, 100, 0.02);
}

.interpretation-scroll.expanded {
  max-height: none;
  overflow: visible;
}

/* 折叠底部渐变淡出 */
.interpretation-scroll:not(.expanded)::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: linear-gradient(transparent, #fcf8f2);
  pointer-events: none;
}

/* —— 实际解读文字 —— */
.interpretation-text {
  font-size: var(--fs-body);
  color: #4a3d30;
  line-height: 2.2;                       /* 宽行距 — 优雅阅读 */
  white-space: pre-wrap;
  letter-spacing: 2rpx;
  display: block;
  text-align: justify;
  font-feature-settings: 'kern' 1, 'liga' 1;
}

/* 首字下沉 — 衬线风格优雅 */
.interpretation-text::first-letter {
  font-size: 60rpx;
  font-weight: 600;
  color: #a67c5b;
  float: left;
  margin-right: 10rpx;
  margin-top: 6rpx;
  line-height: 1;
  font-family: serif;
  font-style: italic;
}

/* 段落间距 */
.interpretation-text p,
.interpretation-text div:not(:last-child) {
  margin-bottom: var(--space-md);
  padding-bottom: var(--space-sm);
  position: relative;
}

/* 段落间 — 有机曲线分隔（替代直线） */
.interpretation-text p::after,
.interpretation-text > div:not(:last-child)::after {
  content: '';
  display: block;
  height: 14rpx;
  margin-top: var(--space-md);
  background:
    radial-gradient(ellipse at 30% 50%, rgba(180, 155, 130, 0.06) 0%, transparent 70%),
    radial-gradient(ellipse at 70% 50%, rgba(180, 155, 130, 0.04) 0%, transparent 60%);
  pointer-events: none;
}

/* 空解读 / 错误 */
.interpretation-card {
  text-align: center;
  padding: var(--space-xxl);
  color: rgba(140, 120, 105, 0.40);
  font-style: italic;
  letter-spacing: 2rpx;
}

/* ========================================================
   操作按钮区
   ======================================================== */
.actions {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  position: relative;
}

/* 上方有机分隔 */
.actions::before {
  content: '';
  display: block;
  height: 16rpx;
  margin-bottom: var(--space-md);
  background:
    radial-gradient(ellipse at 25% 50%, rgba(160, 180, 140, 0.10) 0%, transparent 60%),
    radial-gradient(ellipse at 75% 50%, rgba(160, 180, 140, 0.08) 0%, transparent 60%);
  pointer-events: none;
}

.action-row {
  display: flex;
  justify-content: center;
  gap: var(--space-huge);
  margin-top: var(--space-xs);
}

/* —— 铜色描边按钮 —— */
.btn-outline-rose {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-md) var(--space-xxl);
  border-radius: 42rpx;
  font-size: var(--fs-body);
  color: #a67c5b;
  background: #ffffff;
  border: 1rpx solid rgba(200, 170, 140, 0.18);
  letter-spacing: 3rpx;
  transition: all 0.3s ease;
  box-shadow: 0 2rpx 12rpx rgba(160, 130, 100, 0.03);
  position: relative;
}

.btn-outline-rose:active {
  background: rgba(200, 170, 140, 0.04);
  border-color: rgba(200, 170, 140, 0.30);
}

/* ========================================================
   加载页
   ======================================================== */
.loading-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  background: linear-gradient(180deg, #faf5ec, #f5ece0);
}

.loading-animation {
  margin-bottom: var(--space-xxl);
  position: relative;
}

/* ========================================================
   错误状态
   ======================================================== */
.error-state {
  text-align: center;
  padding: var(--space-massive) var(--space-xl);
}

.error-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: var(--space-md);
  opacity: 0.30;
}

.error-text {
  font-size: var(--fs-body);
  color: rgba(120, 100, 85, 0.45);
  display: block;
  margin-bottom: var(--space-xs);
  letter-spacing: 2rpx;
}

.error-hint {
  font-size: var(--fs-body-small);
  color: rgba(120, 100, 85, 0.25);
  display: block;
  margin-bottom: var(--space-xxl);
  font-style: italic;
}

/* ========================================================
   「展开全文」按钮
   ======================================================== */
.expand-btn {
  display: block;
  width: 100%;
  text-align: center;
  padding: var(--space-sm) 0;
  font-size: var(--fs-body-small);
  color: rgba(160, 140, 120, 0.45);
  letter-spacing: 3rpx;
  position: relative;
  background: none;
  border: none;
  transition: color 0.3s;
}

.expand-btn:active {
  color: rgba(180, 155, 130, 0.70);
}
