<!-- pages/journal/journal.wxml —— 星光手账（T1-4）：五档点星 + 星光夜空月历 + 星点详情展开 -->

<view class="container">
  <!-- E3 奶油底色氛围光斑 -->
  <view class="wash wash-pink"></view>
  <view class="wash wash-gold"></view>

  <!-- ===== 加载骨架 ===== -->
  <view wx:if="{{calendarLoading}}">
    <view class="skeleton-wrap">
      <view class="skeleton-header-area">
        <view class="skeleton skeleton-line wide"></view>
        <view class="skeleton skeleton-line medium"></view>
      </view>
      <view class="skeleton skeleton-btn"></view>
      <view class="skeleton skeleton-block"></view>
    </view>
  </view>

  <!-- ===== 错误状态 ===== -->
  <view wx:elif="{{calendarError}}" class="error-state">
    <view class="error-card">
      <text class="error-title">夜空暂时无法打开</text>
      <text class="error-desc">{{calendarError}}</text>
      <button class="btn-retry" bindtap="onRetry">重新连接</button>
    </view>
  </view>

  <!-- ===== 主内容 ===== -->
  <view wx:else>

    <!-- Header -->
    <view class="page-header">
      <text class="page-title">星光手账</text>
      <text class="page-subtitle">我的星光夜空 · 每晚一颗星</text>
    </view>

    <!-- ===== 今晚，记一颗星：5 档星光亮度一屏点选 ===== -->
    <view class="quick-card anim-fade-up">
      <view class="quick-header">
        <view class="quick-title-line">
          <text class="quick-title">今晚，记一颗星</text>
          <view wx:if="{{quickDone}}" class="quick-done-badge">
            <text class="quick-done-text">今晚的星已点亮 ✦</text>
          </view>
        </view>
        <text class="quick-subtitle">点选星光亮度，一按即记 · 3 秒完成</text>
      </view>

      <view class="quick-row">
        <view
          wx:for="{{quickLevels}}" wx:key="level"
          class="quick-level {{quickSaving ? 'quick-level--busy' : ''}}"
          data-mood="{{item.mood}}"
          bindtap="onQuickRecord"
          role="button"
          aria-label="记一颗{{item.name}}（{{item.hint}}）"
          hover-class="quick-level--press"
        >
          <view class="quick-glyph-wrap">
            <text class="quick-glyph {{item.level <= 2 ? 'quick-glyph--dim' : ''}} {{item.level === 1 ? 'quick-glyph--faint' : ''}}">{{item.glyph}}</text>
          </view>
          <text class="quick-name">{{item.name}}</text>
          <text class="quick-hint">{{item.hint}}</text>
        </view>
      </view>
    </view>

    <!-- ===== 月度统计 ===== -->
    <view class="stats-row anim-fade-up" wx:if="{{stats}}">
      <view class="stat-item">
        <text class="stat-num">{{stats.days_recorded}}</text>
        <text class="stat-label">点亮天数</text>
      </view>
      <view class="stat-sep"></view>
      <view class="stat-item">
        <text class="stat-num">{{stats.bright_count}}</text>
        <text class="stat-label">亮星</text>
      </view>
      <view class="stat-sep"></view>
      <view class="stat-item">
        <text class="stat-num">{{stats.dim_count}}</text>
        <text class="stat-label">暗星</text>
      </view>
      <view class="stat-sep"></view>
      <view class="stat-item">
        <text class="stat-num stat-num--streak">{{stats.current_streak}}</text>
        <text class="stat-label">连续记录</text>
      </view>
    </view>

    <!-- ===== 空月引导 ===== -->
    <view class="empty-month anim-fade-up" wx:if="{{stats && stats.days_recorded === 0}}">
      <text class="empty-month-icon">✦</text>
      <text class="empty-month-text">夜空从不催促，星会等你</text>
      <text class="empty-month-sub">今晚，为今天点一颗星，夜空就多一处光</text>
    </view>

    <!-- ===== 月历顶部 · 本月星光回顾卡（T1-5 → 月度复盘页） ===== -->
    <view
      wx:if="{{stats && stats.days_recorded > 0}}"
      class="month-review-entry anim-fade-up anim-stagger-1"
      bindtap="onOpenMonthlyReview"
      role="button"
      aria-label="打开{{month}}月星光复盘"
      hover-class="month-review-entry--press"
    >
      <view class="month-review-left">
        <view class="month-review-icon">📖</view>
        <view class="month-review-texts">
          <text class="month-review-title">本月星光回顾</text>
          <text class="month-review-sub">{{month}}月 · 点亮 {{stats.days_recorded}} 天 · AI 温柔复盘</text>
        </view>
      </view>
      <text class="month-review-arrow">›</text>
    </view>

    <!-- ===== 星光夜空月历（共用组件 · 星点模式） ===== -->
    <view class="calendar-wrap anim-fade-up anim-stagger-2">
      <calendar
        year="{{year}}"
        month="{{month}}"
        days="{{calDays}}"
        today="{{todayStr}}"
        mark-mode="stars"
        bind:daytap="onDayTap"
        bind:monthchange="onCalendarMonthChange"
      />
    </view>

    <view class="cal-legend">
      <view class="legend-item">
        <view class="legend-dust"></view>
        <text class="legend-text">留一颗星的位子</text>
      </view>
      <view class="legend-item">
        <view class="legend-star"></view>
        <text class="legend-text">星光色 = 当天星光 · 光晕 = 亮度</text>
      </view>
    </view>

    <!-- ===== AI 周回顾（I-1：由旧日记迁入 · 折叠标题条） ===== -->
    <view class="review-card anim-fade-up anim-stagger-2" wx:if="{{entriesCount >= 3}}">
      <!-- 一行标题条：本周回顾 ▾ 生成（数据绑定与动画完整保留） -->
      <view class="review-header" bindtap="onToggleReview" role="button" aria-label="{{reviewExpanded ? '收起本周回顾' : '展开本周回顾'}}">
        <view class="review-header-left">
          <text class="review-header-icon">📊</text>
          <text class="review-title">本周回顾</text>
        </view>
        <view class="review-header-actions">
          <view class="review-refresh-btn" catchtap="onRefreshReview" role="button" aria-label="生成周回顾">
            <text wx:if="{{reviewLoading}}">加载中...</text>
            <text wx:elif="{{weeklyReview}}">⟳ 刷新</text>
            <text wx:else>生成回顾</text>
          </view>
          <text class="review-fold-arrow">{{reviewExpanded ? '▴' : '▾'}}</text>
        </view>
      </view>

      <!-- 展开区（wx:if 控制显隐，保留全部数据绑定与动画） -->
      <view wx:if="{{reviewExpanded}}" class="review-body">

        <!-- 加载状态 -->
        <view wx:if="{{reviewLoading && !weeklyReview}}" class="review-loading">
          <text class="review-loading-text">AI 正在分析你的周记...</text>
        </view>

        <!-- 错误状态（保留本地回溯数据作为降级） -->
        <view wx:elif="{{reviewError && !weeklyReview}}" class="review-fallback">
          <text class="review-summary">
            这周你记录了 {{entriesCount}} 次心情，
            最常出现的牌是「{{topCard}}」，
            你的心情趋势是{{moodTrend}}。
          </text>
        </view>

        <!-- 初始状态 — 主动生成回顾 -->
        <view wx:elif="{{!reviewLoading && !reviewError && !weeklyReview}}" class="review-generate">
          <text class="review-generate-icon">📊</text>
          <text class="review-generate-text">本周已有 {{entriesCount}} 条日记记录</text>
          <button class="review-generate-btn" bindtap="onRefreshReview">生成 AI 周回顾 ✦</button>
        </view>

        <!-- AI 周回顾内容 -->
        <view wx:elif="{{weeklyReview}}" class="review-content">

          <!-- 情绪趋势曲线 (emoji + block chart) -->
          <view class="mood-trend" wx:if="{{weeklyReview.moodTrendCurve}}">
            <text class="review-section-label">本周心情</text>
            <view class="trend-line">
              <text class="trend-emoji" wx:for="{{weeklyReview.mood_trends}}" wx:key="date">{{item.mood_emoji}}</text>
            </view>
            <text class="trend-curve-text">{{weeklyReview.moodTrendCurve}}</text>
          </view>

          <!-- 情绪趋势柱状图（hasMoodTrends 为 JS 预计算；WXML 编译环境下 .length > 0 不渲染） -->
          <view class="chart-section" wx:if="{{hasMoodTrends}}">
            <text class="review-section-label">情绪趋势</text>
            <text class="trend-summary-text">{{weeklyReview.emotional_trend_summary}}</text>
            <view class="mood-chart">
              <view
                class="chart-bar-wrap"
                wx:for="{{weeklyReview.mood_trends}}" wx:for-item="trend" wx:key="date"
              >
                <view class="chart-bar-column">
                  <text class="chart-bar-emoji">{{trend.mood_emoji}}</text>
                  <view class="chart-bar-track">
                    <view
                      class="chart-bar-fill"
                      style="height: {{(trend.mood_score / 5) * 100}}%;"
                    ></view>
                  </view>
                  <text class="chart-bar-label">{{trend.date.slice(5)}}</text>
                </view>
              </view>
            </view>
          </view>

          <!-- 本周影响最大的牌 -->
          <view class="review-card-section" wx:if="{{weeklyReview.top_card_name}}">
            <text class="review-section-label">本周影响力之牌</text>
            <view class="top-card-row">
              <text class="top-card-name">{{weeklyReview.top_card_name}}</text>
              <text class="top-card-count">出现 {{weeklyReview.top_card_count}} 次</text>
            </view>
            <text class="top-card-meaning" wx:if="{{weeklyReview.top_card_meaning}}">
              {{weeklyReview.top_card_meaning}}
            </text>
          </view>

          <!-- AI 洞察 -->
          <view class="review-card-section insight-section" wx:if="{{weeklyReview.ai_insight}}">
            <text class="review-section-label">AI 洞察</text>
            <text class="insight-text">{{weeklyReview.ai_insight}}</text>
          </view>

          <!-- 下周指引 -->
          <view class="review-card-section guidance-section" wx:if="{{weeklyReview.next_week_guidance}}">
            <text class="review-section-label">下周指引</text>
            <text class="guidance-text">{{weeklyReview.next_week_guidance}}</text>
          </view>

        </view>

      </view>
    </view>

  </view>

  <!-- ============ 星点详情展开（底部弹层） ============ -->
  <view class="modal-mask" wx:if="{{detailVisible}}" bindtap="_closeDetail" role="button" aria-label="关闭星点详情">
    <view class="modal-sheet" catchtap="preventClose">

      <!-- Handle -->
      <view class="modal-handle"></view>

      <!-- 日期标题 -->
      <view class="detail-header">
        <text class="detail-date">{{detailDateLabel}}</text>
        <text wx:if="{{detailIsToday}}" class="detail-today-tag">今天</text>
      </view>

      <!-- ── 已记录：星点 + 情绪档 + 可选文字 ── -->
      <block wx:if="{{detailHasStar}}">
        <!-- 星点预览：颜色=当日星光色 · 光晕=亮度档 -->
        <view class="detail-star-preview">
          <view
            class="detail-star"
            style="width: {{26 + detailBrightness * 8}}rpx; height: {{26 + detailBrightness * 8}}rpx; background: {{detailStarColor}}; box-shadow: 0 0 {{detailBrightness * 12}}rpx {{detailStarColor}};"
          ></view>
          <view class="detail-star-info">
            <text class="detail-brightness-name">{{detailBrightnessName}}</text>
            <text class="detail-mood-line" wx:if="{{detailMoodMeta}}">{{detailMoodMeta.emoji}} {{detailMoodMeta.name}}</text>
          </view>
        </view>
        <text wx:if="{{detailBrightness === 1}}" class="detail-dim-note">隐没的星，也是夜空的居民。它只是需要一点时间，再亮起来。</text>

        <!-- 当日卡牌 -->
        <view class="detail-card-row" wx:if="{{detailCard}}">
          <view class="detail-card-dot">🃏</view>
          <view class="detail-card-info">
            <text class="detail-card-name">{{detailCard.name_zh}}</text>
            <text class="detail-card-meaning">{{detailCard.meaning_upright}}</text>
          </view>
        </view>

        <!-- 情绪档（6 档 → 星光亮度） -->
        <text class="modal-label">让这一天更亮一点</text>
        <view class="detail-mood-row">
          <view
            wx:for="{{moodChips}}" wx:key="mood"
            class="detail-chip {{detailMood === item.mood ? 'detail-chip--selected' : ''}}"
            data-mood="{{item.mood}}"
            bindtap="onDetailMoodSelect"
            role="button"
            aria-label="选择星光亮度：{{item.name}}"
          >
            <text class="detail-chip-emoji">{{item.emoji}}</text>
            <text class="detail-chip-name">{{item.name}}</text>
            <view class="detail-chip-stars">
              <text class="detail-chip-star {{item.brightness <= 2 ? 'detail-chip-star--dim' : ''}}">{{item.starGlyph}}</text>
            </view>
          </view>
        </view>

        <!-- 反思引导 + 可选文字 -->
        <view class="reflection-prompt-card" wx:if="{{detailReflectionPrompt}}">
          <text class="reflection-prompt-label">💫 今日反思</text>
          <text class="reflection-prompt-question">{{detailReflectionPrompt}}</text>
        </view>
        <text class="modal-label">星语（可选）</text>
        <textarea
          class="reflection-input"
          placeholder="此刻的心事，交给星光收好…"
          value="{{detailReflection}}"
          bindinput="onDetailReflectionInput"
          maxlength="500"
        />
        <text class="char-count">{{detailReflection.length}}/500</text>

        <!-- 图片（复用旧日记上传） -->
        <view class="image-picker-wrap">
          <view wx:if="{{!detailSelectedImage && !detailImage}}" class="image-picker-btn" bindtap="onDetailChooseImage" role="button" aria-label="添加图片">
            <text class="image-picker-icon">+</text>
            <text class="image-picker-label">添加图片</text>
          </view>
          <view wx:else class="image-preview-wrap">
            <image
              class="image-preview"
              src="{{detailSelectedImage || detailImage}}"
              mode="aspectFill"
              aria-label="已选图片预览"
            />
            <view wx:if="{{detailSelectedImage}}" class="image-remove-btn" bindtap="onDetailRemoveImage" role="button" aria-label="移除图片">
              <text class="image-remove-btn-char">✕</text>
            </view>
          </view>
          <!-- M-2：已保存图片的删除入口（PUT image_url 置空） -->
          <view wx:if="{{detailImage && !detailSelectedImage}}" class="image-saved-delete" bindtap="onDetailRemoveSavedImage" role="button" aria-label="删除图片">
            <text class="image-saved-delete-text">删除图片</text>
          </view>
        </view>

        <!-- 保存 / 删除 -->
        <button
          class="btn-submit"
          bindtap="onDetailSave"
          disabled="{{detailSaving || !detailEntry || !detailEntry.id}}"
        >
          {{detailSaving ? '让星光更亮一点…' : '让这一天更亮一点 ✦'}}
        </button>
        <text wx:if="{{detailHasStar && (!detailEntry || !detailEntry.id)}}" class="detail-edit-hint">较早的记录仅可查看星光，暂不可编辑</text>
        <!-- I-1：匿名分享海报（复用旧 diary share-poster 流程） -->
        <view wx:if="{{detailEntry && detailEntry.id}}" class="detail-share" bindtap="onDetailShare" role="button" aria-label="生成分享图">
          <text class="detail-share-text">✦ 生成分享图</text>
        </view>
        <view wx:if="{{detailEntry && detailEntry.id}}" class="detail-delete" bindtap="onDetailDelete" role="button" aria-label="删除这一天">
          <text class="detail-delete-text">{{detailDeleting ? '删除中…' : '删除这一天'}}</text>
        </view>
      </block>

      <!-- ── 未记录 · 今天：引导点亮 ── -->
      <block wx:elif="{{detailIsToday}}">
        <view class="detail-empty">
          <view class="detail-empty-dust"></view>
          <text class="detail-empty-title">留一颗星的位子</text>
          <text class="detail-empty-sub">今晚的星，等你来点亮 · 3 秒完成</text>
        </view>
        <view class="quick-row quick-row--sheet">
          <view
            wx:for="{{quickLevels}}" wx:key="level"
            class="quick-level {{quickSaving ? 'quick-level--busy' : ''}}"
            data-mood="{{item.mood}}"
            bindtap="onQuickRecord"
            role="button"
            aria-label="记一颗{{item.name}}（{{item.hint}}）"
            hover-class="quick-level--press"
          >
            <view class="quick-glyph-wrap">
              <text class="quick-glyph {{item.level <= 2 ? 'quick-glyph--dim' : ''}} {{item.level === 1 ? 'quick-glyph--faint' : ''}}">{{item.glyph}}</text>
            </view>
            <text class="quick-name">{{item.name}}</text>
          </view>
        </view>
      </block>

      <!-- ── 未记录 · 过去/未来：温柔留白 ── -->
      <block wx:else>
        <view class="detail-empty">
          <view class="detail-empty-dust"></view>
          <text wx:if="{{detailIsFuture}}" class="detail-empty-title">这一天还在前方</text>
          <text wx:else class="detail-empty-title">留一颗星的位子</text>
          <text wx:if="{{detailIsFuture}}" class="detail-empty-sub">未来的夜空，还留着你的星光 ✦</text>
          <text wx:else class="detail-empty-sub">夜空从不催促，星会等你 ✦</text>
        </view>
      </block>

    </view>
  </view>

  <!-- I-1：日记精选分享海报（匿名 · 复用旧 diary share-poster） -->
  <share-poster
    wx:if="{{diaryShareData}}"
    mode="diary"
    visible="{{showDiarySharePoster}}"
    moodEmoji="{{diaryShareData.moodEmoji}}"
    dateText="{{diaryShareData.date}}"
    cardImagePath="{{diaryShareData.cardImagePath}}"
    cardName="{{diaryShareData.cardName}}"
    excerpt="{{diaryShareData.excerpt}}"
    bind:close="onCloseDiarySharePoster"
    bind:share="onShareDiaryPosterToFriend"
  />

</view>
