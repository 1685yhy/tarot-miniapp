.container{padding:24rpx;background:var(--color-bg);min-height:100vh;padding-bottom:60rpx}
.header{text-align:center;padding:30rpx 0}.header-title{font-size:36rpx;font-weight:700;color:var(--color-gold);display:block}.header-sub{font-size:24rpx;color:var(--color-text-dim);display:block;margin-top:6rpx}
.create-btn{width:100%;background:linear-gradient(135deg,var(--color-gold),var(--color-gold-light));color:#1a1a2e;font-weight:600;border-radius:48rpx;padding:24rpx 0;font-size:30rpx;margin-bottom:28rpx;border:none}
.entries{display:flex;flex-direction:column;gap:16rpx}.entry-card{background:var(--color-bg-card);border-radius:16rpx;padding:24rpx;border:1rpx solid rgba(201,169,110,0.08)}.entry-header{display:flex;justify-content:space-between;margin-bottom:10rpx}.entry-date{font-size:24rpx;color:var(--color-text-dim)}.entry-mood{font-size:32rpx}.entry-reflection{font-size:28rpx;color:var(--color-text-primary);line-height:1.7;display:block}
.empty{text-align:center;padding:100rpx 0}.empty-icon{font-size:64rpx;display:block}.empty-text{font-size:28rpx;color:var(--color-text-secondary);display:block;margin-top:16rpx}.empty-hint{font-size:24rpx;color:var(--color-text-dim);display:block;margin-top:8rpx}
.modal-mask{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.7);display:flex;align-items:flex-end;z-index:100}.modal-content{width:100%;background:var(--color-bg-card);border-radius:32rpx 32rpx 0 0;padding:40rpx 32rpx 60rpx;max-height:80vh;overflow-y:auto}.modal-title{font-size:32rpx;font-weight:700;color:var(--color-gold);display:block;text-align:center;margin-bottom:28rpx}.modal-label{font-size:26rpx;color:var(--color-text-secondary);display:block;margin-bottom:12rpx;margin-top:20rpx}.mood-grid{display:flex;flex-wrap:wrap;gap:12rpx}.mood-item{padding:14rpx 24rpx;border-radius:24rpx;font-size:26rpx;background:var(--color-bg);color:var(--color-text-secondary);border:2rpx solid transparent}.mood-item.selected{border-color:var(--color-gold);color:var(--color-gold);background:rgba(201,169,110,0.08)}.reflection-input{width:100%;min-height:160rpx;background:var(--color-bg);border-radius:16rpx;padding:20rpx;font-size:26rpx;color:var(--color-text-primary);box-sizing:border-box}.char-count{text-align:right;font-size:22rpx;color:var(--color-text-dim);margin-top:8rpx;display:block}.submit-btn{width:100%;background:linear-gradient(135deg,var(--color-gold),var(--color-gold-light));color:#1a1a2e;font-weight:600;border-radius:48rpx;padding:24rpx 0;font-size:30rpx;margin-top:32rpx;border:none}.submit-btn[disabled]{opacity:.5}
