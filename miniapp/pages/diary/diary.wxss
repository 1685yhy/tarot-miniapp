/* ============================================================
   Diary Page — 柔光星辰
   Night journal aesthetic · Dark cards with golden date headers
   Soft starlight on every entry
   ============================================================ */

/* ---- Old variable aliases (WXML inline style compat) ---- */
page {
  --space-massive: var(--spacing-5xl);
  --space-xxxl: var(--spacing-3xl);
  --space-xxl: var(--spacing-2xl);
  --space-xl: var(--spacing-xl);
  --space-lg: var(--spacing-lg);
  --space-md: var(--spacing-md);
  --space-sm: var(--spacing-sm);
  --space-xs: var(--spacing-xs);
  --fs-h3: var(--font-size-xl);
  --fs-h4: var(--font-size-lg);
  --fs-body: var(--font-size-base);
  --fs-body-small: var(--font-size-sm);
  --fs-caption: var(--font-size-xs);
  --lh-loose: var(--line-height-loose);
  --lh-normal: var(--line-height-base);
  --fw-semibold: var(--font-weight-semibold);
  --fw-bold: var(--font-weight-bold);
  --fw-medium: var(--font-weight-medium);
  --duration-normal: var(--duration-base);
  --duration-fast: var(--duration-fast);
  --ease-out: var(--ease-out);
  --ease-in-out: var(--ease-in-out);
  --color-star-subtle: rgba(244, 212, 140, 0.12);
  --color-text-secondary: var(--color-text-secondary);
  --color-text-primary: var(--color-text-primary);
}

/* ---------------------------------------------------------------
   Container — Dark indigo night sky
   --------------------------------------------------------------- */
.container {
  padding: var(--spacing-xl);
  padding-bottom: calc(var(--safe-area-bottom) + var(--spacing-5xl));
  min-height: 100vh;
  position: relative;
  z-index: 1;
}

/* ---------------------------------------------------------------
   text-dim — class alias for old WXML
   --------------------------------------------------------------- */
.text-dim {
  color: var(--color-text-secondary);
  font-size: var(--font-size-sm);
}

.text-secondary {
  color: var(--color-text-secondary);
  font-size: var(--font-size-base);
}

.text-body {
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  line-height: var(--line-height-base);
}

/* ---- Heading overrides ---- */
.heading-2 {
  font-size: var(--font-size-2xl);
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
  text-align: center;
}

/* ---------------------------------------------------------------
   Error State
   --------------------------------------------------------------- */
.error-state {
  text-align: center;
  padding: var(--spacing-5xl) var(--spacing-xl);
}

.error-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: var(--spacing-md);
  opacity: 0.40;
}

.error-text {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--spacing-xs);
}

.error-hint {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
  display: block;
  margin-bottom: var(--spacing-2xl);
}

.btn-small {
  font-size: var(--font-size-sm);
  padding: 16rpx 36rpx;
}

/* ---------------------------------------------------------------
   Empty State
   --------------------------------------------------------------- */
.empty-state {
  text-align: center;
  padding: var(--spacing-5xl) 0;
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: var(--spacing-md);
  opacity: 0.40;
}

.empty-text {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--spacing-xs);
}

.empty-hint {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
  display: block;
}

/* ---- anim-glow-pulse ---- */
.anim-glow-pulse {
  animation: glow-pulse 2.5s ease-in-out infinite;
}

@keyframes glow-pulse {
  0%, 100% { box-shadow: 0 0 10rpx rgba(244, 212, 140, 0.08), var(--shadow-gold-button); }
  50% { box-shadow: 0 0 30rpx rgba(244, 212, 140, 0.20), var(--shadow-gold-button); }
}

/* ---------------------------------------------------------------
   Entries — Dark cards with golden date headers
   --------------------------------------------------------------- */
.entries {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-lg);
}

.entry-card {
  background: var(--color-card);
  border: 1rpx solid var(--color-card-border);
  border-radius: var(--radius-lg);
  padding: var(--spacing-xl);
  box-shadow: var(--shadow-card);
  transition: all var(--duration-base) var(--ease-soft);
  position: relative;
  overflow: hidden;
}

/* Subtle golden top glow */
.entry-card::before {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -80rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(244, 212, 140, 0.06) 0%, transparent 70%);
  pointer-events: none;
}

.entry-card:active {
  border-color: var(--color-card-border-hover);
  box-shadow: var(--shadow-elevated);
  transform: translateY(-2rpx);
}

.entry-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-md);
  padding-bottom: var(--spacing-sm);
  border-bottom: 1rpx solid rgba(244, 212, 140, 0.10);
}

/* Golden date text */
.entry-header .text-dim {
  color: var(--color-gold);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  letter-spacing: 1rpx;
}

.entry-card-section {
  background: rgba(244, 212, 140, 0.06);
  border: 1rpx solid rgba(244, 212, 140, 0.10);
  border-radius: var(--radius-md);
  padding: var(--spacing-md) var(--spacing-lg);
  margin-bottom: var(--spacing-md);
}

.card-name {
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-semibold);
  color: var(--color-gold);
  display: block;
  margin-bottom: var(--spacing-xs);
}

.card-meaning {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  display: block;
  line-height: var(--line-height-loose);
}

.entry-reflection {
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  line-height: var(--line-height-loose);
  display: block;
  white-space: pre-wrap;
  word-break: break-word;
}

/* ---------------------------------------------------------------
   Modal — Bottom sheet for creating diary entry
   --------------------------------------------------------------- */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(10, 10, 30, 0.60);
  z-index: var(--z-overlay);
  animation: overlay-in var(--duration-base) var(--ease-soft) forwards;
}

@keyframes overlay-in {
  0% { opacity: 0; }
  100% { opacity: 1; }
}

.modal-content {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--color-surface);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  z-index: var(--z-modal);
  padding: var(--spacing-3xl) var(--spacing-2xl) calc(var(--spacing-5xl) + var(--safe-area-bottom));
  max-height: 80vh;
  overflow-y: auto;
  animation: modal-in 0.5s var(--ease-soft);
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.30);
}

@keyframes modal-in {
  0% { transform: translateY(100%); opacity: 0; }
  100% { transform: translateY(0); opacity: 1; }
}

.modal-title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-bold);
  color: var(--color-gold);
  display: block;
  text-align: center;
  margin-bottom: var(--spacing-2xl);
  letter-spacing: 2rpx;
}

/* ---- Mood Grid ---- */
.mood-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-2xl);
}

.mood-item {
  padding: 14rpx var(--spacing-xl);
  border-radius: var(--radius-pill);
  font-size: var(--font-size-base);
  background: rgba(244, 212, 140, 0.06);
  color: var(--color-text-secondary);
  border: 1rpx solid rgba(244, 212, 140, 0.10);
  transition: all var(--duration-base);
}

.mood-item:active {
  transform: scale(0.94);
}

.mood-item.selected {
  border-color: var(--color-gold);
  color: var(--color-gold);
  background: rgba(244, 212, 140, 0.12);
  box-shadow: 0 0 12rpx rgba(244, 212, 140, 0.10);
}

/* ---- Reflection Textarea ---- */
.reflection-input {
  width: 100%;
  min-height: 200rpx;
  background: rgba(244, 212, 140, 0.04);
  border: 1rpx solid rgba(244, 212, 140, 0.12);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  line-height: var(--line-height-loose);
  box-sizing: border-box;
  transition: border-color var(--duration-fast);
}

.reflection-input:focus {
  border-color: rgba(244, 212, 140, 0.35);
  box-shadow: 0 0 0 2rpx rgba(244, 212, 140, 0.06);
}

.reflection-input::placeholder {
  color: var(--color-text-tertiary);
}

/* ---- Submit Button ---- */
.submit-btn {
  width: 100%;
  margin-top: var(--spacing-2xl);
  background: linear-gradient(135deg, #F4D48C 0%, #E8C67A 50%, #D4B06A 100%);
  color: var(--color-text-inverse);
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  border-radius: var(--radius-pill);
  padding: 26rpx 0;
  border: none;
  box-shadow: var(--shadow-gold-button);
  transition: all var(--duration-base) var(--ease-soft);
  letter-spacing: 1rpx;
}

.submit-btn:active {
  transform: scale(0.97);
  opacity: 0.90;
  box-shadow: 0 2rpx 12rpx rgba(244, 212, 140, 0.20);
}

.submit-btn[disabled] {
  opacity: 0.30;
  box-shadow: none;
  pointer-events: none;
}

/* ---------------------------------------------------------------
   Skeleton — Dark indigo shimmer
   --------------------------------------------------------------- */
.skeleton {
  padding: var(--spacing-2xl) 0;
}

.skeleton-header-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-md);
  margin-bottom: var(--spacing-2xl);
}

.skeleton-line {
  height: 32rpx;
  border-radius: var(--radius-sm);
  background: var(--color-surface);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-line.wide { width: 280rpx; }
.skeleton-line.medium { width: 200rpx; }

.skeleton-btn {
  width: 100%;
  height: 80rpx;
  border-radius: var(--radius-pill);
  background: var(--color-surface);
  margin-bottom: var(--spacing-2xl);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-entry {
  width: 100%;
  height: 140rpx;
  border-radius: var(--radius-lg);
  background: var(--color-surface);
  margin-bottom: var(--spacing-md);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

@keyframes pulse-scale {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.45; }
}

/* ---------------------------------------------------------------
   Entrance animation
   --------------------------------------------------------------- */
.anim-fade-in-up {
  opacity: 0;
  animation: fade-up 0.6s var(--ease-soft) forwards;
}

@keyframes fade-up {
  0% { opacity: 0; transform: translateY(24rpx); }
  100% { opacity: 1; transform: translateY(0); }
}
