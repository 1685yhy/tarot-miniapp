/* ===== 星光日记 - 薄暮圣殿主题 (Twilight Sanctuary) ===== */
/*    灵魂手札：烛光下的私密记录，暖色羊皮纸质感       */

/* ---------------------------------------------------------------
   Container
   --------------------------------------------------------------- */
.container {
  padding: var(--space-xl);
  padding-bottom: calc(env(safe-area-inset-bottom) + var(--space-massive));
  background: var(--color-bg);
  min-height: 100vh;
  background-image:
    var(--gradient-candle-ambient),
    var(--gradient-bg-radial),
    var(--gradient-bg-radial-gold);
}

/* ---------------------------------------------------------------
   Page Heading
   --------------------------------------------------------------- */
.page-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-xxl);
  padding-bottom: var(--space-lg);
  border-bottom: 1rpx solid var(--color-divider);
}

.page-title {
  font-size: var(--fs-h3);
  font-weight: var(--fw-bold);
  color: var(--color-gold-light);
  letter-spacing: var(--ls-heading);
  display: block;
}

.new-entry-btn {
  font-size: var(--fs-body-small);
  color: var(--color-gold);
  background: var(--color-gold-subtle);
  border: none;
  padding: var(--space-sm) var(--space-xl);
  border-radius: var(--radius-round);
  font-weight: var(--fw-semibold);
  transition: all var(--duration-fast);
}

.new-entry-btn:active {
  background: var(--color-gold);
  color: var(--color-text-on-gold);
  transform: scale(0.95);
}

/* ---------------------------------------------------------------
   Entries — 日记条目（暖色羊皮纸卡片）
   --------------------------------------------------------------- */
.entries {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}

.entry-card {
  border-radius: var(--radius-lg);
  padding: var(--space-xl);
  position: relative;
  overflow: hidden;
  background: linear-gradient(145deg,
    var(--color-bg-card-warm),
    var(--color-bg-mid));
  border: 1rpx solid var(--color-border-subtle);
  box-shadow: var(--shadow-card-warm);
  transition: all var(--duration-normal) var(--ease-out);
}

.entry-card:active {
  border-color: var(--color-border-glow);
  transform: scale(0.98);
  box-shadow: var(--shadow-card-elevated), var(--shadow-glow-gold);
}

/* 顶部暖光扫线 */
.entry-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 2rpx;
  background: linear-gradient(90deg,
    transparent, var(--color-gold-subtle), transparent);
  opacity: 0.4;
  pointer-events: none;
}

/* 左边界装饰 — 金色竖线（像书签线） */
.entry-card::after {
  content: '';
  position: absolute;
  left: 0;
  top: var(--space-xl);
  bottom: var(--space-xl);
  width: 3rpx;
  background: linear-gradient(180deg,
    var(--color-gold-subtle),
    var(--color-purple-subtle),
    transparent);
  border-radius: 2rpx;
}

.entry-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: var(--space-sm);
  padding-left: var(--space-lg);
}

.entry-date {
  font-size: var(--fs-caption);
  color: var(--color-text-dim);
  display: block;
  letter-spacing: 1rpx;
}

.entry-mood {
  font-size: 32rpx;
  display: block;
  flex-shrink: 0;
}

.entry-reflection {
  font-size: var(--fs-body);
  color: var(--color-text-primary);
  line-height: var(--lh-loose);
  display: block;
  padding-left: var(--space-lg);
  white-space: pre-wrap;
  word-break: break-word;
}

/* ---------- Empty state inside entries ---------- */
.entries-empty {
  text-align: center;
  padding: var(--space-massive) 0;
}

.entries-empty-icon {
  font-size: 72rpx;
  display: block;
  margin-bottom: var(--space-lg);
  opacity: 0.5;
}

.entries-empty-text {
  font-size: var(--fs-body);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--space-xs);
}

.entries-empty-hint {
  font-size: var(--fs-body-small);
  color: var(--color-text-dim);
  display: block;
}

/* ---------------------------------------------------------------
   Modal / Sheet — 新建条目弹窗 (底部弹出)
   --------------------------------------------------------------- */
.modal-content {
  width: 100%;
  background: linear-gradient(180deg,
    var(--color-bg-card-warm),
    var(--color-bg-mid));
  border-radius: var(--radius-xxl) var(--radius-xxl) 0 0;
  padding: var(--space-xxxl) var(--space-xxl) calc(var(--space-massive) + env(safe-area-inset-bottom));
  max-height: 80vh;
  overflow-y: auto;
  animation: fade-in-up 0.5s var(--ease-out);
}

.modal-title {
  font-size: var(--fs-h4);
  font-weight: var(--fw-bold);
  color: var(--color-gold);
  display: block;
  text-align: center;
  margin-bottom: var(--space-xxl);
  letter-spacing: var(--ls-heading);
}

/* Mood grid — 情绪选择 (暖色系) */
.mood-label {
  font-size: var(--fs-body-small);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--space-md);
  letter-spacing: 1rpx;
}

.mood-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
  margin-bottom: var(--space-xxl);
}

.mood-item {
  padding: 14rpx var(--space-xl);
  border-radius: var(--radius-round);
  font-size: var(--fs-body);
  background: var(--color-bg);
  color: var(--color-text-secondary);
  border: 2rpx solid transparent;
  transition: all var(--duration-normal);
}

.mood-item:active {
  transform: scale(0.94);
}

.mood-item.selected {
  border-color: var(--color-gold);
  color: var(--color-gold);
  background: var(--color-gold-subtle);
  box-shadow: 0 0 16rpx var(--color-gold-glow);
}

/* Reflection textarea */
.reflection-input {
  width: 100%;
  min-height: 200rpx;
  background: var(--color-bg);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  font-size: var(--fs-body);
  color: var(--color-text-primary);
  line-height: var(--lh-loose);
  box-sizing: border-box;
  border: 1rpx solid var(--color-border-subtle);
  transition: border-color var(--duration-fast);
}

.reflection-input:focus {
  border-color: var(--color-gold);
  box-shadow: var(--shadow-glow-gold);
}

.reflection-input::placeholder {
  color: var(--color-text-muted);
}

/* Save button */
.save-btn {
  width: 100%;
  margin-top: var(--space-xxl);
  background: var(--gradient-gold);
  color: var(--color-text-on-gold);
  font-size: var(--fs-h4);
  font-weight: var(--fw-bold);
  border-radius: var(--radius-button);
  padding: 26rpx 0;
  border: none;
  box-shadow: var(--shadow-button);
  transition: all var(--duration-normal) var(--ease-out);
}

.save-btn:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 8rpx var(--color-gold-glow);
}

.save-btn[disabled] {
  opacity: 0.4;
}

/* ---------------------------------------------------------------
   Skeleton
   --------------------------------------------------------------- */
.skeleton {
  padding: var(--space-xxl) 0;
}

.skeleton-header-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-md);
  margin-bottom: var(--space-xxl);
}

.skeleton-line {
  height: 32rpx;
  border-radius: var(--radius-sm);
  background: var(--color-bg-card);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-line.wide { width: 280rpx; }
.skeleton-line.medium { width: 200rpx; }

.skeleton-btn {
  width: 100%;
  height: 80rpx;
  border-radius: var(--radius-round);
  background: var(--color-bg-card);
  margin-bottom: var(--space-xxl);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-entry {
  width: 100%;
  height: 140rpx;
  border-radius: var(--radius-lg);
  background: var(--color-bg-card);
  margin-bottom: var(--space-md);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

/* ---------------------------------------------------------------
   Error
   --------------------------------------------------------------- */
.error-state {
  text-align: center;
  padding: var(--space-massive) var(--space-xl);
}

.error-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: var(--space-md);
  opacity: 0.5;
}

.error-text {
  font-size: var(--fs-body);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--space-xs);
}

.error-hint {
  font-size: var(--fs-body-small);
  color: var(--color-text-dim);
  display: block;
  margin-bottom: var(--space-xxl);
}
