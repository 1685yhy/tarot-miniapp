/* ============================================================
   Diary — Warm Paper Design System
   Warm ivory base, deep rose accent, sage subtle
   Journal entry cards, mood grid, reflection modal
   ============================================================ */

/* -----------------------------------------------------------
   1. CONTAINER
   ----------------------------------------------------------- */

.container {
  padding: var(--page-padding);
  padding-bottom: calc(var(--page-padding) + var(--safe-area-bottom));
  min-height: 100vh;
  position: relative;
  z-index: var(--z-base);
}

/* -----------------------------------------------------------
   2. COLOR UTILITIES
   ----------------------------------------------------------- */

.accent {
  color: var(--color-accent);
}

.subtle {
  color: var(--color-subtle);
}

/* -----------------------------------------------------------
   3. TEXT HELPERS
   ----------------------------------------------------------- */

.text-dim {
  color: var(--color-text-secondary);
  font-size: var(--font-size-body);
}

.text-secondary {
  color: var(--color-text-secondary);
  font-size: var(--font-size-body);
}

.text-body {
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  line-height: var(--line-height-body);
}

.heading-2 {
  font-size: var(--font-size-subhead);
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
  text-align: center;
  letter-spacing: var(--letter-spacing-none);
}

/* -----------------------------------------------------------
   4. ERROR STATE
   ----------------------------------------------------------- */

.error-state {
  text-align: center;
  padding: var(--spacing-8) var(--spacing-6);
}

.error-icon {
  width: 80rpx;
  height: 80rpx;
  display: block;
  margin: 0 auto var(--spacing-5);
  opacity: 0.30;
}

.error-text {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--spacing-3);
}

.error-hint {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--spacing-6);
  opacity: 0.70;
}

.btn-small {
  font-size: var(--font-size-body);
  padding: var(--spacing-4) var(--spacing-6);
}

/* -----------------------------------------------------------
   5. EMPTY STATE
   ----------------------------------------------------------- */

.empty-state {
  text-align: center;
  padding: var(--spacing-8) 0;
}

.empty-icon {
  width: 80rpx;
  height: 80rpx;
  display: block;
  margin: 0 auto var(--spacing-5);
  opacity: 0.30;
}

.empty-text {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--spacing-3);
}

.empty-hint {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  display: block;
  opacity: 0.70;
}

/* -----------------------------------------------------------
   6. CREATE BUTTON
   ----------------------------------------------------------- */

.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-accent);
  color: var(--color-surface);
  font-size: var(--font-size-body-large);
  font-weight: var(--font-weight-semibold);
  border-radius: var(--radius-pill);
  padding: var(--spacing-5) 0;
  border: none;
  box-shadow: var(--shadow-subtle);
  transition: all var(--duration-navigation) ease;
  letter-spacing: var(--letter-spacing-none);
}

.btn-primary:active {
  transform: scale(0.97);
  opacity: 0.90;
  box-shadow: var(--shadow-subtle);
}

/* -----------------------------------------------------------
   7. ENTRIES — Card list
   ----------------------------------------------------------- */

.entries {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-5);
}

.entry-card {
  background: var(--color-surface);
  border: 1rpx solid rgba(139, 126, 110, 0.12);
  border-radius: var(--radius-medium);
  padding: var(--spacing-6);
  box-shadow: var(--shadow-subtle);
  transition: all var(--duration-navigation) ease;
  position: relative;
  overflow: hidden;
}

.entry-card:active {
  border-color: rgba(176, 102, 80, 0.20);
  box-shadow: var(--shadow-medium);
  transform: translateY(-2rpx);
}

.entry-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-4);
  padding-bottom: var(--spacing-4);
  border-bottom: 1rpx solid rgba(139, 126, 110, 0.08);
}

.entry-header .text-dim {
  color: var(--color-accent);
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-semibold);
  letter-spacing: var(--letter-spacing-none);
}

.entry-card-section {
  background: rgba(176, 102, 80, 0.04);
  border: 1rpx solid rgba(176, 102, 80, 0.08);
  border-radius: var(--radius-small);
  padding: var(--spacing-4) var(--spacing-5);
  margin-bottom: var(--spacing-4);
}

.card-name {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-semibold);
  color: var(--color-accent);
  display: block;
  margin-bottom: var(--spacing-3);
  letter-spacing: var(--letter-spacing-none);
}

.card-meaning {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  display: block;
  line-height: var(--line-height-body);
}

.entry-reflection {
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  line-height: var(--line-height-body);
  display: block;
  white-space: pre-wrap;
  word-break: break-word;
}

/* -----------------------------------------------------------
   8. MODAL
   ----------------------------------------------------------- */

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--color-overlay);
  z-index: var(--z-overlay);
  animation: fade-in var(--duration-navigation) ease forwards;
}

.modal-content {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--color-surface);
  border-top: 1rpx solid rgba(139, 126, 110, 0.12);
  border-radius: var(--radius-medium) var(--radius-medium) 0 0;
  z-index: var(--z-modal);
  padding: var(--spacing-7) var(--spacing-6) calc(var(--spacing-8) + var(--safe-area-bottom));
  max-height: 80vh;
  overflow-y: auto;
  animation: slide-in var(--duration-navigation) ease;
  box-shadow: 0 -4rpx 24rpx rgba(61, 50, 40, 0.10);
}

.modal-title {
  font-size: var(--font-size-subhead);
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
  display: block;
  text-align: center;
  margin-bottom: var(--spacing-6);
  letter-spacing: var(--letter-spacing-none);
}

/* Mood Grid */
.mood-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-3);
  margin-bottom: var(--spacing-6);
}

.mood-item {
  padding: var(--spacing-3) var(--spacing-6);
  border-radius: var(--radius-pill);
  font-size: var(--font-size-body);
  background: rgba(176, 102, 80, 0.04);
  color: var(--color-text-secondary);
  border: 1rpx solid rgba(176, 102, 80, 0.08);
  transition: all var(--duration-navigation);
}

.mood-item:active {
  transform: scale(0.94);
}

.mood-item.selected {
  border-color: var(--color-accent);
  color: var(--color-accent);
  background: rgba(176, 102, 80, 0.08);
}

/* Reflection Textarea */
.reflection-input {
  width: 100%;
  min-height: 200rpx;
  background: var(--color-bg);
  border: 1rpx solid rgba(139, 126, 110, 0.15);
  border-radius: var(--radius-medium);
  padding: var(--spacing-5);
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  line-height: var(--line-height-body);
  box-sizing: border-box;
  transition: border-color var(--duration-feedback);
}

.reflection-input:focus {
  border-color: var(--color-accent);
  box-shadow: 0 0 0 2rpx rgba(176, 102, 80, 0.10);
}

.reflection-input::placeholder {
  color: var(--color-text-secondary);
  opacity: 0.50;
}

/* Submit Button */
.submit-btn {
  width: 100%;
  margin-top: var(--spacing-6);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-accent);
  color: var(--color-surface);
  font-size: var(--font-size-body-large);
  font-weight: var(--font-weight-semibold);
  border-radius: var(--radius-pill);
  padding: var(--spacing-5) 0;
  border: none;
  box-shadow: var(--shadow-subtle);
  transition: all var(--duration-navigation) ease;
  letter-spacing: var(--letter-spacing-none);
}

.submit-btn:active {
  transform: scale(0.97);
  opacity: 0.90;
  box-shadow: var(--shadow-subtle);
}

.submit-btn[disabled] {
  opacity: 0.30;
  box-shadow: none;
  pointer-events: none;
}

/* -----------------------------------------------------------
   9. SKELETON
   ----------------------------------------------------------- */

.skeleton {
  padding: var(--spacing-6) 0;
}

.skeleton-header-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-4);
  margin-bottom: var(--spacing-6);
}

.skeleton-line {
  height: 32rpx;
  border-radius: var(--radius-small);
  background: rgba(139, 126, 110, 0.08);
  animation: pulse-soft 1500ms ease-in-out infinite;
}

.skeleton-line.wide { width: 280rpx; }
.skeleton-line.medium { width: 200rpx; }

.skeleton-btn {
  width: 100%;
  height: 80rpx;
  border-radius: var(--radius-pill);
  background: rgba(139, 126, 110, 0.08);
  margin-bottom: var(--spacing-6);
  animation: pulse-soft 1500ms ease-in-out infinite;
}

.skeleton-entry {
  width: 100%;
  height: 140rpx;
  border-radius: var(--radius-medium);
  background: rgba(139, 126, 110, 0.08);
  margin-bottom: var(--spacing-4);
  animation: pulse-soft 1500ms ease-in-out infinite;
}

/* -----------------------------------------------------------
   10. ENTRANCE ANIMATIONS
   ----------------------------------------------------------- */

.anim-fade-in-up {
  opacity: 0;
  animation: fade-up var(--duration-emphasis) ease forwards;
}
