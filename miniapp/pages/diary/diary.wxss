/* ===== 星光日记 - 洁净手帐主题 ===== */
/*    白纸般的干净底色，日记条目为白色卡片    */

/* ---------------------------------------------------------------
   Container — 柔和米白底
   --------------------------------------------------------------- */
.container {
  padding: var(--space-xl);
  padding-bottom: calc(env(safe-area-inset-bottom) + var(--space-massive));
  background: #FAF8F6;
  min-height: 100vh;
}

/* ---------------------------------------------------------------
   Entries — 白色卡片列表
   --------------------------------------------------------------- */
.entries {
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
}

.entry-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: var(--space-xl);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04), 0 1rpx 4rpx rgba(0, 0, 0, 0.02);
  transition: all var(--duration-normal) var(--ease-out);
  position: relative;
}

.entry-card:active {
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  transform: translateY(-2rpx);
}

.entry-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-md);
  padding-bottom: var(--space-sm);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
}

.entry-card-section {
  background: #F7F4F1;
  border-radius: 16rpx;
  padding: var(--space-md) var(--space-lg);
  margin-bottom: var(--space-md);
}

.card-name {
  font-size: var(--fs-body);
  font-weight: var(--fw-semibold);
  color: #4A4238;
  display: block;
  margin-bottom: var(--space-xs);
}

.card-meaning {
  font-size: var(--fs-body-small);
  color: #7A7268;
  display: block;
  line-height: var(--lh-loose);
}

.entry-reflection {
  font-size: var(--fs-body);
  color: #3A342E;
  line-height: var(--lh-loose);
  display: block;
  white-space: pre-wrap;
  word-break: break-word;
}

/* ---------------------------------------------------------------
   Modal — 新建日记弹窗
   --------------------------------------------------------------- */
.modal-content {
  width: 100%;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: var(--space-xxxl) var(--space-xxl) calc(var(--space-massive) + env(safe-area-inset-bottom));
  max-height: 80vh;
  overflow-y: auto;
  animation: fade-in-up 0.5s var(--ease-out);
}

.modal-title {
  font-size: var(--fs-h4);
  font-weight: var(--fw-bold);
  color: #3A342E;
  display: block;
  text-align: center;
  margin-bottom: var(--space-xxl);
  letter-spacing: 1rpx;
}

/* Mood grid — 情绪选择 */
.mood-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
  margin-bottom: var(--space-xxl);
}

.mood-item {
  padding: 14rpx var(--space-xl);
  border-radius: 40rpx;
  font-size: var(--fs-body);
  background: #F7F4F1;
  color: #6A6258;
  border: 2rpx solid transparent;
  transition: all var(--duration-normal);
}

.mood-item:active {
  transform: scale(0.94);
}

.mood-item.selected {
  border-color: #8B7E6E;
  color: #4A4238;
  background: #EDE8E2;
}

/* Reflection textarea */
.reflection-input {
  width: 100%;
  min-height: 200rpx;
  background: #FAF8F6;
  border-radius: 20rpx;
  padding: var(--space-lg);
  font-size: var(--fs-body);
  color: #3A342E;
  line-height: var(--lh-loose);
  box-sizing: border-box;
  border: 1rpx solid #E8E4DF;
  transition: border-color var(--duration-fast);
}

.reflection-input:focus {
  border-color: #8B7E6E;
}

.reflection-input::placeholder {
  color: #B5ADA5;
}

/* Submit button */
.submit-btn {
  width: 100%;
  margin-top: var(--space-xxl);
  background: #4A4238;
  color: #FFFFFF;
  font-size: var(--fs-h4);
  font-weight: var(--fw-semibold);
  border-radius: 40rpx;
  padding: 26rpx 0;
  border: none;
  transition: all var(--duration-normal) var(--ease-out);
  letter-spacing: 1rpx;
}

.submit-btn:active {
  transform: scale(0.97);
  opacity: 0.9;
}

.submit-btn[disabled] {
  opacity: 0.35;
}

/* ---------------------------------------------------------------
   Skeleton — 浅灰骨架
   --------------------------------------------------------------- */
.skeleton {
  padding: var(--space-xxl) 0;
}

.skeleton-header-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-md);
  margin-bottom: var(--space-xxl);
}

.skeleton-line {
  height: 32rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #EDE8E3, #E8E3DE);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-line.wide { width: 280rpx; }
.skeleton-line.medium { width: 200rpx; }

.skeleton-btn {
  width: 100%;
  height: 80rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #EDE8E3, #E8E3DE);
  margin-bottom: var(--space-xxl);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-entry {
  width: 100%;
  height: 140rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #EDE8E3, #E8E3DE);
  margin-bottom: var(--space-md);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

/* ---------------------------------------------------------------
   Error — 柔和报错
   --------------------------------------------------------------- */
.error-state {
  text-align: center;
  padding: var(--space-massive) var(--space-xl);
}

.error-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: var(--space-md);
  opacity: 0.4;
}

.error-text {
  font-size: var(--fs-body);
  color: #6A6258;
  display: block;
  margin-bottom: var(--space-xs);
}

.error-hint {
  font-size: var(--fs-body-small);
  color: #9A9288;
  display: block;
  margin-bottom: var(--space-xxl);
}
