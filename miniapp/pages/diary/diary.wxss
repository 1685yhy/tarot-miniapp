/* ============================================================
   Diary Page — Starlight Design System
   Self-contained. No reliance on global CSS variables.
   #1A1A3E deep indigo · #F4D48C gold · #F0EDE8 cream text
   #252550 card surface · #C8C3E0 lavender secondary
   ============================================================ */

/* ---------- Design tokens ---------- */
page {
  --ds-bg: #1A1A3E;
  --ds-card-bg: #252550;
  --ds-card-border: rgba(244, 212, 140, 0.15);
  --ds-gold: #F4D48C;
  --ds-gold-dim: rgba(244, 212, 140, 0.08);
  --ds-gold-glow: rgba(244, 212, 140, 0.20);
  --ds-cream: #F0EDE8;
  --ds-lavender: #C8C3E0;
  --ds-muted: #9A95B8;
  --ds-text-on-gold: #1A1A3E;
  --ds-error: #FF6B7A;

  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 16rpx;
  --radius-xl: 24rpx;
  --radius-pill: 999rpx;

  background: var(--ds-bg);
  color: var(--ds-cream);
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", sans-serif;
}


/* ============================================================
   Container
   ============================================================ */
.container {
  padding: 48rpx 32rpx;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  position: relative;
  z-index: 1;
}


/* ============================================================
   Page Header
   ============================================================ */
.page-header {
  text-align: center;
  padding: 32rpx 0 40rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ds-gold);
  letter-spacing: 4rpx;
  display: block;
  margin-bottom: 12rpx;
  text-shadow: 0 0 40rpx rgba(244, 212, 140, 0.15);
}

.page-subtitle {
  font-size: 26rpx;
  color: var(--ds-lavender);
  letter-spacing: 2rpx;
  display: block;
}


/* ============================================================
   Create Button — Gold pill with soft glow
   ============================================================ */
.btn-create {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #F4D48C 0%, #E8C67A 50%, #D4B06A 100%);
  color: var(--ds-text-on-gold);
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  border-radius: var(--radius-pill);
  padding: 26rpx 0;
  margin-bottom: 48rpx;
  box-shadow:
    0 4rpx 20rpx rgba(244, 212, 140, 0.25),
    0 0 60rpx rgba(244, 212, 140, 0.08);
  letter-spacing: 2rpx;
  animation: create-glow 3s ease-in-out infinite;
}

.btn-create:active {
  transform: scale(0.97);
  opacity: 0.85;
  box-shadow: 0 2rpx 12rpx rgba(244, 212, 140, 0.15);
}

.btn-create-icon {
  font-size: 32rpx;
}

@keyframes create-glow {
  0%, 100% { box-shadow: 0 4rpx 20rpx rgba(244, 212, 140, 0.25), 0 0 60rpx rgba(244, 212, 140, 0.08); }
  50% { box-shadow: 0 4rpx 28rpx rgba(244, 212, 140, 0.35), 0 0 80rpx rgba(244, 212, 140, 0.15); }
}


/* ============================================================
   Entries Scroll View
   ============================================================ */
.entries-scroll {
  max-height: 70vh;
}

.entries {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.load-more-hint {
  text-align: center;
  padding: 32rpx 0;
}

.load-more-text {
  font-size: 24rpx;
  color: var(--ds-muted);
  letter-spacing: 2rpx;
}


/* ============================================================
   Entry Card — Dark indigo surface, subtle gold border
   ============================================================ */
.entry-card {
  background: var(--ds-card-bg);
  border: 1rpx solid var(--ds-card-border);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.20);
  position: relative;
  overflow: hidden;
  transition: all 0.3s ease;
}

/* Gold corner glow */
.entry-card::before {
  content: '';
  position: absolute;
  top: -100rpx;
  right: -100rpx;
  width: 260rpx;
  height: 260rpx;
  background: radial-gradient(circle, rgba(244, 212, 140, 0.07) 0%, transparent 70%);
  pointer-events: none;
}

/* Entry Header — Date + Mood */
.entry-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(244, 212, 140, 0.10);
}

.entry-date-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.entry-date-icon {
  font-size: 22rpx;
  color: var(--ds-gold);
}

.entry-date {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ds-gold);
  letter-spacing: 2rpx;
}

.entry-mood {
  font-size: 36rpx;
  line-height: 1;
}

/* Card Section */
.entry-card-section {
  background: rgba(244, 212, 140, 0.06);
  border: 1rpx solid rgba(244, 212, 140, 0.10);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.card-label-line {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-bottom: 8rpx;
}

.card-label-icon {
  font-size: 24rpx;
}

.card-label {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--ds-gold);
  letter-spacing: 2rpx;
  opacity: 0.75;
}

.card-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ds-gold);
  display: block;
  margin-bottom: 10rpx;
  letter-spacing: 2rpx;
}

.card-meaning {
  font-size: 24rpx;
  color: var(--ds-lavender);
  display: block;
  line-height: 1.7;
}

/* Reflection Text */
.entry-reflection {
  font-size: 26rpx;
  color: var(--ds-cream);
  line-height: 1.8;
  display: block;
  white-space: pre-wrap;
  word-break: break-word;
}


/* ============================================================
   Error State
   ============================================================ */
.error-state {
  padding: 120rpx 32rpx;
  text-align: center;
}

.error-card {
  background: var(--ds-card-bg);
  border: 1rpx solid rgba(255, 107, 122, 0.20);
  border-radius: var(--radius-lg);
  padding: 48rpx 32rpx;
}

.error-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ds-cream);
  display: block;
  margin-bottom: 12rpx;
}

.error-desc {
  font-size: 24rpx;
  color: var(--ds-muted);
  display: block;
  margin-bottom: 36rpx;
  line-height: 1.6;
}

.btn-retry {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(244, 212, 140, 0.10);
  color: var(--ds-gold);
  font-size: 24rpx;
  font-weight: 500;
  border: 1rpx solid rgba(244, 212, 140, 0.20);
  border-radius: var(--radius-pill);
  padding: 16rpx 48rpx;
  transition: all 0.2s;
}

.btn-retry:active {
  background: rgba(244, 212, 140, 0.18);
}


/* ============================================================
   Empty State — Warm, inviting
   ============================================================ */
.empty-state {
  text-align: center;
  padding: 120rpx 32rpx;
}

.empty-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(244, 212, 140, 0.08);
  border: 1rpx solid rgba(244, 212, 140, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 32rpx;
}

.empty-star {
  font-size: 52rpx;
  color: var(--ds-gold);
  opacity: 0.7;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ds-cream);
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--ds-muted);
  display: block;
  margin-bottom: 48rpx;
  line-height: 1.6;
}

.btn-empty-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #F4D48C 0%, #E8C67A 50%, #D4B06A 100%);
  color: var(--ds-text-on-gold);
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  border-radius: var(--radius-pill);
  padding: 22rpx 60rpx;
  box-shadow: 0 4rpx 20rpx rgba(244, 212, 140, 0.25);
  letter-spacing: 2rpx;
}

.btn-empty-cta:active {
  transform: scale(0.97);
  opacity: 0.85;
}

.btn-empty-cta-icon {
  font-size: 30rpx;
}


/* ============================================================
   Modal — Bottom sheet, dark indigo
   ============================================================ */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(10, 10, 30, 0.70);
  z-index: 1000;
  animation: fade-in 0.3s ease forwards;
}

@keyframes fade-in {
  0% { opacity: 0; }
  100% { opacity: 1; }
}

.modal-sheet {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #242048;
  border-top: 2rpx solid rgba(244, 212, 140, 0.20);
  border-radius: 32rpx 32rpx 0 0;
  z-index: 1001;
  padding: 16rpx 36rpx 60rpx;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
  max-height: 82vh;
  overflow-y: auto;
  animation: sheet-up 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  box-shadow: 0 -12rpx 60rpx rgba(0, 0, 0, 0.40);
}

@keyframes sheet-up {
  0% { transform: translateY(100%); opacity: 0; }
  100% { transform: translateY(0); opacity: 1; }
}

.modal-handle {
  width: 60rpx;
  height: 6rpx;
  background: rgba(244, 212, 140, 0.20);
  border-radius: var(--radius-pill);
  margin: 0 auto 32rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ds-gold);
  display: block;
  text-align: center;
  margin-bottom: 48rpx;
  letter-spacing: 3rpx;
  text-shadow: 0 0 30rpx rgba(244, 212, 140, 0.12);
}

.modal-label {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--ds-cream);
  display: block;
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
}


/* ---------- Mood Grid ---------- */
.mood-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 40rpx;
}

.mood-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 28rpx;
  border-radius: var(--radius-pill);
  background: rgba(244, 212, 140, 0.06);
  border: 1rpx solid rgba(244, 212, 140, 0.10);
  transition: all 0.25s ease;
}

.mood-item:active {
  transform: scale(0.94);
}

.mood-item.mood-selected {
  border-color: var(--ds-gold);
  background: rgba(244, 212, 140, 0.14);
  box-shadow: 0 0 20rpx rgba(244, 212, 140, 0.10);
}

.mood-emoji {
  font-size: 34rpx;
  line-height: 1;
}

.mood-label {
  font-size: 26rpx;
  color: var(--ds-cream);
  font-weight: 500;
}

.mood-selected .mood-label {
  color: var(--ds-gold);
}


/* ---------- Textarea ---------- */
.reflection-input {
  width: 100%;
  min-height: 200rpx;
  background: rgba(244, 212, 140, 0.04);
  border: 1rpx solid rgba(244, 212, 140, 0.12);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  font-size: 26rpx;
  color: var(--ds-cream);
  line-height: 1.7;
  box-sizing: border-box;
  transition: border-color 0.2s, box-shadow 0.2s;
}

.reflection-input:focus {
  border-color: rgba(244, 212, 140, 0.40);
  box-shadow: 0 0 0 3rpx rgba(244, 212, 140, 0.06);
}

.reflection-input::placeholder {
  color: #6A6588;
}

.char-count {
  font-size: 22rpx;
  color: var(--ds-muted);
  display: block;
  text-align: right;
  margin-top: 10rpx;
}


/* ---------- Submit Button ---------- */
.btn-submit {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #F4D48C 0%, #E8C67A 50%, #D4B06A 100%);
  color: var(--ds-text-on-gold);
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  border-radius: var(--radius-pill);
  padding: 26rpx 0;
  margin-top: 48rpx;
  box-shadow: 0 4rpx 20rpx rgba(244, 212, 140, 0.25);
  letter-spacing: 2rpx;
  transition: all 0.25s ease;
}

.btn-submit:active {
  transform: scale(0.97);
  opacity: 0.85;
}

.btn-submit[disabled] {
  opacity: 0.30;
  box-shadow: none;
  transform: none;
  pointer-events: none;
}


/* ============================================================
   Skeleton — Shimmer loading
   ============================================================ */
.skeleton-wrap {
  padding: 48rpx 0;
}

.skeleton-header-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 48rpx;
}

.skeleton-line {
  height: 30rpx;
  border-radius: var(--radius-sm);
  background: #252550;
  animation: shimmer 1.5s ease-in-out infinite;
}

.skeleton-line.wide { width: 280rpx; }
.skeleton-line.medium { width: 200rpx; }

.skeleton-btn {
  width: 100%;
  height: 80rpx;
  border-radius: var(--radius-pill);
  background: #252550;
  margin-bottom: 48rpx;
  animation: shimmer 1.5s ease-in-out infinite;
}

.skeleton-entry {
  width: 100%;
  height: 160rpx;
  border-radius: var(--radius-lg);
  background: #252550;
  margin-bottom: 24rpx;
  animation: shimmer 1.5s ease-in-out infinite;
}

@keyframes shimmer {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.45; }
}


/* ============================================================
   Entrance Animation
   ============================================================ */
.anim-fade-in-up {
  opacity: 0;
  animation: fade-up 0.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
}

@keyframes fade-up {
  0% { opacity: 0; transform: translateY(20rpx); }
  100% { opacity: 1; transform: translateY(0); }
}
