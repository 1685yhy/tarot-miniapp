/* ============================================================
   Diary Page — Starlight Design System
   Uses global CSS variables from styles/common.wxss.
   ============================================================ */

page {
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", sans-serif;
}


/* ============================================================
   Container
   ============================================================ */
.container {
  padding: var(--spacing-xl) var(--spacing-lg);
  padding-bottom: calc(120rpx + var(--safe-area-bottom));
  min-height: 100vh;
  position: relative;
  z-index: 1;
}


/* ============================================================
   Page Header
   ============================================================ */
.page-header {
  text-align: center;
  padding: var(--spacing-lg) 0 40rpx;
}

.page-title {
  font-size: var(--font-size-subhead);
  font-weight: 700;
  color: var(--color-gold);
  letter-spacing: 4rpx;
  display: block;
  margin-bottom: 12rpx;
  text-shadow: 0 0 40rpx rgba(244, 212, 140, 0.15);
}

.page-subtitle {
  font-size: var(--font-size-caption);
  color: var(--color-lavender);
  letter-spacing: 2rpx;
  display: block;
}


/* ============================================================
   Create Button — Gold pill with soft glow
   ============================================================ */
.btn-create {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-xs);
  background: linear-gradient(135deg, #F4D48C 0%, #E8C67A 50%, #D4B06A 100%);
  color: var(--color-text-inverse);
  font-size: var(--font-size-body);
  font-weight: 600;
  border: none;
  border-radius: var(--radius-pill);
  padding: var(--spacing-md) 0;
  margin-bottom: var(--spacing-xl);
  box-shadow:
    0 4rpx 20rpx rgba(244, 212, 140, 0.25),
    0 0 60rpx rgba(244, 212, 140, 0.08);
  letter-spacing: 2rpx;
  animation: create-glow 3s ease-in-out infinite;
}

.btn-create:active {
  transform: scale(0.97);
  opacity: 0.85;
  box-shadow: 0 2rpx 12rpx rgba(244, 212, 140, 0.15);
}

.btn-create-icon {
  width: 36rpx;
  height: 36rpx;
  display: block;
}

@keyframes create-glow {
  0%, 100% { box-shadow: 0 4rpx 20rpx rgba(244, 212, 140, 0.25), 0 0 60rpx rgba(244, 212, 140, 0.08); }
  50% { box-shadow: 0 4rpx 28rpx rgba(244, 212, 140, 0.35), 0 0 80rpx rgba(244, 212, 140, 0.15); }
}


/* ============================================================
   Entries Scroll View
   ============================================================ */
.entries-scroll {
  max-height: 70vh;
}

.entries {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

.load-more-hint {
  text-align: center;
  padding: var(--spacing-lg) 0;
}

.load-more-text {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  letter-spacing: 2rpx;
}


/* ============================================================
   Entry Card — Dark indigo surface, subtle gold border
   ============================================================ */
.entry-card {
  background: var(--color-surface);
  border: 1rpx solid rgba(244, 212, 140, 0.15);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.20);
  position: relative;
  overflow: hidden;
  transition: all 0.15s ease-out;
}

/* Gold corner glow */
.entry-card::before {
  content: '';
  position: absolute;
  top: -100rpx;
  right: -100rpx;
  width: 260rpx;
  height: 260rpx;
  background: radial-gradient(circle, rgba(244, 212, 140, 0.07) 0%, transparent 70%);
  pointer-events: none;
}

/* Entry Header — Date + Mood */
.entry-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(244, 212, 140, 0.10);
}

.entry-date-line {
  display: flex;
  align-items: center;
  gap: var(--spacing-xxs);
}

.entry-date-icon {
  font-size: var(--font-size-caption);
  color: var(--color-gold);
}

.entry-date {
  font-size: var(--font-size-caption);
  font-weight: 600;
  color: var(--color-gold);
  letter-spacing: 2rpx;
}

.entry-mood {
  font-size: var(--font-size-subhead);
  line-height: 1;
}

/* Card Section */
.entry-card-section {
  background: rgba(244, 212, 140, 0.06);
  border: 1rpx solid rgba(244, 212, 140, 0.10);
  border-radius: var(--radius-md);
  padding: var(--spacing-sm) var(--spacing-md);
  margin-bottom: 20rpx;
}

.card-label-line {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-bottom: 8rpx;
}

.card-label-icon {
  width: 24rpx;
  height: 24rpx;
  display: block;
  opacity: 0.70;
}

.card-label {
  font-size: var(--font-size-caption);
  font-weight: 500;
  color: var(--color-gold);
  letter-spacing: 2rpx;
  opacity: 0.75;
}

.card-name {
  font-size: var(--font-size-body);
  font-weight: 600;
  color: var(--color-gold);
  display: block;
  margin-bottom: 10rpx;
  letter-spacing: 2rpx;
}

.card-meaning {
  font-size: var(--font-size-caption);
  color: var(--color-lavender);
  display: block;
  line-height: 1.7;
}

/* Entry Card Thumbnail — small rounded square with gold border */
.entry-card-row {
  display: flex;
  align-items: flex-start;
  gap: var(--spacing-sm);
}

.entry-card-thumb {
  width: 56rpx;
  height: 80rpx;
  border-radius: var(--radius-sm);
  border: 1.5rpx solid rgba(244, 212, 140, 0.25);
  flex-shrink: 0;
  object-fit: cover;
}

.entry-card-info {
  flex: 1;
  min-width: 0;
}

/* Reflection Text */
.entry-reflection {
  font-size: var(--font-size-caption);
  color: var(--color-text-primary);
  line-height: 1.8;
  display: block;
  white-space: pre-wrap;
  word-break: break-word;
}


/* ============================================================
   Error State
   ============================================================ */
.error-state {
  padding: 120rpx var(--spacing-lg);
  text-align: center;
}

.error-card {
  background: var(--color-surface);
  border: 1rpx solid rgba(255, 107, 122, 0.20);
  border-radius: var(--radius-lg);
  padding: var(--spacing-xl) var(--spacing-lg);
}

.error-title {
  font-size: var(--font-size-body);
  font-weight: 600;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: 12rpx;
}

.error-desc {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  display: block;
  margin-bottom: 36rpx;
  line-height: 1.6;
}

.btn-retry {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(244, 212, 140, 0.10);
  color: var(--color-gold);
  font-size: var(--font-size-caption);
  font-weight: 500;
  border: 1rpx solid rgba(244, 212, 140, 0.20);
  border-radius: var(--radius-pill);
  padding: var(--spacing-sm) var(--spacing-xl);
  transition: all 0.2s;
}

.btn-retry:active {
  background: rgba(244, 212, 140, 0.18);
}


/* ============================================================
   Empty State — Warm, inviting
   ============================================================ */
.empty-state {
  text-align: center;
  padding: 120rpx var(--spacing-lg);
}

.empty-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(244, 212, 140, 0.08);
  border: 1rpx solid rgba(244, 212, 140, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 32rpx;
}

.empty-star {
  font-size: var(--font-size-title);
  color: var(--color-gold);
  opacity: 0.7;
}

.empty-title {
  font-size: var(--font-size-body);
  font-weight: 600;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.empty-desc {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  display: block;
  margin-bottom: var(--spacing-xl);
  line-height: 1.6;
}

.btn-empty-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-xs);
  background: linear-gradient(135deg, #F4D48C 0%, #E8C67A 50%, #D4B06A 100%);
  color: var(--color-text-inverse);
  font-size: var(--font-size-body);
  font-weight: 600;
  border: none;
  border-radius: var(--radius-pill);
  padding: var(--spacing-md) var(--spacing-2xl);
  box-shadow: 0 4rpx 20rpx rgba(244, 212, 140, 0.25);
  letter-spacing: 2rpx;
}

.btn-empty-cta:active {
  transform: scale(0.97);
  opacity: 0.85;
}

.btn-empty-cta-icon {
  font-size: var(--font-size-body);
}


/* ============================================================
   Modal — Bottom sheet, dark indigo
   ============================================================ */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(10, 10, 30, 0.70);
  z-index: 1000;
  animation: fade-in var(--duration-fast) var(--ease-out) forwards;
} /* @keyframes fade-in via common.wxss */

.modal-sheet {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--color-bg);
  border-top: 2rpx solid rgba(244, 212, 140, 0.20);
  border-radius: 32rpx 32rpx 0 0;
  z-index: 1001;
  padding: var(--spacing-sm) var(--spacing-lg) 60rpx;
  padding-bottom: calc(60rpx + var(--safe-area-bottom));
  max-height: 82vh;
  overflow-y: auto;
  animation: sheet-up 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  box-shadow: 0 -12rpx 60rpx rgba(0, 0, 0, 0.40);
}

@keyframes sheet-up {
  0% { transform: translateY(100%); opacity: 0; }
  100% { transform: translateY(0); opacity: 1; }
}

.modal-handle {
  width: 60rpx;
  height: 6rpx;
  background: rgba(244, 212, 140, 0.20);
  border-radius: var(--radius-pill);
  margin: 0 auto 32rpx;
}

.modal-title {
  font-size: var(--font-size-subhead);
  font-weight: 700;
  color: var(--color-gold);
  display: block;
  text-align: center;
  margin-bottom: var(--spacing-xl);
  letter-spacing: 3rpx;
  text-shadow: 0 0 30rpx rgba(244, 212, 140, 0.12);
}

.modal-label {
  font-size: var(--font-size-caption);
  font-weight: 500;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
}


/* ---------- Mood Grid ---------- */
.mood-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
  margin-bottom: 40rpx;
}

.mood-item {
  display: flex;
  align-items: center;
  gap: var(--spacing-xxs);
  padding: var(--spacing-sm) var(--spacing-md);
  min-height: 88rpx;
  border-radius: var(--radius-pill);
  background: rgba(244, 212, 140, 0.06);
  border: 1rpx solid rgba(244, 212, 140, 0.10);
  transition: all 0.15s ease-out;
}

.mood-item:active {
  transform: scale(0.94);
}

.mood-item.mood-selected {
  border-color: var(--color-gold);
  background: rgba(244, 212, 140, 0.14);
  box-shadow: 0 0 20rpx rgba(244, 212, 140, 0.10);
}

.mood-emoji {
  font-size: var(--font-size-subhead);
  line-height: 1;
}

.mood-label {
  font-size: var(--font-size-caption);
  color: var(--color-text-primary);
  font-weight: 500;
}

.mood-selected .mood-label {
  color: var(--color-gold);
}


/* ---------- Textarea ---------- */
.reflection-input {
  width: 100%;
  min-height: 200rpx;
  background: rgba(244, 212, 140, 0.04);
  border: 1rpx solid rgba(244, 212, 140, 0.12);
  border-radius: var(--radius-lg);
  padding: var(--spacing-md);
  font-size: var(--font-size-caption);
  color: var(--color-text-primary);
  line-height: 1.7;
  box-sizing: border-box;
  transition: border-color 0.2s, box-shadow 0.2s;
}

.reflection-input:focus {
  border-color: rgba(244, 212, 140, 0.40);
  box-shadow: 0 0 0 3rpx rgba(244, 212, 140, 0.06);
}

.reflection-input::placeholder {
  color: var(--color-text-tertiary);
}

.char-count {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  display: block;
  text-align: right;
  margin-top: 10rpx;
}


/* ---------- Submit Button ---------- */
.btn-submit {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #F4D48C 0%, #E8C67A 50%, #D4B06A 100%);
  color: var(--color-text-inverse);
  font-size: var(--font-size-body);
  font-weight: 600;
  border: none;
  border-radius: var(--radius-pill);
  padding: var(--spacing-md) 0;
  margin-top: var(--spacing-xl);
  box-shadow: 0 4rpx 20rpx rgba(244, 212, 140, 0.25);
  letter-spacing: 2rpx;
  transition: all 0.15s ease-out;
}

.btn-submit:active {
  transform: scale(0.97);
  opacity: 0.85;
}

.btn-submit[disabled] {
  opacity: 0.30;
  box-shadow: none;
  transform: none;
  pointer-events: none;
}


/* ============================================================
   Skeleton — Shapes only (shimmer from common.wxss)
   ============================================================ */
.skeleton-wrap {
  padding: var(--spacing-xl) 0;
}

.skeleton-header-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-xl);
}

.skeleton-line {
  height: 30rpx;
  border-radius: var(--radius-sm);
}

.skeleton-line.wide { width: 280rpx; }
.skeleton-line.medium { width: 200rpx; }

.skeleton-btn {
  width: 100%;
  height: 80rpx;
  border-radius: var(--radius-pill);
  margin-bottom: var(--spacing-xl);
}

.skeleton-entry {
  width: 100%;
  height: 160rpx;
  border-radius: var(--radius-lg);
  margin-bottom: 24rpx;
}

/* Entrance animation via common.wxss: .anim-fade-up */


/* ============================================================
   Diary Card Context — Today's card shown in the editor modal
   ============================================================ */
.diary-card-context {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  background: rgba(244, 212, 140, 0.06);
  border: 1rpx solid rgba(244, 212, 140, 0.12);
  border-radius: var(--radius-lg);
  padding: var(--spacing-sm) var(--spacing-md);
  margin-bottom: var(--spacing-lg);
}

.diary-card-thumb {
  width: 64rpx;
  height: 88rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}

.diary-card-thumb-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #25255A 0%, #2E2E62 100%);
  border: 1rpx solid rgba(212, 168, 83, 0.20);
}

.diary-card-fallback-name {
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-medium);
  color: var(--color-lavender-light);
  text-align: center;
  letter-spacing: 2rpx;
  line-height: 1.4;
}

.diary-card-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.diary-card-name {
  font-size: var(--font-size-body);
  font-weight: 600;
  color: var(--color-gold);
  letter-spacing: 2rpx;
}

.diary-card-hint {
  font-size: var(--font-size-caption);
  color: var(--color-lavender);
  opacity: 0.75;
}


/* ============================================================
   Retrospect Card — Weekly review summary (replaced by review-card below)
   ============================================================ */
.retrospect-card {
  display: none;
}


/* ============================================================
   Emoji Mood Trend — Warm emotional curve
   ============================================================ */
.mood-trend {
  padding: var(--spacing-sm) 0;
  margin-bottom: var(--spacing-sm);
}

.trend-line {
  display: flex;
  align-items: center;
  justify-content: space-around;
  gap: 6rpx;
  padding: 12rpx 0;
}

.trend-emoji {
  font-size: 36rpx;
  line-height: 1;
  filter: drop-shadow(0 0 8rpx rgba(244, 212, 140, 0.15));
}

.trend-curve-text {
  display: block;
  text-align: center;
  font-size: 32rpx;
  letter-spacing: 6rpx;
  padding: 8rpx 0;
  color: var(--color-gold);
  opacity: 0.85;
  line-height: 1.6;
}


/* ============================================================
   Floating AI Review Button
   ============================================================ */
.floating-review-btn {
  position: fixed;
  bottom: calc(160rpx + var(--safe-area-bottom));
  right: 32rpx;
  z-index: 900;
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: linear-gradient(135deg, rgba(244, 212, 140, 0.92) 0%, rgba(212, 176, 106, 0.92) 100%);
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
  border: 1rpx solid rgba(244, 212, 140, 0.30);
  border-radius: var(--radius-pill);
  padding: 16rpx 28rpx;
  box-shadow:
    0 4rpx 24rpx rgba(244, 212, 140, 0.25),
    0 0 40rpx rgba(244, 212, 140, 0.08);
  animation: floating-btn-enter 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.floating-review-btn:active {
  transform: scale(0.94);
  box-shadow: 0 2rpx 12rpx rgba(244, 212, 140, 0.15);
}

.floating-review-icon {
  font-size: 28rpx;
  line-height: 1;
}

.floating-review-text {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-inverse);
  letter-spacing: 2rpx;
}

@keyframes floating-btn-enter {
  0% { transform: translateY(40rpx); opacity: 0; }
  100% { transform: translateY(0); opacity: 1; }
}


/* ============================================================
   AI Weekly Review Card — Deep insight section
   ============================================================ */
.review-card {
  background: linear-gradient(135deg, rgba(244, 212, 140, 0.06) 0%, rgba(180, 140, 200, 0.06) 100%);
  border: 1.5rpx solid rgba(244, 212, 140, 0.18);
  border-radius: var(--radius-lg);
  padding: var(--spacing-md);
  margin-bottom: var(--spacing-xl);
  position: relative;
  overflow: hidden;
}

/* Subtle top glow */
.review-card::before {
  content: '';
  position: absolute;
  top: -80rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 300rpx;
  height: 160rpx;
  background: radial-gradient(circle, rgba(244, 212, 140, 0.08) 0%, transparent 70%);
  pointer-events: none;
}

.review-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-sm);
  padding-bottom: var(--spacing-sm);
  border-bottom: 1rpx solid rgba(244, 212, 140, 0.10);
}

.review-header-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.review-header-icon {
  font-size: var(--font-size-body);
}

.review-title {
  font-size: var(--font-size-body);
  font-weight: 700;
  color: var(--color-gold);
  letter-spacing: 2rpx;
}

.review-header-actions {
  display: flex;
  align-items: center;
}

.review-refresh-btn {
  font-size: var(--font-size-caption);
  color: var(--color-lavender);
  opacity: 0.75;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  transition: all 0.15s ease;
}

.review-refresh-btn:active {
  opacity: 1;
  background: rgba(244, 212, 140, 0.10);
}

.review-loading {
  padding: var(--spacing-lg) 0;
  text-align: center;
}

.review-loading-text {
  font-size: var(--font-size-caption);
  color: var(--color-lavender);
  opacity: 0.7;
}

.review-summary {
  font-size: var(--font-size-caption);
  color: var(--color-lavender);
  line-height: 1.8;
  display: block;
  letter-spacing: 1rpx;
}

.review-content {
  display: flex;
  flex-direction: column;
  gap: 0;
}

/* ---- Section label ---- */
.review-section-label {
  font-size: var(--font-size-caption);
  font-weight: 600;
  color: var(--color-gold);
  display: block;
  margin-bottom: 10rpx;
  letter-spacing: 2rpx;
  opacity: 0.85;
}

/* ---- Chart section ---- */
.chart-section {
  padding: var(--spacing-sm) 0;
  margin-bottom: var(--spacing-sm);
}

.trend-summary-text {
  font-size: var(--font-size-caption);
  color: var(--color-text-primary);
  line-height: 1.7;
  display: block;
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
}

.mood-chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  gap: 8rpx;
  padding: 10rpx 0;
  min-height: 160rpx;
}

.chart-bar-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.chart-bar-column {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.chart-bar-emoji {
  font-size: 28rpx;
  line-height: 1;
}

.chart-bar-track {
  width: 40rpx;
  height: 100rpx;
  background: rgba(244, 212, 140, 0.06);
  border-radius: 20rpx;
  position: relative;
  overflow: hidden;
  border: 1rpx solid rgba(244, 212, 140, 0.08);
}

.chart-bar-fill {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(180deg, #F4D48C 0%, #E8C67A 60%, #D4B06A 100%);
  border-radius: 20rpx;
  transition: height 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  min-height: 8rpx;
  box-shadow: 0 0 12rpx rgba(244, 212, 140, 0.15);
}

.chart-bar-label {
  font-size: 20rpx;
  color: var(--color-lavender);
  opacity: 0.65;
  letter-spacing: 1rpx;
}

/* ---- Review card sections ---- */
.review-card-section {
  padding: var(--spacing-sm) 0;
  margin-bottom: var(--spacing-sm);
  border-top: 1rpx solid rgba(244, 212, 140, 0.06);
}

.top-card-row {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  margin-bottom: 8rpx;
}

.top-card-name {
  font-size: var(--font-size-body);
  font-weight: 700;
  color: var(--color-gold);
  letter-spacing: 2rpx;
}

.top-card-count {
  font-size: var(--font-size-xs);
  color: var(--color-lavender);
  opacity: 0.7;
  background: rgba(244, 212, 140, 0.10);
  padding: 2rpx 12rpx;
  border-radius: var(--radius-pill);
}

.top-card-meaning {
  font-size: var(--font-size-caption);
  color: var(--color-text-secondary);
  line-height: 1.7;
  display: block;
  letter-spacing: 1rpx;
}

.insight-section {
  background: rgba(244, 212, 140, 0.04);
  border-radius: var(--radius-md);
  padding: var(--spacing-sm) var(--spacing-md);
  margin: var(--spacing-sm) 0;
  border: 1rpx solid rgba(244, 212, 140, 0.10);
}

.insight-text {
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  line-height: 1.8;
  display: block;
  font-style: italic;
  letter-spacing: 1rpx;
}

.guidance-section {
  background: rgba(180, 140, 200, 0.06);
  border-radius: var(--radius-md);
  padding: var(--spacing-sm) var(--spacing-md);
  border: 1rpx solid rgba(180, 140, 200, 0.12);
}

.guidance-text {
  font-size: var(--font-size-caption);
  color: var(--color-lavender);
  line-height: 1.8;
  display: block;
  letter-spacing: 1rpx;
}


/* ============================================================
   Entry Image — Displayed below reflection text
   ============================================================ */
.entry-image {
  width: 100%;
  border-radius: var(--radius-md, 16rpx);
  margin-top: var(--spacing-sm, 12rpx);
  border: 1rpx solid rgba(244, 212, 140, 0.15);
}


/* ============================================================
   Entry Header Right — Share button + mood
   ============================================================ */
.entry-header-right {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm, 12rpx);
}

.entry-share-btn {
  font-size: 22rpx;
  color: var(--color-gold, #F4D48C);
  opacity: 0.7;
  padding: 4rpx 12rpx;
  border: 1rpx solid rgba(244, 212, 140, 0.2);
  border-radius: var(--radius-pill, 999rpx);
  transition: all 0.15s ease;
}

.entry-share-btn:active {
  opacity: 1;
  background: rgba(244, 212, 140, 0.12);
}


/* ============================================================
   Image Picker — In compose modal
   ============================================================ */
.image-picker-wrap {
  margin-top: var(--spacing-md, 16rpx);
}

.image-picker-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  width: 140rpx;
  height: 140rpx;
  border: 1.5rpx dashed rgba(244, 212, 140, 0.25);
  border-radius: var(--radius-md, 16rpx);
  background: rgba(244, 212, 140, 0.04);
  transition: all 0.15s ease;
}

.image-picker-btn:active {
  background: rgba(244, 212, 140, 0.10);
  border-color: rgba(244, 212, 140, 0.40);
}

.image-picker-icon {
  font-size: 48rpx;
  color: var(--color-gold, #F4D48C);
  line-height: 1;
  opacity: 0.6;
}

.image-picker-label {
  font-size: 20rpx;
  color: var(--color-lavender, #B8A9E0);
  opacity: 0.7;
}

.image-preview-wrap {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--radius-md, 16rpx);
  overflow: hidden;
  border: 1.5rpx solid rgba(244, 212, 140, 0.20);
}

.image-preview {
  width: 100%;
  height: 100%;
}

.image-remove-btn {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 36rpx;
  height: 36rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  border-radius: 50%;
  text-align: center;
  line-height: 36rpx;
  font-size: 24rpx;
}


/* ============================================================
   Empty Date Hint — Tarot guidance when no entries found
   ============================================================ */
.empty-date-hint {
  text-align: center;
  padding: 120rpx var(--spacing-lg);
}

.empty-date-hint:active {
  opacity: 0.75;
  transform: scale(0.98);
  transition: all 0.15s ease-out;
}

.hint-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 24rpx;
}

.hint-text {
  font-size: var(--font-size-body);
  font-weight: 600;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.hint-sub {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  display: block;
  line-height: 1.6;
}


/* ============================================================
   Reflection Prompt Card — AI-powered guided writing
   ============================================================ */
.reflection-prompt-card {
  margin: 0 var(--spacing-md) var(--spacing-md);
  padding: var(--spacing-md);
  background: linear-gradient(135deg, rgba(244,212,140,0.12) 0%, rgba(180,140,200,0.08) 100%);
  border: 1.5rpx solid rgba(244,212,140,0.25);
  border-radius: var(--radius-md, 16rpx);
}

.reflection-prompt-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.reflection-prompt-icon {
  font-size: 28rpx;
}

.reflection-prompt-label {
  font-size: var(--font-size-caption, 24rpx);
  color: var(--color-gold);
  font-weight: 600;
  letter-spacing: 2rpx;
}

.reflection-prompt-question {
  display: block;
  font-size: var(--font-size-body, 30rpx);
  color: var(--color-text-primary, #F0EDE8);
  line-height: 1.6;
  font-weight: 400;
}

.reflection-prompt-card-tag {
  margin-top: 12rpx;
  display: inline-flex;
  padding: 4rpx 16rpx;
  background: rgba(244,212,140,0.10);
  border-radius: var(--radius-pill, 999rpx);
}

.reflection-prompt-card-tag text {
  font-size: var(--font-size-xs, 20rpx);
  color: var(--color-gold);
}
