<!-- pages/diary/diary.wxml -->
<view class="container">

  <!-- ===== 加载骨架 ===== -->
  <view wx:if="{{pageLoading}}">
    <view class="skeleton-wrap">
      <view class="skeleton-header-area">
        <view class="skeleton skeleton-line wide"></view>
        <view class="skeleton skeleton-line medium"></view>
      </view>
      <view class="skeleton skeleton-btn"></view>
      <view class="skeleton skeleton-entry"></view>
      <view class="skeleton skeleton-entry"></view>
      <view class="skeleton skeleton-entry"></view>
    </view>
  </view>

  <!-- ===== 错误状态 ===== -->
  <view wx:elif="{{pageError}}" class="error-state">
    <view class="error-card">
      <text class="error-title">日记暂时无法打开</text>
      <text class="error-desc">{{pageError}}</text>
      <button class="btn-retry" bindtap="onRetry">重新加载</button>
    </view>
  </view>

  <!-- ===== 主内容 ===== -->
  <view wx:else>

    <!-- Header -->
    <view class="page-header">
      <text class="page-title">星光日记</text>
      <text class="page-subtitle">每天一张牌，记录内心旅程</text>
    </view>

    <!-- Create entry button -->
    <button class="btn-create" bindtap="showCreateModal">
      <image class="btn-create-icon" src="/images/icons/star_64.png" mode="aspectFit" aria-label="记录今天" />
      <text>记录今天</text>
    </button>

    <!-- ===== AI 周回顾卡片（≥3条记录时显示） ===== -->
    <view class="review-card" wx:if="{{entries.length >= 3}}">

      <!-- 标题栏 -->
      <view class="review-header">
        <view class="review-header-left">
          <text class="review-header-icon">📊</text>
          <text class="review-title">本周回顾</text>
        </view>
        <view class="review-header-actions">
          <text class="review-refresh-btn" bindtap="onRefreshReview">
            <text wx:if="{{reviewLoading}}">加载中...</text>
            <text wx:else>⟳ 刷新</text>
          </text>
        </view>
      </view>

      <!-- 加载状态 -->
      <view wx:if="{{reviewLoading && !weeklyReview}}" class="review-loading">
        <text class="review-loading-text">AI 正在分析你的周记...</text>
      </view>

      <!-- 错误状态（保留本地回溯数据作为降级） -->
      <view wx:elif="{{reviewError && !weeklyReview}}" class="review-fallback">
        <text class="review-summary">
          这周你记录了 {{entries.length}} 次心情，
          最常出现的牌是「{{topCard}}」，
          你的心情趋势是{{moodTrend}}。
        </text>
      </view>

      <!-- AI 周回顾内容 -->
      <view wx:elif="{{weeklyReview}}" class="review-content">

        <!-- 情绪趋势曲线 (emoji + block chart) -->
        <view class="mood-trend" wx:if="{{weeklyReview.moodTrendCurve}}">
          <text class="review-section-label">本周心情</text>
          <view class="trend-line">
            <text class="trend-emoji" wx:for="{{weeklyReview.mood_trends}}" wx:key="date">{{item.mood_emoji}}</text>
          </view>
          <text class="trend-curve-text">{{weeklyReview.moodTrendCurve}}</text>
        </view>

        <!-- 情绪趋势柱状图 -->
        <view class="chart-section" wx:if="{{weeklyReview.mood_trends && weeklyReview.mood_trends.length > 0}}">
          <text class="review-section-label">情绪趋势</text>
          <text class="trend-summary-text">{{weeklyReview.emotional_trend_summary}}</text>
          <view class="mood-chart">
            <view
              class="chart-bar-wrap"
              wx:for="{{weeklyReview.mood_trends}}" wx:for-item="trend" wx:key="date"
            >
              <view class="chart-bar-column">
                <text class="chart-bar-emoji">{{trend.mood_emoji}}</text>
                <view class="chart-bar-track">
                  <view
                    class="chart-bar-fill"
                    style="height: {{(trend.mood_score / 5) * 100}}%;"
                  ></view>
                </view>
                <text class="chart-bar-label">{{trend.date.slice(5)}}</text>
              </view>
            </view>
          </view>
        </view>

        <!-- 本周影响最大的牌 -->
        <view class="review-card-section" wx:if="{{weeklyReview.top_card_name}}">
          <text class="review-section-label">本周影响力之牌</text>
          <view class="top-card-row">
            <text class="top-card-name">{{weeklyReview.top_card_name}}</text>
            <text class="top-card-count">出现 {{weeklyReview.top_card_count}} 次</text>
          </view>
          <text class="top-card-meaning" wx:if="{{weeklyReview.top_card_meaning}}">
            {{weeklyReview.top_card_meaning}}
          </text>
        </view>

        <!-- AI 洞察 -->
        <view class="review-card-section insight-section" wx:if="{{weeklyReview.ai_insight}}">
          <text class="review-section-label">AI 洞察</text>
          <text class="insight-text">{{weeklyReview.ai_insight}}</text>
        </view>

        <!-- 下周指引 -->
        <view class="review-card-section guidance-section" wx:if="{{weeklyReview.next_week_guidance}}">
          <text class="review-section-label">下周指引</text>
          <text class="guidance-text">{{weeklyReview.next_week_guidance}}</text>
        </view>

      </view>

    </view>

    <!-- ===== 日记列表 ===== -->
    <scroll-view
      wx:if="{{entries.length > 0}}"
      class="entries-scroll"
      scroll-y
      bindscrolltolower="loadMore"
    >
      <view class="entries">
        <view
          class="entry-card"
          wx:for="{{entries}}" wx:for-item="entry" wx:key="id"
        >
          <!-- Card header: date + mood -->
          <view class="entry-header">
            <view class="entry-date-line">
              <text class="entry-date-icon">✦</text>
              <text class="entry-date">{{entry.date}}</text>
            </view>
            <text class="entry-mood">
              <text wx:if="{{entry.mood === 'happy'}}">😊</text>
              <text wx:elif="{{entry.mood === 'sad'}}">😢</text>
              <text wx:elif="{{entry.mood === 'anxious'}}">😰</text>
              <text wx:elif="{{entry.mood === 'calm'}}">😌</text>
              <text wx:elif="{{entry.mood === 'excited'}}">🤩</text>
              <text wx:elif="{{entry.mood === 'thoughtful'}}">🤔</text>
              <text wx:else>🤔</text>
            </text>
          </view>

          <!-- Card info with thumbnail -->
          <view wx:if="{{entry.card}}" class="entry-card-section">
            <view class="entry-card-row">
              <image
                wx:if="{{entry.cardImagePath && !entryCardImgErrors[entry.id]}}"
                class="entry-card-thumb"
                src="{{entry.cardImagePath}}"
                mode="aspectFill"
                lazy-load
                binderror="onEntryCardImageError"
                data-entry-id="{{entry.id}}"
                aria-label="{{entry.card.name_zh}} — 关联卡牌"
              />
              <view class="entry-card-info">
                <view class="card-label-line">
                  <image class="card-label-icon" src="/images/icons/card_back_64.png" mode="aspectFit" lazy-load aria-label="今日之牌" />
                  <text class="card-label">今日之牌</text>
                </view>
                <text class="card-name">{{entry.card.name_zh}}</text>
                <text class="card-meaning">{{entry.card.meaning_upright}}</text>
              </view>
            </view>
          </view>

          <!-- Reflection text -->
          <text wx:if="{{entry.reflection}}" class="entry-reflection">{{entry.reflection}}</text>
        </view>
      </view>

      <!-- Load more indicator -->
      <view wx:if="{{loadingMore}}" class="load-more-hint">
        <text class="load-more-text">加载中...</text>
      </view>
      <view wx:elif="{{!hasMore && entries.length > 0}}" class="load-more-hint">
        <text class="load-more-text">— 已加载全部 —</text>
      </view>
    </scroll-view>

    <!-- ===== 空状态 ===== -->
    <view class="empty-date-hint" wx:if="{{entries.length === 0}}" bindtap="showCreateModal">
      <text class="hint-icon">🃏</text>
      <text class="hint-text">今天抽到了什么牌？</text>
      <text class="hint-sub">翻开每日一牌，记录此刻心情</text>
    </view>

  </view>

  <!-- ===== Floating AI Review Button ===== -->
  <view class="floating-review-btn" wx:if="{{entries.length >= 3 && weeklyReview}}" bindtap="onTapFloatingReview">
    <text class="floating-review-icon">📊</text>
    <text class="floating-review-text">AI周回顾</text>
  </view>

  <!-- ============ 创建日记 Modal ============ -->
  <view class="modal-mask" wx:if="{{showCreate}}" bindtap="hideCreateModal">
    <view class="modal-sheet" catchtap="preventClose">
      <!-- Handle -->
      <view class="modal-handle"></view>

      <text class="modal-title">今日星光日记</text>

      <!-- 今日卡牌上下文 -->
      <view class="diary-card-context" wx:if="{{todayCard}}">
        <image class="diary-card-thumb" src="{{todayCard.imagePath}}" mode="aspectFill" lazy-load binderror="onDiaryCardImgError" wx:if="{{!diaryCardImgError}}" aria-label="{{todayCard.name_zh}} — 今日卡牌" />
        <view wx:elif="{{diaryCardImgError}}" class="diary-card-thumb diary-card-thumb-fallback">
          <text class="diary-card-fallback-name">{{todayCard.name_zh}}</text>
        </view>
        <view class="diary-card-info">
          <text class="diary-card-name">{{todayCard.name_zh}}</text>
          <text class="diary-card-hint">今天抽到的牌</text>
        </view>
      </view>

      <!-- Mood selector -->
      <text class="modal-label">今天的心情</text>
      <view class="mood-grid">
        <view
          class="mood-item {{mood === 'happy' ? 'mood-selected' : ''}}"
          data-mood="happy"
          bindtap="onMoodSelect"
        >
          <text class="mood-emoji">😊</text>
          <text class="mood-label">开心</text>
        </view>
        <view
          class="mood-item {{mood === 'calm' ? 'mood-selected' : ''}}"
          data-mood="calm"
          bindtap="onMoodSelect"
        >
          <text class="mood-emoji">😌</text>
          <text class="mood-label">平静</text>
        </view>
        <view
          class="mood-item {{mood === 'excited' ? 'mood-selected' : ''}}"
          data-mood="excited"
          bindtap="onMoodSelect"
        >
          <text class="mood-emoji">🤩</text>
          <text class="mood-label">兴奋</text>
        </view>
        <view
          class="mood-item {{mood === 'anxious' ? 'mood-selected' : ''}}"
          data-mood="anxious"
          bindtap="onMoodSelect"
        >
          <text class="mood-emoji">😰</text>
          <text class="mood-label">焦虑</text>
        </view>
        <view
          class="mood-item {{mood === 'sad' ? 'mood-selected' : ''}}"
          data-mood="sad"
          bindtap="onMoodSelect"
        >
          <text class="mood-emoji">😢</text>
          <text class="mood-label">低落</text>
        </view>
        <view
          class="mood-item {{mood === 'thoughtful' ? 'mood-selected' : ''}}"
          data-mood="thoughtful"
          bindtap="onMoodSelect"
        >
          <text class="mood-emoji">🤔</text>
          <text class="mood-label">思考</text>
        </view>
      </view>

      <!-- Reflection textarea with AI prompt -->
      <text class="modal-label">今日感悟</text>
      <textarea
        class="reflection-input"
        placeholder="{{reflectionPlaceholder || '此刻你的心情是怎样的？'}}"
        value="{{reflection}}"
        bindinput="onReflectionInput"
        maxlength="500"
      />
      <text class="char-count">{{reflection.length}}/500</text>

      <!-- Submit -->
      <button
        class="btn-submit"
        disabled="{{creating}}"
        bindtap="onCreateEntry"
      >
        {{creating ? '记录中...' : '保存日记'}}
      </button>
    </view>
  </view>

</view>
