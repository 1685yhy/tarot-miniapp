<!-- pages/diary/diary.wxml -->
<view class="container">
  <!-- ===== 加载骨架 ===== -->
  <view wx:if="{{pageLoading}}">
    <view class="skeleton">
      <view class="skeleton-header-area">
        <view class="skeleton-line wide"></view>
        <view class="skeleton-line medium"></view>
      </view>
      <view class="skeleton-btn"></view>
      <view class="skeleton-entry"></view>
      <view class="skeleton-entry"></view>
      <view class="skeleton-entry"></view>
    </view>
  </view>

  <!-- ===== 错误状态 ===== -->
  <view wx:elif="{{pageError}}" class="error-state">
    <text class="error-icon">📖</text>
    <text class="error-text">日记暂时无法打开</text>
    <text class="error-hint">{{pageError}}</text>
    <button class="btn-primary btn-small" bindtap="onRetry">✨ 重新加载</button>
  </view>

  <!-- ===== 主内容 ===== -->
  <view wx:else>
    <!-- Header -->
    <view class="flex-center flex-col" style="padding:var(--space-xl) 0">
      <text class="heading-2">📝 塔罗日记</text>
      <text class="text-dim mt-sm">每天一张牌，记录内心旅程</text>
    </view>

    <!-- Create button -->
    <button class="btn-primary anim-glow-pulse mb-xxl" style="width:100%;margin-bottom:var(--space-xxl)" bindtap="showCreateModal">
      ✨ 记录今天
    </button>

    <!-- Entries -->
    <scroll-view scroll-y style="max-height:70vh" bindscrolltolower="loadMore" wx:if="{{entries.length > 0}}">
      <view class="entries">
        <view class="entry-card anim-fade-in-up" wx:for="{{entries}}" wx:key="id">
          <view class="entry-header">
            <text class="text-dim" style="font-size:var(--fs-body-small)">{{item.date}}</text>
            <text style="font-size:32rpx">{{item.mood === 'happy' ? '😊' : item.mood === 'sad' ? '😢' : item.mood === 'anxious' ? '😰' : item.mood === 'calm' ? '😌' : item.mood === 'excited' ? '🤩' : '💭'}}</text>
          </view>
          <view class="entry-card-section" wx:if="{{item.card}}">
            <text class="card-name">🔮 {{item.card.name_zh}}</text>
            <text class="card-meaning">{{item.card.meaning_upright}}</text>
          </view>
          <text class="entry-reflection" wx:if="{{item.reflection}}">{{item.reflection}}</text>
        </view>
      </view>
      <view wx:if="{{loadingMore}}" style="text-align:center;padding:var(--space-md)" class="text-dim">加载更多...</view>
      <view wx:elif="{{!hasMore && entries.length > 0}}" style="text-align:center;padding:var(--space-md)" class="text-dim">— 已加载全部 —</view>
    </scroll-view>

    <!-- Empty state -->
    <view wx:if="{{entries.length === 0}}" class="empty-state" style="padding:var(--space-massive) 0">
      <text class="empty-icon">📖</text>
      <text class="empty-text">还没有日记记录</text>
      <text class="empty-hint">每天抽一张牌，记录你的感受</text>
    </view>
  </view>

  <!-- Create modal -->
  <view class="modal-mask" wx:if="{{showCreate}}" bindtap="hideCreateModal">
    <view class="modal-content" catchtap="">
      <text class="modal-title">今日塔罗日记</text>

      <text class="text-secondary" style="display:block;margin-bottom:var(--space-sm)">今天的心情</text>
      <view class="mood-grid">
        <view class="mood-item {{mood === 'happy' ? 'selected' : ''}}" data-mood="happy" bindtap="onMoodSelect">
          <text>😊 开心</text></view>
        <view class="mood-item {{mood === 'calm' ? 'selected' : ''}}" data-mood="calm" bindtap="onMoodSelect">
          <text>😌 平静</text></view>
        <view class="mood-item {{mood === 'excited' ? 'selected' : ''}}" data-mood="excited" bindtap="onMoodSelect">
          <text>🤩 兴奋</text></view>
        <view class="mood-item {{mood === 'anxious' ? 'selected' : ''}}" data-mood="anxious" bindtap="onMoodSelect">
          <text>😰 焦虑</text></view>
        <view class="mood-item {{mood === 'sad' ? 'selected' : ''}}" data-mood="sad" bindtap="onMoodSelect">
          <text>😢 低落</text></view>
        <view class="mood-item {{mood === 'thoughtful' ? 'selected' : ''}}" data-mood="thoughtful" bindtap="onMoodSelect">
          <text>💭 思考</text></view>
      </view>

      <text class="text-secondary mt-xl" style="display:block;margin-bottom:var(--space-sm)">今日感悟（可选）</text>
      <textarea class="reflection-input" placeholder="记录今天的想法..." value="{{reflection}}" bindinput="onReflectionInput" maxlength="500" />
      <text class="text-dim mt-xs" style="text-align:right;display:block;font-size:var(--fs-caption)">{{reflection.length}}/500</text>

      <button class="btn-primary submit-btn mt-xxl" bindtap="onCreateEntry" disabled="{{creating}}">
        {{creating ? '记录中...' : '💫 保存日记'}}
      </button>
    </view>
  </view>
</view>
