<!-- pages/profile/profile.wxml -->
<!-- 星辰背景由 app.wxss/common.wxss 的 cosmic-layer 提供 -->

<view class="container">

  <!-- ===== 加载骨架 ===== -->
  <view wx:if="{{pageLoading}}">
    <view class="skeleton skeleton-card"></view>
    <view class="skeleton skeleton-stats"></view>
    <view class="skeleton-actions">
      <view class="skeleton skeleton-action"></view>
      <view class="skeleton skeleton-action"></view>
      <view class="skeleton skeleton-action"></view>
    </view>
  </view>

  <!-- ===== 错误状态 ===== -->
  <view wx:elif="{{pageError}}" class="error-state">
    <text class="error-text">个人信息暂时无法获取</text>
    <text class="error-hint">{{pageError}}</text>
    <button class="btn-primary btn-small" bindtap="onRetry">重新加载</button>
  </view>

  <!-- ===== 主内容 ===== -->
  <view wx:else>
    <!-- ============ User info + membership ============ -->
    <view class="user-card anim-fade-up anim-stagger-1">
      <!-- Avatar: 金色星星剪影 -->
      <view class="avatar-circle">
        <image class="avatar-emoji" src="/images/icons/theme_general_64.png" mode="aspectFit" aria-label="用户头像" />
      </view>
      <text class="user-name">{{user.nickname || '星光旅人'}}</text>
      <view class="user-badge-row">
        <text class="user-status-text" wx:if="{{!memberStatus.is_member}}">今日剩余 {{memberStatus.free_readings_today || 0}} 次免费解读</text>
        <text class="user-status-text member-status" wx:else>会员</text>
        <text class="badge-date" wx:if="{{memberStatus.is_member && memberStatus.expires_at}}">
          有效期至 {{memberStatus.expiresAtFormatted}}
        </text>
      </view>
      <button class="btn-primary btn--sm upgrade-btn" wx:if="{{!memberStatus.is_member}}" bindtap="onGoMembership">
        <image class="btn-inline-icon" src="/images/icons/star_64.png" mode="aspectFit" aria-label="会员" />
        <text>开通会员 · 无限解读</text>
      </button>
    </view>

    <!-- ============ Stats ============ -->
    <view class="stats-row anim-fade-up anim-stagger-2">
      <view class="stat-item">
        <text class="stat-num anim-pulse-once">{{memberStatus.total_readings || historyTotal || 0}}</text>
        <text class="stat-label">解读次数</text>
      </view>
      <view class="stat-item">
        <text class="stat-num anim-pulse-once">{{memberStatus.free_readings_today || 0}}</text>
        <text class="stat-label">今日占卜</text>
      </view>
      <view class="stat-item">
        <text class="stat-num anim-pulse-once">{{memberStatus.free_chats_today || 0}}</text>
        <text class="stat-label">追问次数</text>
        <text class="stat-subtitle">解读后可追问AI</text>
      </view>
    </view>

    <!-- ============ 会员权益卡片 ============ -->
    <view class="benefits-card anim-fade-up anim-stagger-3" wx:if="{{memberStatus && memberStatus.is_member}}">
      <view class="benefits-card-header">
        <text class="benefits-card-title">✦ 已解锁权益</text>
      </view>
      <view class="benefits-list">
        <view class="benefit-item" wx:for="{{memberBenefits}}" wx:key="index">
          <text class="benefit-icon">{{item.icon}}</text>
          <text class="benefit-text">{{item.text}}</text>
        </view>
      </view>
      <view class="benefits-card-footer">
        <text class="benefits-expiry" wx:if="{{memberStatus.expiresAtFormatted}}">有效期至 {{memberStatus.expiresAtFormatted}} · 自动续费</text>
        <text class="benefits-manage" bindtap="onGoMembership">管理会员 →</text>
      </view>
    </view>

    <!-- ============ 非会员：被锁定权益 ============ -->
    <view class="benefits-card benefits-card--locked anim-fade-up anim-stagger-3" wx:else>
      <view class="benefits-card-header">
        <text class="benefits-card-title">✦ 开通会员解锁</text>
      </view>
      <view class="benefits-list">
        <view class="benefit-item benefit-item--locked" wx:for="{{lockedBenefits}}" wx:key="index">
          <text class="benefit-icon">{{item.icon}}</text>
          <text class="benefit-text benefit-text--locked">{{item.text}}</text>
          <text class="benefit-lock">🔒</text>
        </view>
      </view>
      <view class="benefits-card-footer">
        <text class="benefits-unlock-hint">无限次解读 · 每日低至 ¥0.46</text>
        <button class="benefits-unlock-btn" bindtap="onGoMembership">了解详情</button>
      </view>
    </view>

    <!-- ============ 你的专属塔罗师 ============ -->
    <view class="persona-usage-card anim-fade-up anim-stagger-4" wx:if="{{personaStats.length > 0}}">
      <view class="persona-usage-header">
        <image src="/images/icons/star_64.png" mode="aspectFit" class="persona-usage-header-icon" aria-label="专属塔罗师" />
        <text class="persona-usage-title">✦ 你的专属塔罗师</text>
      </view>
      <text class="persona-usage-sub" wx:if="{{mostUsedPersona}}">
        你最常使用的是 <text class="persona-usage-highlight">{{mostUsedPersona.icon}} {{mostUsedPersona.name}}</text>，共 {{mostUsedPersonaCount}} 次
      </text>
      <view class="persona-usage-list">
        <view class="persona-usage-item" wx:for="{{personaStats}}" wx:key="key">
          <text class="persona-usage-icon">{{item.icon}}</text>
          <view class="persona-usage-info">
            <text class="persona-usage-name">{{item.name}}</text>
            <text class="persona-usage-desc" wx:if="{{item.desc}}">{{item.desc}}</text>
          </view>
          <text class="persona-usage-count">{{item.count}}次</text>
        </view>
      </view>
    </view>

    <!-- ============ Menu items ============ -->
    <view class="menu-section anim-fade-up anim-stagger-3">
      <view class="menu-item anim-slide-up anim-stagger-1" bindtap="onGoDiary">
        <view class="menu-icon-wrap">
          <image src="/images/icons/diary_64.png" mode="aspectFit" class="menu-icon-img" aria-label="我的日记"></image>
        </view>
        <view class="menu-content">
          <text class="menu-title">我的日记</text>
          <text class="menu-desc">记录你的星光感悟</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item anim-slide-up anim-stagger-2" bindtap="onGoFavorites">
        <view class="menu-icon-wrap">
          <image src="/images/icons/star_filled_64.png" mode="aspectFit" class="menu-icon-img" aria-label="我的收藏"></image>
        </view>
        <view class="menu-content">
          <text class="menu-title">我的收藏</text>
          <text class="menu-desc">{{favoriteCount}}张牌</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <!-- 邀请朋友 — 裂变分享入口 -->
      <view class="menu-item menu-item--invite anim-slide-up anim-stagger-3" bindtap="onGoShareCenter">
        <view class="menu-icon-wrap">
          <image src="/images/icons/sparkle_64.png" mode="aspectFit" class="menu-icon-img" aria-label="邀请朋友"></image>
        </view>
        <view class="menu-content">
          <text class="menu-title">邀请朋友</text>
          <text class="menu-desc">已获 {{inviteRewards || 0}} 次免费解读</text>
        </view>
        <view class="menu-badge-invite" wx:if="{{inviteRewards > 0}}">
          <text class="menu-badge-text">{{inviteRewards}}</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item anim-slide-up anim-stagger-4" bindtap="onGoMembership">
        <view class="menu-icon-wrap">
          <image src="/images/icons/member_64.png" mode="aspectFit" class="menu-icon-img" aria-label="会员中心"></image>
        </view>
        <view class="menu-content">
          <text class="menu-title">{{memberStatus.is_member ? '会员中心' : '开通会员'}}</text>
          <text class="menu-desc">{{memberStatus.is_member ? '管理你的会员权益' : '解锁无限占卜与追问'}}</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item anim-slide-up anim-stagger-5 {{isAnnualReportSeason ? 'menu-item--annual-season' : ''}}" bindtap="onGoAnnualReport">
        <view class="menu-icon-wrap">
          <image src="/images/icons/report_64.png" mode="aspectFit" class="menu-icon-img" aria-label="年度报告"></image>
        </view>
        <view class="menu-content">
          <text class="menu-title">
            <text wx:if="{{isAnnualReportSeason}}" class="menu-season-badge">✨</text>
            年度报告
          </text>
          <text class="menu-desc">{{isAnnualReportSeason ? annualReportYear + ' 年度报告已上线' : '回顾你一年的星途旅程'}}</text>
        </view>
        <image wx:if="{{isAnnualReportSeason}}" class="menu-arrow-img menu-arrow-img--season" src="/images/icons/star_64.png" mode="aspectFit" aria-label="年度报告" />
        <text wx:else class="menu-arrow">›</text>
      </view>
      <view class="menu-item anim-slide-up anim-stagger-6" bindtap="onToggleYearEndReminder">
        <view class="menu-icon-wrap">
          <image src="/images/icons/sparkle_64.png" mode="aspectFit" class="menu-icon-img" aria-label="年末报告提醒"></image>
        </view>
        <view class="menu-content">
          <text class="menu-title">年末报告提醒</text>
          <text class="menu-desc">{{yearEndReminderEnabled ? '已开启 · 年底推送年度报告' : '关闭'}}</text>
        </view>
        <image wx:if="{{yearEndReminderEnabled}}" class="menu-arrow-img" src="/images/icons/star_64.png" mode="aspectFit" aria-label="报告提醒开启" />
        <text wx:else class="menu-arrow">○</text>
      </view>
      <view class="menu-item anim-slide-up anim-stagger-7" bindtap="onToggleSound">
        <view class="menu-icon-wrap">
          <image src="/images/icons/theme_general_64.png" mode="aspectFit" class="menu-icon-img" aria-label="音效"></image>
        </view>
        <view class="menu-content">
          <text class="menu-title">音效</text>
          <text class="menu-desc">{{soundEnabled ? '已开启' : '已关闭'}}</text>
        </view>
        <image wx:if="{{soundEnabled}}" class="menu-arrow-img" src="/images/icons/star_64.png" mode="aspectFit" aria-label="音效开启" />
        <text wx:else class="menu-arrow">○</text>
      </view>
      <view class="menu-item anim-slide-up anim-stagger-8" bindtap="onToggleAmbient">
        <view class="menu-icon-wrap">
          <image src="/images/icons/theme_general_64.png" mode="aspectFit" class="menu-icon-img" aria-label="星空环境音"></image>
        </view>
        <view class="menu-content">
          <text class="menu-title">🌙 星空环境音</text>
          <text class="menu-desc">{{ambientEnabled ? '已开启' : '已关闭'}}</text>
        </view>
        <image wx:if="{{ambientEnabled}}" class="menu-arrow-img" src="/images/icons/star_64.png" mode="aspectFit" aria-label="星空环境音开启" />
        <text wx:else class="menu-arrow">○</text>
      </view>
      <!-- ===== Push Notification Settings ===== -->
      <view class="menu-section-title anim-fade-up anim-stagger-9">
        <text class="menu-section-label">推送设置</text>
      </view>
      <view class="menu-item anim-slide-up anim-stagger-10" bindtap="onSubscribeDailyCard">
        <view class="menu-icon-wrap">
          <image src="/images/icons/star_64.png" mode="aspectFit" class="menu-icon-img" aria-label="每日推送"></image>
        </view>
        <view class="menu-content">
          <text class="menu-title">每日塔罗推送</text>
          <text class="menu-desc">{{pushDailyCard ? '已开启 · 每日推送今日塔罗' : '关闭'}}</text>
        </view>
        <image wx:if="{{pushDailyCard}}" class="menu-arrow-img" src="/images/icons/star_64.png" mode="aspectFit" aria-label="每日推送已开启" />
        <text wx:else class="menu-arrow">○</text>
      </view>
      <view class="menu-item anim-slide-up anim-stagger-11" bindtap="onOpenPushSettings">
        <view class="menu-icon-wrap">
          <image src="/images/icons/about_64.png" mode="aspectFit" class="menu-icon-img" aria-label="推送管理"></image>
        </view>
        <view class="menu-content">
          <text class="menu-title">推送管理</text>
          <text class="menu-desc">在系统设置中管理通知权限</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item anim-slide-up anim-stagger-13" bindtap="onToggleDrawMode">
        <view class="menu-icon-wrap">
          <image src="/images/icons/theme_general_64.png" mode="aspectFit" class="menu-icon-img" aria-label="默认抽牌模式"></image>
        </view>
        <view class="menu-content">
          <text class="menu-title">默认抽牌模式</text>
          <text class="menu-desc">{{defaultDrawMode === 'immersive' ? '沉浸解读' : '快速抽牌'}}</text>
        </view>
        <image wx:if="{{defaultDrawMode === 'immersive'}}" class="menu-arrow-img" src="/images/icons/sparkle_64.png" mode="aspectFit" aria-label="沉浸解读模式" />
        <image wx:else class="menu-arrow-img" src="/images/icons/lightning_64.png" mode="aspectFit" aria-label="快速抽牌模式" />
      </view>
      <view class="menu-item anim-slide-up anim-stagger-14" bindtap="onGoAbout">
        <view class="menu-icon-wrap">
          <image src="/images/icons/about_64.png" mode="aspectFit" class="menu-icon-img" aria-label="关于星光映照"></image>
        </view>
        <view class="menu-content">
          <text class="menu-title">关于星光映照</text>
          <text class="menu-desc">塔罗是镜子，不是预言</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <!-- ============ Saved Readings ============ -->
    <view class="history-section anim-fade-up anim-stagger-4">
      <view class="history-header">
        <view class="history-header-left">
          <image src="/images/icons/history_64.png" mode="aspectFit" class="history-header-icon-img" aria-label="收藏的解读"></image>
          <text class="history-header-title">收藏的解读</text>
        </view>
        <button class="clear-btn" bindtap="onClearSavedReadings" wx:if="{{savedReadings.length > 0}}">清除</button>
      </view>

      <!-- 空状态 -->
      <view wx:if="{{savedReadings.length === 0}}" class="empty-state-inline">
        <image class="empty-icon-img" src="/images/icons/theme_general_64.png" mode="aspectFit" aria-label="暂无收藏" />
        <text class="empty-text" wx:if="{{savedReadingsLoading}}">加载中...</text>
        <text class="empty-text" wx:else>暂无收藏的解读</text>
        <text class="empty-hint">在解读页面点击「收藏本次解读」即可收藏</text>
      </view>

      <!-- 收藏列表 -->
      <view wx:else>
        <view class="history-list">
          <view
            class="history-item anim-slide-up anim-stagger-{{index + 1}}"
            wx:for="{{savedReadings}}" wx:key="id"
            data-id="{{item.id}}"
            bindtap="onViewReading"
          >
            <view class="card-img-wrap history-thumb card-img-wrap--error">
              <view class="card-img-fallback">
                <image class="card-img-fallback-icon" src="/images/icons/card_back_64.png" mode="aspectFit" lazy-load aria-label="占卜记录缩略图" />
              </view>
            </view>
            <view class="history-info">
              <text class="history-spread-name">{{item.spreadTypeName}}</text>
              <text class="history-theme" wx:if="{{item.theme}}">{{item.theme}}</text>
              <text class="history-meta" wx:if="{{item.createdAtFormatted}}">
                {{item.createdAtFormatted}}
              </text>
            </view>
            <text class="history-arrow">›</text>
          </view>
        </view>
      </view>
    </view>

    <!-- ============ History ============ -->
    <view class="history-section anim-fade-up anim-stagger-5">
      <view class="history-header">
        <view class="history-header-left">
          <image src="/images/icons/history_64.png" mode="aspectFit" class="history-header-icon-img" aria-label="占卜历史"></image>
          <text class="history-header-title">占卜历史</text>
        </view>
        <button class="clear-btn" bindtap="onClearHistory" wx:if="{{readingHistory.length > 0}}">清除</button>
      </view>

      <!-- 空状态 -->
      <view wx:if="{{readingHistory.length === 0}}" class="empty-state-inline">
        <image class="empty-icon-img" src="/images/icons/theme_general_64.png" mode="aspectFit" aria-label="暂无占卜记录" />
        <text class="empty-text">暂无占卜记录</text>
        <text class="empty-hint">开始你的第一次占卜吧</text>
        <button class="btn-gold-empty begin-reading-btn" bindtap="onGoToReading">
          <image class="btn-inline-icon" src="/images/icons/star_64.png" mode="aspectFit" aria-label="开始占卜" />
          <text>开始占卜</text>
        </button>
      </view>

      <!-- 历史列表 -->
      <scroll-view scroll-y style="max-height:70vh" bindscrolltolower="onScrollToBottom" wx:else>
        <view class="history-list">
          <view
            class="history-card anim-slide-up anim-stagger-{{index + 1}}"
            wx:for="{{readingHistory}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="onViewReading"
          >
            <view class="history-card-header">
              <text class="history-spread-type">{{item.spreadTypeName}}</text>
              <text class="history-date">{{item.createdAtFormatted}}</text>
            </view>
            <text class="history-question" wx:if="{{item.question}}">"{{item.question}}"</text>
            <view class="history-card-footer">
              <text class="history-theme">{{item.theme || '综合'}}</text>
              <text class="history-action">查看解读 →</text>
            </view>
          </view>
        </view>

        <!-- 加载更多 -->
        <view wx:if="{{loadingMore}}" class="loading-more">
          <view class="loading-spinner"></view>
          <text class="loading-text">加载更多...</text>
        </view>
        <view wx:elif="{{!hasMore && readingHistory.length > 0}}" class="loaded-all">
          <text class="loaded-all-line"></text>
          <text class="loaded-all-text">已加载全部</text>
          <text class="loaded-all-line"></text>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
