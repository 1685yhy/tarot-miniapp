<!-- pages/profile/profile.wxml -->
<!-- 星辰背景由 app.wxss/common.wxss 的 cosmic-layer 提供 -->

<view class="container">

  <!-- ===== 加载骨架 ===== -->
  <view wx:if="{{pageLoading}}">
    <view class="skeleton skeleton-card"></view>
    <view class="skeleton-actions">
      <view class="skeleton skeleton-action"></view>
      <view class="skeleton skeleton-action"></view>
      <view class="skeleton skeleton-action"></view>
    </view>
  </view>

  <!-- ===== 错误状态 ===== -->
  <view wx:elif="{{pageError}}" class="error-state">
    <text class="error-text">个人信息暂时无法获取</text>
    <text class="error-hint">{{pageError}}</text>
    <button class="btn-primary btn-small" bindtap="onRetry">重新加载</button>
  </view>

  <!-- ===== 主内容 ===== -->
  <view wx:else>
    <!-- ============ User info + membership ============ -->
    <view class="user-card anim-fade-up anim-stagger-1">
      <!-- Avatar: 金色星星剪影 -->
      <view class="avatar-circle">
        <image class="avatar-emoji" src="/images/icons/theme_general_64.png" mode="aspectFit" aria-label="用户头像" />
      </view>
      <text class="user-name">{{user.nickname || '星光旅人'}}</text>
      <view class="user-badge-row">
        <text class="user-status-text" wx:if="{{!memberStatus.is_member}}">今日剩余 {{memberStatus.free_readings_today || 0}} 次免费解读</text>
        <text class="user-status-text member-status" wx:else>会员</text>
        <text class="badge-date" wx:if="{{memberStatus.is_member && memberStatus.expires_at}}">
          有效期至 {{memberStatus.expiresAtFormatted}}
        </text>
      </view>
      <button class="btn-primary btn--sm upgrade-btn" wx:if="{{!memberStatus.is_member}}" bindtap="onGoMembership">
        <image class="btn-inline-icon" src="/images/icons/star_cream_64.png" mode="aspectFit" aria-label="会员" />
        <text>开通会员 · 无限解读</text>
      </button>
    </view>

    <!-- ============ 主角：星光记录卡（开发 04 · 连续天数大数字 + 迷你牌运曲线） ============ -->
    <view class="record-card anim-fade-up anim-stagger-2" bindtap="onGoFortuneTrend" role="button" aria-label="查看星光记录与牌运曲线" hover-class="card-pressed">
      <view class="record-card-top">
        <text class="record-card-label">星光记录</text>
        <text class="record-card-badge" wx:if="{{recordLevel}}">{{recordLevel}}</text>
        <text class="record-card-badge" wx:else>星光旅人</text>
      </view>
      <view class="record-card-main">
        <text class="record-card-num">{{streak}}<text class="record-card-num-unit">天连续</text></text>
        <view class="record-card-text">
          <text class="record-card-line1">本月解读 {{fortuneTotal}} 次 · {{fortuneMood}}</text>
          <text class="record-card-line2">你已与星光同行 {{streak}} 天，星光正在累积</text>
        </view>
      </view>
      <!-- 迷你牌运曲线（30 根柱 · 归一化高度） -->
      <view class="record-spark" wx:if="{{sparkBars.length > 0}}">
        <view class="spark-bar {{item.active ? 'spark-bar--on' : ''}}" wx:for="{{sparkBars}}" wx:key="index" style="height: {{item.h}}%;"></view>
      </view>
      <view class="record-stats">
        <view class="record-stat">
          <text class="record-stat-num">{{totalReadings}}</text>
          <text class="record-stat-label">解读</text>
        </view>
        <view class="record-stat">
          <text class="record-stat-num">{{diaryCount}}</text>
          <text class="record-stat-label">日记</text>
        </view>
        <view class="record-stat">
          <text class="record-stat-num">{{wishCount}}</text>
          <text class="record-stat-label">愿望</text>
        </view>
        <view class="record-stat">
          <text class="record-stat-num">{{collectionCount}}/78</text>
          <text class="record-stat-label">收藏</text>
        </view>
      </view>
    </view>
    <view class="record-curve-link anim-fade-up anim-stagger-2" bindtap="onGoFortuneTrend" role="button" aria-label="查看牌运曲线">
      <text>牌运曲线 · 近 30 天 {{sparkActive}} 天有星光 →</text>
    </view>

    <!-- ============ 注脚入口（开发 04 · 日记 3 小卡 + 签到/收藏/设置） ============ -->
    <view class="me-grid anim-fade-up anim-stagger-3">
      <view class="me-tile" bindtap="onGoDiary" role="button" aria-label="我的日记" hover-class="tile-pressed">
        <view class="me-tile-icon"><text class="me-tile-emoji">✎</text></view>
        <view class="me-tile-text">
          <text class="me-tile-name">我的日记</text>
          <text class="me-tile-desc">{{diaryCount}} 篇星光感悟</text>
        </view>
      </view>
      <view class="me-tile" bindtap="onGoWish" role="button" aria-label="新月许愿" hover-class="tile-pressed">
        <view class="me-tile-icon"><text class="me-tile-emoji">☽</text></view>
        <view class="me-tile-text">
          <text class="me-tile-name">新月许愿</text>
          <text class="me-tile-desc">{{wishTileDesc}}</text>
        </view>
      </view>
      <view class="me-tile" bindtap="onGoReview" role="button" aria-label="满月复盘" hover-class="tile-pressed">
        <view class="me-tile-icon"><text class="me-tile-emoji">✧</text></view>
        <view class="me-tile-text">
          <text class="me-tile-name">满月复盘</text>
          <text class="me-tile-desc">{{reviewTileDesc}}</text>
        </view>
      </view>
      <view class="me-tile" bindtap="onGoCheckin" role="button" aria-label="每日签到" hover-class="tile-pressed">
        <view class="me-tile-icon"><text class="me-tile-emoji">✦</text></view>
        <view class="me-tile-text">
          <text class="me-tile-name">每日签到</text>
          <text class="me-tile-desc">连续 {{streak}} 天</text>
        </view>
      </view>
      <view class="me-tile" bindtap="onGoFavorites" role="button" aria-label="收藏卡牌" hover-class="tile-pressed">
        <view class="me-tile-icon"><text class="me-tile-emoji">✧</text></view>
        <view class="me-tile-text">
          <text class="me-tile-name">收藏卡牌</text>
          <text class="me-tile-desc">{{collectionCount}} / 78 张</text>
        </view>
      </view>
      <view class="me-tile" bindtap="onGoSettingsSection" role="button" aria-label="设置" hover-class="tile-pressed">
        <view class="me-tile-icon"><text class="me-tile-emoji">⚙</text></view>
        <view class="me-tile-text">
          <text class="me-tile-name">设置</text>
          <text class="me-tile-desc">推送 · 音效 · 隐私</text>
        </view>
      </view>
    </view>

    <!-- ============ 我的星象（第一阶段：星座可改 · 出生信息可选） ============ -->
    <view class="menu-section anim-fade-up anim-stagger-2">
      <view class="menu-section-title">
        <text class="menu-section-label">我的星象</text>
      </view>
      <view class="menu-item anim-slide-up anim-stagger-1" bindtap="onGoZodiac" role="button" aria-label="修改我的星座" hover-class="card-pressed">
        <view class="menu-icon-wrap">
          <text class="menu-icon-text">✦</text>
        </view>
        <view class="menu-content">
          <text class="menu-title">我的星座</text>
          <text class="menu-desc">今日能量与牌语，随星座轻轻调整</text>
        </view>
        <text class="menu-value" wx:if="{{zodiacBadge}}">{{zodiacBadge}}</text>
        <text class="menu-value menu-value--empty" wx:else>未设置</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item anim-slide-up anim-stagger-2" bindtap="onGoBirthInfo" role="button" aria-label="完善出生信息" hover-class="card-pressed">
        <view class="menu-icon-wrap">
          <text class="menu-icon-text">☽</text>
        </view>
        <view class="menu-content">
          <text class="menu-title">完善出生信息</text>
          <text class="menu-desc">填了才能解锁月亮与上升（二期）</text>
        </view>
        <text class="menu-value" wx:if="{{birthInfo}}">已完善</text>
        <text class="menu-value menu-value--empty" wx:else>未填写</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <!-- ============ 会员权益卡片 ============ -->
    <view class="benefits-card anim-fade-up anim-stagger-3" wx:if="{{memberStatus && memberStatus.is_member}}">
      <view class="benefits-card-header">
        <text class="benefits-card-title">✦ 已解锁权益</text>
      </view>
      <view class="benefits-list">
        <view class="benefit-item" wx:for="{{memberBenefits}}" wx:key="index">
          <text class="benefit-icon">{{item.icon}}</text>
          <text class="benefit-text">{{item.text}}</text>
        </view>
      </view>
      <view class="benefits-card-footer">
        <text class="benefits-expiry" wx:if="{{memberStatus.expiresAtFormatted}}">有效期至 {{memberStatus.expiresAtFormatted}} · 自动续费</text>
        <text class="benefits-manage" bindtap="onGoMembership" role="button" aria-label="管理会员">管理会员 →</text>
      </view>
    </view>

    <!-- ============ 非会员：权益摘要（一行 + 箭头 · 整卡可点） ============ -->
    <view class="benefits-card benefits-card--locked anim-fade-up anim-stagger-3" wx:else bindtap="onGoMembership" role="button" aria-label="开通会员，解锁全部权益">
      <view class="benefits-locked-row">
        <text class="benefits-locked-title">✦ 开通会员 · 无限解读</text>
        <text class="benefits-locked-hint">无限解读 · AI追问 · 深度解读</text>
        <text class="benefits-locked-arrow">→</text>
      </view>
    </view>

    <!-- ============ 你的专属塔罗师 ============ -->
    <view class="persona-usage-card anim-fade-up anim-stagger-4" wx:if="{{personaStats.length > 0}}">
      <view class="persona-usage-header">
        <image src="/images/icons/star_64.png" mode="aspectFit" class="persona-usage-header-icon" aria-label="专属塔罗师" />
        <text class="persona-usage-title">✦ 你的专属塔罗师</text>
      </view>
      <text class="persona-usage-sub" wx:if="{{mostUsedPersona}}">
        你最常使用的是 <text class="persona-usage-highlight">{{mostUsedPersona.icon}} {{mostUsedPersona.name}}</text>，共 {{mostUsedPersonaCount}} 次
      </text>
      <view class="persona-usage-list">
        <view class="persona-usage-item" wx:for="{{personaStats}}" wx:key="key">
          <text class="persona-usage-icon">{{item.icon}}</text>
          <view class="persona-usage-info">
            <text class="persona-usage-name">{{item.name}}</text>
            <text class="persona-usage-desc" wx:if="{{item.desc}}">{{item.desc}}</text>
          </view>
          <text class="persona-usage-count">{{item.count}}次</text>
        </view>
      </view>
    </view>

    <!-- ============ Menu items（P1-2：三组分组） ============ -->
    <view class="menu-section anim-fade-up anim-stagger-3">
      <view class="menu-section-title anim-fade-up anim-stagger-1">
        <text class="menu-section-label">我的内容</text>
      </view>
      <view class="menu-item anim-slide-up anim-stagger-1" bindtap="onGoDiary" role="button" aria-label="进入我的日记">
        <view class="menu-icon-wrap">
          <image src="/images/icons/diary_64.png" mode="aspectFit" class="menu-icon-img" aria-label="我的日记"></image>
        </view>
        <view class="menu-content">
          <text class="menu-title">我的日记</text>
          <text class="menu-desc">记录你的星光感悟</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <!-- UX 修复: 痛点#5 — 菜单名区分"卡牌收藏"与下方"收藏的解读"，避免两个收藏入口混淆 -->
      <view class="menu-item anim-slide-up anim-stagger-2" bindtap="onGoFavorites" role="button" aria-label="查看收藏的卡牌">
        <view class="menu-icon-wrap">
          <image src="/images/icons/star_filled_64.png" mode="aspectFit" class="menu-icon-img" aria-label="收藏的卡牌"></image>
        </view>
        <view class="menu-content">
          <text class="menu-title">收藏的卡牌</text>
          <text class="menu-desc">{{favoriteCount}}张牌</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <!-- 邀请朋友 — 裂变分享入口 -->
      <view class="menu-item menu-item--invite anim-slide-up anim-stagger-3" bindtap="onGoShareCenter" role="button" aria-label="邀请朋友">
        <view class="menu-icon-wrap">
          <image src="/images/icons/sparkle_64.png" mode="aspectFit" class="menu-icon-img" aria-label="邀请朋友"></image>
        </view>
        <view class="menu-content">
          <text class="menu-title">邀请朋友</text>
          <text class="menu-desc">已获 {{inviteRewards || 0}} 次免费解读</text>
        </view>
        <view class="menu-badge-invite" wx:if="{{inviteRewards > 0}}">
          <text class="menu-badge-text">{{inviteRewards}}</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <!-- 每日签到 — P3-1 恢复入口 -->
      <view class="menu-item anim-slide-up anim-stagger-3" bindtap="onGoCheckin" role="button" aria-label="每日签到">
        <view class="menu-icon-wrap">
          <image src="/images/icons/star_64.png" mode="aspectFit" class="menu-icon-img" aria-label="每日签到"></image>
        </view>
        <view class="menu-content">
          <text class="menu-title">每日签到</text>
          <text class="menu-desc">连续打卡，解锁等级与会员奖励</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-section-title anim-fade-up anim-stagger-3">
        <text class="menu-section-label">会员与服务</text>
      </view>
      <view class="menu-item anim-slide-up anim-stagger-4" bindtap="onGoMembership" role="button" aria-label="进入会员中心">
        <view class="menu-icon-wrap">
          <image src="/images/icons/member_64.png" mode="aspectFit" class="menu-icon-img" aria-label="会员中心"></image>
        </view>
        <view class="menu-content">
          <text class="menu-title">{{memberStatus.is_member ? '会员中心' : '开通会员'}}</text>
          <text class="menu-desc">{{memberStatus.is_member ? '管理你的会员权益' : '解锁无限占卜与追问'}}</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item anim-slide-up anim-stagger-5 {{isAnnualReportSeason ? 'menu-item--annual-season' : ''}}" bindtap="onGoAnnualReport" role="button" aria-label="查看年度报告">
        <view class="menu-icon-wrap">
          <image src="/images/icons/report_64.png" mode="aspectFit" class="menu-icon-img" aria-label="年度报告"></image>
        </view>
        <view class="menu-content">
          <text class="menu-title">
            <text wx:if="{{isAnnualReportSeason}}" class="menu-season-badge">✨</text>
            年度报告
          </text>
          <text class="menu-desc">{{isAnnualReportSeason ? annualReportYear + ' 年度报告已上线' : '回顾你一年的星途旅程'}}</text>
        </view>
        <image wx:if="{{isAnnualReportSeason}}" class="menu-arrow-img menu-arrow-img--season" src="/images/icons/star_64.png" mode="aspectFit" aria-label="年度报告" />
        <text wx:else class="menu-arrow">›</text>
      </view>
      <view class="menu-item anim-slide-up anim-stagger-6" bindtap="onToggleYearEndReminder" role="button" aria-label="切换年末报告提醒">
        <view class="menu-icon-wrap">
          <image src="/images/icons/sparkle_64.png" mode="aspectFit" class="menu-icon-img" aria-label="年末报告提醒"></image>
        </view>
        <view class="menu-content">
          <text class="menu-title">年末报告提醒</text>
          <text class="menu-desc">{{yearEndReminderEnabled ? '已开启 · 年底推送年度报告' : '关闭'}}</text>
        </view>
        <image wx:if="{{yearEndReminderEnabled}}" class="menu-arrow-img" src="/images/icons/star_64.png" mode="aspectFit" aria-label="报告提醒开启" />
        <text wx:else class="menu-arrow">○</text>
      </view>
      <view id="settings-section" class="menu-section-title anim-fade-up anim-stagger-7">
        <text class="menu-section-label">设置</text>
      </view>
      <view class="menu-item anim-slide-up anim-stagger-7" bindtap="onToggleSound" role="button" aria-label="切换音效开关">
        <view class="menu-icon-wrap">
          <image src="/images/icons/theme_general_64.png" mode="aspectFit" class="menu-icon-img" aria-label="音效"></image>
        </view>
        <view class="menu-content">
          <text class="menu-title">音效</text>
          <text class="menu-desc">{{soundEnabled ? '已开启' : '已关闭'}}</text>
        </view>
        <image wx:if="{{soundEnabled}}" class="menu-arrow-img" src="/images/icons/star_64.png" mode="aspectFit" aria-label="音效开启" />
        <text wx:else class="menu-arrow">○</text>
      </view>
      <view class="menu-item anim-slide-up anim-stagger-8" bindtap="onToggleAmbient" role="button" aria-label="切换星空环境音">
        <view class="menu-icon-wrap">
          <image src="/images/icons/theme_general_64.png" mode="aspectFit" class="menu-icon-img" aria-label="星空环境音"></image>
        </view>
        <view class="menu-content">
          <text class="menu-title">🌙 星空环境音</text>
          <text class="menu-desc">{{ambientEnabled ? '已开启' : '已关闭'}}</text>
        </view>
        <image wx:if="{{ambientEnabled}}" class="menu-arrow-img" src="/images/icons/star_64.png" mode="aspectFit" aria-label="星空环境音开启" />
        <text wx:else class="menu-arrow">○</text>
      </view>
      <!-- ===== Push Notification Settings ===== -->
      <view class="menu-section-title anim-fade-up anim-stagger-9">
        <text class="menu-section-label">推送设置</text>
      </view>
      <view class="menu-item anim-slide-up anim-stagger-10" bindtap="onSubscribeDailyCard" role="button" aria-label="订阅每日塔罗推送">
        <view class="menu-icon-wrap">
          <image src="/images/icons/star_64.png" mode="aspectFit" class="menu-icon-img" aria-label="每日推送"></image>
        </view>
        <view class="menu-content">
          <text class="menu-title">每日塔罗推送</text>
          <text class="menu-desc">{{pushDailyCard ? '已开启 · 每日推送今日塔罗' : '关闭'}}</text>
        </view>
        <image wx:if="{{pushDailyCard}}" class="menu-arrow-img" src="/images/icons/star_64.png" mode="aspectFit" aria-label="每日推送已开启" />
        <text wx:else class="menu-arrow">○</text>
      </view>
      <view class="menu-item anim-slide-up anim-stagger-11" bindtap="onOpenPushSettings" role="button" aria-label="打开推送管理">
        <view class="menu-icon-wrap">
          <image src="/images/icons/about_64.png" mode="aspectFit" class="menu-icon-img" aria-label="推送管理"></image>
        </view>
        <view class="menu-content">
          <text class="menu-title">推送管理</text>
          <text class="menu-desc">在系统设置中管理通知权限</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item anim-slide-up anim-stagger-13" bindtap="onToggleDrawMode" role="button" aria-label="切换默认抽牌模式">
        <view class="menu-icon-wrap">
          <image src="/images/icons/theme_general_64.png" mode="aspectFit" class="menu-icon-img" aria-label="默认抽牌模式"></image>
        </view>
        <view class="menu-content">
          <text class="menu-title">默认抽牌模式</text>
          <text class="menu-desc">{{defaultDrawMode === 'immersive' ? '沉浸解读' : '快速抽牌'}}</text>
        </view>
        <image wx:if="{{defaultDrawMode === 'immersive'}}" class="menu-arrow-img" src="/images/icons/sparkle_64.png" mode="aspectFit" aria-label="沉浸解读模式" />
        <image wx:else class="menu-arrow-img" src="/images/icons/lightning_64.png" mode="aspectFit" aria-label="快速抽牌模式" />
      </view>
      <view class="menu-item anim-slide-up anim-stagger-14" bindtap="onGoAbout" role="button" aria-label="关于星光映照">
        <view class="menu-icon-wrap">
          <image src="/images/icons/about_64.png" mode="aspectFit" class="menu-icon-img" aria-label="关于星光映照"></image>
        </view>
        <view class="menu-content">
          <text class="menu-title">关于星光映照</text>
          <text class="menu-desc">塔罗是镜子，不是预言</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item anim-slide-up anim-stagger-15" bindtap="onLogout" role="button" aria-label="退出登录">
        <view class="menu-icon-wrap">
          <image src="/images/icons/about_64.png" mode="aspectFit" class="menu-icon-img" aria-label="退出登录"></image>
        </view>
        <view class="menu-content">
          <text class="menu-title">退出登录</text>
          <text class="menu-desc">退出当前账号，可随时重新登录</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item menu-item--danger anim-slide-up anim-stagger-16" bindtap="onDeleteAccount" role="button" aria-label="注销账号">
        <view class="menu-icon-wrap">
          <image src="/images/icons/warning_64.png" mode="aspectFit" class="menu-icon-img" aria-label="注销账号"></image>
        </view>
        <view class="menu-content">
          <text class="menu-title menu-title--danger">注销账号</text>
          <text class="menu-desc">注销后数据将被删除或匿名化处理</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <!-- ============ AI 周回顾（P1-2：降权移到菜单之后） ============ -->
    <view class="weekly-card anim-fade-up anim-stagger-4">
      <view class="weekly-card-header">
        <image src="/images/icons/report_64.png" mode="aspectFit" class="weekly-card-header-icon" aria-label="AI 周回顾" />
        <text class="weekly-card-title">✦ AI 周回顾</text>
      </view>
      <text class="weekly-card-desc">本周心情轨迹 · 常遇之牌 · AI 寄语 — 生成一张属于你的星光周报长图</text>
      <button
        class="weekly-card-btn"
        bindtap="onShareWeeklyReport"
        loading="{{weeklyLoading}}"
        disabled="{{weeklyLoading}}"
        aria-label="生成AI周报分享图"
      >
        <image class="btn-inline-icon" src="/images/icons/star_cream_64.png" mode="aspectFit" aria-label="生成分享图" />
        <text>{{weeklyLoading ? '正在生成周报...' : '生成分享图'}}</text>
      </button>
    </view>

    <!-- ============ 我的记录（收藏的解读 + 占卜历史） ============ -->
    <view class="records-group-title anim-fade-up anim-stagger-4">
      <text class="records-group-label">我的记录</text>
    </view>

    <!-- ============ Saved Readings ============ -->
    <view class="history-section anim-fade-up anim-stagger-4">
      <view class="history-header">
        <view class="history-header-left">
          <image src="/images/icons/history_64.png" mode="aspectFit" class="history-header-icon-img" aria-label="收藏的解读"></image>
          <text class="history-header-title">收藏的解读</text>
        </view>
        <button class="clear-btn" bindtap="onClearSavedReadings" wx:if="{{savedReadings.length > 0}}">清除</button>
      </view>

      <!-- 空状态 -->
      <view wx:if="{{savedReadings.length === 0}}" class="empty-state-inline">
        <image class="empty-icon-img" src="/images/icons/theme_general_64.png" mode="aspectFit" aria-label="暂无收藏" />
        <text class="empty-text" wx:if="{{savedReadingsLoading}}">加载中...</text>
        <text class="empty-text" wx:else>暂无收藏的解读</text>
        <text class="empty-hint">在解读页面点击「收藏本次解读」即可收藏</text>
      </view>

      <!-- 收藏列表 -->
      <view wx:else>
        <view class="history-list">
          <view
            class="history-item anim-slide-up anim-stagger-{{index + 1}}"
            wx:for="{{savedReadings}}" wx:key="id"
            data-id="{{item.id}}"
            bindtap="onViewReading" role="button" aria-label="查看{{item.spreadTypeName}}解读"
          >
            <view class="card-img-wrap history-thumb card-img-wrap--error">
              <view class="card-img-fallback">
                <image class="card-img-fallback-icon" src="/images/icons/card_back_64.png" mode="aspectFit" lazy-load aria-label="占卜记录缩略图" />
              </view>
            </view>
            <view class="history-info">
              <text class="history-spread-name">{{item.spreadTypeName}}</text>
              <text class="history-theme" wx:if="{{item.theme}}">{{item.theme}}</text>
              <text class="history-meta" wx:if="{{item.createdAtFormatted}}">
                {{item.createdAtFormatted}}
              </text>
            </view>
            <text class="history-arrow">›</text>
          </view>
        </view>
      </view>
    </view>

    <!-- ============ History ============ -->
    <view class="history-section anim-fade-up anim-stagger-5">
      <view class="history-header">
        <view class="history-header-left">
          <image src="/images/icons/history_64.png" mode="aspectFit" class="history-header-icon-img" aria-label="占卜历史"></image>
          <text class="history-header-title">占卜历史</text>
        </view>
        <button class="clear-btn" bindtap="onClearHistory" wx:if="{{readingHistory.length > 0}}">清除</button>
      </view>

      <!-- 空状态 -->
      <view wx:if="{{readingHistory.length === 0}}" class="empty-state-inline">
        <image class="empty-icon-img" src="/images/icons/theme_general_64.png" mode="aspectFit" aria-label="暂无占卜记录" />
        <text class="empty-text">暂无占卜记录</text>
        <text class="empty-hint">开始你的第一次占卜吧</text>
        <button class="btn-gold-empty begin-reading-btn" bindtap="onGoToReading">
          <image class="btn-inline-icon" src="/images/icons/star_cream_64.png" mode="aspectFit" aria-label="开始占卜" />
          <text>开始占卜</text>
        </button>
      </view>

      <!-- 历史列表 -->
      <scroll-view scroll-y style="max-height:70vh" bindscrolltolower="onScrollToBottom" wx:else>
        <view class="history-list">
          <view
            class="history-card anim-slide-up anim-stagger-{{index + 1}}"
            wx:for="{{readingHistory}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="onViewReading" role="button" aria-label="查看{{item.spreadTypeName}}解读"
          >
            <view class="history-card-header">
              <text class="history-spread-type">{{item.spreadTypeName}}</text>
              <text class="history-date">{{item.createdAtFormatted}}</text>
            </view>
            <text class="history-question" wx:if="{{item.question}}">"{{item.question}}"</text>
            <view class="history-card-footer">
              <text class="history-theme">{{item.theme || '综合'}}</text>
              <text class="history-action">查看解读 →</text>
            </view>
          </view>
        </view>

        <!-- 加载更多 -->
        <view wx:if="{{loadingMore}}" class="loading-more">
          <view class="loading-spinner"></view>
          <text class="loading-text">加载更多...</text>
        </view>
        <view wx:elif="{{!hasMore && readingHistory.length > 0}}" class="loaded-all">
          <text class="loaded-all-line"></text>
          <text class="loaded-all-text">已加载全部</text>
          <text class="loaded-all-line"></text>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- ============ AI 周报分享长图 ============ -->
  <weekly-report-poster
    visible="{{showWeeklyPoster}}"
    weeklyData="{{weeklyReportData}}"
    cardImagePath="{{weeklyCardImage}}"
    nickname="{{user.nickname || '星光旅人'}}"
    bind:close="onCloseWeeklyPoster"
    bind:share="onShareWeeklyPoster"
  />
</view>
