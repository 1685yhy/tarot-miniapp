/* ============================================================
   Profile — Warm Paper Design System
   Warm ivory base, deep rose accent, sage subtle
   User card, stats row, menu sections, history list
   ============================================================ */

/* -----------------------------------------------------------
   1. CONTAINER
   ----------------------------------------------------------- */

.container {
  padding: var(--page-padding);
  padding-bottom: calc(var(--page-padding) + var(--safe-area-bottom));
  min-height: 100vh;
  position: relative;
  z-index: var(--z-base);
}

/* -----------------------------------------------------------
   2. COLOR UTILITIES
   ----------------------------------------------------------- */

.accent {
  color: var(--color-accent);
}

.subtle {
  color: var(--color-subtle);
}

/* -----------------------------------------------------------
   3. ERROR STATE
   ----------------------------------------------------------- */

.error-state {
  text-align: center;
  padding: var(--spacing-8) var(--spacing-6);
}

.error-icon {
  width: 80rpx;
  height: 80rpx;
  display: block;
  margin: 0 auto var(--spacing-5);
  opacity: 0.30;
}

.error-text {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--spacing-3);
}

.error-hint {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--spacing-6);
  opacity: 0.70;
}

.btn-small {
  font-size: var(--font-size-body);
  padding: var(--spacing-4) var(--spacing-6);
}

/* -----------------------------------------------------------
   4. EMPTY STATE
   ----------------------------------------------------------- */

.empty-state-inline {
  text-align: center;
  padding: var(--spacing-7) 0;
}

.empty-state-inline .empty-icon {
  width: 72rpx;
  height: 72rpx;
  display: block;
  margin: 0 auto var(--spacing-5);
  opacity: 0.25;
}

.empty-state-inline .empty-text {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--spacing-3);
}

.empty-state-inline .empty-hint {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  display: block;
  opacity: 0.70;
}

/* -----------------------------------------------------------
   5. USER CARD — Centered info with avatar
   ----------------------------------------------------------- */

.user-card {
  text-align: center;
  padding: var(--spacing-7) var(--spacing-6) var(--spacing-6);
  border-radius: var(--radius-medium);
  margin-bottom: var(--spacing-6);
  background: var(--color-surface);
  border: 1rpx solid rgba(139, 126, 110, 0.12);
  box-shadow: var(--shadow-subtle);
  position: relative;
  overflow: hidden;
}

.avatar-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-pill);
  background: rgba(139, 126, 110, 0.06);
  border: 2rpx solid rgba(176, 102, 80, 0.20);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto var(--spacing-4);
  position: relative;
}

.avatar-icon {
  width: 56rpx;
  height: 56rpx;
  opacity: 0.50;
}

.user-name {
  display: block;
  font-size: var(--font-size-subhead);
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
  letter-spacing: var(--letter-spacing-none);
  margin-bottom: var(--spacing-3);
}

.user-badge-row {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: var(--spacing-3);
  margin-bottom: var(--spacing-3);
}

.badge {
  display: inline-block;
  padding: 4rpx var(--spacing-5);
  border-radius: var(--radius-pill);
  font-size: var(--font-size-body);
  background: var(--color-surface);
  color: var(--color-text-secondary);
  border: 1rpx solid rgba(139, 126, 110, 0.15);
  letter-spacing: var(--letter-spacing-none);
}

.badge--premium {
  background: rgba(176, 102, 80, 0.08);
  color: var(--color-accent);
  border-color: rgba(176, 102, 80, 0.15);
}

.badge--free {
  background: rgba(139, 126, 110, 0.06);
  color: var(--color-text-secondary);
  border-color: rgba(139, 126, 110, 0.10);
}

.badge-date {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  display: block;
  width: 100%;
  margin-top: var(--spacing-1);
  opacity: 0.70;
}

/* Upgrade button */
.upgrade-btn {
  margin-top: var(--spacing-5);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--color-accent);
  color: var(--color-surface);
  font-weight: var(--font-weight-semibold);
  font-size: var(--font-size-body);
  border: none;
  border-radius: var(--radius-pill);
  padding: var(--spacing-5) var(--spacing-7);
  line-height: var(--line-height-heading);
  box-shadow: var(--shadow-subtle);
  transition: all var(--duration-feedback) ease;
}

.upgrade-btn:active {
  transform: scale(0.97);
  opacity: 0.90;
  box-shadow: var(--shadow-subtle);
}

/* -----------------------------------------------------------
   6. STATS ROW
   ----------------------------------------------------------- */

.stats-row {
  display: flex;
  background: var(--color-surface);
  border: 1rpx solid rgba(139, 126, 110, 0.12);
  border-radius: var(--radius-medium);
  padding: var(--spacing-5) var(--spacing-6);
  margin-bottom: var(--spacing-6);
  box-shadow: var(--shadow-subtle);
}

.stat-item {
  flex: 1;
  text-align: center;
  position: relative;
  padding: var(--spacing-3) 0;
}

.stat-item + .stat-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 1rpx;
  height: 44%;
  background: rgba(139, 126, 110, 0.12);
}

.stat-num {
  font-size: var(--font-size-subhead);
  font-weight: var(--font-weight-bold);
  color: var(--color-accent);
  display: block;
  line-height: var(--line-height-heading);
}

.stat-label {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  display: block;
  margin-top: var(--spacing-3);
  letter-spacing: var(--letter-spacing-none);
}

/* -----------------------------------------------------------
   7. MENU SECTION
   ----------------------------------------------------------- */

.menu-section {
  margin-bottom: var(--spacing-6);
  border-radius: var(--radius-medium);
  overflow: hidden;
  background: var(--color-surface);
  border: 1rpx solid rgba(139, 126, 110, 0.12);
  box-shadow: var(--shadow-subtle);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: var(--spacing-5) var(--spacing-6);
  transition: all var(--duration-feedback) ease;
  position: relative;
}

.menu-item + .menu-item {
  border-top: 1rpx solid rgba(139, 126, 110, 0.08);
}

.menu-item:active {
  background: rgba(139, 126, 110, 0.04);
}

/* Icon circle */
.menu-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-pill);
  background: rgba(176, 102, 80, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: var(--spacing-4);
  border: 1rpx solid rgba(176, 102, 80, 0.12);
}

.menu-icon {
  width: 32rpx;
  height: 32rpx;
  display: block;
}

/* Content area */
.menu-content {
  flex: 1;
  min-width: 0;
}

.menu-title {
  display: block;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  line-height: var(--line-height-heading);
  margin-bottom: 4rpx;
}

.menu-desc {
  display: block;
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  line-height: var(--line-height-body);
}

/* Right arrow */
.menu-arrow {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.20;
  margin-left: var(--spacing-3);
  flex-shrink: 0;
}

/* -----------------------------------------------------------
   8. HISTORY SECTION
   ----------------------------------------------------------- */

.history-section {
  border-radius: var(--radius-medium);
  overflow: hidden;
  background: var(--color-surface);
  border: 1rpx solid rgba(139, 126, 110, 0.12);
  box-shadow: var(--shadow-subtle);
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-5) var(--spacing-6);
  border-bottom: 1rpx solid rgba(139, 126, 110, 0.08);
}

.history-header-left {
  display: flex;
  align-items: center;
  gap: var(--spacing-3);
}

.history-header-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.60;
}

.history-header-title {
  font-size: var(--font-size-body-large);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  letter-spacing: var(--letter-spacing-none);
}

.clear-btn {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  background: none;
  border: none;
  padding: var(--spacing-3) var(--spacing-4);
  border-radius: var(--radius-small);
  transition: all var(--duration-feedback);
}

.clear-btn:active {
  color: var(--color-accent);
  background: rgba(176, 102, 80, 0.04);
}

.history-list {
  padding: 0;
}

.history-item {
  display: flex;
  align-items: center;
  padding: var(--spacing-5) var(--spacing-6);
  border-bottom: 1rpx solid rgba(139, 126, 110, 0.06);
  transition: background var(--duration-feedback);
  gap: var(--spacing-4);
}

.history-item:last-child {
  border-bottom: none;
}

.history-item:active {
  background: rgba(139, 126, 110, 0.04);
}

.history-thumb {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-small);
  flex-shrink: 0;
  background: rgba(139, 126, 110, 0.06);
  border: 1rpx solid rgba(139, 126, 110, 0.12);
}

.history-thumb-placeholder {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-small);
  flex-shrink: 0;
  background: rgba(139, 126, 110, 0.04);
  border: 1rpx solid rgba(139, 126, 110, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}

.thumb-placeholder-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.20;
}

.history-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.history-spread-name {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  line-height: var(--line-height-heading);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.history-theme {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  line-height: var(--line-height-body);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.history-meta {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  line-height: var(--line-height-body);
  opacity: 0.70;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.history-arrow {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.18;
  margin-left: auto;
  flex-shrink: 0;
}

/* -----------------------------------------------------------
   9. LOADING
   ----------------------------------------------------------- */

.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-5);
  gap: var(--spacing-3);
}

.loading-spinner {
  width: 28rpx;
  height: 28rpx;
  border: 2rpx solid rgba(139, 126, 110, 0.15);
  border-top-color: var(--color-accent);
  border-radius: var(--radius-pill);
  animation: spin var(--duration-emphasis) linear infinite;
}

.loading-text {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
}

.loaded-all {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-5);
  gap: var(--spacing-3);
}

.loaded-all-line {
  display: block;
  width: 60rpx;
  height: 1rpx;
  background: rgba(139, 126, 110, 0.12);
}

.loaded-all-text {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  opacity: 0.60;
  letter-spacing: var(--letter-spacing-display);
}

/* -----------------------------------------------------------
   10. SKELETON
   ----------------------------------------------------------- */

.skeleton-card {
  width: 100%;
  height: 320rpx;
  border-radius: var(--radius-medium);
  background: rgba(139, 126, 110, 0.08);
  margin-bottom: var(--spacing-6);
  animation: pulse-soft 1500ms ease-in-out infinite;
}

.skeleton-stats {
  width: 100%;
  height: 110rpx;
  border-radius: var(--radius-medium);
  background: rgba(139, 126, 110, 0.08);
  margin-bottom: var(--spacing-6);
  animation: pulse-soft 1500ms ease-in-out infinite;
}

.skeleton-actions {
  display: flex;
  gap: var(--spacing-4);
  margin-bottom: var(--spacing-6);
}

.skeleton-action {
  flex: 1;
  height: 96rpx;
  border-radius: var(--radius-medium);
  background: rgba(139, 126, 110, 0.08);
  animation: pulse-soft 1500ms ease-in-out infinite;
}

/* -----------------------------------------------------------
   11. ENTRANCE ANIMATIONS
   ----------------------------------------------------------- */

.anim-fade-in-up-1 { opacity: 0; animation: fade-up var(--duration-emphasis) ease 0.08s forwards; }
.anim-fade-in-up-2 { opacity: 0; animation: fade-up var(--duration-emphasis) ease 0.20s forwards; }
.anim-fade-in-up-3 { opacity: 0; animation: fade-up var(--duration-emphasis) ease 0.32s forwards; }
.anim-fade-in-up-4 { opacity: 0; animation: fade-up var(--duration-emphasis) ease 0.44s forwards; }
.anim-fade-in-up-5 { opacity: 0; animation: fade-up var(--duration-emphasis) ease 0.56s forwards; }
