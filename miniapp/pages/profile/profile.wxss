/* ============================================================
   Profile Page — Starlight Design System
   Uses design tokens from common.wxss (CSS custom properties)
   #1A1A3E bg · #F4D48C gold · #B8A9E0 lavender · #F0EDE8 text
   ============================================================ */


/* ============================================================
   Container
   ============================================================ */
.container {
  padding: var(--spacing-xl);
  padding-bottom: calc(var(--safe-area-bottom) + var(--spacing-5xl));
  min-height: 100vh;
  position: relative;
  z-index: 1;
}

/* ============================================================
   Gold / lavender utilities
   ============================================================ */
.gold {
  color: var(--color-gold);
}
.lavender {
  color: #B8A9E0;
}

/* ============================================================
   Error State
   ============================================================ */
.error-state {
  text-align: center;
  padding: var(--spacing-5xl) var(--spacing-xl);
}

.error-icon {
  font-size: calc(var(--font-size-display) + 24rpx);
  display: block;
  margin-bottom: var(--spacing-md);
  opacity: 0.50;
}

.error-text {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--spacing-xs);
}

.error-hint {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  display: block;
  margin-bottom: var(--spacing-2xl);
}

.btn-small {
  font-size: var(--font-size-caption);
  padding: var(--spacing-sm) var(--spacing-lg);
}

/* ============================================================
   Empty State (inline)
   ============================================================ */
.empty-state-inline {
  text-align: center;
  padding: var(--spacing-4xl) 0;
}

.empty-state-inline .empty-icon {
  font-size: calc(var(--font-size-display) + 16rpx);
  display: block;
  margin-bottom: var(--spacing-md);
  opacity: 0.35;
}

.empty-state-inline .empty-text {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--spacing-xs);
}

.empty-state-inline .empty-hint {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  display: block;
}

/* Empty state icon image — gold-tinted star */
.empty-state-inline .empty-icon-img {
  width: 80rpx;
  height: 80rpx;
  display: block;
  margin: 0 auto var(--spacing-md);
  opacity: 0.40;
  /* filter replaced */
}

/* ============================================================
   USER CARD — Centered · Gold name · Warm glow
   ============================================================ */
.user-card {
  text-align: center;
  padding: var(--spacing-3xl) var(--spacing-xl) var(--spacing-2xl);
  border-radius: var(--radius-lg);
  margin-bottom: var(--spacing-xl);
  background: var(--color-surface-gradient);
  border: 1.5rpx solid rgba(244, 212, 140, 0.12);
  box-shadow: var(--shadow-card);
  position: relative;
  overflow: hidden;
}

/* Golden top glow */
.user-card::before {
  content: '';
  position: absolute;
  top: -120rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 400rpx;
  height: 240rpx;
  background: radial-gradient(circle, rgba(244, 212, 140, 0.10) 0%, transparent 70%);
  pointer-events: none;
}

/* Avatar — golden circle with sparkle emoji */
.avatar-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--color-surface);
  border: 3rpx solid var(--color-gold);
  box-shadow: 0 0 30rpx rgba(244, 212, 140, 0.30), inset 0 0 20rpx rgba(244, 212, 140, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto var(--spacing-sm);
  position: relative;
}

.avatar-emoji {
  width: 64rpx;
  height: 64rpx;
  display: block;
  /* filter replaced */
}

/* Username — gold */
.user-name {
  display: block;
  font-size: var(--font-size-title);
  font-weight: var(--font-weight-bold);
  color: var(--color-gold);
  letter-spacing: 2rpx;
  margin-bottom: var(--spacing-sm);
}

/* Badge row */
.user-badge-row {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: var(--spacing-xs);
  margin-bottom: var(--spacing-sm);
}

.user-status-text {
  font-size: var(--font-size-caption);
  color: var(--color-lavender);
  letter-spacing: 1rpx;
}

.user-status-text.member-status {
  color: var(--color-gold);
  background: rgba(244, 212, 140, 0.14);
  padding: 4rpx var(--spacing-md);
  border-radius: var(--radius-pill);
  border: 1rpx solid rgba(244, 212, 140, 0.25);
}

.badge-date {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  display: block;
  width: 100%;
  margin-top: 4rpx;
}

/* Upgrade button — spacing only; .btn-primary.btn--sm for base style */
.upgrade-btn {
  margin-top: var(--spacing-md);
}

/* Begin reading CTA button (empty state) */
.begin-reading-btn {
  margin-top: 24rpx;
  background: linear-gradient(135deg, var(--color-gold), #D4AF37);
  color: var(--color-text-inverse);
  border: none;
  border-radius: 48rpx;
  padding: var(--spacing-md) var(--spacing-xl);
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-semibold);
}

/* active/disabled states via common .btn-primary */

/* ============================================================
   STATS ROW — Golden numbers · Lavender labels
   ============================================================ */
.stats-row {
  display: flex;
  background: var(--color-surface-gradient);
  border: 1.5rpx solid rgba(244, 212, 140, 0.12);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg) var(--spacing-xl);
  margin-bottom: var(--spacing-xl);
  box-shadow: var(--shadow-card);
}

.stat-item {
  flex: 1;
  text-align: center;
  position: relative;
  padding: var(--spacing-sm) 0;
}

.stat-item + .stat-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 1rpx;
  height: 44%;
  background: linear-gradient(
    180deg, transparent 0%,
    rgba(244, 212, 140, 0.20) 50%,
    transparent 100%
  );
}

.stat-num {
  font-size: var(--font-size-title);
  font-weight: var(--font-weight-bold);
  color: var(--color-gold);
  display: block;
  line-height: 1.1;
  text-shadow: 0 0 20rpx rgba(244, 212, 140, 0.20);
}

.stat-label {
  font-size: var(--font-size-caption);
  color: var(--color-lavender);
  display: block;
  margin-top: 6rpx;
  letter-spacing: 2rpx;
}

.stat-subtitle {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary, #A098C0);
  display: block;
  margin-top: 4rpx;
  letter-spacing: 1rpx;
  opacity: 0.75;
}

/* ============================================================
   MENU SECTION — Icon circles with gold background
   ============================================================ */
.menu-section {
  margin-bottom: var(--spacing-2xl);
  border-radius: var(--radius-lg);
  overflow: hidden;
  background: var(--color-surface-gradient);
  border: 1.5rpx solid rgba(244, 212, 140, 0.12);
  box-shadow: var(--shadow-card);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: var(--spacing-md) var(--spacing-xl);
  transition: all var(--duration-fast) var(--ease-soft);
  position: relative;
  min-height: 88rpx;
}

.menu-item + .menu-item {
  border-top: 1rpx solid rgba(244, 212, 140, 0.06);
}

.menu-item:active {
  background: var(--color-card-hover);
  transform: scale(0.97);
}

/* Icon container — borderless, icon floats freely */
.menu-icon-wrap {
  flex-shrink: 0;
  margin-right: var(--spacing-md);
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-icon {
  font-size: var(--font-size-body);
  line-height: 1;
  display: block;
}

/* Menu icon images */
.menu-icon-img {
  width: 48rpx;
  height: 48rpx;
  display: block;
  /* filter replaced */
}

/* Content area */
.menu-content {
  flex: 1;
  min-width: 0;
}

.menu-title {
  display: block;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  line-height: var(--line-height-tight);
  margin-bottom: 4rpx;
}

.menu-desc {
  display: block;
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  line-height: var(--line-height-base);
}

/* Right arrow */
.menu-arrow {
  font-size: var(--font-size-body);
  color: var(--color-text-tertiary);
  opacity: 0.50;
  margin-left: var(--spacing-sm);
  flex-shrink: 0;
  line-height: 1;
  font-weight: var(--font-weight-bold);
}

/* ============================================================
   HISTORY CARD — Card-style reading archive entries
   ============================================================ */
.history-card {
  background: var(--color-surface-gradient);
  border: 1.5rpx solid rgba(244, 212, 140, 0.12);
  border-radius: var(--radius-md);
  padding: var(--spacing-lg) var(--spacing-xl);
  margin: var(--spacing-sm) var(--spacing-lg);
  box-shadow: var(--shadow-card);
  transition: all var(--duration-fast) var(--ease-out);
  position: relative;
  border-left: 4rpx solid var(--color-gold);
}
.history-card:first-child {
  margin-top: var(--spacing-md);
}
.history-card:last-child {
  margin-bottom: var(--spacing-md);
}
.history-card:active {
  transform: scale(0.97);
  border-color: rgba(244, 212, 140, 0.20);
  box-shadow: var(--shadow-card-press);
}
.history-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-xs);
}
.history-spread-type {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-semibold);
  color: var(--color-gold);
  letter-spacing: 1rpx;
}
.history-date {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}
.history-question {
  display: block;
  font-size: var(--font-size-caption);
  color: var(--color-text-secondary);
  font-style: italic;
  line-height: var(--line-height-base);
  margin-bottom: var(--spacing-sm);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.history-card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: var(--spacing-xxs);
}
.history-card-footer .history-theme {
  font-size: var(--font-size-xs);
  color: var(--color-lavender);
  opacity: 0.80;
}
.history-action {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-medium);
  color: var(--color-gold);
  letter-spacing: 1rpx;
}

/* ============================================================
   HISTORY SECTION — Card thumbnails on the left
   ============================================================ */
.history-section {
  border-radius: var(--radius-lg);
  background: var(--color-surface-gradient);
  border: 1.5rpx solid rgba(244, 212, 140, 0.12);
  box-shadow: var(--shadow-card);
  padding-bottom: var(--spacing-xs);
}

/* History scroll view with padding for card cards */
.history-section scroll-view {
  /* overflow-y set inline via style */
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-md) var(--spacing-xl);
  border-bottom: 1rpx solid rgba(244, 212, 140, 0.08);
}

.history-header-left {
  display: flex;
  align-items: center;
  gap: var(--spacing-xs);
}

.history-header-icon {
  font-size: var(--font-size-body);
  line-height: 1;
  opacity: 0.70;
}

/* History header icon image */
.history-header-icon-img {
  width: 32rpx;
  height: 32rpx;
  display: block;
  opacity: 0.85;
}

.history-header-title {
  font-size: var(--font-size-subhead);
  font-weight: var(--font-weight-bold);
  color: var(--color-gold);
  letter-spacing: 2rpx;
}

.clear-btn {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  background: none;
  border: none;
  padding: var(--spacing-xs) var(--spacing-sm);
  border-radius: var(--radius-sm);
  transition: all var(--duration-fast) var(--ease-out);
}

.clear-btn:active {
  color: var(--color-gold);
  background: rgba(244, 212, 140, 0.06);
}

/* History list */
.history-list {
  padding: 0;
}

/* Individual history item */
.history-item {
  display: flex;
  align-items: center;
  padding: var(--spacing-lg) var(--spacing-xl);
  border-bottom: 1rpx solid rgba(244, 212, 140, 0.05);
  transition: background var(--duration-fast) var(--ease-out);
  gap: var(--spacing-md);
}

.history-item:last-child {
  border-bottom: none;
}

.history-item:active {
  background: var(--color-card-hover);
  transform: scale(0.97);
}

/* Card thumbnail — 96x96rpx rounded image with clear card presence */
.history-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-md);
  flex-shrink: 0;
  background: var(--color-surface);
  border: 1rpx solid rgba(244, 212, 140, 0.18);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.20);
}

.history-thumb-placeholder {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-md);
  flex-shrink: 0;
  background: var(--color-surface);
  border: 1rpx solid rgba(244, 212, 140, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}

.thumb-placeholder-text {
  font-size: var(--font-size-body);
  opacity: 0.30;
  line-height: 1;
}

/* Info section (center) */
.history-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.history-spread-name {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-medium);
  color: var(--color-gold);
  line-height: var(--line-height-tight);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.history-theme {
  font-size: var(--font-size-caption);
  color: var(--color-text-secondary);
  line-height: var(--line-height-base);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.history-meta {
  font-size: var(--font-size-xs);
  color: var(--color-lavender);
  line-height: var(--line-height-base);
  opacity: 0.80;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* Right arrow */
.history-arrow {
  font-size: var(--font-size-body);
  color: var(--color-text-tertiary);
  opacity: 0.35;
  margin-left: auto;
  flex-shrink: 0;
  line-height: 1;
  font-weight: var(--font-weight-bold);
}

/* ============================================================
   Loading more — golden spinner
   ============================================================ */
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-md);
  gap: var(--spacing-sm);
}

.loading-spinner {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid rgba(244, 212, 140, 0.10);
  border-top-color: var(--color-gold);
  border-radius: var(--radius-full);
  animation: profile-spin 0.7s linear infinite;
}

@keyframes profile-spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
}

/* Loaded all indicator */
.loaded-all {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-md);
  gap: var(--spacing-sm);
}

.loaded-all-line {
  display: block;
  width: 60rpx;
  height: 1rpx;
  background: rgba(244, 212, 140, 0.12);
}

.loaded-all-text {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  opacity: 0.60;
  letter-spacing: 2rpx;
}

/* ============================================================
   SKELETON — Shapes only (shimmer from common.wxss)
   ============================================================ */
.skeleton-card {
  width: 100%;
  height: 320rpx;
  border-radius: var(--radius-lg);
  margin-bottom: var(--spacing-xl);
}

.skeleton-stats {
  width: 100%;
  height: 110rpx;
  border-radius: var(--radius-lg);
  margin-bottom: var(--spacing-xl);
}

.skeleton-actions {
  display: flex;
  gap: var(--spacing-md);
  margin-bottom: var(--spacing-2xl);
}

.skeleton-action {
  flex: 1;
  height: 96rpx;
  border-radius: var(--radius-lg);
}

/* Entrance animations via common.wxss: .anim-fade-up + .anim-stagger-* */
