/* ============================================================
   Profile Page — Starlight Design System
   Uses design tokens from common.wxss (CSS custom properties)
   #FAF6EF bg · #C9A97C gold · #D8D2E4 lavender · #3D3A36 text (E3 奶油疗愈)
   ============================================================ */


/* ============================================================
   Container
   ============================================================ */
.container {
  padding: var(--spacing-xl);
  padding-bottom: calc(var(--safe-area-bottom) + var(--spacing-5xl));
  min-height: 100vh;
  position: relative;
  z-index: 1;
}

/* ============================================================
   Gold / lavender utilities
   ============================================================ */
.gold {
  color: var(--color-gold-deep-ink);
}
.lavender {
  color: var(--color-lavender-deep);
}

/* ============================================================
   Error State
   ============================================================ */
.error-state {
  text-align: center;
  padding: var(--spacing-5xl) var(--spacing-xl);
}

.error-icon {
  font-size: calc(var(--font-size-display) + 24rpx);
  display: block;
  margin-bottom: var(--spacing-md);
  opacity: 0.50;
}

.error-text {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--spacing-xs);
}

.error-hint {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  display: block;
  margin-bottom: var(--spacing-2xl);
}

.btn-small {
  font-size: var(--font-size-caption);
  padding: var(--spacing-sm) var(--spacing-lg);
}

/* ============================================================
   Empty State (inline)
   ============================================================ */
.empty-state-inline {
  text-align: center;
  padding: var(--spacing-4xl) 0;
}

.empty-state-inline .empty-icon {
  font-size: calc(var(--font-size-display) + 16rpx);
  display: block;
  margin-bottom: var(--spacing-md);
  opacity: 0.35;
}

.empty-state-inline .empty-text {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--spacing-xs);
}

.empty-state-inline .empty-hint {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  display: block;
}

/* Empty state icon image — gold-tinted star */
.empty-state-inline .empty-icon-img {
  width: 80rpx;
  height: 80rpx;
  display: block;
  margin: 0 auto var(--spacing-md);
  opacity: 0.40;
  /* filter replaced */
}

/* ============================================================
   USER CARD — Centered · Gold name · Warm glow
   ============================================================ */
.user-card {
  text-align: center;
  padding: var(--spacing-3xl) var(--spacing-xl) var(--spacing-2xl);
  border-radius: var(--radius-lg);
  margin-bottom: var(--spacing-xl);
  background: var(--color-surface-gradient);
  border: 1.5rpx solid rgba(201, 169, 124, 0.12);
  box-shadow: var(--shadow-card);
  position: relative;
  overflow: hidden;
}

/* Golden top glow */
.user-card::before {
  content: '';
  position: absolute;
  top: -120rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 400rpx;
  height: 240rpx;
  background: radial-gradient(circle, rgba(201, 169, 124, 0.10) 0%, transparent 70%);
  pointer-events: none;
}

/* Avatar — golden circle with sparkle emoji */
.avatar-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--color-surface);
  border: 3rpx solid var(--color-gold);
  box-shadow: 0 0 30rpx rgba(201, 169, 124, 0.30), inset 0 0 20rpx rgba(201, 169, 124, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto var(--spacing-sm);
  position: relative;
}

.avatar-emoji {
  width: 64rpx;
  height: 64rpx;
  display: block;
  /* filter replaced */
}

/* Username — gold */
.user-name {
  display: block;
  font-size: var(--font-size-title);
  font-weight: var(--font-weight-bold);
  color: var(--color-gold-dark);
  letter-spacing: 2rpx;
  margin-bottom: var(--spacing-sm);
}

/* Badge row */
.user-badge-row {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: var(--spacing-xs);
  margin-bottom: var(--spacing-sm);
}

.user-status-text {
  font-size: var(--font-size-caption);
  color: var(--color-lavender-dark);
  letter-spacing: 1rpx;
}

.user-status-text.member-status {
  color: var(--color-gold-dark);
  background: rgba(201, 169, 124, 0.14);
  padding: 4rpx var(--spacing-md);
  border-radius: var(--radius-pill);
  border: 1rpx solid rgba(201, 169, 124, 0.25);
}

.badge-date {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  display: block;
  width: 100%;
  margin-top: 4rpx;
}

/* Upgrade button — spacing only; .btn-primary.btn--sm for base style */
.upgrade-btn {
  margin-top: var(--spacing-md);
}

/* Begin reading CTA button (empty state) */
.begin-reading-btn {
  margin-top: 24rpx;
  background: linear-gradient(135deg, var(--color-gold), var(--color-gold-dark));
  color: var(--color-text-inverse);
  border: none;
  border-radius: 48rpx;
  padding: var(--spacing-md) var(--spacing-xl);
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-semibold);
}

/* active/disabled states via common .btn-primary */

/* Inline icon inside buttons */
.btn-inline-icon {
  width: 28rpx;
  height: 28rpx;
  display: block;
}

/* ============================================================
   STATS ROW — 已删除（P1-2：与 journey-card / user-card 统计重复）
   ============================================================ */

/* ============================================================
   AI 周回顾 — 星光周报分享长图入口
   ============================================================ */
.weekly-card {
  background: var(--color-surface-gradient);
  border: 1.5rpx solid rgba(201, 169, 124, 0.12);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg) var(--spacing-xl);
  margin-bottom: var(--spacing-xl);
  box-shadow: var(--shadow-card);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.weekly-card-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-xs);
  margin-bottom: var(--spacing-sm);
}

.weekly-card-header-icon {
  width: 32rpx;
  height: 32rpx;
  display: block;
}

.weekly-card-title {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-semibold);
  color: var(--color-gold-dark);
  letter-spacing: 2rpx;
}

.weekly-card-desc {
  font-size: var(--font-size-caption);
  color: var(--color-text-secondary);
  line-height: 1.6;
  text-align: center;
  margin-bottom: var(--spacing-md);
}

.weekly-card-btn {
  background: linear-gradient(135deg, var(--color-gold), var(--color-gold-dark));
  color: var(--color-text-inverse);
  border: none;
  border-radius: 48rpx;
  padding: var(--spacing-md) var(--spacing-xl);
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-semibold);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-xs);
  min-width: 320rpx;
  transition: opacity 0.2s, transform 0.2s;
}

.weekly-card-btn::after {
  border: none;
}

.weekly-card-btn:active {
  opacity: 0.85;
  transform: scale(0.97);
}

.weekly-card-btn[disabled] {
  opacity: 0.7;
}

/* ============================================================
   我的星光之旅 — 2x2 stat grid · Golden numbers · Lavender labels
   ============================================================ */
.journey-card {
  background: var(--color-surface-gradient);
  border: 1.5rpx solid rgba(201, 169, 124, 0.12);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg) var(--spacing-xl) var(--spacing-md);
  margin-bottom: var(--spacing-xl);
  box-shadow: var(--shadow-card);
}

.journey-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-xs);
  margin-bottom: var(--spacing-sm);
}

.journey-header-icon {
  width: 32rpx;
  height: 32rpx;
  display: block;
}

.journey-title {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-semibold);
  color: var(--color-gold-dark);
  letter-spacing: 2rpx;
}

.journey-grid {
  display: flex;
  flex-wrap: wrap;
}

.journey-item {
  width: 50%;
  box-sizing: border-box;
  text-align: center;
  padding: var(--spacing-sm) 0;
  position: relative;
}

.journey-item:nth-child(odd)::after {
  content: '';
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 1rpx;
  height: 40%;
  background: linear-gradient(
    180deg, transparent 0%,
    rgba(201, 169, 124, 0.18) 50%,
    transparent 100%
  );
}

.journey-num-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 6rpx;
}

.journey-num {
  font-size: var(--font-size-title);
  font-weight: var(--font-weight-bold);
  color: var(--color-gold-dark);
  line-height: 1.1;
  text-shadow: 0 0 20rpx rgba(201, 169, 124, 0.20);
}

.journey-unit {
  font-size: var(--font-size-xs);
  color: var(--color-lavender-dark);
  letter-spacing: 1rpx;
}

.journey-label {
  font-size: var(--font-size-caption);
  color: var(--color-lavender-dark);
  display: block;
  margin-top: 6rpx;
  letter-spacing: 2rpx;
}

/* ============================================================
   我的牌运 — 牌运曲线入口卡（E3 奶油 · 细金描边）
   ============================================================ */
.fortune-entry-card {
  background: var(--color-surface-gradient);
  border: 1.5rpx solid rgba(201, 169, 124, 0.14);
  border-radius: var(--radius-lg);
  padding: var(--spacing-md) var(--spacing-xl);
  margin-bottom: var(--spacing-xl);
  box-shadow: var(--shadow-card);
  transition: transform var(--duration-fast) var(--ease-out),
              box-shadow var(--duration-fast) var(--ease-out);
}

.fortune-entry-header {
  display: flex;
  align-items: center;
  gap: var(--spacing-xs);
  margin-bottom: var(--spacing-xs);
}

.fortune-entry-icon {
  width: 30rpx;
  height: 30rpx;
  display: block;
  opacity: 0.9;
}

.fortune-entry-title {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-semibold);
  color: var(--color-gold-dark);
  letter-spacing: 2rpx;
}

.fortune-entry-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--spacing-sm);
}

.fortune-entry-desc {
  flex: 1;
  min-width: 0;
  font-family: var(--e3-serif, 'Songti SC', 'STSong', serif);
  font-size: 24rpx;
  color: var(--color-text-secondary, #8A8478);
  letter-spacing: 1rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.fortune-entry-arrow {
  font-size: 28rpx;
  color: var(--color-gold-dark);
  flex-shrink: 0;
  transition: transform 0.15s ease;
}

.fortune-entry-card:active .fortune-entry-arrow {
  transform: translateX(6rpx);
}

/* ============================================================
   MENU SECTION — Icon circles with gold background
   ============================================================ */
.menu-section {
  margin-bottom: var(--spacing-2xl);
  border-radius: var(--radius-lg);
  overflow: hidden;
  background: var(--color-surface-gradient);
  border: 1.5rpx solid rgba(201, 169, 124, 0.12);
  box-shadow: var(--shadow-card);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: var(--spacing-md) var(--spacing-xl);
  transition: background var(--duration-fast) var(--ease-soft),
              transform var(--duration-fast) var(--ease-soft);
  position: relative;
  min-height: 88rpx;
  height: 100rpx;
  box-sizing: border-box;
}

.menu-item + .menu-item {
  border-top: 1rpx solid rgba(201, 169, 124, 0.06);
}

.menu-item:active {
  background: var(--color-card-hover);
  transform: scale(0.97);
}

/* Icon container — borderless, icon floats freely */
.menu-icon-wrap {
  flex-shrink: 0;
  margin-right: var(--spacing-md);
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-icon {
  font-size: var(--font-size-body);
  line-height: 1;
  display: block;
}

/* Menu icon images */
.menu-icon-img {
  width: 48rpx;
  height: 48rpx;
  display: block;
  /* filter replaced */
}

/* Content area */
.menu-content {
  flex: 1;
  min-width: 0;
}

.menu-title {
  display: block;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  line-height: var(--line-height-tight);
  margin-bottom: 4rpx;
}

.menu-desc {
  display: block;
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  line-height: var(--line-height-base);
}

/* Right arrow */
.menu-arrow {
  font-size: var(--font-size-body);
  color: var(--color-text-tertiary);
  opacity: 0.50;
  margin-left: var(--spacing-sm);
  flex-shrink: 0;
  line-height: 1;
  font-weight: var(--font-weight-bold);
}

/* Invite menu item — subtle gold emphasis */
.menu-item--invite {
  border-left: 3rpx solid rgba(201, 169, 124, 0.25);
}

/* Seasonal annual report menu item — gold glow */
.menu-item--annual-season {
  border-left: 3rpx solid rgba(201, 169, 124, 0.30);
  background: linear-gradient(135deg, rgba(201,169,124,0.06) 0%, rgba(138,132,120,0.03) 100%);
}

/* Dangerous action menu item — 注销账号 */
.menu-item--danger {
  border-left: 3rpx solid rgba(230, 67, 64, 0.35);
}

.menu-title--danger {
  color: #e64340;
}

.menu-season-badge {
  font-size: 24rpx;
  margin-right: 6rpx;
  animation: season-badge-glow 2s ease-in-out infinite;
}

@keyframes season-badge-glow {
  0%, 100% { opacity: 0.6; }
  50% { opacity: 1; }
}

/* Right arrow image — toggle/status indicators */
.menu-arrow-img {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
  margin-left: var(--spacing-sm);
  display: block;
}

.menu-arrow-img--season {
  animation: arrow-season 1.5s ease-in-out infinite;
}

@keyframes arrow-season {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.2); }
}

/* Invite reward badge — small gold circle with count */
.menu-badge-invite {
  width: 36rpx;
  height: 36rpx;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, #C9A97C 0%, #A98B5F 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: var(--spacing-xs);
  flex-shrink: 0;
  box-shadow: 0 0 12rpx rgba(201, 169, 124, 0.30);
}

.menu-badge-text {
  font-size: 20rpx;
  font-weight: var(--font-weight-bold);
  color: var(--color-text-inverse);
  line-height: 1;
}

/* ============================================================
   HISTORY CARD — Card-style reading archive entries
   ============================================================ */
.history-card {
  background: var(--color-surface-gradient);
  border: 1.5rpx solid rgba(201, 169, 124, 0.12);
  border-radius: var(--radius-md);
  padding: var(--spacing-lg) var(--spacing-xl);
  margin: var(--spacing-sm) var(--spacing-lg);
  box-shadow: var(--shadow-card);
  transition: transform var(--duration-fast) var(--ease-out),
              border-color var(--duration-fast) var(--ease-out),
              box-shadow var(--duration-fast) var(--ease-out);
  position: relative;
  border-left: 4rpx solid var(--color-gold);
}
.history-card:first-child {
  margin-top: var(--spacing-md);
}
.history-card:last-child {
  margin-bottom: var(--spacing-md);
}
.history-card:active {
  transform: scale(0.97);
  border-color: rgba(201, 169, 124, 0.20);
  box-shadow: var(--shadow-pressed);
}
.history-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-xs);
}
.history-spread-type {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-semibold);
  color: var(--color-gold-dark);
  letter-spacing: 1rpx;
}
.history-date {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}
.history-question {
  display: block;
  font-size: var(--font-size-caption);
  color: var(--color-text-secondary);
  font-style: italic;
  line-height: var(--line-height-base);
  margin-bottom: var(--spacing-sm);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.history-card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: var(--spacing-xxs);
}
.history-card-footer .history-theme {
  font-size: var(--font-size-xs);
  color: var(--color-lavender-dark);
  opacity: 0.80;
}
.history-action {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-medium);
  color: var(--color-gold-dark);
  letter-spacing: 1rpx;
}

/* ============================================================
   专属塔罗师 — Persona usage section
   ============================================================ */
.persona-usage-card {
  background: linear-gradient(145deg, rgba(42,42,90,0.6) 0%, rgba(53,53,112,0.4) 100%);
  border: 1.5rpx solid rgba(201, 169, 124, 0.15);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-xl);
  box-shadow: var(--shadow-card);
  position: relative;
  overflow: hidden;
}

.persona-usage-card::before {
  content: '';
  position: absolute;
  top: -60rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 280rpx;
  height: 140rpx;
  background: radial-gradient(circle, rgba(201, 169, 124, 0.06) 0%, transparent 70%);
  pointer-events: none;
}

.persona-usage-header {
  display: flex;
  align-items: center;
  gap: var(--spacing-xs);
  margin-bottom: var(--spacing-sm);
}

.persona-usage-header-icon {
  width: 32rpx;
  height: 32rpx;
  display: block;
  opacity: 0.8;
}

.persona-usage-title {
  font-size: var(--font-size-subhead);
  font-weight: 700;
  color: var(--color-gold-dark);
  letter-spacing: 3rpx;
}

.persona-usage-sub {
  display: block;
  font-size: var(--font-size-caption);
  color: var(--color-lavender-dark);
  letter-spacing: 1rpx;
  margin-bottom: var(--spacing-md);
  line-height: 1.5;
  opacity: 0.8;
}

.persona-usage-highlight {
  color: var(--color-gold-dark);
  font-weight: 600;
}

.persona-usage-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
}

.persona-usage-item {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  padding: var(--spacing-sm) var(--spacing-md);
  background: rgba(201, 169, 124, 0.10);
  border: 1rpx solid rgba(201, 169, 124, 0.28);
  border-radius: var(--radius-md);
  transition: background var(--duration-fast) var(--ease-out);
}

.persona-usage-item:active {
  background: rgba(201, 169, 124, 0.18);
}

.persona-usage-icon {
  font-size: 36rpx;
  line-height: 1;
  flex-shrink: 0;
  width: 44rpx;
  text-align: center;
}

.persona-usage-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.persona-usage-name {
  font-size: var(--font-size-caption);
  font-weight: 600;
  color: var(--color-text-primary);
  letter-spacing: 1rpx;
}

.persona-usage-desc {
  font-size: 20rpx;
  color: var(--color-lavender-dark);
  letter-spacing: 1rpx;
  opacity: 0.7;
}

.persona-usage-count {
  font-size: var(--font-size-caption);
  color: var(--color-gold-dark);
  font-weight: 600;
  letter-spacing: 1rpx;
  flex-shrink: 0;
}

/* ============================================================
   HISTORY SECTION — Card thumbnails on the left
   ============================================================ */
.history-section {
  border-radius: var(--radius-lg);
  background: var(--color-surface-gradient);
  border: 1.5rpx solid rgba(201, 169, 124, 0.12);
  box-shadow: var(--shadow-card);
  padding-bottom: var(--spacing-xs);
}

/* History scroll view with padding for card cards */
.history-section scroll-view {
  /* overflow-y set inline via style */
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-md) var(--spacing-xl);
  border-bottom: 1rpx solid rgba(201, 169, 124, 0.08);
}

.history-header-left {
  display: flex;
  align-items: center;
  gap: var(--spacing-xs);
}

.history-header-icon {
  font-size: var(--font-size-body);
  line-height: 1;
  opacity: 0.70;
}

/* History header icon image */
.history-header-icon-img {
  width: 32rpx;
  height: 32rpx;
  display: block;
  opacity: 0.85;
}

.history-header-title {
  font-size: var(--font-size-subhead);
  font-weight: var(--font-weight-bold);
  color: var(--color-gold-dark);
  letter-spacing: 2rpx;
}

.clear-btn {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  background: none;
  border: none;
  padding: var(--spacing-xs) var(--spacing-sm);
  border-radius: var(--radius-sm);
  transition: color var(--duration-fast) var(--ease-out),
              background var(--duration-fast) var(--ease-out);
}

.clear-btn:active {
  color: var(--color-gold-dark);
  background: rgba(201, 169, 124, 0.06);
}

/* History list */
.history-list {
  padding: 0;
}

/* Individual history item */
.history-item {
  display: flex;
  align-items: center;
  padding: var(--spacing-lg) var(--spacing-xl);
  border-bottom: 1rpx solid rgba(201, 169, 124, 0.05);
  transition: background var(--duration-fast) var(--ease-out);
  gap: var(--spacing-md);
}

.history-item:last-child {
  border-bottom: none;
}

.history-item:active {
  background: var(--color-card-hover);
  transform: scale(0.97);
}

/* Card thumbnail — 96x96rpx rounded image with clear card presence */
/* E3 装裱: 我的页 — 记录缩略图统一奶油系高光与浅阴影 */
.history-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-md);
  flex-shrink: 0;
  background: var(--color-surface);
  border: 1rpx solid rgba(201, 169, 124, 0.28);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.6), 0 2rpx 8rpx rgba(61, 58, 54, 0.08);
}

.history-thumb-placeholder {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-md);
  flex-shrink: 0;
  background: var(--color-surface);
  border: 1rpx solid rgba(201, 169, 124, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
}

.thumb-placeholder-text {
  font-size: var(--font-size-body);
  opacity: 0.30;
  line-height: 1;
}

/* Info section (center) */
.history-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.history-spread-name {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-medium);
  color: var(--color-gold-dark);
  line-height: var(--line-height-tight);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.history-theme {
  font-size: var(--font-size-caption);
  color: var(--color-text-secondary);
  line-height: var(--line-height-base);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.history-meta {
  font-size: var(--font-size-xs);
  color: var(--color-lavender-dark);
  line-height: var(--line-height-base);
  opacity: 0.80;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* Right arrow */
.history-arrow {
  font-size: var(--font-size-body);
  color: var(--color-text-tertiary);
  opacity: 0.35;
  margin-left: auto;
  flex-shrink: 0;
  line-height: 1;
  font-weight: var(--font-weight-bold);
}

/* ============================================================
   Loading more — golden spinner
   ============================================================ */
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-md);
  gap: var(--spacing-sm);
}

.loading-spinner {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid rgba(201, 169, 124, 0.10);
  border-top-color: var(--color-gold-dark);
  border-radius: var(--radius-full);
  animation: profile-spin 0.7s linear infinite;
}

@keyframes profile-spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
}

/* Loaded all indicator */
.loaded-all {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-md);
  gap: var(--spacing-sm);
}

.loaded-all-line {
  display: block;
  width: 60rpx;
  height: 1rpx;
  background: rgba(201, 169, 124, 0.12);
}

.loaded-all-text {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  opacity: 0.60;
  letter-spacing: 2rpx;
}

/* ============================================================
   SKELETON — Shapes only (shimmer from common.wxss)
   ============================================================ */
.skeleton-card {
  width: 100%;
  height: 320rpx;
  border-radius: var(--radius-lg);
  margin-bottom: var(--spacing-xl);
}

.skeleton-stats {
  width: 100%;
  height: 110rpx;
  border-radius: var(--radius-lg);
  margin-bottom: var(--spacing-xl);
}

.skeleton-actions {
  display: flex;
  gap: var(--spacing-md);
  margin-bottom: var(--spacing-2xl);
}

.skeleton-action {
  flex: 1;
  height: 96rpx;
  border-radius: var(--radius-lg);
}

/* Entrance animations via common.wxss: .anim-fade-up + .anim-stagger-* */

/* ============================================================
   Benefits Card — Membership value visualization
   ============================================================ */
.benefits-card {
  background: linear-gradient(145deg, #FFFDF8 0%, #F7F0E3 100%);
  border: 1.5rpx solid rgba(201, 169, 124, 0.18);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-xl);
  box-shadow: var(--shadow-card);
  position: relative;
  overflow: hidden;
}

.benefits-card::before {
  content: '';
  position: absolute;
  top: -80rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 300rpx;
  height: 160rpx;
  background: radial-gradient(circle, rgba(201, 169, 124, 0.08) 0%, transparent 70%);
  pointer-events: none;
}

.benefits-card--locked {
  background: var(--color-surface-gradient);
  border-color: rgba(201, 169, 124, 0.10);
  opacity: 0.9;
}

.benefits-card-header {
  margin-bottom: var(--spacing-md);
  text-align: center;
}

.benefits-card-title {
  font-size: var(--font-size-subhead);
  font-weight: 700;
  color: var(--color-gold-dark);
  letter-spacing: 3rpx;
}

.benefits-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-md);
}

.benefit-item {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  padding: var(--spacing-xs) 0;
  border-bottom: 1rpx solid rgba(201, 169, 124, 0.06);
}

.benefit-item:last-child {
  border-bottom: none;
}

.benefit-icon {
  font-size: 32rpx;
  width: 48rpx;
  text-align: center;
  flex-shrink: 0;
}

.benefit-text {
  font-size: var(--font-size-caption);
  color: var(--color-text-primary);
  font-weight: 500;
  letter-spacing: 1rpx;
}

.benefit-item--locked {
  opacity: 0.6;
}

.benefit-text--locked {
  color: var(--color-text-tertiary);
  flex: 1;
}

.benefit-lock {
  font-size: 24rpx;
  opacity: 0.5;
  flex-shrink: 0;
}

.benefits-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: var(--spacing-sm);
  border-top: 1rpx solid rgba(201, 169, 124, 0.08);
}

.benefits-expiry {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  letter-spacing: 1rpx;
}

.benefits-manage {
  font-size: var(--font-size-caption);
  color: var(--color-gold-dark);
  font-weight: 500;
  letter-spacing: 2rpx;
  padding: var(--spacing-xxs) var(--spacing-sm);
}

.benefits-manage:active {
  opacity: 0.7;
}

/* ============================================================
   P1-2 重构新增 — 菜单分组标题 / 会员权益摘要 / 我的记录标题
   ============================================================ */

/* 菜单分组标题（我的内容 / 会员与服务 / 设置） */
.menu-section-title {
  padding: var(--spacing-lg) var(--spacing-xl) var(--spacing-xs);
  margin-top: var(--spacing-xs);
  border-top: 1rpx solid rgba(201, 169, 124, 0.10);
}
.menu-section-title:first-child {
  border-top: none;
  padding-top: var(--spacing-md);
}
.menu-section-label {
  font-family: var(--e3-serif, 'Songti SC', 'STSong', serif);
  font-size: 22rpx;
  font-weight: 500;
  color: var(--color-gold-dark, #A98B5F);
  letter-spacing: 4rpx;
  opacity: 0.85;
}

/* 非会员权益摘要 — 一行 + 箭头（整卡可点） */
.benefits-locked-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 44rpx;
}
.benefits-locked-title {
  font-family: var(--e3-serif, 'Songti SC', 'STSong', serif);
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-gold-dark, #A98B5F);
  letter-spacing: 2rpx;
  flex-shrink: 0;
}
.benefits-locked-hint {
  flex: 1;
  font-size: var(--font-size-xs, 22rpx);
  color: var(--color-text-tertiary, #A098C0);
  letter-spacing: 1rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.benefits-locked-arrow {
  font-size: 30rpx;
  color: var(--color-gold-dark, #A98B5F);
  flex-shrink: 0;
  transition: transform 0.15s ease;
}
.benefits-card:active .benefits-locked-arrow {
  transform: translateX(6rpx);
}

/* 我的记录 — 两个历史列表的组标题 */
.records-group-title {
  padding: var(--spacing-md) 0 var(--spacing-sm);
  border-top: 1rpx solid rgba(201, 169, 124, 0.10);
  margin-top: var(--spacing-xl);
}
.records-group-label {
  font-family: var(--e3-serif, 'Songti SC', 'STSong', serif);
  font-size: 22rpx;
  font-weight: 500;
  color: var(--color-gold-dark, #A98B5F);
  letter-spacing: 4rpx;
  opacity: 0.85;
}
