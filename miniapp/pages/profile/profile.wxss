/* ===== 个人中心 - 柔美手札主题 (Gentle Journal) ===== */
/*    像一本私人手帐封面：温暖、亲切、细腻                */

/* ---------------------------------------------------------------
   Container — 奶油底色，暖意融融
   --------------------------------------------------------------- */
.container {
  padding: var(--space-xl);
  padding-bottom: calc(env(safe-area-inset-bottom) + var(--space-massive));
  background: linear-gradient(180deg, #FFF8F5 0%, #FFF5F0 100%);
  min-height: 100vh;
}

/* ---------------------------------------------------------------
   User Card — 如手帐封面上的肖像卡片
   --------------------------------------------------------------- */
.user-card {
  text-align: center;
  padding: var(--space-xxxl) var(--space-xl) var(--space-xxl);
  border-radius: 28rpx;
  margin-bottom: var(--space-xl);
  position: relative;
  overflow: hidden;
  background: linear-gradient(155deg, #FFFFFF, #FFF8F5);
  border: 1rpx solid rgba(212, 131, 106, 0.15);
  box-shadow: 0 8rpx 32rpx rgba(212, 131, 106, 0.08);
}

/* 左上角花枝装饰 */
.user-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100rpx;
  height: 100rpx;
  background: radial-gradient(circle at 0 0, rgba(212, 131, 106, 0.08), transparent 70%);
  pointer-events: none;
}

/* 细腻纹理 — 像手工纸的触感 */
.user-card::after {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: repeating-linear-gradient(
    0deg,
    transparent,
    transparent 3rpx,
    rgba(183, 201, 177, 0.02) 3rpx,
    rgba(183, 201, 177, 0.02) 4rpx
  );
  pointer-events: none;
}

/* Avatar — 柔和光晕 */
.avatar-wrap {
  position: relative;
  display: inline-block;
  z-index: 1;
}

.avatar {
  font-size: 80rpx;
  display: block;
  position: relative;
  z-index: 1;
}

.avatar-ring {
  position: absolute;
  top: -8rpx;
  left: -8rpx;
  width: calc(100% + 16rpx);
  height: calc(100% + 16rpx);
  border-radius: var(--radius-full);
  border: 2rpx solid rgba(201, 169, 110, 0.3);
  box-shadow: 0 0 30rpx rgba(212, 131, 106, 0.1);
  animation: halo-breathe 4s var(--ease-in-out) infinite;
  pointer-events: none;
}

.user-name {
  font-size: var(--fs-h3);
  font-weight: var(--fw-semibold);
  color: #3D3535;
  display: block;
  margin-top: var(--space-lg);
  position: relative;
  z-index: 1;
  letter-spacing: 2rpx;
}

.user-level {
  font-size: var(--fs-body-small);
  color: #D4836A;
  display: block;
  margin-top: var(--space-xs);
  position: relative;
  z-index: 1;
  letter-spacing: 1rpx;
}

/* 升级按钮 — 丝绒质感 */
.upgrade-btn {
  margin-top: var(--space-lg);
  background: linear-gradient(135deg, #D4836A, #C9A96E);
  color: #FFFFFF;
  font-weight: var(--fw-semibold);
  border-radius: 40rpx;
  padding: var(--space-md) var(--space-huge);
  font-size: var(--fs-body);
  display: inline-block;
  border: none;
  box-shadow: 0 4rpx 20rpx rgba(212, 131, 106, 0.2);
  position: relative;
  z-index: 1;
  transition: all var(--duration-normal) var(--ease-out);
  letter-spacing: 2rpx;
}

.upgrade-btn:active {
  transform: scale(0.96);
  box-shadow: 0 2rpx 8rpx rgba(212, 131, 106, 0.1);
}

/* ---------------------------------------------------------------
   Stats Row — 三列数据卡片
   --------------------------------------------------------------- */
.stats-row {
  display: flex;
  border-radius: 20rpx;
  padding: var(--space-xl);
  margin-bottom: var(--space-xl);
  position: relative;
  background: linear-gradient(135deg, #FFFFFF, #FFF8F5);
  border: 1rpx solid rgba(183, 201, 177, 0.2);
  box-shadow: 0 4rpx 20rpx rgba(183, 201, 177, 0.06);
}

.stat-item {
  flex: 1;
  text-align: center;
  position: relative;
}

.stat-item + .stat-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 1rpx;
  height: 50%;
  background: linear-gradient(180deg,
    transparent, rgba(212, 131, 106, 0.2), transparent);
}

.stat-num {
  font-size: var(--fs-h3);
  font-weight: var(--fw-bold);
  color: #D4836A;
  display: block;
  line-height: var(--lh-tight);
}

.stat-label {
  font-size: var(--fs-caption);
  color: #9A8A8A;
  display: block;
  margin-top: var(--space-xs);
  letter-spacing: 1rpx;
}

/* ---------------------------------------------------------------
   Quick Actions — 快捷操作按钮
   --------------------------------------------------------------- */
.quick-actions {
  display: flex;
  gap: var(--space-md);
  margin-bottom: var(--space-xxl);
}

.action-item {
  flex: 1;
  text-align: center;
  border-radius: 20rpx;
  padding: var(--space-xl) 0;
  position: relative;
  overflow: hidden;
  background: #FFFFFF;
  border: 1rpx solid rgba(212, 131, 106, 0.1);
  box-shadow: 0 4rpx 16rpx rgba(183, 201, 177, 0.05);
  transition: all var(--duration-normal) var(--ease-out);
}

.action-item:active {
  background: #FFF5F0;
  border-color: rgba(212, 131, 106, 0.2);
  transform: scale(0.96);
}

.action-icon {
  font-size: 36rpx;
  display: block;
  margin-bottom: var(--space-sm);
  opacity: 0.7;
}

.action-label {
  font-size: var(--fs-body-small);
  color: #6B5A5A;
  display: block;
}

/* ---------------------------------------------------------------
   History — 记录卷宗
   --------------------------------------------------------------- */
.history-section {
  border-radius: 24rpx;
  overflow: hidden;
  border: 1rpx solid rgba(183, 201, 177, 0.2);
  background: #FFFFFF;
  box-shadow: 0 4rpx 20rpx rgba(183, 201, 177, 0.04);
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-lg) var(--space-xl);
  border-bottom: 1rpx solid rgba(183, 201, 177, 0.2);
}

.history-title {
  font-size: var(--fs-body);
  font-weight: var(--fw-semibold);
  color: #3D3535;
  letter-spacing: 1rpx;
}

.clear-btn {
  font-size: var(--fs-body-small);
  color: #9A8A8A;
  background: none;
  border: none;
  padding: var(--space-xs) var(--space-sm);
  border-radius: 12rpx;
  transition: all var(--duration-fast);
}

.clear-btn:active {
  color: #D4836A;
  background: rgba(212, 131, 106, 0.08);
}

/* History list */
.history-list {
  padding: 0;
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-lg) var(--space-xl);
  border-bottom: 1rpx solid rgba(183, 201, 177, 0.15);
  transition: background var(--duration-fast);
}

.history-item:last-child {
  border-bottom: none;
}

.history-item:active {
  background: rgba(212, 131, 106, 0.04);
}

.history-left {
  display: flex;
  flex-direction: column;
  gap: var(--space-xxs);
}

.history-type {
  font-size: var(--fs-body);
  color: #3D3535;
  display: block;
}

.history-time {
  font-size: var(--fs-caption);
  color: #9A8A8A;
  display: block;
}

.history-right {
  text-align: right;
}

.history-status {
  font-size: var(--fs-caption);
  color: #C9A96E;
  display: block;
}

/* ---------------------------------------------------------------
   Load / Skeleton — 柔和骨架
   --------------------------------------------------------------- */
.skeleton {
  width: 100%;
}

.skeleton-card {
  width: 100%;
  height: 320rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #F5EDE8, #F0EBE5);
  margin-bottom: var(--space-xl);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-stats {
  width: 100%;
  height: 120rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #F5EDE8, #F0EBE5);
  margin-bottom: var(--space-xl);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-actions {
  display: flex;
  gap: var(--space-md);
  margin-bottom: var(--space-xxl);
}

.skeleton-action {
  flex: 1;
  height: 100rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #F5EDE8, #F0EBE5);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-history {
  width: 100%;
  height: 300rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #F5EDE8, #F0EBE5);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

/* ---------------------------------------------------------------
   Error — 温柔报错
   --------------------------------------------------------------- */
.error-state {
  text-align: center;
  padding: var(--space-massive) var(--space-xl);
}

.error-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: var(--space-md);
  opacity: 0.5;
}

.error-text {
  font-size: var(--fs-body);
  color: #6B5A5A;
  display: block;
  margin-bottom: var(--space-xs);
}

.error-hint {
  font-size: var(--fs-body-small);
  color: #9A8A8A;
  display: block;
  margin-bottom: var(--space-xxl);
}
