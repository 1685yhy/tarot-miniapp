/* ============================================================
   Profile Page — Editorial Minimal
   Clean, airy white space with warm brown accent
   ============================================================ */

/* ---------------------------------------------------------------
   Container
   --------------------------------------------------------------- */
.container {
  padding: var(--space-xl);
  padding-bottom: calc(env(safe-area-inset-bottom) + var(--space-massive));
  min-height: 100vh;
}

/* ---------------------------------------------------------------
   Star field — subtle ambient
   --------------------------------------------------------------- */
.star-field {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
  opacity: 0.12;
}

.star-particle {
  position: absolute;
  width: 4rpx;
  height: 4rpx;
  background: #8D6E63;
  border-radius: 50%;
  opacity: 0.25;
}

.star-particle:nth-child(1) { top: 10%; left: 20%; animation: star-drift 8s ease-in-out infinite; }
.star-particle:nth-child(2) { top: 28%; left: 72%; animation: star-drift 10s ease-in-out infinite 1s; }
.star-particle:nth-child(3) { top: 55%; left: 35%; animation: star-drift 7s ease-in-out infinite 2s; }
.star-particle:nth-child(4) { top: 72%; left: 82%; animation: star-drift 9s ease-in-out infinite 3s; }
.star-particle:nth-child(5) { top: 15%; left: 65%; animation: star-drift 11s ease-in-out infinite 0.5s; }
.star-particle:nth-child(6) { top: 85%; left: 12%; animation: star-drift 8s ease-in-out infinite 4s; }
.star-particle:nth-child(7) { top: 42%; left: 8%; animation: star-drift 12s ease-in-out infinite 1.5s; }
.star-particle:nth-child(8) { top: 92%; left: 52%; animation: star-drift 9s ease-in-out infinite 2.5s; }
.star-particle:nth-child(9) { top: 62%; left: 92%; animation: star-drift 10s ease-in-out infinite 3.5s; }
.star-particle:nth-child(10) { top: 22%; left: 48%; animation: star-drift 7s ease-in-out infinite 0.8s; }

@keyframes star-drift {
  0%, 100% { transform: translateY(0) scale(1); opacity: 0.2; }
  50% { transform: translateY(-24rpx) scale(1.4); opacity: 0.5; }
}

/* ---------------------------------------------------------------
   User Card — white bg, centered, clean avatar, md font name
   --------------------------------------------------------------- */
.user-card {
  text-align: center;
  padding: var(--space-xxxl) var(--space-xl) var(--space-xxl);
  border-radius: 24rpx;
  margin-bottom: var(--space-xl);
  background: #FFFFFF;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
  position: relative;
}

.avatar {
  font-size: 88rpx;
  display: block;
  line-height: 1;
}

.badge {
  display: inline-block;
  padding: 4rpx 22rpx;
  border-radius: 20rpx;
  font-size: var(--fs-caption);
  background: #EFEBE9;
  color: #8D6E63;
  letter-spacing: 1rpx;
}

.badge-premium {
  background: #8D6E63;
  color: #FFFFFF;
}

.upgrade-btn {
  margin-top: var(--space-lg);
  background: #8D6E63;
  color: #FFFFFF;
  font-weight: var(--fw-semibold);
  font-size: var(--fs-body);
  border: none;
  border-radius: 24rpx;
  padding: var(--space-md) var(--space-huge);
  display: inline-block;
  line-height: 1.4;
  transition: opacity var(--duration-fast);
}

.upgrade-btn:active {
  opacity: 0.75;
}

/* ---------------------------------------------------------------
   Stats Row — flex row, large numbers, warm brown accent
   --------------------------------------------------------------- */
.stats-row {
  display: flex;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: var(--space-xl);
  margin-bottom: var(--space-xl);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
}

.stat-item {
  flex: 1;
  text-align: center;
  position: relative;
}

.stat-item + .stat-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 1rpx;
  height: 36%;
  background: #EEEEEE;
}

.stat-num {
  font-size: 42rpx;
  font-weight: var(--fw-bold, 700);
  color: #8D6E63;
  display: block;
  line-height: 1.15;
}

.stat-label {
  font-size: var(--fs-caption);
  color: #AAAAAA;
  display: block;
  margin-top: var(--space-xs);
  letter-spacing: 1rpx;
}

/* ---------------------------------------------------------------
   Quick Actions — white cards, list style with arrow indicators
   --------------------------------------------------------------- */
.quick-actions {
  margin-bottom: var(--space-xxl);
  border-radius: 20rpx;
  overflow: hidden;
  background: #FFFFFF;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
}

.action-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  padding: var(--space-lg) var(--space-xl);
  transition: background var(--duration-fast);
  position: relative;
}

.action-item + .action-item {
  border-top: 1rpx solid #F2F2F2;
}

.action-item:active {
  background: #F8F6F5;
}

/* Arrow indicator */
.action-item::after {
  content: '›';
  font-size: 36rpx;
  color: #CCCCCC;
  line-height: 1;
  margin-left: auto;
  flex-shrink: 0;
}

.action-icon {
  font-size: 40rpx !important;
  display: inline !important;
  margin-right: var(--space-md);
  flex-shrink: 0;
}

/* ---------------------------------------------------------------
   History Section — clean list
   --------------------------------------------------------------- */
.history-section {
  border-radius: 20rpx;
  overflow: hidden;
  background: #FFFFFF;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-lg) var(--space-xl);
  border-bottom: 1rpx solid #F2F2F2;
}

.clear-btn {
  font-size: var(--fs-body-small);
  color: #AAAAAA;
  background: none;
  border: none;
  padding: var(--space-xs) var(--space-sm);
  border-radius: 12rpx;
  transition: all var(--duration-fast);
}

.clear-btn:active {
  color: #8D6E63;
  background: rgba(141, 110, 99, 0.06);
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-lg) var(--space-xl);
  border-bottom: 1rpx solid #F2F2F2;
  transition: background var(--duration-fast);
}

.history-item:last-child {
  border-bottom: none;
}

.history-item:active {
  background: #F8F6F5;
}

/* ---------------------------------------------------------------
   Loading / Skeleton
   --------------------------------------------------------------- */
.skeleton-card {
  width: 100%;
  height: 320rpx;
  border-radius: 24rpx;
  background: #F2F2F2;
  margin-bottom: var(--space-xl);
  animation: skeleton-pulse 1.4s ease-in-out infinite;
}

.skeleton-stats {
  width: 100%;
  height: 110rpx;
  border-radius: 20rpx;
  background: #F2F2F2;
  margin-bottom: var(--space-xl);
  animation: skeleton-pulse 1.4s ease-in-out infinite;
}

.skeleton-actions {
  display: flex;
  gap: var(--space-md);
  margin-bottom: var(--space-xxl);
}

.skeleton-action {
  flex: 1;
  height: 96rpx;
  border-radius: 20rpx;
  background: #F2F2F2;
  animation: skeleton-pulse 1.4s ease-in-out infinite;
}

@keyframes skeleton-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

/* ---------------------------------------------------------------
   Error State
   --------------------------------------------------------------- */
.error-state {
  text-align: center;
  padding: var(--space-massive) var(--space-xl);
}

.error-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: var(--space-md);
}

.error-text {
  font-size: var(--fs-body);
  color: #666666;
  display: block;
  margin-bottom: var(--space-xs);
}

.error-hint {
  font-size: var(--fs-body-small);
  color: #AAAAAA;
  display: block;
  margin-bottom: var(--space-xxl);
}
