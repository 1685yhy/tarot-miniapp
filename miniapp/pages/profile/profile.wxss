/* ============================================================
   Profile Page — 柔光星辰
   Dark indigo backdrop · Golden starlight accents · Premium user card
   ============================================================ */

/* ---- Old variable aliases (WXML inline style compat) ---- */
page {
  --space-massive: var(--spacing-5xl);
  --space-xxxl: var(--spacing-3xl);
  --space-xxl: var(--spacing-2xl);
  --space-xl: var(--spacing-xl);
  --space-lg: var(--spacing-lg);
  --space-md: var(--spacing-md);
  --space-sm: var(--spacing-sm);
  --space-xs: var(--spacing-xs);
  --fs-h3: var(--font-size-xl);
  --fs-h4: var(--font-size-lg);
  --fs-body: var(--font-size-base);
  --fs-body-small: var(--font-size-sm);
  --fs-caption: var(--font-size-xs);
  --lh-loose: var(--line-height-loose);
  --lh-normal: var(--line-height-base);
  --fw-semibold: var(--font-weight-semibold);
  --fw-bold: var(--font-weight-bold);
  --fw-medium: var(--font-weight-medium);
  --duration-normal: var(--duration-base);
  --duration-fast: var(--duration-fast);
  --ease-out: var(--ease-out);
  --ease-in-out: var(--ease-in-out);
  --color-star-subtle: rgba(244, 212, 140, 0.12);
  --color-text-secondary: var(--color-text-secondary);
  --color-text-primary: var(--color-text-primary);
}

/* ---- Container ---- */
.container {
  padding: var(--spacing-xl);
  padding-bottom: calc(var(--safe-area-bottom) + var(--spacing-5xl));
  min-height: 100vh;
  position: relative;
  z-index: 1;
}

/* ---------------------------------------------------------------
   Star field — golden starlight particles
   --------------------------------------------------------------- */
.star-field {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
  opacity: 0.20;
}

.star-particle {
  position: absolute;
  width: 4rpx;
  height: 4rpx;
  background: var(--color-gold);
  border-radius: 50%;
  opacity: 0.25;
  box-shadow: 0 0 6rpx var(--color-gold-glow);
}

.star-particle:nth-child(1) { top: 10%; left: 20%; animation: star-drift 8s ease-in-out infinite; }
.star-particle:nth-child(2) { top: 28%; left: 72%; animation: star-drift 10s ease-in-out infinite 1s; }
.star-particle:nth-child(3) { top: 55%; left: 35%; animation: star-drift 7s ease-in-out infinite 2s; }
.star-particle:nth-child(4) { top: 72%; left: 82%; animation: star-drift 9s ease-in-out infinite 3s; }
.star-particle:nth-child(5) { top: 15%; left: 65%; animation: star-drift 11s ease-in-out infinite 0.5s; }
.star-particle:nth-child(6) { top: 85%; left: 12%; animation: star-drift 8s ease-in-out infinite 4s; }
.star-particle:nth-child(7) { top: 42%; left: 8%; animation: star-drift 12s ease-in-out infinite 1.5s; }
.star-particle:nth-child(8) { top: 92%; left: 52%; animation: star-drift 9s ease-in-out infinite 2.5s; }
.star-particle:nth-child(9) { top: 62%; left: 92%; animation: star-drift 10s ease-in-out infinite 3.5s; }
.star-particle:nth-child(10) { top: 22%; left: 48%; animation: star-drift 7s ease-in-out infinite 0.8s; }

@keyframes star-drift {
  0%, 100% { transform: translateY(0) scale(1); opacity: 0.15; box-shadow: 0 0 4rpx rgba(244, 212, 140, 0.10); }
  50% { transform: translateY(-24rpx) scale(1.5); opacity: 0.55; box-shadow: 0 0 12rpx rgba(244, 212, 140, 0.25); }
}

/* ---------------------------------------------------------------
   text-dim / text-body — class aliases for old WXML
   --------------------------------------------------------------- */
.text-dim {
  color: var(--color-text-secondary);
  font-size: var(--font-size-sm);
}

.text-body {
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  line-height: var(--line-height-base);
}

/* ---------------------------------------------------------------
   Error State
   --------------------------------------------------------------- */
.error-state {
  text-align: center;
  padding: var(--spacing-5xl) var(--spacing-xl);
}

.error-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: var(--spacing-md);
  opacity: 0.50;
}

.error-text {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--spacing-xs);
}

.error-hint {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
  display: block;
  margin-bottom: var(--spacing-2xl);
}

/* ---- btn-small override for error state ---- */
.btn-small {
  font-size: var(--font-size-sm);
  padding: 16rpx 36rpx;
}

/* ---------------------------------------------------------------
   Empty State
   --------------------------------------------------------------- */
.empty-state {
  text-align: center;
  padding: var(--spacing-5xl) 0;
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: var(--spacing-md);
  opacity: 0.40;
}

.empty-text {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--spacing-xs);
}

.empty-hint {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
  display: block;
}

/* ---------------------------------------------------------------
   User Card — Dark indigo surface with golden glow
   --------------------------------------------------------------- */
.user-card {
  text-align: center;
  padding: var(--spacing-3xl) var(--spacing-xl) var(--spacing-2xl);
  border-radius: var(--radius-lg);
  margin-bottom: var(--spacing-xl);
  background: var(--color-card);
  border: 1rpx solid var(--color-card-border);
  box-shadow: var(--shadow-card);
  position: relative;
  overflow: hidden;
}

/* Soft golden top glow */
.user-card::before {
  content: '';
  position: absolute;
  top: -120rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 400rpx;
  height: 240rpx;
  background: radial-gradient(circle, rgba(244, 212, 140, 0.10) 0%, transparent 70%);
  pointer-events: none;
}

/* Avatar override (emoji-based, not image) */
.user-card .avatar {
  font-size: 88rpx;
  display: block;
  line-height: 1;
  width: auto;
  height: auto;
  border: none;
  background: none;
  border-radius: 0;
  margin-bottom: var(--spacing-sm);
}

/* Badge */
.badge {
  display: inline-block;
  padding: 4rpx 22rpx;
  border-radius: var(--radius-pill);
  font-size: var(--font-size-xs);
  background: var(--color-surface);
  color: var(--color-text-secondary);
  border: 1rpx solid rgba(244, 212, 140, 0.15);
  letter-spacing: 1rpx;
}

.badge-premium {
  background: rgba(244, 212, 140, 0.12);
  color: var(--color-gold);
  border-color: rgba(244, 212, 140, 0.25);
}

/* Upgrade button — golden gradient */
.upgrade-btn {
  margin-top: var(--spacing-lg);
  background: linear-gradient(135deg, #F4D48C 0%, #E8C67A 50%, #D4B06A 100%);
  color: var(--color-text-inverse);
  font-weight: var(--font-weight-semibold);
  font-size: var(--font-size-base);
  border: none;
  border-radius: var(--radius-pill);
  padding: var(--spacing-md) var(--spacing-huge);
  display: inline-block;
  line-height: 1.4;
  box-shadow: var(--shadow-gold-button);
  transition: all var(--duration-fast) var(--ease-soft);
}

.upgrade-btn:active {
  transform: scale(0.96);
  opacity: 0.85;
  box-shadow: 0 2rpx 12rpx rgba(244, 212, 140, 0.20);
}

/* ---------------------------------------------------------------
   Stats Row — Glass dark cards with golden numbers
   --------------------------------------------------------------- */
.stats-row {
  display: flex;
  background: var(--color-card);
  border: 1rpx solid var(--color-card-border);
  border-radius: var(--radius-lg);
  padding: var(--spacing-xl);
  margin-bottom: var(--spacing-xl);
  box-shadow: var(--shadow-card);
}

.stat-item {
  flex: 1;
  text-align: center;
  position: relative;
}

.stat-item + .stat-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 1rpx;
  height: 40%;
  background: linear-gradient(
    180deg,
    transparent 0%,
    rgba(244, 212, 140, 0.20) 50%,
    transparent 100%
  );
}

.stat-num {
  font-size: var(--font-size-3xl);
  font-weight: var(--font-weight-bold);
  color: var(--color-gold);
  display: block;
  line-height: 1.15;
  text-shadow: 0 0 16rpx rgba(244, 212, 140, 0.15);
}

.stat-label {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  display: block;
  margin-top: var(--spacing-xs);
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

/* ---------------------------------------------------------------
   Quick Actions — Dark cards with golden borders
   --------------------------------------------------------------- */
.quick-actions {
  margin-bottom: var(--spacing-2xl);
  border-radius: var(--radius-lg);
  overflow: hidden;
  background: var(--color-card);
  border: 1rpx solid var(--color-card-border);
  box-shadow: var(--shadow-card);
}

.action-item {
  display: flex;
  align-items: center;
  background: transparent;
  padding: var(--spacing-lg) var(--spacing-xl);
  transition: all var(--duration-fast) var(--ease-soft);
  position: relative;
}

.action-item + .action-item {
  border-top: 1rpx solid rgba(244, 212, 140, 0.08);
}

.action-item:active {
  background: var(--color-card-hover);
}

/* Arrow indicator — golden */
.action-item::after {
  content: '›';
  font-size: 36rpx;
  color: var(--color-gold);
  opacity: 0.40;
  line-height: 1;
  margin-left: auto;
  flex-shrink: 0;
}

.action-icon {
  font-size: 40rpx;
  margin-right: var(--spacing-md);
  flex-shrink: 0;
  opacity: 0.80;
}

/* ---------------------------------------------------------------
   History Section — Dark card list
   --------------------------------------------------------------- */
.history-section {
  border-radius: var(--radius-lg);
  overflow: hidden;
  background: var(--color-card);
  border: 1rpx solid var(--color-card-border);
  box-shadow: var(--shadow-card);
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-lg) var(--spacing-xl);
  border-bottom: 1rpx solid rgba(244, 212, 140, 0.08);
}

.clear-btn {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
  background: none;
  border: none;
  padding: var(--spacing-xs) var(--spacing-sm);
  border-radius: var(--radius-sm);
  transition: all var(--duration-fast);
}

.clear-btn:active {
  color: var(--color-gold);
  background: rgba(244, 212, 140, 0.06);
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-lg) var(--spacing-xl);
  border-bottom: 1rpx solid rgba(244, 212, 140, 0.06);
  transition: background var(--duration-fast);
}

.history-item:last-child {
  border-bottom: none;
}

.history-item:active {
  background: var(--color-card-hover);
}

/* ---------------------------------------------------------------
   Skeleton — Dark indigo shimmer
   --------------------------------------------------------------- */
.skeleton-card {
  width: 100%;
  height: 320rpx;
  border-radius: var(--radius-lg);
  background: var(--color-surface);
  margin-bottom: var(--spacing-xl);
  animation: skeleton-pulse 1.4s ease-in-out infinite;
}

.skeleton-stats {
  width: 100%;
  height: 110rpx;
  border-radius: var(--radius-lg);
  background: var(--color-surface);
  margin-bottom: var(--spacing-xl);
  animation: skeleton-pulse 1.4s ease-in-out infinite;
}

.skeleton-actions {
  display: flex;
  gap: var(--spacing-md);
  margin-bottom: var(--spacing-2xl);
}

.skeleton-action {
  flex: 1;
  height: 96rpx;
  border-radius: var(--radius-lg);
  background: var(--color-surface);
  animation: skeleton-pulse 1.4s ease-in-out infinite;
}

@keyframes skeleton-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.45; }
}

/* ---------------------------------------------------------------
   Staggered entrance animations (WXML compat)
   --------------------------------------------------------------- */
.anim-fade-in-up-1 { opacity: 0; animation: fade-up 0.5s var(--ease-soft) 0.08s forwards; }
.anim-fade-in-up-2 { opacity: 0; animation: fade-up 0.5s var(--ease-soft) 0.20s forwards; }
.anim-fade-in-up-3 { opacity: 0; animation: fade-up 0.5s var(--ease-soft) 0.32s forwards; }
.anim-fade-in-up-4 { opacity: 0; animation: fade-up 0.5s var(--ease-soft) 0.44s forwards; }
.anim-fade-in-up-5 { opacity: 0; animation: fade-up 0.5s var(--ease-soft) 0.56s forwards; }
