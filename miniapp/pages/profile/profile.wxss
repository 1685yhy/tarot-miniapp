.container{padding:24rpx;background:var(--color-bg);min-height:100vh}
.user-card{text-align:center;padding:40rpx 0;background:var(--color-bg-card);border-radius:24rpx;margin-bottom:24rpx;border:1rpx solid rgba(201,169,110,0.1)}.avatar{font-size:72rpx}.nickname{font-size:32rpx;font-weight:600;color:var(--color-text-primary);display:block;margin-top:12rpx}.member-badge{display:inline-block;margin-top:14rpx;padding:8rpx 24rpx;border-radius:20rpx;font-size:24rpx;background:rgba(136,136,170,0.15);color:var(--color-text-secondary)}.member-badge.is-member{background:rgba(201,169,110,0.15);color:var(--color-gold)}.member-expiry{display:block;font-size:20rpx;margin-top:4rpx;opacity:.7}.upgrade-btn{margin-top:20rpx;background:linear-gradient(135deg,var(--color-gold),var(--color-gold-light));color:#1a1a2e;font-weight:600;border-radius:32rpx;padding:16rpx 48rpx;font-size:28rpx;display:inline-block;border:none}
.stats-row{display:flex;background:var(--color-bg-card);border-radius:20rpx;padding:28rpx;margin-bottom:24rpx;border:1rpx solid rgba(201,169,110,0.08)}.stat-item{flex:1;text-align:center}.stat-num{font-size:36rpx;font-weight:700;color:var(--color-gold);display:block}.stat-label{font-size:22rpx;color:var(--color-text-dim);display:block;margin-top:6rpx}
.quick-actions{display:flex;gap:16rpx;margin-bottom:32rpx}.action-item{flex:1;text-align:center;background:var(--color-bg-card);border-radius:20rpx;padding:28rpx 0;border:1rpx solid rgba(201,169,110,0.08)}.action-icon{font-size:40rpx;display:block}.action-label{font-size:24rpx;color:var(--color-text-secondary);display:block;margin-top:8rpx}
.history-section{background:var(--color-bg-card);border-radius:20rpx;padding:24rpx 0;border:1rpx solid rgba(201,169,110,0.08)}.history-header{display:flex;justify-content:space-between;align-items:center;padding:0 24rpx 16rpx;border-bottom:1rpx solid rgba(201,169,110,0.06)}.section-title{font-size:28rpx;font-weight:600;color:var(--color-text-primary)}.clear-btn{font-size:24rpx;color:var(--color-text-dim)}.history-item{display:flex;justify-content:space-between;align-items:center;padding:20rpx 24rpx;border-bottom:1rpx solid rgba(201,169,110,0.04)}.history-item:last-child{border-bottom:none}.history-spread{font-size:28rpx;color:var(--color-text-primary);display:block}.history-theme{font-size:22rpx;color:var(--color-text-dim);display:block;margin-top:4rpx}.history-arrow{font-size:36rpx;color:var(--color-text-dim)}
.empty{text-align:center;padding:60rpx 0}.empty-text{font-size:26rpx;color:var(--color-text-dim)}.loading{text-align:center;padding:200rpx 0;color:var(--color-text-secondary)}
