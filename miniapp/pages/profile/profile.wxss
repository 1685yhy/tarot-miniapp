/* ===== 个人中心 - 新艺术主义手札 (Art Nouveau Journal) ===== */
/*    暖意私册 · 植物纹章 · 铜质书角                        */

/* ---------------------------------------------------------------
   Container — 暖棕色基调，如陈年皮革封面
   --------------------------------------------------------------- */
.container {
  padding: var(--space-xl);
  padding-bottom: calc(env(safe-area-inset-bottom) + var(--space-massive));
  background: linear-gradient(180deg, #F5F0E8 0%, #EFE9E0 100%);
  min-height: 100vh;
  position: relative;
}

/* 纸纹底纹 */
.container::before {
  content: '';
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background-image:
    repeating-linear-gradient(
      0deg,
      transparent,
      transparent 3rpx,
      rgba(139, 94, 60, 0.01) 3rpx,
      rgba(139, 94, 60, 0.01) 5rpx
    );
  pointer-events: none;
  z-index: 0;
}

/* ---------------------------------------------------------------
   User Card — 如手札扉页上的铜版肖像
   --------------------------------------------------------------- */
.user-card {
  text-align: center;
  padding: var(--space-xxxl) var(--space-xl) var(--space-xxl);
  margin-bottom: var(--space-xl);
  position: relative;
  overflow: visible;
  background: #FAF5ED;
  border: 2rpx solid #C97D4A;
  box-shadow:
    0 0 0 4rpx #FAF5ED,
    0 0 0 6rpx rgba(185, 115, 51, 0.15),
    0 8rpx 32rpx rgba(139, 94, 60, 0.08);
}

/* 四角植物框饰 */
.user-card::before {
  content: '';
  position: absolute;
  top: -6rpx; left: -6rpx; right: -6rpx; bottom: -6rpx;
  border: 2rpx solid rgba(122, 139, 111, 0.12);
  pointer-events: none;
}

/* 右上角蔓叶装饰 */
.user-card::after {
  content: '❧';
  position: absolute;
  top: var(--space-md);
  right: var(--space-md);
  font-size: 32rpx;
  color: #7A8B6F;
  opacity: 0.15;
  pointer-events: none;
  transform: rotate(15deg);
}

/* 铜质书角 — 左上 */
.user-card-corner-tl {
  position: absolute;
  top: -4rpx;
  left: -4rpx;
  width: 48rpx;
  height: 48rpx;
  border-top: 3rpx solid #B87333;
  border-left: 3rpx solid #B87333;
  opacity: 0.5;
  pointer-events: none;
}

.user-card-corner-br {
  position: absolute;
  bottom: -4rpx;
  right: -4rpx;
  width: 48rpx;
  height: 48rpx;
  border-bottom: 3rpx solid #B87333;
  border-right: 3rpx solid #B87333;
  opacity: 0.5;
  pointer-events: none;
}

/* Avatar — 植物纹样光环 */
.avatar-wrap {
  position: relative;
  display: inline-block;
  z-index: 1;
}

.avatar {
  font-size: 80rpx;
  display: block;
  position: relative;
  z-index: 1;
}

.avatar-ring {
  position: absolute;
  top: -10rpx;
  left: -10rpx;
  width: calc(100% + 20rpx);
  height: calc(100% + 20rpx);
  border-radius: var(--radius-full);
  border: 2rpx solid rgba(122, 139, 111, 0.3);
  box-shadow: 0 0 30rpx rgba(185, 115, 51, 0.12);
  animation: halo-breathe 4s var(--ease-in-out) infinite;
  pointer-events: none;
}

/* 藤蔓叶环 — 绕头像一圈 */
.avatar-vine {
  position: absolute;
  top: -18rpx;
  left: -18rpx;
  width: calc(100% + 36rpx);
  height: calc(100% + 36rpx);
  border-radius: var(--radius-full);
  border: 2rpx dashed rgba(122, 139, 111, 0.15);
  pointer-events: none;
}

.avatar-vine::before,
.avatar-vine::after {
  content: '❀';
  position: absolute;
  font-size: 18rpx;
  color: #7A8B6F;
  opacity: 0.35;
}
.avatar-vine::before { top: -10rpx; left: 50%; transform: translateX(-50%); }
.avatar-vine::after { bottom: -10rpx; left: 50%; transform: translateX(-50%); }

.user-name {
  font-size: var(--fs-h3);
  font-weight: var(--fw-semibold);
  color: #2C1810;
  display: block;
  margin-top: var(--space-lg);
  position: relative;
  z-index: 1;
  letter-spacing: 4rpx;
  font-family: var(--font-family-display, serif);
}

.user-level {
  font-size: var(--fs-body-small);
  color: #8B5E3C;
  display: block;
  margin-top: var(--space-xs);
  position: relative;
  z-index: 1;
  letter-spacing: 2rpx;
  font-style: italic;
}

/* 升级按钮 — 铜质徽章 */
.upgrade-btn {
  margin-top: var(--space-lg);
  background: linear-gradient(135deg, #8B5E3C, #B87333);
  color: #F5F0E8;
  font-weight: var(--fw-semibold);
  padding: var(--space-md) var(--space-huge);
  font-size: var(--fs-body);
  display: inline-block;
  border: 2rpx solid #C97D4A;
  box-shadow:
    0 4rpx 20rpx rgba(139, 94, 60, 0.25),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.1);
  position: relative;
  z-index: 1;
  transition: all var(--duration-normal) var(--ease-out);
  letter-spacing: 3rpx;
}

.upgrade-btn:active {
  transform: scale(0.96);
  box-shadow: 0 2rpx 8rpx rgba(139, 94, 60, 0.1);
}

/* ---------------------------------------------------------------
   Stats Row — 植物纹章数据卡片
   --------------------------------------------------------------- */
.stats-row {
  display: flex;
  padding: var(--space-xl);
  margin-bottom: var(--space-xl);
  position: relative;
  background: #FAF5ED;
  border: 2rpx solid rgba(122, 139, 111, 0.2);
  box-shadow:
    0 0 0 4rpx #FAF5ED,
    0 0 0 6rpx rgba(122, 139, 111, 0.08),
    0 4rpx 20rpx rgba(139, 94, 60, 0.05);
}

/* 顶部蔓线 */
.stats-row::before {
  content: '';
  position: absolute;
  top: -4rpx; left: 10%; right: 10%;
  height: 2rpx;
  background: linear-gradient(90deg,
    transparent,
    rgba(122, 139, 111, 0.3),
    transparent
  );
  pointer-events: none;
}

/* 底部蔓线 */
.stats-row::after {
  content: '';
  position: absolute;
  bottom: -4rpx; left: 10%; right: 10%;
  height: 2rpx;
  background: linear-gradient(90deg,
    transparent,
    rgba(122, 139, 111, 0.3),
    transparent
  );
  pointer-events: none;
}

.stat-item {
  flex: 1;
  text-align: center;
  position: relative;
  padding: var(--space-sm) 0;
}

/* 竖分隔线 — 植物茎蔓 */
.stat-item + .stat-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 2rpx;
  height: 60%;
  background: linear-gradient(180deg,
    transparent,
    rgba(122, 139, 111, 0.2) 30%,
    rgba(122, 139, 111, 0.2) 70%,
    transparent
  );
}

.stat-num {
  font-size: var(--fs-h3);
  font-weight: var(--fw-bold);
  color: #8B5E3C;
  display: block;
  line-height: var(--lh-tight);
  font-family: var(--font-family-display, serif);
}

.stat-label {
  font-size: var(--fs-caption);
  color: #8C7A6B;
  display: block;
  margin-top: var(--space-xs);
  letter-spacing: 2rpx;
  position: relative;
  padding-top: var(--space-xs);
}

/* 标签上方小草叶 */
.stat-label::before {
  content: '';
  display: block;
  width: 20rpx;
  height: 1rpx;
  background: #7A8B6F;
  margin: 0 auto var(--space-xs);
  opacity: 0.3;
}

/* ---------------------------------------------------------------
   Quick Actions — 植物纹样快捷入口
   --------------------------------------------------------------- */
.quick-actions {
  display: flex;
  gap: var(--space-md);
  margin-bottom: var(--space-xxl);
}

.action-item {
  flex: 1;
  text-align: center;
  padding: var(--space-xl) 0;
  position: relative;
  overflow: visible;
  background: #FAF5ED;
  border: 2rpx solid rgba(185, 115, 51, 0.12);
  box-shadow:
    0 0 0 4rpx #FAF5ED,
    0 0 0 6rpx rgba(185, 115, 51, 0.06),
    0 4rpx 16rpx rgba(139, 94, 60, 0.04);
  transition: all var(--duration-normal) var(--ease-out);
}

.action-item:active {
  background: #F0EBE2;
  border-color: rgba(185, 115, 51, 0.25);
  transform: scale(0.96);
}

/* 左上角装饰叶 */
.action-item::before {
  content: '❧';
  position: absolute;
  top: var(--space-xs);
  left: var(--space-xs);
  font-size: 16rpx;
  color: #7A8B6F;
  opacity: 0.2;
  transform: rotate(-30deg);
}

.action-icon {
  font-size: 36rpx;
  display: block;
  margin-bottom: var(--space-sm);
  color: #7A8B6F;
  opacity: 0.75;
}

.action-label {
  font-size: var(--fs-body-small);
  color: #3D2920;
  display: block;
  letter-spacing: 2rpx;
}

/* ---------------------------------------------------------------
   History — 藤蔓纹卷宗
   --------------------------------------------------------------- */
.history-section {
  position: relative;
  border: 2rpx solid rgba(122, 139, 111, 0.15);
  background: #FAF5ED;
  box-shadow:
    0 0 0 4rpx #FAF5ED,
    0 0 0 6rpx rgba(122, 139, 111, 0.06),
    0 4rpx 20rpx rgba(139, 94, 60, 0.03);
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-lg) var(--space-xl);
  border-bottom: 2rpx solid rgba(122, 139, 111, 0.1);
  position: relative;
}

/* 标题下方装饰 */
.history-header::after {
  content: '';
  position: absolute;
  bottom: -4rpx;
  left: 15%;
  right: 15%;
  height: 1rpx;
  background: linear-gradient(90deg,
    transparent,
    rgba(185, 115, 51, 0.2),
    transparent
  );
}

.history-title {
  font-size: var(--fs-body);
  font-weight: var(--fw-semibold);
  color: #2C1810;
  letter-spacing: 3rpx;
}

.clear-btn {
  font-size: var(--fs-body-small);
  color: #8C7A6B;
  background: none;
  border: 1rpx solid transparent;
  padding: var(--space-xs) var(--space-sm);
  transition: all var(--duration-fast);
  letter-spacing: 1rpx;
}

.clear-btn:active {
  color: #8B5E3C;
  border-color: rgba(139, 94, 60, 0.15);
}

/* History list */
.history-list {
  padding: 0;
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-lg) var(--space-xl);
  border-bottom: 1rpx solid rgba(122, 139, 111, 0.08);
  transition: background var(--duration-fast);
  position: relative;
}

.history-item:last-child {
  border-bottom: none;
}

.history-item:active {
  background: rgba(122, 139, 111, 0.04);
}

.history-left {
  display: flex;
  flex-direction: column;
  gap: var(--space-xxs);
}

.history-type {
  font-size: var(--fs-body);
  color: #2C1810;
  display: block;
  letter-spacing: 1rpx;
}

.history-time {
  font-size: var(--fs-caption);
  color: #8C7A6B;
  display: block;
  font-style: italic;
}

.history-right {
  text-align: right;
}

.history-status {
  font-size: var(--fs-caption);
  color: #7A8B6F;
  display: block;
  position: relative;
  padding-right: var(--space-lg);
}

/* 状态旁小叶片 */
.history-status::after {
  content: '❧';
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  font-size: 14rpx;
  opacity: 0.4;
}

/* ---------------------------------------------------------------
   Load / Skeleton — 暖色骨架
   --------------------------------------------------------------- */
.skeleton {
  width: 100%;
}

.skeleton-card {
  width: 100%;
  height: 320rpx;
  background: linear-gradient(135deg, #E8E2D8, #E0DAD0);
  margin-bottom: var(--space-xl);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-stats {
  width: 100%;
  height: 120rpx;
  background: linear-gradient(135deg, #E8E2D8, #E0DAD0);
  margin-bottom: var(--space-xl);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-actions {
  display: flex;
  gap: var(--space-md);
  margin-bottom: var(--space-xxl);
}

.skeleton-action {
  flex: 1;
  height: 100rpx;
  background: linear-gradient(135deg, #E8E2D8, #E0DAD0);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-history {
  width: 100%;
  height: 300rpx;
  background: linear-gradient(135deg, #E8E2D8, #E0DAD0);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

/* ---------------------------------------------------------------
   Error — 暖色报错
   --------------------------------------------------------------- */
.error-state {
  text-align: center;
  padding: var(--space-massive) var(--space-xl);
}

.error-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: var(--space-md);
  color: #8C7A6B;
  opacity: 0.5;
}

.error-text {
  font-size: var(--fs-body);
  color: #3D2920;
  display: block;
  margin-bottom: var(--space-xs);
}

.error-hint {
  font-size: var(--fs-body-small);
  color: #8C7A6B;
  display: block;
  margin-bottom: var(--space-xxl);
  font-style: italic;
}
