/* ===== 个人中心 - 薄暮圣殿主题 (Twilight Sanctuary) ===== */
/*    神谕者肖像：光环照耀，星盘数据，历史卷宗          */

/* ---------------------------------------------------------------
   Container
   --------------------------------------------------------------- */
.container {
  padding: var(--space-xl);
  padding-bottom: calc(env(safe-area-inset-bottom) + var(--space-massive));
  background: var(--color-bg);
  min-height: 100vh;
  background-image:
    var(--gradient-candle-ambient),
    var(--gradient-bg-radial),
    var(--gradient-bg-radial-gold);
}

/* ---------------------------------------------------------------
   User Card — 神谕者肖像 (光环 + 天鹅绒质感)
   --------------------------------------------------------------- */
.user-card {
  text-align: center;
  padding: var(--space-xxxl) var(--space-xl) var(--space-xxl);
  border-radius: var(--radius-card);
  margin-bottom: var(--space-xl);
  border: 1rpx solid var(--color-border-subtle);
  position: relative;
  overflow: hidden;
  background: linear-gradient(155deg,
    var(--color-bg-card-warm), var(--color-bg-mid));
  box-shadow: var(--shadow-card-warm);
}

/* 环境光环 — 暖色光晕从上方洒落 */
.user-card::before {
  content: '';
  position: absolute;
  top: -40%;
  left: -30%;
  width: 160%;
  height: 160%;
  background:
    radial-gradient(circle at 50% 10%,
      rgba(221, 184, 71, 0.06) 0%,
      rgba(212, 137, 58, 0.03) 30%,
      transparent 60%),
    radial-gradient(circle at 30% 80%,
      var(--color-mystic-glow) 0%,
      transparent 50%);
  pointer-events: none;
}

/* 天鹅绒纹理 */
.user-card::after {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: repeating-linear-gradient(
    0deg,
    transparent,
    transparent 3rpx,
    rgba(255, 255, 255, 0.002) 3rpx,
    rgba(255, 255, 255, 0.002) 4rpx
  );
  pointer-events: none;
}

/* Avatar — 金色光环 */
.avatar-wrap {
  position: relative;
  display: inline-block;
  z-index: 1;
}

.avatar {
  font-size: 80rpx;
  display: block;
  position: relative;
  z-index: 1;
}

.avatar-ring {
  position: absolute;
  top: -8rpx;
  left: -8rpx;
  width: calc(100% + 16rpx);
  height: calc(100% + 16rpx);
  border-radius: var(--radius-full);
  border: 2rpx solid var(--color-gold-subtle);
  box-shadow: 0 0 30rpx var(--color-gold-glow);
  animation: halo-breathe 4s var(--ease-in-out) infinite;
  pointer-events: none;
}

.user-name {
  font-size: var(--fs-h3);
  font-weight: var(--fw-semibold);
  color: var(--color-text-primary);
  display: block;
  margin-top: var(--space-lg);
  position: relative;
  z-index: 1;
  letter-spacing: var(--ls-heading);
}

.user-level {
  font-size: var(--fs-body-small);
  color: var(--color-gold);
  display: block;
  margin-top: var(--space-xs);
  position: relative;
  z-index: 1;
  letter-spacing: 2rpx;
}

/* 升级按钮 */
.upgrade-btn {
  margin-top: var(--space-lg);
  background: var(--gradient-gold);
  color: var(--color-text-on-gold);
  font-weight: var(--fw-semibold);
  border-radius: var(--radius-round);
  padding: var(--space-md) var(--space-huge);
  font-size: var(--fs-body);
  display: inline-block;
  border: none;
  box-shadow: var(--shadow-button);
  position: relative;
  z-index: 1;
  transition: all var(--duration-normal) var(--ease-out);
}

.upgrade-btn:active {
  transform: scale(0.96);
  box-shadow: 0 2rpx 8rpx var(--color-gold-glow);
}

/* ---------------------------------------------------------------
   Stats Row — 星盘数据 (三列神圣数值)
   --------------------------------------------------------------- */
.stats-row {
  display: flex;
  border-radius: var(--radius-lg);
  padding: var(--space-xl);
  margin-bottom: var(--space-xl);
  position: relative;
  background: linear-gradient(135deg,
    var(--color-bg-card-warm), var(--color-bg-mid));
  border: 1rpx solid var(--color-border-subtle);
  box-shadow: var(--shadow-card);
}

.stat-item {
  flex: 1;
  text-align: center;
  position: relative;
}

.stat-item + .stat-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 1rpx;
  height: 50%;
  background: linear-gradient(180deg,
    transparent, var(--color-gold-subtle), transparent);
}

.stat-num {
  font-size: var(--fs-h3);
  font-weight: var(--fw-bold);
  color: var(--color-gold);
  display: block;
  text-shadow: 0 0 20rpx var(--color-gold-glow);
  line-height: var(--lh-tight);
}

.stat-label {
  font-size: var(--fs-caption);
  color: var(--color-text-dim);
  display: block;
  margin-top: var(--space-xs);
  letter-spacing: 1rpx;
}

/* ---------------------------------------------------------------
   Quick Actions — 快捷仪式操作
   --------------------------------------------------------------- */
.quick-actions {
  display: flex;
  gap: var(--space-md);
  margin-bottom: var(--space-xxl);
}

.action-item {
  flex: 1;
  text-align: center;
  border-radius: var(--radius-lg);
  padding: var(--space-xl) 0;
  position: relative;
  overflow: hidden;
  background: var(--color-bg-card-warm);
  border: 1rpx solid var(--color-border-subtle);
  box-shadow: var(--shadow-card);
  transition: all var(--duration-normal) var(--ease-out);
}

.action-item::after {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, var(--color-gold-subtle), transparent);
  opacity: 0;
  transition: opacity var(--duration-normal);
}

.action-item:active {
  background: linear-gradient(135deg,
    var(--color-bg-card-warm), var(--color-bg-card-elevated));
  border-color: var(--color-border-glow);
  transform: scale(0.96);
  box-shadow: var(--shadow-glow-gold);
}

.action-item:active::after {
  opacity: 0.5;
}

.action-icon {
  font-size: 36rpx;
  display: block;
  margin-bottom: var(--space-sm);
  opacity: 0.7;
}

.action-label {
  font-size: var(--fs-body-small);
  color: var(--color-text-secondary);
  display: block;
}

/* ---------------------------------------------------------------
   History — 占卜历史卷宗
   --------------------------------------------------------------- */
.history-section {
  border-radius: var(--radius-card);
  overflow: hidden;
  border: 1rpx solid var(--color-border-subtle);
  background: var(--color-bg-card-warm);
  box-shadow: var(--shadow-card);
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-lg) var(--space-xl);
  border-bottom: 1rpx solid var(--color-divider);
}

.history-title {
  font-size: var(--fs-body);
  font-weight: var(--fw-semibold);
  color: var(--color-text-primary);
  letter-spacing: var(--ls-heading);
}

.clear-btn {
  font-size: var(--fs-body-small);
  color: var(--color-text-dim);
  background: none;
  border: none;
  padding: var(--space-xs) var(--space-sm);
  border-radius: var(--radius-sm);
  transition: all var(--duration-fast);
}

.clear-btn:active {
  color: var(--color-gold);
  background: var(--color-gold-subtle);
}

/* History list */
.history-list {
  padding: 0;
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-lg) var(--space-xl);
  border-bottom: 1rpx solid var(--color-divider);
  transition: background var(--duration-fast);
}

.history-item:last-child {
  border-bottom: none;
}

.history-item:active {
  background: var(--color-star-subtle);
}

.history-left {
  display: flex;
  flex-direction: column;
  gap: var(--space-xxs);
}

.history-type {
  font-size: var(--fs-body);
  color: var(--color-text-primary);
  display: block;
}

.history-time {
  font-size: var(--fs-caption);
  color: var(--color-text-dim);
  display: block;
}

.history-right {
  text-align: right;
}

.history-status {
  font-size: var(--fs-caption);
  color: var(--color-gold);
  display: block;
}

/* ---------------------------------------------------------------
   Load / Skeleton
   --------------------------------------------------------------- */
.skeleton {
  width: 100%;
}

.skeleton-card {
  width: 100%;
  height: 320rpx;
  border-radius: var(--radius-card);
  background: var(--color-bg-card);
  margin-bottom: var(--space-xl);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-stats {
  width: 100%;
  height: 120rpx;
  border-radius: var(--radius-lg);
  background: var(--color-bg-card);
  margin-bottom: var(--space-xl);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-actions {
  display: flex;
  gap: var(--space-md);
  margin-bottom: var(--space-xxl);
}

.skeleton-action {
  flex: 1;
  height: 100rpx;
  border-radius: var(--radius-lg);
  background: var(--color-bg-card);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-history {
  width: 100%;
  height: 300rpx;
  border-radius: var(--radius-card);
  background: var(--color-bg-card);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

/* ---------------------------------------------------------------
   Error
   --------------------------------------------------------------- */
.error-state {
  text-align: center;
  padding: var(--space-massive) var(--space-xl);
}

.error-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: var(--space-md);
  opacity: 0.5;
}

.error-text {
  font-size: var(--fs-body);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--space-xs);
}

.error-hint {
  font-size: var(--fs-body-small);
  color: var(--color-text-dim);
  display: block;
  margin-bottom: var(--space-xxl);
}
