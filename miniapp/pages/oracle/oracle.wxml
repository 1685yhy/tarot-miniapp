<!-- pages/oracle/oracle.wxml -->
<!-- 神谕主屏（简版）：星图三要素（真实计算 · 开发 05）· 深度报告入口 · 牌阵馆 · 百科 -->

<view class="page">
  <view class="wash wash-pink"></view>
  <view class="wash wash-gold"></view>

  <!-- 顶部：品牌 · 日期（左）｜星座徽章（右） -->
  <view class="topbar">
    <view class="tb-left">
      <text class="brand">星光映照</text>
      <view class="date-row">
        <view class="gold-dot"></view>
        <text class="date-text">{{dateText}}</text>
      </view>
    </view>
    <view class="zodiac-badge" wx:if="{{zodiacBadge}}" bindtap="onGoZodiac" role="button" aria-label="点击修改星座 {{zodiacBadge}}">
      <text class="zodiac-badge-text">{{zodiacBadge}}</text>
    </view>
    <view class="zodiac-badge zodiac-badge--empty" wx:else bindtap="onGoZodiac" role="button" aria-label="选择你的星座">
      <text class="zodiac-badge-text">选择星座 ✦</text>
    </view>
  </view>

  <!-- 标题：注脚，不抢戏 -->
  <view class="oracle-head">
    <text class="oh-en">ORACLE</text>
    <text class="oh-h2">星图三要素</text>
    <text class="oh-p">你的光芒，由三颗星写就</text>
  </view>

  <!-- 主角：三要素卡（真实星盘 · 未点亮 → 出生信息引导） -->
  <view
    class="ele-card {{item.locked ? 'ele-card-locked' : ''}}"
    wx:for="{{elements}}" wx:key="key"
    bindtap="onGoElement" data-key="{{item.key}}"
    role="button" aria-label="{{item.locked ? item.line : '查看' + item.name + '详情'}}"
    hover-class="ele-card-pressed"
  >
    <view class="ele-ic {{item.locked ? 'ele-ic-locked' : ''}}"><text>{{item.icon}}</text></view>
    <view class="ele-tx">
      <view class="ele-n-row">
        <text class="ele-n {{item.locked ? 'ele-n-locked' : ''}}">{{item.name}}</text>
        <text class="ele-approx" wx:if="{{item.approx}}">近似</text>
      </view>
      <text class="ele-l {{item.locked ? 'ele-l-locked' : ''}}">{{item.line}}</text>
    </view>
    <text class="ele-go">›</text>
  </view>

  <!-- 未填出生信息的全局引导（三要素全部未点亮时） -->
  <view class="need-birth" wx:if="{{needsBirth}}" bindtap="onGoElement" data-key="sun" hover-class="need-birth-pressed" role="button" aria-label="完善出生信息，点亮星盘">
    <text class="need-birth-ic">✦</text>
    <text class="need-birth-tx">完善出生信息，点亮你的太阳与月亮</text>
    <text class="need-birth-go">去填写 →</text>
  </view>

  <!-- 深度报告入口（会员免费 / 19.9 解锁） -->
  <view class="deep-pill" bindtap="onDeepReport" role="button" aria-label="深度星图报告" hover-class="deep-pill-pressed">
    <text class="deep-pill-ic">✦</text>
    <text class="deep-pill-tx">深度星图报告 · 结合出生时刻的更深你</text>
    <text class="deep-pill-go">会员免费 →</text>
  </view>

  <!-- 牌阵馆（6 卡入口：4 网格 + 2 行宽卡 · 与原型页 07 一致） -->
  <view class="section-label">
    <view class="sec-line"></view>
    <text class="sec-text">牌阵馆</text>
    <view class="sec-line"></view>
  </view>
  <view class="spread-grid">
    <view
      class="spread-card" wx:for="{{spreads}}" wx:key="type" wx:if="{{!item.wide}}"
      bindtap="onGoSpread" data-type="{{item.type}}"
      role="button" aria-label="选择{{item.name}}牌阵"
      hover-class="spread-card-pressed"
    >
      <view class="spread-tag {{item.tag === '免费' ? 'spread-tag-free' : ''}}">{{item.tag}}</view>
      <text class="spread-ic">{{item.ic}}</text>
      <text class="spread-n">{{item.name}}</text>
      <text class="spread-d">{{item.desc}}</text>
    </view>
  </view>
  <view class="spread-wide-list">
    <view
      class="spread-wide" wx:for="{{spreads}}" wx:key="type" wx:if="{{item.wide}}"
      bindtap="onGoSpread" data-type="{{item.type}}"
      role="button" aria-label="选择{{item.name}}牌阵"
      hover-class="spread-card-pressed"
    >
      <text class="spread-ic">{{item.ic}}</text>
      <view class="spread-wide-t">
        <text class="spread-n">{{item.name}}<text wx:if="{{item.tag}}" class="spread-tag-inline">{{item.tag}}</text></text>
        <text class="spread-d">{{item.desc}}</text>
      </view>
      <text class="spread-wide-go">›</text>
    </view>
  </view>

  <!-- 注脚入口：卡牌百科 -->
  <view class="entry-row">
    <view class="entry-pill" bindtap="onGoEncyclopedia" role="button" aria-label="进入卡牌百科" hover-class="entry-pill-pressed">
      <text>卡牌百科</text>
      <text class="entry-arrow">→</text>
    </view>
    <view class="entry-pill entry-pill-ghost" bindtap="onDeepReport" role="button" aria-label="深度报告" hover-class="entry-pill-pressed">
      <text>深度报告</text>
      <text class="entry-arrow">✦</text>
    </view>
  </view>
</view>
