/* pages/share-center/share-center.wxss */
@import '../../styles/common.wxss';

/* ============================================================
   Share Center — Starlight Design System
   ============================================================ */

.page {
  padding: var(--spacing-lg);
  padding-bottom: calc(var(--safe-area-bottom) + var(--spacing-3xl));
  min-height: 100vh;
}

/* ============================================================
   Hero Card
   ============================================================ */
.hero-card {
  position: relative;
  text-align: center;
  padding: var(--spacing-2xl) var(--spacing-xl) var(--spacing-xl);
  border-radius: var(--radius-lg);
  margin-bottom: var(--spacing-lg);
  background: linear-gradient(145deg, #2A2A5A 0%, #252550 100%);
  border: 1.5rpx solid rgba(244, 212, 140, 0.12);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

.hero-glow {
  position: absolute;
  top: -100rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 400rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(244, 212, 140, 0.10) 0%, transparent 70%);
  pointer-events: none;
}

.hero-icon {
  width: 80rpx;
  height: 80rpx;
  display: block;
  margin: 0 auto var(--spacing-sm);
  opacity: 0.85;
}

.hero-title {
  font-size: var(--font-size-subhead);
  font-weight: var(--font-weight-bold);
  color: var(--color-gold);
  display: block;
  letter-spacing: 2rpx;
  margin-bottom: var(--spacing-xs);
}

.hero-subtitle {
  font-size: var(--font-size-caption);
  color: var(--color-lavender);
  display: block;
  letter-spacing: 1rpx;
  margin-bottom: var(--spacing-lg);
}

.hero-stats-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0;
}

.hero-stat {
  flex: 1;
  text-align: center;
  padding: var(--spacing-sm) 0;
}

.hero-stat-divider {
  width: 1rpx;
  height: 40rpx;
  background: linear-gradient(180deg, transparent, rgba(244, 212, 140, 0.20), transparent);
}

.hero-stat-num {
  display: block;
  font-size: var(--font-size-title);
  font-weight: var(--font-weight-bold);
  color: var(--color-gold);
  text-shadow: 0 0 20rpx rgba(244, 212, 140, 0.20);
}

.hero-stat-label {
  display: block;
  font-size: var(--font-size-caption);
  color: var(--color-lavender);
  margin-top: 4rpx;
}

/* ============================================================
   Invite Code Card
   ============================================================ */
.invite-code-card {
  background: linear-gradient(145deg, #252550 0%, #2A2A5A 100%);
  border: 1.5rpx solid rgba(244, 212, 140, 0.12);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-lg);
  box-shadow: var(--shadow-card);
  text-align: center;
}

.invite-code-label {
  display: block;
  font-size: var(--font-size-caption);
  color: var(--color-lavender);
  margin-bottom: var(--spacing-sm);
  letter-spacing: 1rpx;
}

.invite-code-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-md);
  margin-bottom: var(--spacing-sm);
}

.invite-code-text {
  font-size: var(--font-size-title);
  font-weight: var(--font-weight-bold);
  color: var(--color-gold);
  letter-spacing: 4rpx;
  text-shadow: 0 0 20rpx rgba(244, 212, 140, 0.15);
}

.copy-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(244, 212, 140, 0.12);
  border: 1rpx solid rgba(244, 212, 140, 0.25);
  border-radius: var(--radius-pill);
  padding: 10rpx 24rpx;
  font-size: var(--font-size-caption);
  color: var(--color-gold);
  min-height: 60rpx;
  line-height: 1;
}

.copy-btn:active {
  background: rgba(244, 212, 140, 0.20);
  transform: scale(0.95);
}

.copy-btn-icon {
  width: 28rpx;
  height: 28rpx;
  display: block;
}

.copy-btn-text {
  font-size: var(--font-size-caption);
  color: var(--color-gold);
}

.invite-code-hint {
  display: block;
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  letter-spacing: 1rpx;
}

/* ============================================================
   Invite Action Button
   ============================================================ */
.invite-action {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-sm);
  background: linear-gradient(135deg, #F4D48C 0%, #E8C67A 50%, #D4B06A 100%);
  border-radius: var(--radius-pill);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-xl);
  box-shadow: var(--shadow-gold-button);
  position: relative;
  overflow: hidden;
  min-height: 88rpx;
}

.invite-action:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 12rpx rgba(244, 212, 140, 0.20);
}

.invite-btn-glow {
  position: absolute;
  top: -40rpx;
  left: -40rpx;
  width: 160rpx;
  height: 160rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.15) 0%, transparent 70%);
  pointer-events: none;
  border-radius: 50%;
}

.invite-action-icon {
  width: 40rpx;
  height: 40rpx;
  display: block;
  z-index: 1;
}

.invite-action-text {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-inverse);
  z-index: 1;
}

.invite-action-arrow {
  font-size: var(--font-size-body);
  color: var(--color-text-inverse);
  opacity: 0.60;
  z-index: 1;
}

/* ============================================================
   Reward Section
   ============================================================ */
.reward-section {
  background: linear-gradient(145deg, #252550 0%, #2A2A5A 100%);
  border: 1.5rpx solid rgba(244, 212, 140, 0.12);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-lg);
  box-shadow: var(--shadow-card);
}

.reward-header {
  display: flex;
  align-items: center;
  gap: var(--spacing-xs);
  margin-bottom: var(--spacing-lg);
  padding-bottom: var(--spacing-md);
  border-bottom: 1rpx solid rgba(244, 212, 140, 0.08);
}

.reward-header-icon {
  width: 32rpx;
  height: 32rpx;
  display: block;
  opacity: 0.85;
}

.reward-header-title {
  font-size: var(--font-size-subhead);
  font-weight: var(--font-weight-bold);
  color: var(--color-gold);
  letter-spacing: 2rpx;
}

.reward-tier {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-md) 0;
  border-bottom: 1rpx solid rgba(244, 212, 140, 0.05);
  opacity: 0.60;
  transition: opacity var(--duration-fast) var(--ease-soft);
}

.reward-tier:last-of-type {
  border-bottom: none;
}

.reward-tier--claimed {
  opacity: 1;
}

.tier-left {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}

.tier-check {
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-bold);
}

.tier-check--pending {
  background: rgba(106, 101, 136, 0.20);
  color: var(--color-text-tertiary);
  border: 1.5rpx solid rgba(106, 101, 136, 0.25);
}

.tier-check--done {
  background: rgba(123, 198, 160, 0.15);
  color: var(--color-success);
  border: 1.5rpx solid rgba(123, 198, 160, 0.30);
}

.tier-check-icon {
  font-size: var(--font-size-caption);
  line-height: 1;
}

.tier-check-num {
  font-size: var(--font-size-caption);
  line-height: 1;
}

.tier-info {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.tier-title {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
}

.tier-desc {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
}

.tier-status {
  font-size: var(--font-size-xs);
  padding: 6rpx 16rpx;
  border-radius: var(--radius-pill);
  flex-shrink: 0;
}

.tier-status--pending {
  background: rgba(244, 212, 140, 0.08);
  color: var(--color-gold-dark);
  border: 1rpx solid rgba(244, 212, 140, 0.15);
}

.tier-status--done {
  background: rgba(123, 198, 160, 0.10);
  color: var(--color-success);
  border: 1rpx solid rgba(123, 198, 160, 0.20);
}

/* Reward progress bar */
.reward-progress-wrap {
  margin-top: var(--spacing-lg);
  padding-top: var(--spacing-md);
  border-top: 1rpx solid rgba(244, 212, 140, 0.08);
  text-align: center;
}

.reward-progress-bar {
  width: 100%;
  height: 8rpx;
  background: rgba(106, 101, 136, 0.20);
  border-radius: var(--radius-pill);
  overflow: hidden;
  margin-bottom: var(--spacing-sm);
}

.reward-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #D4B06A 0%, #F4D48C 50%, #FADE9E 100%);
  border-radius: var(--radius-pill);
  transition: width var(--duration-slow) var(--ease-out);
  box-shadow: 0 0 10rpx rgba(244, 212, 140, 0.15);
}

.reward-progress-text {
  display: block;
  font-size: var(--font-size-caption);
  color: var(--color-text-secondary);
  margin-bottom: 4rpx;
}

.reward-progress-next {
  display: block;
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  letter-spacing: 1rpx;
}

.reward-progress-next--complete {
  color: var(--color-success);
}

/* ============================================================
   History Section
   ============================================================ */
.history-section {
  background: linear-gradient(145deg, #252550 0%, #2A2A5A 100%);
  border: 1.5rpx solid rgba(244, 212, 140, 0.12);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  box-shadow: var(--shadow-card);
}

.history-header {
  display: flex;
  align-items: center;
  gap: var(--spacing-xs);
  margin-bottom: var(--spacing-md);
  padding-bottom: var(--spacing-md);
  border-bottom: 1rpx solid rgba(244, 212, 140, 0.08);
}

.history-header-icon {
  width: 32rpx;
  height: 32rpx;
  display: block;
  opacity: 0.80;
}

.history-header-title {
  font-size: var(--font-size-subhead);
  font-weight: var(--font-weight-semibold);
  color: var(--color-gold);
}

.history-item {
  display: flex;
  align-items: center;
  padding: var(--spacing-sm) 0;
  border-bottom: 1rpx solid rgba(244, 212, 140, 0.04);
}

.history-item:last-child {
  border-bottom: none;
}

.history-date {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  flex: 1;
}

.history-type {
  font-size: var(--font-size-caption);
  color: var(--color-lavender);
  margin-right: var(--spacing-sm);
}

.history-reward {
  font-size: var(--font-size-xs);
  color: var(--color-success);
  background: rgba(123, 198, 160, 0.10);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid rgba(123, 198, 160, 0.20);
}

/* Back action */
.back-action {
  text-align: center;
  padding: var(--spacing-md) 0 var(--spacing-sm);
  margin-top: var(--spacing-sm);
  border-top: 1rpx solid rgba(244, 212, 140, 0.06);
}

.back-text {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  letter-spacing: 1rpx;
}

.back-text:active {
  color: var(--color-gold);
}

/* ============================================================
   Zodiac Match Section — 星座契合 · 塔罗关系牌 (v1.5)
   ============================================================ */
.zodiac-section {
  background: linear-gradient(145deg, #252550 0%, #2A2A5A 100%);
  border: 1.5rpx solid rgba(244, 212, 140, 0.12);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-lg);
  box-shadow: var(--shadow-card);
}

.zodiac-header {
  text-align: center;
  margin-bottom: var(--spacing-lg);
}

.zodiac-header-title {
  display: block;
  font-size: var(--font-size-subhead);
  font-weight: var(--font-weight-bold);
  color: var(--color-gold);
  letter-spacing: 2rpx;
}

.zodiac-header-hint {
  display: block;
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  margin-top: 6rpx;
  letter-spacing: 1rpx;
}

/* Two pickers side by side */
.zodiac-pickers {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-lg);
}

.zodiac-picker {
  flex: 1;
  text-align: center;
  background: rgba(106, 101, 136, 0.12);
  border: 1.5rpx solid rgba(244, 212, 140, 0.18);
  border-radius: var(--radius-md);
  padding: var(--spacing-md) var(--spacing-sm);
  transition: transform var(--duration-fast) var(--ease-soft);
}

.zodiac-picker:active {
  background: rgba(244, 212, 140, 0.10);
  transform: scale(0.97);
}

.zodiac-picker-emoji {
  display: block;
  font-size: 64rpx;
  line-height: 1.2;
  color: var(--color-gold);
  text-shadow: 0 0 20rpx rgba(244, 212, 140, 0.20);
}

.zodiac-picker-name {
  display: block;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  margin-top: 8rpx;
}

.zodiac-picker-tip {
  display: block;
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  margin-top: 4rpx;
}

.zodiac-plus {
  font-size: 40rpx;
  line-height: 1;
  color: var(--color-gold);
  opacity: 0.70;
  flex-shrink: 0;
}

.zodiac-btn {
  width: 100%;
}

/* Match result */
.zodiac-result {
  margin-top: var(--spacing-lg);
  padding-top: var(--spacing-md);
  border-top: 1rpx solid rgba(244, 212, 140, 0.10);
}

.zodiac-result-card-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-xs);
  margin-bottom: var(--spacing-sm);
}

.zodiac-result-label {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}

.zodiac-result-card {
  font-size: var(--font-size-subhead);
  font-weight: var(--font-weight-bold);
  color: var(--color-gold);
  text-shadow: 0 0 20rpx rgba(244, 212, 140, 0.15);
}

.zodiac-result-text {
  display: block;
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  line-height: 1.7;
  margin-bottom: var(--spacing-md);
  text-align: center;
}

.zodiac-share-btn {
  width: 100%;
}

/* Zodiac picker popover (12 signs grid) */
.zodiac-picker-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(11, 11, 22, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.zodiac-picker-panel {
  width: 600rpx;
  max-width: 86vw;
  background: linear-gradient(145deg, #2A2A5A 0%, #252550 100%);
  border: 1.5rpx solid rgba(244, 212, 140, 0.15);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  box-shadow: var(--shadow-card);
}

.zodiac-picker-panel-title {
  display: block;
  text-align: center;
  font-size: var(--font-size-subhead);
  font-weight: var(--font-weight-bold);
  color: var(--color-gold);
  letter-spacing: 2rpx;
  margin-bottom: var(--spacing-lg);
}

.zodiac-picker-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-lg);
}

.zodiac-picker-option {
  width: calc((100% - var(--spacing-sm) * 2) / 3);
  box-sizing: border-box;
  text-align: center;
  background: rgba(106, 101, 136, 0.12);
  border: 1.5rpx solid rgba(244, 212, 140, 0.10);
  border-radius: var(--radius-md);
  padding: var(--spacing-sm) 0;
}

.zodiac-picker-option:active {
  background: rgba(244, 212, 140, 0.14);
  border-color: rgba(244, 212, 140, 0.35);
}

.zodiac-picker-option-emoji {
  display: block;
  font-size: 44rpx;
  line-height: 1.2;
  color: var(--color-gold);
}

.zodiac-picker-option-name {
  display: block;
  font-size: var(--font-size-caption);
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

.zodiac-picker-cancel {
  width: 100%;
}

/* ============================================================
   Empty State
   ============================================================ */
.empty-state-inline {
  text-align: center;
  padding: var(--spacing-2xl) 0;
}

.empty-state-inline .empty-icon-img {
  width: 72rpx;
  height: 72rpx;
  display: block;
  margin: 0 auto var(--spacing-md);
  opacity: 0.35;
}

.empty-state-inline .empty-text {
  display: block;
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  margin-bottom: var(--spacing-xs);
}

.empty-state-inline .empty-hint {
  display: block;
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
}

/* ============================================================
   Error State
   ============================================================ */
.error-state {
  text-align: center;
  padding: var(--spacing-3xl) var(--spacing-xl);
}

.error-state .error-text {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--spacing-xs);
}

.error-state .error-hint {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  display: block;
  margin-bottom: var(--spacing-xl);
}
