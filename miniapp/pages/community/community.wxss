/* pages/community/community.wxss */
/* Starlight Tree Hole — Anonymous community page */

/* === E3 补全: community ===
   设计级补全（与首页 E3 气质统一）：
   1. 标题（页头/话题卡/分区/编辑器）→ 衬线宽字距
   2. 话题卡 0.28 黑重阴影 → E3 浅阴影 + 细金描边
   3. 倾诉卡/编辑器 → 奶油底 + 细金描边 + 顶部高光
   4. 其余组件已 E3 化，微调次级文字 */

/* ============================================================
   1. Page Container
   ============================================================ */
.community-page {
  background: var(--color-bg);
  background-image: var(--color-bg-gradient);
  min-height: 100vh;
  padding-bottom: calc(200rpx + var(--safe-area-bottom));
}

/* ============================================================
   2. Header
   ============================================================ */
.community-header {
  display: flex;
  align-items: center;
  padding: var(--spacing-md) 0;
  margin-bottom: var(--spacing-sm);
}

.community-header-back {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(201, 169, 124, 0.06);
  border: 1rpx solid rgba(201, 169, 124, 0.12);
  margin-right: var(--spacing-sm);
  flex-shrink: 0;
  transition: background var(--duration-fast) var(--ease-out),
              transform var(--duration-fast) var(--ease-out);
}

.community-header-back:active {
  background: rgba(201, 169, 124, 0.15);
  transform: scale(0.92);
}

.community-back-arrow {
  font-size: var(--font-size-body);
  color: var(--color-gold-dark);
  font-weight: var(--font-weight-medium);
}

.community-header-title {
  flex: 1;
}

.community-title-main {
  display: block;
  font-size: var(--font-size-title);
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
  letter-spacing: 4rpx;
  text-shadow: 0 0 30rpx rgba(201, 169, 124, 0.08);
}

.community-title-sub {
  display: block;
  font-size: var(--font-size-caption);
  color: var(--color-lavender-dark);
  margin-top: 4rpx;
  letter-spacing: 2rpx;
  opacity: 0.75;
}

/* ============================================================
   3. Today's Topic Card
   ============================================================ */
.topic-card-wrap {
  margin-bottom: var(--spacing-lg);
}

.topic-card {
  position: relative;
  background: var(--color-surface-gradient);
  border: 1.5rpx solid rgba(201, 169, 124, 0.25);
  border-radius: var(--radius-lg);
  padding: var(--spacing-xl) var(--spacing-lg);
  text-align: center;
  overflow: hidden;
  box-shadow:
    0 4rpx 24rpx rgba(0, 0, 0, 0.28),
    0 0 50rpx rgba(201, 169, 124, 0.08);
}

/* Decorative glow ring */
.topic-card-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 500rpx;
  height: 500rpx;
  transform: translate(-50%, -50%);
  background: radial-gradient(
    circle at center,
    rgba(201, 169, 124, 0.06) 0%,
    transparent 60%
  );
  pointer-events: none;
  z-index: 0;
}

/* Sparkle particles inside card */
.topic-sparkles {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  overflow: hidden;
  border-radius: inherit;
  z-index: 0;
}

.ts {
  position: absolute;
  width: 4rpx;
  height: 4rpx;
  background: #C9A97C;
  border-radius: 50%;
  opacity: 0;
  box-shadow: 0 0 6rpx 2rpx rgba(201, 169, 124, 0.15);
}

.ts.s1 { top: 10%; left: 12%; animation: sparkle-float 3.5s ease-in-out 0.2s infinite; }
.ts.s2 { top: 15%; left: 82%; animation: sparkle-float 3s ease-in-out 1s infinite; }
.ts.s3 { top: 80%; left: 15%; animation: sparkle-float 4s ease-in-out 0.5s infinite; }
.ts.s4 { top: 75%; left: 80%; animation: sparkle-float 3.2s ease-in-out 1.8s infinite; }

@keyframes sparkle-float {
  0%, 100% { opacity: 0; transform: translateY(8rpx) scale(0.4); }
  25% { opacity: 0.2; transform: translateY(-4rpx) scale(1.1); }
  50% { opacity: 0.1; transform: translateY(-8rpx) scale(0.6); }
  75% { opacity: 0.15; transform: translateY(-2rpx) scale(0.9); }
}

.topic-card-icon {
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto var(--spacing-md);
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(201, 169, 124, 0.08);
  border: 1.5rpx solid rgba(201, 169, 124, 0.20);
  border-radius: 50%;
  position: relative;
  z-index: 1;
  box-shadow: 0 0 30rpx rgba(201, 169, 124, 0.10);
}

.topic-card-emoji {
  width: 44rpx;
  height: 44rpx;
  display: block;
}

.topic-card-title {
  display: block;
  font-size: var(--font-size-subhead);
  font-weight: var(--font-weight-semibold);
  color: var(--color-gold-dark);
  line-height: var(--line-height-tight);
  letter-spacing: 3rpx;
  margin-bottom: var(--spacing-sm);
  position: relative;
  z-index: 1;
  text-shadow: 0 0 20rpx rgba(201, 169, 124, 0.10);
}

.topic-card-desc {
  display: block;
  font-size: var(--font-size-caption);
  color: var(--color-lavender-dark);
  line-height: var(--line-height-loose);
  letter-spacing: 2rpx;
  position: relative;
  z-index: 1;
  opacity: 0.90;
}

.topic-card-footer {
  margin-top: var(--spacing-md);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 1;
}

.topic-post-count {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx var(--spacing-sm);
  background: rgba(201, 169, 124, 0.08);
  border: 1rpx solid rgba(201, 169, 124, 0.30);
  border-radius: var(--radius-pill);
}

.topic-post-count-icon {
  font-size: var(--font-size-xs);
  color: var(--color-gold-dark);
}

.topic-post-count-text {
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-medium);
  color: var(--color-gold-dark);
  letter-spacing: 1rpx;
}

/* ============================================================
   4. Posts Section
   ============================================================ */
.posts-section {
  margin-top: var(--spacing-lg);
}

.posts-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-sm);
  padding-left: var(--spacing-sm);
  border-left: 3rpx solid var(--color-gold);
}

.posts-section-title {
  font-size: var(--font-size-subhead);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  letter-spacing: 3rpx;
}

.posts-section-count {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  letter-spacing: 1rpx;
}

.posts-scroll {
  max-height: 70vh;
}

.posts-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
}

/* Post card — anonymous, no avatar */
.post-card {
  background: linear-gradient(135deg, rgba(255, 253, 248, 0.85) 0%, rgba(247, 240, 227, 0.85) 100%);
  border: 1rpx solid rgba(201, 169, 124, 0.28);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  position: relative;
  overflow: hidden;
  transition: transform var(--duration-fast) var(--ease-out),
              border-color var(--duration-fast) var(--ease-out),
              box-shadow var(--duration-fast) var(--ease-out);
}

.post-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(201, 169, 124, 0.12), transparent);
  pointer-events: none;
}

.post-content {
  display: block;
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  line-height: var(--line-height-loose);
  letter-spacing: 1rpx;
  word-break: break-word;
}

.post-time {
  display: block;
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  margin-top: var(--spacing-sm);
  letter-spacing: 0.5rpx;
  opacity: 0.55;
}

/* Load more */
.load-more-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-lg) 0;
}

.load-more-text {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  opacity: 0.50;
  letter-spacing: 1rpx;
}

/* Empty state */
.empty-posts {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-4xl) var(--spacing-lg);
  text-align: center;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}

.empty-posts:active {
  opacity: 0.70;
}

.empty-posts-icon {
  width: 88rpx;
  height: 88rpx;
  margin-bottom: var(--spacing-md);
  display: block;
  opacity: 0.60;
}

.empty-posts-title {
  display: block;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-secondary);
  margin-bottom: var(--spacing-xs);
  letter-spacing: 2rpx;
}

.empty-posts-sub {
  display: block;
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  letter-spacing: 1rpx;
  opacity: 0.70;
}

/* ============================================================
   5. Floating Action Button
   ============================================================ */
.fab-write {
  position: fixed;
  right: var(--page-padding);
  bottom: calc(120rpx + var(--safe-area-bottom));
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(201, 169, 124, 0.40);
  background: var(--color-surface-gradient);
  box-shadow:
    0 4rpx 24rpx rgba(201, 169, 124, 0.35),
    0 0 60rpx rgba(201, 169, 124, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: var(--z-card);
  transition: transform var(--duration-fast) var(--ease-soft),
              box-shadow var(--duration-fast) var(--ease-soft);
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}

.fab-write:active {
  transform: scale(0.90);
  box-shadow: 0 2rpx 12rpx rgba(201, 169, 124, 0.20);
}

.fab-write-icon {
  width: 44rpx;
  height: 44rpx;
  display: block;
}

/* ============================================================
   6. Post Composer Overlay
   ============================================================ */
.composer-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(61, 58, 54, 0.45);
  z-index: var(--z-modal);
  display: flex;
  align-items: flex-end;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s var(--ease-soft);
}

.composer-overlay--visible {
  opacity: 1;
  pointer-events: auto;
}

.composer-sheet {
  width: 100%;
  background: var(--color-surface-gradient);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: var(--spacing-lg) var(--page-padding) calc(var(--spacing-xl) + var(--safe-area-bottom));
  padding-bottom: calc(var(--spacing-xl) + var(--safe-area-bottom));
  box-shadow: 0 -8rpx 40rpx rgba(61, 58, 54, 0.12);
  transform: translateY(100%);
  transition: transform 0.35s var(--ease-out);
}

.composer-sheet--show {
  transform: translateY(0);
}

.composer-handle {
  width: 64rpx;
  height: 6rpx;
  background: rgba(106, 101, 136, 0.35);
  border-radius: var(--radius-pill);
  margin: 0 auto var(--spacing-md);
}

.composer-title {
  display: block;
  font-size: var(--font-size-title);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  text-align: center;
  letter-spacing: 3rpx;
  margin-bottom: var(--spacing-xs);
}

.composer-hint {
  display: block;
  font-size: var(--font-size-caption);
  color: var(--color-lavender-dark);
  text-align: center;
  letter-spacing: 2rpx;
  margin-bottom: var(--spacing-lg);
  opacity: 0.75;
}

.composer-input {
  width: 100%;
  min-height: 200rpx;
  background: rgba(255, 253, 248, 0.90);
  border: 1rpx solid rgba(201, 169, 124, 0.30);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  line-height: var(--line-height-loose);
  letter-spacing: 1rpx;
  box-sizing: border-box;
  transition: border-color var(--duration-fast) var(--ease-soft);
}

.composer-input:focus {
  border-color: rgba(201, 169, 124, 0.40);
  box-shadow: 0 0 0 2rpx rgba(201, 169, 124, 0.08);
}

.composer-input::placeholder {
  color: var(--color-text-tertiary);
  font-size: var(--font-size-caption);
}

.composer-char-count {
  display: block;
  text-align: right;
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  margin-top: var(--spacing-xs);
  letter-spacing: 1rpx;
}

.btn-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin-top: var(--spacing-lg);
  padding: 28rpx 0;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-medium);
  letter-spacing: 3rpx;
  border-radius: var(--radius-pill);
  border: none;
  background: linear-gradient(135deg, #C9A97C 0%, #B08F52 50%, #A98B5F 100%);
  color: var(--color-text-inverse);
  box-shadow: var(--shadow-gold-button);
  transition: transform var(--duration-fast) var(--ease-out),
              opacity var(--duration-fast) var(--ease-out);
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}

.btn-submit:active {
  transform: scale(0.97);
  opacity: 0.92;
}

.btn-submit[disabled] {
  background: rgba(201, 169, 124, 0.20);
  color: rgba(61, 58, 54, 0.35);
  box-shadow: none;
  pointer-events: none;
}

.composer-anon-notice {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: var(--spacing-md);
}

.composer-anon-icon {
  font-size: var(--font-size-xs);
  color: var(--color-gold-dark);
  opacity: 0.60;
}

.composer-anon-text {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  letter-spacing: 1rpx;
  opacity: 0.60;
}

/* ============================================================
   7. Error State (reuse index pattern)
   ============================================================ */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx var(--spacing-lg) 80rpx;
  text-align: center;
}

.error-text {
  font-size: var(--font-size-title);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-xs);
  display: block;
}

.error-hint {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  margin-bottom: var(--spacing-xl);
  display: block;
}

.btn-ghost {
  background: transparent;
  color: var(--color-text-secondary);
  border: none;
  padding: 16rpx 24rpx;
  min-height: 88rpx;
  font-size: var(--font-size-body);
  cursor: pointer;
}

.btn-ghost:active {
  color: var(--color-gold-dark);
  background: rgba(201, 169, 124, 0.06);
}

/* ============================================================
   8. Accessibility
   ============================================================ */
@media (prefers-reduced-motion: reduce) {
  .ts { animation: none !important; opacity: 0; }
  .topic-card-glow { opacity: 0.3; }
  .composer-sheet { transition: none; }
  .composer-overlay { transition: none; }
}

/* ============================================================
   E3 奶油疗愈 — 设计级补全（追加覆盖）
   ============================================================ */
page {
  --e3-cream: #FAF6EF;
  --e3-cream-hi: #FFFDF8;
  --e3-paper: #F2ECDF;
  --e3-pink: #E8C4BE;
  --e3-pink-ink: #B08A82;
  --e3-gold: #C9A97C;
  --e3-gold-deep: #8A6B3D;
  --e3-line: rgba(201, 169, 124, 0.28);
  --e3-line-soft: rgba(201, 169, 124, 0.38);
  --e3-ink: #3D3A36;
  --e3-ink-soft: #8A8478;
  --e3-ink-faint: #6E6A96;
  --e3-shadow: 0 2rpx 8rpx rgba(61, 58, 54, 0.08);
  --e3-hi: inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
  --e3-serif: 'Songti SC', 'STSong', 'SimSun', 'Noto Serif CJK SC', 'Noto Serif SC', serif;
}

/* —— 页头 —— */
.community-title-main {
  font-family: var(--e3-serif);
  font-weight: 500;
  color: var(--e3-ink);
  letter-spacing: 8rpx;
  text-shadow: none;
}
.community-title-sub {
  color: var(--e3-ink-soft);
  letter-spacing: 2rpx;
}
.community-header-back {
  background: var(--e3-cream-hi);
  border: 1rpx solid var(--e3-line);
  box-shadow: var(--e3-shadow);
}

/* —— 今日话题卡：重阴影 → E3 浅阴影 —— */
.topic-card {
  border: 1rpx solid var(--e3-line-soft);
  border-radius: 24rpx;
  box-shadow: var(--e3-shadow), var(--e3-hi);
}
.topic-card-title {
  font-family: var(--e3-serif);
  font-weight: 500;
  color: var(--e3-ink);
  letter-spacing: 4rpx;
  text-shadow: none;
}
.topic-card-desc {
  color: var(--e3-ink-soft);
  font-family: var(--e3-serif);
  letter-spacing: 2rpx;
}
.topic-card-icon {
  background: rgba(232, 196, 190, 0.30);
  border: 1rpx solid rgba(201, 169, 124, 0.22);
  box-shadow: 0 0 30rpx rgba(201, 169, 124, 0.08);
}
.topic-post-count {
  background: rgba(232, 196, 190, 0.30);
  border: 1rpx solid rgba(201, 169, 124, 0.25);
}
.topic-post-count-text {
  color: var(--e3-pink-ink);
}

/* —— 倾诉列表 —— */
.posts-section-title {
  font-family: var(--e3-serif);
  font-weight: 500;
  color: var(--e3-ink);
  letter-spacing: 4rpx;
}
.post-card {
  background: linear-gradient(145deg, var(--e3-cream-hi) 0%, var(--e3-paper) 100%);
  border: 1rpx solid var(--e3-line);
  border-radius: 20rpx;
  box-shadow: var(--e3-shadow), var(--e3-hi);
}
.post-content {
  color: var(--e3-ink);
  font-family: var(--e3-serif);
  letter-spacing: 1rpx;
}
.post-time {
  color: var(--e3-ink-faint);
}

/* —— 倾诉编辑器 —— */
.composer-sheet {
  background: linear-gradient(180deg, var(--e3-cream-hi) 0%, var(--e3-cream) 100%);
  border-top: 1rpx solid var(--e3-line-soft);
}
.composer-title {
  font-family: var(--e3-serif);
  font-weight: 500;
  color: var(--e3-ink);
  letter-spacing: 6rpx;
}
.composer-hint {
  color: var(--e3-ink-soft);
}
.composer-input {
  background: var(--e3-cream-hi);
  border: 1rpx solid var(--e3-line);
  border-radius: 20rpx;
  box-shadow: var(--e3-hi);
  color: var(--e3-ink);
}
.composer-anon-text {
  color: var(--e3-ink-faint);
}
.composer-handle {
  background: rgba(201, 169, 124, 0.30);
}

/* —— 错误状态 —— */
.error-text {
  font-family: var(--e3-serif);
  color: var(--e3-ink);
  letter-spacing: 3rpx;
}

/* ============================================================
   P3-3 新增：话题卡单行化 + 帖子互动行
   ============================================================ */

/* —— 今日话题卡：一行排布 —— */
.topic-card--row {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  padding: var(--spacing-sm) var(--spacing-lg);
  text-align: left;
  border: 1rpx solid var(--e3-line-soft);
  border-radius: 24rpx;
  box-shadow: var(--e3-shadow), var(--e3-hi);
}
.topic-card--row .topic-card-icon {
  width: 64rpx;
  height: 64rpx;
  margin: 0;
  flex-shrink: 0;
}
.topic-card--row .topic-card-title {
  flex: 1;
  min-width: 0;
  margin-bottom: 0;
  font-size: var(--font-size-body);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: 2rpx;
}
.topic-card-tag {
  flex-shrink: 0;
  font-size: var(--font-size-xs);
  font-family: var(--e3-serif);
  color: var(--e3-pink-ink);
  letter-spacing: 1rpx;
  opacity: 0.85;
}
.topic-card--row .topic-post-count {
  flex-shrink: 0;
  margin: 0;
  padding: 4rpx var(--spacing-sm);
}

/* —— 帖子互动行：时间 + 回应数 —— */
.post-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--spacing-sm);
}
.post-footer .post-time {
  margin-top: 0;
}
.post-replies {
  font-size: var(--font-size-xs);
  font-family: var(--e3-serif);
  color: var(--e3-gold-deep);
  letter-spacing: 1rpx;
}
