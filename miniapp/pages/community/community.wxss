/* pages/community/community.wxss */
/* Starlight Tree Hole — Anonymous community page */

/* ============================================================
   1. Page Container
   ============================================================ */
.community-page {
  background: var(--color-bg);
  background-image: var(--color-bg-gradient);
  min-height: 100vh;
  padding-bottom: calc(200rpx + var(--safe-area-bottom));
}

/* ============================================================
   2. Header
   ============================================================ */
.community-header {
  display: flex;
  align-items: center;
  padding: var(--spacing-md) 0;
  margin-bottom: var(--spacing-sm);
}

.community-header-back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(244, 212, 140, 0.06);
  border: 1rpx solid rgba(244, 212, 140, 0.12);
  margin-right: var(--spacing-sm);
  flex-shrink: 0;
  transition: all var(--duration-fast) var(--ease-out);
}

.community-header-back:active {
  background: rgba(244, 212, 140, 0.15);
  transform: scale(0.92);
}

.community-back-arrow {
  font-size: var(--font-size-body);
  color: var(--color-gold);
  font-weight: var(--font-weight-medium);
}

.community-header-title {
  flex: 1;
}

.community-title-main {
  display: block;
  font-size: var(--font-size-title);
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
  letter-spacing: 4rpx;
  text-shadow: 0 0 30rpx rgba(244, 212, 140, 0.08);
}

.community-title-sub {
  display: block;
  font-size: var(--font-size-caption);
  color: var(--color-lavender);
  margin-top: 4rpx;
  letter-spacing: 2rpx;
  opacity: 0.75;
}

/* ============================================================
   3. Today's Topic Card
   ============================================================ */
.topic-card-wrap {
  margin-bottom: var(--spacing-lg);
}

.topic-card {
  position: relative;
  background: var(--color-surface-gradient);
  border: 1.5rpx solid rgba(244, 212, 140, 0.25);
  border-radius: var(--radius-lg);
  padding: var(--spacing-xl) var(--spacing-lg);
  text-align: center;
  overflow: hidden;
  box-shadow:
    0 4rpx 24rpx rgba(0, 0, 0, 0.28),
    0 0 50rpx rgba(244, 212, 140, 0.08);
}

/* Decorative glow ring */
.topic-card-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 500rpx;
  height: 500rpx;
  transform: translate(-50%, -50%);
  background: radial-gradient(
    circle at center,
    rgba(244, 212, 140, 0.06) 0%,
    transparent 60%
  );
  pointer-events: none;
  z-index: 0;
}

/* Sparkle particles inside card */
.topic-sparkles {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  overflow: hidden;
  border-radius: inherit;
  z-index: 0;
}

.ts {
  position: absolute;
  width: 4rpx;
  height: 4rpx;
  background: #F4D48C;
  border-radius: 50%;
  opacity: 0;
  box-shadow: 0 0 6rpx 2rpx rgba(244, 212, 140, 0.15);
}

.ts.s1 { top: 10%; left: 12%; animation: sparkle-float 3.5s ease-in-out 0.2s infinite; }
.ts.s2 { top: 15%; left: 82%; animation: sparkle-float 3s ease-in-out 1s infinite; }
.ts.s3 { top: 80%; left: 15%; animation: sparkle-float 4s ease-in-out 0.5s infinite; }
.ts.s4 { top: 75%; left: 80%; animation: sparkle-float 3.2s ease-in-out 1.8s infinite; }

@keyframes sparkle-float {
  0%, 100% { opacity: 0; transform: translateY(8rpx) scale(0.4); }
  25% { opacity: 0.2; transform: translateY(-4rpx) scale(1.1); }
  50% { opacity: 0.1; transform: translateY(-8rpx) scale(0.6); }
  75% { opacity: 0.15; transform: translateY(-2rpx) scale(0.9); }
}

.topic-card-icon {
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto var(--spacing-md);
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(244, 212, 140, 0.08);
  border: 1.5rpx solid rgba(244, 212, 140, 0.20);
  border-radius: 50%;
  position: relative;
  z-index: 1;
  box-shadow: 0 0 30rpx rgba(244, 212, 140, 0.10);
}

.topic-card-emoji {
  font-size: 40rpx;
}

.topic-card-title {
  display: block;
  font-size: var(--font-size-subhead);
  font-weight: var(--font-weight-semibold);
  color: var(--color-gold);
  line-height: var(--line-height-tight);
  letter-spacing: 3rpx;
  margin-bottom: var(--spacing-sm);
  position: relative;
  z-index: 1;
  text-shadow: 0 0 20rpx rgba(244, 212, 140, 0.10);
}

.topic-card-desc {
  display: block;
  font-size: var(--font-size-caption);
  color: var(--color-lavender);
  line-height: var(--line-height-loose);
  letter-spacing: 2rpx;
  position: relative;
  z-index: 1;
  opacity: 0.90;
}

.topic-card-footer {
  margin-top: var(--spacing-md);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 1;
}

.topic-post-count {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx var(--spacing-sm);
  background: rgba(244, 212, 140, 0.08);
  border: 1rpx solid rgba(244, 212, 140, 0.15);
  border-radius: var(--radius-pill);
}

.topic-post-count-icon {
  font-size: var(--font-size-xs);
  color: var(--color-gold);
}

.topic-post-count-text {
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-medium);
  color: var(--color-gold);
  letter-spacing: 1rpx;
}

/* ============================================================
   4. Posts Section
   ============================================================ */
.posts-section {
  margin-top: var(--spacing-lg);
}

.posts-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-sm);
  padding-left: var(--spacing-sm);
  border-left: 3rpx solid var(--color-gold);
}

.posts-section-title {
  font-size: var(--font-size-subhead);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  letter-spacing: 3rpx;
}

.posts-section-count {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  letter-spacing: 1rpx;
}

.posts-scroll {
  max-height: 70vh;
}

.posts-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
}

/* Post card — anonymous, no avatar */
.post-card {
  background: linear-gradient(135deg, rgba(37, 37, 80, 0.70) 0%, rgba(42, 42, 94, 0.70) 100%);
  border: 1rpx solid rgba(244, 212, 140, 0.08);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  position: relative;
  overflow: hidden;
  transition: all var(--duration-fast) var(--ease-out);
}

.post-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(244, 212, 140, 0.12), transparent);
  pointer-events: none;
}

.post-content {
  display: block;
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  line-height: var(--line-height-loose);
  letter-spacing: 1rpx;
  word-break: break-word;
}

.post-time {
  display: block;
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  margin-top: var(--spacing-sm);
  letter-spacing: 0.5rpx;
  opacity: 0.55;
}

/* Load more */
.load-more-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-lg) 0;
}

.load-more-text {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  opacity: 0.50;
  letter-spacing: 1rpx;
}

/* Empty state */
.empty-posts {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-4xl) var(--spacing-lg);
  text-align: center;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}

.empty-posts:active {
  opacity: 0.70;
}

.empty-posts-icon {
  font-size: 64rpx;
  margin-bottom: var(--spacing-md);
  display: block;
  opacity: 0.60;
}

.empty-posts-title {
  display: block;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-secondary);
  margin-bottom: var(--spacing-xs);
  letter-spacing: 2rpx;
}

.empty-posts-sub {
  display: block;
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  letter-spacing: 1rpx;
  opacity: 0.70;
}

/* ============================================================
   5. Floating Action Button
   ============================================================ */
.fab-write {
  position: fixed;
  right: var(--page-padding);
  bottom: calc(120rpx + var(--safe-area-bottom));
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #F4D48C 0%, #E8C67A 50%, #D4B06A 100%);
  box-shadow:
    0 4rpx 24rpx rgba(244, 212, 140, 0.35),
    0 0 60rpx rgba(244, 212, 140, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: var(--z-card);
  transition: all var(--duration-fast) var(--ease-soft);
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}

.fab-write:active {
  transform: scale(0.90);
  box-shadow: 0 2rpx 12rpx rgba(244, 212, 140, 0.20);
}

.fab-write-icon {
  font-size: 44rpx;
  color: var(--color-text-inverse);
  font-weight: var(--font-weight-bold);
  line-height: 1;
}

/* ============================================================
   6. Post Composer Overlay
   ============================================================ */
.composer-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(10, 10, 30, 0.70);
  z-index: var(--z-modal);
  display: flex;
  align-items: flex-end;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s var(--ease-soft);
}

.composer-overlay--visible {
  opacity: 1;
  pointer-events: auto;
}

.composer-sheet {
  width: 100%;
  background: var(--color-surface-gradient);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: var(--spacing-lg) var(--page-padding) calc(var(--spacing-xl) + var(--safe-area-bottom));
  padding-bottom: calc(var(--spacing-xl) + var(--safe-area-bottom));
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.35);
  transform: translateY(100%);
  transition: transform 0.35s var(--ease-out);
}

.composer-sheet--show {
  transform: translateY(0);
}

.composer-handle {
  width: 64rpx;
  height: 6rpx;
  background: rgba(106, 101, 136, 0.35);
  border-radius: var(--radius-pill);
  margin: 0 auto var(--spacing-md);
}

.composer-title {
  display: block;
  font-size: var(--font-size-title);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  text-align: center;
  letter-spacing: 3rpx;
  margin-bottom: var(--spacing-xs);
}

.composer-hint {
  display: block;
  font-size: var(--font-size-caption);
  color: var(--color-lavender);
  text-align: center;
  letter-spacing: 2rpx;
  margin-bottom: var(--spacing-lg);
  opacity: 0.75;
}

.composer-input {
  width: 100%;
  min-height: 200rpx;
  background: rgba(37, 37, 80, 0.60);
  border: 1rpx solid rgba(244, 212, 140, 0.15);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  line-height: var(--line-height-loose);
  letter-spacing: 1rpx;
  box-sizing: border-box;
  transition: border-color var(--duration-fast) var(--ease-soft);
}

.composer-input:focus {
  border-color: rgba(244, 212, 140, 0.40);
  box-shadow: 0 0 0 2rpx rgba(244, 212, 140, 0.08);
}

.composer-input::placeholder {
  color: var(--color-text-tertiary);
  font-size: var(--font-size-caption);
}

.composer-char-count {
  display: block;
  text-align: right;
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  margin-top: var(--spacing-xs);
  letter-spacing: 1rpx;
}

.btn-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin-top: var(--spacing-lg);
  padding: 28rpx 0;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-medium);
  letter-spacing: 3rpx;
  border-radius: var(--radius-pill);
  border: none;
  background: linear-gradient(135deg, #F4D48C 0%, #E8C67A 50%, #D4B06A 100%);
  color: var(--color-text-inverse);
  box-shadow: var(--shadow-gold-button);
  transition: all var(--duration-fast) var(--ease-out);
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}

.btn-submit:active {
  transform: scale(0.97);
  opacity: 0.92;
}

.btn-submit[disabled] {
  background: rgba(244, 212, 140, 0.20);
  color: rgba(26, 26, 62, 0.35);
  box-shadow: none;
  pointer-events: none;
}

.composer-anon-notice {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: var(--spacing-md);
}

.composer-anon-icon {
  font-size: var(--font-size-xs);
  color: var(--color-gold);
  opacity: 0.60;
}

.composer-anon-text {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  letter-spacing: 1rpx;
  opacity: 0.60;
}

/* ============================================================
   7. Error State (reuse index pattern)
   ============================================================ */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx var(--spacing-lg) 80rpx;
  text-align: center;
}

.error-text {
  font-size: var(--font-size-title);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-xs);
  display: block;
}

.error-hint {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  margin-bottom: var(--spacing-xl);
  display: block;
}

.btn-ghost {
  background: transparent;
  color: var(--color-text-secondary);
  border: none;
  padding: 16rpx 24rpx;
  min-height: 88rpx;
  font-size: var(--font-size-body);
  cursor: pointer;
}

.btn-ghost:active {
  color: var(--color-gold);
  background: rgba(244, 212, 140, 0.06);
}

/* ============================================================
   8. Accessibility
   ============================================================ */
@media (prefers-reduced-motion: reduce) {
  .ts { animation: none !important; opacity: 0; }
  .topic-card-glow { opacity: 0.3; }
  .composer-sheet { transition: none; }
  .composer-overlay { transition: none; }
}
