<!-- pages/community/community.wxml -->
<!-- ===== 加载骨架 ===== -->
<view class="page" wx:if="{{pageLoading}}">
  <view class="skeleton skeleton--circle" style="margin:80rpx auto 30rpx"></view>
  <view class="skeleton skeleton--title" style="width:50%;margin:0 auto"></view>
  <view class="skeleton skeleton--text" style="width:70%;margin:12rpx auto 40rpx"></view>
  <view class="skeleton skeleton--block" style="margin-bottom:20rpx"></view>
  <view class="skeleton skeleton--text" style="width:30%;margin-bottom:20rpx"></view>
  <view class="skeleton skeleton--block" style="margin-bottom:16rpx;height:120rpx"></view>
  <view class="skeleton skeleton--block" style="margin-bottom:16rpx;height:120rpx"></view>
  <view class="skeleton skeleton--block" style="margin-bottom:16rpx;height:120rpx"></view>
</view>

<!-- ===== 错误状态 ===== -->
<view class="page" wx:elif="{{pageError}}">
  <view class="error-state">
    <text class="error-text">星光暂未连接</text>
    <text class="error-hint">{{pageError}}</text>
    <button class="btn-ghost" bindtap="onRetry">重新连接</button>
  </view>
</view>

<!-- ===== 主内容 ===== -->
<view class="page community-page" wx:else>

  <!-- ===== 今日话题卡片（P3-3：压缩为一行：图标+标题+今日话题+条数） ===== -->
  <view class="topic-card-wrap anim-fade-in-up-1">
    <view class="topic-card topic-card--row">
      <view class="topic-card-icon">
        <image class="topic-card-emoji" src="/images/icons/star_64.png" mode="aspectFit" aria-label="今日话题" />
      </view>
      <text class="topic-card-title">{{topic.topic.title}}</text>
      <text class="topic-card-tag">今日话题</text>
      <view class="topic-post-count">
        <text class="topic-post-count-icon">✦</text>
        <text class="topic-post-count-text">{{topic.post_count}} 条</text>
      </view>
    </view>
  </view>

  <!-- ===== 树洞倾诉列表 ===== -->
  <view class="posts-section">
    <!-- Section header -->
    <view class="posts-section-header">
      <text class="posts-section-title">树洞回响</text>
      <text wx:if="{{posts.length > 0}}" class="posts-section-count">{{total}} 条</text>
    </view>

    <!-- Posts list -->
    <scroll-view
      wx:if="{{posts.length > 0}}"
      class="posts-scroll"
      scroll-y
      bindscrolltolower="loadMorePosts"
    >
      <view class="posts-list">
        <view
          class="post-card"
          wx:for="{{posts}}"
          wx:for-item="post"
          wx:key="id"
        >
          <text class="post-content">{{post.content}}</text>
          <view class="post-footer">
            <text class="post-time">{{_formatTime(post.created_at)}}</text>
            <text class="post-replies" wx:if="{{post.reply_count}}">{{post.reply_count}} 条回应</text>
          </view>
        </view>
      </view>

      <!-- Load more -->
      <view wx:if="{{loadingMore}}" class="load-more-hint">
        <text class="load-more-text">加载中...</text>
      </view>
      <view wx:elif="{{!hasMore && posts.length > 0}}" class="load-more-hint">
        <text class="load-more-text">— 已加载全部 —</text>
      </view>
    </scroll-view>

    <!-- Empty state -->
    <view wx:elif="{{!pageLoading}}" class="empty-posts" bindtap="openComposer" role="button" aria-label="写第一篇倾诉">
      <image class="empty-posts-icon" src="/images/icons/heart_64.png" mode="aspectFit" aria-label="树洞" />
      <text class="empty-posts-title">树洞还很安静</text>
      <text class="empty-posts-sub">写下第一句心里话，星光为你倾听 ✦</text>
    </view>
  </view>

  <!-- ===== 浮动按钮 — 写倾诉 ===== -->
  <view class="fab fab-write" bindtap="openComposer" role="button" aria-label="写倾诉">
    <image class="fab-write-icon" src="/images/icons/chat_ask_64.png" mode="aspectFit" aria-label="写倾诉" />
  </view>

  <!-- ===== 倾诉编辑器浮层 ===== -->
  <view class="composer-overlay {{showComposer ? 'composer-overlay--visible' : ''}}" bindtap="closeComposer" role="button" aria-label="关闭倾诉编辑器">
    <view class="composer-sheet {{showComposer ? 'composer-sheet--show' : ''}}" catchtap="preventClose">
      <!-- Handle -->
      <view class="composer-handle"></view>

      <text class="composer-title">匿名倾诉</text>
      <text class="composer-hint">写下你的心声，无需留名</text>

      <textarea
        class="composer-input"
        placeholder="此刻你心里在想什么？这里只有星光听见..."
        value="{{composerContent}}"
        bindinput="onComposerInput"
        maxlength="500"
        focus="{{composerFocused}}"
        auto-height
      />
      <text class="composer-char-count">{{composerContent.length}}/500</text>

      <button bindtap="onSubmitPost"
        class="btn-submit btn-primary"
        disabled="{{submitting || composerContent.length === 0}}"
      >
        {{submitting ? '倾诉中...' : '匿名倾诉 ✦'}}
      </button>
      <view class="composer-anon-notice">
        <text class="composer-anon-icon">✦</text>
        <text class="composer-anon-text">匿名发布，不记录身份</text>
      </view>
    </view>
  </view>

</view>
