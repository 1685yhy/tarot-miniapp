/* ============================================================
   星象节点活动页（三形态）— E3 奶油疗愈 token（styles/common.wxss）
   许愿之夜 / 复盘之夜 / 慢行期（水逆自我关怀）+ info 资讯兜底
   ============================================================ */

/* --e3-* token 接线（同 astral-calendar 模式） */
page {
  --e3-cream: #FAF6EF;
  --e3-cream-hi: #FFFDF8;
  --e3-paper: #F2ECDF;
  --e3-pink: #E8C4BE;
  --e3-pink-ink: #B08A82;
  --e3-gold: #C9A97C;
  --e3-gold-deep: #8A6B3D;
  --e3-line: rgba(201, 169, 124, 0.28);
  --e3-line-soft: rgba(201, 169, 124, 0.38);
  --e3-lav: #D8D2E4;
  --e3-ink: #3D3A36;
  --e3-ink-soft: #8A8478;
  --e3-ink-faint: #6E6A96;
  --e3-shadow: 0 2rpx 8rpx rgba(61, 58, 54, 0.08);
  --e3-hi: inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
  --e3-serif: 'Songti SC', 'STSong', 'SimSun', 'Noto Serif CJK SC', 'Noto Serif SC', serif;
}

.container {
  padding: var(--spacing-xl) var(--spacing-lg);
  padding-bottom: calc(120rpx + var(--safe-area-bottom));
  min-height: 100vh;
  position: relative;
  z-index: 1;
}

/* E3 奶油底色氛围光斑 */
.wash {
  position: fixed;
  border-radius: 50%;
  filter: blur(80rpx);
  opacity: 0.5;
  pointer-events: none;
  z-index: 0;
}

.wash-pink {
  width: 420rpx;
  height: 420rpx;
  background: rgba(232, 196, 190, 0.5);
  top: -120rpx;
  right: -140rpx;
}

.wash-gold {
  width: 460rpx;
  height: 460rpx;
  background: rgba(201, 169, 124, 0.32);
  bottom: -160rpx;
  left: -180rpx;
}

/* ============================================================
   节点头
   ============================================================ */
.page-header {
  text-align: center;
  padding: var(--spacing-lg) 0 40rpx;
}

.node-emoji-wrap {
  width: 128rpx;
  height: 128rpx;
  margin: 0 auto var(--spacing-md);
  border-radius: 50%;
  background: linear-gradient(145deg, var(--e3-cream-hi, #FFFDF8) 0%, var(--e3-paper, #F2ECDF) 100%);
  border: 1rpx solid var(--e3-line-soft, rgba(201, 169, 124, 0.38));
  box-shadow: var(--e3-shadow, 0 2rpx 8rpx rgba(61, 58, 54, 0.08)), 0 0 32rpx rgba(201, 169, 124, 0.20);
  display: flex;
  align-items: center;
  justify-content: center;
}

.node-emoji {
  font-size: 60rpx;
  line-height: 1;
}

.page-title {
  font-size: var(--font-size-title);
  font-weight: 500;
  font-family: var(--e3-serif, 'Songti SC', serif);
  color: var(--e3-ink, #3D3A36);
  letter-spacing: 8rpx;
  display: block;
  margin-bottom: 12rpx;
}

.page-subtitle {
  font-size: var(--font-size-caption);
  color: var(--e3-ink-soft, #8A8478);
  letter-spacing: 3rpx;
  display: block;
}

/* ============================================================
   区间/窗口倒计时卡（wish 窗口 · mercury 慢行期共用）
   ============================================================ */
.window-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  background: linear-gradient(145deg, var(--e3-cream-hi, #FFFDF8) 0%, var(--e3-paper, #F2ECDF) 100%);
  border: 1rpx solid var(--e3-line-soft, rgba(201, 169, 124, 0.38));
  border-radius: 24rpx;
  padding: var(--spacing-lg) var(--spacing-md);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--e3-shadow, 0 2rpx 8rpx rgba(61, 58, 54, 0.08)), var(--e3-hi, inset 0 1rpx 0 rgba(255, 255, 255, 0.6));
}

.window-label {
  font-size: var(--font-size-xs);
  color: var(--e3-ink-faint, #6E6A96);
  letter-spacing: 4rpx;
}

.window-range {
  font-family: var(--e3-serif, 'Songti SC', serif);
  font-size: var(--font-size-subhead);
  font-weight: 600;
  color: var(--e3-gold-deep, #8A6B3D);
  letter-spacing: 2rpx;
}

.window-days {
  font-size: var(--font-size-caption);
  color: var(--e3-ink-soft, #8A8478);
  letter-spacing: 1rpx;
}

/* ============================================================
   每日一句（慢行期）
   ============================================================ */
.daily-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  background: rgba(216, 210, 228, 0.16);
  border: 1rpx solid rgba(110, 106, 150, 0.22);
  border-radius: 24rpx;
  padding: var(--spacing-lg) var(--spacing-md);
  margin-bottom: var(--spacing-md);
}

.daily-label {
  font-size: var(--font-size-xs);
  color: var(--e3-ink-faint, #6E6A96);
  letter-spacing: 4rpx;
}

.daily-text {
  font-family: var(--e3-serif, 'Songti SC', serif);
  font-size: var(--font-size-body);
  color: var(--e3-ink, #3D3A36);
  letter-spacing: 2rpx;
  line-height: 1.7;
  text-align: center;
}

/* ============================================================
   引导卡（许愿 / 复盘 / info 共用）
   ============================================================ */
.guide-card {
  background: linear-gradient(145deg, var(--e3-cream-hi, #FFFDF8) 0%, var(--e3-paper, #F2ECDF) 100%);
  border: 1rpx solid var(--e3-line, rgba(201, 169, 124, 0.28));
  border-radius: 24rpx;
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--e3-shadow, 0 2rpx 8rpx rgba(61, 58, 54, 0.08)), var(--e3-hi, inset 0 1rpx 0 rgba(255, 255, 255, 0.6));
}

.guide-title {
  display: block;
  font-family: var(--e3-serif, 'Songti SC', serif);
  font-size: var(--font-size-body);
  font-weight: 600;
  color: var(--e3-gold-deep, #8A6B3D);
  letter-spacing: 3rpx;
  margin-bottom: 10rpx;
}

.guide-body {
  display: block;
  font-size: var(--font-size-caption);
  color: var(--e3-ink-soft, #8A8478);
  line-height: 1.7;
  letter-spacing: 1rpx;
  margin-bottom: var(--spacing-md);
}

/* ============================================================
   愿望状态总览（wish / review 共用）
   ============================================================ */
.counts-card {
  background: linear-gradient(145deg, var(--e3-cream-hi, #FFFDF8) 0%, var(--e3-paper, #F2ECDF) 100%);
  border: 1rpx solid var(--e3-line, rgba(201, 169, 124, 0.28));
  border-radius: 24rpx;
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--e3-shadow, 0 2rpx 8rpx rgba(61, 58, 54, 0.08));
}

.counts-title {
  display: block;
  font-size: var(--font-size-xs);
  color: var(--e3-ink-faint, #6E6A96);
  letter-spacing: 4rpx;
  margin-bottom: var(--spacing-md);
}

.counts-row {
  display: flex;
  gap: var(--spacing-sm);
}

.count-chip {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  border-radius: 20rpx;
  padding: var(--spacing-md) 0;
  border: 1rpx solid transparent;
}

.count-chip--active {
  background: rgba(201, 169, 124, 0.14);
  border-color: rgba(201, 169, 124, 0.30);
}

.count-chip--grown {
  background: rgba(123, 198, 160, 0.12);
  border-color: rgba(123, 198, 160, 0.28);
}

.count-chip--answered {
  background: rgba(232, 196, 190, 0.18);
  border-color: rgba(232, 196, 190, 0.40);
}

.count-num {
  font-family: var(--e3-serif, 'Songti SC', serif);
  font-size: var(--font-size-title);
  font-weight: 600;
  color: var(--e3-ink, #3D3A36);
  line-height: 1.2;
}

.count-label {
  font-size: var(--font-size-xs);
  color: var(--e3-ink-soft, #8A8478);
  letter-spacing: 2rpx;
}

.counts-empty {
  text-align: center;
  font-family: var(--e3-serif, 'Songti SC', serif);
  font-size: var(--font-size-caption);
  color: var(--e3-ink-soft, #8A8478);
  letter-spacing: 2rpx;
  padding: var(--spacing-sm) 0;
}

/* ============================================================
   「慢下来的 7 件小事」清单
   ============================================================ */
.care-card {
  background: linear-gradient(145deg, var(--e3-cream-hi, #FFFDF8) 0%, var(--e3-paper, #F2ECDF) 100%);
  border: 1rpx solid var(--e3-line, rgba(201, 169, 124, 0.28));
  border-radius: 24rpx;
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-sm);
  box-shadow: var(--e3-shadow, 0 2rpx 8rpx rgba(61, 58, 54, 0.08)), var(--e3-hi, inset 0 1rpx 0 rgba(255, 255, 255, 0.6));
}

.care-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.care-title {
  font-family: var(--e3-serif, 'Songti SC', serif);
  font-size: var(--font-size-body);
  font-weight: 600;
  color: var(--e3-gold-deep, #8A6B3D);
  letter-spacing: 3rpx;
}

.care-progress {
  font-size: var(--font-size-xs);
  color: var(--e3-ink-faint, #6E6A96);
  letter-spacing: 1rpx;
}

.care-sub {
  display: block;
  font-size: var(--font-size-xs);
  color: var(--e3-ink-soft, #8A8478);
  letter-spacing: 1rpx;
  margin-bottom: var(--spacing-md);
}

/* 星星排：每完成一项点亮一颗 */
.star-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-md);
}

.star-chip {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(61, 58, 54, 0.05);
  border: 1rpx solid var(--e3-line, rgba(201, 169, 124, 0.28));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: rgba(201, 169, 124, 0.35);
  transition: background 0.2s ease, color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
}

.star-chip--lit {
  background: linear-gradient(135deg, #C9A97C 0%, #B08F52 100%);
  border-color: rgba(201, 169, 124, 0.60);
  color: #FFFDF8;
  box-shadow: 0 0 18rpx rgba(201, 169, 124, 0.45);
  transform: scale(1.06);
}

.care-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-xs);
}

.care-item {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
  background: rgba(255, 253, 248, 0.7);
  border: 1rpx solid var(--e3-line, rgba(201, 169, 124, 0.28));
  border-radius: 20rpx;
  padding: var(--spacing-md);
  transition: background 0.2s ease, border-color 0.2s ease;
}

.care-item--press {
  background: rgba(201, 169, 124, 0.10);
  transform: scale(0.985);
}

.care-item--done {
  background: rgba(201, 169, 124, 0.12);
  border-color: rgba(201, 169, 124, 0.45);
}

.care-check {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 1rpx solid var(--e3-line-soft, rgba(201, 169, 124, 0.38));
  background: var(--e3-cream-hi, #FFFDF8);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--e3-gold-deep, #8A6B3D);
  flex-shrink: 0;
  transition: background 0.2s ease, border-color 0.2s ease;
}

.care-item--done .care-check {
  background: linear-gradient(135deg, #C9A97C 0%, #B08F52 100%);
  border-color: rgba(201, 169, 124, 0.60);
  box-shadow: 0 0 14rpx rgba(201, 169, 124, 0.40);
}

.care-text {
  flex: 1;
  font-size: var(--font-size-caption);
  color: var(--e3-ink-soft, #8A8478);
  line-height: 1.6;
  letter-spacing: 1rpx;
}

.care-item--done .care-text {
  color: var(--e3-ink, #3D3A36);
}

/* 自我关怀备注 */
.care-note {
  background: rgba(232, 196, 190, 0.10);
  border: 1rpx solid rgba(232, 196, 190, 0.30);
  border-radius: 20rpx;
  padding: var(--spacing-md) var(--spacing-lg);
  margin-bottom: var(--spacing-md);
}

.care-note-text {
  font-family: var(--e3-serif, 'Songti SC', serif);
  font-size: var(--font-size-caption);
  color: var(--e3-pink-ink, #B08A82);
  letter-spacing: 2rpx;
  line-height: 1.7;
}

/* ============================================================
   资讯兜底（info）
   ============================================================ */
.info-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-md);
}

.info-item {
  display: flex;
  align-items: flex-start;
  gap: var(--spacing-sm);
}

.info-dot {
  font-size: var(--font-size-caption);
  color: var(--e3-gold, #C9A97C);
  line-height: 1.6;
  flex-shrink: 0;
}

.info-text {
  flex: 1;
  font-size: var(--font-size-caption);
  color: var(--e3-ink-soft, #8A8478);
  line-height: 1.7;
  letter-spacing: 1rpx;
}

/* ============================================================
   打卡区
   ============================================================ */
.checkin-area {
  padding-top: var(--spacing-xs);
}

.btn-checkin {
  width: 100%;
  min-height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #C9A97C 0%, #B08F52 50%, #A98B5F 100%);
  border: none;
  border-radius: var(--radius-pill);
  font-family: var(--e3-serif, 'Songti SC', serif);
  font-size: var(--font-size-body);
  color: #3D3A36;
  letter-spacing: 3rpx;
  box-shadow: var(--shadow-gold-button);
  transition: transform 0.15s ease-out, background 0.15s ease-out, opacity 0.15s ease-out;
}

.btn-checkin::after {
  border: none;
}

.btn-checkin--press {
  transform: scale(0.98);
  opacity: 0.92;
}

/* 未满足条件（慢行期未全部点亮）：浅金灰禁用态 */
.btn-checkin--muted,
.btn-checkin[disabled] {
  background: rgba(201, 169, 124, 0.22);
  color: rgba(61, 58, 54, 0.35);
  box-shadow: none;
  pointer-events: none;
}

.checkin-done {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-xs);
  min-height: 92rpx;
  background: rgba(123, 198, 160, 0.12);
  border: 1rpx solid rgba(123, 198, 160, 0.28);
  border-radius: var(--radius-pill);
}

.checkin-done-star {
  font-size: 28rpx;
  color: var(--color-success, #7BC6A0);
}

.checkin-done-text {
  font-family: var(--e3-serif, 'Songti SC', serif);
  font-size: var(--font-size-caption);
  color: var(--e3-ink, #3D3A36);
  letter-spacing: 2rpx;
}

/* ============================================================
   合规尾行
   ============================================================ */
.disclaimer {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-sm, 16rpx);
  padding: var(--spacing-lg, 32rpx) var(--spacing-md, 24rpx);
}

.disc-line {
  flex: 1;
  height: 1rpx;
  max-width: 60rpx;
  background: rgba(201, 169, 124, 0.25);
}

.disc-text {
  font-size: var(--font-size-xs, 20rpx);
  color: var(--color-text-tertiary, #6E6A96);
  letter-spacing: 1rpx;
  opacity: 0.85;
}

/* ============================================================
   加载骨架 + 错误状态
   ============================================================ */
.skeleton-wrap {
  padding: var(--spacing-xl) 0;
}

.skeleton-header-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-xl);
}

.skeleton-line {
  height: 30rpx;
  border-radius: var(--radius-sm);
}

.skeleton-line.wide { width: 280rpx; }
.skeleton-line.medium { width: 200rpx; }

.skeleton-block {
  width: 100%;
  height: 560rpx;
  border-radius: 28rpx;
}

.error-state {
  padding: 120rpx var(--spacing-lg);
  text-align: center;
}

.error-card {
  background: var(--color-surface);
  border: 1rpx solid rgba(232, 122, 138, 0.20);
  border-radius: var(--radius-lg);
  padding: var(--spacing-xl) var(--spacing-lg);
}

.error-title {
  font-family: var(--e3-serif, 'Songti SC', serif);
  font-size: var(--font-size-body);
  color: var(--e3-ink, #3D3A36);
  letter-spacing: 3rpx;
  display: block;
  margin-bottom: 12rpx;
}

.error-desc {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  display: block;
  margin-bottom: 36rpx;
  line-height: 1.6;
}

.btn-retry {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  background: rgba(201, 169, 124, 0.10);
  color: var(--color-gold-dark);
  font-size: var(--font-size-caption);
  font-weight: 500;
  border: 1rpx solid rgba(201, 169, 124, 0.20);
  border-radius: var(--radius-pill);
  padding: var(--spacing-sm) var(--spacing-xl);
  transition: background 0.2s;
}

.btn-retry:active {
  background: rgba(201, 169, 124, 0.18);
}

.btn-retry::after {
  border: none;
}

/* ============================================================
   引导卡主按钮
   ============================================================ */
.btn-submit {
  width: 100%;
  min-height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(201, 169, 124, 0.16) 0%, rgba(216, 210, 228, 0.16) 100%);
  border: 1rpx solid var(--e3-line-soft, rgba(201, 169, 124, 0.38));
  border-radius: var(--radius-pill);
  font-family: var(--e3-serif, 'Songti SC', serif);
  font-size: var(--font-size-body);
  color: var(--e3-gold-deep, #8A6B3D);
  letter-spacing: 4rpx;
  transition: background 0.2s, transform 0.15s ease-out;
}

.btn-submit::after {
  border: none;
}

.btn-submit--press {
  background: rgba(201, 169, 124, 0.18);
  transform: scale(0.98);
}
