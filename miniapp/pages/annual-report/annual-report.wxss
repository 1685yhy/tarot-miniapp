/* ===== 年度报告 - 新艺术主义年鉴 (Art Nouveau Yearbook) ===== */
/*    手工精装年册 · 植物章首 · 铜质月度分隔                */

/* ---------------------------------------------------------------
   Container — 暖白书页，如精装年鉴内页
   --------------------------------------------------------------- */
.container {
  padding: var(--space-xl);
  padding-bottom: calc(env(safe-area-inset-bottom) + var(--space-massive));
  background: linear-gradient(180deg, #F5F0E8 0%, #EFE9E0 100%);
  min-height: 100vh;
  position: relative;
}

/* 书页纹理 */
.container::before {
  content: '';
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background-image:
    repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2rpx,
      rgba(139, 94, 60, 0.015) 2rpx,
      rgba(139, 94, 60, 0.015) 4rpx
    );
  pointer-events: none;
  z-index: 0;
}

/* ---------------------------------------------------------------
   Intro — 卷首语，如年鉴扉页
   --------------------------------------------------------------- */
.intro {
  text-align: center;
  padding: var(--space-huge) 0 var(--space-xxl);
  position: relative;
}

/* 上下装饰线 — 铜绿交织 */
.intro::before,
.intro::after {
  content: '';
  display: block;
  width: 240rpx;
  height: 2rpx;
  margin: 0 auto;
  background: linear-gradient(90deg,
    transparent 0%,
    #B87333 20%,
    #7A8B6F 50%,
    #B87333 80%,
    transparent 100%
  );
  opacity: 0.35;
}
.intro::before { margin-bottom: var(--space-xxl); }
.intro::after { margin-top: var(--space-xxl); }

.intro-symbol {
  font-size: 80rpx;
  display: block;
  margin-bottom: var(--space-xl);
  animation: float 5s var(--ease-in-out) infinite;
  color: #7A8B6F;
  opacity: 0.5;
}

.intro-title {
  font-size: var(--fs-h1);
  font-weight: var(--fw-bold);
  color: #2C1810;
  display: block;
  letter-spacing: 6rpx;
  font-family: var(--font-family-display, serif);
}

.intro-subtitle {
  font-size: var(--fs-body);
  color: #8C7A6B;
  display: block;
  margin-top: var(--space-md);
  line-height: var(--lh-normal);
  letter-spacing: 2rpx;
  font-style: italic;
}

.intro-divider {
  display: block;
  margin: var(--space-xxl) auto 0;
  width: 120rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #B87333, transparent);
  opacity: 0.3;
}

/* 扉页底部藤蔓 */
.intro-vine-decoration {
  display: block;
  margin-top: var(--space-lg);
  font-size: 28rpx;
  color: #7A8B6F;
  opacity: 0.25;
  letter-spacing: 12rpx;
}

/* ---------------------------------------------------------------
   Generating (loading) — 翻页等待
   --------------------------------------------------------------- */
.generating {
  text-align: center;
  padding: var(--space-massive) 0;
}

.generating-symbol {
  font-size: 64rpx;
  display: block;
  color: #7A8B6F;
  animation: mystic-spin 5s var(--ease-in-out) infinite;
  margin-bottom: var(--space-xl);
  opacity: 0.6;
}

.generating-text {
  font-size: var(--fs-h4);
  color: #8B5E3C;
  font-weight: var(--fw-semibold);
  display: block;
  animation: breathe 3s ease-in-out infinite;
  letter-spacing: 4rpx;
}

.generating-sub {
  font-size: var(--fs-body);
  color: #8C7A6B;
  display: block;
  margin-top: var(--space-sm);
  font-style: italic;
}

/* ---------------------------------------------------------------
   Report — 年鉴正文
   --------------------------------------------------------------- */
.report {
  padding: var(--space-lg) 0;
}

.report-body {
  padding: var(--space-xxl);
  margin-bottom: var(--space-xl);
  position: relative;
  overflow: visible;
  background: #FAF5ED;
  border: 2rpx solid rgba(185, 115, 51, 0.1);
  box-shadow:
    0 0 0 4rpx #FAF5ED,
    0 0 0 6rpx rgba(185, 115, 51, 0.06),
    0 6rpx 28rpx rgba(139, 94, 60, 0.06);
}

/* 四角铜质书角 */
.report-body-corner-tl {
  position: absolute;
  top: -4rpx;
  left: -4rpx;
  width: 36rpx;
  height: 36rpx;
  border-top: 3rpx solid #B87333;
  border-left: 3rpx solid #B87333;
  opacity: 0.4;
  pointer-events: none;
}
.report-body-corner-tr {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  width: 36rpx;
  height: 36rpx;
  border-top: 3rpx solid #B87333;
  border-right: 3rpx solid #B87333;
  opacity: 0.4;
  pointer-events: none;
}
.report-body-corner-bl {
  position: absolute;
  bottom: -4rpx;
  left: -4rpx;
  width: 36rpx;
  height: 36rpx;
  border-bottom: 3rpx solid #B87333;
  border-left: 3rpx solid #B87333;
  opacity: 0.4;
  pointer-events: none;
}
.report-body-corner-br {
  position: absolute;
  bottom: -4rpx;
  right: -4rpx;
  width: 36rpx;
  height: 36rpx;
  border-bottom: 3rpx solid #B87333;
  border-right: 3rpx solid #B87333;
  opacity: 0.4;
  pointer-events: none;
}

/* 内侧植物框线 */
.report-body::before {
  content: '';
  position: absolute;
  top: 8rpx; left: 8rpx; right: 8rpx; bottom: 8rpx;
  border: 2rpx solid rgba(122, 139, 111, 0.08);
  pointer-events: none;
}

/* 右上角装饰植物 */
.report-body::after {
  content: '❦';
  position: absolute;
  top: var(--space-md);
  right: var(--space-md);
  font-size: 28rpx;
  color: #7A8B6F;
  opacity: 0.08;
  pointer-events: none;
}

.report-section {
  margin-bottom: var(--space-xxl);
  position: relative;
}

.report-section:last-child {
  margin-bottom: 0;
}

.report-section-title {
  font-size: var(--fs-body);
  font-weight: var(--fw-semibold);
  color: #8B5E3C;
  display: block;
  margin-bottom: var(--space-md);
  letter-spacing: 3rpx;
  position: relative;
  padding-left: var(--space-xl);
  text-transform: uppercase;
}

/* 标题前铜叶 */
.report-section-title::before {
  content: '❧';
  position: absolute;
  left: 0;
  font-size: 20rpx;
  color: #7A8B6F;
  opacity: 0.5;
  top: 50%;
  transform: translateY(-50%);
}

.report-text {
  font-size: var(--fs-body);
  color: #2C1810;
  line-height: var(--lh-loose);
  white-space: pre-wrap;
  letter-spacing: 1rpx;
}

/* 段落首字下沉 — 如古籍装饰首字母 */
.report-text.drop-cap::first-letter {
  font-size: 56rpx;
  font-weight: var(--fw-bold);
  color: #B87333;
  float: left;
  margin-right: 10rpx;
  line-height: 0.9;
  font-family: var(--font-family-display, serif);
  text-shadow: 0 0 8rpx rgba(185, 115, 51, 0.15);
}

/* Stats highlight in report */
.report-stat-highlight {
  display: inline-block;
  font-size: var(--fs-h2);
  font-weight: var(--fw-bold);
  color: #B87333;
  font-family: var(--font-family-display, serif);
  text-shadow: 0 0 12rpx rgba(185, 115, 51, 0.1);
}

.report-stat-label {
  font-size: var(--fs-body-small);
  color: #8C7A6B;
  display: block;
  margin-top: var(--space-xs);
  font-style: italic;
}

/* ---------------------------------------------------------------
   Monthly Sections — 植物章首月度分区
   --------------------------------------------------------------- */
.month-section {
  margin-bottom: var(--space-xxxl);
  position: relative;
  padding-top: var(--space-lg);
}

/* 月度章首装饰 — 铜质分隔 + 植物纹样 */
.month-header {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  margin-bottom: var(--space-xl);
  position: relative;
}

.month-header::before {
  content: '';
  flex: 1;
  height: 2rpx;
  background: linear-gradient(90deg,
    transparent,
    rgba(185, 115, 51, 0.3),
    transparent
  );
}

.month-header::after {
  content: '';
  flex: 1;
  height: 2rpx;
  background: linear-gradient(90deg,
    transparent,
    rgba(185, 115, 51, 0.3),
    transparent
  );
}

.month-label {
  font-size: var(--fs-body-small);
  color: #8B5E3C;
  letter-spacing: 4rpx;
  white-space: nowrap;
  text-transform: uppercase;
  position: relative;
  padding: 0 var(--space-md);
  font-weight: var(--fw-semibold);
}

/* 标签两侧铜叶 */
.month-label::before,
.month-label::after {
  content: '❧';
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  font-size: 18rpx;
  color: #7A8B6F;
  opacity: 0.35;
}
.month-label::before { left: -var(--space-md); }
.month-label::after { right: -var(--space-md); }

/* 月度卡片 */
.month-card {
  padding: var(--space-lg);
  background: #FAF5ED;
  border: 2rpx solid rgba(122, 139, 111, 0.12);
  box-shadow:
    0 0 0 4rpx #FAF5ED,
    0 0 0 6rpx rgba(122, 139, 111, 0.05);
  transition: all var(--duration-normal) var(--ease-out);
  position: relative;
}

/* 每月卡片右上角小植物标记 */
.month-card::before {
  content: '❀';
  position: absolute;
  top: var(--space-xs);
  right: var(--space-xs);
  font-size: 18rpx;
  color: #7A8B6F;
  opacity: 0.15;
}

.month-card:active {
  border-color: rgba(185, 115, 51, 0.2);
  transform: scale(0.98);
  box-shadow:
    0 0 0 4rpx #FAF5ED,
    0 0 0 6rpx rgba(185, 115, 51, 0.1);
}

.month-card-image {
  width: 200rpx;
  height: 280rpx;
  margin-bottom: var(--space-sm);
  box-shadow: 0 4rpx 12rpx rgba(139, 94, 60, 0.08);
}

/* ---------------------------------------------------------------
   Monthly Cards Scroll — 月度卡片长廊
   --------------------------------------------------------------- */
.report-cards-section {
  margin-bottom: var(--space-xxl);
  position: relative;
  padding-top: var(--space-lg);
}

.section-subtitle {
  font-size: var(--fs-body);
  color: #3D2920;
  display: block;
  margin-bottom: var(--space-md);
  text-align: center;
  letter-spacing: 3rpx;
  font-style: italic;
  position: relative;
}

/* 副标题下装饰 */
.section-subtitle::after {
  content: '';
  display: block;
  width: 80rpx;
  height: 1rpx;
  background: #7A8B6F;
  margin: var(--space-sm) auto 0;
  opacity: 0.3;
}

.monthly-cards-scroll {
  white-space: nowrap;
  padding-bottom: var(--space-md);
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.monthly-cards-row {
  display: flex;
  flex-direction: row;
  gap: var(--space-md);
  padding: 0 var(--space-sm);
}

.monthly-card-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  width: 300rpx;
  padding: var(--space-lg) 0;
  background: #FAF5ED;
  border: 2rpx solid rgba(185, 115, 51, 0.1);
  transition: all var(--duration-normal) var(--ease-out);
  box-shadow:
    0 0 0 4rpx #FAF5ED,
    0 0 0 6rpx rgba(185, 115, 51, 0.04),
    0 4rpx 16rpx rgba(139, 94, 60, 0.04);
  position: relative;
}

.monthly-card-item::before {
  content: '❀';
  position: absolute;
  top: var(--space-xs);
  left: var(--space-xs);
  font-size: 16rpx;
  color: #7A8B6F;
  opacity: 0.12;
}

.monthly-card-item:active {
  border-color: rgba(185, 115, 51, 0.25);
  transform: scale(0.96);
  box-shadow:
    0 0 0 4rpx #FAF5ED,
    0 0 0 6rpx rgba(185, 115, 51, 0.1);
}

.monthly-card-image {
  width: 200rpx;
  height: 280rpx;
  margin-bottom: var(--space-sm);
  box-shadow: 0 4rpx 12rpx rgba(139, 94, 60, 0.08);
}

.monthly-card-label {
  font-size: var(--fs-body-small);
  color: #3D2920;
  text-align: center;
  letter-spacing: 2rpx;
}

/* ---------------------------------------------------------------
   Skeleton — 暖色骨架
   --------------------------------------------------------------- */
.skeleton {
  padding: var(--space-xxl) 0;
}

.skeleton-hero-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-md);
  margin-bottom: var(--space-xxxl);
}

.skeleton-icon {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #E8E2D8, #E0DAD0);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-line {
  height: 32rpx;
  background: linear-gradient(135deg, #E8E2D8, #E0DAD0);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}
.skeleton-line.wide { width: 300rpx; }
.skeleton-line.medium { width: 240rpx; }

.skeleton-desc {
  width: 80%;
  height: 80rpx;
  background: linear-gradient(135deg, #E8E2D8, #E0DAD0);
  margin-bottom: var(--space-xxl);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-btn {
  width: 80%;
  height: 88rpx;
  background: linear-gradient(135deg, #E8E2D8, #E0DAD0);
  margin: 0 auto;
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

/* ---------------------------------------------------------------
   Error — 暖色报错
   --------------------------------------------------------------- */
.error-state {
  text-align: center;
  padding: var(--space-massive) var(--space-xl);
}

.error-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: var(--space-md);
  color: #8C7A6B;
  opacity: 0.5;
}

.error-text {
  font-size: var(--fs-body);
  color: #3D2920;
  display: block;
  margin-bottom: var(--space-xs);
}

.error-hint {
  font-size: var(--fs-body-small);
  color: #8C7A6B;
  display: block;
  margin-bottom: var(--space-xxl);
  font-style: italic;
}
