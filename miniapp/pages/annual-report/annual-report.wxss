/* ============================================================
   Annual Report Page — Starlight Design System
   #1A1A3E bg · #F4D48C gold · #B8A9E0 lavender accent
   Celestial calendar aesthetic · Monthly dark cards
   Golden section headers · Deep cosmic indigo
   ============================================================ */

page {
  background: var(--color-bg);
  --color-star-subtle: rgba(244, 212, 140, 0.12);
  --color-text-secondary: var(--color-text-secondary);
  --color-text-primary: var(--color-text-primary);
  /* Inline style compat aliases */
  --space-massive: var(--spacing-5xl);
  --space-xxxl: var(--spacing-3xl);
  --space-xxl: var(--spacing-2xl);
  --space-xl: var(--spacing-xl);
  --space-lg: var(--spacing-lg);
  --space-md: var(--spacing-md);
  --space-sm: var(--spacing-sm);
  --space-xs: var(--spacing-xs);
  --fs-h3: var(--font-size-title);
  --fs-h4: var(--font-size-subhead);
  --fs-body: var(--font-size-body);
  --fs-body-small: var(--font-size-caption);
  --fs-caption: var(--font-size-xs);
  --lh-loose: var(--line-height-loose);
  --lh-normal: var(--line-height-base);
  --fw-semibold: var(--font-weight-semibold);
  --fw-bold: var(--font-weight-bold);
  --fw-medium: var(--font-weight-medium);
  --duration-normal: var(--duration-base);
  --duration-fast: var(--duration-fast);
  --ease-out: var(--ease-out);
  --ease-in-out: var(--ease-in-out);
}

/* ============================================================
   Container
   ============================================================ */
.container {
  padding: var(--spacing-xl);
  padding-bottom: calc(var(--safe-area-bottom) + var(--spacing-5xl));
  min-height: 100vh;
  position: relative;
  z-index: 1;
}

/* ============================================================
   Gold / Lavender utilities
   ============================================================ */
.gold {
  color: var(--color-gold);
}
.lavender {
  color: #B8A9E0;
}

/* ============================================================
   Text helpers
   ============================================================ */
.text-dim {
  color: var(--color-text-secondary);
  font-size: var(--font-size-caption);
}

.text-secondary {
  color: var(--color-text-secondary);
  font-size: var(--font-size-body);
}

.text-body {
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  line-height: var(--line-height-base);
}

/* ============================================================
   INTRO — Preamble before generation
   ============================================================ */
.intro {
  text-align: center;
  padding: var(--spacing-5xl) var(--spacing-xl) var(--spacing-2xl);
}

.heading-1 {
  font-size: var(--font-size-display);
  font-weight: var(--font-weight-bold);
  color: var(--color-gold);
  text-align: center;
  letter-spacing: 2rpx;
}

/* ============================================================
   Generate Button — Golden pill
   ============================================================ */
.btn-glow-pulse {
  width: 80%;
  margin: var(--spacing-xl) auto 0;
  background: linear-gradient(135deg, #F4D48C 0%, #E8C67A 50%, #D4B06A 100%);
  color: var(--color-text-inverse);
  font-size: var(--font-size-subhead);
  font-weight: var(--font-weight-semibold);
  border-radius: var(--radius-pill);
  padding: 28rpx 0;
  border: none;
  box-shadow: var(--shadow-gold-button);
  letter-spacing: 2rpx;
  transition: all var(--duration-base);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: glow-pulse 2.5s ease-in-out infinite;
}

.btn-glow-pulse:active {
  transform: scale(0.96);
  opacity: 0.90;
  box-shadow: 0 2rpx 12rpx rgba(244, 212, 140, 0.20);
}

@keyframes glow-pulse {
  0%, 100% { box-shadow: 0 0 10rpx rgba(244, 212, 140, 0.08), var(--shadow-gold-button); }
  50% { box-shadow: 0 0 30rpx rgba(244, 212, 140, 0.20), var(--shadow-gold-button); }
}

/* Secondary button (outline) */
.btn-secondary {
  width: 80%;
  background: transparent;
  border: 1rpx solid rgba(244, 212, 140, 0.20);
  color: var(--color-text-secondary);
  font-size: var(--font-size-body);
  border-radius: var(--radius-pill);
  padding: 24rpx 0;
  letter-spacing: 1rpx;
  transition: all var(--duration-base);
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-secondary:active {
  border-color: rgba(244, 212, 140, 0.40);
  color: var(--color-gold);
  background: rgba(244, 212, 140, 0.04);
}

/* ============================================================
   Mystic Loading
   ============================================================ */
.mystic-loading {
  text-align: center;
  padding: var(--spacing-5xl) var(--spacing-xl);
}

.mystic-loading-symbol {
  font-size: calc(var(--font-size-display) + 16rpx);
  display: block;
  margin-bottom: var(--spacing-xl);
  opacity: 0.80;
  animation: mystic-rotate 3s ease-in-out infinite;
}

@keyframes mystic-rotate {
  0%, 100% { transform: rotate(0deg) scale(1); opacity: 0.70; }
  50% { transform: rotate(180deg) scale(1.10); opacity: 1; }
}

.mystic-loading-title {
  font-size: var(--font-size-subhead);
  color: var(--color-text-primary);
  font-weight: var(--font-weight-semibold);
  display: block;
  margin-bottom: var(--spacing-sm);
  letter-spacing: 2rpx;
}

.mystic-loading-sub {
  font-size: var(--font-size-body);
  color: var(--color-text-tertiary);
  display: block;
}

/* ============================================================
   REPORT — Main report body
   ============================================================ */
.report {
  padding: var(--spacing-lg) 0;
}

/* Golden section title (centered) */
.section-title-center {
  font-size: var(--font-size-title);
  color: var(--color-gold);
  font-weight: var(--font-weight-bold);
  display: block;
  text-align: center;
  margin-bottom: var(--spacing-2xl);
  letter-spacing: 2rpx;
  text-shadow: 0 0 20rpx rgba(244, 212, 140, 0.08);
}

/* ============================================================
   MONTHLY CARDS — Dark indigo, golden month labels
   ============================================================ */
.report-cards-section {
  margin-bottom: var(--spacing-2xl);
}

.section-subtitle {
  font-size: var(--font-size-body);
  color: var(--color-gold);
  font-weight: var(--font-weight-medium);
  display: block;
  margin-bottom: var(--spacing-lg);
  text-align: center;
  letter-spacing: 2rpx;
}

.monthly-cards-scroll {
  white-space: nowrap;
  padding-bottom: var(--spacing-md);
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.monthly-cards-row {
  display: flex;
  flex-direction: row;
  gap: var(--spacing-md);
  padding: 0 var(--spacing-sm);
}

/* Individual month card */
.monthly-card-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  width: 300rpx;
  padding: var(--spacing-lg) var(--spacing-md);
  border-radius: var(--radius-lg);
  background: var(--color-card);
  border: 1rpx solid var(--color-card-border);
  transition: all var(--duration-base) var(--ease-soft);
  box-shadow: var(--shadow-card);
  position: relative;
  overflow: hidden;
}

/* Starlight accent glow */
.monthly-card-item::before {
  content: '';
  position: absolute;
  top: -60rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 200rpx;
  height: 120rpx;
  background: radial-gradient(circle, rgba(244, 212, 140, 0.06) 0%, transparent 70%);
  pointer-events: none;
}

.monthly-card-item:active {
  transform: translateY(-6rpx);
  border-color: var(--color-card-border-hover);
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.30), 0 0 60rpx rgba(244, 212, 140, 0.06);
}

/* Month label — golden */
.month-label {
  font-size: var(--font-size-caption);
  color: var(--color-gold);
  text-align: center;
  margin-top: var(--spacing-sm);
  letter-spacing: 2rpx;
  font-weight: var(--font-weight-medium);
}

/* ============================================================
   REPORT BODY — Dark card with report text
   ============================================================ */
.report-body {
  border-radius: var(--radius-xl);
  padding: var(--spacing-2xl);
  margin-bottom: var(--spacing-xl);
  position: relative;
  overflow: hidden;
  background: var(--color-card);
  border: 1rpx solid var(--color-card-border);
  box-shadow: var(--shadow-card);
}

/* Golden top rim glow */
.report-body::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2rpx;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(244, 212, 140, 0.20) 30%,
    rgba(244, 212, 140, 0.35) 50%,
    rgba(244, 212, 140, 0.20) 70%,
    transparent 100%
  );
  pointer-events: none;
}

.report-text {
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  line-height: var(--line-height-loose);
  white-space: pre-wrap;
  letter-spacing: 1rpx;
}

/* Buttons via common.wxss: .btn-primary, .btn--sm, .btn--full */

/* ============================================================
   Error State
   ============================================================ */
.error-state {
  text-align: center;
  padding: var(--spacing-5xl) var(--spacing-xl);
}

.error-icon {
  font-size: calc(var(--font-size-display) + 24rpx);
  display: block;
  margin-bottom: var(--spacing-md);
  opacity: 0.50;
}

.error-text {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--spacing-xs);
}

.error-hint {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  display: block;
  margin-bottom: var(--spacing-2xl);
}

.btn-small {
  font-size: var(--font-size-caption);
  padding: 16rpx 36rpx;
}

/* ============================================================
   SKELETON — Shapes only (shimmer from common.wxss)
   ============================================================ */
.skeleton-ar-wrap {
  padding: var(--spacing-2xl) 0;
}

.skeleton-hero-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-md);
  margin-bottom: var(--spacing-3xl);
}

.skeleton-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-full);
}

.skeleton-line {
  height: 32rpx;
  border-radius: var(--radius-sm);
}

.skeleton-line.wide { width: 300rpx; }
.skeleton-line.medium { width: 240rpx; }

.skeleton-desc {
  width: 80%;
  height: 80rpx;
  border-radius: var(--radius-sm);
  margin-bottom: var(--spacing-2xl);
}

.skeleton-btn {
  width: 80%;
  height: 88rpx;
  border-radius: var(--radius-pill);
  margin: 0 auto;
}

/* ============================================================
   Entrance animations
   ============================================================ */
.anim-fade-in-up-1 { opacity: 0; animation: fade-up 0.5s var(--ease-soft) 0.08s forwards; }
.anim-fade-in-up-2 { opacity: 0; animation: fade-up 0.5s var(--ease-soft) 0.23s forwards; }
.anim-fade-in-up-3 { opacity: 0; animation: fade-up 0.5s var(--ease-soft) 0.38s forwards; }
.anim-fade-in-up-4 { opacity: 0; animation: fade-up 0.5s var(--ease-soft) 0.53s forwards; }
.anim-fade-in-up-5 { opacity: 0; animation: fade-up 0.5s var(--ease-soft) 0.68s forwards; }

/* ================================================================
   New Annual Report Styles
   ================================================================ */
.ar-intro {
  text-align: center;
  padding: 80rpx 48rpx;
}
.ar-intro-icon { font-size: 80rpx; display: block; margin-bottom: 24rpx; }
.ar-intro-title { font-size: var(--font-size-display); font-weight: 700; color: var(--color-gold); display: block; letter-spacing: 3rpx; }
.ar-intro-desc { font-size: var(--font-size-caption); color: var(--color-text-tertiary); display: block; margin: 24rpx 0 40rpx; line-height: 1.8; padding: 0 16rpx; }

.ar-preview-cards {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
  margin-bottom: 48rpx;
}
.ar-preview-card {
  width: 100rpx;
  text-align: center;
}
.ar-preview-card-inner {
  width: 88rpx; height: 120rpx;
  background: var(--color-surface);
  border: 1rpx solid rgba(244,212,140,0.12);
  border-radius: 12rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx;
}
.ar-preview-month { font-size: 20rpx; color: var(--color-text-tertiary); margin-top: 6rpx; display: block; }

.ar-gen-btn {
  width: 80%; margin: 0 auto;
  background: linear-gradient(135deg, #F4D48C, #E8C67A);
  color: #1A1A3E; font-weight: 700; font-size: var(--font-size-body);
  border-radius: 50rpx; padding: 28rpx 0; border: none; letter-spacing: 2rpx;
}
.ar-buy-btn {
  width: 80%; margin: 20rpx auto 0;
  background: transparent; color: var(--color-text-tertiary);
  font-size: var(--font-size-caption); border-radius: 50rpx;
  padding: 20rpx 0; border: 1rpx solid rgba(244,212,140,0.15);
}
.ar-intro-note { font-size: 20rpx; color: var(--color-text-tertiary); opacity: 0.5; display: block; margin-top: 24rpx; }

/* Generating */
.ar-generating { text-align: center; padding: 160rpx 48rpx; }
.ar-gen-orb { position: relative; width: 160rpx; height: 160rpx; margin: 0 auto 40rpx; }
.ar-gen-ring {
  position: absolute; inset: 0; border-radius: 50%;
  border: 3rpx solid rgba(244,212,140,0.2);
  border-top-color: var(--color-gold);
  animation: ar-spin 1.5s linear infinite;
}
@keyframes ar-spin { to { transform: rotate(360deg); } }
.ar-gen-icon { font-size: 64rpx; line-height: 160rpx; }
.ar-gen-title { font-size: var(--font-size-subhead); color: var(--color-gold); display: block; font-weight: 600; }
.ar-gen-sub { font-size: var(--font-size-caption); color: var(--color-text-tertiary); margin-top: 12rpx; display: block; }

/* Report */
.ar-report { padding: 40rpx 32rpx 120rpx; }
.ar-header { text-align: center; margin-bottom: 40rpx; }
.ar-year { font-size: 100rpx; font-weight: 900; color: rgba(244,212,140,0.08); display: block; line-height: 1; }
.ar-title { font-size: var(--font-size-title); font-weight: 700; color: var(--color-gold); display: block; margin: -20rpx 0 8rpx; }
.ar-date { font-size: var(--font-size-xs); color: var(--color-text-tertiary); }

/* Stats */
.ar-stats { display: flex; gap: 16rpx; margin-bottom: 40rpx; }
.ar-stat {
  flex: 1; text-align: center; background: var(--color-surface-gradient);
  border: 1rpx solid rgba(244,212,140,0.08); border-radius: 16rpx; padding: 28rpx 8rpx;
}
.ar-stat-num { font-size: var(--font-size-title); font-weight: 800; color: var(--color-gold); display: block; }
.ar-stat-label { font-size: 20rpx; color: var(--color-text-tertiary); margin-top: 6rpx; display: block; }

/* Section title */
.ar-section-title { font-size: var(--font-size-subhead); font-weight: 600; color: var(--color-text-primary); display: block; margin-bottom: 20rpx; }

/* Monthly scroll */
.ar-monthly { margin-bottom: 40rpx; }
.ar-monthly-scroll { width: 100%; white-space: nowrap; }
.ar-monthly-row { display: inline-flex; gap: 20rpx; padding: 8rpx 0; }
.ar-month-card { width: 200rpx; flex-shrink: 0; }

/* Report text */
.ar-text-card { background: var(--color-surface-gradient); border: 1rpx solid rgba(244,212,140,0.08); border-radius: 16rpx; padding: 32rpx; }
.ar-text { font-size: var(--font-size-body); color: var(--color-text-secondary); line-height: 2; white-space: pre-wrap; }

/* Actions */
.ar-actions { display: flex; flex-direction: column; gap: 16rpx; margin-top: 40rpx; }
.ar-share-btn { background: linear-gradient(135deg, #F4D48C, #E8C67A); color: #1A1A3E; font-weight: 700; border-radius: 50rpx; padding: 24rpx 0; border: none; }
.ar-redo-btn { background: transparent; color: var(--color-text-tertiary); border-radius: 50rpx; padding: 20rpx 0; border: 1rpx solid rgba(244,212,140,0.12); }
