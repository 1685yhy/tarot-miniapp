}
.screen-0-divider {
  background: linear-gradient(90deg, transparent, #C9A97C, transparent);
}
.screen-0-title {
  color: rgba(61, 58, 54, 0.55);
  font-family: var(--e3-serif);
}
.screen-0-subtitle {
  font-family: var(--e3-serif);
  font-weight: 500;
  color: var(--e3-ink);
  letter-spacing: 10rpx;
  text-shadow: 0 0 40rpx rgba(201, 169, 124, 0.20);
}
.screen-0-sparkle {
  color: #C9A97C;
}
.screen-0-hint {
  color: var(--e3-ink-faint);
  font-family: var(--e3-serif);
  letter-spacing: 4rpx;
}

/* ================================================================
   SCREEN 1 — Big number
   ================================================================ */
.screen-bg-glow {
  background: radial-gradient(circle, rgba(232, 196, 190, 0.22) 0%, transparent 60%);
}
.screen-1-label {
  color: var(--e3-ink-soft);
  font-family: var(--e3-serif);
  letter-spacing: 4rpx;
}
.screen-1-number {
  font-family: var(--e3-serif);
  color: var(--e3-gold-deep);
  text-shadow: 0 0 80rpx rgba(201, 169, 124, 0.25);
}
.screen-1-unit {
  color: var(--e3-gold-deep);
  font-family: var(--e3-serif);
}
.screen-1-sub {
  color: var(--e3-ink-soft);
}
.sparkle-particle {
  background: #C9A97C;
}

/* ================================================================
   SCREEN 2 — Top theme（图表色板 → E3 细金/奶油/灰紫）
   ================================================================ */
.screen-2-label {
  color: var(--e3-ink-soft);
  font-family: var(--e3-serif);
  letter-spacing: 4rpx;
}
.screen-2-theme-text {
  font-family: var(--e3-serif);
  font-weight: 500;
  color: var(--e3-ink);
  letter-spacing: 6rpx;
}
.screen-2-mini-bar-label {
  color: var(--e3-ink-soft);
  font-family: var(--e3-serif);
}
.screen-2-mini-bar-track {
  background: rgba(216, 210, 228, 0.35);
}
.screen-2-mini-bar-fill {
  background: linear-gradient(90deg, rgba(201, 169, 124, 0.45), #C9A97C);
}
.screen-2-mini-bar-count {
  color: var(--e3-gold-deep);
}

/* ================================================================
   SCREEN 3 — Annual card（卡框深紫 → 奶油）
   ================================================================ */
.screen-bg-card-glow {
  background: radial-gradient(circle, rgba(232, 196, 190, 0.20) 0%, transparent 60%);
}
.screen-3-label {
  color: var(--e3-ink-soft);
  font-family: var(--e3-serif);
  letter-spacing: 4rpx;
}
.screen-3-card-glow-ring {
  border-color: rgba(201, 169, 124, 0.28);
}
@keyframes card-glow-pulse-e3 {
  0%, 100% { box-shadow: 0 0 20rpx rgba(201, 169, 124, 0.10); }
  50% { box-shadow: 0 0 60rpx rgba(201, 169, 124, 0.22); }
}
.screen-3-card-glow-ring {
  animation: card-glow-pulse-e3 3s ease-in-out infinite;
}
.screen-3-card-frame {
  background: var(--e3-cream-hi);
  border: 2rpx solid rgba(201, 169, 124, 0.35);
  box-shadow: 0 8rpx 40rpx rgba(61, 58, 54, 0.16), var(--e3-hi);
}
.screen-3-card-placeholder-inner {
  background: rgba(232, 196, 190, 0.18);
  border: 1rpx dashed rgba(201, 169, 124, 0.35);
}
.screen-3-card-fallback {
  background: linear-gradient(150deg, var(--e3-cream-hi) 0%, var(--e3-paper) 100%) !important;
}
.screen-3-card-placeholder-name {
  color: var(--e3-ink);
  font-family: var(--e3-serif);
  background: rgba(255, 253, 248, 0.9);
  border: 1rpx solid var(--e3-line);
  text-shadow: none;
}
.screen-3-card-name {
  font-family: var(--e3-serif);
  font-weight: 500;
  color: var(--e3-ink);
  letter-spacing: 6rpx;
}
.screen-3-card-meaning {
  color: var(--e3-ink-soft);
  font-family: var(--e3-serif);
  line-height: 2;
}
.screen-3-card-keyword {
  color: var(--e3-gold-deep);
  font-family: var(--e3-serif);
  letter-spacing: 6rpx;
}

/* ================================================================
   SCREEN 4 — Personality（数据卡 → 奶油底）
   ================================================================ */
.screen-4-label {
  color: var(--e3-ink-soft);
  font-family: var(--e3-serif);
  letter-spacing: 4rpx;
}
.screen-4-archetype-badge {
  background: linear-gradient(135deg, rgba(232, 196, 190, 0.30), rgba(216, 210, 228, 0.25));
  border: 1rpx solid rgba(201, 169, 124, 0.30);
}
.screen-4-archetype-icon {
  color: var(--e3-gold-deep);
}
.screen-4-archetype-name {
  font-family: var(--e3-serif);
  font-weight: 500;
  color: var(--e3-ink);
  letter-spacing: 6rpx;
}
.screen-4-desc {
  color: var(--e3-ink-soft);
  font-family: var(--e3-serif);
  line-height: 2;
}
.screen-4-insight {
  color: var(--color-lavender-deep);
  font-family: var(--e3-serif);
  border-left: 2rpx solid rgba(216, 210, 228, 0.6);
}
.screen-4-stat {
  background: var(--e3-cream-hi);
  border: 1rpx solid var(--e3-line);
  border-radius: 20rpx;
  box-shadow: var(--e3-shadow), var(--e3-hi);
}
.screen-4-stat-num {
  font-family: var(--e3-serif);
  font-weight: 500;
  color: var(--e3-gold-deep);
  letter-spacing: 2rpx;
}
.screen-4-stat-label {
  color: var(--e3-ink-soft);
  font-family: var(--e3-serif);
  letter-spacing: 2rpx;
}
.screen-4-stat-sub {
  color: var(--e3-ink-faint);
}

/* ================================================================
   SCREEN 5 — Monthly chart（柱状图 → E3 细金/灰紫/雾粉）
   ================================================================ */
.screen-5-label {
  color: var(--e3-ink-soft);
  font-family: var(--e3-serif);
  letter-spacing: 4rpx;
}
.screen-5-sub {
  color: var(--e3-ink-faint);
  font-family: var(--e3-serif);
  letter-spacing: 2rpx;
}
.screen-5-bar-fill {
  background: linear-gradient(180deg, #C9A97C, rgba(201, 169, 124, 0.35));
}
.screen-5-bar-empty {
  background: rgba(216, 210, 228, 0.30);
}
.screen-5-bar-count {
  color: var(--e3-gold-deep);
  font-family: var(--e3-serif);
}
.screen-5-bar-label {
  color: var(--e3-ink-soft);
  font-family: var(--e3-serif);
}
.screen-5-mood-title {
  color: var(--e3-ink-soft);
  font-family: var(--e3-serif);
  letter-spacing: 3rpx;
}
.screen-5-mood-dot {
  background: rgba(216, 210, 228, 0.45);
}
.mood-happy { background: #C9A97C; box-shadow: 0 0 10rpx rgba(201, 169, 124, 0.35); }
.mood-calm { background: #D8D2E4; box-shadow: 0 0 10rpx rgba(216, 210, 228, 0.40); }
.mood-gloomy { background: #E8C4BE; box-shadow: 0 0 10rpx rgba(232, 196, 190, 0.40); }
.mood-down { background: #B08A82; box-shadow: 0 0 10rpx rgba(176, 138, 130, 0.35); }

/* ================================================================
   SCREEN 6 — Blessing
   ================================================================ */
.screen-blessing-bg {
  background: radial-gradient(ellipse at 50% 30%, rgba(232, 196, 190, 0.22) 0%, transparent 60%);
}
.blessing-star {
  background: #C9A97C;
  box-shadow: 0 0 8rpx rgba(201, 169, 124, 0.3);
}
.screen-6-quote-mark {
  color: rgba(201, 169, 124, 0.25);
  font-family: var(--e3-serif);
}
.screen-6-blessing-line {
  font-family: var(--e3-serif);
  font-weight: 500;
  color: var(--e3-gold-deep);
  letter-spacing: 4rpx;
  text-shadow: 0 0 40rpx rgba(201, 169, 124, 0.15);
}
.screen-6-signature {
  color: var(--e3-ink-faint);
  font-family: var(--e3-serif);
  letter-spacing: 3rpx;
}

/* ================================================================
   SCREEN 7 — Share
   ================================================================ */
.screen-7-title {
  font-family: var(--e3-serif);
  font-weight: 500;
  color: var(--e3-ink);
  letter-spacing: 6rpx;
}
.screen-7-desc {
  color: var(--e3-ink-soft);
  font-family: var(--e3-serif);
  letter-spacing: 2rpx;
}
.screen-7-poster-preview {
  background: var(--e3-cream-hi);
  border: 1rpx solid var(--e3-line);
  border-radius: 20rpx;
  box-shadow: var(--e3-shadow), var(--e3-hi);
}
.screen-7-poster-preview:active {
  border-color: var(--e3-line-soft);
}
.screen-7-poster-text {
  color: var(--e3-ink-soft);
  font-family: var(--e3-serif);
  letter-spacing: 2rpx;
}
.screen-7-btn--moments {
  background: var(--e3-gold-btn);
  color: #FAF6EF;
  box-shadow: 0 4rpx 20rpx rgba(201, 169, 124, 0.25), var(--e3-hi);
  font-family: var(--e3-serif);
  letter-spacing: 2rpx;
}
.screen-7-btn--save {
  background: var(--e3-cream-hi);
  color: var(--e3-ink-soft);
  border: 1rpx solid var(--e3-line);
  box-shadow: var(--e3-shadow);
  font-family: var(--e3-serif);
  letter-spacing: 2rpx;
}
.screen-7-recap-num {
  font-family: var(--e3-serif);
  font-weight: 500;
  color: var(--e3-gold-deep);
  letter-spacing: 2rpx;
}
.screen-7-recap-label {
  color: var(--e3-ink-soft);
  font-family: var(--e3-serif);
  letter-spacing: 2rpx;
}
.screen-7-recap-divider {
  background: rgba(201, 169, 124, 0.25);
}
.screen-7-redo {
  color: var(--e3-ink-soft);
  border: 1rpx solid var(--e3-line);
  background: var(--e3-cream-hi);
  font-family: var(--e3-serif);
  letter-spacing: 2rpx;
}

/* ================================================================
   Poster modal — 深靛蓝 → 奶油
   ================================================================ */
.poster-modal {
  background: linear-gradient(180deg, #FFFDF8 0%, #F7F0E3 100%);
  border-top: 1rpx solid var(--e3-line-soft);
}
.poster-title {
  font-family: var(--e3-serif);
  font-weight: 500;
  color: var(--e3-ink);
  letter-spacing: 4rpx;
}
.poster-close {
  background: rgba(232, 196, 190, 0.30);
  border: 1rpx solid rgba(201, 169, 124, 0.25);
}
.poster-close-icon {
  color: var(--e3-pink-ink);
}
.poster-loading {
  color: var(--e3-ink-soft);
  font-family: var(--e3-serif);
}
.poster-loading-spinner {
  border: 3rpx solid rgba(201, 169, 124, 0.15);
  border-top-color: #C9A97C;
}
.poster-save-btn {
  background: var(--e3-gold-btn);
  color: #FAF6EF;
  box-shadow: 0 4rpx 20rpx rgba(201, 169, 124, 0.25), var(--e3-hi);
  font-family: var(--e3-serif);
  font-weight: 500;
  letter-spacing: 3rpx;
}
.poster-save-btn[disabled] {
  opacity: 0.3;
  background: rgba(201, 169, 124, 0.18);
  color: var(--e3-ink-faint);
}

/* —— 减动效兼容：新增 E3 动画一并收敛 —— */
@media (prefers-reduced-motion: reduce) {
  .screen-3-card-glow-ring { animation: none !important; }
}

/* —— 补遗漏：retry 按钮 / poster 遮罩（E3 统一） —— */
.wrapped-retry-btn {
  background: var(--e3-gold-btn);
  color: #FAF6EF;
  box-shadow: 0 4rpx 20rpx rgba(201, 169, 124, 0.25), var(--e3-hi);
  font-family: var(--e3-serif);
  font-weight: 500;
  letter-spacing: 3rpx;
}
.poster-overlay {
  background: rgba(61, 58, 54, 0.55);
}

/* ================================================================
   P4-2：非会员价格锚点前置 — 会员权益说明卡
   ================================================================ */
.pre-benefit-card {
  width: 80%;
  background: linear-gradient(145deg, #FFFDF8 0%, #F2ECDF 100%);
  border: 1rpx solid var(--e3-line);
  border-radius: 24rpx;
  padding: 28rpx 36rpx;
  margin-bottom: 44rpx;
  box-shadow: var(--e3-shadow), var(--e3-hi);
  position: relative;
  z-index: 1;
}

.pre-benefit-title {
  display: block;
  font-family: var(--e3-serif);
  font-weight: 500;
  font-size: 32rpx;
  color: var(--e3-gold-deep);
  letter-spacing: 4rpx;
  margin-bottom: 8rpx;
}

.pre-benefit-sub {
  display: block;
  font-size: 24rpx;
  color: var(--e3-ink-soft);
  letter-spacing: 2rpx;
  line-height: 1.6;
}

/* ================================================================
   P4-2：8 屏进度计数 — 每屏底部「3/8」小进度字
   ================================================================ */
.wrapped-counter {
  position: fixed;
  bottom: calc(env(safe-area-inset-bottom) + 20rpx);
  left: 0;
  right: 0;
  text-align: center;
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: var(--e3-ink-faint);
  font-family: var(--e3-serif);
  z-index: 100;
  pointer-events: none;
}
