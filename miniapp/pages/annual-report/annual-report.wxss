/* ============================================================
   Annual Report — Warm Paper Design System
   Warm ivory base, deep rose accent, sage subtle
   Monthly card scroll, report body, intro section
   ============================================================ */

/* -----------------------------------------------------------
   1. CONTAINER
   ----------------------------------------------------------- */

.container {
  padding: var(--page-padding);
  padding-bottom: calc(var(--page-padding) + var(--safe-area-bottom));
  min-height: 100vh;
  position: relative;
  z-index: var(--z-base);
}

/* -----------------------------------------------------------
   2. COLOR UTILITIES
   ----------------------------------------------------------- */

.accent {
  color: var(--color-accent);
}

.subtle {
  color: var(--color-subtle);
}

/* -----------------------------------------------------------
   3. TEXT HELPERS
   ----------------------------------------------------------- */

.text-dim {
  color: var(--color-text-secondary);
  font-size: var(--font-size-body);
}

.text-secondary {
  color: var(--color-text-secondary);
  font-size: var(--font-size-body);
}

.text-body {
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  line-height: var(--line-height-body);
}

/* -----------------------------------------------------------
   4. INTRO
   ----------------------------------------------------------- */

.intro {
  text-align: center;
  padding: var(--spacing-8) var(--spacing-6) var(--spacing-6);
}

.heading-1 {
  font-size: var(--font-size-display);
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
  text-align: center;
  letter-spacing: var(--letter-spacing-display);
  line-height: var(--line-height-heading);
}

/* -----------------------------------------------------------
   5. GENERATE BUTTON
   ----------------------------------------------------------- */

.btn-glow-pulse {
  width: 80%;
  margin: var(--spacing-6) auto 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-accent);
  color: var(--color-surface);
  font-size: var(--font-size-body-large);
  font-weight: var(--font-weight-semibold);
  border-radius: var(--radius-pill);
  padding: var(--spacing-5) 0;
  border: none;
  box-shadow: var(--shadow-subtle);
  letter-spacing: var(--letter-spacing-none);
  transition: all var(--duration-navigation) ease;
}

.btn-glow-pulse:active {
  transform: scale(0.97);
  opacity: 0.90;
  box-shadow: var(--shadow-subtle);
}

.btn-glow-pulse[disabled] {
  opacity: 0.30;
  box-shadow: none;
  pointer-events: none;
}

/* Secondary button (outline) */
.btn-secondary {
  width: 80%;
  margin: var(--spacing-4) auto 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: 1rpx solid rgba(176, 102, 80, 0.20);
  color: var(--color-text-secondary);
  font-size: var(--font-size-body);
  border-radius: var(--radius-pill);
  padding: var(--spacing-5) 0;
  letter-spacing: var(--letter-spacing-none);
  transition: all var(--duration-navigation) ease;
}

.btn-secondary:active {
  border-color: var(--color-accent);
  color: var(--color-accent);
  background: rgba(176, 102, 80, 0.04);
}

/* -----------------------------------------------------------
   6. MYSTIC LOADING
   ----------------------------------------------------------- */

.mystic-loading {
  text-align: center;
  padding: var(--spacing-8) var(--spacing-6);
}

.mystic-loading-symbol {
  width: 72rpx;
  height: 72rpx;
  display: block;
  margin: 0 auto var(--spacing-6);
  opacity: 0.60;
}

.mystic-loading-title {
  font-size: var(--font-size-body-large);
  color: var(--color-text-primary);
  font-weight: var(--font-weight-semibold);
  display: block;
  margin-bottom: var(--spacing-3);
  letter-spacing: var(--letter-spacing-none);
}

.mystic-loading-sub {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  display: block;
  opacity: 0.70;
}

/* -----------------------------------------------------------
   7. REPORT BODY
   ----------------------------------------------------------- */

.report {
  padding: var(--spacing-5) 0;
}

.section-title-center {
  font-size: var(--font-size-subhead);
  color: var(--color-text-primary);
  font-weight: var(--font-weight-bold);
  display: block;
  text-align: center;
  margin-bottom: var(--spacing-6);
  letter-spacing: var(--letter-spacing-none);
}

/* -----------------------------------------------------------
   8. MONTHLY CARDS
   ----------------------------------------------------------- */

.report-cards-section {
  margin-bottom: var(--spacing-6);
}

.section-subtitle {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  font-weight: var(--font-weight-medium);
  display: block;
  margin-bottom: var(--spacing-5);
  text-align: center;
  letter-spacing: var(--letter-spacing-none);
}

.monthly-cards-scroll {
  white-space: nowrap;
  padding-bottom: var(--spacing-4);
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.monthly-cards-row {
  display: flex;
  flex-direction: row;
  gap: var(--spacing-4);
  padding: 0 var(--spacing-3);
}

.monthly-card-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  width: 300rpx;
  padding: var(--spacing-5) var(--spacing-4);
  border-radius: var(--radius-medium);
  background: var(--color-surface);
  border: 1rpx solid rgba(139, 126, 110, 0.12);
  transition: all var(--duration-navigation) ease;
  box-shadow: var(--shadow-subtle);
  position: relative;
  overflow: hidden;
}

.monthly-card-item:active {
  border-color: rgba(176, 102, 80, 0.20);
  box-shadow: var(--shadow-medium);
  transform: translateY(-2rpx);
}

.month-label {
  font-size: var(--font-size-body);
  color: var(--color-accent);
  text-align: center;
  margin-top: var(--spacing-3);
  letter-spacing: var(--letter-spacing-none);
  font-weight: var(--font-weight-medium);
}

/* -----------------------------------------------------------
   9. REPORT TEXT BODY
   ----------------------------------------------------------- */

.report-body {
  border-radius: var(--radius-medium);
  padding: var(--spacing-6);
  margin-bottom: var(--spacing-6);
  position: relative;
  overflow: hidden;
  background: var(--color-surface);
  border: 1rpx solid rgba(139, 126, 110, 0.12);
  box-shadow: var(--shadow-subtle);
}

/* Top accent rim */
.report-body::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2rpx;
  background: rgba(139, 126, 110, 0.15);
  pointer-events: none;
}

.report-text {
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  line-height: var(--line-height-body);
  white-space: pre-wrap;
  letter-spacing: var(--letter-spacing-none);
}

/* -----------------------------------------------------------
   10. PRIMARY BUTTON (share / actions)
   ----------------------------------------------------------- */

.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-accent);
  color: var(--color-surface);
  border: none;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-semibold);
  border-radius: var(--radius-pill);
  padding: var(--spacing-5) var(--spacing-7);
  box-shadow: var(--shadow-subtle);
  transition: all var(--duration-navigation) ease;
  width: 100%;
}

.btn-primary:active {
  transform: scale(0.97);
  opacity: 0.90;
  box-shadow: var(--shadow-subtle);
}

/* -----------------------------------------------------------
   11. ERROR STATE
   ----------------------------------------------------------- */

.error-state {
  text-align: center;
  padding: var(--spacing-8) var(--spacing-6);
}

.error-icon {
  width: 80rpx;
  height: 80rpx;
  display: block;
  margin: 0 auto var(--spacing-5);
  opacity: 0.30;
}

.error-text {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--spacing-3);
}

.error-hint {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--spacing-6);
  opacity: 0.70;
}

.btn-small {
  font-size: var(--font-size-body);
  padding: var(--spacing-4) var(--spacing-6);
}

/* -----------------------------------------------------------
   12. SKELETON
   ----------------------------------------------------------- */

.skeleton {
  padding: var(--spacing-6) 0;
}

.skeleton-hero-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-4);
  margin-bottom: var(--spacing-7);
}

.skeleton-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-pill);
  background: rgba(139, 126, 110, 0.08);
  animation: pulse-soft 1500ms ease-in-out infinite;
}

.skeleton-line {
  height: 32rpx;
  border-radius: var(--radius-small);
  background: rgba(139, 126, 110, 0.08);
  animation: pulse-soft 1500ms ease-in-out infinite;
}

.skeleton-line.wide { width: 300rpx; }
.skeleton-line.medium { width: 240rpx; }

.skeleton-desc {
  width: 80%;
  height: 80rpx;
  border-radius: var(--radius-small);
  background: rgba(139, 126, 110, 0.08);
  margin-bottom: var(--spacing-6);
  animation: pulse-soft 1500ms ease-in-out infinite;
}

.skeleton-btn {
  width: 80%;
  height: 88rpx;
  border-radius: var(--radius-pill);
  background: rgba(139, 126, 110, 0.08);
  margin: 0 auto;
  animation: pulse-soft 1500ms ease-in-out infinite;
}

/* -----------------------------------------------------------
   13. ENTRANCE ANIMATIONS
   ----------------------------------------------------------- */

.anim-fade-in-up-1 { opacity: 0; animation: fade-up var(--duration-emphasis) ease 0.08s forwards; }
.anim-fade-in-up-2 { opacity: 0; animation: fade-up var(--duration-emphasis) ease 0.23s forwards; }
.anim-fade-in-up-3 { opacity: 0; animation: fade-up var(--duration-emphasis) ease 0.38s forwards; }
.anim-fade-in-up-4 { opacity: 0; animation: fade-up var(--duration-emphasis) ease 0.53s forwards; }
.anim-fade-in-up-5 { opacity: 0; animation: fade-up var(--duration-emphasis) ease 0.68s forwards; }
