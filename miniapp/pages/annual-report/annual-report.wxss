/* ============================================================
   Annual Report Page — Starlight Design System
   #1A1A3E bg · #F4D48C gold · #B8A9E0 lavender accent
   Celestial calendar aesthetic · Monthly dark cards
   Golden section headers · Deep cosmic indigo
   ============================================================ */

page {
  background: var(--color-bg);
  --color-star-subtle: rgba(244, 212, 140, 0.12);
  --color-text-secondary: var(--color-text-secondary);
  --color-text-primary: var(--color-text-primary);
  /* Inline style compat aliases */
  --space-massive: var(--spacing-5xl);
  --space-xxxl: var(--spacing-3xl);
  --space-xxl: var(--spacing-2xl);
  --space-xl: var(--spacing-xl);
  --space-lg: var(--spacing-lg);
  --space-md: var(--spacing-md);
  --space-sm: var(--spacing-sm);
  --space-xs: var(--spacing-xs);
  --fs-h3: var(--font-size-xl);
  --fs-h4: var(--font-size-lg);
  --fs-body: var(--font-size-base);
  --fs-body-small: var(--font-size-sm);
  --fs-caption: var(--font-size-xs);
  --lh-loose: var(--line-height-loose);
  --lh-normal: var(--line-height-base);
  --fw-semibold: var(--font-weight-semibold);
  --fw-bold: var(--font-weight-bold);
  --fw-medium: var(--font-weight-medium);
  --duration-normal: var(--duration-base);
  --duration-fast: var(--duration-fast);
  --ease-out: var(--ease-out);
  --ease-in-out: var(--ease-in-out);
}

/* ============================================================
   Container
   ============================================================ */
.container {
  padding: var(--spacing-xl);
  padding-bottom: calc(var(--safe-area-bottom) + var(--spacing-5xl));
  min-height: 100vh;
  position: relative;
  z-index: 1;
}

/* ============================================================
   Gold / Lavender utilities
   ============================================================ */
.gold {
  color: var(--color-gold);
}
.lavender {
  color: #B8A9E0;
}

/* ============================================================
   Text helpers
   ============================================================ */
.text-dim {
  color: var(--color-text-secondary);
  font-size: var(--font-size-sm);
}

.text-secondary {
  color: var(--color-text-secondary);
  font-size: var(--font-size-base);
}

.text-body {
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  line-height: var(--line-height-base);
}

/* ============================================================
   INTRO — Preamble before generation
   ============================================================ */
.intro {
  text-align: center;
  padding: var(--spacing-5xl) var(--spacing-xl) var(--spacing-2xl);
}

.heading-1 {
  font-size: var(--font-size-3xl);
  font-weight: var(--font-weight-bold);
  color: var(--color-gold);
  text-align: center;
  letter-spacing: 2rpx;
}

/* ============================================================
   Generate Button — Golden pill
   ============================================================ */
.btn-glow-pulse {
  width: 80%;
  margin: var(--spacing-xl) auto 0;
  background: linear-gradient(135deg, #F4D48C 0%, #E8C67A 50%, #D4B06A 100%);
  color: var(--color-text-inverse);
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  border-radius: var(--radius-pill);
  padding: 28rpx 0;
  border: none;
  box-shadow: var(--shadow-gold-button);
  letter-spacing: 2rpx;
  transition: all var(--duration-base);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: glow-pulse 2.5s ease-in-out infinite;
}

.btn-glow-pulse:active {
  transform: scale(0.96);
  opacity: 0.90;
  box-shadow: 0 2rpx 12rpx rgba(244, 212, 140, 0.20);
}

@keyframes glow-pulse {
  0%, 100% { box-shadow: 0 0 10rpx rgba(244, 212, 140, 0.08), var(--shadow-gold-button); }
  50% { box-shadow: 0 0 30rpx rgba(244, 212, 140, 0.20), var(--shadow-gold-button); }
}

/* Secondary button (outline) */
.btn-secondary {
  width: 80%;
  background: transparent;
  border: 1rpx solid rgba(244, 212, 140, 0.20);
  color: var(--color-text-secondary);
  font-size: var(--font-size-base);
  border-radius: var(--radius-pill);
  padding: 24rpx 0;
  letter-spacing: 1rpx;
  transition: all var(--duration-base);
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-secondary:active {
  border-color: rgba(244, 212, 140, 0.40);
  color: var(--color-gold);
  background: rgba(244, 212, 140, 0.04);
}

/* ============================================================
   Mystic Loading
   ============================================================ */
.mystic-loading {
  text-align: center;
  padding: var(--spacing-5xl) var(--spacing-xl);
}

.mystic-loading-symbol {
  font-size: 72rpx;
  display: block;
  margin-bottom: var(--spacing-xl);
  opacity: 0.80;
  animation: mystic-rotate 3s ease-in-out infinite;
}

@keyframes mystic-rotate {
  0%, 100% { transform: rotate(0deg) scale(1); opacity: 0.70; }
  50% { transform: rotate(180deg) scale(1.10); opacity: 1; }
}

.mystic-loading-title {
  font-size: var(--font-size-lg);
  color: var(--color-text-primary);
  font-weight: var(--font-weight-semibold);
  display: block;
  margin-bottom: var(--spacing-sm);
  letter-spacing: 2rpx;
}

.mystic-loading-sub {
  font-size: var(--font-size-base);
  color: var(--color-text-tertiary);
  display: block;
}

/* ============================================================
   REPORT — Main report body
   ============================================================ */
.report {
  padding: var(--spacing-lg) 0;
}

/* Golden section title (centered) */
.section-title-center {
  font-size: var(--font-size-xl);
  color: var(--color-gold);
  font-weight: var(--font-weight-bold);
  display: block;
  text-align: center;
  margin-bottom: var(--spacing-2xl);
  letter-spacing: 2rpx;
  text-shadow: 0 0 20rpx rgba(244, 212, 140, 0.08);
}

/* ============================================================
   MONTHLY CARDS — Dark indigo, golden month labels
   ============================================================ */
.report-cards-section {
  margin-bottom: var(--spacing-2xl);
}

.section-subtitle {
  font-size: var(--font-size-base);
  color: var(--color-gold);
  font-weight: var(--font-weight-medium);
  display: block;
  margin-bottom: var(--spacing-lg);
  text-align: center;
  letter-spacing: 2rpx;
}

.monthly-cards-scroll {
  white-space: nowrap;
  padding-bottom: var(--spacing-md);
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.monthly-cards-row {
  display: flex;
  flex-direction: row;
  gap: var(--spacing-md);
  padding: 0 var(--spacing-sm);
}

/* Individual month card */
.monthly-card-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  width: 300rpx;
  padding: var(--spacing-lg) var(--spacing-md);
  border-radius: var(--radius-lg);
  background: var(--color-card);
  border: 1rpx solid var(--color-card-border);
  transition: all var(--duration-base) var(--ease-soft);
  box-shadow: var(--shadow-card);
  position: relative;
  overflow: hidden;
}

/* Starlight accent glow */
.monthly-card-item::before {
  content: '';
  position: absolute;
  top: -60rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 200rpx;
  height: 120rpx;
  background: radial-gradient(circle, rgba(244, 212, 140, 0.06) 0%, transparent 70%);
  pointer-events: none;
}

.monthly-card-item:active {
  transform: translateY(-6rpx);
  border-color: var(--color-card-border-hover);
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.30), 0 0 60rpx rgba(244, 212, 140, 0.06);
}

/* Month label — golden */
.month-label {
  font-size: var(--font-size-sm);
  color: var(--color-gold);
  text-align: center;
  margin-top: var(--spacing-sm);
  letter-spacing: 2rpx;
  font-weight: var(--font-weight-medium);
}

/* ============================================================
   REPORT BODY — Dark card with report text
   ============================================================ */
.report-body {
  border-radius: var(--radius-xl);
  padding: var(--spacing-2xl);
  margin-bottom: var(--spacing-xl);
  position: relative;
  overflow: hidden;
  background: var(--color-card);
  border: 1rpx solid var(--color-card-border);
  box-shadow: var(--shadow-card);
}

/* Golden top rim glow */
.report-body::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2rpx;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(244, 212, 140, 0.20) 30%,
    rgba(244, 212, 140, 0.35) 50%,
    rgba(244, 212, 140, 0.20) 70%,
    transparent 100%
  );
  pointer-events: none;
}

.report-text {
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  line-height: var(--line-height-loose);
  white-space: pre-wrap;
  letter-spacing: 1rpx;
}

/* ============================================================
   Primary Button (share / actions)
   ============================================================ */
.btn-primary {
  background: linear-gradient(135deg, #F4D48C 0%, #E8C67A 50%, #D4B06A 100%);
  color: var(--color-text-inverse);
  border: none;
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-semibold);
  border-radius: var(--radius-pill);
  padding: 24rpx 48rpx;
  box-shadow: var(--shadow-gold-button);
  transition: all var(--duration-base) var(--ease-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
}

.btn-primary:active {
  transform: scale(0.97);
  opacity: 0.90;
  box-shadow: 0 2rpx 12rpx rgba(244, 212, 140, 0.20);
}

/* ============================================================
   Error State
   ============================================================ */
.error-state {
  text-align: center;
  padding: var(--spacing-5xl) var(--spacing-xl);
}

.error-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: var(--spacing-md);
  opacity: 0.50;
}

.error-text {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--spacing-xs);
}

.error-hint {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
  display: block;
  margin-bottom: var(--spacing-2xl);
}

.btn-small {
  font-size: var(--font-size-sm);
  padding: 16rpx 36rpx;
}

/* ============================================================
   SKELETON — Dark cosmic shimmer
   ============================================================ */
.skeleton {
  padding: var(--spacing-2xl) 0;
}

.skeleton-hero-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-md);
  margin-bottom: var(--spacing-3xl);
}

.skeleton-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-full);
  background: var(--color-surface);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-line {
  height: 32rpx;
  border-radius: var(--radius-sm);
  background: var(--color-surface);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-line.wide { width: 300rpx; }
.skeleton-line.medium { width: 240rpx; }

.skeleton-desc {
  width: 80%;
  height: 80rpx;
  border-radius: var(--radius-sm);
  background: var(--color-surface);
  margin-bottom: var(--spacing-2xl);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-btn {
  width: 80%;
  height: 88rpx;
  border-radius: var(--radius-pill);
  background: var(--color-surface);
  margin: 0 auto;
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

@keyframes pulse-scale {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.45; }
}

/* ============================================================
   Entrance animations
   ============================================================ */
.anim-fade-in-up-1 { opacity: 0; animation: fade-up 0.5s var(--ease-soft) 0.08s forwards; }
.anim-fade-in-up-2 { opacity: 0; animation: fade-up 0.5s var(--ease-soft) 0.23s forwards; }
.anim-fade-in-up-3 { opacity: 0; animation: fade-up 0.5s var(--ease-soft) 0.38s forwards; }
.anim-fade-in-up-4 { opacity: 0; animation: fade-up 0.5s var(--ease-soft) 0.53s forwards; }
.anim-fade-in-up-5 { opacity: 0; animation: fade-up 0.5s var(--ease-soft) 0.68s forwards; }
