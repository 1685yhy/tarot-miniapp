/* ================================================================
   Annual Report — Spotify Wrapped-style
   E3 奶油疗愈明亮主题（浅色底 · 深金/细金点缀 · 衬线标题）
   Full-screen story format, 8 swipeable screens
   ================================================================ */

/* === E3 补全: annual-report（深色→奶油浅色化改造） ===
   用户点名要求全站统一 E3：深色夜空 → 奶油底浅色版（保留沉浸叙事感）
   1. 全屏底 #0B0B1A → 奶油浅渐变 #FAF6EF→#F7F0E3→#F2ECDF
   2. 金色文字 #F4D48C → 深金 #A98B5F / #C9A97C；浅字 #F0EDE8/#B8A9E0 → 墨 #3D3A36/墨灰 #8A8478
   3. 星点/月亮装饰 → 浅金 rgba(201,169,124,...) 柔和版
   4. 按钮 → E3 三段金渐变 #C9A97C→#B08F52→#A98B5F + 奶油字
   5. 卡框/数据卡/海报弹层 → 奶油底 + 细金描边 + E3 浅阴影
   6. 大标题衬线化；图表色板换 E3 色（奶油/雾粉/细金/灰紫）
   7. 动画与交互全部保留 */

page {
  background: #FAF6EF;
  overflow: hidden;
  height: 100vh;
}

/* ================================================================
   Container — full viewport
   ================================================================ */
.container {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  overflow: hidden;
  background: #FAF6EF;
}

/* ================================================================
   Loading state
   ================================================================ */
.wrapped-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  padding: 0 60rpx;
}

.wrapped-loading-orb {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 48rpx;
}

.wrapped-loading-ring {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  border-radius: 50%;
  border: 3rpx solid rgba(201, 169, 124, 0.15);
  border-top-color: #C9A97C;
  animation: wr-spin 1.2s cubic-bezier(0.6, 0, 0.4, 1) infinite;
}

.wrapped-loading-icon {
  font-size: 64rpx;
  line-height: 160rpx;
  display: block;
  text-align: center;
}

.wrapped-loading-title {
  font-size: 32rpx;
  color: rgba(201, 169, 124, 0.8);
  font-weight: 600;
  letter-spacing: 3rpx;
}

/* ================================================================
   Error state
   ================================================================ */
.wrapped-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 0 60rpx;
}

.wrapped-error-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(201, 169, 124, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.wrapped-error-icon {
  font-size: 56rpx;
}

.wrapped-error-title {
  font-size: 32rpx;
  color: #3D3A36;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.wrapped-error-hint {
  font-size: 24rpx;
  color: rgba(138, 132, 120, 0.6);
  margin-bottom: 48rpx;
  text-align: center;
}

.wrapped-retry-btn {
  width: 60%;
  padding: 24rpx 0;
  background: linear-gradient(135deg, #C9A97C, #A98B5F);
  color: #F7F0E3;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 50rpx;
  border: none;
  letter-spacing: 2rpx;
}

/* ================================================================
   Generating state
   ================================================================ */
.wrapped-generating {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  padding: 0 60rpx;
  position: relative;
  overflow: hidden;
}

.wrapped-gen-orb {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 48rpx;
}

.wrapped-gen-ring-1,
.wrapped-gen-ring-2,
.wrapped-gen-ring-3 {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  border-radius: 50%;
  border: 2rpx solid transparent;
}

.wrapped-gen-ring-1 {
  border-top-color: rgba(201, 169, 124, 0.3);
  border-bottom-color: rgba(138, 132, 120, 0.2);
  animation: wr-spin 2s linear infinite;
}

.wrapped-gen-ring-2 {
  top: 20rpx; right: 20rpx; bottom: 20rpx; left: 20rpx;
  border-left-color: rgba(201, 169, 124, 0.2);
  border-right-color: rgba(138, 132, 120, 0.3);
  animation: wr-spin 1.5s linear infinite reverse;
}

.wrapped-gen-ring-3 {
  top: 40rpx; right: 40rpx; bottom: 40rpx; left: 40rpx;
  border-top-color: rgba(201, 169, 124, 0.15);
  animation: wr-spin 1s linear infinite;
}

.wrapped-gen-icon {
  font-size: 64rpx;
  line-height: 200rpx;
  display: block;
  text-align: center;
}

.wrapped-gen-title {
  font-size: 32rpx;
  color: #C9A97C;
  font-weight: 600;
  letter-spacing: 3rpx;
  margin-bottom: 12rpx;
}

.wrapped-gen-sub {
  font-size: 24rpx;
  color: rgba(138, 132, 120, 0.5);
  letter-spacing: 2rpx;
}

.wrapped-gen-particles {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  pointer-events: none;
}

.wrapped-gen-particle {
  position: absolute;
  width: 4rpx;
  height: 4rpx;
  background: #C9A97C;
  border-radius: 50%;
  opacity: 0;
  animation: gen-particle 2s ease-in-out infinite;
  animation-delay: calc(var(--i) * 0.25s);
  bottom: 20%;
}

@keyframes gen-particle {
  0% { opacity: 0; transform: translateY(0) scale(1); }
  20% { opacity: 0.6; }
  80% { opacity: 0.6; }
  100% { opacity: 0; transform: translateY(-300rpx) scale(0.05); }
}

/* ================================================================
   Pre-generation intro
   ================================================================ */
.wrapped-pre-intro {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  padding: 0 60rpx 120rpx;
  position: relative;
  overflow: hidden;
  text-align: center;
}

.pre-cosmic-glow {
  position: absolute;
  width: 600rpx;
  height: 600rpx;
  top: 10%;
  background: radial-gradient(circle, rgba(201, 169, 124, 0.06) 0%, transparent 70%);
  animation: pre-glow-breathe 4s ease-in-out infinite;
}

@keyframes pre-glow-breathe {
  0%, 100% { transform: scale(1); opacity: 0.5; }
  50% { transform: scale(1.1); opacity: 1; }
}

.pre-stars {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  pointer-events: none;
}

.pre-star {
  position: absolute;
  width: 4rpx;
  height: 4rpx;
  background: #C9A97C;
  border-radius: 50%;
  opacity: 0;
  animation: pre-star-twinkle 3s ease-in-out infinite;
  animation-delay: calc(var(--i) * 0.4s);
}

@keyframes pre-star-twinkle {
  0%, 100% { opacity: 0; transform: scale(0.5); }
  50% { opacity: 0.8; transform: scale(1.2); }
}

.pre-icon-wrap {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: rgba(201, 169, 124, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  position: relative;
  z-index: 1;
}

.pre-icon {
  font-size: 64rpx;
}

.pre-title {
  font-size: 48rpx;
  font-weight: 800;
  color: #C9A97C;
  letter-spacing: 6rpx;
  position: relative;
  z-index: 1;
  margin-bottom: 20rpx;
}

.pre-desc {
  font-size: 24rpx;
  color: rgba(138, 132, 120, 0.6);
  line-height: 1.8;
  margin-bottom: 60rpx;
  position: relative;
  z-index: 1;
}

.pre-gen-btn {
  width: 80%;
  padding: 28rpx 0;
  background: linear-gradient(135deg, #C9A97C, #A98B5F);
  color: #F7F0E3;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 50rpx;
  border: none;
  letter-spacing: 3rpx;
  position: relative;
  z-index: 1;
  box-shadow: 0 0 40rpx rgba(201, 169, 124, 0.15);
}

.pre-buy-btn {
  width: 80%;
  padding: 20rpx 0;
  background: transparent;
  color: rgba(138, 132, 120, 0.5);
  font-size: 24rpx;
  border-radius: 50rpx;
  border: 1rpx solid rgba(201, 169, 124, 0.1);
  margin-top: 16rpx;
  position: relative;
  z-index: 1;
}

.pre-note {
  font-size: 20rpx;
  color: rgba(138, 132, 120, 0.3);
  margin-top: 24rpx;
  position: relative;
  z-index: 1;
}

/* ================================================================
   Custom back button — top-left golden pill
   Below the status bar, clear of the right-side capsule,
   hit area >= 88rpx (min-height)
   ================================================================ */
.wrapped-back {
  position: fixed;
  top: calc(env(safe-area-inset-top) + 16rpx);
  left: 24rpx;
  z-index: 200;
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 88rpx;
  padding: 0 32rpx 0 20rpx;
  box-sizing: border-box;
  border-radius: var(--radius-pill);
  background: rgba(201, 169, 124, 0.10);
  border: 1rpx solid rgba(201, 169, 124, 0.28);
  color: var(--color-gold);
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
  transition: background 0.15s ease-out, transform 0.15s ease-out;
}

.wrapped-back:active {
  background: rgba(201, 169, 124, 0.20);
  transform: scale(0.96);
}

.wrapped-back-icon {
  width: 32rpx;
  height: 32rpx;
  display: block;
}

.wrapped-back-text {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-semibold);
  letter-spacing: 2rpx;
  line-height: 1;
}

/* ================================================================
   Wrapped stage — full screen
   ================================================================ */
.wrapped-stage {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: #FAF6EF;
}

/* Progress dots — pushed below status bar + back button, and
   stops short of the right-side capsule (approx 180rpx zone) */
.wrapped-progress {
  position: fixed;
  top: calc(env(safe-area-inset-top) + 120rpx);
  left: 40rpx;
  right: 200rpx;
  display: flex;
  gap: 4rpx;
  z-index: 100;
}

.wrapped-dot {
  height: 4rpx;
  border-radius: 2rpx;
  background: rgba(201, 169, 124, 0.18);
  transition: background 0.3s ease;
}

.wrapped-dot--active {
  background: #C9A97C;
}

/* ================================================================
   Screen base
   ================================================================ */
.wrapped-screen {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.5s ease;
  padding: 80rpx 40rpx 160rpx;
}

.wrapped-screen--active {
  opacity: 1;
  pointer-events: auto;
}

/* ================================================================
   SCREEN 0: INTRO — Cosmic
   ================================================================ */
.screen-cosmic-bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cosmic-ring {
  position: absolute;
  border-radius: 50%;
  border: 1rpx solid rgba(201, 169, 124, 0.08);
}

.cosmic-ring-1 {
  width: 500rpx;
  height: 500rpx;
  animation: cr-spin 8s linear infinite;
}

.cosmic-ring-2 {
  width: 380rpx;
  height: 380rpx;
  animation: cr-spin 6s linear infinite reverse;
  border-color: rgba(138, 132, 120, 0.08);
}

.cosmic-ring-3 {
  width: 260rpx;
  height: 260rpx;
  animation: cr-spin 4s linear infinite;
  border-color: rgba(201, 169, 124, 0.12);
}

@keyframes cr-spin {
  to { transform: rotate(360deg); }
}

.screen-star-particles {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  pointer-events: none;
}

.screen-star {
  position: absolute;
  background: #C9A97C;
  border-radius: 50%;
  opacity: 0;
}

.screen-star.star-float {
  animation: star-float 3s ease-in-out infinite;
}

@keyframes star-float {
  0%, 100% { opacity: 0; transform: translateY(0) scale(0.5); }
  20% { opacity: 0.6; }
  50% { opacity: 0.8; transform: translateY(-20rpx) scale(1); }
  80% { opacity: 0.6; }
}

.screen-0-content {
  text-align: center;
  position: relative;
  z-index: 10;
  opacity: 0;
  transform: translateY(40rpx);
  transition: opacity 1s cubic-bezier(0.22, 1, 0.36, 1),
              transform 1s cubic-bezier(0.22, 1, 0.36, 1);
}

.screen-0-content--visible {
  opacity: 1;
  transform: translateY(0);
}

.screen-0-year {
  font-size: 120rpx;
  font-weight: 900;
  color: rgba(201, 169, 124, 0.06);
  line-height: 1;
  letter-spacing: 8rpx;
  position: absolute;
  top: -80rpx;
  left: 50%;
  transform: translateX(-50%);
  white-space: nowrap;
}

.screen-0-divider {
  width: 60rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #C9A97C, transparent);
  margin: 0 auto 32rpx;
}

.screen-0-title {
  font-size: 40rpx;
  color: rgba(61, 58, 54, 0.6);
  display: block;
  letter-spacing: 8rpx;
  font-weight: 300;
}

.screen-0-subtitle {
  font-size: 72rpx;
  font-weight: 800;
  color: #C9A97C;
  display: block;
  letter-spacing: 10rpx;
  margin-top: 8rpx;
  text-shadow: 0 0 60rpx rgba(201, 169, 124, 0.15);
}

.screen-0-sparkles {
  position: relative;
  height: 40rpx;
  margin-top: 24rpx;
}

.screen-0-sparkle {
  position: absolute;
  font-size: 20rpx;
  color: #C9A97C;
  opacity: 0;
  animation: sparkle-rotate 2s ease-in-out infinite;
}

.screen-0-sparkle.s1 { left: 30%; animation-delay: 0s; }
.screen-0-sparkle.s2 { left: 45%; animation-delay: 0.5s; }
.screen-0-sparkle.s3 { left: 60%; animation-delay: 1s; }
.screen-0-sparkle.s4 { left: 50%; animation-delay: 1.5s; }

@keyframes sparkle-rotate {
  0%, 100% { opacity: 0; transform: scale(0.5) rotate(0deg); }
  50% { opacity: 1; transform: scale(1.2) rotate(180deg); }
}

.screen-0-hint {
  font-size: 20rpx;
  color: rgba(138, 132, 120, 0.3);
  margin-top: 80rpx;
  display: block;
  animation: hint-blink 2s ease-in-out infinite;
}

@keyframes hint-blink {
  0%, 100% { opacity: 0.3; }
  50% { opacity: 0.8; }
}

/* ================================================================
   SCREEN 1: BIG NUMBER
   ================================================================ */
.screen-bg-glow {
  position: absolute;
  width: 600rpx;
  height: 600rpx;
  top: 5%;
  background: radial-gradient(circle, rgba(201, 169, 124, 0.04) 0%, transparent 60%);
  pointer-events: none;
}

.screen-1-content {
  text-align: center;
  position: relative;
  z-index: 10;
}

.screen-1-label {
  font-size: 28rpx;
  color: rgba(138, 132, 120, 0.6);
  display: block;
  letter-spacing: 4rpx;
  margin-bottom: 32rpx;
}

.screen-1-number-wrap {
  position: relative;
  display: inline-block;
}

.screen-1-number {
  font-size: 200rpx;
  font-weight: 900;
  color: #C9A97C;
  line-height: 1;
  letter-spacing: 4rpx;
  opacity: 0;
  transform: scale(0.3);
  transition: opacity 1s cubic-bezier(0.34, 1.56, 0.64, 1),
              transform 1s cubic-bezier(0.34, 1.56, 0.64, 1);
  text-shadow: 0 0 80rpx rgba(201, 169, 124, 0.2);
}

.screen-1-number--visible {
  opacity: 1;
  transform: scale(1);
}

.screen-1-unit {
  font-size: 36rpx;
  color: rgba(201, 169, 124, 0.5);
  margin-left: 8rpx;
}

.screen-1-sub {
  font-size: 24rpx;
  color: rgba(138, 132, 120, 0.4);
  display: block;
  margin-top: 24rpx;
  letter-spacing: 2rpx;
}

/* Sparkle burst */
.sparkle-burst {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  pointer-events: none;
}

.sparkle-particle {
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  background: #C9A97C;
  border-radius: 50%;
  animation: sparkle-burst 1s ease-out forwards;
}

.sparkle-particle:nth-child(1) { --angle: 0deg; animation-delay: 0s; }
.sparkle-particle:nth-child(2) { --angle: 60deg; animation-delay: 0.05s; }
.sparkle-particle:nth-child(3) { --angle: 120deg; animation-delay: 0.1s; }
.sparkle-particle:nth-child(4) { --angle: 180deg; animation-delay: 0.15s; }
.sparkle-particle:nth-child(5) { --angle: 240deg; animation-delay: 0.2s; }
.sparkle-particle:nth-child(6) { --angle: 300deg; animation-delay: 0.25s; }

@keyframes sparkle-burst {
  0% {
    opacity: 1;
    transform: rotate(var(--angle)) translateY(0);
  }
  100% {
    opacity: 0;
    transform: rotate(var(--angle)) translateY(-120rpx);
  }
}

/* ================================================================
   SCREEN 2: TOP THEME
   ================================================================ */
.screen-2-content {
  text-align: center;
  position: relative;
  z-index: 10;
  width: 100%;
}

.screen-2-label {
  font-size: 28rpx;
  color: rgba(138, 132, 120, 0.6);
  display: block;
  letter-spacing: 4rpx;
  margin-bottom: 40rpx;
}

.screen-2-theme {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  opacity: 0;
  transform: scale(0.8);
  transition: opacity 0.6s cubic-bezier(0.34, 1.56, 0.64, 1),
              transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  margin-bottom: 60rpx;
}

.screen-2-theme--visible {
  opacity: 1;
  transform: scale(1);
}

.screen-2-icon {
  width: 80rpx;
  height: 80rpx;
}

.screen-2-theme-text {
  font-size: 60rpx;
  font-weight: 800;
  color: #C9A97C;
  letter-spacing: 6rpx;
}

.screen-2-mini-chart {
  width: 80%;
  margin: 0 auto;
  text-align: left;
}

.screen-2-mini-bar-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.screen-2-mini-bar-label {
  font-size: 24rpx;
  color: rgba(61, 58, 54, 0.6);
  width: 80rpx;
  flex-shrink: 0;
}

.screen-2-mini-bar-track {
  flex: 1;
  height: 24rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 12rpx;
  overflow: hidden;
}

.screen-2-mini-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, rgba(201, 169, 124, 0.3), #C9A97C);
  border-radius: 12rpx;
  width: 0;
  transition: width 0.8s cubic-bezier(0.22, 1, 0.36, 1);
}

.screen-2-mini-bar-fill--animate {
  width: var(--bar-width, 60%);
}

.screen-2-mini-bar-count {
  font-size: 22rpx;
  color: rgba(201, 169, 124, 0.5);
  width: 60rpx;
  text-align: right;
  flex-shrink: 0;
}

/* ================================================================
   SCREEN 3: CARD REVEAL
   ================================================================ */
.screen-bg-card-glow {
  position: absolute;
  width: 500rpx;
  height: 500rpx;
  top: 15%;
  background: radial-gradient(circle, rgba(138, 132, 120, 0.04) 0%, transparent 60%);
  pointer-events: none;
}

.screen-3-content {
  text-align: center;
  position: relative;
  z-index: 10;
  width: 100%;
}

.screen-3-label {
  font-size: 28rpx;
  color: rgba(138, 132, 120, 0.6);
  display: block;
  letter-spacing: 4rpx;
  margin-bottom: 40rpx;
}

.screen-3-card-wrap {
  position: relative;
  width: 280rpx;
  height: 400rpx;
  margin: 0 auto 32rpx;
  opacity: 0;
  transform: scaleX(0.1);
  transition: opacity 0.8s cubic-bezier(0.34, 1.56, 0.64, 1),
              transform 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.screen-3-card-wrap--reveal {
  opacity: 1;
  transform: scaleX(1);
}

.screen-3-card-glow-ring {
  position: absolute;
  top: -20rpx;
  left: -20rpx;
  right: -20rpx;
  bottom: -20rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(201, 169, 124, 0.1);
  animation: card-glow-pulse 3s ease-in-out infinite;
}

@keyframes card-glow-pulse {
  0%, 100% { box-shadow: 0 0 20rpx rgba(201, 169, 124, 0.05); }
  50% { box-shadow: 0 0 60rpx rgba(201, 169, 124, 0.12); }
}

/* E3 装裱: 年度报告页 — 奶油卡底 + 细金描边 + 顶部高光 + 极浅阴影 + 内缩奶油边距 */
.screen-3-card-frame {
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
  overflow: hidden;
  background: #F7F0E3;
  border: 1rpx solid rgba(201, 169, 124, 0.28);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.6), 0 12rpx 32rpx rgba(61, 58, 54, 0.14);
  padding: 10rpx;
  box-sizing: border-box;
}

