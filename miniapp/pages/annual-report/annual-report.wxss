.container{padding:24rpx;background:var(--color-bg);min-height:100vh;padding-bottom:80rpx}
.intro{text-align:center;padding:80rpx 0}.intro-icon{font-size:80rpx;display:block}.intro-title{font-size:36rpx;font-weight:700;color:var(--color-gold);display:block;margin-top:20rpx}.intro-desc{font-size:26rpx;color:var(--color-text-secondary);line-height:1.7;display:block;margin:24rpx 0;padding:0 24rpx}.generate-btn{background:linear-gradient(135deg,var(--color-gold),var(--color-gold-light));color:#1a1a2e;font-weight:700;border-radius:48rpx;padding:28rpx 0;font-size:32rpx;width:80%;margin:0 auto;border:none}.intro-note{font-size:22rpx;color:var(--color-text-dim);display:block;margin-top:20rpx}
.generating{text-align:center;padding:160rpx 0}.gen-icon{font-size:80rpx;display:block;animation:mysticSpin 3s linear infinite}@keyframes mysticSpin{0%{transform:rotate(0)}to{transform:rotate(360deg)}}.gen-text{font-size:30rpx;color:var(--color-gold);display:block;margin-top:30rpx}.gen-sub{font-size:24rpx;color:var(--color-text-dim);display:block;margin-top:10rpx}
.report{padding:20rpx 0}.report-title{font-size:28rpx;font-weight:700;color:var(--color-gold);display:block;text-align:center;margin-bottom:24rpx}.report-body{background:var(--color-bg-card);border-radius:20rpx;padding:28rpx;border:1rpx solid rgba(201,169,110,0.1);margin-bottom:28rpx}.report-text{font-size:28rpx;color:var(--color-text-primary);line-height:1.9;white-space:pre-wrap}.share-btn{background:linear-gradient(135deg,var(--color-gold),var(--color-gold-light));color:#1a1a2e;font-weight:600;border-radius:48rpx;padding:24rpx 0;font-size:30rpx;margin-bottom:16rpx;border:none}.regenerate-btn{background:transparent;color:var(--color-gold);border:2rpx solid var(--color-gold);border-radius:48rpx;padding:24rpx 0;font-size:30rpx}
