/* ================================================================
   SHARE POSTER MODAL
   ================================================================ */
.poster-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  z-index: 1000;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
  display: flex;
  align-items: flex-end;
}

.poster-overlay--visible {
  opacity: 1;
  pointer-events: auto;
}

.poster-modal {
  width: 100%;
  max-height: 85vh;
  background: #F7F0E3;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx 60rpx;
  transform: translateY(100%);
  transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
}

.poster-overlay--visible .poster-modal {
  transform: translateY(0);
}

.poster-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.poster-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #C9A97C;
}

.poster-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.05);
}

.poster-close-icon {
  font-size: 24rpx;
  color: rgba(138, 132, 120, 0.6);
}

.poster-canvas-wrap {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 400rpx;
  position: relative;
}

.poster-canvas {
  width: 100%;
  border-radius: 16rpx;
}

.poster-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  color: rgba(138, 132, 120, 0.5);
  font-size: 24rpx;
}

.poster-loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(201, 169, 124, 0.1);
  border-top-color: #C9A97C;
  animation: wr-spin 1s linear infinite;
}

.poster-preview-img {
  width: 100%;
  max-height: 600rpx;
  border-radius: 16rpx;
}

.poster-actions {
  margin-top: 24rpx;
}

.poster-save-btn {
  width: 100%;
  padding: 24rpx 0;
  background: linear-gradient(135deg, #C9A97C, #A98B5F);
  color: #F7F0E3;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 50rpx;
  border: none;
  letter-spacing: 2rpx;
}

.poster-save-btn[disabled] {
  opacity: 0.3;
  background: rgba(255, 255, 255, 0.05);
  color: rgba(138, 132, 120, 0.3);
}

/* ================================================================
   Keyframes shared
   ================================================================ */
@keyframes wr-spin {
  to { transform: rotate(360deg); }
}

/* ============================================================
   E3 奶油疗愈 — 深色→奶油浅色化改造（追加覆盖，动画全部保留）
   ============================================================ */
page {
  --e3-cream: #FAF6EF;
  --e3-cream-hi: #FFFDF8;
  --e3-paper: #F2ECDF;
  --e3-pink: #E8C4BE;
  --e3-pink-ink: #B08A82;
  --e3-gold: #C9A97C;
  --e3-gold-deep: #8A6B3D;
  --e3-line: rgba(201, 169, 124, 0.28);
  --e3-line-soft: rgba(201, 169, 124, 0.38);
  --e3-lav: #D8D2E4;
  --e3-ink: #3D3A36;
  --e3-ink-soft: #8A8478;
  --e3-ink-faint: #6E6A96;
  --e3-shadow: 0 2rpx 8rpx rgba(61, 58, 54, 0.08);
  --e3-hi: inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
  --e3-serif: 'Songti SC', 'STSong', 'SimSun', 'Noto Serif CJK SC', 'Noto Serif SC', serif;
  --e3-gold-btn: linear-gradient(135deg, #C9A97C 0%, #B08F52 50%, #A98B5F 100%);
}

/* —— 全屏底：深色夜空 → 奶油浅渐变 —— */
page {
  background: #FAF6EF;
}
.container,
.wrapped-stage {
  background: linear-gradient(180deg, #FAF6EF 0%, #F7F0E3 45%, #F2ECDF 100%);
}

/* ================================================================
   Loading / Generating
   ================================================================ */
.wrapped-loading-ring {
  border: 3rpx solid rgba(201, 169, 124, 0.18);
  border-top-color: #C9A97C;
}
.wrapped-loading-title {
  color: var(--e3-ink);
  font-family: var(--e3-serif);
  letter-spacing: 4rpx;
}
.wrapped-gen-ring-1 {
  border-top-color: rgba(201, 169, 124, 0.35);
  border-bottom-color: rgba(216, 210, 228, 0.30);
}
.wrapped-gen-ring-2 {
  border-left-color: rgba(201, 169, 124, 0.25);
  border-right-color: rgba(216, 210, 228, 0.40);
}
.wrapped-gen-ring-3 {
  border-top-color: rgba(201, 169, 124, 0.20);
}
.wrapped-gen-title {
  color: var(--e3-ink);
  font-family: var(--e3-serif);
  letter-spacing: 4rpx;
}
.wrapped-gen-sub {
  color: var(--e3-ink-soft);
}
.wrapped-gen-particle {
  background: #C9A97C;
}

/* ================================================================
   Error
   ================================================================ */
.wrapped-error-icon-wrap {
  background: rgba(232, 196, 190, 0.35);
  border: 1rpx solid rgba(201, 169, 124, 0.25);
}
.wrapped-error-title {
  color: var(--e3-ink);
  font-family: var(--e3-serif);
  letter-spacing: 4rpx;
}
.wrapped-error-hint {
  color: var(--e3-ink-soft);
}

/* ================================================================
   Pre-intro
   ================================================================ */
.pre-cosmic-glow {
  background: radial-gradient(circle, rgba(232, 196, 190, 0.28) 0%, rgba(232, 196, 190, 0) 70%);
}
.pre-star {
  background: #C9A97C;
  box-shadow: 0 0 8rpx rgba(201, 169, 124, 0.25);
}
.pre-icon-wrap {
  background: rgba(232, 196, 190, 0.35);
  border: 1rpx solid rgba(201, 169, 124, 0.25);
  box-shadow: var(--e3-shadow);
}
.pre-title {
  font-family: var(--e3-serif);
  font-weight: 500;
  color: var(--e3-ink);
  letter-spacing: 8rpx;
}
.pre-desc {
  color: var(--e3-ink-soft);
  line-height: 2;
}
.pre-gen-btn {
  background: var(--e3-gold-btn);
  color: #FAF6EF;
  box-shadow: 0 4rpx 28rpx rgba(201, 169, 124, 0.30), var(--e3-hi);
  font-family: var(--e3-serif);
  font-weight: 500;
  letter-spacing: 4rpx;
}
.pre-buy-btn {
