/* ===== 年度报告 - 轻奢简约主题 ===== */
/*    深色基调的高级感，月度卡片精致布局    */

/* ---------------------------------------------------------------
   Container — 深色基底，衬托内容
   --------------------------------------------------------------- */
.container {
  padding: var(--space-xl);
  padding-bottom: calc(env(safe-area-inset-bottom) + var(--space-massive));
  background: linear-gradient(180deg, #1A1720 0%, #221F2A 100%);
  min-height: 100vh;
}

/* ---------------------------------------------------------------
   Intro — 卷首语
   --------------------------------------------------------------- */
.intro {
  text-align: center;
  padding: var(--space-huge) var(--space-xl) var(--space-xxl);
}

/* ---------------------------------------------------------------
   Mystic Loading — 深邃等待
   --------------------------------------------------------------- */
.mystic-loading {
  text-align: center;
  padding: var(--space-massive) var(--space-xl);
}

.mystic-loading-symbol {
  font-size: 72rpx;
  display: block;
  margin-bottom: var(--space-xl);
  opacity: 0.8;
}

.mystic-loading-title {
  font-size: var(--fs-h4);
  color: #E8E4F0;
  font-weight: var(--fw-semibold);
  display: block;
  margin-bottom: var(--space-sm);
  letter-spacing: 2rpx;
}

.mystic-loading-sub {
  font-size: var(--fs-body);
  color: #8A84A0;
  display: block;
}

/* ---------------------------------------------------------------
   Report — 报告正文
   --------------------------------------------------------------- */
.report {
  padding: var(--space-lg) 0;
}

.section-title-center {
  font-size: var(--fs-h3);
  color: #E8E4F0;
  font-weight: var(--fw-bold);
  display: block;
  text-align: center;
  margin-bottom: var(--space-xxl);
  letter-spacing: 2rpx;
}

/* Monthly cards section — 白色卡片展示 */
.report-cards-section {
  margin-bottom: var(--space-xxl);
}

.section-subtitle {
  font-size: var(--fs-body);
  color: #8A84A0;
  display: block;
  margin-bottom: var(--space-lg);
  text-align: center;
  letter-spacing: 2rpx;
}

.monthly-cards-scroll {
  white-space: nowrap;
  padding-bottom: var(--space-md);
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.monthly-cards-row {
  display: flex;
  flex-direction: row;
  gap: var(--space-md);
  padding: 0 var(--space-sm);
}

.monthly-card-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  width: 300rpx;
  padding: var(--space-lg) var(--space-md);
  border-radius: 24rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  transition: all var(--duration-normal) var(--ease-out);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.15);
}

.monthly-card-item:active {
  transform: translateY(-4rpx);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
}

.month-label {
  font-size: var(--fs-body-small);
  color: #6A6280;
  text-align: center;
  margin-top: var(--space-sm);
  letter-spacing: 1rpx;
  font-weight: var(--fw-medium);
}

/* Report body — 深色卡片中的文字内容 */
.report-body {
  border-radius: 28rpx;
  padding: var(--space-xxl);
  margin-bottom: var(--space-xl);
  position: relative;
  overflow: hidden;
  background: linear-gradient(160deg, #2A2735, #24212E);
  border: 1rpx solid rgba(255, 255, 255, 0.04);
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.2);
}

.report-text {
  font-size: var(--fs-body);
  color: #D0CCE0;
  line-height: var(--lh-loose);
  white-space: pre-wrap;
  letter-spacing: 1rpx;
}

/* ---------------------------------------------------------------
   Buttons — 深色背景按钮
   --------------------------------------------------------------- */
.btn-glow-pulse {
  width: 80%;
  margin: var(--space-xl) auto 0;
  background: linear-gradient(135deg, #6B5B9E, #8B7BBE);
  color: #FFFFFF;
  font-size: var(--fs-h4);
  font-weight: var(--fw-semibold);
  border-radius: 44rpx;
  padding: 28rpx 0;
  border: none;
  box-shadow: 0 4rpx 24rpx rgba(107, 91, 158, 0.3);
  letter-spacing: 2rpx;
  transition: all var(--duration-normal);
}

.btn-glow-pulse:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.btn-secondary {
  width: 80%;
  background: transparent;
  border: 2rpx solid rgba(255, 255, 255, 0.12);
  color: #A09AB8;
  font-size: var(--fs-body);
  border-radius: 44rpx;
  padding: 24rpx 0;
  letter-spacing: 1rpx;
  transition: all var(--duration-normal);
}

.btn-secondary:active {
  border-color: rgba(255, 255, 255, 0.25);
  color: #C8C4D8;
}

/* ---------------------------------------------------------------
   Skeleton — 深色骨架
   --------------------------------------------------------------- */
.skeleton {
  padding: var(--space-xxl) 0;
}

.skeleton-hero-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-md);
  margin-bottom: var(--space-xxxl);
}

.skeleton-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, #2E2B3A, #353240);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-line {
  height: 32rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #2E2B3A, #353240);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-line.wide { width: 300rpx; }
.skeleton-line.medium { width: 240rpx; }

.skeleton-desc {
  width: 80%;
  height: 80rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #2E2B3A, #353240);
  margin-bottom: var(--space-xxl);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-btn {
  width: 80%;
  height: 88rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #2E2B3A, #353240);
  margin: 0 auto;
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

/* ---------------------------------------------------------------
   Error — 深色报错
   --------------------------------------------------------------- */
.error-state {
  text-align: center;
  padding: var(--space-massive) var(--space-xl);
}

.error-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: var(--space-md);
  opacity: 0.5;
}

.error-text {
  font-size: var(--fs-body);
  color: #A09AB8;
  display: block;
  margin-bottom: var(--space-xs);
}

.error-hint {
  font-size: var(--fs-body-small);
  color: #6A6280;
  display: block;
  margin-bottom: var(--space-xxl);
}
