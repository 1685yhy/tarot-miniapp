/* ===== 年度报告 - 暖金年鉴主题 (Golden Yearbook) ===== */
/*    像一本手工制作的年册：温暖、珍贵、每一页都值得珍藏  */

/* ---------------------------------------------------------------
   Container — 暖白底色，宛如精装书页
   --------------------------------------------------------------- */
.container {
  padding: var(--space-xl);
  padding-bottom: calc(env(safe-area-inset-bottom) + var(--space-massive));
  background: linear-gradient(180deg, #FFFAF5 0%, #FFF5EB 100%);
  min-height: 100vh;
}

/* ---------------------------------------------------------------
   Intro — 卷首语，像年鉴扉页
   --------------------------------------------------------------- */
.intro {
  text-align: center;
  padding: var(--space-huge) 0 var(--space-xxl);
  position: relative;
}

.intro-symbol {
  font-size: 80rpx;
  display: block;
  margin-bottom: var(--space-xl);
  animation: float 5s var(--ease-in-out) infinite;
  opacity: 0.7;
}

.intro-title {
  font-size: var(--fs-h1);
  font-weight: var(--fw-bold);
  color: #3D3535;
  display: block;
  letter-spacing: 4rpx;
}

.intro-subtitle {
  font-size: var(--fs-body);
  color: #9A8A8A;
  display: block;
  margin-top: var(--space-md);
  line-height: var(--lh-normal);
  letter-spacing: 1rpx;
}

.intro-divider {
  display: block;
  margin: var(--space-xxl) auto 0;
  width: 200rpx;
  height: 2rpx;
  background: linear-gradient(90deg,
    transparent, #D4836A, transparent);
  opacity: 0.4;
}

/* ---------------------------------------------------------------
   Generating (loading) — 翻页等待中
   --------------------------------------------------------------- */
.generating {
  text-align: center;
  padding: var(--space-massive) 0;
}

.generating-symbol {
  font-size: 64rpx;
  display: block;
  color: #C9A96E;
  animation: mystic-spin 5s var(--ease-in-out) infinite;
  margin-bottom: var(--space-xl);
  opacity: 0.7;
}

.generating-text {
  font-size: var(--fs-h4);
  color: #D4836A;
  font-weight: var(--fw-semibold);
  display: block;
  animation: breathe 3s ease-in-out infinite;
  letter-spacing: 2rpx;
}

.generating-sub {
  font-size: var(--fs-body);
  color: #9A8A8A;
  display: block;
  margin-top: var(--space-sm);
}

/* ---------------------------------------------------------------
   Report — 年鉴正文
   --------------------------------------------------------------- */
.report {
  padding: var(--space-lg) 0;
}

.report-body {
  border-radius: 28rpx;
  padding: var(--space-xxl);
  margin-bottom: var(--space-xl);
  position: relative;
  overflow: hidden;
  background: linear-gradient(160deg, #FFFFFF, #FFFAF5);
  border: 1rpx solid rgba(201, 169, 110, 0.15);
  box-shadow: 0 6rpx 28rpx rgba(183, 201, 177, 0.06);
}

/* 顶部暖色装饰线 */
.report-body::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 3rpx;
  background: linear-gradient(90deg,
    transparent,
    rgba(201, 169, 110, 0.3) 30%,
    rgba(212, 131, 106, 0.3) 70%,
    transparent);
  opacity: 0.4;
  pointer-events: none;
}

/* 右上角装饰花 */
.report-body::after {
  content: '✿';
  position: absolute;
  top: var(--space-md);
  right: var(--space-md);
  font-size: 24rpx;
  color: #C9A96E;
  opacity: 0.12;
  pointer-events: none;
}

.report-section {
  margin-bottom: var(--space-xxl);
}

.report-section:last-child {
  margin-bottom: 0;
}

.report-section-title {
  font-size: var(--fs-body);
  font-weight: var(--fw-semibold);
  color: #D4836A;
  display: block;
  margin-bottom: var(--space-md);
  letter-spacing: 2rpx;
  position: relative;
  padding-left: var(--space-xl);
}

.report-section-title::before {
  content: '🌸';
  position: absolute;
  left: 0;
  font-size: 18rpx;
  opacity: 0.5;
}

.report-text {
  font-size: var(--fs-body);
  color: #3D3535;
  line-height: var(--lh-loose);
  white-space: pre-wrap;
  letter-spacing: 1rpx;
}

/* 段落首字下沉 — 如精装书的装饰首字母 */
.report-text.drop-cap::first-letter {
  font-size: 56rpx;
  font-weight: var(--fw-bold);
  color: #D4836A;
  float: left;
  margin-right: 8rpx;
  line-height: 1;
  font-family: var(--font-family-display, serif);
}

/* Stats highlight in report */
.report-stat-highlight {
  display: inline-block;
  font-size: var(--fs-h2);
  font-weight: var(--fw-bold);
  color: #C9A96E;
}

.report-stat-label {
  font-size: var(--fs-body-small);
  color: #9A8A8A;
  display: block;
  margin-top: var(--space-xs);
}

/* ---------------------------------------------------------------
   Monthly Cards Scroll — 月度卡片长廊
   --------------------------------------------------------------- */
.report-cards-section {
  margin-bottom: var(--space-xxl);
}

.section-subtitle {
  font-size: var(--fs-body);
  color: #6B5A5A;
  display: block;
  margin-bottom: var(--space-md);
  text-align: center;
  letter-spacing: 2rpx;
}

.monthly-cards-scroll {
  white-space: nowrap;
  padding-bottom: var(--space-md);
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.monthly-cards-row {
  display: flex;
  flex-direction: row;
  gap: var(--space-md);
  padding: 0 var(--space-sm);
}

.monthly-card-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  width: 300rpx;
  padding: var(--space-lg) 0;
  border-radius: 20rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(212, 131, 106, 0.1);
  transition: all var(--duration-normal) var(--ease-out);
  box-shadow: 0 4rpx 16rpx rgba(183, 201, 177, 0.04);
}

.monthly-card-item:active {
  border-color: rgba(212, 131, 106, 0.25);
  transform: scale(0.96);
  box-shadow: 0 8rpx 24rpx rgba(212, 131, 106, 0.1);
}

.monthly-card-image {
  width: 200rpx;
  height: 280rpx;
  border-radius: 12rpx;
  margin-bottom: var(--space-sm);
  box-shadow: 0 4rpx 12rpx rgba(183, 201, 177, 0.08);
}

.month-label {
  font-size: var(--fs-body-small);
  color: #6B5A5A;
  text-align: center;
  letter-spacing: 1rpx;
}

/* ---------------------------------------------------------------
   Skeleton — 暖色骨架
   --------------------------------------------------------------- */
.skeleton {
  padding: var(--space-xxl) 0;
}

.skeleton-hero-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-md);
  margin-bottom: var(--space-xxxl);
}

.skeleton-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, #F5EDE8, #F0EBE5);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-line {
  height: 32rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #F5EDE8, #F0EBE5);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-line.wide { width: 300rpx; }
.skeleton-line.medium { width: 240rpx; }

.skeleton-desc {
  width: 80%;
  height: 80rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #F5EDE8, #F0EBE5);
  margin-bottom: var(--space-xxl);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-btn {
  width: 80%;
  height: 88rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #F5EDE8, #F0EBE5);
  margin: 0 auto;
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

/* ---------------------------------------------------------------
   Error — 温柔报错
   --------------------------------------------------------------- */
.error-state {
  text-align: center;
  padding: var(--space-massive) var(--space-xl);
}

.error-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: var(--space-md);
  opacity: 0.5;
}

.error-text {
  font-size: var(--fs-body);
  color: #6B5A5A;
  display: block;
  margin-bottom: var(--space-xs);
}

.error-hint {
  font-size: var(--fs-body-small);
  color: #9A8A8A;
  display: block;
  margin-bottom: var(--space-xxl);
}
