/* ============================================================
   星空时刻表页 — E3 奶油疗愈 token（styles/common.wxss）
   月历 = 天象时刻表（事件徽标 + 月相小字）；与手账共用同一月历组件
   ============================================================ */

/* M-1 修复：--e3-* token 接线（参照 journal.wxss 追加覆盖模式）。
   page 级自定义属性会正常继承进 calendar 组件子树。 */
page {
  --e3-cream: #FAF6EF;
  --e3-cream-hi: #FFFDF8;
  --e3-paper: #F2ECDF;
  --e3-pink: #E8C4BE;
  --e3-pink-ink: #B08A82;
  --e3-gold: #C9A97C;
  --e3-gold-deep: #8A6B3D;
  --e3-line: rgba(201, 169, 124, 0.28);
  --e3-line-soft: rgba(201, 169, 124, 0.38);
  --e3-lav: #D8D2E4;
  --e3-ink: #3D3A36;
  --e3-ink-soft: #8A8478;
  --e3-ink-faint: #6E6A96;
  --e3-shadow: 0 2rpx 8rpx rgba(61, 58, 54, 0.08);
  --e3-hi: inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
  --e3-serif: 'Songti SC', 'STSong', 'SimSun', 'Noto Serif CJK SC', 'Noto Serif SC', serif;
}

.container {
  padding: var(--spacing-xl) var(--spacing-lg);
  padding-bottom: calc(120rpx + var(--safe-area-bottom));
  min-height: 100vh;
  position: relative;
  z-index: 1;
}

/* E3 奶油底色氛围光斑（参照 index/diary 同款） */
.wash {
  position: fixed;
  border-radius: 50%;
  filter: blur(80rpx);
  opacity: 0.5;
  pointer-events: none;
  z-index: 0;
}

.wash-pink {
  width: 420rpx;
  height: 420rpx;
  background: rgba(232, 196, 190, 0.5);
  top: -120rpx;
  right: -140rpx;
}

.wash-gold {
  width: 460rpx;
  height: 460rpx;
  background: rgba(201, 169, 124, 0.32);
  bottom: -160rpx;
  left: -180rpx;
}

/* ============================================================
   Page Header
   ============================================================ */
.page-header {
  text-align: center;
  padding: var(--spacing-lg) 0 40rpx;
}

.page-title {
  font-size: var(--font-size-subhead);
  font-weight: 500;
  font-family: var(--e3-serif, 'Songti SC', serif);
  color: var(--e3-ink, #3D3A36);
  letter-spacing: 8rpx;
  display: block;
  margin-bottom: 12rpx;
}

.page-subtitle {
  font-size: var(--font-size-caption);
  color: var(--e3-ink-soft, #8A8478);
  letter-spacing: 3rpx;
  display: block;
}

/* ============================================================
   静默失败内联提示（切月/onShow 刷新失败：轻量横幅 + 重试）
   ============================================================ */
.silent-error {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
  background: rgba(232, 122, 138, 0.06);
  border: 1rpx solid rgba(232, 122, 138, 0.18);
  border-radius: 20rpx;
  padding: 18rpx var(--spacing-lg);
  margin-bottom: var(--spacing-md);
}

.silent-error-texts {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  min-width: 0;
  flex: 1;
}

.silent-error-title {
  font-size: var(--font-size-caption);
  font-weight: 600;
  color: var(--e3-ink, #3D3A36);
  letter-spacing: 2rpx;
}

.silent-error-desc {
  font-size: var(--font-size-xs);
  color: var(--e3-ink-soft, #8A8478);
  letter-spacing: 1rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.silent-error-retry {
  flex-shrink: 0;
  min-height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(201, 169, 124, 0.10);
  color: var(--color-gold-dark);
  font-size: var(--font-size-xs);
  font-weight: 500;
  border: 1rpx solid rgba(201, 169, 124, 0.20);
  border-radius: var(--radius-pill);
  padding: 0 var(--spacing-lg);
  transition: background 0.2s;
}

.silent-error-retry:active {
  background: rgba(201, 169, 124, 0.18);
}

.silent-error-retry::after {
  border: none;
}

/* ============================================================
   下一节点倒计时卡（顶部 · 全局下一节点，随日更新）
   ============================================================ */
.countdown-card {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
  background: linear-gradient(145deg, var(--e3-cream-hi, #FFFDF8) 0%, var(--e3-paper, #F2ECDF) 100%);
  border: 1rpx solid var(--e3-line-soft, rgba(201, 169, 124, 0.38));
  border-radius: 24rpx;
  padding: var(--spacing-md) var(--spacing-lg);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--e3-shadow, 0 2rpx 8rpx rgba(61, 58, 54, 0.08)), var(--e3-hi, inset 0 1rpx 0 rgba(255, 255, 255, 0.6));
  transition: transform 0.15s ease-out, background 0.15s ease-out;
}

.countdown-card--press {
  background: rgba(201, 169, 124, 0.12);
  transform: scale(0.985);
}

.countdown-emoji-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(201, 169, 124, 0.12);
  border: 1rpx solid rgba(201, 169, 124, 0.30);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 0 24rpx rgba(201, 169, 124, 0.25);
}

.countdown-emoji {
  font-size: 44rpx;
  line-height: 1;
}

.countdown-texts {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
  flex: 1;
}

.countdown-label {
  font-size: var(--font-size-xs);
  color: var(--e3-ink-faint, #6E6A96);
  letter-spacing: 3rpx;
}

.countdown-title {
  font-family: var(--e3-serif, 'Songti SC', serif);
  font-size: var(--font-size-body);
  font-weight: 600;
  color: var(--e3-gold-deep, #8A6B3D);
  letter-spacing: 2rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.countdown-date {
  font-size: var(--font-size-xs);
  color: var(--e3-ink-soft, #8A8478);
  letter-spacing: 1rpx;
}

.countdown-arrow {
  font-size: 44rpx;
  color: var(--e3-gold-deep, #8A6B3D);
  opacity: 0.7;
  flex-shrink: 0;
}

/* ============================================================
   双视图切换（月历 / 事件列表）
   ============================================================ */
.view-toggle {
  display: flex;
  background: rgba(201, 169, 124, 0.08);
  border: 1rpx solid var(--e3-line, rgba(201, 169, 124, 0.28));
  border-radius: var(--radius-pill);
  padding: 6rpx;
  margin-bottom: var(--spacing-md);
}

.view-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: var(--font-size-caption);
  color: var(--e3-ink-soft, #8A8478);
  letter-spacing: 3rpx;
  border-radius: var(--radius-pill);
  transition: background 0.2s ease, color 0.2s ease;
}

.view-tab--active {
  background: var(--e3-cream-hi, #FFFDF8);
  color: var(--e3-gold-deep, #8A6B3D);
  font-weight: 600;
  box-shadow: var(--e3-shadow, 0 2rpx 8rpx rgba(61, 58, 54, 0.08));
}

/* ============================================================
   月历视图 + 图例 + 空月引导
   ============================================================ */
.calendar-wrap {
  margin-bottom: var(--spacing-sm);
}

.cal-legend {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 0 var(--spacing-xs) var(--spacing-lg);
}

.legend-item {
  display: flex;
  align-items: center;
  gap: var(--spacing-xs);
}

.legend-emoji {
  font-size: 24rpx;
  line-height: 1;
}

.legend-text {
  font-size: var(--font-size-xs);
  color: var(--e3-ink-soft, #8A8478);
  letter-spacing: 1rpx;
}

/* 空月引导：星空从不缺席，只是有时安静。 */
.empty-month {
  text-align: center;
  padding: var(--spacing-md) 0 var(--spacing-lg);
}

.empty-month-text {
  font-family: var(--e3-serif, 'Songti SC', serif);
  font-size: var(--font-size-body);
  color: var(--e3-ink-soft, #8A8478);
  letter-spacing: 4rpx;
}

/* ============================================================
   事件列表视图
   ============================================================ */
.event-list {
  padding: 4rpx 0 var(--spacing-xl);
}

.list-empty {
  text-align: center;
  padding: 120rpx var(--spacing-lg);
}

.list-empty-icon {
  display: block;
  font-size: 52rpx;
  color: var(--e3-gold, #C9A97C);
  margin-bottom: var(--spacing-md);
}

.list-empty-text {
  display: block;
  font-family: var(--e3-serif, 'Songti SC', serif);
  font-size: var(--font-size-body);
  color: var(--e3-ink, #3D3A36);
  letter-spacing: 3rpx;
  margin-bottom: 12rpx;
}

.list-empty-sub {
  display: block;
  font-size: var(--font-size-xs);
  color: var(--e3-ink-soft, #8A8478);
  letter-spacing: 1rpx;
}

.event-item {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
  background: linear-gradient(145deg, var(--e3-cream-hi, #FFFDF8) 0%, var(--e3-paper, #F2ECDF) 100%);
  border: 1rpx solid var(--e3-line, rgba(201, 169, 124, 0.28));
  border-radius: 20rpx;
  padding: var(--spacing-md) var(--spacing-lg);
  margin-bottom: var(--spacing-sm);
  box-shadow: var(--e3-shadow, 0 2rpx 8rpx rgba(61, 58, 54, 0.08)), var(--e3-hi, inset 0 1rpx 0 rgba(255, 255, 255, 0.6));
  transition: transform 0.15s ease-out, background 0.15s ease-out;
}

.event-item--press {
  background: rgba(201, 169, 124, 0.12);
  transform: scale(0.98);
}

.event-item-emoji {
  font-size: 40rpx;
  line-height: 1;
  flex-shrink: 0;
}

.event-item-texts {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
  flex: 1;
}

.event-item-label {
  font-family: var(--e3-serif, 'Songti SC', serif);
  font-size: var(--font-size-body);
  color: var(--e3-ink, #3D3A36);
  letter-spacing: 2rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.event-item-date {
  font-size: var(--font-size-xs);
  color: var(--e3-ink-soft, #8A8478);
  letter-spacing: 1rpx;
}

.event-item-arrow {
  font-size: 40rpx;
  color: var(--e3-gold-deep, #8A6B3D);
  opacity: 0.7;
  flex-shrink: 0;
}

/* ============================================================
   加载骨架
   ============================================================ */
.skeleton-wrap {
  padding: var(--spacing-xl) 0;
}

.skeleton-header-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-xl);
}

.skeleton-line {
  height: 30rpx;
  border-radius: var(--radius-sm);
}

.skeleton-line.wide { width: 280rpx; }
.skeleton-line.medium { width: 200rpx; }

.skeleton-block {
  width: 100%;
  height: 560rpx;
  border-radius: 28rpx;
}

/* ============================================================
   错误状态
   ============================================================ */
.error-state {
  padding: 120rpx var(--spacing-lg);
  text-align: center;
}

.error-card {
  background: var(--color-surface);
  border: 1rpx solid rgba(232, 122, 138, 0.20);
  border-radius: var(--radius-lg);
  padding: var(--spacing-xl) var(--spacing-lg);
}

.error-title {
  font-family: var(--e3-serif, 'Songti SC', serif);
  font-size: var(--font-size-body);
  color: var(--e3-ink, #3D3A36);
  letter-spacing: 3rpx;
  display: block;
  margin-bottom: 12rpx;
}

.error-desc {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  display: block;
  margin-bottom: 36rpx;
  line-height: 1.6;
}

.btn-retry {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  background: rgba(201, 169, 124, 0.10);
  color: var(--color-gold-dark);
  font-size: var(--font-size-caption);
  font-weight: 500;
  border: 1rpx solid rgba(201, 169, 124, 0.20);
  border-radius: var(--radius-pill);
  padding: var(--spacing-sm) var(--spacing-xl);
  transition: background 0.2s;
}

.btn-retry:active {
  background: rgba(201, 169, 124, 0.18);
}

/* ============================================================
   事件详情底部弹层（底部 sheet）
   ============================================================ */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(61, 58, 54, 0.45);
  z-index: 1000;
  animation: fade-in var(--duration-fast) var(--ease-out) forwards;
}

.modal-sheet {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--e3-cream, #FAF6EF);
  border-top: 1rpx solid var(--e3-line-soft, rgba(201, 169, 124, 0.38));
  border-radius: 32rpx 32rpx 0 0;
  z-index: 1001;
  padding: var(--spacing-sm) var(--spacing-lg) 60rpx;
  padding-bottom: calc(60rpx + var(--safe-area-bottom));
  max-height: 82vh;
  overflow-y: auto;
  animation: sheet-up 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  box-shadow: 0 -12rpx 60rpx rgba(61, 58, 54, 0.12);
}

@keyframes sheet-up {
  0% { transform: translateY(100%); opacity: 0; }
  100% { transform: translateY(0); opacity: 1; }
}

.modal-handle {
  width: 60rpx;
  height: 6rpx;
  background: rgba(201, 169, 124, 0.20);
  border-radius: var(--radius-pill);
  margin: 0 auto 32rpx;
}

.detail-header {
  display: flex;
  align-items: center;
  gap: var(--spacing-xs);
  margin-bottom: var(--spacing-sm);
}

.detail-date {
  font-family: var(--e3-serif, 'Songti SC', serif);
  font-size: var(--font-size-body);
  font-weight: 600;
  color: var(--e3-ink, #3D3A36);
  letter-spacing: 2rpx;
}

.detail-today-tag {
  font-size: var(--font-size-xs);
  color: var(--e3-gold-deep, #8A6B3D);
  background: rgba(201, 169, 124, 0.14);
  border: 1rpx solid rgba(201, 169, 124, 0.30);
  border-radius: var(--radius-pill);
  padding: 2rpx 14rpx;
}

/* 当日月相小字 */
.detail-phase {
  display: flex;
  align-items: center;
  gap: var(--spacing-xs);
  margin-bottom: var(--spacing-md);
}

.detail-phase-emoji {
  font-size: 36rpx;
  line-height: 1;
}

.detail-phase-label {
  font-size: var(--font-size-xs);
  color: var(--e3-ink-soft, #8A8478);
  letter-spacing: 1rpx;
}

.detail-loading {
  text-align: center;
  padding: 60rpx 0;
}

.detail-loading-text {
  font-size: var(--font-size-caption);
  color: var(--e3-ink-soft, #8A8478);
  letter-spacing: 2rpx;
}

/* 事件卡 */
.detail-events {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
}

.detail-event {
  display: flex;
  align-items: flex-start;
  gap: var(--spacing-md);
  background: rgba(255, 253, 248, 0.7);
  border: 1rpx solid var(--e3-line, rgba(201, 169, 124, 0.28));
  border-radius: 20rpx;
  padding: var(--spacing-md);
}

.detail-event-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(201, 169, 124, 0.12);
  border: 1rpx solid rgba(201, 169, 124, 0.30);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.detail-event-emoji {
  font-size: 34rpx;
  line-height: 1;
}

.detail-event-texts {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
  flex: 1;
}

.detail-event-label {
  font-family: var(--e3-serif, 'Songti SC', serif);
  font-size: var(--font-size-body);
  color: var(--e3-ink, #3D3A36);
  letter-spacing: 2rpx;
}

.detail-event-note {
  font-size: var(--font-size-caption);
  color: var(--e3-ink-soft, #8A8478);
  line-height: 1.6;
  letter-spacing: 1rpx;
}

/* 无事件日 */
.detail-quiet {
  text-align: center;
  padding: 40rpx 0;
}

.detail-quiet-text {
  display: block;
  font-family: var(--e3-serif, 'Songti SC', serif);
  font-size: var(--font-size-body);
  color: var(--e3-ink-soft, #8A8478);
  letter-spacing: 3rpx;
  margin-bottom: 8rpx;
}

.detail-quiet-sub {
  display: block;
  font-size: var(--font-size-xs);
  color: var(--e3-ink-faint, #6E6A96);
  letter-spacing: 1rpx;
}

/* 星象宜忌 */
.detail-guidance {
  margin-top: var(--spacing-lg);
}

.modal-label {
  display: block;
  font-size: var(--font-size-xs);
  color: var(--e3-ink-faint, #6E6A96);
  letter-spacing: 3rpx;
  margin-bottom: var(--spacing-sm);
}

.guidance-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
  background: rgba(255, 253, 248, 0.7);
  border: 1rpx solid var(--e3-line, rgba(201, 169, 124, 0.28));
  border-radius: 20rpx;
  padding: var(--spacing-md);
}

.guidance-do {
  font-size: var(--font-size-caption);
  color: var(--e3-gold-deep, #8A6B3D);
  letter-spacing: 1rpx;
}

.guidance-dont {
  font-size: var(--font-size-caption);
  color: var(--e3-pink-ink, #B08A82);
  letter-spacing: 1rpx;
}

/* 日详情降级提示 */
.detail-error-hint {
  margin-top: var(--spacing-md);
  text-align: center;
  font-size: var(--font-size-xs);
  color: var(--e3-pink-ink, #B08A82);
  letter-spacing: 1rpx;
}

/* 进入节点活动按钮 */
.btn-submit {
  margin-top: var(--spacing-lg);
  width: 100%;
  min-height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(201, 169, 124, 0.16) 0%, rgba(216, 210, 228, 0.16) 100%);
  border: 1rpx solid var(--e3-line-soft, rgba(201, 169, 124, 0.38));
  border-radius: var(--radius-pill);
  font-family: var(--e3-serif, 'Songti SC', serif);
  font-size: var(--font-size-body);
  color: var(--e3-gold-deep, #8A6B3D);
  letter-spacing: 4rpx;
  transition: background 0.2s, transform 0.15s ease-out;
}

.btn-submit--press {
  background: rgba(201, 169, 124, 0.18);
  transform: scale(0.98);
}

.btn-submit::after {
  border: none;
}
