/* ============================================================
   用户协议 / 隐私政策 — E3 奶油疗愈（#FAF6EF / 细金 #C9A97C / 墨 #3D3A36）
   与 about 页同源：衬线标题 Songti SC、章节卡片细金描边、极浅阴影
   ============================================================ */

.legal-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FAF6EF 0%, #F7F0E3 50%, #FAF6EF 100%);
  display: flex;
  flex-direction: column;
  position: relative;
}

/* 浅色星河背景（E3，同 about） */
.cosmic-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 0;
  background:
    radial-gradient(ellipse 60% 50% at 80% 20%, rgba(232, 196, 190, 0.10) 0%, transparent 70%),
    radial-gradient(ellipse 50% 60% at 20% 80%, rgba(201, 169, 124, 0.07) 0%, transparent 65%);
}

.legal-content {
  position: relative;
  z-index: 1;
  padding: var(--spacing-2xl, 48rpx) var(--spacing-lg, 32rpx) var(--spacing-3xl, 64rpx);
  max-width: 600rpx;
  margin: 0 auto;
  width: 100%;
  box-sizing: border-box;
}

/* ── 页头 ── */
.legal-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: var(--spacing-lg, 32rpx);
}

.legal-title {
  display: block;
  font-size: var(--font-size-title, 40rpx);
  font-family: 'Songti SC', 'STSong', 'SimSun', 'Noto Serif CJK SC', 'Noto Serif SC', serif;
  font-weight: 500;
  color: #B08F52;
  letter-spacing: 6rpx;
  text-align: center;
  margin-bottom: var(--spacing-sm, 16rpx);
}

.legal-meta {
  font-size: 22rpx;
  color: #B0AA9C;
  letter-spacing: 2rpx;
}

.legal-intro {
  display: block;
  font-size: 28rpx;
  color: #3D3A36;
  line-height: 1.8;
  letter-spacing: 1rpx;
  background: linear-gradient(145deg, #FFFDF8 0%, #F2ECDF 100%);
  border: 1rpx solid rgba(201, 169, 124, 0.28);
  border-radius: 20rpx;
  padding: var(--spacing-md, 24rpx) var(--spacing-lg, 32rpx);
  margin-bottom: var(--spacing-md, 24rpx);
  box-shadow: 0 2rpx 8rpx rgba(61, 58, 54, 0.08),
              inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
}

/* ── 章节卡片：奶油底 + 细金描边 + 极浅阴影（E3） ── */
.legal-section {
  background: linear-gradient(145deg, #FFFDF8 0%, #F2ECDF 100%);
  border: 1rpx solid rgba(201, 169, 124, 0.28);
  border-radius: 24rpx;
  padding: var(--spacing-lg, 32rpx);
  margin-bottom: var(--spacing-md, 24rpx);
  box-shadow: 0 2rpx 8rpx rgba(61, 58, 54, 0.08),
              inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
}

.legal-section-title {
  display: block;
  font-size: var(--font-size-subhead, 32rpx);
  font-family: 'Songti SC', 'STSong', 'SimSun', 'Noto Serif CJK SC', 'Noto Serif SC', serif;
  font-weight: 500;
  color: #B08F52;
  letter-spacing: 4rpx;
  padding-bottom: var(--spacing-sm, 16rpx);
  margin-bottom: var(--spacing-sm, 16rpx);
  border-bottom: 1rpx solid rgba(201, 169, 124, 0.20);
}

.legal-section-body {
  display: flex;
  flex-direction: column;
}

/* ── 正文：墨色 28rpx（14px）行高 1.8 ── */
.legal-p {
  display: block;
  font-size: 28rpx;
  color: #3D3A36;
  line-height: 1.8;
  letter-spacing: 1rpx;
  margin-bottom: var(--spacing-sm, 16rpx);
}

.legal-p:last-child {
  margin-bottom: 0;
}

.legal-strong {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  font-family: 'Songti SC', 'STSong', 'SimSun', 'Noto Serif CJK SC', 'Noto Serif SC', serif;
  color: #3D3A36;
  line-height: 1.8;
  letter-spacing: 1rpx;
  margin-bottom: var(--spacing-sm, 16rpx);
}

.legal-strong:last-child {
  margin-bottom: 0;
}

/* 有序列表：编号已含在文案 */
.legal-ol {
  display: block;
  font-size: 28rpx;
  color: #3D3A36;
  line-height: 1.8;
  letter-spacing: 1rpx;
  margin-bottom: var(--spacing-sm, 16rpx);
}

.legal-ol:last-child {
  margin-bottom: 0;
}

/* 无序列表：✦ 引导 */
.legal-ul {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin-bottom: var(--spacing-sm, 16rpx);
}

.legal-ul:last-child {
  margin-bottom: 0;
}

.legal-ul-mark {
  flex-shrink: 0;
  margin-top: 8rpx;
  margin-right: var(--spacing-sm, 16rpx);
  font-size: 24rpx;
  color: #C9A97C;
  line-height: 1.6;
}

.legal-ul-text {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #3D3A36;
  line-height: 1.8;
  letter-spacing: 1rpx;
}

/* ── 信息收集表：卡片行 ── */
.legal-table {
  display: flex;
  flex-direction: column;
}

.legal-table-row {
  padding: var(--spacing-sm, 16rpx) 0;
  border-bottom: 1rpx solid rgba(201, 169, 124, 0.16);
}

.legal-table-row:first-child {
  padding-top: 0;
}

.legal-table-row:last-child {
  padding-bottom: 0;
  border-bottom: none;
}

.legal-table-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.legal-table-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  font-family: 'Songti SC', 'STSong', 'SimSun', 'Noto Serif CJK SC', 'Noto Serif SC', serif;
  color: #3D3A36;
  line-height: 1.6;
  letter-spacing: 1rpx;
  padding-right: var(--spacing-sm, 16rpx);
}

.legal-table-required {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #8A8478;
  background: rgba(232, 196, 190, 0.28);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
  letter-spacing: 1rpx;
  line-height: 1.5;
}

.legal-table-required--yes {
  color: #B08F52;
  background: rgba(201, 169, 124, 0.18);
}

.legal-table-usage {
  display: block;
  font-size: 26rpx;
  color: #3D3A36;
  line-height: 1.8;
  letter-spacing: 1rpx;
}

/* ── 页脚：版本号 + 更新日期 ── */
.legal-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: var(--spacing-xl, 48rpx);
  padding-top: var(--spacing-lg, 32rpx);
}

.legal-footer-line {
  width: 60rpx;
  height: 1rpx;
  background: rgba(201, 169, 124, 0.30);
  margin-bottom: var(--spacing-sm, 16rpx);
}

.legal-footer-text {
  font-size: var(--font-size-xs, 20rpx);
  color: #B0AA9C;
  letter-spacing: 2rpx;
  font-family: 'Songti SC', 'STSong', 'SimSun', 'Noto Serif CJK SC', 'Noto Serif SC', serif;
}
