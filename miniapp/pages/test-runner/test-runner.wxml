<view class="page">
  <view class="header">
    <text class="title">星光映照 · 全面质量检测</text>
    <text class="sub">登录 · API · 图片 · 页面 · 特效</text>
  </view>

  <button class="btn-start" bindtap="startTest" wx:if="{{!running && !done}}">开始全面检测</button>

  <view class="progress" wx:if="{{running}}">
    <text class="progress-text">检测中... {{current >= 0 ? current + 1 : 0}}/{{totalPages}}</text>
    <view class="progress-bar"><view class="progress-fill" style="width: {{current >= 0 ? (current+1)/totalPages*100 : 0}}%"></view></view>
  </view>

  <view class="summary" wx:if="{{done}}">
    <text class="s-title">检测结果</text>
    <text class="s-pass">✅ {{passedCount}} 通过</text>
    <text class="s-fail" wx:if="{{failedCount > 0}}">❌ {{failedCount}} 失败</text>
    <button class="btn-retry" bindtap="startTest">重新检测</button>
  </view>

  <!-- Pre-flight: Login + API -->
  <view class="section-title">Pre-flight</view>
  <view class="result-item {{item.errors.length === 0 ? 'pass' : 'fail'}}" wx:for="{{results}}" wx:key="name" wx:if="{{item.path === ''}}">
    <text class="r-status">{{item.errors.length === 0 ? '✅' : '❌'}}</text>
    <text class="r-name">{{item.name}}</text>
    <text class="r-detail" wx:if="{{item.errors.length > 0}}">{{item.errors[0]}}</text>
  </view>

  <!-- API tests -->
  <view class="section-title">API 连通性</view>
  <view class="api-item" wx:for="{{apiResults}}" wx:key="name">
    <text class="r-status">{{item.ok ? '✅' : '❌'}}</text>
    <text class="r-name">{{item.name}}</text>
    <text class="r-detail">{{item.detail}}</text>
  </view>

  <!-- Page tests -->
  <view class="section-title">页面检测 ({{totalPages}}页)</view>
  <view class="result-item {{item.errors.length === 0 ? 'pass' : 'fail'}}" wx:for="{{results}}" wx:key="path" wx:if="{{item.path !== ''}}">
    <view class="result-header">
      <text class="r-status">{{item.errors.length === 0 ? '✅' : '❌'}}</text>
      <text class="r-name">{{item.name}}</text>
      <text class="r-path">{{item.path}}</text>
    </view>
    <view class="result-errors" wx:if="{{item.errors.length > 0}}">
      <text class="error-item" wx:for="{{item.errors}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <!-- Quick nav -->
  <view class="quick-nav">
    <text class="section-title">页面直达</text>
    <view class="quick-grid">
      <view class="quick-item" wx:for="{{PAGES}}" wx:key="path" data-index="{{index}}" bindtap="onPageTap" role="button" aria-label="跳转到{{item.name}}页面">{{item.name}}</view>
    </view>
  </view>
</view>
