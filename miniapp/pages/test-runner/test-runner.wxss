/* pages/test-runner/test-runner.wxss */
.page { background: #1a1a2e; min-height: 100vh; padding: 32rpx; color: #fff; }
.header { text-align: center; margin: 60rpx 0 40rpx; }
.title { font-size: 40rpx; color: #C9A97C; display: block; }
.sub { font-size: 26rpx; color: rgba(255,255,255,0.4); margin-top: 8rpx; display: block; }
.controls { text-align: center; margin: 40rpx 0; }
.btn-start, .btn-retry {
  background: linear-gradient(135deg, #C9A84C, #E0C878);
  color: #1a1a2e; font-size: 30rpx; font-weight: 600;
  border-radius: 48rpx; padding: 20rpx 64rpx; border: none;
}
.progress { margin: 32rpx 0; }
.progress-text { font-size: 26rpx; color: #9A95B8; display: block; margin-bottom: 12rpx; }
.progress-bar { height: 8rpx; background: rgba(255,255,255,0.1); border-radius: 4rpx; overflow: hidden; }
.progress-fill { height: 100%; background: #C9A84C; transition: width 0.3s; }
.summary { text-align: center; margin: 32rpx 0; }
.summary-pass { font-size: 32rpx; color: #4CAF50; margin-right: 32rpx; }
.summary-fail { font-size: 32rpx; color: #F44336; }
.results { margin: 32rpx 0; }
.result-item { background: rgba(255,255,255,0.05); border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; }
.result-item.pass { border-left: 6rpx solid #4CAF50; }
.result-item.fail { border-left: 6rpx solid #F44336; }
.result-header { display: flex; align-items: center; gap: 12rpx; }
.result-status { font-size: 28rpx; }
.result-name { font-size: 28rpx; color: #C9A97C; font-weight: 600; }
.result-path { font-size: 22rpx; color: rgba(255,255,255,0.3); margin-left: auto; }
.result-errors { margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid rgba(255,255,255,0.1); }
.error-item { font-size: 22rpx; color: #F44336; display: block; margin-bottom: 8rpx; word-break: break-all; }
.quick-nav { margin: 48rpx 0; }
.quick-title { font-size: 26rpx; color: rgba(255,255,255,0.4); display: block; margin-bottom: 16rpx; }
.quick-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.quick-item { background: rgba(255,255,255,0.08); border-radius: 12rpx; padding: 16rpx 24rpx; }
.quick-item text { font-size: 24rpx; color: #9A95B8; }
