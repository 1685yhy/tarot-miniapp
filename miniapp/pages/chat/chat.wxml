<!-- pages/chat/chat.wxml -->
<!-- ============================================================
     "A Quiet Conversation Under the Stars"
     Intimate late-night follow-up after a tarot reading
     ============================================================ -->

<view class="container">

  <!-- ===== Loading skeleton ===== -->
  <view wx:if="{{pageLoading}}" class="skeleton-wrap">
    <view class="skeleton-block">
      <view class="skeleton skeleton-line" style="width:32%"></view>
      <view class="skeleton skeleton-bubble left"></view>
    </view>
    <view class="skeleton-block">
      <view class="skeleton skeleton-bubble right" style="width:45%"></view>
    </view>
    <view class="skeleton-block">
      <view class="skeleton skeleton-line" style="width:48%"></view>
      <view class="skeleton skeleton-bubble left" style="width:70%"></view>
    </view>
    <view class="skeleton-block">
      <view class="skeleton skeleton-bubble right" style="width:38%"></view>
    </view>
  </view>

  <!-- ===== Context header — tiny lavender reminder ===== -->
  <view wx:if="{{readingContext && !pageLoading && !pageError}}" class="ctx-header">
    <text class="ctx-label">关于「{{readingContext.spreadTypeName}}」的追问</text>
    <text wx:if="{{readingContext.question}}" class="ctx-question">{{readingContext.question}}</text>
  </view>

  <!-- ===== Empty state — warm invitation ===== -->
  <view wx:elif="{{messages.length === 0 && !pageLoading && !pageError}}" class="empty-wrap">
    <view class="empty-inner">
      <view class="empty-glow"></view>
      <text class="empty-heading">关于这次解读，还有什么想了解的？</text>
      <text class="empty-sub">星光在这里倾听你的每一个问题</text>
    </view>
  </view>

  <!-- ===== Error state ===== -->
  <view wx:elif="{{pageError && !readingContext}}" class="error-state">
    <image class="error-icon" src="/images/icons/warning_64.png" mode="aspectFit" aria-label="错误" />
    <text class="error-text">星光暂时无法回应</text>
    <text class="error-hint">{{pageError}}</text>
    <button class="retry-btn" bindtap="onRetry">再试一次</button>
    <button class="retry-btn" bindtap="onGoHome" style="margin-top:16rpx;background:transparent;color:var(--color-gold);border:1px solid rgba(244,212,140,0.3);">回到首页</button>
  </view>

  <!-- ===== Message list ===== -->
  <view wx:elif="{{!pageLoading}}" class="msg-list">
    <block wx:for="{{messages}}" wx:key="index">
      <!-- User message -->
      <view wx:if="{{item.role === 'user'}}" class="msg-wrap msg-user msg-enter">
        <text class="role-label role-user">你</text>
        <view class="msg-bubble bubble-user {{item.failed ? 'bubble-failed' : ''}}" data-failed="{{item.failed}}" bindtap="onRetrySend" role="button" aria-label="重试发送">
          <text class="msg-text msg-text-user">{{item.content}}</text>
          <text wx:if="{{item.failed}}" class="msg-failed-hint">发送失败 · 点击重试</text>
        </view>
      </view>
      <!-- AI / reader message -->
      <view wx:else class="msg-wrap msg-ai msg-enter">
        <text class="role-label role-ai">解读者</text>
        <view class="msg-bubble bubble-ai">
          <text class="msg-text msg-text-ai">{{item.content}}</text>
          <text class="cursor-blink" wx:if="{{item.streaming}}">|</text>
        </view>
      </view>
    </block>

    <!-- ===== Typing indicator ===== -->
    <view wx:if="{{aiThinking}}" class="msg-wrap msg-ai msg-enter">
      <text class="role-label role-typing">星光正在回应...</text>
      <view class="typing-box">
        <view class="typing-dot"></view>
        <view class="typing-dot"></view>
        <view class="typing-dot"></view>
      </view>
    </view>

    <view id="chat-bottom"></view>

    <!-- ===== 发送失败重试 ===== -->
    <view wx:if="{{sendFailed}}" class="retry-bar" bindtap="onRetrySend" data-failed="true" role="button" aria-label="重试发送">
      <image class="retry-icon" src="/images/icons/warning_64.png" mode="aspectFit" aria-label="发送失败" />
      <text class="retry-text">发送失败，点击重试</text>
    </view>

    <!-- ===== 追问次数耗尽 — 简洁文字提示 ===== -->
    <view class="quota-exhausted" wx:if="{{showMembershipPrompt}}">
      <text class="quota-exhausted-text">今日追问次数已用完</text>
    </view>
  </view>

</view>

<!-- ===== Input area — fixed bottom ===== -->
<view class="input-bar">
  <label class="input-wrap">
    <textarea class="chat-input" placeholder="写下你想问的..."
      placeholder-class="input-placeholder"
      value="{{inputText}}" bindinput="onInput"
      auto-height="{{true}}" maxlength="1000"
      show-confirm-bar="{{false}}"
      cursor-spacing="12"
      adjust-position="{{true}}"
    />
  </label>
  <view class="send-btn {{sending || !canSend ? 'send-btn--disabled' : ''}}"
    bindtap="onSend" aria-label="发送" role="button"
  >
    <text class="send-text">发送</text>
  </view>
</view>

<view class="free-quota-bar">
  <text class="quota-text" wx:if="{{remainingFree > 0}}">剩余 {{remainingFree}} 次追问</text>
  <text class="quota-text quota-text--exhausted" wx:elif="{{remainingFree === 0}}">今日可用追问已用完</text>
  <text class="quota-text" wx:else>无限次追问 · 会员专享</text>
</view>

<!-- Back to Home removed — native nav bar provides back button -->
