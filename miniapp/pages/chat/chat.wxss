/* ============================================================
   Chat Page — Starlight Design System
   Dark indigo chat · Cream bubbles · Gold accents
   ============================================================ */

/* ---- Design Tokens ---- */
page {
  --gold: #F4D48C;
  --gold-light: #FADE9E;
  --gold-glow: rgba(244, 212, 140, 0.35);
  --gold-dim: rgba(244, 212, 140, 0.15);
  --bg-deep: #1A1A3E;
  --bg-card: #252550;
  --bg-elevated: #1e1a38;
  --bg-user: #252550;
  --bg-ai: #2A2A5A;
  --cream: #F0EDE8;
  --cream-dim: #e0d8c4;
  --text-primary: #e8e4f0;
  --text-secondary: #b8b0d0;
  --text-tertiary: #A098C0;
  --radius-sm: 12rpx;
  --radius-md: 18rpx;
  --radius-lg: 24rpx;
  --radius-round: 999rpx;
  --radius-bubble: 18rpx;
  --space-xs: 6rpx;
  --space-sm: 12rpx;
  --space-md: 20rpx;
  --space-lg: 28rpx;
  --space-xl: 36rpx;
  --space-xxl: 48rpx;
  --space-xxxl: 64rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  background: var(--bg-deep);
  color: var(--text-primary);
  font-size: 28rpx;
  line-height: 1.6;
  min-height: 100vh;
  overflow-x: hidden;
}

/* ================================================================
   Container
   ================================================================ */
.container {
  padding: var(--space-xl) var(--space-xl) 320rpx;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: 1;
  box-sizing: border-box;
}

/* ================================================================
   Animations
   ================================================================ */
.anim-fade-in {
  animation: fadeIn 0.4s ease both;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.msg-enter {
  animation: msgSlideUp 0.45s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes msgSlideUp {
  0% { opacity: 0; transform: translateY(20rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

.msg-user .msg-bubble {
  animation: slideInRight 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes slideInRight {
  0% { opacity: 0; transform: translateX(30rpx); }
  100% { opacity: 1; transform: translateX(0); }
}

.msg-ai .msg-bubble {
  animation: slideInLeft 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes slideInLeft {
  0% { opacity: 0; transform: translateX(-30rpx); }
  100% { opacity: 1; transform: translateX(0); }
}

/* ================================================================
   Typing indicator — golden bouncing dots
   ================================================================ */
.typing-indicator {
  margin-bottom: var(--space-xl);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.bubble-typing {
  padding: var(--space-lg) var(--space-xl);
  min-height: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.typing-dots {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.typing-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--gold-light), var(--gold));
  animation: typingBounce 1.4s ease-in-out infinite;
}

.typing-dot:nth-child(2) { animation-delay: 0.2s; }
.typing-dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes typingBounce {
  0%, 80%, 100% {
    transform: translateY(0) scale(0.7);
    opacity: 0.35;
  }
  40% {
    transform: translateY(-10rpx) scale(1);
    opacity: 1;
  }
}

/* ================================================================
   Empty / Intro state
   ================================================================ */
.chat-intro {
  text-align: center;
  padding: var(--space-xxxl) 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.empty-text {
  font-size: 30rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: var(--space-sm);
  letter-spacing: 2rpx;
  line-height: 1.6;
}

.empty-hint {
  font-size: 24rpx;
  color: var(--text-tertiary);
  display: block;
  line-height: 1.6;
  letter-spacing: 1rpx;
}

/* ================================================================
   Error state
   ================================================================ */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx var(--space-xl);
  text-align: center;
}

.error-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: var(--space-sm);
  display: block;
}

.error-hint {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-bottom: var(--space-xxl);
  display: block;
}

/* ---- Shared button — golden pill ---- */
.btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-sm);
  padding: 20rpx 48rpx;
  border: none;
  border-radius: var(--radius-round);
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A3E;
  background: linear-gradient(135deg, var(--gold-light), var(--gold));
  box-shadow: 0 4rpx 24rpx var(--gold-glow);
  transition: all 0.25s;
}

.btn-primary::after { border: none; }
.btn-primary:active { transform: scale(0.96); }

.btn-small {
  padding: 16rpx 36rpx;
  font-size: 24rpx;
}

/* ================================================================
   Reading context bar
   ================================================================ */
.reading-context-bar {
  border-radius: var(--radius-lg);
  padding: var(--space-md) var(--space-lg);
  margin-bottom: var(--space-xl);
  background: var(--bg-card);
  border: 1.5rpx solid var(--gold-dim);
  border-left: 4rpx solid var(--gold);
  box-shadow: 0 2rpx 20rpx rgba(212, 175, 55, 0.05);
}

.context-label {
  font-size: 22rpx;
  color: var(--gold);
  font-weight: 600;
  display: block;
  margin-bottom: var(--space-xs);
  letter-spacing: 3rpx;
  text-transform: uppercase;
}

.context-question {
  font-size: 24rpx;
  color: var(--text-primary);
  display: block;
  margin-bottom: 4rpx;
  line-height: 1.5;
}

.context-spread {
  font-size: 22rpx;
  color: var(--text-tertiary);
  display: block;
}

/* ================================================================
   Message list
   ================================================================ */
.message-list {
  flex: 1;
  margin-bottom: 20rpx;
}

.msg-item {
  margin-bottom: var(--space-xl);
  display: flex;
  flex-direction: column;
}

.msg-user {
  align-items: flex-end;
}

.msg-ai {
  align-items: flex-start;
}

/* ---- Role label ---- */
.text-caption {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-bottom: var(--space-xs);
}

/* ================================================================
   Chat bubbles
   ================================================================ */
.msg-bubble {
  padding: var(--space-lg) var(--space-xl);
  max-width: 85%;
  position: relative;
  line-height: 1.7;
}

.msg-text {
  font-size: 28rpx;
  white-space: pre-wrap;
  word-break: break-word;
  color: var(--cream);
}

/* ---- User bubble: #252550 card bg, right-aligned ---- */
.bubble-user {
  background: var(--bg-user);
  border-radius: var(--radius-bubble) 4rpx var(--radius-bubble) var(--radius-bubble);
  border: 1rpx solid rgba(255, 255, 255, 0.04);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.15);
}

/* ---- AI bubble: #2A2A5A lighter bg, left-aligned, gold left border ---- */
.bubble-ai {
  background: var(--bg-ai);
  border-radius: 4rpx var(--radius-bubble) var(--radius-bubble) var(--radius-bubble);
  border: 1rpx solid var(--gold-dim);
  border-left: 3rpx solid var(--gold);
  box-shadow: 0 2rpx 16rpx rgba(212, 175, 55, 0.08);
}

/* ================================================================
   Input bar — fixed bottom
   ================================================================ */
.input-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: var(--space-md) var(--space-xl);
  padding-bottom: calc(env(safe-area-inset-bottom) + var(--space-md));
  background: rgba(26, 26, 62, 0.97);
  border-top: 1.5rpx solid var(--gold-dim);
  gap: var(--space-sm);
  z-index: 100;
}

.chat-input {
  flex: 1;
  height: 72rpx;
  background: var(--bg-elevated);
  border-radius: var(--radius-round);
  padding: 0 var(--space-xl);
  font-size: 28rpx;
  color: var(--cream);
  border: 1.5rpx solid rgba(212, 175, 55, 0.1);
  transition: border-color 0.25s, box-shadow 0.25s;
  caret-color: var(--gold);
}

.chat-input:focus {
  border-color: var(--gold);
  box-shadow: 0 0 0 3rpx rgba(244, 212, 140, 0.12);
}

.chat-input::placeholder {
  color: #8A85A8;
}

/* ---- Send button: golden pill ---- */
.send-btn {
  width: 120rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: linear-gradient(135deg, var(--gold-light), var(--gold));
  color: #1A1A3E;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: var(--radius-round);
  border: none;
  padding: 0;
  transition: all 0.25s;
  box-shadow: 0 4rpx 16rpx var(--gold-glow);
}

.send-btn::after { border: none; }

.send-btn:active:not([disabled]) {
  transform: scale(0.94);
}

.send-btn[disabled] {
  opacity: 0.35;
}

/* ================================================================
   Free query hint
   ================================================================ */
.free-hint {
  text-align: center;
  padding: var(--space-sm) 0;
  font-size: 22rpx;
  color: var(--text-tertiary);
  position: fixed;
  bottom: 112rpx;
  left: 0;
  right: 0;
}

/* ================================================================
   Skeleton loading — dark indigo shimmer
   ================================================================ */
.skeleton-messages {
  flex: 1;
  padding: var(--space-xl);
}

.skeleton-msg {
  margin-bottom: var(--space-xl);
}

.skeleton-bubble {
  height: 72rpx;
  border-radius: var(--radius-lg);
  background: linear-gradient(90deg, var(--bg-card) 25%, var(--bg-elevated) 50%, var(--bg-card) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.6s infinite;
}

.skeleton-bubble.left { width: 60%; }
.skeleton-bubble.right { width: 50%; margin-left: auto; }

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ================================================================
   Scrollbar hidden
   ================================================================ */
::-webkit-scrollbar {
  width: 0;
  height: 0;
}
