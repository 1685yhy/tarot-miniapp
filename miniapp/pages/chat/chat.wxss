/* ============================================================
   Chat — Warm Paper Design System
   Warm ivory base, deep rose accent, sage subtle
   Chat bubbles, input bar, reading context bar
   ============================================================ */

/* -----------------------------------------------------------
   1. CONTAINER
   ----------------------------------------------------------- */

.container {
  padding: var(--page-padding) var(--page-padding) 320rpx;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: var(--z-base);
  box-sizing: border-box;
}

/* -----------------------------------------------------------
   2. ANIMATIONS
   ----------------------------------------------------------- */

.anim-fade-in {
  animation: fade-in var(--duration-navigation) ease both;
}

.msg-enter {
  animation: msg-slide-up var(--duration-emphasis) ease both;
}

@keyframes msg-slide-up {
  0% { opacity: 0; transform: translateY(20rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

.msg-user .msg-bubble {
  animation: slide-in-right var(--duration-emphasis) ease both;
}

@keyframes slide-in-right {
  0% { opacity: 0; transform: translateX(30rpx); }
  100% { opacity: 1; transform: translateX(0); }
}

.msg-ai .msg-bubble {
  animation: slide-in-left var(--duration-emphasis) ease both;
}

@keyframes slide-in-left {
  0% { opacity: 0; transform: translateX(-30rpx); }
  100% { opacity: 1; transform: translateX(0); }
}

/* -----------------------------------------------------------
   3. TYPING INDICATOR
   ----------------------------------------------------------- */

.typing-indicator {
  margin-bottom: var(--spacing-6);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.bubble-typing {
  padding: var(--spacing-5) var(--spacing-6);
  min-height: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.typing-dots {
  display: flex;
  align-items: center;
  gap: var(--spacing-3);
}

.typing-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: var(--radius-pill);
  background: var(--color-accent);
  opacity: 0.30;
  animation: typing-bounce 1.4s ease-in-out infinite;
}

.typing-dot:nth-child(2) { animation-delay: 0.2s; }
.typing-dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes typing-bounce {
  0%, 80%, 100% {
    transform: translateY(0);
    opacity: 0.30;
  }
  40% {
    transform: translateY(-10rpx);
    opacity: 0.80;
  }
}

/* -----------------------------------------------------------
   4. EMPTY / INTRO STATE
   ----------------------------------------------------------- */

.chat-intro {
  text-align: center;
  padding: var(--spacing-7) 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.empty-icon {
  width: 72rpx;
  height: 72rpx;
  display: block;
  margin-bottom: var(--spacing-6);
  opacity: 0.50;
}

.empty-text {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--spacing-3);
}

.empty-hint {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  display: block;
  line-height: var(--line-height-body);
  opacity: 0.70;
}

/* -----------------------------------------------------------
   5. ERROR STATE
   ----------------------------------------------------------- */

.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-8) var(--spacing-6);
  text-align: center;
}

.error-icon {
  width: 72rpx;
  height: 72rpx;
  margin-bottom: var(--spacing-5);
  display: block;
  opacity: 0.30;
}

.error-text {
  font-size: var(--font-size-body-large);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-3);
  display: block;
}

.error-hint {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  margin-bottom: var(--spacing-6);
  display: block;
}

/* -----------------------------------------------------------
   6. BUTTONS
   ----------------------------------------------------------- */

.btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-3);
  padding: var(--spacing-5) var(--spacing-7);
  border: none;
  border-radius: var(--radius-pill);
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-semibold);
  color: var(--color-surface);
  background: var(--color-accent);
  box-shadow: var(--shadow-subtle);
  transition: all var(--duration-feedback) ease;
}

.btn-primary:active { transform: scale(0.97); opacity: 0.90; }

.btn-small {
  padding: var(--spacing-4) var(--spacing-6);
  font-size: var(--font-size-body);
}

/* -----------------------------------------------------------
   7. READING CONTEXT BAR
   ----------------------------------------------------------- */

.reading-context-bar {
  border-radius: var(--radius-medium);
  padding: var(--spacing-4) var(--spacing-5);
  margin-bottom: var(--spacing-6);
  background: var(--color-surface);
  border: 1rpx solid rgba(139, 126, 110, 0.12);
  border-left: 3rpx solid var(--color-accent);
  box-shadow: var(--shadow-subtle);
}

.context-label {
  font-size: var(--font-size-body);
  color: var(--color-accent);
  font-weight: var(--font-weight-semibold);
  display: block;
  margin-bottom: var(--spacing-3);
  letter-spacing: var(--letter-spacing-none);
}

.context-question {
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  display: block;
  margin-bottom: 4rpx;
  line-height: var(--line-height-body);
}

.context-spread {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  display: block;
  opacity: 0.70;
}

/* -----------------------------------------------------------
   8. MESSAGE LIST
   ----------------------------------------------------------- */

.message-list {
  flex: 1;
  margin-bottom: var(--spacing-5);
}

.msg-item {
  margin-bottom: var(--spacing-6);
  display: flex;
  flex-direction: column;
}

.msg-user {
  align-items: flex-end;
}

.msg-ai {
  align-items: flex-start;
}

/* Role label */
.text-caption {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  margin-bottom: var(--spacing-3);
  opacity: 0.70;
}

/* -----------------------------------------------------------
   9. CHAT BUBBLES
   ----------------------------------------------------------- */

.msg-bubble {
  padding: var(--spacing-5) var(--spacing-6);
  max-width: 85%;
  position: relative;
  line-height: var(--line-height-body);
}

.msg-text {
  font-size: var(--font-size-body);
  white-space: pre-wrap;
  word-break: break-word;
}

/* User bubble — right-aligned */
.bubble-user {
  background: var(--color-surface);
  border-radius: var(--radius-medium) var(--radius-small) var(--radius-medium) var(--radius-medium);
  border: 1rpx solid rgba(139, 126, 110, 0.12);
  box-shadow: var(--shadow-subtle);
}

.bubble-user .msg-text {
  color: var(--color-text-primary);
}

/* AI bubble — left-aligned */
.bubble-ai {
  background: var(--color-surface);
  border-radius: var(--radius-small) var(--radius-medium) var(--radius-medium) var(--radius-medium);
  border: 1rpx solid rgba(139, 126, 110, 0.12);
  border-left: 3rpx solid var(--color-accent);
  box-shadow: var(--shadow-subtle);
}

.bubble-ai .msg-text {
  color: var(--color-text-primary);
}

/* -----------------------------------------------------------
   10. INPUT BAR — Fixed bottom
   ----------------------------------------------------------- */

.input-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: var(--spacing-4) var(--page-padding);
  padding-bottom: calc(var(--safe-area-bottom) + var(--spacing-4));
  background: var(--color-surface);
  border-top: 1rpx solid rgba(139, 126, 110, 0.12);
  gap: var(--spacing-3);
  z-index: var(--z-sticky);
  box-shadow: 0 -2rpx 8rpx rgba(61, 50, 40, 0.04);
}

.chat-input {
  flex: 1;
  height: 72rpx;
  background: var(--color-bg);
  border-radius: var(--radius-pill);
  padding: 0 var(--spacing-6);
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  border: 1rpx solid rgba(139, 126, 110, 0.15);
  transition: border-color var(--duration-feedback) ease, box-shadow var(--duration-feedback) ease;
  caret-color: var(--color-accent);
}

.chat-input:focus {
  border-color: var(--color-accent);
  box-shadow: 0 0 0 2rpx rgba(176, 102, 80, 0.10);
}

.chat-input::placeholder {
  color: var(--color-text-secondary);
  opacity: 0.50;
}

/* Send button */
.send-btn {
  width: 120rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: var(--color-accent);
  color: var(--color-surface);
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-semibold);
  border-radius: var(--radius-pill);
  border: none;
  padding: 0;
  transition: all var(--duration-feedback) ease;
  box-shadow: var(--shadow-subtle);
}

.send-btn:active:not([disabled]) {
  transform: scale(0.94);
  opacity: 0.90;
}

.send-btn[disabled] {
  opacity: 0.30;
  box-shadow: none;
  pointer-events: none;
}

/* -----------------------------------------------------------
   11. FREE QUERY HINT
   ----------------------------------------------------------- */

.free-hint {
  text-align: center;
  padding: var(--spacing-3) 0;
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  position: fixed;
  bottom: 112rpx;
  left: 0;
  right: 0;
  opacity: 0.60;
}

/* -----------------------------------------------------------
   12. SKELETON LOADING
   ----------------------------------------------------------- */

.skeleton-messages {
  flex: 1;
  padding: var(--spacing-6);
}

.skeleton-msg {
  margin-bottom: var(--spacing-6);
}

.skeleton-bubble {
  height: 72rpx;
  border-radius: var(--radius-medium);
  background: rgba(139, 126, 110, 0.08);
  animation: pulse-soft 1500ms ease-in-out infinite;
}

.skeleton-bubble.left { width: 60%; }
.skeleton-bubble.right { width: 50%; margin-left: auto; }

/* -----------------------------------------------------------
   13. SCROLLBAR
   ----------------------------------------------------------- */

::-webkit-scrollbar {
  width: 0;
  height: 0;
}
