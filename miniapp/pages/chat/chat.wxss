/* ============================================================
   Chat Page — "A Quiet Conversation Under the Stars"
   Intimate late-night follow-up about a tarot reading
   ============================================================ */

page {
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue',
               'PingFang SC', 'Microsoft YaHei', sans-serif;
}

/* ================================================================
   Container
   ================================================================ */
.container {
  padding: var(--spacing-lg) var(--spacing-lg) 260rpx;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: 1;
  box-sizing: border-box;
}

/* ================================================================
   Animations — message entrance
   ================================================================ */
@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

@keyframes msgSlideUp {
  0%   { opacity: 0; transform: translateY(20rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

@keyframes slideFadeRight {
  0%   { opacity: 0; transform: translateX(24rpx); }
  100% { opacity: 1; transform: translateX(0); }
}

@keyframes slideFadeLeft {
  0%   { opacity: 0; transform: translateX(-24rpx); }
  100% { opacity: 1; transform: translateX(0); }
}

.msg-enter {
  animation: msgSlideUp 0.35s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.msg-user .msg-bubble {
  animation: slideFadeRight 0.35s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.msg-ai .msg-bubble {
  animation: slideFadeLeft 0.35s cubic-bezier(0.22, 1, 0.36, 1) both;
}

/* ================================================================
   Skeleton loading — Shapes only (shimmer from common.wxss)
   ================================================================ */
.skeleton-wrap {
  flex: 1;
  padding: var(--spacing-sm) 0;
}

.skeleton-block {
  margin-bottom: 40rpx;
}

.skeleton-line {
  height: 20rpx;
  border-radius: var(--radius-pill);
  background-image: linear-gradient(90deg, var(--color-surface) 25%, var(--color-surface) 50%, var(--color-surface) 75%);
  margin-bottom: 12rpx;
}

.skeleton-bubble {
  height: 68rpx;
  border-radius: var(--radius-lg);
  background-image: linear-gradient(90deg, var(--color-surface) 25%, var(--color-surface) 50%, var(--color-surface) 75%);
}

.skeleton-bubble.left  { width: 60%; }
.skeleton-bubble.right { width: 50%; margin-left: auto; }

/* ================================================================
   Context header — tiny lavender reminder
   ================================================================ */
.ctx-header {
  padding: 0 4rpx 28rpx;
  text-align: center;
}

.ctx-label {
  font-size: var(--font-size-caption);
  color: var(--color-lavender);
  letter-spacing: 2rpx;
  line-height: 1.5;
  display: block;
}

.ctx-question {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  display: block;
  margin-top: 4rpx;
  line-height: 1.4;
  /* clamp to 1 line with ellipsis */
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 70%;
  margin-left: auto;
  margin-right: auto;
}

/* ================================================================
   Empty state — warm invitation
   ================================================================ */
.empty-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-2xl) var(--spacing-xl) 120rpx;
}

.empty-inner {
  text-align: center;
  position: relative;
}

.empty-glow {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: radial-gradient(circle, var(--color-gold-glow) 0%, transparent 70%);
  margin: 0 auto 36rpx;
  animation: breath 3s ease-in-out infinite;
}

@keyframes breath {
  0%, 100% { transform: scale(0.95); opacity: 0.6; }
  50%      { transform: scale(1.05); opacity: 1; }
}

.empty-heading {
  display: block;
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  line-height: 1.7;
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
}

.empty-sub {
  display: block;
  font-size: var(--font-size-caption);
  color: var(--color-lavender);
  line-height: 1.6;
  letter-spacing: 1rpx;
}

/* ================================================================
   Error state
   ================================================================ */
.error-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx var(--spacing-xl);
  text-align: center;
}

.error-icon {
  font-size: var(--font-size-title);
  color: var(--color-gold-glow);
  margin-bottom: 24rpx;
  display: block;
}

.error-text {
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  margin-bottom: 12rpx;
  display: block;
}

.error-hint {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  margin-bottom: 40rpx;
  display: block;
  line-height: 1.5;
}

.retry-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-md) var(--spacing-xl);
  border: none;
  border-radius: var(--radius-pill);
  font-size: var(--font-size-caption);
  color: var(--color-bg);
  background: linear-gradient(135deg, var(--color-gold-light), var(--color-gold));
  box-shadow: 0 4rpx 20rpx var(--color-gold-glow-strong);
  transition: all 0.15s ease-out;
}

.retry-btn::after { border: none; }
.retry-btn:active { transform: scale(0.96); }

/* ================================================================
   Message list
   ================================================================ */
.msg-list {
  flex: 1;
}

.msg-wrap {
  margin-bottom: 36rpx;
  display: flex;
  flex-direction: column;
}

.msg-user {
  align-items: flex-end;
}

.msg-ai {
  align-items: flex-start;
}

/* ================================================================
   Role labels
   ================================================================ */
.role-label {
  font-size: var(--font-size-xs);
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
  display: block;
  padding: 0 6rpx;
}

.role-user {
  color: var(--color-lavender);
}

.role-ai {
  color: var(--color-gold);
}

.role-typing {
  color: var(--color-lavender);
}

/* ================================================================
   Message bubbles
   ================================================================ */
.msg-bubble {
  padding: var(--spacing-md) var(--spacing-md);
  max-width: 82%;
  position: relative;
  line-height: 1.7;
}

.msg-text {
  white-space: pre-wrap;
  word-break: break-word;
}

/* ---- User bubble: compact, warm dark card, gold left-accent ---- */
.bubble-user {
  background: var(--color-surface);
  border-radius: 18rpx 4rpx 18rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.03);
  border-left: 2rpx solid var(--color-gold-glow);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.18);
}

.msg-text-user {
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  line-height: 1.6;
}

/* ---- AI bubble: lighter card, gold left-margin line ---- */
.bubble-ai {
  background: var(--color-card);
  border-radius: 4rpx 18rpx 18rpx 18rpx;
  border: 1rpx solid rgba(244, 212, 140, 0.08);
  border-left: 3rpx solid var(--color-gold);
  box-shadow: 0 2rpx 20rpx rgba(212, 175, 55, 0.06);
}

.msg-text-ai {
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  line-height: 1.7;
}

/* ================================================================
   Typing indicator — pulsing gold dots
   ================================================================ */
.typing-box {
  display: flex;
  align-items: center;
  gap: var(--spacing-xxs);
  background: var(--color-card);
  border-radius: 4rpx 18rpx 18rpx 18rpx;
  border: 1rpx solid rgba(244, 212, 140, 0.08);
  border-left: 3rpx solid var(--color-gold);
  padding: var(--spacing-md) var(--spacing-lg);
  min-height: 28rpx;
}

.typing-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-gold-light), var(--color-gold));
  animation: typingPulse 1.4s ease-in-out infinite;
}

.typing-dot:nth-child(2) { animation-delay: 0.2s; }
.typing-dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes typingPulse {
  0%, 80%, 100% {
    transform: translateY(0) scale(0.7);
    opacity: 0.35;
  }
  40% {
    transform: translateY(-8rpx) scale(1);
    opacity: 1;
  }
}

/* ================================================================
   Input area — fixed at bottom
   ================================================================ */
.input-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  padding: var(--spacing-sm) var(--spacing-lg);
  padding-bottom: calc(env(safe-area-inset-bottom) + 20rpx);
  background: rgba(26, 26, 62, 0.97);
  border-top: 1.5rpx solid rgba(244, 212, 140, 0.08);
  z-index: 100;
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
}

.input-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
}

.chat-input {
  width: 100%;
  height: 72rpx;
  background: rgba(30, 26, 56, 0.85);
  border-radius: var(--radius-pill);
  padding: 0 32rpx;
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  border: 1.5rpx solid rgba(244, 212, 140, 0.12);
  transition: border-color 0.2s, box-shadow 0.2s;
  caret-color: var(--color-gold);
  box-sizing: border-box;
}

.chat-input:focus {
  border-color: var(--color-gold);
  box-shadow: 0 0 0 4rpx rgba(244, 212, 140, 0.10);
}

.input-placeholder {
  color: var(--color-text-tertiary);
}

/* ---- Send button: compact gold pill — "casting the spell" ---- */
.send-btn {
  height: 72rpx;
  padding: 0 36rpx;
  border-radius: var(--radius-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--color-gold-light), var(--color-gold));
  box-shadow: 0 4rpx 16rpx rgba(244, 212, 140, 0.25);
  transition: transform 0.15s ease-out, box-shadow 0.15s ease-out;
  flex-shrink: 0;
}

.send-btn:active {
  transform: scale(0.94);
  box-shadow: 0 2rpx 8rpx rgba(244, 212, 140, 0.15);
}

.send-btn--disabled {
  opacity: 0.3;
  pointer-events: none;
}

.send-text {
  font-size: var(--font-size-caption);
  font-weight: 700;
  color: var(--color-bg);
  letter-spacing: 4rpx;
  line-height: 1;
}

/* ================================================================
   Free query hint — progress bar
   ================================================================ */
.free-quota-bar {
  text-align: center;
  padding: var(--spacing-xs) 0 var(--spacing-md);
  position: fixed;
  bottom: 106rpx;
  left: 0;
  right: 0;
  letter-spacing: 1rpx;
}

.quota-progress-wrap {
  width: 200rpx;
  height: 6rpx;
  background: rgba(184, 169, 224, 0.12);
  border-radius: 999rpx;
  margin: 0 auto var(--spacing-xxs);
  overflow: hidden;
}

.quota-progress {
  height: 100%;
  background: linear-gradient(90deg, #F4D48C, #D4B06A);
  border-radius: 999rpx;
  transition: width 0.4s ease-out;
}

.quota-text {
  font-size: var(--font-size-xs);
  color: var(--color-lavender, #C8B8E8);
  line-height: 1.6;
}

.quota-text--exhausted {
  color: var(--color-gold, #F4D48C);
  font-weight: 500;
}

/* ================================================================
   Scrollbar hidden
   ================================================================ */
::-webkit-scrollbar {
  width: 0;
  height: 0;
}

/* ================================================================
   Retry bar for failed send
   ================================================================ */
.retry-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-xxs);
  padding: var(--spacing-sm);
  margin: var(--spacing-xs) 0;
  background: rgba(232, 122, 138, 0.08);
  border-radius: var(--radius-md);
  border: 1rpx solid rgba(232, 122, 138, 0.20);
  cursor: pointer;
}

.retry-bar:active {
  background: rgba(232, 122, 138, 0.15);
}

.retry-icon {
  font-size: var(--font-size-caption);
  color: var(--color-error);
}

.retry-text {
  font-size: var(--font-size-caption);
  color: var(--color-error);
}

/* ================================================================
   Failed message bubble
   ================================================================ */
.bubble-failed {
  border: 1rpx solid rgba(232, 122, 138, 0.40) !important;
  opacity: 0.75;
}

.msg-failed-hint {
  font-size: 20rpx;
  color: var(--color-error);
  display: block;
  margin-top: 8rpx;
  text-align: right;
}

/* ================================================================
   Textarea styles (replaces input)
   ================================================================ */
.chat-input {
  width: 100%;
  min-height: 72rpx;
  max-height: 240rpx;
  padding: var(--spacing-sm) var(--spacing-md);
  border-radius: var(--radius-pill);
  background: var(--color-surface);
  border: 2rpx solid transparent;
  color: var(--color-text-primary);
  font-size: var(--font-size-body);
  line-height: 1.5;
  box-sizing: border-box;
}

/* ================================================================
   ACCESSIBILITY: Reduced Motion
   ================================================================ */
@media (prefers-reduced-motion: reduce) {
  .msg-enter { animation: none; }
  .msg-user .msg-bubble, .msg-ai .msg-bubble { animation: none; }
  .empty-glow { animation: none; }
}
