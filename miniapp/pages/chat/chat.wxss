/* ===== 聊天 - 柔语花间主题 (Soft Whispers) ===== */
/*    温暖对话气泡，如午后茶叙，轻轻柔柔                  */

/* ---------------------------------------------------------------
   Container — 奶油底色
   --------------------------------------------------------------- */
.container {
  padding: var(--space-xl);
  padding-bottom: 280rpx;
  background: linear-gradient(180deg, #FFF8F5 0%, #FFF5F0 100%);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* ---------------------------------------------------------------
   Chat Intro — 空状态（花间小憩）
   --------------------------------------------------------------- */
.chat-intro {
  text-align: center;
  padding: var(--space-massive) 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.chat-intro-symbol {
  font-size: 80rpx;
  display: block;
  margin-bottom: var(--space-xl);
  opacity: 0.6;
  animation: float 5s var(--ease-in-out) infinite;
}

.chat-intro-title {
  font-size: var(--fs-h4);
  color: #D4836A;
  font-weight: var(--fw-semibold);
  display: block;
  margin-bottom: var(--space-sm);
  letter-spacing: 2rpx;
}

.chat-intro-sub {
  font-size: var(--fs-body);
  color: #9A8A8A;
  display: block;
  line-height: var(--lh-normal);
}

/* ---------------------------------------------------------------
   Message List
   --------------------------------------------------------------- */
.message-list {
  flex: 1;
  margin-bottom: 20rpx;
}

.msg-item {
  margin-bottom: var(--space-xl);
  display: flex;
  flex-direction: column;
}

/* ---------- User bubble — 玫瑰色低语 ---------- */
.msg-item.user {
  align-items: flex-end;
}

.msg-item.ai {
  align-items: flex-start;
}

.msg-label {
  font-size: var(--fs-caption);
  color: #9A8A8A;
  margin-bottom: var(--space-xs);
  padding: 0 var(--space-sm);
  letter-spacing: 1rpx;
}

/* 气泡主体 */
.msg-bubble {
  padding: var(--space-lg) var(--space-xl);
  max-width: 85%;
  position: relative;
  line-height: var(--lh-loose);
}

/* 用户气泡 — 柔和的玫瑰粉色，如花瓣 */
.bubble-user {
  background: linear-gradient(135deg,
    rgba(212, 131, 106, 0.10),
    rgba(212, 131, 106, 0.06));
  border-radius: 28rpx 28rpx 6rpx 28rpx;
  border: 1rpx solid rgba(212, 131, 106, 0.15);
  box-shadow: 0 4rpx 16rpx rgba(212, 131, 106, 0.05);
}

.bubble-user::after {
  content: '';
  position: absolute;
  bottom: 8rpx;
  right: -6rpx;
  width: 12rpx;
  height: 12rpx;
  background: linear-gradient(135deg,
    rgba(212, 131, 106, 0.10),
    rgba(212, 131, 106, 0.06));
  border-radius: 2rpx;
  border-right: 1rpx solid rgba(212, 131, 106, 0.15);
  border-bottom: 1rpx solid rgba(212, 131, 106, 0.15);
  transform: rotate(-45deg);
}

/* AI 气泡 — 暖白鼠尾草色，如清茶 */
.bubble-ai {
  background: linear-gradient(135deg,
    rgba(183, 201, 177, 0.15),
    rgba(183, 201, 177, 0.08));
  border-radius: 28rpx 28rpx 28rpx 6rpx;
  border: 1rpx solid rgba(183, 201, 177, 0.2);
  box-shadow: 0 4rpx 16rpx rgba(183, 201, 177, 0.05);
}

.bubble-ai::after {
  content: '';
  position: absolute;
  bottom: 8rpx;
  left: -6rpx;
  width: 12rpx;
  height: 12rpx;
  background: rgba(183, 201, 177, 0.15);
  border-radius: 2rpx;
  border-left: 1rpx solid rgba(183, 201, 177, 0.2);
  border-bottom: 1rpx solid rgba(183, 201, 177, 0.2);
  transform: rotate(45deg);
}

/* 打字指示器 — 玫瑰色音符 */
.typing-indicator {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: var(--space-md) var(--space-lg);
}

.typing-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: var(--radius-full);
  background: #D4836A;
  animation: breathe 1.8s var(--ease-in-out) infinite;
  opacity: 0.4;
}

.typing-dot:nth-child(2) { animation-delay: 0.3s; }
.typing-dot:nth-child(3) { animation-delay: 0.6s; }

/* 消息文字 */
.msg-text {
  font-size: var(--fs-body);
  color: #3D3535;
  line-height: var(--lh-loose);
  white-space: pre-wrap;
  word-break: break-word;
}

.msg-time {
  font-size: var(--fs-caption);
  color: #B5A5A5;
  margin-top: var(--space-xs);
  display: block;
}

.msg-item.user .msg-time {
  text-align: right;
}

/* ---------------------------------------------------------------
   Input Bar — 柔光玻璃输入区
   --------------------------------------------------------------- */
.input-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: var(--space-md) var(--space-xl);
  padding-bottom: calc(env(safe-area-inset-bottom) + var(--space-md));
  background: rgba(255, 248, 245, 0.92);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  border-top: 1rpx solid rgba(212, 131, 106, 0.1);
  gap: var(--space-sm);
  z-index: var(--z-card);
}

.input-bar::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1rpx;
  background: linear-gradient(90deg,
    transparent,
    rgba(212, 131, 106, 0.2) 50%,
    transparent);
  pointer-events: none;
}

.chat-input {
  flex: 1;
  height: 72rpx;
  background: #FFFFFF;
  border-radius: 40rpx;
  padding: 0 var(--space-xl);
  font-size: var(--fs-body);
  color: #3D3535;
  border: 1rpx solid rgba(183, 201, 177, 0.25);
  transition: all var(--duration-fast);
}

.chat-input:focus {
  border-color: #D4836A;
  box-shadow: 0 0 12rpx rgba(212, 131, 106, 0.1);
}

.chat-input::placeholder {
  color: #B5A5A5;
}

.send-btn {
  width: 120rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: linear-gradient(135deg, #D4836A, #C9A96E);
  color: #FFFFFF;
  font-size: var(--fs-body-small);
  font-weight: var(--fw-semibold);
  border-radius: 40rpx;
  border: none;
  padding: 0;
  transition: all var(--duration-fast);
  position: relative;
  overflow: hidden;
  letter-spacing: 2rpx;
}

.send-btn:active:not([disabled]) {
  transform: scale(0.94);
}

.send-btn[disabled] {
  opacity: 0.35;
}

.free-hint {
  text-align: center;
  padding: var(--space-sm) 0;
  font-size: var(--fs-caption);
  color: #9A8A8A;
  position: fixed;
  bottom: 120rpx;
  left: 0;
  right: 0;
  letter-spacing: 1rpx;
}

/* ---------------------------------------------------------------
   Reading Context Bar — 上下文提示
   --------------------------------------------------------------- */
.reading-context-bar {
  border-radius: 20rpx;
  padding: var(--space-md) var(--space-lg);
  margin-bottom: var(--space-xl);
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #FFFFFF, #FFF8F5);
  border: 1rpx solid rgba(183, 201, 177, 0.2);
  border-left: 6rpx solid #D4836A;
  box-shadow: 0 4rpx 16rpx rgba(183, 201, 177, 0.05);
}

.context-label {
  font-size: var(--fs-caption);
  color: #D4836A;
  font-weight: var(--fw-semibold);
  display: block;
  margin-bottom: var(--space-xs);
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

.context-question {
  font-size: var(--fs-body-small);
  color: #3D3535;
  display: block;
  margin-bottom: 4rpx;
  line-height: var(--lh-normal);
}

.context-spread {
  font-size: var(--fs-caption);
  color: #9A8A8A;
  display: block;
}

/* ---------------------------------------------------------------
   Skeleton
   --------------------------------------------------------------- */
.skeleton-messages {
  flex: 1;
}

.skeleton-msg {
  margin-bottom: var(--space-xl);
}

.skeleton-bubble {
  height: 80rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #F5EDE8, #F0EBE5);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-bubble.left { width: 60%; }
.skeleton-bubble.right { width: 50%; margin-left: auto; }

/* ---------------------------------------------------------------
   Error — 温柔报错
   --------------------------------------------------------------- */
.error-state {
  text-align: center;
  padding: var(--space-massive) var(--space-xl);
}

.error-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: var(--space-md);
  opacity: 0.5;
}

.error-text {
  font-size: var(--fs-body);
  color: #6B5A5A;
  display: block;
  margin-bottom: var(--space-xs);
}

.error-hint {
  font-size: var(--fs-body-small);
  color: #9A8A8A;
  display: block;
  margin-bottom: var(--space-xxl);
}
