/* ==========================================
   chat · Editorial Minimal
   Clean white cards · Warm accents
   ========================================== */

/* -------- Container -------- */
.container {
  padding: var(--space-xl);
  padding-bottom: 280rpx;
  background: #faf8f6;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* -------- Empty state -------- */
.chat-intro {
  text-align: center;
  padding: var(--space-massive) 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.empty-icon {
  font-size: 72rpx;
  display: block;
  margin-bottom: var(--space-xl);
  opacity: 0.5;
}

.empty-text {
  font-size: var(--fs-body);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--space-sm);
  letter-spacing: 1rpx;
}

.empty-hint {
  font-size: var(--fs-body-small);
  color: var(--color-text-dim);
  display: block;
  line-height: var(--lh-normal);
  letter-spacing: 1rpx;
}

/* -------- Message list -------- */
.message-list {
  flex: 1;
  margin-bottom: 20rpx;
}

.msg-item {
  margin-bottom: var(--space-xl);
  display: flex;
  flex-direction: column;
}

.msg-item.user { align-items: flex-end; }
.msg-item.ai   { align-items: flex-start; }

.text-caption {
  font-size: var(--fs-caption);
  color: rgba(120, 100, 85, 0.4);
  margin-bottom: var(--space-xs);
  letter-spacing: 2rpx;
}

/* -------- Bubbles -------- */
.msg-bubble {
  padding: var(--space-lg) var(--space-xl);
  max-width: 85%;
  position: relative;
  line-height: var(--lh-loose);
}

.bubble-user {
  background: #ffffff;
  border-radius: 18rpx 18rpx 4rpx 18rpx;
  border: 1rpx solid rgba(180, 140, 110, 0.06);
  box-shadow: 0 2rpx 10rpx rgba(160, 130, 100, 0.04);
  border-right: 3rpx solid rgba(180, 140, 110, 0.15);
}

.bubble-user::after {
  content: '';
  position: absolute;
  bottom: 8rpx;
  right: -7rpx;
  width: 0;
  height: 0;
  border-left: 8rpx solid #ffffff;
  border-top: 6rpx solid transparent;
  border-bottom: 6rpx solid transparent;
  transform: rotate(-15deg);
}

.bubble-ai {
  background: #f8f4f0;
  border-radius: 18rpx 18rpx 18rpx 4rpx;
  border: 1rpx solid rgba(180, 140, 110, 0.06);
  box-shadow: 0 2rpx 10rpx rgba(160, 130, 100, 0.03);
}

.bubble-ai::after {
  content: '';
  position: absolute;
  bottom: 8rpx;
  left: -7rpx;
  width: 0;
  height: 0;
  border-right: 8rpx solid #f8f4f0;
  border-top: 6rpx solid transparent;
  border-bottom: 6rpx solid transparent;
  transform: rotate(15deg);
}

.msg-text {
  font-size: var(--fs-body);
  color: #3d3228;
  line-height: var(--lh-loose);
  white-space: pre-wrap;
  word-break: break-word;
}

/* -------- Input bar -------- */
.input-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: var(--space-md) var(--space-xl);
  padding-bottom: calc(env(safe-area-inset-bottom) + var(--space-md));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid rgba(180, 140, 110, 0.08);
  gap: var(--space-sm);
  z-index: var(--z-card);
}

.chat-input {
  flex: 1;
  height: 72rpx;
  background: #f8f4f0;
  border-radius: 40rpx;
  padding: 0 var(--space-xl);
  font-size: var(--fs-body);
  color: #3d3228;
  border: 1rpx solid rgba(180, 140, 110, 0.10);
  transition: all var(--duration-fast) ease;
  caret-color: #b8865a;
}

.chat-input:focus {
  border-color: rgba(180, 140, 110, 0.20);
  box-shadow: 0 0 0 3rpx rgba(180, 140, 110, 0.04);
}

.chat-input::placeholder {
  color: rgba(140, 120, 105, 0.35);
  letter-spacing: 1rpx;
}

.send-btn {
  width: 120rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #d4a574;
  color: #ffffff;
  font-size: var(--fs-body-small);
  border-radius: 40rpx;
  border: none;
  padding: 0;
  transition: all var(--duration-fast) ease;
  letter-spacing: 3rpx;
}

.send-btn:active:not([disabled]) {
  transform: scale(0.94);
}

.send-btn[disabled] {
  opacity: 0.3;
}

.free-hint {
  text-align: center;
  padding: var(--space-sm) 0;
  font-size: var(--fs-caption);
  color: rgba(120, 100, 85, 0.4);
  position: fixed;
  bottom: 120rpx;
  left: 0;
  right: 0;
  letter-spacing: 2rpx;
}

/* -------- Reading context bar -------- */
.reading-context-bar {
  border-radius: 16rpx;
  padding: var(--space-md) var(--space-lg);
  margin-bottom: var(--space-xl);
  background: #ffffff;
  border: 1rpx solid rgba(180, 140, 110, 0.06);
  border-left: 4rpx solid rgba(180, 140, 110, 0.20);
  box-shadow: 0 2rpx 10rpx rgba(160, 130, 100, 0.03);
}

.context-label {
  font-size: var(--fs-caption);
  color: #b8865a;
  font-weight: var(--fw-semibold);
  display: block;
  margin-bottom: var(--space-xs);
  letter-spacing: 3rpx;
  text-transform: uppercase;
}

.context-question {
  font-size: var(--fs-body-small);
  color: #3d3228;
  display: block;
  margin-bottom: 4rpx;
  line-height: var(--lh-normal);
}

.context-spread {
  font-size: var(--fs-caption);
  color: rgba(120, 100, 85, 0.4);
  display: block;
}

/* -------- Skeleton -------- */
.skeleton-messages {
  flex: 1;
}

.skeleton-msg {
  margin-bottom: var(--space-xl);
}

.skeleton-bubble {
  height: 72rpx;
  border-radius: 16rpx;
  background: #f0e8e0;
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-bubble.left  { width: 60%; }
.skeleton-bubble.right { width: 50%; margin-left: auto; }

/* -------- Error state -------- */
.error-state {
  text-align: center;
  padding: var(--space-massive) var(--space-xl);
}

.error-icon {
  font-size: 72rpx;
  display: block;
  margin-bottom: var(--space-md);
  opacity: 0.4;
}

.error-text {
  font-size: var(--fs-body);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--space-xs);
}

.error-hint {
  font-size: var(--fs-body-small);
  color: var(--color-text-dim);
  display: block;
  margin-bottom: var(--space-xxl);
}
