/* ===== 聊天 - 至尊神秘主题 ===== */

.container {
  padding: var(--space-xl);
  padding-bottom: 200rpx;
  background: var(--color-bg);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* Chat intro (empty state) */
.chat-intro {
  text-align: center;
  padding: var(--space-massive) 0;
}

/* Message list */
.message-list {
  flex: 1;
  margin-bottom: 140rpx;
}

.msg-item {
  margin-bottom: var(--space-xl);
}

.msg-bubble {
  padding: var(--space-lg) var(--space-xl);
  border-radius: var(--radius-lg);
  max-width: 85%;
}

.bubble-user {
  background: var(--color-gold-subtle);
  margin-left: auto;
  border-bottom-right-radius: 6rpx;
}

.bubble-ai {
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border-subtle);
  border-bottom-left-radius: 6rpx;
}

.msg-text {
  font-size: var(--fs-body);
  color: var(--color-text-primary);
  line-height: var(--lh-loose);
  white-space: pre-wrap;
}

/* Input bar */
.input-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: var(--space-md) var(--space-xl);
  padding-bottom: calc(env(safe-area-inset-bottom) + var(--space-md));
  background: var(--color-bg-card);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-top: 1rpx solid var(--color-border-subtle);
  gap: var(--space-sm);
  z-index: var(--z-card);
}

.chat-input {
  flex: 1;
  height: 72rpx;
  background: var(--color-bg);
  border-radius: var(--radius-round);
  padding: 0 var(--space-xl);
  font-size: var(--fs-body);
  color: var(--color-text-primary);
  border: 1rpx solid var(--color-border-subtle);
}

.send-btn {
  width: 120rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: var(--gradient-gold);
  color: var(--color-text-on-gold);
  font-size: var(--fs-body-small);
  font-weight: var(--fw-semibold);
  border-radius: var(--radius-round);
  border: none;
  padding: 0;
}

.send-btn[disabled] {
  opacity: 0.4;
}

.free-hint {
  text-align: center;
  padding: var(--space-sm) 0;
  font-size: var(--fs-caption);
  color: var(--color-text-dim);
  position: fixed;
  bottom: 100rpx;
  left: 0;
  right: 0;
}

/* ===== 加载骨架 ===== */
.skeleton-messages {
  flex: 1;
}

.skeleton-msg {
  margin-bottom: var(--space-xl);
}

.skeleton-bubble {
  height: 80rpx;
  border-radius: var(--radius-lg);
  background: var(--color-bg-card);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-bubble.left { width: 60%; }
.skeleton-bubble.right { width: 50%; margin-left: auto; }

/* ===== 错误状态 ===== */
.error-state {
  text-align: center;
  padding: var(--space-massive) var(--space-xl);
}

.error-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: var(--space-md);
  opacity: 0.6;
}

.error-text {
  font-size: var(--fs-body);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--space-xs);
}

.error-hint {
  font-size: var(--fs-body-small);
  color: var(--color-text-dim);
  display: block;
  margin-bottom: var(--space-xxl);
}
