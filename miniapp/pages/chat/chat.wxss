/* ============================================================
   Chat Page — "A Quiet Conversation Under the Stars"
   Intimate late-night follow-up about a tarot reading
   ============================================================ */

/* === E3 补全: chat ===
   设计级补全（与首页 E3 气质统一）：
   1. 新增奶油 wash 氛围光斑（.wash-pink/.wash-gold，wxml 已加）
   2. 语境条/解读师条 → 奶油底 + 细金描边 + 衬线名
   3. 对话气泡 → 奶油底 + 细金左线（修复用户气泡 0.18 黑重阴影）
   4. 空状态标题衬线化，发送按钮 → E3 三段金渐变
   5. 输入栏保持奶油毛玻璃，占位/提示文字换 E3 灰 */

page {
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue',
               'PingFang SC', 'Microsoft YaHei', sans-serif;
}

/* ================================================================
   Container
   ================================================================ */
.container {
  padding: var(--spacing-lg) var(--spacing-lg) 260rpx;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: 1;
  box-sizing: border-box;
}

/* ================================================================
   Animations — message entrance
   ================================================================ */
@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

@keyframes msgSlideUp {
  0%   { opacity: 0; transform: translateY(20rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

@keyframes slideFadeRight {
  0%   { opacity: 0; transform: translateX(24rpx); }
  100% { opacity: 1; transform: translateX(0); }
}

@keyframes slideFadeLeft {
  0%   { opacity: 0; transform: translateX(-24rpx); }
  100% { opacity: 1; transform: translateX(0); }
}

.msg-enter {
  animation: msgSlideUp 0.35s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.msg-user .msg-bubble {
  animation: slideFadeRight 0.35s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.msg-ai .msg-bubble {
  animation: slideFadeLeft 0.35s cubic-bezier(0.22, 1, 0.36, 1) both;
}

/* ================================================================
   Skeleton loading — Shapes only (shimmer from common.wxss)
   ================================================================ */
.skeleton-wrap {
  flex: 1;
  padding: var(--spacing-sm) 0;
}

.skeleton-block {
  margin-bottom: 40rpx;
}

.skeleton-line {
  height: 20rpx;
  border-radius: var(--radius-pill);
  background-image: linear-gradient(90deg, var(--color-surface) 25%, var(--color-surface) 50%, var(--color-surface) 75%);
  margin-bottom: 12rpx;
}

.skeleton-bubble {
  height: 68rpx;
  border-radius: var(--radius-lg);
  background-image: linear-gradient(90deg, var(--color-surface) 25%, var(--color-surface) 50%, var(--color-surface) 75%);
}

.skeleton-bubble.left  { width: 60%; }
.skeleton-bubble.right { width: 50%; margin-left: auto; }

/* ================================================================
   Context header — 一行小字（P3-4：与空状态合并，单行省略）
   ================================================================ */
.ctx-header {
  padding: 0 4rpx 28rpx;
  text-align: center;
}

.ctx-label {
  display: inline-block;
  max-width: 100%;
  font-size: var(--font-size-caption);
  color: var(--color-lavender-dark);
  letter-spacing: 2rpx;
  line-height: 1.5;
  /* clamp to 1 line with ellipsis */
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  vertical-align: top;
}

.ctx-question {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  display: inline;
  letter-spacing: 1rpx;
}

/* ================================================================
   Persona identity bar — prominent, shows who is listening
   ================================================================ */
.persona-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx var(--spacing-lg);
  margin: 0 0 28rpx;
  background: linear-gradient(135deg, rgba(201,169,124,0.12) 0%, rgba(201,169,124,0.04) 100%);
  border: 1rpx solid rgba(201,169,124,0.2);
  border-radius: 20rpx;
}

.persona-bar-icon {
  font-size: 40rpx;
  color: var(--color-gold-dark);
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(201,169,124,0.1);
  border-radius: 50%;
}

.persona-bar-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.persona-bar-name {
  font-size: var(--font-size-body);
  color: var(--color-gold-dark);
  font-weight: 700;
  letter-spacing: 2rpx;
}

.persona-bar-desc {
  font-size: var(--font-size-xs);
  color: var(--color-lavender-dark);
  letter-spacing: 1rpx;
}

/* ================================================================
   Empty state — warm invitation
   ================================================================ */
.empty-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-2xl) var(--spacing-xl) 120rpx;
}

.empty-inner {
  text-align: center;
  position: relative;
}

.empty-glow {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: radial-gradient(circle, var(--color-gold-glow) 0%, transparent 70%);
  margin: 0 auto 36rpx;
  animation: breath 3s ease-in-out infinite;
}

@keyframes breath {
  0%, 100% { transform: scale(0.95); opacity: 0.6; }
  50%      { transform: scale(1.05); opacity: 1; }
}

.empty-heading {
  display: block;
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  line-height: 1.7;
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
}

.empty-sub {
  display: block;
  font-size: var(--font-size-caption);
  color: var(--color-lavender-dark);
  line-height: 1.6;
  letter-spacing: 1rpx;
}

/* ================================================================
   Error state
   ================================================================ */
.error-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx var(--spacing-xl);
  text-align: center;
}

.error-icon {
  width: 80rpx;
  height: 80rpx;
  display: block;
  margin-bottom: 24rpx;
}

.error-text {
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  margin-bottom: 12rpx;
  display: block;
}

.error-hint {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  margin-bottom: 40rpx;
  display: block;
  line-height: 1.5;
}

.retry-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-md) var(--spacing-xl);
  border: none;
  border-radius: var(--radius-pill);
  font-size: var(--font-size-caption);
  color: var(--color-bg);
  background: linear-gradient(135deg, var(--color-gold-light), var(--color-gold));
  box-shadow: 0 4rpx 20rpx var(--color-gold-glow-strong);
  transition: transform 0.15s ease-out;
}

.retry-btn::after { border: none; }
.retry-btn:active { transform: scale(0.96); }

/* ================================================================
   Message list
   ================================================================ */
.msg-list {
  flex: 1;
}

.msg-wrap {
  margin-bottom: 36rpx;
  display: flex;
  flex-direction: column;
}

.msg-user {
  align-items: flex-end;
}

.msg-ai {
  align-items: flex-start;
}

/* ================================================================
   Role labels
   ================================================================ */
.role-label {
  font-size: var(--font-size-xs);
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
  display: block;
  padding: 0 6rpx;
}

.role-user {
  color: var(--color-lavender-dark);
}

.role-ai {
  color: var(--color-gold-dark);
}

.role-typing {
  color: var(--color-lavender-dark);
}

/* ================================================================
   Message bubbles
   ================================================================ */
.msg-bubble {
  padding: var(--spacing-md) var(--spacing-md);
  max-width: 82%;
  position: relative;
  line-height: 1.7;
}

.msg-text {
  white-space: pre-wrap;
  word-break: break-word;
}

/* ---- User bubble: compact, warm dark card, gold left-accent ---- */
.bubble-user {
  background: var(--color-surface);
  border-radius: 18rpx 4rpx 18rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.03);
  border-left: 2rpx solid var(--color-gold-glow);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.18);
}

.msg-text-user {
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  line-height: 1.6;
}

/* ---- AI bubble: lighter card, gold left-margin line ---- */
.bubble-ai {
  background: var(--color-card);
  border-radius: 4rpx 18rpx 18rpx 18rpx;
  border: 1rpx solid rgba(201, 169, 124, 0.08);
  border-left: 3rpx solid var(--color-gold);
  box-shadow: 0 2rpx 20rpx rgba(201, 169, 124, 0.06);
}

.msg-text-ai {
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  line-height: 1.7;
}

/* ================================================================
   Typing indicator — pulsing gold dots
   ================================================================ */
.typing-box {
  display: flex;
  align-items: center;
  gap: var(--spacing-xxs);
  background: var(--color-card);
  border-radius: 4rpx 18rpx 18rpx 18rpx;
  border: 1rpx solid rgba(201, 169, 124, 0.08);
  border-left: 3rpx solid var(--color-gold);
  padding: var(--spacing-md) var(--spacing-lg);
  min-height: 28rpx;
}

.typing-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-gold-light), var(--color-gold));
  animation: typingPulse 1.4s ease-in-out infinite;
}

.typing-dot:nth-child(2) { animation-delay: 0.2s; }
.typing-dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes typingPulse {
  0%, 80%, 100% {
    transform: translateY(0) scale(0.7);
    opacity: 0.35;
  }
  40% {
    transform: translateY(-8rpx) scale(1);
    opacity: 1;
  }
}

/* ================================================================
   Input area — fixed at bottom
   ================================================================ */
.input-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  gap: var(--spacing-xs);
  padding: var(--spacing-sm) var(--spacing-lg);
  padding-bottom: calc(var(--safe-area-bottom) + 20rpx);
  background: rgba(255, 253, 248, 0.97);
  border-top: 1.5rpx solid rgba(201, 169, 124, 0.22);
  z-index: 100;
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
}

/* Row holding the textarea + send button (inside the column bar) */
.input-row {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  width: 100%;
}

.input-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
}

.chat-input:focus {
  border-color: var(--color-gold-dark);
  box-shadow: 0 0 0 4rpx rgba(201, 169, 124, 0.10);
}

.input-placeholder {
  color: var(--color-text-tertiary);
}

/* ---- Send button: compact gold pill — "casting the spell" ---- */
.send-btn {
  height: 88rpx;
  padding: 0 36rpx;
  border-radius: var(--radius-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--color-gold-light), var(--color-gold));
  box-shadow: 0 4rpx 16rpx rgba(201, 169, 124, 0.25);
  transition: transform 0.15s ease-out, box-shadow 0.15s ease-out;
  flex-shrink: 0;
}

.send-btn:active {
  transform: scale(0.94);
  box-shadow: 0 2rpx 8rpx rgba(201, 169, 124, 0.15);
}

.send-btn--disabled {
  opacity: 0.3;
  pointer-events: none;
}

.send-text {
  font-size: var(--font-size-caption);
  font-weight: 700;
  color: var(--color-bg);
  letter-spacing: 4rpx;
  line-height: 1;
}

/* ================================================================
   Free query hint — inside .input-bar (flex column), so it moves up
   with the textarea when auto-height grows; never overlaps the input
   ================================================================ */
.free-quota-bar {
  text-align: center;
  letter-spacing: 1rpx;
}

.quota-text {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  line-height: 1.6;
}

.quota-text--exhausted {
  color: var(--color-lavender-dark);
}

/* ================================================================
   Scrollbar hidden
   ================================================================ */
::-webkit-scrollbar {
  width: 0;
  height: 0;
}

/* ================================================================
   Retry bar for failed send
   ================================================================ */
.retry-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-xxs);
  padding: var(--spacing-sm);
  margin: var(--spacing-xs) 0;
  background: rgba(232, 122, 138, 0.08);
  border-radius: var(--radius-md);
  border: 1rpx solid rgba(232, 122, 138, 0.20);
  cursor: pointer;
}

.retry-bar:active {
  background: rgba(232, 122, 138, 0.15);
}

.retry-icon {
  width: 32rpx;
  height: 32rpx;
  display: block;
}

.retry-text {
  font-size: var(--font-size-caption);
  color: var(--color-error);
}

/* ================================================================
   Failed message bubble
   ================================================================ */
.bubble-failed {
  border: 1rpx solid rgba(232, 122, 138, 0.40) !important;
  opacity: 0.75;
}

.msg-failed-hint {
  font-size: 20rpx;
  color: var(--color-error);
  display: block;
  margin-top: 8rpx;
  text-align: right;
}

/* ================================================================
   Textarea styles (replaces input)
   ================================================================ */
.chat-input {
  width: 100%;
  min-height: 72rpx;
  max-height: 240rpx;
  padding: var(--spacing-sm) var(--spacing-md);
  border-radius: var(--radius-pill);
  background: var(--color-surface);
  border: 1.5rpx solid rgba(201, 169, 124, 0.12);
  color: var(--color-text-primary);
  font-size: var(--font-size-body);
  line-height: 1.5;
  box-sizing: border-box;
}

/* ================================================================
   Blinking cursor for streaming AI output
   ================================================================ */
.cursor-blink {
  display: inline-block;
  margin-left: 4rpx;
  animation: blink 1s step-end infinite;
  color: var(--color-gold-dark);
  font-weight: 300;
  font-size: 32rpx;
  line-height: 1;
}

@keyframes blink {
  50% { opacity: 0; }
}

/* ================================================================
   Quota exhausted — 主按钮（P3-4：输入条上方，强化升级入口）
   ================================================================ */
.quota-cta-bar {
  padding: var(--spacing-xs) 0 0;
}

.quota-cta-btn {
  width: 100%;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #C9A97C 0%, #B08F52 50%, #A98B5F 100%);
  border: none;
  border-radius: var(--radius-pill);
  font-size: var(--font-size-body);
  font-weight: 600;
  color: var(--e3-cream, #FAF6EF);
  letter-spacing: 3rpx;
  box-shadow: 0 4rpx 20rpx rgba(201, 169, 124, 0.30), inset 0 1rpx 0 rgba(255, 255, 255, 0.3);
  transition: transform 0.15s ease-out, box-shadow 0.15s ease-out;
}

.quota-cta-btn::after {
  border: none;
}

.quota-cta-btn:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 12rpx rgba(201, 169, 124, 0.20);
}

/* ================================================================
   ACCESSIBILITY: Reduced Motion
   ================================================================ */
@media (prefers-reduced-motion: reduce) {
  .msg-enter { animation: none; }
  .msg-user .msg-bubble, .msg-ai .msg-bubble { animation: none; }
  .empty-glow { animation: none; }
}

/* ============================================================
   E3 奶油疗愈 — 设计级补全（追加覆盖）
   ============================================================ */
page {
  --e3-cream: #FAF6EF;
  --e3-cream-hi: #FFFDF8;
  --e3-paper: #F2ECDF;
  --e3-pink: #E8C4BE;
  --e3-pink-ink: #B08A82;
  --e3-gold: #C9A97C;
  --e3-gold-deep: #8A6B3D;
  --e3-line: rgba(201, 169, 124, 0.28);
  --e3-line-soft: rgba(201, 169, 124, 0.38);
  --e3-ink: #3D3A36;
  --e3-ink-soft: #8A8478;
  --e3-ink-faint: #6E6A96;
  --e3-shadow: 0 2rpx 8rpx rgba(61, 58, 54, 0.08);
  --e3-hi: inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
  --e3-serif: 'Songti SC', 'STSong', 'SimSun', 'Noto Serif CJK SC', 'Noto Serif SC', serif;
}

/* —— 奶油底色氛围光斑（与首页 .wash 一致） —— */
.wash {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
}
.wash-pink {
  top: -140rpx;
  right: -160rpx;
  width: 560rpx;
  height: 560rpx;
  background: radial-gradient(circle, rgba(232, 196, 190, 0.35) 0%, rgba(232, 196, 190, 0) 66%);
}
.wash-gold {
  left: -180rpx;
  top: 1000rpx;
  width: 500rpx;
  height: 500rpx;
  background: radial-gradient(circle, rgba(201, 169, 124, 0.16) 0%, rgba(201, 169, 124, 0) 66%);
}

/* —— 语境提示条 —— */
.ctx-label {
  font-family: var(--e3-serif);
  color: var(--e3-ink-soft);
  letter-spacing: 3rpx;
}
.ctx-question {
  color: var(--e3-ink-faint);
}

/* —— 解读师身份条：奶油底 + 细金描边 —— */
.persona-bar {
  background: linear-gradient(135deg, rgba(232, 196, 190, 0.26) 0%, rgba(232, 196, 190, 0.08) 100%);
  border: 1rpx solid var(--e3-line);
  border-radius: 24rpx;
  box-shadow: var(--e3-shadow), var(--e3-hi);
}
.persona-bar-icon {
  background: rgba(255, 253, 248, 0.9);
  border: 1rpx solid var(--e3-line);
  color: var(--e3-gold-deep);
}
.persona-bar-name {
  font-family: var(--e3-serif);
  font-weight: 500;
  color: var(--e3-gold-deep);
  letter-spacing: 4rpx;
}
.persona-bar-desc {
  color: var(--e3-ink-soft);
}

/* —— 空状态 —— */
.empty-heading {
  font-family: var(--e3-serif);
  font-weight: 500;
  color: var(--e3-ink);
  letter-spacing: 3rpx;
}
.empty-sub {
  color: var(--e3-ink-soft);
  letter-spacing: 2rpx;
}
.empty-glow {
  background: radial-gradient(circle, rgba(201, 169, 124, 0.18) 0%, transparent 70%);
}

/* —— 对话气泡 —— */
.bubble-user {
  background: linear-gradient(145deg, var(--e3-cream-hi) 0%, var(--e3-paper) 100%);
  border: 1rpx solid var(--e3-line);
  border-left: 3rpx solid var(--e3-gold-deep);
  box-shadow: var(--e3-shadow), var(--e3-hi);
}
.bubble-ai {
  background: var(--e3-cream-hi);
  border: 1rpx solid var(--e3-line);
  border-left: 3rpx solid var(--e3-gold);
  box-shadow: var(--e3-shadow), var(--e3-hi);
}
.msg-text-user,
.msg-text-ai {
  color: var(--e3-ink);
  letter-spacing: 1rpx;
}
.role-label {
  font-family: var(--e3-serif);
  letter-spacing: 3rpx;
}
.role-user {
  color: var(--e3-ink-faint);
}
.role-ai {
  color: var(--e3-gold-deep);
}

/* —— 正在输入 —— */
.typing-box {
  background: var(--e3-cream-hi);
  border: 1rpx solid var(--e3-line);
  border-left: 3rpx solid var(--e3-gold);
  box-shadow: var(--e3-shadow);
}
.typing-dot {
  background: linear-gradient(135deg, var(--e3-gold), var(--e3-gold-deep));
}

/* —— 发送按钮：E3 三段金渐变 —— */
.send-btn {
  background: linear-gradient(135deg, #C9A97C 0%, #B08F52 50%, #A98B5F 100%);
  box-shadow: 0 4rpx 16rpx rgba(201, 169, 124, 0.28), var(--e3-hi);
}
.send-text {
  font-family: var(--e3-serif);
  letter-spacing: 6rpx;
}

/* —— 输入区 —— */
.chat-input {
  border-color: var(--e3-line);
  background: var(--e3-cream-hi);
  color: var(--e3-ink);
}
.input-placeholder {
  color: var(--e3-ink-faint);
  font-style: italic;
}

/* —— 追问次数 —— */
.quota-text {
  color: var(--e3-ink-faint);
}
.quota-text--exhausted {
  color: var(--e3-pink-ink);
}
.quota-exhausted-link {
  font-family: var(--e3-serif);
  color: var(--e3-gold-deep);
}

/* —— 错误状态 —— */
.error-text {
  font-family: var(--e3-serif);
  color: var(--e3-ink);
  letter-spacing: 3rpx;
}
.retry-btn {
  background: linear-gradient(135deg, #C9A97C 0%, #B08F52 50%, #A98B5F 100%);
  box-shadow: 0 4rpx 20rpx rgba(201, 169, 124, 0.25);
  color: var(--e3-cream);
}
