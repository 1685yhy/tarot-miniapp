.container{padding:24rpx;background:var(--color-bg);min-height:100vh;display:flex;flex-direction:column}
.chat-intro{text-align:center;padding:120rpx 0}.intro-icon{font-size:80rpx;display:block}.intro-text{font-size:30rpx;color:var(--color-text-primary);display:block;margin-top:20rpx}.intro-hint{font-size:24rpx;color:var(--color-text-dim);display:block;margin-top:10rpx}
.message-list{flex:1;margin-bottom:140rpx}.msg-item{margin-bottom:24rpx}.msg-role{font-size:22rpx;color:var(--color-text-dim);display:block;margin-bottom:6rpx;padding:0 8rpx}.msg-user .msg-role{text-align:right}.msg-bubble{padding:20rpx 24rpx;border-radius:20rpx;max-width:85%}.bubble-user{background:rgba(201,169,110,0.15);margin-left:auto;border-bottom-right-radius:6rpx}.bubble-ai{background:var(--color-bg-card);border:1rpx solid rgba(201,169,110,0.08);border-bottom-left-radius:6rpx}.msg-text{font-size:28rpx;color:var(--color-text-primary);line-height:1.7;white-space:pre-wrap}
.input-bar{position:fixed;bottom:0;left:0;right:0;display:flex;align-items:center;padding:16rpx 24rpx;background:var(--color-bg-card);border-top:1rpx solid rgba(201,169,110,0.1);gap:12rpx}.chat-input{flex:1;height:72rpx;background:var(--color-bg);border-radius:36rpx;padding:0 24rpx;font-size:28rpx;color:var(--color-text-primary)}.send-btn{width:120rpx;height:72rpx;line-height:72rpx;text-align:center;background:linear-gradient(135deg,var(--color-gold),var(--color-gold-light));color:#1a1a2e;font-size:26rpx;font-weight:600;border-radius:36rpx;border:none;padding:0}.send-btn[disabled]{opacity:.4}.free-hint{text-align:center;padding:12rpx 0;font-size:22rpx;color:var(--color-text-dim);position:fixed;bottom:100rpx;left:0;right:0}
