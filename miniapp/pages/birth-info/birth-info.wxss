/* pages/birth-info/birth-info.wxss — E3 出生信息（与原型页 18 一致） */
page {
  --e3-cream: #FAF6EF;
  --e3-cream-hi: #FFFDF8;
  --e3-paper: #F2ECDF;
  --e3-pink: #E8C4BE;
  --e3-pink-ink: #B08A82;
  --e3-gold: #C9A97C;
  --e3-gold-deep: #B08F52;
  --e3-line-soft: rgba(201, 169, 124, 0.38);
  --e3-ink: #3D3A36;
  --e3-ink-soft: #8A8478;
  --e3-ink-faint: #B0AA9C;
  --e3-shadow: 0 4rpx 20rpx rgba(61, 58, 54, 0.06);
  --e3-hi: inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
  --e3-serif: 'Songti SC', 'STSong', 'SimSun', 'Noto Serif CJK SC', 'Noto Serif SC', serif;
  --e3-sans: -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif;

  background: #FAF6EF;
  color: #3D3A36;
  font-family: var(--e3-serif);
  font-size: 28rpx;
  line-height: 1.6;
}

.page {
  min-height: 100vh;
  padding: 16rpx 36rpx calc(40rpx + env(safe-area-inset-bottom));
  position: relative;
  box-sizing: border-box;
  background: #FAF6EF;
  overflow: hidden;
}

.wash {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
}
.wash-pink {
  top: -170rpx;
  right: -190rpx;
  width: 560rpx;
  height: 560rpx;
  background: radial-gradient(circle, rgba(232, 196, 190, 0.45) 0%, rgba(232, 196, 190, 0) 66%);
}
.wash-gold {
  left: -200rpx;
  top: 700rpx;
  width: 500rpx;
  height: 500rpx;
  background: radial-gradient(circle, rgba(201, 169, 124, 0.24) 0%, rgba(201, 169, 124, 0) 66%);
}

/* ── 标题 ── */
.fp-hero {
  position: relative;
  z-index: 2;
  text-align: center;
  margin-top: 16rpx;
}
.fp-h3 {
  font-size: 33rpx;
  letter-spacing: 7rpx;
  font-weight: 500;
  color: var(--e3-ink);
}
.fp-h3 em {
  font-style: normal;
  color: var(--e3-pink-ink);
}
.fp-p {
  display: block;
  margin-top: 14rpx;
  font-family: var(--e3-sans);
  font-size: 22rpx;
  color: var(--e3-ink-faint);
  letter-spacing: 3rpx;
  line-height: 1.7;
}

/* ── 表单 ── */
.bf-row {
  position: relative;
  z-index: 2;
  margin-top: 28rpx;
}
.bf-label {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-family: var(--e3-sans);
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: var(--e3-gold-deep);
  margin-bottom: 14rpx;
}
.bf-opt {
  color: var(--e3-ink-faint);
  letter-spacing: 2rpx;
  font-size: 20rpx;
}
.bf-date {
  display: flex;
  gap: 16rpx;
}
.bf-sel {
  flex: 1;
  position: relative;
}
.bf-sel-box {
  height: 88rpx;
  border-radius: 26rpx;
  background: var(--e3-cream-hi);
  border: 1rpx solid rgba(201, 169, 124, 0.3);
  box-shadow: var(--e3-hi);
  padding: 0 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--e3-serif);
  font-size: 25rpx;
  letter-spacing: 2rpx;
  color: var(--e3-ink);
  position: relative;
}
.bf-sel-box::after {
  content: '▾';
  position: absolute;
  right: 22rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 18rpx;
  color: var(--e3-gold-deep);
}
.bf-derive {
  display: block;
  font-family: var(--e3-sans);
  font-size: 22rpx;
  color: var(--e3-ink-faint);
  letter-spacing: 2rpx;
  margin-top: 12rpx;
}
.bf-input {
  height: 88rpx;
  border-radius: 26rpx;
  background: var(--e3-cream-hi);
  border: 1rpx solid rgba(201, 169, 124, 0.3);
  box-shadow: var(--e3-hi);
  padding: 0 26rpx;
  font-family: var(--e3-sans);
  font-size: 25rpx;
  color: var(--e3-ink);
  box-sizing: border-box;
}
.bf-input::placeholder {
  color: var(--e3-ink-faint);
}
.bf-note {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 32rpx;
  background: rgba(201, 169, 124, 0.07);
  border: 1rpx solid rgba(201, 169, 124, 0.25);
  border-radius: 28rpx;
  padding: 22rpx 26rpx;
}
.bf-note-ic {
  font-size: 22rpx;
  color: var(--e3-gold-deep);
  flex-shrink: 0;
  margin-top: 2rpx;
}
.bf-note-tx {
  font-family: var(--e3-sans);
  font-size: 22rpx;
  color: var(--e3-ink-soft);
  line-height: 1.7;
  letter-spacing: 1rpx;
  white-space: pre-line;
}

/* ── 已填摘要 ── */
.birth-sum {
  position: relative;
  z-index: 2;
  background: var(--e3-cream-hi);
  border: 1rpx solid rgba(201, 169, 124, 0.3);
  border-radius: 36rpx;
  box-shadow: var(--e3-shadow), var(--e3-hi);
  padding: 26rpx 30rpx 28rpx;
  margin-top: 24rpx;
}
.bs-t {
  font-family: var(--e3-sans);
  font-size: 21rpx;
  letter-spacing: 5rpx;
  color: var(--e3-gold-deep);
}
.bs-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-top: 1rpx dashed rgba(201, 169, 124, 0.3);
}
.bs-row:first-of-type {
  border-top: none;
}
.bs-l {
  width: 124rpx;
  flex-shrink: 0;
  font-family: var(--e3-sans);
  font-size: 22rpx;
  color: var(--e3-ink-faint);
  letter-spacing: 2rpx;
}
.bs-v {
  flex: 1;
  font-size: 25rpx;
  letter-spacing: 2rpx;
  color: var(--e3-ink);
}
.bs-v-opt {
  font-family: var(--e3-sans);
  font-size: 21rpx;
  color: var(--e3-ink-faint);
  letter-spacing: 1rpx;
}

/* ── CTA ── */
.cta {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, var(--e3-gold), var(--e3-gold-deep));
  color: #FFFDF8;
  font-size: 28rpx;
  letter-spacing: 6rpx;
  margin-top: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(176, 143, 82, 0.35), var(--e3-hi);
  transition: transform 0.15s ease;
}
.cta-pressed {
  transform: scale(0.975);
}
.cta-ghost {
  background: transparent;
  border: 1rpx solid rgba(201, 169, 124, 0.38);
  color: var(--e3-gold-deep);
  box-shadow: none;
  height: 88rpx;
  margin-top: 8rpx;
}
