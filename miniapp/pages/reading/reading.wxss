/* ===== 占卜页 - 神秘牌阵选择 · 羊皮卷宗 ===== */

/* -------- 全局装饰 ---------- */
@keyframes heart-pulse {
  0%, 100% { transform: scale(1); box-shadow: 0 0 20rpx rgba(212, 175, 55, 0.3), 0 0 40rpx rgba(212, 175, 55, 0.1); }
  50%      { transform: scale(1.02); box-shadow: 0 0 30rpx rgba(212, 175, 55, 0.5), 0 0 60rpx rgba(212, 175, 55, 0.2); }
}

@keyframes card-glint {
  0%   { background-position: -200% center; }
  100% { background-position: 200% center; }
}

@keyframes ember-float {
  0%   { opacity: 0; transform: translateY(0) scale(0.8); }
  30%  { opacity: 0.6; }
  70%  { opacity: 0.3; }
  100% { opacity: 0; transform: translateY(-60rpx) scale(1.2); }
}

/* -------- 牌阵选择卡片 · 典藏牌盒 -------- */
.spread-grid {
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
  padding: var(--space-md) 0;
}

.spread-card {
  display: flex;
  align-items: center;
  background: linear-gradient(
    145deg,
    rgba(60, 40, 80, 0.7),
    rgba(40, 25, 55, 0.85)
  );
  border-radius: 18rpx;
  padding: var(--space-xl) var(--space-xxl);
  border: 1rpx solid rgba(212, 175, 55, 0.15);
  transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  position: relative;
  overflow: hidden;
  backdrop-filter: blur(4rpx);
  box-shadow:
    0 4rpx 20rpx rgba(0, 0, 0, 0.25),
    inset 0 1rpx 0 rgba(212, 175, 55, 0.08);
}

/* Ornate edge ornament */
.spread-card::before {
  content: '╌';
  position: absolute;
  top: -2rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 14rpx;
  color: rgba(212, 175, 55, 0.12);
  letter-spacing: 12rpx;
  line-height: 1;
}

/* Deck card back texture shimmer */
.spread-card::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(212, 175, 55, 0.04) 30%,
    rgba(212, 175, 55, 0.08) 50%,
    rgba(212, 175, 55, 0.04) 70%,
    transparent 100%
  );
  background-size: 200% 100%;
  background-repeat: no-repeat;
  pointer-events: none;
  border-radius: inherit;
}

.spread-card:active {
  border-color: rgba(212, 175, 55, 0.4);
  transform: scale(0.97) translateY(2rpx);
  box-shadow:
    0 2rpx 12rpx rgba(0, 0, 0, 0.3),
    0 0 30rpx rgba(212, 175, 55, 0.15);
}

/* Premium variant — gilded deck */
.spread-card.premium {
  border: 1rpx solid rgba(212, 175, 55, 0.35);
  background: linear-gradient(
    145deg,
    rgba(70, 45, 90, 0.75),
    rgba(45, 28, 60, 0.9)
  );
  box-shadow:
    0 4rpx 20rpx rgba(0, 0, 0, 0.25),
    0 0 30rpx rgba(212, 175, 55, 0.08),
    inset 0 1rpx 0 rgba(212, 175, 55, 0.12);
}

/* Premium card golden corner flourish */
.spread-card.premium::before {
  content: '✦';
  position: absolute;
  top: 6rpx;
  right: 10rpx;
  font-size: 18rpx;
  color: rgba(212, 175, 55, 0.5);
  text-shadow: 0 0 12rpx rgba(212, 175, 55, 0.3);
  opacity: 1;
  letter-spacing: normal;
}

/* Premium badge — warm gleam */
.premium-badge {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx 16rpx 4rpx 12rpx;
  border-radius: 30rpx;
  font-size: 18rpx;
  font-weight: 500;
  color: #d4af37;
  background: linear-gradient(
    135deg,
    rgba(212, 175, 55, 0.15),
    rgba(212, 175, 55, 0.06)
  );
  border: 1rpx solid rgba(212, 175, 55, 0.25);
  box-shadow:
    0 0 12rpx rgba(212, 175, 55, 0.1),
    inset 0 1rpx 0 rgba(255, 215, 0, 0.08);
  position: relative;
  letter-spacing: 2rpx;
}

.premium-badge::before {
  content: '✦';
  font-size: 14rpx;
  margin-right: 4rpx;
  animation: card-glint 3s linear infinite;
}

/* -------- 问题输入 · 羊皮纸书写区 -------- */
.selected-info {
  text-align: center;
  padding: var(--space-xl) 0 var(--space-lg);
}

.question-box {
  background: linear-gradient(
    145deg,
    rgba(55, 42, 65, 0.6),
    rgba(42, 30, 52, 0.75)
  );
  border-radius: 16rpx;
  padding: var(--space-xl);
  margin-bottom: var(--space-lg);
  border: 1rpx solid rgba(192, 168, 96, 0.12);
  transition: border-color 0.5s ease, box-shadow 0.5s ease;
  position: relative;
}

/* Parchment-like inner shadow */
.question-box::before {
  content: '';
  position: absolute;
  inset: 4rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(192, 168, 96, 0.06);
  pointer-events: none;
}

/* Decorative corner ornaments */
.question-box::after {
  content: '✧ ──── ✧';
  position: absolute;
  bottom: -10rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 14rpx;
  color: rgba(212, 175, 55, 0.08);
  letter-spacing: 6rpx;
  white-space: nowrap;
}

.question-box:focus-within {
  border-color: rgba(212, 175, 55, 0.3);
  box-shadow:
    0 0 30rpx rgba(212, 175, 55, 0.06),
    0 0 60rpx rgba(212, 175, 55, 0.03);
}

.question-input {
  width: 100%;
  min-height: 160rpx;
  font-size: var(--fs-body);
  color: rgba(230, 220, 240, 0.92);
  line-height: var(--lh-loose);
  background: transparent;
  caret-color: #d4af37;
  letter-spacing: 1.5rpx;
}

.question-input::placeholder {
  color: rgba(192, 168, 120, 0.35);
  font-style: italic;
}

.selected-spread-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: var(--space-sm) 0;
  font-size: var(--fs-body-small);
  color: rgba(212, 175, 55, 0.7);
  letter-spacing: 2rpx;
}

.selected-spread-hint::before,
.selected-spread-hint::after {
  content: '┅';
  font-size: 14rpx;
  color: rgba(212, 175, 55, 0.15);
}

/* -------- 主题选择 -------- */
.theme-options {
  display: flex;
  gap: var(--space-md);
  margin-top: var(--space-sm);
}

.theme-item {
  flex: 1;
  text-align: center;
  background: linear-gradient(
    180deg,
    rgba(55, 40, 70, 0.6),
    rgba(40, 28, 55, 0.7)
  );
  border-radius: 16rpx;
  padding: var(--space-md) 0;
  font-size: var(--fs-body-small);
  color: rgba(200, 190, 210, 0.6);
  border: 1rpx solid rgba(212, 175, 55, 0.06);
  transition: all 0.4s ease;
  letter-spacing: 1rpx;
  position: relative;
  overflow: hidden;
}

.theme-item:active {
  transform: scale(0.95);
}

.theme-active {
  border-color: rgba(212, 175, 55, 0.3);
  color: #d4af37;
  background: linear-gradient(
    180deg,
    rgba(212, 175, 55, 0.1),
    rgba(212, 175, 55, 0.04)
  );
  box-shadow:
    0 0 20rpx rgba(212, 175, 55, 0.08),
    inset 0 0 20rpx rgba(212, 175, 55, 0.04);
}

.theme-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 20%;
  right: 20%;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(212, 175, 55, 0.4), transparent);
}

/* -------- 启动按钮 · 心跳脉冲 -------- */
.btn-glow-pulse {
  position: relative;
  overflow: hidden;
  letter-spacing: 4rpx;
  font-size: var(--fs-body);
  padding: var(--space-lg) 0;
  border-radius: 40rpx;
  background: linear-gradient(
    135deg,
    rgba(180, 140, 60, 0.8),
    rgba(212, 175, 55, 0.7)
  );
  border: 1rpx solid rgba(212, 175, 55, 0.3);
  color: #1a1025;
  font-weight: 600;
  animation: heart-pulse 3s ease-in-out infinite;
  text-shadow: 0 1rpx 0 rgba(255, 215, 0, 0.3);
}

/* Ember particles floating up */
.btn-glow-pulse::before {
  content: '';
  position: absolute;
  bottom: 0;
  left: 10%;
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: rgba(255, 200, 100, 0.6);
  box-shadow:
    0 0 6rpx 2rpx rgba(255, 200, 100, 0.3),
    80rpx -30rpx 0 2rpx rgba(255, 180, 80, 0.4),
    -60rpx -50rpx 0 1rpx rgba(255, 200, 100, 0.2),
    120rpx -20rpx 0 3rpx rgba(255, 180, 80, 0.3);
  animation: ember-float 4s ease-out infinite;
  pointer-events: none;
}

/* ✧ decoration */
.btn-glow-pulse::after {
  content: '✧';
  position: absolute;
  right: var(--space-xl);
  top: 50%;
  transform: translateY(-50%);
  font-size: 22rpx;
  opacity: 0.35;
  transition: opacity 0.4s;
  color: #1a1025;
}

.btn-glow-pulse:active {
  transform: scale(0.96);
  animation: none;
}

.btn-glow-pulse.drawing {
  opacity: 0.7;
  animation: heart-pulse 1.2s ease-in-out infinite;
}

.btn-glow-pulse.drawing::after {
  content: '✦';
  opacity: 0.7;
  animation: mystic-spin 2s linear infinite;
  color: #1a1025;
}

.btn-glow-pulse[disabled] {
  opacity: 0.45;
  animation: none;
  filter: grayscale(0.6);
}

/* -------- 加载骨架屏 -------- */
.skeleton {
  padding: var(--space-xxl) 0;
}

.skeleton-title {
  width: 280rpx;
  height: 40rpx;
  border-radius: 10rpx;
  background: linear-gradient(90deg, rgba(55, 40, 70, 0.5), rgba(70, 50, 85, 0.3));
  margin: 0 auto var(--space-sm);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-subtitle {
  width: 200rpx;
  height: 28rpx;
  border-radius: 10rpx;
  background: linear-gradient(90deg, rgba(55, 40, 70, 0.5), rgba(70, 50, 85, 0.3));
  margin: 0 auto var(--space-xxxl);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-spread {
  width: 100%;
  height: 140rpx;
  border-radius: 18rpx;
  background: linear-gradient(90deg, rgba(55, 40, 70, 0.4), rgba(70, 50, 85, 0.25));
  margin-bottom: var(--space-md);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

/* -------- 错误状态 -------- */
.error-state {
  text-align: center;
  padding: var(--space-massive) var(--space-xl);
}

.error-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: var(--space-md);
  opacity: 0.45;
}

.error-text {
  font-size: var(--fs-body);
  color: rgba(200, 190, 210, 0.6);
  display: block;
  margin-bottom: var(--space-xs);
}

.error-hint {
  font-size: var(--fs-body-small);
  color: rgba(200, 190, 210, 0.35);
  display: block;
  margin-bottom: var(--space-xxl);
}
