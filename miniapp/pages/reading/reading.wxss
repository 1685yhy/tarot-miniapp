/* ============================================================
   E3 奶油疗愈 — 设计级补全（追加覆盖，置于文件末尾保证层叠生效）
   ============================================================ */
page {
  --e3-cream: #FAF6EF;
  --e3-cream-hi: #FFFDF8;
  --e3-paper: #F2ECDF;
  --e3-pink: #E8C4BE;
  --e3-pink-ink: #B08A82;
  --e3-gold: #C9A97C;
  --e3-gold-deep: #8A6B3D;
  --e3-line: rgba(201, 169, 124, 0.28);
  --e3-line-soft: rgba(201, 169, 124, 0.38);
  --e3-ink: #3D3A36;
  --e3-ink-soft: #8A8478;
  --e3-ink-faint: #6E6A96;
  --e3-shadow: 0 2rpx 8rpx rgba(61, 58, 54, 0.08);
  --e3-hi: inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
  --e3-serif: 'Songti SC', 'STSong', 'SimSun', 'Noto Serif CJK SC', 'Noto Serif SC', serif;
}

/* —— 奶油底色氛围光斑（与首页 .wash 一致） —— */
.wash {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
}
.wash-pink {
  top: -140rpx;
  right: -160rpx;
  width: 560rpx;
  height: 560rpx;
  background: radial-gradient(circle, rgba(232, 196, 190, 0.42) 0%, rgba(232, 196, 190, 0) 66%);
}
.wash-gold {
  left: -180rpx;
  top: 720rpx;
  width: 500rpx;
  height: 500rpx;
  background: radial-gradient(circle, rgba(201, 169, 124, 0.22) 0%, rgba(201, 169, 124, 0) 66%);
}

/* —— 光晕 orbs → E3 雾粉 / 细金 —— */
.orb-top {
  background: radial-gradient(circle at center, rgba(232, 196, 190, 0.30) 0%, transparent 70%);
}
.orb-bottom {
  background: radial-gradient(circle at center, rgba(201, 169, 124, 0.16) 0%, transparent 70%);
}

/* —— 星尘粒子背景（原无样式死元素 → 细金微尘） —— */
.star-field {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
}
.star-particle {
  position: absolute;
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: var(--e3-gold);
  opacity: 0;
  box-shadow: 0 0 6rpx 2rpx rgba(201, 169, 124, 0.16);
}
.star-particle:nth-child(1)  { top: 10%; left: 6%;  animation: e3-star-tw 3.6s ease-in-out 0.1s infinite; }
.star-particle:nth-child(2)  { top: 18%; left: 88%; animation: e3-star-tw 4.2s ease-in-out 0.9s infinite; }
.star-particle:nth-child(3)  { top: 32%; left: 14%; animation: e3-star-tw 3.0s ease-in-out 0.4s infinite; }
.star-particle:nth-child(4)  { top: 45%; left: 92%; animation: e3-star-tw 3.8s ease-in-out 1.4s infinite; }
.star-particle:nth-child(5)  { top: 58%; left: 8%;  animation: e3-star-tw 4.6s ease-in-out 0.7s infinite; }
.star-particle:nth-child(6)  { top: 70%; left: 86%; animation: e3-star-tw 3.2s ease-in-out 1.9s infinite; }
.star-particle:nth-child(7)  { top: 82%; left: 16%; animation: e3-star-tw 4.0s ease-in-out 0.3s infinite; }
.star-particle:nth-child(8)  { top: 90%; left: 80%; animation: e3-star-tw 3.4s ease-in-out 1.1s infinite; }
.star-particle:nth-child(9)  { top: 25%; left: 40%; animation: e3-star-tw 3.9s ease-in-out 2.3s infinite; }
.star-particle:nth-child(10) { top: 55%; left: 55%; animation: e3-star-tw 4.4s ease-in-out 0.6s infinite; }
.star-particle:nth-child(11) { top: 75%; left: 34%; animation: e3-star-tw 3.1s ease-in-out 1.7s infinite; }
.star-particle:nth-child(12) { top: 40%; left: 68%; animation: e3-star-tw 4.8s ease-in-out 2.6s infinite; }
.star-particle:nth-child(13) { top: 8%;  left: 56%; animation: e3-star-tw 3.7s ease-in-out 1.2s infinite; }
.star-particle:nth-child(14) { top: 64%; left: 72%; animation: e3-star-tw 4.1s ease-in-out 0.2s infinite; }
.star-particle:nth-child(15) { top: 48%; left: 30%; animation: e3-star-tw 3.3s ease-in-out 2.0s infinite; }
.star-particle:nth-child(16) { top: 86%; left: 62%; animation: e3-star-tw 4.5s ease-in-out 0.8s infinite; }
@keyframes e3-star-tw {
  0%, 100% { opacity: 0; transform: scale(0.5); }
  50% { opacity: 0.55; transform: scale(1.2); }
}

/* —— 衬线大标题（宽字距） —— */
.heading-2 {
  font-family: var(--e3-serif);
  font-weight: 500;
  font-size: 44rpx;
  color: var(--e3-ink);
  letter-spacing: 8rpx;
}
.heading-4 {
  font-family: var(--e3-serif);
  font-weight: 500;
  color: var(--e3-ink);
  letter-spacing: 2rpx;
}
.text-secondary {
  color: var(--e3-ink-soft);
  letter-spacing: 2rpx;
}
.text-dim {
  color: var(--e3-ink-faint);
}

/* —— 牌阵卡：卡面 #FFFDF8 + 细金描边 + 阴影加深（原型页 07：与底色拉开层次） —— */
.spread-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  background: #FFFDF8;
  border: 1rpx solid rgba(169, 139, 95, 0.45);
  border-left: 4rpx solid var(--e3-gold-deep);
  border-radius: 24rpx;
  box-shadow: 0 12rpx 26rpx rgba(61, 58, 54, 0.13), var(--e3-hi);
  min-height: 168rpx;
  box-sizing: border-box;
}
.spread-card::before {
  background: linear-gradient(135deg, transparent 50%, rgba(201, 169, 124, 0.05));
}
.spread-card:active {
  background: var(--e3-cream-hi);
  border-color: var(--e3-gold-deep);
  border-left-color: var(--e3-gold-deep);
}
.spread-card.premium {
  border-color: rgba(169, 139, 95, 0.55);
  border-left-color: var(--e3-gold-deep);
  background: linear-gradient(145deg, #FFFDF8 0%, rgba(232, 196, 190, 0.20) 100%);
}
.spread-card-desc,
.spread-card-count {
  color: var(--e3-ink-soft);
}
.spread-card-plainDesc {
  color: var(--e3-lav, #6E6A96);
}
/* 两列卡等高：描述区底部对齐 */
.spread-card-info {
  display: flex;
  flex-direction: column;
  min-height: 0;
}
.spread-card-desc {
  margin-top: auto;
}
.spread-card-meta {
  align-self: flex-end;
  margin-top: 8rpx;
}
.badge-popular {
  background: rgba(232, 196, 190, 0.40);
  color: var(--e3-pink-ink);
  border-color: rgba(201, 169, 124, 0.25);
}

/* —— premium 锁角标（P1-1 轻量版 · 金色小锁 + 文案） —— */
.premium-overlay-content {
  background: rgba(255, 253, 248, 0.96);
  border: 1rpx solid rgba(201, 169, 124, 0.4);
  border-radius: 999rpx;
  box-shadow: 0 2rpx 10rpx rgba(61, 58, 54, 0.12), inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
}
.premium-overlay-text {
  color: var(--e3-gold-deep);
  font-weight: 600;
  letter-spacing: 2rpx;
}

/* —— 冥想呼吸仪式 —— */
.ritual-heading {
  font-family: var(--e3-serif);
  font-weight: 500;
  font-size: 40rpx;
  color: var(--e3-ink);
  letter-spacing: 6rpx;
  text-shadow: none;
}
.ritual-subtitle {
  color: var(--e3-ink-soft);
  letter-spacing: 6rpx;
  font-family: var(--e3-serif);
}
.breathing-circle {
  background: radial-gradient(circle at 35% 35%, rgba(201, 169, 124, 0.35), rgba(201, 169, 124, 0.06));
  box-shadow: 0 0 60rpx rgba(201, 169, 124, 0.20);
}
.breathing-ring {
  border-color: rgba(201, 169, 124, 0.28);
}
.breathing-text {
  font-family: var(--e3-serif);
  color: var(--e3-gold-deep);
  letter-spacing: 8rpx;
  text-shadow: none;
}

/* —— 洗牌卡背：深紫 → E3 墨灰紫 + 细金边 —— */
.shuffle-card {
  background: linear-gradient(145deg, #57525C 0%, #3D3A36 100%);
  border: 1rpx solid rgba(201, 169, 124, 0.45);
  box-shadow: 0 4rpx 20rpx rgba(61, 58, 54, 0.18);
}

/* —— 问题书写区：奶油信笺 —— */
.question-box {
  background: linear-gradient(145deg, var(--e3-cream-hi) 0%, var(--e3-paper) 100%);
  border: 1rpx solid var(--e3-line-soft);
  border-radius: 24rpx;
  box-shadow: var(--e3-shadow), var(--e3-hi);
}
.question-box-accent {
  background: linear-gradient(90deg, transparent, var(--e3-gold), transparent);
  opacity: 0.6;
}
.question-input {
  background: rgba(255, 253, 248, 0.9);
  border: 1rpx solid var(--e3-line);
  border-radius: 16rpx;
  color: var(--e3-ink);
}
.question-input:focus {
  border-color: var(--e3-gold-deep);
  box-shadow: 0 0 20rpx rgba(201, 169, 124, 0.14);
}
.question-input::placeholder {
  color: var(--e3-ink-faint);
  font-style: italic;
}
.prompt-text {
  font-family: var(--e3-serif);
  font-weight: 500;
  color: var(--e3-ink);
  letter-spacing: 4rpx;
  text-shadow: none;
}
.prompt-stars {
  color: var(--e3-gold-deep);
  opacity: 0.7;
}
.hint-text {
  color: var(--e3-ink-faint);
}
.char-counter {
  background: rgba(232, 196, 190, 0.35);
  border-color: rgba(201, 169, 124, 0.20);
  color: var(--e3-pink-ink);
}

/* —— 主题两形态统一最小高度容器（P1-1：切换时不跳动） —— */
.theme-stage {
  min-height: 200rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.theme-stage .mb-xxxl {
  margin-bottom: 12rpx;
}

/* —— 解读侧重（主题选择） —— */
.theme-section-label {
  font-family: var(--e3-serif);
  color: var(--e3-ink);
  letter-spacing: 6rpx;
  font-weight: 500;
}
.theme-item {
  background: var(--e3-cream-hi);
  border: 1rpx solid var(--e3-line);
  border-radius: 20rpx;
  box-shadow: var(--e3-shadow);
}
.theme-label {
  color: var(--e3-ink-soft);
  letter-spacing: 2rpx;
}
.theme-active {
  background: rgba(232, 196, 190, 0.30);
  border-color: rgba(201, 169, 124, 0.50);
}
.theme-active .theme-label {
  color: var(--e3-gold-deep);
}
.theme-hint {
  color: var(--e3-ink-soft);
  opacity: 0.8;
}

/* —— 解读师选择 —— */
.persona-section-label {
  font-family: var(--e3-serif);
  color: var(--e3-ink);
  letter-spacing: 6rpx;
  font-weight: 500;
}
.persona-card {
  background: var(--e3-cream-hi);
  border: 1rpx solid var(--e3-line);
  border-radius: 20rpx;
  box-shadow: var(--e3-shadow);
}
.persona-card.persona-active {
  background: rgba(232, 196, 190, 0.30);
  border-color: var(--e3-gold-deep);
  border-width: 2rpx;
  box-shadow: 0 0 24rpx rgba(201, 169, 124, 0.15);
}
.persona-name {
  font-family: var(--e3-serif);
  color: var(--e3-ink);
  letter-spacing: 2rpx;
}
.persona-label {
  color: var(--e3-ink-faint);
}
.persona-active .persona-name {
  color: var(--e3-gold-deep);
}
.persona-active .persona-label {
  color: var(--e3-gold-deep);
  opacity: 0.85;
}

/* —— 模式选择（快速 / 沉浸） —— */
.mode-card {
  background: var(--e3-cream-hi);
  border: 1rpx solid var(--e3-line);
  border-radius: 20rpx;
  box-shadow: var(--e3-shadow);
}
.mode-card.mode-active {
  background: rgba(232, 196, 190, 0.30);
  border-color: rgba(201, 169, 124, 0.50);
}
.mode-card-name {
  color: var(--e3-ink);
  font-family: var(--e3-serif);
  letter-spacing: 2rpx;
}
.mode-card.mode-active .mode-card-name {
  color: var(--e3-gold-deep);
}
.mode-card-desc {
  color: var(--e3-ink-faint);
}

/* —— 静心冥想开关 —— */
.ritual-toggle {
  background: linear-gradient(135deg, rgba(232, 196, 190, 0.35), rgba(232, 196, 190, 0.16));
  border: 1rpx solid rgba(201, 169, 124, 0.35);
}
.ritual-toggle:active {
  background: linear-gradient(135deg, rgba(232, 196, 190, 0.45), rgba(232, 196, 190, 0.25));
  border-color: rgba(201, 169, 124, 0.5);
}
.ritual-toggle.active {
  background: linear-gradient(135deg, rgba(232, 196, 190, 0.5), rgba(232, 196, 190, 0.28));
  border-color: var(--e3-gold-deep);
  box-shadow: 0 0 20rpx rgba(201, 169, 124, 0.18);
}
.ritual-toggle-text {
  color: var(--e3-pink-ink);
  font-family: var(--e3-serif);
  letter-spacing: 3rpx;
}
.ritual-toggle-icon {
  color: var(--e3-gold-deep);
}

/* —— 免费次数 —— */
.quota-progress-wrap {
  background: rgba(201, 169, 124, 0.14);
}
.quota-text {
  color: var(--e3-ink-soft);
}
.quota-text--exhausted {
  color: var(--e3-gold-deep);
}

/* —— 返回牌阵 —— */
.btn-back-spreads {
  color: var(--e3-ink-soft);
  border-color: var(--e3-line);
  background: var(--e3-cream-hi);
}

/* —— 免费次数耗尽浮层 —— */
.exhausted-title {
  font-family: var(--e3-serif);
  font-weight: 500;
  color: var(--e3-ink);
  letter-spacing: 6rpx;
  font-size: 40rpx;
}
.exhausted-sub {
  color: var(--e3-ink-soft);
}
.exhausted-cta-text {
  font-family: var(--e3-serif);
  color: var(--e3-ink);
  letter-spacing: 2rpx;
}

/* —— 解读师介绍浮层 —— */
.persona-intro-name {
  font-family: var(--e3-serif);
  font-weight: 500;
  color: var(--e3-ink);
  letter-spacing: 6rpx;
  font-size: 44rpx;
}
.persona-intro-desc {
  color: var(--e3-ink-soft);
}
.persona-intro-style-label {
  color: var(--e3-ink-soft);
}
.persona-intro-style-value {
  color: var(--e3-gold-deep);
  font-family: var(--e3-serif);
  letter-spacing: 3rpx;
}
.persona-intro-card,
.exhausted-card {
  border-color: var(--e3-line-soft);
  box-shadow: 0 16rpx 60rpx rgba(61, 58, 54, 0.14), var(--e3-hi);
}

/* —— AI 解读时间提示 —— */
.reading-time-note {
  color: var(--e3-ink-faint);
}

/* ============================================================
   E3 改造清单 3（原型页 07）：底部主 CTA 暖金填充 + 奶油白字 + safe-area
   ============================================================ */
/* 「翻开牌阵」主 CTA：暖金 #8A6B3D 填充 + 奶油白字（覆盖 common .btn-primary 墨字金底） */
.btn-primary.btn--full {
  background: linear-gradient(135deg, #8A6B3D 0%, #6F532C 100%);
  color: #FAF6EF;
  box-shadow: 0 8rpx 24rpx rgba(138, 107, 61, 0.32);
}
.btn-primary.btn--full:active {
  background: linear-gradient(135deg, #7A5E35 0%, #634A27 100%);
  box-shadow: 0 4rpx 14rpx rgba(138, 107, 61, 0.28);
}
/* 提问页底部留出 safe-area（真机 Home 条不遮挡按钮） */
.btn-back-spreads-wrap {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}
/* 牌阵列表底部：留出固定栏高度 + 24rpx 余量 */
.spread-grid {
  margin-bottom: calc(120rpx + env(safe-area-inset-bottom));
}
/* 会员徽章：金描边 + 深金字 */
.premium-overlay-content {
  border: 1rpx solid rgba(169, 139, 95, 0.55);
}
.premium-overlay-text {
  color: #8A6B3D;
}
