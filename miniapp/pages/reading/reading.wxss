/* ==============================
   柔光星辰 — Spread Selection
   Dark indigo + warm golden starlight
   ============================== */

/* ----- CSS Variables ----- */
page {
  --bg-deep: var(--color-bg);
  --bg-card: #252550;
  --bg-card-hover: #2A2A5A;
  --bg-elevated: #313165;
  --gold: #F4D48C;
  --gold-light: #FADE9E;
  --gold-glow: rgba(244, 212, 140, 0.35);
  --gold-dim: rgba(244, 212, 140, 0.15);
  --text-primary: #F0EDE8;
  --text-secondary: #B8A9E0;
  --text-dim: #A098C0;
  --text-gold: #F4D48C;
  --danger: #ff6b6b;
  --lavender: #C8B8E8;
  --fs-caption: 22rpx;
  --fs-body-small: 24rpx;
  --fs-body: 28rpx;
  --space-xs: 8rpx;
  --space-sm: 12rpx;
  --space-md: 20rpx;
  --space-lg: 28rpx;
  --space-xl: 36rpx;
  --space-xxl: 48rpx;
  --space-xxxl: 64rpx;
  --radius-card: 24rpx;
  --radius-sm: 12rpx;
  --radius-round: 999rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  background: var(--bg-deep);
  color: var(--text-primary);
  font-size: var(--fs-body);
  line-height: 1.6;
  min-height: 100vh;
  overflow-x: hidden;
}

/* ==============================
   Glowing orbs
   ============================== */
.orb-top {
  position: fixed;
  top: -200rpx;
  right: -150rpx;
  width: 500rpx;
  height: 500rpx;
  border-radius: 50%;
  background: radial-gradient(circle at center, rgba(244,212,140,0.12) 0%, transparent 70%);
  z-index: 0;
  pointer-events: none;
}

.orb-bottom {
  position: fixed;
  bottom: -250rpx;
  left: -180rpx;
  width: 600rpx;
  height: 600rpx;
  border-radius: 50%;
  background: radial-gradient(circle at center, rgba(100,80,180,0.10) 0%, transparent 70%);
  z-index: 0;
  pointer-events: none;
}

/* ==============================
   Page wrapper
   ============================== */
.page {
  position: relative;
  z-index: 1;
  padding: var(--space-xxl) var(--space-xl) 80rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ==============================
   Typography helpers
   ============================== */
.heading-2 {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 0.02em;
}

.heading-4 {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.text-center { text-align: center; }
.text-secondary { color: var(--text-secondary); }
.text-dim { color: var(--text-dim); }

.mt-xs { margin-top: var(--space-xs); }
.mt-sm { margin-top: var(--space-sm); }
.mb-xxl { margin-bottom: var(--space-xxl); }
.mb-xxxl { margin-bottom: var(--space-xxxl); }
.mr-sm { margin-right: var(--space-sm); }

/* ==============================
   Animations
   ============================== */
.anim-fade-in-up-1 {
  animation: fadeInUp 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
}
.anim-fade-in-up-2 {
  animation: fadeInUp 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.12s both;
}
.anim-fade-in-up-3 {
  animation: fadeInUp 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.24s both;
}
.anim-fade-in-up-4 {
  animation: fadeInUp 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.36s both;
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ==============================
   Skeleton loading
   ============================== */
.skeleton {
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
  padding: var(--space-xl) 0;
}

.skeleton-title {
  width: 50%;
  height: 36rpx;
  border-radius: var(--radius-round);
  background: linear-gradient(90deg, var(--bg-card) 25%, var(--bg-elevated) 50%, var(--bg-card) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.6s infinite;
}

.skeleton-subtitle {
  width: 35%;
  height: 28rpx;
  border-radius: var(--radius-round);
  background: linear-gradient(90deg, var(--bg-card) 25%, var(--bg-elevated) 50%, var(--bg-card) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.6s infinite;
  margin-bottom: var(--space-lg);
}

.skeleton-spread {
  height: 100rpx;
  border-radius: var(--radius-card);
  background: linear-gradient(90deg, var(--bg-card) 25%, var(--bg-elevated) 50%, var(--bg-card) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.6s infinite;
}

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ==============================
   Error state
   ============================== */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx var(--space-xl);
  text-align: center;
  position: relative;
  z-index: 1;
}

.error-icon {
  font-size: 80rpx;
  margin-bottom: var(--space-lg);
  display: block;
}

.error-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: var(--space-sm);
}

.error-hint {
  font-size: var(--fs-body-small);
  color: var(--text-dim);
  margin-bottom: var(--space-xxl);
  word-break: break-all;
}

/* ==============================
   Buttons
   ============================== */
.btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-sm);
  padding: 20rpx 48rpx;
  border: none;
  border-radius: var(--radius-round);
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--color-text-inverse);
  background: linear-gradient(135deg, var(--gold-light), var(--gold));
  box-shadow: 0 4rpx 24rpx var(--gold-glow);
  transition: all var(--duration-fast) var(--ease-out);
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  transform: scale(0.97);
}

.btn-small {
  padding: 16rpx 36rpx;
  font-size: var(--fs-body-small);
}

/* ==============================
   Spread grid — constellation cards
   ============================== */
.section-title-center {
  text-align: center;
  margin-bottom: var(--space-sm);
}

.spread-grid {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: var(--space-lg);
}

/* ──────────── Base spread card ──────────── */
.spread-card {
  display: flex;
  align-items: center;
  padding: var(--space-xl);
  background: linear-gradient(145deg, #252550 0%, #2A2A5A 100%);
  border: 1.5rpx solid rgba(244, 212, 140, 0.12);
  border-left: 4rpx solid var(--gold-dim);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  transition: all var(--duration-fast) var(--ease-out);
  cursor: pointer;
  position: relative;
  overflow: hidden;
}

.spread-card::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: var(--radius-card);
  background: linear-gradient(135deg, transparent 50%, rgba(244,212,140,0.04));
  pointer-events: none;
}

.spread-card:active {
  transform: scale(0.97);
  background: var(--bg-card-hover);
  border-color: var(--gold);
  border-left-color: var(--gold);
  box-shadow: var(--shadow-card-press);
}

/* ──────────── Premium spread card ──────────── */
.spread-card.premium {
  border-color: rgba(244, 212, 140, 0.20);
  border-left-color: var(--gold);
  background: linear-gradient(135deg, #252550 0%, rgba(244, 212, 140, 0.06) 100%);
}

.spread-card.premium:active {
  border-color: var(--gold-light);
  border-left-color: var(--gold-light);
  box-shadow: var(--shadow-card-press);
}

/* Gold diamond corner for premium */
.premium-diamond {
  position: absolute;
  top: 12rpx;
  right: 14rpx;
  font-size: 18rpx;
  color: var(--gold);
  opacity: 0.50;
  line-height: 1;
  pointer-events: none;
}

/* ──────────── Spread card icon ──────────── */
.spread-card-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: var(--space-lg);
  flex-shrink: 0;
  opacity: 0.75;
}

/* ──────────── Spread card info area ──────────── */
.spread-card-info {
  flex: 1;
  min-width: 0;
}

.spread-card-title-row {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  margin-bottom: 4rpx;
}

.spread-card-desc {
  font-size: var(--fs-body-small);
  color: var(--text-dim);
  line-height: 1.4;
}

/* ──────────── Spread card meta (right column) ──────────── */
.spread-card-meta {
  text-align: right;
  flex-shrink: 0;
  margin-left: var(--space-md);
}

.spread-card-count {
  display: block;
  font-size: var(--fs-body-small);
  color: var(--text-dim);
  margin-bottom: var(--space-xs);
}

/* Badges */
.badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-round);
  font-size: var(--fs-caption);
  font-weight: 600;
}

.badge-gold {
  background: rgba(244,212,140,0.18);
  color: var(--gold-light);
  border: 1rpx solid rgba(244,212,140,0.3);
}

/* Popular badge — subtle gold pill */
.badge-popular {
  display: inline-block;
  padding: 2rpx 14rpx;
  border-radius: var(--radius-round);
  font-size: 20rpx;
  font-weight: 500;
  background: rgba(244, 212, 140, 0.12);
  color: var(--gold);
  border: 1rpx solid rgba(244, 212, 140, 0.20);
  line-height: 1.4;
}

.badge-danger {
  background: rgba(255,107,107,0.15);
  color: var(--danger);
  border: 1rpx solid rgba(255,107,107,0.25);
}

/* ==============================
   Meditation Toggle Pill
   ============================== */
.ritual-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-sm);
  margin: 0 auto var(--space-lg);
  padding: 14rpx 36rpx;
  background: linear-gradient(135deg, rgba(244,212,140,0.12), rgba(244,212,140,0.06));
  border: 1.5rpx solid rgba(244,212,140,0.20);
  border-radius: var(--radius-round);
  cursor: pointer;
  transition: all 0.3s ease;
  width: fit-content;
}

.ritual-toggle:active {
  transform: scale(0.97);
  background: linear-gradient(135deg, rgba(244,212,140,0.18), rgba(244,212,140,0.10));
  border-color: rgba(244,212,140,0.35);
}

.ritual-toggle.active {
  background: linear-gradient(135deg, rgba(244,212,140,0.20), rgba(244,212,140,0.10));
  border-color: var(--gold);
  box-shadow: 0 0 20rpx var(--gold-dim);
}

.ritual-toggle-text {
  font-size: var(--fs-body-small);
  color: var(--text-gold);
  font-weight: 500;
  letter-spacing: 0.04em;
}

.ritual-toggle-icon {
  font-size: 24rpx;
  color: var(--gold);
  opacity: 0.7;
  transition: transform 0.3s ease;
}

.ritual-toggle.active .ritual-toggle-icon {
  opacity: 1;
  transform: rotate(180deg);
}

/* ==============================
   Selected spread info
   ============================== */
.selected-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: var(--space-xl) 0;
}

/* ==============================
   Question box — premium stationery
   ============================== */
.question-box {
  background: linear-gradient(145deg, #252550 0%, #2A2A5A 100%);
  border: 1.5rpx solid var(--gold-dim);
  border-radius: 16rpx;
  padding: 24rpx;
  margin: var(--space-xl) 0 32rpx;
  position: relative;
  overflow: hidden;
}

/* Decorative gold accent line at the top */
.question-box-accent {
  position: absolute;
  top: 0;
  left: 32rpx;
  right: 32rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, var(--gold), transparent);
  opacity: 0.35;
  pointer-events: none;
}

.question-input {
  width: 100%;
  min-height: 200rpx;
  padding: 24rpx;
  background: var(--bg-deep);
  border: 1.5rpx solid rgba(244,212,140,0.10);
  border-radius: 16rpx;
  color: #F0EDE8;
  font-size: var(--fs-body);
  line-height: 1.7;
  box-sizing: border-box;
  outline: none;
  transition: border-color 0.2s ease-out, box-shadow 0.2s ease-out;
}

.question-input:focus {
  border-color: var(--gold);
  border-width: 2rpx;
  box-shadow: 0 0 20rpx var(--gold-dim);
}

.question-input::placeholder {
  color: #B8A9E0;
  font-style: italic;
  font-weight: 300;
}

/* Footer — hint left, char counter pill right */
.question-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

.hint-text {
  font-size: var(--fs-caption);
  color: rgba(244,212,140,0.5);
}

.char-counter {
  display: inline-block;
  padding: 4rpx 16rpx;
  background: rgba(244,212,140,0.12);
  border: 1rpx solid rgba(244,212,140,0.15);
  border-radius: 999rpx;
  font-size: var(--fs-caption);
  color: var(--gold);
  line-height: 1.4;
}

/* Counter warning — amber pill when nearing the limit */
.counter-warning {
  background: rgba(240,160,48,0.15) !important;
  border-color: rgba(240,160,48,0.25) !important;
  color: #f0a030 !important;
}

/* ==============================
   Enhanced question prompt
   ============================== */
.question-prompt {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-md);
  margin-bottom: var(--space-lg);
}

.prompt-stars {
  font-size: 20rpx;
  color: var(--gold);
  opacity: 0.6;
  letter-spacing: 6rpx;
}

.prompt-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--gold);
  text-shadow: 0 0 20rpx var(--gold-dim);
  letter-spacing: 0.04em;
}

/* ==============================
   Theme selection
   ============================== */
/* Theme hint — subtle text below label */
.theme-hint {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: var(--gold);
  opacity: 0.7;
  margin-bottom: var(--space-sm);
  letter-spacing: 0.04em;
  animation: fadeInUp 0.4s ease-out both;
}

/* Theme section label — gold, centered */
.theme-section-label {
  display: block;
  text-align: center;
  color: var(--gold);
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 0.08em;
  margin-bottom: var(--space-lg);
  opacity: 0.85;
}

.theme-options {
  display: flex;
  gap: 16rpx;
}

.theme-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  flex: 1;
  text-align: center;
  padding: 16rpx 8rpx;
  background: #252550;
  border: 1.5rpx solid rgba(244,212,140,0.12);
  border-radius: 16rpx;
  transition: all 0.2s ease-out;
  cursor: pointer;
  box-sizing: border-box;
  min-height: 120rpx;
}

.theme-item:active {
  transform: scale(0.96);
}

.theme-icon {
  width: 40rpx;
  height: 40rpx;
  display: block;
  opacity: 0.75;
}

.theme-label {
  font-size: 24rpx;
  color: #F0EDE8;
  font-weight: 500;
  letter-spacing: 0.04em;
}

.theme-active {
  background: rgba(244,212,140,0.08);
  border-color: rgba(244,212,140,0.30);
}

.theme-active .theme-icon {
  opacity: 1;
}

.theme-active .theme-label {
  color: var(--gold);
}

/* ==============================
   Draw button — glowing pulse
   ============================== */
.btn-glow-pulse {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  padding: 28rpx 0;
  border: none;
  border-radius: var(--radius-round);
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-inverse);
  background: linear-gradient(135deg, var(--gold-light), var(--gold));
  box-shadow: 0 0 40rpx var(--gold-glow);
  transition: all var(--duration-fast) var(--ease-out);
  cursor: pointer;
  position: relative;
  overflow: hidden;
}

.btn-glow-pulse::after {
  border: none;
}

.btn-glow-pulse:not(.drawing):active {
  transform: scale(0.97);
}

.btn-glow-pulse.drawing {
  opacity: 0.8;
  background: linear-gradient(135deg, #D4B06A, #C8A050);
  animation: pulseGlow 1.6s ease-in-out infinite;
}

.btn-glow-pulse[disabled] {
  opacity: 0.5;
}

@keyframes pulseGlow {
  0%, 100% { box-shadow: 0 0 30rpx var(--gold-glow); }
  50% { box-shadow: 0 0 60rpx var(--gold-glow); }
}

/* ==============================
   RITUAL STAGE — Shared
   ============================== */
.ritual-stage {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
  text-align: center;
  padding: var(--space-xxl) var(--space-xl);
  position: relative;
}

.ritual-heading {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--gold);
  letter-spacing: 0.06em;
  text-shadow: 0 0 24rpx var(--gold-dim);
  margin-bottom: var(--space-xxl);
}

.ritual-subtitle {
  font-size: 28rpx;
  color: var(--lavender);
  letter-spacing: 0.08em;
  margin-top: var(--space-xxl);
  opacity: 0.85;
}

.ritual-skip-hint {
  position: absolute;
  bottom: 60rpx;
  font-size: 22rpx;
  color: var(--text-dim);
  opacity: 0.5;
  letter-spacing: 0.04em;
}

/* ==============================
   RITUAL STAGE 0 — Breathing
   ============================== */
.breathing-container {
  position: relative;
  width: 360rpx;
  height: 360rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.breathing-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 35%, rgba(244,212,140,0.30), rgba(244,212,140,0.08));
  box-shadow: 0 0 60rpx rgba(244,212,140,0.25);
  animation: breatheCircle 4s ease-in-out infinite;
  position: absolute;
  z-index: 2;
}

.breathing-ring {
  position: absolute;
  border-radius: 50%;
  border: 1.5rpx solid rgba(244,212,140,0.15);
  pointer-events: none;
}

.breathing-ring-outer {
  width: 360rpx;
  height: 360rpx;
  animation: breatheRingOuter 4s ease-in-out infinite;
  z-index: 1;
}

.breathing-ring-inner {
  width: 240rpx;
  height: 240rpx;
  animation: breatheRingInner 4s ease-in-out infinite;
  z-index: 1;
}

.breathing-text {
  position: absolute;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--gold);
  letter-spacing: 0.08em;
  text-shadow: 0 0 20rpx var(--gold-glow);
  z-index: 3;
  animation: breatheText 4s ease-in-out infinite;
}

@keyframes breatheCircle {
  0%, 100% { transform: scale(0.6); opacity: 0.5; }
  50% { transform: scale(1.6); opacity: 1; }
}

@keyframes breatheRingOuter {
  0%, 100% { transform: scale(0.3); opacity: 0.2; }
  50% { transform: scale(1.0); opacity: 0.6; }
}

@keyframes breatheRingInner {
  0%, 100% { transform: scale(0.5); opacity: 0.3; }
  50% { transform: scale(1.3); opacity: 0.7; }
}

@keyframes breatheText {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}

/* ==============================
   RITUAL STAGE 1 — Shuffle cards
   ============================== */
.shuffle-area {
  position: relative;
  width: 500rpx;
  height: 300rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.shuffle-card {
  position: absolute;
  width: 80rpx;
  height: 120rpx;
  border-radius: 10rpx;
  background: linear-gradient(145deg, #3A3070, #2A2050);
  border: 1rpx solid rgba(244,212,140,0.20);
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.3);
}

/* Card 1 — far left, slow flip */
.shuffle-card-1 {
  animation: shuffleCard1 1.6s cubic-bezier(0.25, 0.46, 0.45, 0.94) infinite;
}

/* Card 2 — left, fast flip */
.shuffle-card-2 {
  animation: shuffleCard2 0.9s cubic-bezier(0.25, 0.46, 0.45, 0.94) infinite;
}

/* Card 3 — center, scale pulse */
.shuffle-card-3 {
  animation: shuffleCard3 0.6s ease-in-out infinite;
}

/* Card 4 — right, fast flip */
.shuffle-card-4 {
  animation: shuffleCard4 1.1s cubic-bezier(0.25, 0.46, 0.45, 0.94) infinite;
}

/* Card 5 — far right, slow flip */
.shuffle-card-5 {
  animation: shuffleCard5 1.8s cubic-bezier(0.25, 0.46, 0.45, 0.94) infinite;
}

/* Card 1: translate left/right + flip */
@keyframes shuffleCard1 {
  0%, 100% { transform: translateX(-180rpx) rotateY(0deg) scale(0.9); opacity: 0.6; }
  25% { transform: translateX(-100rpx) rotateY(180deg) scale(1.05); opacity: 0.9; }
  50% { transform: translateX(-160rpx) rotateY(360deg) scale(0.95); opacity: 0.8; }
  75% { transform: translateX(-120rpx) rotateY(180deg) scale(1.0); opacity: 1; }
}

/* Card 2: slide to center and back */
@keyframes shuffleCard2 {
  0%, 100% { transform: translateX(-90rpx) rotateY(0deg) scale(0.95); opacity: 0.7; }
  30% { transform: translateX(-20rpx) rotateY(180deg) scale(1.0); opacity: 1; }
  60% { transform: translateX(-70rpx) rotateY(360deg) scale(0.95); opacity: 0.8; }
}

/* Card 3: center — scale pulse + subtle rise */
@keyframes shuffleCard3 {
  0%, 100% { transform: translateX(0) scale(0.95); opacity: 0.8; }
  25% { transform: translateX(0) scale(1.15); opacity: 1; }
  50% { transform: translateX(0) scale(0.9); opacity: 0.7; }
  75% { transform: translateX(0) scale(1.1); opacity: 0.9; }
}

/* Card 4: slide left to center */
@keyframes shuffleCard4 {
  0%, 100% { transform: translateX(90rpx) rotateY(0deg) scale(0.95); opacity: 0.7; }
  35% { transform: translateX(20rpx) rotateY(180deg) scale(1.0); opacity: 1; }
  65% { transform: translateX(70rpx) rotateY(360deg) scale(0.95); opacity: 0.8; }
}

/* Card 5: far right */
@keyframes shuffleCard5 {
  0%, 100% { transform: translateX(180rpx) rotateY(0deg) scale(0.9); opacity: 0.6; }
  30% { transform: translateX(100rpx) rotateY(180deg) scale(1.05); opacity: 0.9; }
  55% { transform: translateX(140rpx) rotateY(360deg) scale(0.95); opacity: 0.8; }
  80% { transform: translateX(120rpx) rotateY(180deg) scale(1.0); opacity: 1; }
}

/* ==============================
   Text link
   ============================== */
.btn-text {
  font-size: var(--fs-body);
  color: var(--text-dim);
  cursor: pointer;
  transition: color 0.2s;
}

.btn-text:active {
  color: var(--gold);
}

/* ==============================
   Free tier banner (reading page)
   ============================== */
.reading-free-banner {
  text-align: center;
  margin: 24rpx 0 32rpx;
  padding: 14rpx 20rpx;
}

.reading-free-text {
  font-size: 26rpx;
  color: var(--lavender);
  letter-spacing: 0.04em;
  line-height: 1.5;
}

.reading-free-text--exhausted {
  color: var(--gold);
  font-weight: 500;
}

/* ==============================
   Premium overlay (full-card lock)
   ============================== */
.premium-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  z-index: 2;
}

.premium-overlay-bg {
  position: absolute;
  inset: 0;
  border-radius: var(--radius-card);
  background: linear-gradient(135deg, rgba(80, 60, 140, 0.50) 0%, rgba(60, 40, 120, 0.35) 100%);
  backdrop-filter: blur(2rpx);
}

.premium-overlay-content {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 18rpx 30rpx;
  background: rgba(244, 212, 140, 0.12);
  border: 1rpx solid var(--gold-dim);
  border-radius: var(--radius-sm);
}

.premium-overlay-icon {
  font-size: 28rpx;
  color: var(--gold);
  line-height: 1.2;
}

.premium-overlay-text {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--gold-light);
  letter-spacing: 0.04em;
}

.premium-overlay-sub {
  font-size: 20rpx;
  color: var(--lavender);
  opacity: 0.80;
  letter-spacing: 0.02em;
}

/* ==============================
   Scrollbar hidden
   ============================== */
::-webkit-scrollbar {
  width: 0;
  height: 0;
}
