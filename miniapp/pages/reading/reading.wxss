}

.persona-text-wrap {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  min-width: 0;
}

.persona-name {
  font-size: var(--font-size-caption);
  font-weight: 600;
  color: var(--color-text-primary);
  letter-spacing: 0.04em;
}

.persona-active .persona-name {
  color: var(--color-gold);
}

.persona-label {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  letter-spacing: 1rpx;
  opacity: 0.75;
  white-space: nowrap;
}

.persona-active .persona-label {
  color: var(--color-gold);
  opacity: 0.85;
}

/* ============================================================
   ONBOARDING BUBBLE — Step 2 lightweight hint
   ============================================================ */
.onboarding-bubble-wrap {
  margin: 0 auto 24rpx;
  max-width: 560rpx;
  z-index: 100;
