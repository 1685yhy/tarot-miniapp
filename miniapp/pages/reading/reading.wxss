/* ===== 占卜页 - 至尊神秘主题 ===== */

/* Spread cards */
.spread-grid {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}

.spread-card {
  display: flex;
  align-items: center;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--space-xl);
  border: 1rpx solid var(--color-border-subtle);
  transition: all var(--duration-normal) var(--ease-out);
}

.spread-card:active {
  border-color: var(--color-gold);
  transform: scale(0.98);
  box-shadow: var(--shadow-glow-gold);
}

.spread-card.premium {
  border-left: 4rpx solid var(--color-gold);
  background: linear-gradient(135deg, rgba(212, 175, 55, 0.04), var(--color-bg-card));
}

/* Question section */
.selected-info {
  text-align: center;
  padding: var(--space-xl) 0 var(--space-lg);
}

.question-box {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--space-xl);
  margin-bottom: var(--space-lg);
  border: 1rpx solid var(--color-border-light);
  transition: border-color var(--duration-normal);
}

.question-box:focus-within {
  border-color: var(--color-gold);
  box-shadow: var(--shadow-glow-gold);
}

.question-input {
  width: 100%;
  min-height: 160rpx;
  font-size: var(--fs-body);
  color: var(--color-text-primary);
  line-height: var(--lh-loose);
  background: transparent;
}

/* Theme */
.theme-options {
  display: flex;
  gap: var(--space-md);
  margin-top: var(--space-sm);
}

.theme-item {
  flex: 1;
  text-align: center;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--space-md) 0;
  font-size: var(--fs-body-small);
  color: var(--color-text-secondary);
  border: 2rpx solid transparent;
  transition: all var(--duration-normal);
}

.theme-active {
  border-color: var(--color-gold);
  color: var(--color-gold);
  background: var(--color-gold-subtle);
  box-shadow: var(--shadow-glow-gold);
}

/* ===== 加载骨架 ===== */
.skeleton {
  padding: var(--space-xxl) 0;
}

.skeleton-title {
  width: 280rpx;
  height: 40rpx;
  border-radius: var(--radius-sm);
  background: var(--color-bg-card);
  margin: 0 auto var(--space-sm);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-subtitle {
  width: 200rpx;
  height: 28rpx;
  border-radius: var(--radius-sm);
  background: var(--color-bg-card);
  margin: 0 auto var(--space-xxxl);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-spread {
  width: 100%;
  height: 140rpx;
  border-radius: var(--radius-lg);
  background: var(--color-bg-card);
  margin-bottom: var(--space-md);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

/* ===== 错误状态 ===== */
.error-state {
  text-align: center;
  padding: var(--space-massive) var(--space-xl);
}

.error-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: var(--space-md);
  opacity: 0.6;
}

.error-text {
  font-size: var(--fs-body);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--space-xs);
}

.error-hint {
  font-size: var(--fs-body-small);
  color: var(--color-text-dim);
  display: block;
  margin-bottom: var(--space-xxl);
}

/* ===== 抽牌中按钮动画 ===== */
.draw-btn.drawing {
  opacity: 0.7;
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.draw-btn[disabled] {
  opacity: 0.6;
}
