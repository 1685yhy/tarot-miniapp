/* ==============================
   柔光星辰 — Spread Selection
   Dark indigo + warm golden starlight
   ============================== */

/* ----- Base (inherits common.wxss tokens) ----- */
page {
  min-height: 100vh;
  overflow-x: hidden;
}

/* ==============================
   Glowing orbs
   ============================== */
.orb-top {
  position: fixed;
  top: -200rpx;
  right: -150rpx;
  width: 500rpx;
  height: 500rpx;
  border-radius: 50%;
  background: radial-gradient(circle at center, rgba(244,212,140,0.12) 0%, transparent 70%);
  z-index: 0;
  pointer-events: none;
}

.orb-bottom {
  position: fixed;
  bottom: -250rpx;
  left: -180rpx;
  width: 600rpx;
  height: 600rpx;
  border-radius: 50%;
  background: radial-gradient(circle at center, rgba(100,80,180,0.10) 0%, transparent 70%);
  z-index: 0;
  pointer-events: none;
}

/* ==============================
   Page wrapper
   ============================== */
.page {
  position: relative;
  z-index: 1;
  padding: var(--spacing-xl) 36rpx 80rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ==============================
   Typography helpers
   ============================== */
.heading-2 {
  font-size: var(--font-size-subhead);
  font-weight: 700;
  color: var(--color-text-primary);
  letter-spacing: 0.02em;
}

.heading-4 {
  font-size: var(--font-size-body);
  font-weight: 600;
  color: var(--color-text-primary);
}

.text-center { text-align: center; }
.text-secondary { color: var(--color-text-secondary); }
.text-dim { color: var(--color-text-tertiary); }

.mt-xs { margin-top: var(--spacing-xxs); }
.mt-sm { margin-top: var(--spacing-xs); }
.mb-xxl { margin-bottom: var(--spacing-xl); }
.mb-xxxl { margin-bottom: var(--spacing-2xl); }
.mr-sm { margin-right: var(--spacing-xs); }

/* Animations via common.wxss: .anim-fade-up + .anim-stagger-* */

/* ==============================
   Skeleton loading (shapes only; shimmer from common.wxss)
   ============================== */
.reading-skeleton-wrap {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
  padding: var(--spacing-lg) 0;
}

.skeleton-reading-title {
  width: 50%;
  height: 36rpx;
  border-radius: var(--radius-pill);
}

.skeleton-reading-subtitle {
  width: 35%;
  height: 28rpx;
  border-radius: var(--radius-pill);
  margin-bottom: 28rpx;
}

.skeleton-reading-spread {
  height: 100rpx;
  border-radius: 24rpx;
}

/* ==============================
   Error state
   ============================== */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 36rpx;
  text-align: center;
  position: relative;
  z-index: 1;
}

.error-icon {
  font-size: calc(var(--font-size-display) + 24rpx);
  margin-bottom: 28rpx;
  display: block;
}

.error-text {
  font-size: var(--font-size-body);
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-xs);
}

.error-hint {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  margin-bottom: var(--spacing-xl);
  word-break: break-all;
}

/* Buttons via common.wxss: .btn-primary, .btn--full, .btn--sm */

/* ==============================
   Spread grid — constellation cards
   ============================== */
.section-title-center {
  text-align: center;
  margin-bottom: var(--spacing-xs);
}

.spread-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: var(--spacing-md);
  margin-top: 28rpx;
}

/* ──────────── Base spread card ──────────── */
.spread-card {
  display: flex;
  align-items: center;
  width: calc((100% - 24rpx) / 2);
  padding: var(--spacing-md);
  box-sizing: border-box;
  background: linear-gradient(145deg, var(--color-surface) 0%, var(--color-card) 100%);
  border: 1.5rpx solid rgba(244, 212, 140, 0.12);
  border-left: 4rpx solid var(--color-gold-glow);
  border-radius: 24rpx;
  box-shadow: var(--shadow-card);
  transition: all var(--duration-fast) var(--ease-out);
  cursor: pointer;
  position: relative;
  overflow: hidden;
}

.spread-card::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 24rpx;
  background: linear-gradient(135deg, transparent 50%, rgba(244,212,140,0.04));
  pointer-events: none;
}

.spread-card:active {
  transform: scale(0.97);
  background: var(--color-card);
  border-color: var(--color-gold);
  border-left-color: var(--color-gold);
  box-shadow: var(--shadow-card-press);
}

/* ──────────── Premium spread card ──────────── */
.spread-card.premium {
  border-color: rgba(244, 212, 140, 0.20);
  border-left-color: var(--color-gold);
  background: linear-gradient(135deg, var(--color-surface) 0%, rgba(244, 212, 140, 0.06) 100%);
}

.spread-card.premium:active {
  border-color: var(--color-gold-light);
  border-left-color: var(--color-gold-light);
  box-shadow: var(--shadow-card-press);
}

/* Gold diamond corner for premium */
.premium-diamond {
  position: absolute;
  top: 12rpx;
  right: 14rpx;
  font-size: var(--font-size-xs);
  color: var(--color-gold);
  opacity: 0.50;
  line-height: 1;
  pointer-events: none;
}

/* ──────────── Spread card icon ──────────── */
.spread-card-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  opacity: 0.75;
}

/* ──────────── Spread card info area ──────────── */
.spread-card-info {
  flex: 1;
  min-width: 0;
}

.spread-card-title-row {
  display: flex;
  align-items: center;
  gap: var(--spacing-xs);
  margin-bottom: 4rpx;
}

.spread-card-desc {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.spread-card-plainDesc {
  font-size: var(--font-size-xs);
  color: var(--color-lavender);
  line-height: 1.4;
  margin-top: 4rpx;
  opacity: 0.80;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ──────────── Spread card meta (right column) ──────────── */
.spread-card-meta {
  text-align: right;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.spread-card-count {
  display: block;
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  margin-bottom: var(--spacing-xxs);
}

/* Badges */
.badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-pill);
  font-size: var(--font-size-caption);
  font-weight: 600;
}

.badge-gold {
  background: rgba(244,212,140,0.18);
  color: var(--color-gold-light);
  border: 1rpx solid rgba(244,212,140,0.3);
}

/* Popular badge — subtle gold pill */
.badge-popular {
  display: inline-block;
  padding: 2rpx 14rpx;
  border-radius: var(--radius-pill);
  font-size: var(--font-size-xs);
  font-weight: 500;
  background: rgba(244, 212, 140, 0.12);
  color: var(--color-gold);
  border: 1rpx solid rgba(244, 212, 140, 0.20);
  line-height: 1.4;
}

.badge-danger {
  background: rgba(255,107,107,0.15);
  color: var(--color-error);
  border: 1rpx solid rgba(255,107,107,0.25);
}

/* ==============================
   Meditation Toggle Pill
   ============================== */
.ritual-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-xs);
  margin: 0 auto 28rpx;
  padding: var(--spacing-sm) var(--spacing-lg);
  background: linear-gradient(135deg, rgba(244,212,140,0.12), rgba(244,212,140,0.06));
  border: 1.5rpx solid rgba(244,212,140,0.20);
  border-radius: var(--radius-pill);
  cursor: pointer;
  transition: all var(--duration-fast) var(--ease-out);
  width: fit-content;
}

.ritual-toggle:active {
  transform: scale(0.97);
  background: linear-gradient(135deg, rgba(244,212,140,0.18), rgba(244,212,140,0.10));
  border-color: rgba(244,212,140,0.35);
}

.ritual-toggle.active {
  background: linear-gradient(135deg, rgba(244,212,140,0.20), rgba(244,212,140,0.10));
  border-color: var(--color-gold);
  box-shadow: 0 0 20rpx var(--color-gold-glow);
}

.ritual-toggle-text {
  font-size: var(--font-size-caption);
  color: var(--color-gold);
  font-weight: 500;
  letter-spacing: 0.04em;
}

.ritual-toggle-icon {
  font-size: var(--font-size-caption);
  color: var(--color-gold);
  opacity: 0.7;
  transition: transform 0.15s ease-out;
}

.ritual-toggle.active .ritual-toggle-icon {
  opacity: 1;
  transform: rotate(180deg);
}

/* ==============================
   Selected spread info
   ============================== */
.selected-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: var(--spacing-lg) 0;
}

/* ==============================
   Question box — premium stationery
   ============================== */
.question-box {
  background: linear-gradient(145deg, var(--color-surface) 0%, var(--color-card) 100%);
  border: 1.5rpx solid var(--color-gold-glow);
  border-radius: 16rpx;
  padding: var(--spacing-md);
  margin: var(--spacing-lg) 0 var(--spacing-lg);
  position: relative;
  overflow: hidden;
}

/* Decorative gold accent line at the top */
.question-box-accent {
  position: absolute;
  top: 0;
  left: 32rpx;
  right: 32rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, var(--color-gold), transparent);
  opacity: 0.35;
  pointer-events: none;
}

.question-input {
  width: 100%;
  min-height: 200rpx;
  padding: var(--spacing-md);
  background: var(--color-bg);
  border: 1.5rpx solid rgba(244,212,140,0.10);
  border-radius: 16rpx;
  color: var(--color-text-primary);
  font-size: var(--font-size-body);
  line-height: 1.7;
  box-sizing: border-box;
  outline: none;
  transition: border-color 0.2s ease-out, box-shadow 0.2s ease-out;
}

.question-input:focus {
  border-color: var(--color-gold);
  border-width: 2rpx;
  box-shadow: 0 0 20rpx var(--color-gold-glow);
}

.question-input::placeholder {
  color: var(--color-lavender);
  font-style: italic;
  font-weight: 300;
}

/* Footer — hint left, char counter pill right */
.question-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

.hint-text {
  font-size: var(--font-size-caption);
  color: rgba(244,212,140,0.5);
}

.char-counter {
  display: inline-block;
  padding: 4rpx 16rpx;
  background: rgba(244,212,140,0.12);
  border: 1rpx solid rgba(244,212,140,0.15);
  border-radius: 999rpx;
  font-size: var(--font-size-caption);
  color: var(--color-gold);
  line-height: 1.4;
}

/* Counter warning — amber pill when nearing the limit */
.counter-warning {
  background: rgba(232, 200, 122, 0.15) !important;
  border-color: rgba(232, 200, 122, 0.25) !important;
  color: var(--color-warning) !important;
}

/* ==============================
   Enhanced question prompt
   ============================== */
.question-prompt {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-sm);
  margin-bottom: 28rpx;
}

.prompt-stars {
  font-size: var(--font-size-xs);
  color: var(--color-gold);
  opacity: 0.6;
  letter-spacing: 6rpx;
}

.prompt-text {
  font-size: var(--font-size-body);
  font-weight: 600;
  color: var(--color-gold);
  text-shadow: 0 0 20rpx var(--color-gold-glow);
  letter-spacing: 0.04em;
}

/* ==============================
   Theme selection
   ============================== */
/* Theme hint — subtle text below label */
.theme-hint {
  display: block;
  text-align: center;
  font-size: var(--font-size-caption);
  color: var(--color-gold);
  opacity: 0.7;
  margin-bottom: var(--spacing-xs);
  letter-spacing: 0.04em;
  animation: fadeInUp 0.4s ease-out both;
}

/* Theme section label — gold, centered */
.theme-section-label {
  display: block;
  text-align: center;
  color: var(--color-gold);
  font-size: var(--font-size-caption);
  font-weight: 500;
  letter-spacing: 0.08em;
  margin-bottom: 28rpx;
  opacity: 0.85;
}

.theme-options {
  display: flex;
  gap: var(--spacing-sm);
}

.theme-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-xxs);
  flex: 1;
  text-align: center;
  padding: var(--spacing-sm) var(--spacing-xxs);
  background: var(--color-surface);
  border: 1.5rpx solid rgba(244,212,140,0.12);
  border-radius: 16rpx;
  transition: all 0.2s ease-out;
  cursor: pointer;
  box-sizing: border-box;
  min-height: 120rpx;
  min-width: 120rpx;
}

.theme-item:active {
  transform: scale(0.96);
}

.theme-icon {
  width: 40rpx;
  height: 40rpx;
  display: block;
  opacity: 0.75;
}

.theme-label {
  font-size: var(--font-size-caption);
  color: var(--color-text-primary);
  font-weight: 500;
  letter-spacing: 0.04em;
}

.theme-active {
  background: rgba(244,212,140,0.08);
  border-color: rgba(244,212,140,0.30);
}

.theme-active .theme-icon {
  opacity: 1;
}

.theme-active .theme-label {
  color: var(--color-gold);
}

/* Filter item for spread selection */
.filter-item {
  min-height: 88rpx;
}

/* ============================================================
   RIPPLE EFFECT — Premium button interaction
   ============================================================ */
.btn-primary.btn--full {
  position: relative;
  overflow: hidden;
}
.btn-primary.btn--full::after {
  content: '';
  position: absolute;
  top: 50%; left: 50%;
  width: 0; height: 0;
  border-radius: 50%;
  background: rgba(255,255,255,0.3);
  transform: translate(-50%, -50%);
  transition: width 0.6s, height 0.6s, opacity 0.6s;
}
.btn-primary.btn--full:active::after {
  width: 600rpx;
  height: 600rpx;
  opacity: 0;
}

/* ==============================
   Draw button — drawing state only (base via common .btn-primary.btn--full)
   ============================== */
.btn-drawing {
  opacity: 0.8;
  background: linear-gradient(135deg, var(--color-gold-dark), var(--color-gold-dark));
  animation: pulseGlow 1.6s ease-in-out infinite;
}

@keyframes pulseGlow {
  0%, 100% { box-shadow: 0 0 30rpx var(--color-gold-glow); }
  50% { box-shadow: 0 0 60rpx var(--color-gold-glow); }
}

/* ==============================
   AI解读时间提示 — subtle note below draw button
   ============================== */
.reading-time-note {
  display: block;
  text-align: center;
  font-size: var(--font-size-caption, 24rpx);
  color: var(--color-text-tertiary, rgba(160, 152, 192, 0.5));
  letter-spacing: 2rpx;
  margin-top: 12rpx;
  opacity: 0.6;
}

/* ==============================
   RITUAL STAGE — Shared
   ============================== */
.ritual-stage {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
  text-align: center;
  padding: var(--spacing-xl) 36rpx;
  position: relative;
}

.ritual-heading {
  font-size: var(--font-size-subhead);
  font-weight: 600;
  color: var(--color-gold);
  letter-spacing: 0.06em;
  text-shadow: 0 0 24rpx var(--color-gold-glow);
  margin-bottom: var(--spacing-xl);
}

.ritual-subtitle {
  font-size: var(--font-size-body);
  color: var(--color-lavender);
  letter-spacing: 0.08em;
  margin-top: var(--spacing-xl);
  opacity: 0.85;
}

.ritual-skip-hint {
  position: absolute;
  bottom: 60rpx;
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  opacity: 0.5;
  letter-spacing: 0.04em;
}

/* ==============================
   RITUAL STAGE 0 — Breathing
   ============================== */
.breathing-container {
  position: relative;
  width: 360rpx;
  height: 360rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.breathing-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 35%, rgba(244,212,140,0.30), rgba(244,212,140,0.08));
  box-shadow: 0 0 60rpx rgba(244,212,140,0.25);
  animation: breatheCircle 4s ease-in-out infinite;
  position: absolute;
  z-index: 2;
}

.breathing-ring {
  position: absolute;
  border-radius: 50%;
  border: 1.5rpx solid rgba(244,212,140,0.15);
  pointer-events: none;
}

.breathing-ring-outer {
  width: 360rpx;
  height: 360rpx;
  animation: breatheRingOuter 4s ease-in-out infinite;
  z-index: 1;
}

.breathing-ring-inner {
  width: 240rpx;
  height: 240rpx;
  animation: breatheRingInner 4s ease-in-out infinite;
  z-index: 1;
}

.breathing-text {
  position: absolute;
  font-size: var(--font-size-caption);
  font-weight: 500;
  color: var(--color-gold);
  letter-spacing: 0.08em;
  text-shadow: 0 0 20rpx var(--color-gold-glow);
  z-index: 3;
  animation: breatheText 4s ease-in-out infinite;
}

@keyframes breatheCircle {
  0%, 100% { transform: scale(0.6); opacity: 0.5; }
  50% { transform: scale(1.6); opacity: 1; }
}

@keyframes breatheRingOuter {
  0%, 100% { transform: scale(0.3); opacity: 0.2; }
  50% { transform: scale(1.0); opacity: 0.6; }
}

@keyframes breatheRingInner {
  0%, 100% { transform: scale(0.5); opacity: 0.3; }
  50% { transform: scale(1.3); opacity: 0.7; }
}

@keyframes breatheText {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}

/* ==============================
   RITUAL STAGE 1 — Shuffle cards
   ============================== */
.shuffle-area {
  position: relative;
  width: 500rpx;
  height: 300rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.shuffle-card {
  position: absolute;
  width: 80rpx;
  height: 120rpx;
  border-radius: var(--radius-sm);
  background: linear-gradient(145deg, #3A3070, #2A2050);
  border: 1rpx solid rgba(244,212,140,0.20);
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.3);
}

/* Card 1 — far left, slow flip */
.shuffle-card-1 {
  animation: shuffleCard1 1.6s cubic-bezier(0.25, 0.46, 0.45, 0.94) infinite;
}

/* Card 2 — left, fast flip */
.shuffle-card-2 {
  animation: shuffleCard2 0.9s cubic-bezier(0.25, 0.46, 0.45, 0.94) infinite;
}

/* Card 3 — center, scale pulse */
.shuffle-card-3 {
  animation: shuffleCard3 0.6s ease-in-out infinite;
}

/* Card 4 — right, fast flip */
.shuffle-card-4 {
  animation: shuffleCard4 1.1s cubic-bezier(0.25, 0.46, 0.45, 0.94) infinite;
}

/* Card 5 — far right, slow flip */
.shuffle-card-5 {
  animation: shuffleCard5 1.8s cubic-bezier(0.25, 0.46, 0.45, 0.94) infinite;
}

/* Card 1: translate left/right + flip (scaleX + opacity for WXSS compat) */
@keyframes shuffleCard1 {
  0%, 100% { transform: translateX(-180rpx) scaleX(1) scale(0.9); opacity: 1; }
  25% { transform: translateX(-100rpx) scaleX(0.3) scale(1.05); opacity: 0.4; }
  50% { transform: translateX(-160rpx) scaleX(1) scale(0.95); opacity: 1; }
  75% { transform: translateX(-120rpx) scaleX(0.3) scale(1.0); opacity: 0.4; }
}

/* Card 2: slide to center and back */
@keyframes shuffleCard2 {
  0%, 100% { transform: translateX(-90rpx) scaleX(1) scale(0.95); opacity: 1; }
  30% { transform: translateX(-20rpx) scaleX(0.3) scale(1.0); opacity: 0.4; }
  60% { transform: translateX(-70rpx) scaleX(1) scale(0.95); opacity: 1; }
}

/* Card 3: center — scale pulse + subtle rise */
@keyframes shuffleCard3 {
  0%, 100% { transform: translateX(0) scale(0.95); opacity: 0.8; }
  25% { transform: translateX(0) scale(1.15); opacity: 1; }
  50% { transform: translateX(0) scale(0.9); opacity: 0.7; }
  75% { transform: translateX(0) scale(1.1); opacity: 0.9; }
}

/* Card 4: slide left to center */
@keyframes shuffleCard4 {
  0%, 100% { transform: translateX(90rpx) scaleX(1) scale(0.95); opacity: 1; }
  35% { transform: translateX(20rpx) scaleX(0.3) scale(1.0); opacity: 0.4; }
  65% { transform: translateX(70rpx) scaleX(1) scale(0.95); opacity: 1; }
}

/* Card 5: far right */
@keyframes shuffleCard5 {
  0%, 100% { transform: translateX(180rpx) scaleX(1) scale(0.9); opacity: 1; }
  30% { transform: translateX(100rpx) scaleX(0.3) scale(1.05); opacity: 0.4; }
  55% { transform: translateX(140rpx) scaleX(1) scale(0.95); opacity: 1; }
  80% { transform: translateX(120rpx) scaleX(0.3) scale(1.0); opacity: 0.4; }
}

/* ==============================
   Mode selector cards — quick / immersive
   ============================== */
.mode-selector {
  display: flex;
  gap: 24rpx;
  margin: 28rpx auto 0;
  justify-content: center;
  width: 100%;
  box-sizing: border-box;
}

.mode-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  max-width: 320rpx;
  padding: 24rpx 20rpx;
  background: var(--color-surface);
  border: 1.5rpx solid rgba(244, 212, 140, 0.12);
  border-radius: 20rpx;
  cursor: pointer;
  transition: all 0.2s ease-out;
  box-sizing: border-box;
}

.mode-card:active {
  transform: scale(0.96);
}

.mode-card.mode-active {
  background: rgba(244, 212, 140, 0.08);
  border-color: rgba(244, 212, 140, 0.30);
}

.mode-card-icon {
  font-size: 40rpx;
  line-height: 1;
  flex-shrink: 0;
}

.mode-card-text-wrap {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.mode-card-name {
  font-size: var(--font-size-caption);
  font-weight: 600;
  color: var(--color-text-primary);
  letter-spacing: 0.04em;
}

.mode-card.mode-active .mode-card-name {
  color: var(--color-gold);
}

.mode-card-desc {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  letter-spacing: 1rpx;
  opacity: 0.75;
  white-space: nowrap;
}

/* ==============================
   Text link
   ============================== */
.btn-text {
  font-size: var(--font-size-body);
  color: var(--color-text-tertiary);
  cursor: pointer;
  transition: color 0.2s;
}

.btn-text:active {
  color: var(--color-gold);
}

/* ==============================
   Free tier — Progress bar
   ============================== */
.free-quota-bar {
  text-align: center;
  margin: var(--spacing-md) 0 var(--spacing-lg);
  padding: var(--spacing-sm) var(--spacing-sm);
}

.quota-progress-wrap {
  width: 240rpx;
  height: 8rpx;
  background: rgba(184, 169, 224, 0.12);
  border-radius: 999rpx;
  margin: 0 auto var(--spacing-xs);
  overflow: hidden;
}

.quota-progress {
  height: 100%;
  background: linear-gradient(90deg, #F4D48C, #D4B06A);
  border-radius: 999rpx;
  transition: width 0.4s ease-out;
}

.quota-text {
  font-size: var(--font-size-caption);
  color: var(--color-lavender);
  letter-spacing: 0.04em;
  line-height: 1.5;
}

.quota-text--exhausted {
  color: var(--color-gold);
  font-weight: 500;
}

/* ─── Exhausted-state quick purchase buttons ─── */
.exhausted-packs {
  display: flex;
  justify-content: center;
  gap: var(--spacing-sm);
  margin-top: var(--spacing-sm);
}

.exhausted-pack-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 200rpx;
  padding: var(--spacing-xs) var(--spacing-md);
  border: 1.5rpx solid rgba(244, 212, 140, 0.25);
  border-radius: var(--radius-pill);
  font-size: var(--font-size-caption);
  font-weight: 600;
  color: var(--color-gold);
  background: transparent;
  letter-spacing: 1rpx;
  transition: all 0.15s;
  line-height: 1.4;
}

.exhausted-pack-btn::after {
  border: none;
}

.exhausted-pack-btn:active {
  background: rgba(244, 212, 140, 0.10);
  transform: scale(0.96);
}

.exhausted-pack-btn--best {
  background: linear-gradient(135deg, #F4D48C, #E8C67A);
  color: var(--color-text-inverse);
  border: none;
  box-shadow: 0 2rpx 16rpx rgba(244, 212, 140, 0.25);
  font-weight: 700;
}

.exhausted-pack-btn--best:active {
  background: linear-gradient(135deg, #E8C67A, #D4B06A);
  transform: scale(0.96);
}

/* ==============================
   Premium overlay (full-card lock)
   ============================== */
.premium-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  z-index: 2;
}

.premium-overlay-bg {
  position: absolute;
  inset: 0;
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(80, 60, 140, 0.50) 0%, rgba(60, 40, 120, 0.35) 100%);
  backdrop-filter: blur(2rpx);
}

.premium-overlay-content {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: var(--spacing-xs) var(--spacing-sm);
  background: rgba(244, 212, 140, 0.12);
  border: 1rpx solid var(--color-gold-glow);
  border-radius: 12rpx;
}

.premium-overlay-icon {
  width: 40rpx;
  height: 40rpx;
  display: block;
}

.premium-overlay-text {
  font-size: var(--font-size-caption);
  font-weight: 700;
  color: var(--color-gold-light);
  letter-spacing: 0.04em;
}

.premium-overlay-sub {
  font-size: var(--font-size-xs);
  color: var(--color-lavender);
  opacity: 0.80;
  letter-spacing: 0.02em;
}

/* ==============================
   Selected spread info — icon + labels
   ============================== */
.selected-spread-icon {
  font-size: var(--font-size-display);
  display: block;
}

.btn-back-spreads {
  text-align: center;
  display: inline-block;
  margin: var(--spacing-md) auto 0;
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  padding: 28rpx 48rpx;
  border: 1rpx solid rgba(160, 152, 192, 0.2);
  border-radius: var(--radius-pill);
  letter-spacing: 2rpx;
  transition: opacity 0.2s, border-color 0.2s, background 0.2s;
}

.btn-back-spreads:active {
  opacity: 0.8;
  border-color: rgba(160, 152, 192, 0.4);
  background: rgba(160, 152, 192, 0.05);
}

/* ==============================
   Theme lock banner — for themed spreads
   ============================== */
.theme-lock-banner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-xs);
  margin: var(--spacing-lg) auto;
  padding: var(--spacing-sm) var(--spacing-lg);
  background: rgba(244, 212, 140, 0.06);
  border: 1rpx solid rgba(244, 212, 140, 0.15);
  border-radius: 999rpx;
  width: fit-content;
}

.theme-lock-icon {
  font-size: var(--font-size-caption);
  color: var(--color-gold);
  opacity: 0.7;
}

.theme-lock-text {
  font-size: var(--font-size-caption);
  color: var(--color-lavender);
  letter-spacing: 2rpx;
}

.theme-lock-keyword {
  color: var(--color-gold);
  font-weight: 600;
  letter-spacing: 3rpx;
  padding: 0 4rpx;
}

/* Center wrapper for back button */
.spread-grid + view:has(.btn-back-spreads),
view:has(> .btn-back-spreads) {
  text-align: center;
}

/* ==============================
   Scrollbar hidden
   ============================== */
::-webkit-scrollbar {
  width: 0;
  height: 0;
}

/* ================================================================
   Drawing overlay — full screen loading while AI works
   ================================================================ */
.drawing-overlay {
  position: fixed; inset: 0; z-index: 100;
  background: rgba(10, 10, 30, 0.95);
  display: flex; align-items: center; justify-content: center;
  opacity: 0; pointer-events: none;
  transition: opacity 0.4s ease;
}
.drawing-overlay--active { opacity: 1; pointer-events: auto; }
.drawing-stage { display: flex; flex-direction: column; align-items: center; }
.shuffle-area-large { position: relative; width: 200rpx; height: 200rpx; margin-bottom: 48rpx; }
.shuffle-card-large { position: absolute; width: 120rpx; height: 160rpx; border-radius: 12rpx; background: var(--color-surface-gradient); border: 2rpx solid rgba(244,212,140,0.2); }
.shuffle-card-large.s1 { top: 0; left: 40rpx; transform: rotate(-8deg); animation: sm1 1.5s ease-in-out infinite; }
.shuffle-card-large.s2 { top: 20rpx; left: 60rpx; transform: rotate(2deg); animation: sm2 1.8s ease-in-out infinite; }
.shuffle-card-large.s3 { top: 10rpx; left: 20rpx; transform: rotate(-3deg); animation: sm3 2s ease-in-out infinite; }
@keyframes sm1 { 0%,100% { transform: rotate(-8deg) translateX(0); } 50% { transform: rotate(5deg) translateX(30rpx); } }
@keyframes sm2 { 0%,100% { transform: rotate(2deg) translateX(0); } 50% { transform: rotate(-6deg) translateX(-25rpx); } }
@keyframes sm3 { 0%,100% { transform: rotate(-3deg) translateY(0); } 50% { transform: rotate(8deg) translateY(-20rpx); } }
.drawing-orb { position: relative; width: 160rpx; height: 160rpx; margin-bottom: 48rpx; }
.drawing-ring { position: absolute; inset: 0; border-radius: 50%; border: 4rpx solid rgba(244,212,140,0.1); border-top-color: var(--color-gold); animation: dspin 1.2s linear infinite; }
@keyframes dspin { to { transform: rotate(360deg); } }
.drawing-orb-icon { font-size: 64rpx; line-height: 160rpx; text-align: center; display: block; }
.drawing-title { font-size: var(--font-size-title); font-weight: 700; color: var(--color-gold); letter-spacing: 3rpx; }
.drawing-sub { font-size: var(--font-size-caption); color: var(--color-text-tertiary); margin-top: 16rpx; letter-spacing: 2rpx; }

/* ============================================================
   ACCESSIBILITY: Reduced Motion
   ============================================================ */
@media (prefers-reduced-motion: reduce) {
  .shuffle-card { animation: none; }
  .breathing-ring { animation: none; }
  .breathing-circle { animation: none; }
}

/* ============================================================
   Exhausted Overlay — Beautiful full-screen membership CTA
   ============================================================ */
.exhausted-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(10, 10, 30, 0.92);
  z-index: var(--z-modal);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-lg);
  animation: exhausted-fade-in 0.3s ease-out;
}

@keyframes exhausted-fade-in {
  0% { opacity: 0; }
  100% { opacity: 1; }
}

.exhausted-card {
  position: relative;
  width: 100%;
  max-width: 520rpx;
  background: linear-gradient(145deg, #2A2A5A 0%, #353570 100%);
  border: 2rpx solid rgba(244, 212, 140, 0.25);
  border-radius: 32rpx;
  padding: var(--spacing-2xl) var(--spacing-lg) var(--spacing-lg);
  text-align: center;
  overflow: hidden;
  animation: exhausted-card-enter 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
}

@keyframes exhausted-card-enter {
  0% { opacity: 0; transform: scale(0.88) translateY(40rpx); }
  100% { opacity: 1; transform: scale(1) translateY(0); }
}

.exhausted-stars {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  pointer-events: none;
}

.exhausted-star {
  position: absolute;
  font-size: 28rpx;
  color: var(--color-gold);
  text-shadow: 0 0 16rpx rgba(244, 212, 140, 0.5);
  animation: exhausted-star-burst 0.8s ease-out forwards;
  opacity: 0;
}

.exhausted-star-1 { top: 24rpx; left: 18%; animation-delay: 0.15s; }
.exhausted-star-2 { top: 16rpx; left: 50%; margin-left: -14rpx; animation-delay: 0.25s; }
.exhausted-star-3 { top: 24rpx; right: 18%; animation-delay: 0.35s; }

@keyframes exhausted-star-burst {
  0% { opacity: 0; transform: scale(0) rotate(-30deg); }
  50% { opacity: 1; transform: scale(1.4) rotate(15deg); }
  100% { opacity: 0.8; transform: scale(1) rotate(0deg); }
}

.exhausted-icon {
  font-size: 64rpx;
  display: block;
  margin-bottom: var(--spacing-sm);
}

.exhausted-title {
  font-size: var(--font-size-title);
  font-weight: 700;
  color: var(--color-gold);
  display: block;
  letter-spacing: 3rpx;
  margin-bottom: var(--spacing-xxs);
}

.exhausted-sub {
  font-size: var(--font-size-caption);
  color: var(--color-lavender);
  display: block;
  margin-bottom: var(--spacing-md);
  letter-spacing: 2rpx;
  opacity: 0.8;
}

.exhausted-divider {
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(244, 212, 140, 0.20), transparent);
  margin: 0 var(--spacing-lg) var(--spacing-md);
}

.exhausted-cta-text {
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  display: block;
  margin-bottom: var(--spacing-md);
  letter-spacing: 2rpx;
  font-weight: 500;
}

.exhausted-cta-btn {
  display: block;
  width: 70%;
  margin: 0 auto;
  padding: var(--spacing-sm) 0;
  background: linear-gradient(135deg, #F4D48C 0%, #E8C67A 50%, #D4B06A 100%);
  color: #1A1A3E;
  font-size: var(--font-size-body);
  font-weight: 700;
  border: none;
  border-radius: var(--radius-pill);
  letter-spacing: 3rpx;
  box-shadow: 0 4rpx 28rpx rgba(244, 212, 140, 0.30);
}

.exhausted-cta-btn::after {
  border: none;
}

.exhausted-cta-btn:active {
  transform: scale(0.96);
  box-shadow: 0 2rpx 12rpx rgba(244, 212, 140, 0.20);
}

.exhausted-dismiss {
  display: inline-block;
  margin-top: var(--spacing-md);
  padding: var(--spacing-xs) var(--spacing-lg);
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  letter-spacing: 2rpx;
  opacity: 0.6;
}

.exhausted-dismiss:active {
  opacity: 1;
}

/* ==============================
   Persona selection — reader character cards
   ============================== */
.persona-section {
  margin-bottom: var(--spacing-xl);
}

.persona-section-label {
  display: block;
  text-align: center;
  color: var(--color-gold);
  font-size: var(--font-size-caption);
  font-weight: 500;
  letter-spacing: 0.08em;
  margin-bottom: 20rpx;
  opacity: 0.85;
}

.persona-options {
  display: flex;
  gap: var(--spacing-sm);
  justify-content: center;
}

.persona-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-xxs);
  flex: 1;
  text-align: center;
  padding: var(--spacing-md) var(--spacing-xxs);
  background: var(--color-surface);
  border: 1.5rpx solid rgba(244,212,140,0.12);
