/* ==============================
   柔光星辰 — Spread Selection
   Dark indigo + warm golden starlight
   ============================== */

/* ----- CSS Variables ----- */
page {
  --bg-deep: var(--color-bg);
  --bg-card: #161329;
  --bg-card-hover: #1c1938;
  --bg-elevated: #201d3e;
  --gold: #F4D48C;
  --gold-light: #FADE9E;
  --gold-glow: rgba(244, 212, 140, 0.35);
  --gold-dim: rgba(244, 212, 140, 0.15);
  --text-primary: #e8e4f0;
  --text-secondary: #b8b0d0;
  --text-dim: #A098C0;
  --text-gold: #e8c84a;
  --danger: #ff6b6b;
  --fs-caption: 22rpx;
  --fs-body-small: 24rpx;
  --fs-body: 28rpx;
  --space-xs: 8rpx;
  --space-sm: 12rpx;
  --space-md: 20rpx;
  --space-lg: 28rpx;
  --space-xl: 36rpx;
  --space-xxl: 48rpx;
  --space-xxxl: 64rpx;
  --radius-card: 24rpx;
  --radius-sm: 12rpx;
  --radius-round: 999rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  background: var(--bg-deep);
  color: var(--text-primary);
  font-size: var(--fs-body);
  line-height: 1.6;
  min-height: 100vh;
  overflow-x: hidden;
}

/* ==============================
   Glowing orbs
   ============================== */
.orb-top {
  position: fixed;
  top: -200rpx;
  right: -150rpx;
  width: 500rpx;
  height: 500rpx;
  border-radius: 50%;
  background: radial-gradient(circle at center, rgba(244,212,140,0.12) 0%, transparent 70%);
  z-index: 0;
  pointer-events: none;
}

.orb-bottom {
  position: fixed;
  bottom: -250rpx;
  left: -180rpx;
  width: 600rpx;
  height: 600rpx;
  border-radius: 50%;
  background: radial-gradient(circle at center, rgba(100,80,180,0.10) 0%, transparent 70%);
  z-index: 0;
  pointer-events: none;
}

/* ==============================
   Page wrapper
   ============================== */
.page {
  position: relative;
  z-index: 1;
  padding: var(--space-xxl) var(--space-xl) 80rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ==============================
   Typography helpers
   ============================== */
.heading-2 {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 0.02em;
}

.heading-4 {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.text-center { text-align: center; }
.text-secondary { color: var(--text-secondary); }
.text-dim { color: var(--text-dim); }

.mt-xs { margin-top: var(--space-xs); }
.mt-sm { margin-top: var(--space-sm); }
.mb-xxl { margin-bottom: var(--space-xxl); }
.mb-xxxl { margin-bottom: var(--space-xxxl); }

/* ==============================
   Animations
   ============================== */
.anim-fade-in-up-1 {
  animation: fadeInUp 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
}
.anim-fade-in-up-2 {
  animation: fadeInUp 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.12s both;
}
.anim-fade-in-up-3 {
  animation: fadeInUp 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.24s both;
}
.anim-fade-in-up-4 {
  animation: fadeInUp 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.36s both;
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ==============================
   Skeleton loading
   ============================== */
.skeleton {
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
  padding: var(--space-xl) 0;
}

.skeleton-title {
  width: 50%;
  height: 36rpx;
  border-radius: var(--radius-round);
  background: linear-gradient(90deg, var(--bg-card) 25%, var(--bg-elevated) 50%, var(--bg-card) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.6s infinite;
}

.skeleton-subtitle {
  width: 35%;
  height: 28rpx;
  border-radius: var(--radius-round);
  background: linear-gradient(90deg, var(--bg-card) 25%, var(--bg-elevated) 50%, var(--bg-card) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.6s infinite;
  margin-bottom: var(--space-lg);
}

.skeleton-spread {
  height: 100rpx;
  border-radius: var(--radius-card);
  background: linear-gradient(90deg, var(--bg-card) 25%, var(--bg-elevated) 50%, var(--bg-card) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.6s infinite;
}

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ==============================
   Error state
   ============================== */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx var(--space-xl);
  text-align: center;
  position: relative;
  z-index: 1;
}

.error-icon {
  font-size: 80rpx;
  margin-bottom: var(--space-lg);
  display: block;
}

.error-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: var(--space-sm);
}

.error-hint {
  font-size: var(--fs-body-small);
  color: var(--text-dim);
  margin-bottom: var(--space-xxl);
  word-break: break-all;
}

/* ==============================
   Buttons
   ============================== */
.btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-sm);
  padding: 20rpx 48rpx;
  border: none;
  border-radius: var(--radius-round);
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--color-text-inverse);
  background: linear-gradient(135deg, var(--gold-light), var(--gold));
  box-shadow: 0 4rpx 24rpx var(--gold-glow);
  transition: all 0.25s;
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  transform: scale(0.96);
}

.btn-small {
  padding: 16rpx 36rpx;
  font-size: var(--fs-body-small);
}

/* ==============================
   Spread grid — constellation cards
   ============================== */
.section-title-center {
  text-align: center;
  margin-bottom: var(--space-sm);
}

.spread-grid {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: var(--space-lg);
}

/* ──────────── Base spread card ──────────── */
.spread-card {
  display: flex;
  align-items: center;
  padding: var(--space-lg);
  background: var(--bg-card);
  border: 1.5rpx solid rgba(244, 212, 140, 0.10);
  border-left: 4rpx solid var(--gold-dim);
  border-radius: var(--radius-card);
  transition: all 0.3s ease;
  cursor: pointer;
  position: relative;
  overflow: hidden;
}

.spread-card::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: var(--radius-card);
  background: linear-gradient(135deg, transparent 50%, rgba(244,212,140,0.04));
  pointer-events: none;
}

.spread-card:active {
  transform: scale(0.97);
  background: var(--bg-card-hover);
  border-color: var(--gold);
  border-left-color: var(--gold);
  box-shadow: 0 0 30rpx var(--gold-dim);
}

/* ──────────── Premium spread card ──────────── */
.spread-card.premium {
  border-color: rgba(244, 212, 140, 0.20);
  border-left-color: var(--gold);
  background: linear-gradient(135deg, rgba(42, 42, 90, 0.95) 0%, rgba(244, 212, 140, 0.08) 100%);
}

.spread-card.premium:active {
  border-color: var(--gold-light);
  border-left-color: var(--gold-light);
}

/* Gold diamond corner for premium */
.premium-diamond {
  position: absolute;
  top: 12rpx;
  right: 14rpx;
  font-size: 18rpx;
  color: var(--gold);
  opacity: 0.50;
  line-height: 1;
  pointer-events: none;
}

/* ──────────── Spread card icon ──────────── */
.spread-card-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: var(--space-lg);
  flex-shrink: 0;
  opacity: 0.75;
}

/* ──────────── Spread card info area ──────────── */
.spread-card-info {
  flex: 1;
  min-width: 0;
}

.spread-card-title-row {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  margin-bottom: 4rpx;
}

.spread-card-desc {
  font-size: var(--fs-body-small);
  color: var(--text-dim);
  line-height: 1.4;
}

/* ──────────── Spread card meta (right column) ──────────── */
.spread-card-meta {
  text-align: right;
  flex-shrink: 0;
  margin-left: var(--space-md);
}

.spread-card-count {
  display: block;
  font-size: var(--fs-body-small);
  color: var(--text-dim);
  margin-bottom: var(--space-xs);
}

/* Badges */
.badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-round);
  font-size: var(--fs-caption);
  font-weight: 600;
}

.badge-gold {
  background: rgba(244,212,140,0.18);
  color: var(--gold-light);
  border: 1rpx solid rgba(244,212,140,0.3);
}

/* Popular badge — subtle gold pill */
.badge-popular {
  display: inline-block;
  padding: 2rpx 14rpx;
  border-radius: var(--radius-round);
  font-size: 20rpx;
  font-weight: 500;
  background: rgba(244, 212, 140, 0.12);
  color: var(--gold);
  border: 1rpx solid rgba(244, 212, 140, 0.20);
  line-height: 1.4;
}

.badge-danger {
  background: rgba(255,107,107,0.15);
  color: var(--danger);
  border: 1rpx solid rgba(255,107,107,0.25);
}

/* ==============================
   Selected spread info
   ============================== */
.selected-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: var(--space-xl) 0;
}

/* ==============================
   Question box
   ============================== */
.question-box {
  background: var(--bg-card);
  border: 1.5rpx solid var(--gold-dim);
  border-radius: var(--radius-card);
  padding: var(--space-lg);
  margin: var(--space-lg) 0;
}

.question-input {
  width: 100%;
  min-height: 140rpx;
  padding: var(--space-md);
  background: var(--bg-deep);
  border: 1rpx solid rgba(244,212,140,0.08);
  border-radius: var(--radius-sm);
  color: var(--text-primary);
  font-size: var(--fs-body);
  line-height: 1.5;
  box-sizing: border-box;
  outline: none;
}

.question-input:focus {
  border-color: var(--gold);
  box-shadow: 0 0 16rpx var(--gold-dim);
}

.question-input::placeholder {
  color: rgba(244, 212, 140, 0.45);
  font-style: italic;
  font-weight: 300;
}

/* ==============================
   Theme selection
   ============================== */
.theme-options {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-md);
}

.theme-item {
  flex: 1;
  min-width: 120rpx;
  text-align: center;
  padding: 16rpx 12rpx;
  background: var(--bg-card);
  border: 1.5rpx solid rgba(255,255,255,0.05);
  border-radius: var(--radius-sm);
  font-size: 26rpx;
  color: var(--text-secondary);
  transition: all 0.25s;
  cursor: pointer;
}

.theme-item:active {
  transform: scale(0.94);
}

.theme-active {
  background: linear-gradient(135deg, rgba(244,212,140,0.15), rgba(244,212,140,0.05));
  border-color: var(--gold);
  color: var(--text-gold);
  box-shadow: 0 0 20rpx var(--gold-dim);
}

/* ==============================
   Draw button — glowing pulse
   ============================== */
.btn-glow-pulse {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  padding: 28rpx 0;
  border: none;
  border-radius: var(--radius-round);
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-inverse);
  background: linear-gradient(135deg, var(--gold-light), var(--gold));
  box-shadow: 0 0 40rpx var(--gold-glow);
  transition: all 0.3s;
  cursor: pointer;
  position: relative;
  overflow: hidden;
}

.btn-glow-pulse::after {
  border: none;
}

.btn-glow-pulse:not(.drawing):active {
  transform: scale(0.96);
}

.btn-glow-pulse.drawing {
  opacity: 0.8;
  background: linear-gradient(135deg, #D4B06A, #C8A050);
  animation: pulseGlow 1.6s ease-in-out infinite;
}

.btn-glow-pulse[disabled] {
  opacity: 0.5;
}

@keyframes pulseGlow {
  0%, 100% { box-shadow: 0 0 30rpx var(--gold-glow); }
  50% { box-shadow: 0 0 60rpx var(--gold-glow); }
}

/* ==============================
   Text link
   ============================== */
.btn-text {
  font-size: var(--fs-body);
  color: var(--text-dim);
  cursor: pointer;
  transition: color 0.2s;
}

.btn-text:active {
  color: var(--gold);
}

/* ==============================
   Scrollbar hidden
   ============================== */
::-webkit-scrollbar {
  width: 0;
  height: 0;
}
