  transform: translateY(-10rpx);
  transition: opacity 0.3s ease, transform 0.3s ease;
  pointer-events: none;
}

.onboarding-bubble-wrap.bubble-visible {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.onboarding-bubble {
  position: relative;
  padding: 24rpx 32rpx;
  background: rgba(26, 26, 62, 0.95);
  border: 1.5rpx solid var(--color-gold, #F4D48C);
  border-radius: 16rpx;
