/* ========================================================
   占卜页 · Editorial Minimal
   纯白卡片 · 左侧重音线 · 疏朗排版
   ======================================================== */

/* -------- 牌阵网格 -------- */
.spread-grid {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  padding: var(--space-md) 0;
}

/* -------- 单张牌阵卡片：纯白+左侧重音线 -------- */
.spread-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 12rpx;
  padding: var(--space-xxl) var(--space-xxl);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
  box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  border-left: none;
}

/* —— 左侧重音线 —— */
.spread-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 12%;
  bottom: 12%;
  width: 6rpx;
  background: #b89a7a;
  border-radius: 3rpx;
}

.spread-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.06);
}

/* -------- Premium 标记 -------- */
.badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 4rpx;
  font-size: 20rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.badge-gold {
  color: #b89a7a;
  background: rgba(184, 154, 122, 0.08);
}

.badge-danger {
  color: #c0392b;
  background: rgba(192, 57, 43, 0.06);
}

/* ========================================================
   问题输入区
   ======================================================== */
.selected-info {
  text-align: center;
  padding: var(--space-lg) 0 var(--space-lg);
}

.question-box {
  background: #ffffff;
  border-radius: 12rpx;
  padding: var(--space-xl);
  margin-bottom: var(--space-lg);
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  transition: border-color 0.3s ease, box-shadow 0.3s ease;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.02);
}

.question-box:focus-within {
  border-color: rgba(0, 0, 0, 0.15);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.question-input {
  width: 100%;
  min-height: 140rpx;
  font-size: var(--fs-body);
  color: #2c2c2c;
  line-height: var(--lh-loose);
  background: transparent;
  caret-color: #b89a7a;
}

.question-input::placeholder {
  color: rgba(0, 0, 0, 0.20);
  font-style: italic;
}

/* ========================================================
   主题选择
   ======================================================== */
.theme-options {
  display: flex;
  gap: var(--space-md);
  margin-top: var(--space-sm);
}

.theme-item {
  flex: 1;
  text-align: center;
  background: #ffffff;
  border-radius: 8rpx;
  padding: var(--space-md) 0;
  font-size: var(--fs-body-small);
  color: rgba(0, 0, 0, 0.35);
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  transition: all 0.25s ease;
}

.theme-item:active {
  transform: scale(0.96);
}

.theme-active {
  border-color: #b89a7a;
  color: #b89a7a;
  background: rgba(184, 154, 122, 0.04);
}

/* ========================================================
   启动按钮 · 干净利落
   ======================================================== */
.btn-glow-pulse {
  position: relative;
  overflow: hidden;
  font-size: var(--fs-body);
  font-weight: 500;
  letter-spacing: 2rpx;
  padding: var(--space-lg) 0;
  border-radius: 8rpx;
  background: #2c2c2c;
  border: none;
  color: #ffffff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: all 0.25s ease;
}

.btn-glow-pulse:active {
  transform: scale(0.97);
  box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.06);
}

.btn-glow-pulse.drawing {
  opacity: 0.7;
}

.btn-glow-pulse[disabled] {
  opacity: 0.35;
}

/* ========================================================
   加载骨架屏
   ======================================================== */
.skeleton {
  padding: var(--space-xxl) 0;
}

.skeleton-title {
  width: 280rpx;
  height: 36rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, rgba(0, 0, 0, 0.06), rgba(0, 0, 0, 0.02));
  margin: 0 auto var(--space-sm);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-subtitle {
  width: 200rpx;
  height: 26rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, rgba(0, 0, 0, 0.06), rgba(0, 0, 0, 0.02));
  margin: 0 auto var(--space-xxxl);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-spread {
  width: 100%;
  height: 130rpx;
  border-radius: 10rpx;
  background: linear-gradient(90deg, rgba(0, 0, 0, 0.04), rgba(0, 0, 0, 0.015));
  margin-bottom: var(--space-md);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

/* ========================================================
   错误状态
   ======================================================== */
.error-state {
  text-align: center;
  padding: var(--space-massive) var(--space-xl);
}

.error-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: var(--space-md);
  opacity: 0.25;
}

.error-text {
  font-size: var(--fs-body);
  color: rgba(0, 0, 0, 0.45);
  display: block;
  margin-bottom: var(--space-xs);
}

.error-hint {
  font-size: var(--fs-body-small);
  color: rgba(0, 0, 0, 0.25);
  display: block;
  margin-bottom: var(--space-xxl);
}
