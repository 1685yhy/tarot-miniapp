/* ===== 占卜页 - 柔和玫瑰选牌 ===== */

/* -------- 全局装饰 ---------- */
@keyframes pulse-soft {
  0%, 100% { transform: scale(1); box-shadow: 0 4rpx 16rpx rgba(200, 130, 140, 0.15); }
  50%      { transform: scale(1.015); box-shadow: 0 6rpx 24rpx rgba(200, 130, 140, 0.25); }
}

/* -------- 牌阵选择卡片 -------- */
.spread-grid {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  padding: var(--space-md) 0;
}

.spread-card {
  display: flex;
  align-items: center;
  background: #fff9f7;
  border-radius: 20rpx;
  padding: var(--space-xl) var(--space-xxl);
  transition: all 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  position: relative;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(180, 120, 130, 0.08);
  border: 1rpx solid rgba(200, 150, 160, 0.08);
}

.spread-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 12rpx rgba(180, 120, 130, 0.12);
  border-color: rgba(200, 150, 160, 0.15);
}

/* Premium variant */
.spread-card.premium {
  background: #fff9f7;
  box-shadow: 0 4rpx 20rpx rgba(200, 130, 140, 0.12);
  border-color: rgba(210, 160, 170, 0.18);
}

/* Premium badge */
.premium-badge {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx 16rpx 4rpx 12rpx;
  border-radius: 30rpx;
  font-size: 18rpx;
  font-weight: 500;
  color: #b8865a;
  background: linear-gradient(135deg, rgba(210, 140, 155, 0.15), rgba(210, 140, 155, 0.05));
  border: 1rpx solid rgba(210, 140, 155, 0.2);
  letter-spacing: 2rpx;
}

/* Popular badge */
.popular-badge {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx 16rpx;
  border-radius: 30rpx;
  font-size: 18rpx;
  font-weight: 500;
  color: #6b8e6b;
  background: linear-gradient(135deg, rgba(130, 170, 130, 0.12), rgba(130, 170, 130, 0.04));
  border: 1rpx solid rgba(130, 170, 130, 0.2);
  letter-spacing: 2rpx;
}

/* -------- 问题输入 -------- */
.selected-info {
  text-align: center;
  padding: var(--space-lg) 0 var(--space-lg);
}

.question-box {
  background: #ffffff;
  border-radius: 18rpx;
  padding: var(--space-xl);
  margin-bottom: var(--space-lg);
  border: 1rpx solid rgba(200, 160, 170, 0.18);
  transition: border-color 0.4s ease, box-shadow 0.4s ease;
  box-shadow: 0 2rpx 12rpx rgba(180, 120, 130, 0.05);
}

.question-box:focus-within {
  border-color: rgba(200, 140, 155, 0.35);
  box-shadow: 0 4rpx 20rpx rgba(200, 130, 140, 0.08);
}

.question-input {
  width: 100%;
  min-height: 140rpx;
  font-size: var(--fs-body);
  color: #4a3a3a;
  line-height: var(--lh-loose);
  background: transparent;
  caret-color: #c8889a;
  letter-spacing: 1rpx;
}

.question-input::placeholder {
  color: rgba(160, 130, 135, 0.4);
  font-style: italic;
}

.selected-spread-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: var(--space-sm) 0;
  font-size: var(--fs-body-small);
  color: rgba(180, 130, 140, 0.6);
  letter-spacing: 2rpx;
}

/* -------- 主题选择 -------- */
.theme-options {
  display: flex;
  gap: var(--space-md);
  margin-top: var(--space-sm);
}

.theme-item {
  flex: 1;
  text-align: center;
  background: #fffaf8;
  border-radius: 16rpx;
  padding: var(--space-md) 0;
  font-size: var(--fs-body-small);
  color: rgba(160, 130, 135, 0.55);
  border: 1rpx solid rgba(200, 160, 170, 0.1);
  transition: all 0.35s ease;
  letter-spacing: 1rpx;
}

.theme-item:active {
  transform: scale(0.95);
}

.theme-active {
  border-color: rgba(200, 140, 155, 0.3);
  color: #c8889a;
  background: linear-gradient(180deg, rgba(210, 140, 155, 0.06), rgba(210, 140, 155, 0.02));
  box-shadow: 0 2rpx 12rpx rgba(200, 130, 140, 0.06);
}

/* -------- 启动按钮 · 柔和玫瑰脉冲 -------- */
.btn-glow-pulse {
  position: relative;
  overflow: hidden;
  letter-spacing: 3rpx;
  font-size: var(--fs-body);
  font-weight: 500;
  padding: var(--space-lg) 0;
  border-radius: 46rpx;
  background: linear-gradient(135deg, #d496a6, #c47e92);
  border: none;
  color: #ffffff;
  animation: pulse-soft 3s ease-in-out infinite;
  box-shadow: 0 6rpx 24rpx rgba(196, 126, 146, 0.25);
}

.btn-glow-pulse:active {
  transform: scale(0.96);
  animation: none;
  box-shadow: 0 3rpx 12rpx rgba(196, 126, 146, 0.2);
}

.btn-glow-pulse.drawing {
  opacity: 0.75;
  animation: pulse-soft 1.2s ease-in-out infinite;
}

.btn-glow-pulse[disabled] {
  opacity: 0.4;
  animation: none;
  filter: grayscale(0.5);
}

/* -------- 加载骨架屏 -------- */
.skeleton {
  padding: var(--space-xxl) 0;
}

.skeleton-title {
  width: 280rpx;
  height: 36rpx;
  border-radius: 10rpx;
  background: linear-gradient(90deg, rgba(200, 160, 170, 0.2), rgba(210, 180, 185, 0.1));
  margin: 0 auto var(--space-sm);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-subtitle {
  width: 200rpx;
  height: 26rpx;
  border-radius: 10rpx;
  background: linear-gradient(90deg, rgba(200, 160, 170, 0.2), rgba(210, 180, 185, 0.1));
  margin: 0 auto var(--space-xxxl);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-spread {
  width: 100%;
  height: 130rpx;
  border-radius: 18rpx;
  background: linear-gradient(90deg, rgba(200, 160, 170, 0.15), rgba(210, 180, 185, 0.08));
  margin-bottom: var(--space-md);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

/* -------- 错误状态 -------- */
.error-state {
  text-align: center;
  padding: var(--space-massive) var(--space-xl);
}

.error-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: var(--space-md);
  opacity: 0.35;
}

.error-text {
  font-size: var(--fs-body);
  color: rgba(120, 90, 95, 0.55);
  display: block;
  margin-bottom: var(--space-xs);
}

.error-hint {
  font-size: var(--fs-body-small);
  color: rgba(120, 90, 95, 0.35);
  display: block;
  margin-bottom: var(--space-xxl);
}
