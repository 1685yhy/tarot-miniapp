/* ============================================================
   Reading (Spread Selection) — Warm Paper Design System
   Warm ivory base, deep rose accent, sage subtle
   Spread cards, question input, theme selection
   ============================================================ */

/* -----------------------------------------------------------
   1. PAGE LAYOUT
   ----------------------------------------------------------- */

.page {
  padding: var(--page-padding);
  padding-bottom: calc(var(--page-padding) + var(--safe-area-bottom));
  min-height: 100vh;
  position: relative;
  z-index: var(--z-base);
}

/* -----------------------------------------------------------
   2. TYPOGRAPHY HELPERS
   ----------------------------------------------------------- */

.heading-2 {
  font-size: var(--font-size-subhead);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  line-height: var(--line-height-heading);
}

.heading-4 {
  font-size: var(--font-size-body-large);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  line-height: var(--line-height-heading);
}

.text-center { text-align: center; }
.text-secondary { color: var(--color-text-secondary); }

.mt-xs { margin-top: var(--spacing-3); }
.mt-sm { margin-top: var(--spacing-4); }
.mb-xxl { margin-bottom: var(--spacing-7); }
.mb-xxxl { margin-bottom: var(--spacing-8); }

/* -----------------------------------------------------------
   3. ENTRANCE ANIMATIONS
   ----------------------------------------------------------- */

.anim-fade-in-up-1 { opacity: 0; animation: fade-up var(--duration-emphasis) ease 0s forwards; }
.anim-fade-in-up-2 { opacity: 0; animation: fade-up var(--duration-emphasis) ease 0.12s forwards; }
.anim-fade-in-up-3 { opacity: 0; animation: fade-up var(--duration-emphasis) ease 0.24s forwards; }
.anim-fade-in-up-4 { opacity: 0; animation: fade-up var(--duration-emphasis) ease 0.36s forwards; }

/* -----------------------------------------------------------
   4. SPREAD GRID
   ----------------------------------------------------------- */

.section-title-center {
  text-align: center;
  margin-bottom: var(--spacing-4);
  font-size: var(--font-size-body-large);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.spread-grid {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-4);
  margin-top: var(--spacing-5);
}

.spread-card {
  display: flex;
  align-items: center;
  padding: var(--spacing-5);
  background: var(--color-surface);
  border: 1rpx solid rgba(139, 126, 110, 0.12);
  border-radius: var(--radius-medium);
  box-shadow: var(--shadow-subtle);
  transition: all var(--duration-navigation) ease;
  position: relative;
  overflow: hidden;
}

.spread-card:active {
  border-color: rgba(176, 102, 80, 0.20);
  box-shadow: var(--shadow-medium);
  transform: translateY(-2rpx);
}

.spread-card--premium {
  border-color: rgba(176, 102, 80, 0.15);
}

.spread-card--premium .spread-card__label {
  color: var(--color-accent);
}

.spread-card__content {
  flex: 1;
  min-width: 0;
}

.spread-card__label {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  display: block;
  line-height: var(--line-height-heading);
  margin-bottom: 4rpx;
}

.spread-card__desc {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  display: block;
  line-height: var(--line-height-body);
}

.spread-card__count {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  opacity: 0.70;
  flex-shrink: 0;
  margin-left: var(--spacing-4);
}

/* -----------------------------------------------------------
   5. BADGES
   ----------------------------------------------------------- */

.badge {
  display: inline-block;
  padding: 4rpx var(--spacing-4);
  border-radius: var(--radius-pill);
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-medium);
}

.badge--accent {
  background: rgba(176, 102, 80, 0.08);
  color: var(--color-accent);
  border: 1rpx solid rgba(176, 102, 80, 0.15);
}

/* -----------------------------------------------------------
   6. SELECTED SPREAD INFO
   ----------------------------------------------------------- */

.selected-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: var(--spacing-6) 0;
}

/* -----------------------------------------------------------
   7. QUESTION BOX
   ----------------------------------------------------------- */

.question-box {
  background: var(--color-surface);
  border: 1rpx solid rgba(139, 126, 110, 0.12);
  border-radius: var(--radius-medium);
  padding: var(--spacing-5);
  margin: var(--spacing-5) 0;
  box-shadow: var(--shadow-subtle);
}

.question-input {
  width: 100%;
  min-height: 140rpx;
  padding: var(--spacing-4);
  background: var(--color-bg);
  border: 1rpx solid rgba(139, 126, 110, 0.15);
  border-radius: var(--radius-small);
  color: var(--color-text-primary);
  font-size: var(--font-size-body);
  line-height: var(--line-height-body);
  box-sizing: border-box;
  outline: none;
}

.question-input:focus {
  border-color: var(--color-accent);
  box-shadow: 0 0 0 2rpx rgba(176, 102, 80, 0.10);
}

.question-input::placeholder {
  color: var(--color-text-secondary);
  opacity: 0.50;
}

/* -----------------------------------------------------------
   8. THEME SELECTION
   ----------------------------------------------------------- */

.theme-options {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-4);
}

.theme-item {
  flex: 1;
  min-width: 120rpx;
  text-align: center;
  padding: var(--spacing-4) var(--spacing-3);
  background: var(--color-surface);
  border: 1rpx solid rgba(139, 126, 110, 0.12);
  border-radius: var(--radius-small);
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  transition: all var(--duration-feedback) ease;
}

.theme-item:active {
  border-color: var(--color-accent);
  color: var(--color-accent);
}

.theme-active {
  background: rgba(176, 102, 80, 0.06);
  border-color: var(--color-accent);
  color: var(--color-accent);
}

/* -----------------------------------------------------------
   9. BUTTONS
   ----------------------------------------------------------- */

.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  padding: var(--spacing-5) 0;
  border: none;
  border-radius: var(--radius-pill);
  font-size: var(--font-size-body-large);
  font-weight: var(--font-weight-semibold);
  color: var(--color-surface);
  background: var(--color-accent);
  box-shadow: var(--shadow-subtle);
  transition: all var(--duration-feedback) ease;
}

.btn-primary:active {
  transform: scale(0.97);
  opacity: 0.90;
}

.btn-primary[disabled] {
  opacity: 0.30;
  box-shadow: none;
  pointer-events: none;
}

.btn-small {
  padding: var(--spacing-4) var(--spacing-6);
  font-size: var(--font-size-body);
}

.btn-text {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  transition: color var(--duration-feedback) ease;
}

.btn-text:active {
  color: var(--color-accent);
}

/* -----------------------------------------------------------
   10. ERROR STATE
   ----------------------------------------------------------- */

.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-8) var(--spacing-6);
  text-align: center;
  position: relative;
  z-index: var(--z-base);
}

.error-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: var(--spacing-5);
  display: block;
  opacity: 0.30;
}

.error-text {
  font-size: var(--font-size-body-large);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-3);
}

.error-hint {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  margin-bottom: var(--spacing-6);
  word-break: break-all;
}

/* -----------------------------------------------------------
   11. SKELETON LOADING
   ----------------------------------------------------------- */

.skeleton {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-5);
  padding: var(--spacing-6) 0;
}

.skeleton-title {
  width: 50%;
  height: 36rpx;
  border-radius: var(--radius-pill);
  background: rgba(139, 126, 110, 0.08);
  animation: pulse-soft 1500ms ease-in-out infinite;
}

.skeleton-subtitle {
  width: 35%;
  height: 28rpx;
  border-radius: var(--radius-pill);
  background: rgba(139, 126, 110, 0.08);
  animation: pulse-soft 1500ms ease-in-out infinite;
  margin-bottom: var(--spacing-5);
}

.skeleton-spread {
  height: 100rpx;
  border-radius: var(--radius-medium);
  background: rgba(139, 126, 110, 0.08);
  animation: pulse-soft 1500ms ease-in-out infinite;
}

/* -----------------------------------------------------------
   12. SCROLLBAR
   ----------------------------------------------------------- */

::-webkit-scrollbar {
  width: 0;
  height: 0;
}
