<!-- pages/reading/reading.wxml -->
<!-- 星尘粒子背景 -->
<view class="star-field">
  <view class="star-particle"></view>
  <view class="star-particle"></view>
  <view class="star-particle"></view>
  <view class="star-particle"></view>
  <view class="star-particle"></view>
  <view class="star-particle"></view>
  <view class="star-particle"></view>
  <view class="star-particle"></view>
  <view class="star-particle"></view>
  <view class="star-particle"></view>
  <view class="star-particle"></view>
  <view class="star-particle"></view>
  <view class="star-particle"></view>
  <view class="star-particle"></view>
  <view class="star-particle"></view>
</view>

<!-- 光晕装饰 -->
<view class="orb-top"></view>
<view class="orb-bottom"></view>

<view class="page">
  <!-- ===== 加载骨架 ===== -->
  <view wx:if="{{pageLoading}}">
    <view class="reading-skeleton-wrap">
      <view class="skeleton skeleton-reading-title"></view>
      <view class="skeleton skeleton-reading-subtitle"></view>
      <view class="skeleton skeleton-reading-spread"></view>
      <view class="skeleton skeleton-reading-spread"></view>
      <view class="skeleton skeleton-reading-spread"></view>
      <view class="skeleton skeleton-reading-spread"></view>
      <view class="skeleton skeleton-reading-spread"></view>
    </view>
  </view>

  <!-- ===== 错误状态 ===== -->
  <view wx:elif="{{pageError}}" class="error-state">
    <text class="error-text">占卜台暂时无法连接</text>
    <text class="error-hint">{{pageError}}</text>
    <button class="btn-primary btn-small" bindtap="onRetry">重新连接</button>
  </view>

  <!-- ===== 主内容 ===== -->
  <view wx:else>
    <!-- ========== Spread selection ========== -->
    <view wx:if="{{ritualStage === null && !showQuestionInput}}">
      <text class="heading-2 section-title-center anim-fade-in-up-1">选择牌阵</text>
      <text class="text-secondary text-center mb-xxl anim-fade-in-up-1">不同问题，用不同牌阵</text>

      <!-- 免费次数提示 -->
      <view class="reading-free-banner anim-fade-in-up-1">
        <text class="reading-free-text" wx:if="{{!isMember && freeReadingsUsed < freeReadingsTotal}}">
          ✦ 今日剩余解读: {{freeReadingsTotal - freeReadingsUsed}} 次
        </text>
        <text class="reading-free-text reading-free-text--exhausted" wx:elif="{{!isMember && freeReadingsUsed >= freeReadingsTotal}}">
          今日免费 {{freeReadingsTotal}}/{{freeReadingsTotal}} 次已用完 · 明天00:00恢复
        </text>
      </view>

      <view class="spread-grid anim-fade-in-up-2">
        <view
          class="spread-card {{item.premium ? 'premium' : ''}}"
          wx:for="{{spreads}}"
          wx:key="key"
          data-spread="{{item}}"
          bindtap="onSelectSpread"
        >
          <image class="spread-card-icon" src="/images/icons/theme_general_64.png" mode="aspectFit" />
          <view class="spread-card-info">
            <view class="spread-card-title-row">
              <text class="heading-4">{{item.name}}</text>
              <text class="badge badge-popular" wx:if="{{item.popular}}">热门</text>
            </view>
            <text class="spread-card-desc">{{item.desc}}</text>
          </view>
          <view class="spread-card-meta">
            <text class="spread-card-count">{{item.cards}}张</text>
          </view>
          <!-- Premium overlay: more prominent than a badge -->
          <view class="premium-overlay" wx:if="{{item.premium}}">
            <view class="premium-overlay-bg"></view>
            <view class="premium-overlay-content">
              <text class="premium-overlay-icon">✦</text>
              <text class="premium-overlay-text">会员专属</text>
              <text class="premium-overlay-sub">开通即可使用</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- ========== RITUAL STAGE 0: 冥想呼吸 ========== -->
    <view wx:elif="{{ritualStage === 0}}" class="ritual-stage anim-fade-in-up-1" bindtap="onRitualTap">
      <view class="breathing-container">
        <view class="breathing-ring breathing-ring-outer"></view>
        <view class="breathing-ring breathing-ring-inner"></view>
        <view class="breathing-circle"></view>
        <text class="breathing-text">闭上眼睛，深呼吸</text>
      </view>
      <text class="ritual-subtitle">默念你想问的问题</text>
    </view>

    <!-- ========== RITUAL STAGE 1: 洗牌 ========== -->
    <view wx:elif="{{ritualStage === 1}}" class="ritual-stage anim-fade-in-up-1" bindtap="onRitualTap">
      <text class="ritual-heading">牌灵正在聆听...</text>
      <view class="shuffle-area">
        <view class="shuffle-card shuffle-card-1"></view>
        <view class="shuffle-card shuffle-card-2"></view>
        <view class="shuffle-card shuffle-card-3"></view>
        <view class="shuffle-card shuffle-card-4"></view>
        <view class="shuffle-card shuffle-card-5"></view>
      </view>
    </view>

    <!-- ========== 问题输入（默认跳过仪式，可选加入冥想） ========== -->
    <view wx:elif="{{showQuestionInput}}">
      <!-- 冥想仪式开关 -->
      <view class="ritual-toggle {{ritualEnabled ? 'active' : ''}}" bindtap="onToggleRitual">
        <text class="ritual-toggle-text">静心冥想后再提问</text>
        <text class="ritual-toggle-icon">✦</text>
      </view>

      <view class="selected-info anim-fade-in-up-1">
        <text class="selected-spread-icon">{{selectedSpread.icon}}</text>
        <text class="heading-2 mt-sm">{{selectedSpread.name}}</text>
        <text class="text-dim mt-xs">{{selectedSpread.desc}}</text>
      </view>

      <view class="question-box anim-fade-in-up-2">
        <view class="question-box-accent"></view>
        <view class="question-prompt">
          <view class="prompt-stars">✦ ✦ ✦</view>
          <text class="prompt-text">把你的问题告诉星光</text>
          <view class="prompt-stars">✦ ✦ ✦</view>
        </view>
        <textarea
          class="question-input"
          placeholder="把你想问的写在这里..."
          maxlength="500"
          value="{{question}}"
          bindinput="onQuestionInput"
        />
        <view class="question-footer">
          <text class="hint-text">星光会倾听每一个字 ✦</text>
          <text class="char-counter {{question.length >= 450 ? 'counter-warning' : ''}}">{{question.length}}/500</text>
        </view>
      </view>

      <!-- 主题选择：仅通用牌阵显示；专属牌阵已隐含主题，不展示选择器 -->
      <view class="mb-xxxl anim-fade-in-up-3" wx:if="{{!spreadDefaultTheme}}">
        <text class="theme-section-label">解读侧重</text>
        <view class="theme-options">
          <view wx:for="{{displayThemes}}" wx:key="key"
            class="theme-item {{theme === item.key ? 'theme-active' : ''}}"
            bindtap="onThemeTap" data-theme="{{item.key}}">
            <image class="theme-icon" src="{{item.icon}}" mode="aspectFit" />
            <text class="theme-label">{{item.label}}</text>
          </view>
        </view>
      </view>

      <!-- 专属牌阵提示：不展示主题选择，仅告知用户此牌阵的解读方向 -->
      <view class="theme-lock-banner" wx:if="{{spreadDefaultTheme}}">
        <text class="theme-lock-icon">✦</text>
        <text class="theme-lock-text">此牌阵侧重<text class="theme-lock-keyword">{{THEME_LABELS[spreadDefaultTheme]}}</text>解读</text>
      </view>

      <!-- Draw button -->
      <button class="btn-glow-pulse {{isDrawing ? 'drawing' : ''}} anim-fade-in-up-4" bindtap="onStartReading" disabled="{{isDrawing}}">
        <text wx:if="{{!isDrawing}}">翻开牌阵</text>
        <text wx:else>牌灵正在回应...</text>
      </button>

      <text class="btn-text btn-back-spreads" bindtap="onBackToSpreads">← 重新选择牌阵</text>
    </view>
  </view>
</view>

