<!-- pages/reading/reading.wxml -->
<!-- 星尘粒子背景 -->
<view class="star-field">
  <view class="star-particle"></view>
  <view class="star-particle"></view>
  <view class="star-particle"></view>
  <view class="star-particle"></view>
  <view class="star-particle"></view>
  <view class="star-particle"></view>
  <view class="star-particle"></view>
  <view class="star-particle"></view>
  <view class="star-particle"></view>
  <view class="star-particle"></view>
  <view class="star-particle"></view>
  <view class="star-particle"></view>
  <view class="star-particle"></view>
  <view class="star-particle"></view>
  <view class="star-particle"></view>
</view>

<!-- 光晕装饰 -->
<view class="orb-top"></view>
<view class="orb-bottom"></view>

<view class="page">
  <!-- ===== 加载骨架 ===== -->
  <view wx:if="{{pageLoading}}">
    <view class="reading-skeleton-wrap">
      <view class="skeleton skeleton-reading-title"></view>
      <view class="skeleton skeleton-reading-subtitle"></view>
      <view class="skeleton skeleton-reading-spread"></view>
      <view class="skeleton skeleton-reading-spread"></view>
      <view class="skeleton skeleton-reading-spread"></view>
      <view class="skeleton skeleton-reading-spread"></view>
      <view class="skeleton skeleton-reading-spread"></view>
    </view>
  </view>

  <!-- ===== 错误状态 ===== -->
  <view wx:elif="{{pageError}}" class="error-state">
    <text class="error-text">占卜台暂时无法连接</text>
    <text class="error-hint">{{pageError}}</text>
    <button class="btn-primary btn-small" bindtap="onRetry">重新连接</button>
  </view>

  <!-- ===== 主内容 ===== -->
  <view wx:else>
    <!-- ========== Spread selection ========== -->
    <view wx:if="{{ritualStage === null && !showQuestionInput}}">
      <text class="heading-2 section-title-center anim-fade-up anim-stagger-1">选择牌阵</text>
      <text class="text-secondary text-center mb-xxl anim-fade-up anim-stagger-1">不同问题，用不同牌阵</text>

      <!-- 免费次数提示（进度条 + 耗尽时购买入口） -->
      <view class="free-quota-bar anim-fade-up anim-stagger-1" wx:if="{{!isMember}}">
        <view class="quota-progress-wrap">
          <view class="quota-progress" style="width: {{(freeReadingsTotal - freeReadingsUsed) / freeReadingsTotal * 100}}%"></view>
        </view>
        <text class="quota-text" wx:if="{{freeReadingsUsed < freeReadingsTotal}}">今日免费解读 {{freeReadingsUsed}}/{{freeReadingsTotal}} · 明日0点重置</text>
        <view wx:else>
          <text class="quota-text quota-text--exhausted">免费次数已用完 ✦ 购买补充包继续解读</text>
          <view class="exhausted-packs">
            <button class="exhausted-pack-btn" bindtap="onPurchasePackQuick" data-product="{{packQuick3}}">¥9.90 / 3次</button>
            <button class="exhausted-pack-btn exhausted-pack-btn--best" bindtap="onPurchasePackQuick" data-product="{{packQuick10}}">¥29.90 / 10次</button>
          </view>
        </view>
      </view>

      <!-- ===== 免费次数耗尽 → 会员引导浮层 ===== -->
      <view wx:if="{{showExhaustedOverlay}}" class="exhausted-overlay" catchtouchmove="preventTouchMove">
        <view class="exhausted-card">
          <view class="exhausted-stars">
            <view class="exhausted-star exhausted-star-1">✦</view>
            <view class="exhausted-star exhausted-star-2">✦</view>
            <view class="exhausted-star exhausted-star-3">✦</view>
          </view>
          <text class="exhausted-icon">🌙</text>
          <text class="exhausted-title">今日星光已用完 ✦</text>
          <text class="exhausted-sub">明日 0 点重置免费次数</text>
          <view class="exhausted-divider"></view>
          <text class="exhausted-cta-text">或立即开通会员，无限解读</text>
          <button class="exhausted-cta-btn" bindtap="onGoMembership">开通会员 ✦</button>
          <text class="exhausted-dismiss" bindtap="onDismissExhausted">我知道了</text>
        </view>
      </view>

      <view class="spread-grid anim-fade-up anim-stagger-2">
        <view
          class="spread-card {{item.premium ? 'premium' : ''}}"
          wx:for="{{spreads}}"
          wx:key="key"
          data-spread="{{item}}"
          bindtap="onSelectSpread"
          role="button"
        >
          <image class="spread-card-icon" src="/images/icons/theme_general_64.png" mode="aspectFit" lazy-load aria-label="{{item.name}}" />
          <view class="spread-card-info">
            <view class="spread-card-title-row">
              <text class="heading-4">{{item.name}}</text>
              <text class="badge badge-popular" wx:if="{{item.popular}}">热门</text>
            </view>
            <text class="spread-card-desc">{{item.desc}}</text>
            <text class="spread-card-plainDesc">{{item.plainDesc}}</text>
          </view>
          <view class="spread-card-meta">
            <text class="spread-card-count">{{item.cards}}张</text>
          </view>
          <!-- Premium overlay: more prominent than a badge -->
          <view class="premium-overlay" wx:if="{{item.premium}}">
            <view class="premium-overlay-bg"></view>
            <view class="premium-overlay-content">
              <image class="premium-overlay-icon" src="/images/icons/lock_64.png" mode="aspectFit" lazy-load aria-label="会员专属" />
              <text class="premium-overlay-text">会员专属</text>
              <text class="premium-overlay-sub">开通即可使用</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- ========== RITUAL STAGE 0: 冥想呼吸 ========== -->
    <view wx:elif="{{ritualStage === 0}}" class="ritual-stage anim-fade-up anim-stagger-1" bindtap="onRitualTap" role="button">
      <view class="breathing-container">
        <view class="breathing-ring breathing-ring-outer"></view>
        <view class="breathing-ring breathing-ring-inner"></view>
        <view class="breathing-circle"></view>
        <text class="breathing-text">闭上眼睛，深呼吸</text>
      </view>
      <text class="ritual-subtitle">默念你想问的问题</text>
    </view>

    <!-- ========== RITUAL STAGE 1: 洗牌 ========== -->
    <view wx:elif="{{ritualStage === 1}}" class="ritual-stage anim-fade-up anim-stagger-1" bindtap="onRitualTap">
      <text class="ritual-heading">牌灵正在聆听...</text>
      <view class="shuffle-area">
        <view class="shuffle-card shuffle-card-1"></view>
        <view class="shuffle-card shuffle-card-2"></view>
        <view class="shuffle-card shuffle-card-3"></view>
        <view class="shuffle-card shuffle-card-4"></view>
        <view class="shuffle-card shuffle-card-5"></view>
      </view>
    </view>

    <!-- ========== 问题输入（默认跳过仪式，可选加入冥想） ========== -->
    <view wx:elif="{{showQuestionInput}}">
      <!-- 冥想仪式开关 -->
      <view class="ritual-toggle {{ritualEnabled ? 'active' : ''}}" bindtap="onToggleRitual" role="button">
        <text class="ritual-toggle-text">静心冥想后再提问</text>
        <text class="ritual-toggle-icon">✦</text>
      </view>

      <view class="selected-info anim-fade-up anim-stagger-1">
        <text class="selected-spread-icon">{{selectedSpread.icon}}</text>
        <text class="heading-2 mt-sm">{{selectedSpread.name}}</text>
        <text class="text-dim mt-xs">{{selectedSpread.desc}}</text>
      </view>

      <!-- ===== Step 2 引导气泡 ===== -->
      <view class="onboarding-bubble-wrap {{showOnboarding && onboardingStep === 2 ? 'bubble-visible' : ''}}">
        <view class="onboarding-bubble" bindtap="onNextOnboarding">
          <text class="bubble-text">把困扰你的事写在这里，星光会为你解读 ✦</text>
        </view>
      </view>

      <view class="question-box anim-fade-up anim-stagger-2">
        <view class="question-box-accent"></view>
        <view class="question-prompt">
          <view class="prompt-stars">✦ ✦ ✦</view>
          <text class="prompt-text">把你的问题告诉星光</text>
          <view class="prompt-stars">✦ ✦ ✦</view>
        </view>
        <textarea
          class="question-input"
          placeholder="把你想问的写在这里..."
          maxlength="500"
          value="{{question}}"
          bindinput="onQuestionInput"
        />
        <view class="question-footer">
          <text class="hint-text">星光会倾听每一个字 ✦</text>
          <text class="char-counter {{question.length >= 450 ? 'counter-warning' : ''}}">{{question.length}}/500</text>
        </view>
      </view>

      <!-- 主题选择：仅通用牌阵显示；专属牌阵已隐含主题，不展示选择器 -->
      <view class="mb-xxxl anim-fade-up anim-stagger-3" wx:if="{{!spreadDefaultTheme}}">
        <text class="theme-section-label">解读侧重</text>
        <view class="theme-options">
          <view wx:for="{{displayThemes}}" wx:key="key"
            class="theme-item {{theme === item.key ? 'theme-active' : ''}}"
            bindtap="onThemeTap" data-theme="{{item.key}}">
            <image class="theme-icon" src="{{item.icon}}" mode="aspectFit" lazy-load aria-label="{{item.label}}" />
            <text class="theme-label">{{item.label}}</text>
          </view>
        </view>
      </view>

      <!-- 专属牌阵提示：不展示主题选择，仅告知用户此牌阵的解读方向 -->
      <view class="theme-lock-banner" wx:if="{{spreadDefaultTheme}}">
        <text class="theme-lock-icon">✦</text>
        <text class="theme-lock-text">此牌阵侧重<text class="theme-lock-keyword">{{themeDefaultLabel}}</text>解读</text>
      </view>

      <!-- ========== Persona selection ========== -->
      <view class="persona-section anim-fade-up anim-stagger-4">
        <text class="persona-section-label">选择解读师</text>
        <view class="persona-options">
          <view wx:for="{{personas}}" wx:key="key"
            class="persona-card {{selectedPersona === item.key ? 'persona-active' : ''}}"
            bindtap="onPersonaTap" data-persona="{{item.key}}">
            <text class="persona-icon">{{item.icon}}</text>
            <view class="persona-text-wrap">
              <text class="persona-name">{{item.name}}</text>
              <text class="persona-label">{{item.label}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- Draw button -->
      <button class="btn-primary btn--full {{isDrawing ? 'btn-drawing' : ''}}" bindtap="onStartReading" disabled="{{isDrawing}}">
        <text wx:if="{{!isDrawing}}">翻开牌阵</text>
        <text wx:else>牌灵正在回应...</text>
      </button>

      <!-- AI 解读时间提示 -->
      <text class="reading-time-note" wx:if="{{!isDrawing}}">AI解读大约需要 10-20 秒</text>

      <!-- Mode selector cards -->
      <view class="mode-selector">
        <view class="mode-card {{quickMode ? 'mode-active' : ''}}" bindtap="onSelectMode" data-mode="quick" role="button" aria-label="快速抽牌模式">
          <text class="mode-card-icon">⚡</text>
          <view class="mode-card-text-wrap">
            <text class="mode-card-name">快速</text>
            <text class="mode-card-desc">跳过仪式 · 10秒出结果</text>
          </view>
        </view>
        <view class="mode-card {{!quickMode ? 'mode-active' : ''}}" bindtap="onSelectMode" data-mode="immersive" role="button" aria-label="沉浸解读模式">
          <text class="mode-card-icon">✨</text>
          <view class="mode-card-text-wrap">
            <text class="mode-card-name">沉浸</text>
            <text class="mode-card-desc">洗牌翻牌 · 完整仪式感</text>
          </view>
        </view>
      </view>

      <text class="btn-text btn-back-spreads" bindtap="onBackToSpreads">← 重新选择牌阵</text>
    </view>
  </view>
</view>

