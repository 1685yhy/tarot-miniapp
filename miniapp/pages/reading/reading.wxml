<!-- pages/reading/reading.wxml -->
<!-- 星尘粒子背景 -->
<view class="star-field">
  <view class="star-particle"></view>
  <view class="star-particle"></view>
  <view class="star-particle"></view>
  <view class="star-particle"></view>
  <view class="star-particle"></view>
  <view class="star-particle"></view>
  <view class="star-particle"></view>
  <view class="star-particle"></view>
  <view class="star-particle"></view>
  <view class="star-particle"></view>
  <view class="star-particle"></view>
  <view class="star-particle"></view>
  <view class="star-particle"></view>
  <view class="star-particle"></view>
  <view class="star-particle"></view>
</view>

<!-- 光晕装饰 -->
<view class="orb-top"></view>
<view class="orb-bottom"></view>

<view class="page">
  <!-- ===== 加载骨架 ===== -->
  <view wx:if="{{pageLoading}}">
    <view class="skeleton">
      <view class="skeleton-title"></view>
      <view class="skeleton-subtitle"></view>
      <view class="skeleton-spread"></view>
      <view class="skeleton-spread"></view>
      <view class="skeleton-spread"></view>
      <view class="skeleton-spread"></view>
      <view class="skeleton-spread"></view>
    </view>
  </view>

  <!-- ===== 错误状态 ===== -->
  <view wx:elif="{{pageError}}" class="error-state">
    <text class="error-icon">🔮</text>
    <text class="error-text">占卜台暂时无法连接</text>
    <text class="error-hint">{{pageError}}</text>
    <button class="btn-primary btn-small" bindtap="onRetry">✨ 重新连接</button>
  </view>

  <!-- ===== 主内容 ===== -->
  <view wx:else>
    <!-- Spread selection -->
    <view wx:if="{{!showQuestionInput}}">
      <text class="heading-2 section-title-center anim-fade-in-up-1">选择牌阵</text>
      <text class="text-secondary text-center mb-xxl anim-fade-in-up-1">不同问题，用不同牌阵</text>

      <view class="spread-grid anim-fade-in-up-2">
        <view
          class="spread-card {{item.premium ? 'premium' : ''}}"
          wx:for="{{spreads}}"
          wx:key="key"
          data-spread="{{item}}"
          bindtap="onSelectSpread"
        >
          <text style="font-size:44rpx;margin-right:var(--space-lg)">{{item.icon}}</text>
          <view style="flex:1">
            <text class="heading-4">{{item.name}}</text>
            <text class="text-dim mt-xs">{{item.desc}}</text>
          </view>
          <view style="text-align:right">
            <text class="text-dim" style="font-size:var(--fs-body-small);display:block">{{item.cards}}张牌</text>
            <text class="badge badge-gold mt-xs" wx:if="{{item.premium}}">会员</text>
            <text class="badge badge-danger mt-xs" wx:if="{{item.popular}}">热门</text>
          </view>
        </view>
      </view>
    </view>

    <!-- Question input -->
    <view wx:if="{{showQuestionInput}}">
      <view class="selected-info anim-fade-in-up-1">
        <text style="font-size:56rpx;display:block">{{selectedSpread.icon}}</text>
        <text class="heading-2 mt-sm">{{selectedSpread.name}}</text>
        <text class="text-dim mt-xs">{{selectedSpread.desc}}</text>
      </view>

      <view class="question-box anim-fade-in-up-2">
        <text class="text-secondary" style="display:block;margin-bottom:var(--space-sm)">你想问什么？（可选）</text>
        <textarea
          class="question-input"
          placeholder="例如：我最近的感情运势怎么样？这份工作要不要换？..."
          placeholder-style="color:#555577"
          maxlength="200"
          value="{{question}}"
          bindinput="onQuestionInput"
        />
        <text class="text-dim mt-xs" style="text-align:right;display:block;font-size:var(--fs-caption)">{{question.length}}/200</text>
      </view>

      <!-- Theme selection -->
      <view class="mb-xxxl anim-fade-in-up-3">
        <text class="text-secondary" style="display:block;margin-bottom:var(--space-sm)">解读侧重</text>
        <view class="theme-options">
          <view class="theme-item {{theme === 'general' ? 'theme-active' : ''}}" bindtap="onThemeTap" data-theme="general">
            <text>🔮 综合</text>
          </view>
          <view class="theme-item {{theme === 'love' ? 'theme-active' : ''}}" bindtap="onThemeTap" data-theme="love">
            <text>💕 爱情</text>
          </view>
          <view class="theme-item {{theme === 'career' ? 'theme-active' : ''}}" bindtap="onThemeTap" data-theme="career">
            <text>💼 事业</text>
          </view>
          <view class="theme-item {{theme === 'finance' ? 'theme-active' : ''}}" bindtap="onThemeTap" data-theme="finance">
            <text>💰 财运</text>
          </view>
        </view>
      </view>

      <!-- Draw button -->
      <button class="btn-glow-pulse {{isDrawing ? 'drawing' : ''}} anim-fade-in-up-4" bindtap="onStartReading" disabled="{{isDrawing}}">
        <text wx:if="{{!isDrawing}}">✨ 开始抽牌</text>
        <text wx:else>🌙 牌灵正在回应...</text>
      </button>

      <text class="btn-text" style="text-align:center;display:block;width:100%;margin-top:var(--space-md)" bindtap="onBackToSpreads">← 重新选择牌阵</text>
    </view>
  </view>
</view>
