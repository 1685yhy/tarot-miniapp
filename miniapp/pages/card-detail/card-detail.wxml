<!--
  ================================================================
  Card Detail — A Precious Illustrated Manuscript
  Starlight Theme: deep indigo, gold illumination, warm cream text,
  lavender accents. Each card opens like a treasured artifact.
  ================================================================
-->
<view class="page">

  <!-- ============================================================
       LOADING SKELETON — subtle shimmer on deep background
       ============================================================ -->
  <view wx:if="{{pageLoading}}" class="skeleton-root">
    <view class="skeleton-hero">
      <view class="skeleton skeleton-frame"></view>
    </view>
    <view class="skeleton skeleton-name"></view>
    <view class="skeleton-tags">
      <view class="skeleton skeleton-pill"></view>
      <view class="skeleton skeleton-pill"></view>
      <view class="skeleton skeleton-pill"></view>
    </view>
    <view class="skeleton-blocks">
      <view class="skeleton skeleton-block"></view>
      <view class="skeleton skeleton-block"></view>
      <view class="skeleton skeleton-block"></view>
    </view>
  </view>

  <!-- ============================================================
       ERROR STATE — gentle, poetic
       ============================================================ -->
  <view wx:elif="{{pageError}}" class="error-root">
    <view class="error-icon-wrap">
      <image class="error-icon" src="/images/icons/warning_64.png" mode="aspectFit" aria-label="错误" />
    </view>
    <text class="error-text">星辰暂时隐匿</text>
    <text class="error-hint">{{pageError}}</text>
    <button class="error-btn" bindtap="onRetry">重新凝望</button>
  </view>

  <!-- ============================================================
       MAIN CONTENT
       ============================================================ -->
  <view wx:elif="{{card}}" class="content-root">

    <!-- ==================== HERO: CARD IMAGE ==================== -->
    <view class="hero-section">
      <view class="hero-frame">
        <view class="card-img-wrap hero-frame-img {{heroImgLoaded ? 'card-img-wrap--loaded' : ''}} {{heroImgError ? 'card-img-wrap--error' : ''}}">
          <image
            class="card-img-inner hero-image"
            src="{{card.imagePath}}"
            mode="aspectFit"
            wx:if="{{card.imagePath && !heroImgError}}"
            bindload="onHeroImgLoad"
            binderror="onHeroImgError"
            aria-label="{{card.name_zh}} · {{card.suit_cn || '大牌'}} · {{card.type_cn || ''}} — 塔罗卡牌详情"
          />
          <view class="card-img-fallback" wx:if="{{!card.imagePath || heroImgError}}">
            <image class="card-img-fallback-icon" src="/images/icons/card_back_64.png" mode="aspectFit" aria-label="{{card.name_zh}} · {{card.suit_cn || '大牌'}} — 塔罗卡牌详情（无图）" />
          </view>
        </view>
        <!-- Decorative corner accents -->
        <view class="corner corner-tl"></view>
        <view class="corner corner-tr"></view>
        <view class="corner corner-bl"></view>
        <view class="corner corner-br"></view>
      </view>
      <text class="hero-name-zh">{{card.name_zh}}</text>
      <text class="hero-name-en">{{card.name_en}}</text>
    </view>

    <!-- ==================== KEYWORD TAGS ==================== -->
    <view class="keywords-row" wx:if="{{card.keywordsList && card.keywordsList.length}}">
      <text
        class="keyword-tag"
        wx:for="{{card.keywordsList}}" wx:key="*this"
      >{{item}}</text>
    </view>

    <!-- ==================== UPRIGHT / REVERSED / TEACHING SWITCHER ==================== -->
    <view class="tab-switcher">
      <view
        class="tab-item {{activeTab === 'upright' ? 'tab-active' : ''}}"
        data-tab="upright"
        bindtap="onTabTap"
      >正位</view>
      <view
        class="tab-item {{activeTab === 'reversed' ? 'tab-active' : ''}}"
        data-tab="reversed"
        bindtap="onTabTap"
      >逆位</view>
      <view
        class="tab-item {{activeTab === 'teaching' ? 'tab-active' : ''}}"
        data-tab="teaching"
        bindtap="onTabTap"
      >深度解析</view>
    </view>

    <!-- ==================== MEANINGS — UPRIGHT ==================== -->
    <view wx:if="{{activeTab === 'upright'}}">
      <view class="meaning-card">
        <text class="meaning-title">✦ 总述</text>
        <text class="meaning-text">{{card.meaning_upright}}</text>
      </view>
      <view class="meaning-card">
        <text class="meaning-title">✦ 感情</text>
        <text class="meaning-text">{{card.love_upright}}</text>
      </view>
      <view class="meaning-card">
        <text class="meaning-title">✦ 事业</text>
        <text class="meaning-text">{{card.career_upright}}</text>
      </view>
      <view class="meaning-card">
        <text class="meaning-title">✦ 财运</text>
        <text class="meaning-text">{{card.finance_upright}}</text>
      </view>
      <view class="meaning-card meaning-card-last">
        <text class="meaning-title">✦ 健康</text>
        <text class="meaning-text">{{card.health_upright}}</text>
      </view>
    </view>

    <!-- ==================== MEANINGS — REVERSED ==================== -->
    <view wx:elif="{{activeTab === 'reversed'}}">
      <view class="meaning-card">
        <text class="meaning-title">✦ 总述</text>
        <text class="meaning-text">{{card.meaning_reversed}}</text>
      </view>
      <view class="meaning-card">
        <text class="meaning-title">✦ 感情</text>
        <text class="meaning-text">{{card.love_reversed}}</text>
      </view>
      <view class="meaning-card">
        <text class="meaning-title">✦ 事业</text>
        <text class="meaning-text">{{card.career_reversed}}</text>
      </view>
      <view class="meaning-card">
        <text class="meaning-title">✦ 财运</text>
        <text class="meaning-text">{{card.finance_reversed}}</text>
      </view>
      <view class="meaning-card meaning-card-last">
        <text class="meaning-title">✦ 健康</text>
        <text class="meaning-text">{{card.health_reversed}}</text>
      </view>
    </view>

    <!-- ==================== TEACHING — 深度解析 ==================== -->
    <view wx:elif="{{activeTab === 'teaching'}}" class="teaching-root">

      <!-- Teaching loading skeleton -->
      <view wx:if="{{teachingLoading}}" class="teaching-loading">
        <view class="skeleton skeleton-text-lg"></view>
        <view class="skeleton skeleton-text"></view>
        <view class="skeleton skeleton-text"></view>
        <view class="skeleton skeleton-block"></view>
      </view>

      <!-- Teaching content -->
      <block wx:elif="{{teaching}}" class="teaching-content">

        <!-- 牌面象征符号解读 -->
        <view class="teaching-section" wx:if="{{teaching.symbols && teaching.symbols.length}}">
          <text class="teaching-section-title">✦ 牌面符号解读</text>
          <view class="symbol-list">
            <view
              class="symbol-item"
              wx:for="{{teaching.symbols}}" wx:key="index"
              wx:for-index="idx"
            >
              <view class="symbol-badge">{{idx + 1}}</view>
              <view class="symbol-body">
                <text class="symbol-name">{{item.symbol}}</text>
                <text class="symbol-meaning">{{item.meaning}}</text>
              </view>
            </view>
          </view>
        </view>

        <!-- 学习关键词 -->
        <view class="teaching-section" wx:if="{{teaching.keywords_learning && teaching.keywords_learning.length}}">
          <text class="teaching-section-title">✦ 学习关键词</text>
          <view class="keywords-learning-row">
            <text
              class="keyword-learning-tag"
              wx:for="{{teaching.keywords_learning}}" wx:key="*this"
            >{{item}}</text>
          </view>
        </view>

        <!-- 典故故事 -->
        <view class="teaching-section" wx:if="{{teaching.story}}">
          <text class="teaching-section-title">✦ 典故故事</text>
          <view class="story-card">
            <text class="story-text">{{teaching.story}}</text>
          </view>
        </view>

        <!-- 生活关联 -->
        <view class="teaching-section" wx:if="{{teaching.life_connection}}">
          <text class="teaching-section-title">✦ 生活关联</text>
          <view class="life-connection-card">
            <text class="life-connection-icon">💫</text>
            <text class="life-connection-text">{{teaching.life_connection}}</text>
          </view>
        </view>

        <!-- 元素属性 -->
        <view class="teaching-section teaching-section-last" wx:if="{{teaching.element_association}}">
          <text class="teaching-section-title">✦ 元素属性</text>
          <view class="element-card">
            <text class="element-text">{{teaching.element_association}}</text>
          </view>
        </view>

      </block>

      <!-- Teaching data unavailable -->
      <view wx:else class="teaching-unavailable">
        <text class="teaching-unavailable-text">深度解析数据暂未收录</text>
        <text class="teaching-unavailable-hint">这张卡牌的教学内容正在完善中</text>
      </view>

    </view>

    <!-- ==================== ADDITIONAL INFO ==================== -->
    <view
      class="meta-row"
      wx:if="{{card.element || card.planet || card.zodiac}}"
    >
      <text class="meta-label" wx:if="{{card.element}}">{{card.element}}</text>
      <text class="meta-divider" wx:if="{{card.element && (card.planet || card.zodiac)}}">·</text>
      <text class="meta-label" wx:if="{{card.planet}}">{{card.planet}}</text>
      <text class="meta-divider" wx:if="{{card.planet && card.zodiac}}">·</text>
      <text class="meta-label" wx:if="{{card.zodiac}}">{{card.zodiac}}</text>
    </view>

    <!-- Back navigation removed — native nav bar provides back button -->

  </view>
</view>
