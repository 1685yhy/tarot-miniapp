<!-- pages/card-detail/card-detail.wxml -->
<view class="page">
  <!-- ===== 加载骨架 ===== -->
  <view wx:if="{{pageLoading}}">
    <view class="skeleton">
      <view class="skeleton-header">
        <view class="skeleton-badge"></view>
        <view class="skeleton-line wide"></view>
        <view class="skeleton-line medium"></view>
      </view>
      <view class="skeleton-body">
        <view class="skeleton-block"></view>
        <view class="skeleton-block" style="height:80rpx"></view>
        <view class="skeleton-block"></view>
        <view class="skeleton-block"></view>
      </view>
    </view>
  </view>

  <!-- ===== 错误状态 ===== -->
  <view wx:elif="{{pageError}}" class="error-state">
    <text class="error-icon">🌙</text>
    <text class="error-text">这张牌的信息暂时无法获取</text>
    <text class="error-hint">{{pageError}}</text>
    <button class="btn-primary btn-small" bindtap="onRetry">✨ 重新加载</button>
  </view>

  <!-- ===== 主内容 ===== -->
  <view wx:elif="{{card}}">
    <!-- Card header -->
    <view class="card-header anim-fade-in-up-1">
      <view class="card-number-badge flex-center">{{card.card_number}}</view>
      <text class="heading-1">{{card.name_zh}}</text>
      <text class="text-dim mt-xs">{{card.name_en}}</text>
      <view class="flex-center gap-sm mt-md">
        <text class="badge badge-purple">{{card.arcana === 'major' ? '大阿尔卡纳' : '小阿尔卡纳'}}</text>
        <text class="badge badge-gold" wx:if="{{card.suit}}">{{card.suit === 'wands' ? '权杖' : card.suit === 'cups' ? '圣杯' : card.suit === 'swords' ? '宝剑' : '星币'}}</text>
        <text class="badge" style="background:var(--color-star-subtle);color:var(--color-text-secondary)" wx:if="{{card.element}}">{{card.element}}</text>
      </view>
    </view>

    <!-- Image description -->
    <view class="card anim-fade-in-up-2">
      <text class="section-title">🖼️ 牌面描述</text>
      <text class="section-text mt-sm">{{card.image_description}}</text>
    </view>

    <!-- Keywords -->
    <view class="card anim-fade-in-up-3">
      <text class="section-title">🔑 关键词</text>
      <view class="keyword-list mt-sm">
        <text class="badge badge-gold" wx:for="{{card.keywordsList}}" wx:key="*this" style="font-size:var(--fs-body-small);padding:8rpx 18rpx">{{item}}</text>
      </view>
    </view>

    <!-- Upright/Reversed toggle -->
    <view class="toggle-bar anim-fade-in-up-4">
      <view
        class="toggle-item {{activeTab === 'upright' ? 'toggle-active' : ''}}"
        data-tab="upright"
        bindtap="onTabTap"
      >
        <text>☀️ 正位</text>
      </view>
      <view
        class="toggle-item {{activeTab === 'reversed' ? 'toggle-active' : ''}}"
        data-tab="reversed"
        bindtap="onTabTap"
      >
        <text>🌙 逆位</text>
      </view>
    </view>

    <!-- Meanings -->
    <view wx:if="{{activeTab === 'upright'}}" class="anim-fade-in-up-5">
      <view class="card mb-lg">
        <text class="section-title">📜 正位含义</text>
        <text class="section-text mt-sm">{{card.meaning_upright}}</text>
      </view>
      <view class="card mb-lg">
        <text class="section-title">💕 爱情</text>
        <text class="section-text mt-sm">{{card.love_upright}}</text>
      </view>
      <view class="card mb-lg">
        <text class="section-title">💼 事业</text>
        <text class="section-text mt-sm">{{card.career_upright}}</text>
      </view>
      <view class="card mb-lg">
        <text class="section-title">💰 财运</text>
        <text class="section-text mt-sm">{{card.finance_upright}}</text>
      </view>
      <view class="card">
        <text class="section-title">💚 健康</text>
        <text class="section-text mt-sm">{{card.health_upright}}</text>
      </view>
    </view>

    <view wx:else class="anim-fade-in-up-5">
      <view class="card mb-lg">
        <text class="section-title">📜 逆位含义</text>
        <text class="section-text mt-sm">{{card.meaning_reversed}}</text>
      </view>
      <view class="card mb-lg">
        <text class="section-title">💕 爱情</text>
        <text class="section-text mt-sm">{{card.love_reversed}}</text>
      </view>
      <view class="card mb-lg">
        <text class="section-title">💼 事业</text>
        <text class="section-text mt-sm">{{card.career_reversed}}</text>
      </view>
      <view class="card mb-lg">
        <text class="section-title">💰 财运</text>
        <text class="section-text mt-sm">{{card.finance_reversed}}</text>
      </view>
      <view class="card">
        <text class="section-title">💚 健康</text>
        <text class="section-text mt-sm">{{card.health_reversed}}</text>
      </view>
    </view>
  </view>
</view>
