/* ================================================================
   CARD DETAIL — STARLIGHT ILLUMINATED MANUSCRIPT
   ================================================================
   Every card is a relic. Deep indigo night sky, gold illumination,
   warm parchment text, lavender starlight accents.
   Uses common.wxss design tokens with page-level overrides.
   ================================================================ */

/* ================================================================
   STARLIGHT THEME — page-level overrides
   Card detail uses deeper bg (#0B0B16) and cooler gold (#D4AF37)
   ================================================================ */
page {
  --color-bg: #0B0B16;
  --color-gold: #D4AF37;
}

/* ================================================================
   PAGE WRAPPER
   ================================================================ */
.page {
  min-height: 100vh;
  background: linear-gradient(
    180deg,
    var(--color-bg) 0%,
    #0F0E1A 50%,
    var(--color-bg) 100%
  );
  padding: var(--spacing-lg) var(--spacing-md) var(--spacing-2xl);
  box-sizing: border-box;
}

/* ================================================================
   HERO SECTION — The Card as Artifact
   ================================================================ */
.hero-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: var(--spacing-md);
  margin-bottom: var(--spacing-lg);
  animation: sl-fade-up 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  animation-delay: 0.05s;
  opacity: 0;
}

/* ── Frame ── */
.hero-frame {
  position: relative;
  width: 440rpx;
  height: 616rpx;
  border-radius: 24rpx;
  border: 2rpx solid rgba(212, 175, 55, 0.45);
  box-shadow:
    0 0 0 6rpx rgba(212, 175, 55, 0.04),
    0 0 40rpx rgba(212, 175, 55, 0.10),
    0 0 80rpx rgba(212, 175, 55, 0.05),
    0 16rpx 48rpx rgba(0, 0, 0, 0.40);
  overflow: hidden;
  background: var(--color-surface);
  flex-shrink: 0;
  /* subtle inner glow on hover */
  transition: box-shadow 0.15s ease-out;
}

.hero-image {
  width: 100%;
  height: 100%;
  display: block;
}

.hero-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, var(--color-surface) 0%, #0F0E1A 100%);
}

.hero-placeholder-icon {
  font-size: calc(var(--font-size-display) + 24rpx);
  opacity: 0.25;
}

/* ── Corner ornaments on the frame ── */
.corner {
  position: absolute;
  width: 28rpx;
  height: 28rpx;
  border-color: rgba(212, 175, 55, 0.50);
  border-style: solid;
}

.corner-tl {
  top: 8rpx;
  left: 8rpx;
  border-width: 2rpx 0 0 2rpx;
  border-radius: 4rpx 0 0 0;
}

.corner-tr {
  top: 8rpx;
  right: 8rpx;
  border-width: 2rpx 2rpx 0 0;
  border-radius: 0 4rpx 0 0;
}

.corner-bl {
  bottom: 8rpx;
  left: 8rpx;
  border-width: 0 0 2rpx 2rpx;
  border-radius: 0 0 0 4rpx;
}

.corner-br {
  bottom: 8rpx;
  right: 8rpx;
  border-width: 0 2rpx 2rpx 0;
  border-radius: 0 0 4rpx 0;
}

/* ── Card name — large gold ── */
.hero-name-zh {
  display: block;
  margin-top: var(--spacing-lg);
  font-size: var(--font-size-title);
  font-weight: 700;
  color: var(--color-gold-light);
  line-height: 1.2;
  letter-spacing: 6rpx;
  text-shadow: 0 0 40rpx rgba(212, 175, 55, 0.15);
}

.hero-name-en {
  display: block;
  margin-top: var(--spacing-xxs);
  font-size: var(--font-size-caption);
  color: var(--color-lavender);
  line-height: 1.3;
  letter-spacing: 2rpx;
  font-style: italic;
  opacity: 0.80;
}

/* ================================================================
   KEYWORD ROW — Centered gold pills
   ================================================================ */
.keywords-row {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: var(--spacing-md);
  margin-bottom: var(--spacing-xl);
  padding: 0 var(--spacing-md);
  animation: sl-fade-up 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  animation-delay: 0.15s;
  opacity: 0;
}

.keyword-tag {
  display: inline-block;
  padding: 8rpx 24rpx;
  font-size: var(--font-size-caption);
  color: var(--color-gold-light);
  background: rgba(212, 175, 55, 0.09);
  border: 1rpx solid rgba(212, 175, 55, 0.18);
  border-radius: var(--radius-pill);
  letter-spacing: 2rpx;
  line-height: 1.4;
  transition: all 0.15s ease-out;
}

.keyword-tag:active {
  background: rgba(212, 175, 55, 0.18);
  border-color: rgba(212, 175, 55, 0.35);
}

/* ================================================================
   TAB SWITCHER — Upright / Reversed pill pair
   ================================================================ */
.tab-switcher {
  display: flex;
  justify-content: center;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-xl);
  animation: sl-fade-up 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  animation-delay: 0.25s;
  opacity: 0;
}

.tab-item {
  flex: 0 1 180rpx;
  text-align: center;
  padding: var(--spacing-xs) 0;
  border-radius: var(--radius-pill);
  font-size: var(--font-size-body);
  font-weight: 500;
  letter-spacing: 3rpx;
  border: 1.5rpx solid rgba(212, 175, 55, 0.30);
  color: var(--color-text-secondary);
  background: transparent;
  transition: all 0.15s cubic-bezier(0.16, 1, 0.3, 1);
  position: relative;
  overflow: hidden;
}

.tab-item:active {
  transform: scale(0.96);
}

.tab-active {
  background: linear-gradient(135deg, var(--color-gold) 0%, #E8C04A 100%);
  border-color: var(--color-gold);
  color: var(--color-text-inverse);
  font-weight: 600;
  box-shadow: 0 4rpx 20rpx rgba(212, 175, 55, 0.25);
}

/* ================================================================
   MEANING CARDS — Illustrated manuscript sections
   ================================================================ */
.meaning-card {
  position: relative;
  background: linear-gradient(
    135deg,
    var(--color-card) 0%,
    rgba(24, 23, 52, 0.85) 100%
  );
  border: 1rpx solid rgba(212, 175, 55, 0.12);
  border-radius: var(--radius-md);
  padding: var(--spacing-lg) var(--spacing-xl);
  margin-bottom: var(--spacing-2xl);
  box-shadow:
    0 2rpx 16rpx rgba(0, 0, 0, 0.20),
    0 0 1rpx rgba(212, 175, 55, 0.04);
  animation: sl-fade-up 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  opacity: 0;
}

/* Staggered animation delays via inline style on view groups,
   but we add nth-of-type delays as a refinement. */
.meaning-card:nth-child(1) { animation-delay: 0.35s; }
.meaning-card:nth-child(2) { animation-delay: 0.42s; }
.meaning-card:nth-child(3) { animation-delay: 0.49s; }
.meaning-card:nth-child(4) { animation-delay: 0.56s; }
.meaning-card:nth-child(5) { animation-delay: 0.63s; }

/* Last card — no bottom margin so page padding handles it */
.meaning-card-last {
  margin-bottom: 0;
}

/* ── Title with diamond ornament ── */
.meaning-title {
  display: block;
  font-size: var(--font-size-caption);
  font-weight: 600;
  color: var(--color-gold-light);
  letter-spacing: 4rpx;
  margin-bottom: var(--spacing-md);
  line-height: 1.4;
}

/* ── Body text — warm cream, generous leading ── */
.meaning-text {
  display: block;
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  line-height: 1.75;
  letter-spacing: 1rpx;
  text-rendering: optimizeLegibility;
}

/* ================================================================
   ADDITIONAL INFO ROW — Lavender labels
   ================================================================ */
.meta-row {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: var(--spacing-xs);
  margin-top: var(--spacing-2xl);
  padding: var(--spacing-md) 0;
  border-top: 1rpx solid rgba(184, 169, 224, 0.08);
  animation: sl-fade-up 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  animation-delay: 0.70s;
  opacity: 0;
}

.meta-label {
  font-size: var(--font-size-caption);
  color: var(--color-lavender);
  letter-spacing: 2rpx;
  padding: 6rpx 20rpx;
  background: rgba(184, 169, 224, 0.07);
  border: 1rpx solid rgba(184, 169, 224, 0.12);
  border-radius: var(--radius-pill);
  line-height: 1.4;
}

.meta-divider {
  font-size: var(--font-size-xs);
  color: rgba(184, 169, 224, 0.25);
  line-height: 1;
}

/* ================================================================
   SKELETON LOADING — Shapes only (shimmer from common.wxss)
   ================================================================ */
.skeleton-root {
  padding: var(--spacing-lg) 0;
}

.skeleton-hero {
  display: flex;
  justify-content: center;
  margin-bottom: var(--spacing-lg);
}

.skeleton-frame {
  width: 400rpx;
  height: 560rpx;
  border-radius: 24rpx;
}

.skeleton-name {
  width: 200rpx;
  height: 36rpx;
  margin: 0 auto var(--spacing-xl);
  border-radius: var(--radius-sm);
}

.skeleton-tags {
  display: flex;
  justify-content: center;
  gap: var(--spacing-xs);
  margin-bottom: var(--spacing-xl);
}

.skeleton-pill {
  width: 100rpx;
  height: 36rpx;
  border-radius: var(--radius-pill);
}

.skeleton-pill:nth-child(2) { width: 130rpx; }
.skeleton-pill:nth-child(3) { width: 90rpx; }

.skeleton-blocks {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

.skeleton-block {
  width: 100%;
  height: 160rpx;
  border-radius: var(--radius-md);
}

/* ================================================================
   ERROR STATE
   ================================================================ */
.error-root {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-2xl) var(--spacing-lg);
  min-height: 60vh;
}

.error-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-pill);
  background: var(--color-lavender-glow);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--spacing-md);
}

.error-icon {
  font-size: var(--font-size-title);
  color: var(--color-lavender);
  opacity: 0.70;
}

.error-text {
  display: block;
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  margin-bottom: var(--spacing-xxs);
  letter-spacing: 2rpx;
}

.error-hint {
  display: block;
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  margin-bottom: var(--spacing-lg);
  text-align: center;
  line-height: 1.5;
}

.error-btn {
  padding: 16rpx 48rpx;
  font-size: var(--font-size-caption);
  color: var(--color-gold-light);
  background: rgba(212, 175, 55, 0.09);
  border: 1.5rpx solid rgba(212, 175, 55, 0.25);
  border-radius: var(--radius-pill);
  letter-spacing: 2rpx;
  transition: all 0.15s ease-out;
}

.error-btn:active {
  background: rgba(212, 175, 55, 0.16);
  border-color: rgba(212, 175, 55, 0.40);
}

/* ================================================================
   ANIMATIONS
   ================================================================ */
@keyframes sl-fade-up {
  from {
    opacity: 0;
    transform: translateY(24rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ================================================================
   CONTENT ROOT — inner wrapper ensures proper animation context
   ================================================================ */
.content-root {
  position: relative;
}
