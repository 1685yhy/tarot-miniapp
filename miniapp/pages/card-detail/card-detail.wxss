/* pages/card-detail/card-detail.wxss */
.container {
  padding: 24rpx;
  background: var(--color-bg);
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* Header */
.card-header {
  text-align: center;
  padding: 40rpx 0 30rpx;
  border-bottom: 1rpx solid rgba(201, 169, 110, 0.15);
  margin-bottom: 28rpx;
}
.card-number-badge {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-gold), var(--color-gold-light));
  color: #1a1a2e;
  font-size: 28rpx;
  font-weight: 700;
  margin: 0 auto 16rpx;
}
.card-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-gold);
  display: block;
}
.card-subtitle {
  font-size: 24rpx;
  color: var(--color-text-dim);
  display: block;
  margin-top: 6rpx;
}
.card-meta {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-top: 16rpx;
}
.meta-item {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  background: var(--color-bg-card);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

/* Sections */
.section {
  background: var(--color-bg-card);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(201, 169, 110, 0.08);
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-gold-light);
  display: block;
  margin-bottom: 14rpx;
}
.section-text {
  font-size: 28rpx;
  color: var(--color-text-primary);
  line-height: 1.8;
  display: block;
}

/* Keywords */
.keyword-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.keyword {
  font-size: 24rpx;
  color: var(--color-gold);
  background: rgba(201, 169, 110, 0.1);
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
}

/* Toggle */
.toggle-bar {
  display: flex;
  background: var(--color-bg-card);
  border-radius: 36rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}
.toggle-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 30rpx;
  font-size: 28rpx;
  color: var(--color-text-secondary);
  transition: all 0.2s;
}
.toggle-active {
  background: linear-gradient(135deg, var(--color-gold), var(--color-gold-light));
  color: #1a1a2e;
  font-weight: 600;
}

/* Loading */
.loading {
  display: flex;
  justify-content: center;
  padding: 200rpx 0;
}
.loading-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}
