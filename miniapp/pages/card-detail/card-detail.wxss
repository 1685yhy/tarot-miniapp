/* ================================================================
   CARD DETAIL — STARLIGHT ILLUMINATED MANUSCRIPT
   ================================================================
   Every card is a relic. Deep indigo night sky, gold illumination,
   warm parchment text, lavender starlight accents.
   Self-contained theme — no external variable dependencies.
   ================================================================ */

/* ================================================================
   STARLIGHT COLOR PALETTE — self-contained
   ================================================================ */
page {
  /* ── Deep space background ── */
  --sl-bg: #0B0B16;
  --sl-bg-warm: #0F0E1A;

  /* ── Surface / card elevations ── */
  --sl-surface: #13122A;
  --sl-card: #181734;
  --sl-card-border: rgba(212, 175, 55, 0.12);

  /* ── Gold illumination ── */
  --sl-gold: #D4AF37;
  --sl-gold-light: #F0D68A;
  --sl-gold-dim: rgba(212, 175, 55, 0.08);

  /* ── Lavender starlight ── */
  --sl-lavender: #B8A9E0;
  --sl-lavender-dim: rgba(184, 169, 224, 0.10);

  /* ── Text — warm cream parchment ── */
  --sl-text-primary: #F0E6D0;
  --sl-text-secondary: #C8BFA8;
  --sl-text-tertiary: #7A7494;

  /* ── Sizing & spacing ── */
  --sl-radius-sm: 8rpx;
  --sl-radius-md: 16rpx;
  --sl-radius-lg: 24rpx;
  --sl-radius-xl: 32rpx;
  --sl-radius-full: 9999rpx;

  --sl-space-xs: 8rpx;
  --sl-space-sm: 12rpx;
  --sl-space-md: 16rpx;
  --sl-space-lg: 24rpx;
  --sl-space-xl: 32rpx;
  --sl-space-2xl: 48rpx;
  --sl-space-3xl: 64rpx;
}

/* ================================================================
   PAGE WRAPPER
   ================================================================ */
.page {
  min-height: 100vh;
  background: linear-gradient(
    180deg,
    var(--sl-bg) 0%,
    var(--sl-bg-warm) 50%,
    var(--sl-bg) 100%
  );
  padding: var(--sl-space-xl) var(--sl-space-lg) var(--sl-space-3xl);
  box-sizing: border-box;
}

/* ================================================================
   HERO SECTION — The Card as Artifact
   ================================================================ */
.hero-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: var(--sl-space-lg);
  margin-bottom: var(--sl-space-xl);
  animation: sl-fade-up 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  animation-delay: 0.05s;
  opacity: 0;
}

/* ── Frame ── */
.hero-frame {
  position: relative;
  width: 440rpx;
  height: 616rpx;
  border-radius: var(--sl-radius-lg);
  border: 2rpx solid rgba(212, 175, 55, 0.45);
  box-shadow:
    0 0 0 6rpx rgba(212, 175, 55, 0.04),
    0 0 40rpx rgba(212, 175, 55, 0.10),
    0 0 80rpx rgba(212, 175, 55, 0.05),
    0 16rpx 48rpx rgba(0, 0, 0, 0.40);
  overflow: hidden;
  background: var(--sl-surface);
  flex-shrink: 0;
  /* subtle inner glow on hover */
  transition: box-shadow 0.4s ease;
}

.hero-image {
  width: 100%;
  height: 100%;
  display: block;
}

.hero-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, var(--sl-surface) 0%, var(--sl-bg-warm) 100%);
}

.hero-placeholder-icon {
  font-size: 80rpx;
  opacity: 0.25;
}

/* ── Corner ornaments on the frame ── */
.corner {
  position: absolute;
  width: 28rpx;
  height: 28rpx;
  border-color: rgba(212, 175, 55, 0.50);
  border-style: solid;
}

.corner-tl {
  top: 8rpx;
  left: 8rpx;
  border-width: 2rpx 0 0 2rpx;
  border-radius: 4rpx 0 0 0;
}

.corner-tr {
  top: 8rpx;
  right: 8rpx;
  border-width: 2rpx 2rpx 0 0;
  border-radius: 0 4rpx 0 0;
}

.corner-bl {
  bottom: 8rpx;
  left: 8rpx;
  border-width: 0 0 2rpx 2rpx;
  border-radius: 0 0 0 4rpx;
}

.corner-br {
  bottom: 8rpx;
  right: 8rpx;
  border-width: 0 2rpx 2rpx 0;
  border-radius: 0 0 4rpx 0;
}

/* ── Card name — large gold ── */
.hero-name-zh {
  display: block;
  margin-top: var(--sl-space-xl);
  font-size: 52rpx;
  font-weight: 700;
  color: var(--sl-gold-light);
  line-height: 1.2;
  letter-spacing: 6rpx;
  text-shadow: 0 0 40rpx rgba(212, 175, 55, 0.15);
}

.hero-name-en {
  display: block;
  margin-top: var(--sl-space-xs);
  font-size: 26rpx;
  color: var(--sl-lavender);
  line-height: 1.3;
  letter-spacing: 2rpx;
  font-style: italic;
  opacity: 0.80;
}

/* ================================================================
   KEYWORD ROW — Centered gold pills
   ================================================================ */
.keywords-row {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: var(--sl-space-lg);
  margin-bottom: var(--sl-space-2xl);
  padding: 0 var(--sl-space-lg);
  animation: sl-fade-up 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  animation-delay: 0.15s;
  opacity: 0;
}

.keyword-tag {
  display: inline-block;
  padding: 8rpx 24rpx;
  font-size: 22rpx;
  color: var(--sl-gold-light);
  background: rgba(212, 175, 55, 0.09);
  border: 1rpx solid rgba(212, 175, 55, 0.18);
  border-radius: var(--sl-radius-full);
  letter-spacing: 2rpx;
  line-height: 1.4;
  transition: all 0.25s ease;
}

.keyword-tag:active {
  background: rgba(212, 175, 55, 0.18);
  border-color: rgba(212, 175, 55, 0.35);
}

/* ================================================================
   TAB SWITCHER — Upright / Reversed pill pair
   ================================================================ */
.tab-switcher {
  display: flex;
  justify-content: center;
  gap: var(--sl-space-md);
  margin-bottom: var(--sl-space-2xl);
  animation: sl-fade-up 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  animation-delay: 0.25s;
  opacity: 0;
}

.tab-item {
  flex: 0 1 180rpx;
  text-align: center;
  padding: var(--sl-space-sm) 0;
  border-radius: var(--sl-radius-full);
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 3rpx;
  border: 1.5rpx solid rgba(212, 175, 55, 0.30);
  color: var(--sl-text-secondary);
  background: transparent;
  transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  position: relative;
  overflow: hidden;
}

.tab-item:active {
  transform: scale(0.96);
}

.tab-active {
  background: linear-gradient(135deg, var(--sl-gold) 0%, #E8C04A 100%);
  border-color: var(--sl-gold);
  color: #1A1A2E;
  font-weight: 600;
  box-shadow: 0 4rpx 20rpx rgba(212, 175, 55, 0.25);
}

/* ================================================================
   MEANING CARDS — Illustrated manuscript sections
   ================================================================ */
.meaning-card {
  position: relative;
  background: linear-gradient(
    135deg,
    var(--sl-card) 0%,
    rgba(24, 23, 52, 0.85) 100%
  );
  border: 1rpx solid var(--sl-card-border);
  border-radius: var(--sl-radius-md);
  padding: var(--sl-space-xl) var(--sl-space-2xl);
  margin-bottom: var(--sl-space-3xl);
  box-shadow:
    0 2rpx 16rpx rgba(0, 0, 0, 0.20),
    0 0 1rpx rgba(212, 175, 55, 0.04);
  animation: sl-fade-up 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  opacity: 0;
}

/* Staggered animation delays via inline style on view groups,
   but we add nth-of-type delays as a refinement. */
.meaning-card:nth-child(1) { animation-delay: 0.35s; }
.meaning-card:nth-child(2) { animation-delay: 0.42s; }
.meaning-card:nth-child(3) { animation-delay: 0.49s; }
.meaning-card:nth-child(4) { animation-delay: 0.56s; }
.meaning-card:nth-child(5) { animation-delay: 0.63s; }

/* Last card — no bottom margin so page padding handles it */
.meaning-card-last {
  margin-bottom: 0;
}

/* ── Title with diamond ornament ── */
.meaning-title {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--sl-gold-light);
  letter-spacing: 4rpx;
  margin-bottom: var(--sl-space-lg);
  line-height: 1.4;
}

/* ── Body text — warm cream, generous leading ── */
.meaning-text {
  display: block;
  font-size: 28rpx;
  color: var(--sl-text-primary);
  line-height: 1.75;
  letter-spacing: 1rpx;
  text-rendering: optimizeLegibility;
}

/* ================================================================
   ADDITIONAL INFO ROW — Lavender labels
   ================================================================ */
.meta-row {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: var(--sl-space-sm);
  margin-top: var(--sl-space-3xl);
  padding: var(--sl-space-lg) 0;
  border-top: 1rpx solid rgba(184, 169, 224, 0.08);
  animation: sl-fade-up 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  animation-delay: 0.70s;
  opacity: 0;
}

.meta-label {
  font-size: 22rpx;
  color: var(--sl-lavender);
  letter-spacing: 2rpx;
  padding: 6rpx 20rpx;
  background: rgba(184, 169, 224, 0.07);
  border: 1rpx solid rgba(184, 169, 224, 0.12);
  border-radius: var(--sl-radius-full);
  line-height: 1.4;
}

.meta-divider {
  font-size: 18rpx;
  color: rgba(184, 169, 224, 0.25);
  line-height: 1;
}

/* ================================================================
   SKELETON LOADING — Subtle pulsing shapes
   ================================================================ */
.skeleton-root {
  padding: var(--sl-space-xl) 0;
}

.skeleton-hero {
  display: flex;
  justify-content: center;
  margin-bottom: var(--sl-space-xl);
}

.skeleton-frame {
  width: 400rpx;
  height: 560rpx;
  border-radius: var(--sl-radius-lg);
  background: var(--sl-surface);
  animation: sl-skeleton-pulse 1.6s ease-in-out infinite;
}

.skeleton-name {
  width: 200rpx;
  height: 36rpx;
  margin: 0 auto var(--sl-space-2xl);
  border-radius: var(--sl-radius-sm);
  background: var(--sl-surface);
  animation: sl-skeleton-pulse 1.6s ease-in-out infinite;
}

.skeleton-tags {
  display: flex;
  justify-content: center;
  gap: var(--sl-space-sm);
  margin-bottom: var(--sl-space-2xl);
}

.skeleton-pill {
  width: 100rpx;
  height: 36rpx;
  border-radius: var(--sl-radius-full);
  background: var(--sl-surface);
  animation: sl-skeleton-pulse 1.6s ease-in-out infinite;
}

.skeleton-pill:nth-child(2) { width: 130rpx; }
.skeleton-pill:nth-child(3) { width: 90rpx; }

.skeleton-blocks {
  display: flex;
  flex-direction: column;
  gap: var(--sl-space-lg);
}

.skeleton-block {
  width: 100%;
  height: 160rpx;
  border-radius: var(--sl-radius-md);
  background: var(--sl-surface);
  animation: sl-skeleton-pulse 1.6s ease-in-out infinite;
}

@keyframes sl-skeleton-pulse {
  0%, 100% { opacity: 0.30; }
  50%      { opacity: 0.60; }
}

/* ================================================================
   ERROR STATE
   ================================================================ */
.error-root {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--sl-space-3xl) var(--sl-space-xl);
  min-height: 60vh;
}

.error-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--sl-radius-full);
  background: var(--sl-lavender-dim);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--sl-space-lg);
}

.error-icon {
  font-size: 48rpx;
  color: var(--sl-lavender);
  opacity: 0.70;
}

.error-text {
  display: block;
  font-size: 30rpx;
  color: var(--sl-text-secondary);
  margin-bottom: var(--sl-space-xs);
  letter-spacing: 2rpx;
}

.error-hint {
  display: block;
  font-size: 24rpx;
  color: var(--sl-text-tertiary);
  margin-bottom: var(--sl-space-xl);
  text-align: center;
  line-height: 1.5;
}

.error-btn {
  padding: 16rpx 48rpx;
  font-size: 26rpx;
  color: var(--sl-gold-light);
  background: rgba(212, 175, 55, 0.09);
  border: 1.5rpx solid rgba(212, 175, 55, 0.25);
  border-radius: var(--sl-radius-full);
  letter-spacing: 2rpx;
  transition: all 0.25s ease;
}

.error-btn:active {
  background: rgba(212, 175, 55, 0.16);
  border-color: rgba(212, 175, 55, 0.40);
}

/* ================================================================
   ANIMATIONS
   ================================================================ */
@keyframes sl-fade-up {
  from {
    opacity: 0;
    transform: translateY(24rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ================================================================
   CONTENT ROOT — inner wrapper ensures proper animation context
   ================================================================ */
.content-root {
  position: relative;
}
