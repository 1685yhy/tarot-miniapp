/* ===== 卡牌详情 - 至尊神秘主题 ===== */

/* Header */
.card-header {
  text-align: center;
  padding: var(--space-xxxl) 0 var(--space-xl);
  margin-bottom: var(--space-xl);
}

.card-number-badge {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: var(--radius-full);
  background: var(--gradient-gold);
  color: var(--color-text-on-gold);
  font-size: var(--fs-body);
  font-weight: var(--fw-bold);
  margin: 0 auto var(--space-md);
  box-shadow: var(--shadow-glow-gold);
}

/* Sections */
.section-text {
  font-size: var(--fs-body);
  color: var(--color-text-primary);
  line-height: var(--lh-loose);
  display: block;
}

/* Keywords */
.keyword-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
}

/* Toggle */
.toggle-bar {
  display: flex;
  background: var(--color-bg-card);
  border-radius: var(--radius-round);
  padding: 6rpx;
  margin-bottom: var(--space-xl);
}

.toggle-item {
  flex: 1;
  text-align: center;
  padding: var(--space-md) 0;
  border-radius: var(--radius-round);
  font-size: var(--fs-body);
  color: var(--color-text-secondary);
  transition: all var(--duration-normal);
}

.toggle-active {
  background: var(--gradient-gold);
  color: var(--color-text-on-gold);
  font-weight: var(--fw-semibold);
  box-shadow: var(--shadow-button);
}

/* ===== 加载骨架 ===== */
.skeleton {
  padding: var(--space-xxl) 0;
}

.skeleton-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-md);
  margin-bottom: var(--space-xxl);
}

.skeleton-badge {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-full);
  background: var(--color-bg-card);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-line {
  height: 32rpx;
  border-radius: var(--radius-sm);
  background: var(--color-bg-card);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-line.wide { width: 280rpx; }
.skeleton-line.medium { width: 180rpx; }

.skeleton-body {
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
}

.skeleton-block {
  width: 100%;
  height: 160rpx;
  border-radius: var(--radius-card);
  background: var(--color-bg-card);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

/* ===== 错误状态 ===== */
.error-state {
  text-align: center;
  padding: var(--space-massive) var(--space-xl);
}

.error-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: var(--space-md);
  opacity: 0.6;
}

.error-text {
  font-size: var(--fs-body);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--space-xs);
}

.error-hint {
  font-size: var(--fs-body-small);
  color: var(--color-text-dim);
  display: block;
  margin-bottom: var(--space-xxl);
}
