/* ============================================================
   Card Detail — Warm Paper Design System
   Warm ivory base, deep rose accent, sage subtle
   Card image hero, name header, meaning sections, keyword tags
   ============================================================ */

/* -----------------------------------------------------------
   1. CARD IMAGE — Hero section
   ----------------------------------------------------------- */

.card-image-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-5) 0 var(--spacing-6);
  margin-bottom: var(--spacing-5);
  position: relative;
}

.card-image-frame {
  width: 280rpx;
  height: 392rpx;
  border-radius: var(--radius-medium);
  border: 2rpx solid rgba(176, 102, 80, 0.20);
  box-shadow: var(--shadow-medium);
  overflow: hidden;
  background: rgba(139, 126, 110, 0.06);
  flex-shrink: 0;
}

.card-image {
  width: 100%;
  height: 100%;
}

.card-image-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(139, 126, 110, 0.04);
}

.card-image-placeholder::after {
  content: '';
  width: 64rpx;
  height: 64rpx;
  border: 2rpx solid rgba(139, 126, 110, 0.12);
  border-radius: var(--radius-small);
  opacity: 0.20;
}

/* -----------------------------------------------------------
   2. CARD HEADER — Name and number
   ----------------------------------------------------------- */

.card-header {
  text-align: center;
  padding: 0 0 var(--spacing-5);
  margin-bottom: var(--spacing-5);
  border-bottom: 1rpx solid rgba(139, 126, 110, 0.08);
}

.card-number-badge {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: var(--radius-pill);
  background: var(--color-accent);
  color: var(--color-surface);
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-bold);
  margin: 0 auto var(--spacing-4);
  text-align: center;
  letter-spacing: var(--letter-spacing-none);
  box-shadow: var(--shadow-subtle);
}

.card-name-zh {
  font-size: var(--font-size-display);
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
  line-height: var(--line-height-heading);
  letter-spacing: var(--letter-spacing-none);
  margin-bottom: var(--spacing-3);
}

.card-name-en {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  line-height: var(--line-height-heading);
  margin-bottom: var(--spacing-3);
  letter-spacing: var(--letter-spacing-none);
}

/* -----------------------------------------------------------
   3. SECTION CARDS — Info blocks
   ----------------------------------------------------------- */

.section-card {
  background: var(--color-surface);
  border: 1rpx solid rgba(139, 126, 110, 0.12);
  border-radius: var(--radius-medium);
  padding: var(--spacing-5) var(--spacing-6);
  margin-bottom: var(--spacing-5);
  box-shadow: var(--shadow-subtle);
  transition: border-color var(--duration-navigation) ease;
}

.section-title {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-semibold);
  color: var(--color-accent);
  letter-spacing: var(--letter-spacing-none);
  display: block;
  margin-bottom: var(--spacing-3);
}

.section-text {
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  line-height: var(--line-height-body);
  display: block;
}

/* -----------------------------------------------------------
   4. KEYWORD TAGS
   ----------------------------------------------------------- */

.keyword-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-3);
}

.keyword-list .badge {
  background: rgba(176, 102, 80, 0.06);
  color: var(--color-accent);
  border: 1rpx solid rgba(176, 102, 80, 0.12);
  border-radius: var(--radius-pill);
  padding: 6rpx var(--spacing-5);
  font-size: var(--font-size-body);
  letter-spacing: var(--letter-spacing-none);
  transition: all var(--duration-feedback) ease;
}

.keyword-list .badge:active {
  background: rgba(176, 102, 80, 0.12);
  border-color: rgba(176, 102, 80, 0.25);
}

/* -----------------------------------------------------------
   5. TOGGLE — Upright / Reversed
   ----------------------------------------------------------- */

.toggle-bar {
  display: flex;
  background: rgba(139, 126, 110, 0.06);
  border-radius: var(--radius-pill);
  padding: 4rpx;
  margin-bottom: var(--spacing-6);
  border: 1rpx solid rgba(139, 126, 110, 0.10);
}

.toggle-item {
  flex: 1;
  text-align: center;
  padding: var(--spacing-3) 0;
  border-radius: var(--radius-pill);
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  transition: all var(--duration-navigation) ease;
  letter-spacing: var(--letter-spacing-none);
}

.toggle-item:active {
  color: var(--color-accent);
}

.toggle-active {
  background: var(--color-surface);
  color: var(--color-accent);
  font-weight: var(--font-weight-medium);
  box-shadow: var(--shadow-subtle);
}

/* -----------------------------------------------------------
   6. SKELETON LOADING
   ----------------------------------------------------------- */

.skeleton {
  padding: var(--spacing-6) 0;
}

.skeleton-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-4);
  margin-bottom: var(--spacing-7);
}

.skeleton-badge {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-pill);
  background: rgba(139, 126, 110, 0.08);
  animation: pulse-soft 1500ms ease-in-out infinite;
}

.skeleton-line {
  height: 28rpx;
  border-radius: var(--radius-small);
  background: rgba(139, 126, 110, 0.08);
  animation: pulse-soft 1500ms ease-in-out infinite;
}

.skeleton-line.wide  { width: 240rpx; }
.skeleton-line.medium { width: 160rpx; }

.skeleton-body {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-5);
}

.skeleton-block {
  width: 100%;
  height: 140rpx;
  border-radius: var(--radius-medium);
  background: rgba(139, 126, 110, 0.08);
  animation: pulse-soft 1500ms ease-in-out infinite;
}

/* -----------------------------------------------------------
   7. ERROR STATE
   ----------------------------------------------------------- */

.error-state {
  text-align: center;
  padding: var(--spacing-8) var(--spacing-6);
}

.error-icon {
  width: 72rpx;
  height: 72rpx;
  display: block;
  margin: 0 auto var(--spacing-5);
  opacity: 0.30;
}

.error-text {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--spacing-3);
}

.error-hint {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--spacing-6);
  opacity: 0.70;
}

/* -----------------------------------------------------------
   8. ENTRANCE ANIMATIONS
   ----------------------------------------------------------- */

.anim-fade-in-up-1 { opacity: 0; animation: fade-up var(--duration-emphasis) ease 0.05s forwards; }
.anim-fade-in-up-2 { opacity: 0; animation: fade-up var(--duration-emphasis) ease 0.12s forwards; }
.anim-fade-in-up-3 { opacity: 0; animation: fade-up var(--duration-emphasis) ease 0.20s forwards; }
.anim-fade-in-up-4 { opacity: 0; animation: fade-up var(--duration-emphasis) ease 0.28s forwards; }
.anim-fade-in-up-5 { opacity: 0; animation: fade-up var(--duration-emphasis) ease 0.36s forwards; }
