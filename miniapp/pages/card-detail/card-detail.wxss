/* ==========================================
   card-detail · Editorial Minimal
   Clean white cards · Warm accents
   ========================================== */

/* -------- Header -------- */
.card-header {
  text-align: center;
  padding: var(--space-xxl) 0 var(--space-xl);
  margin-bottom: var(--space-lg);
  border-bottom: 1rpx solid rgba(180, 140, 110, 0.10);
}

.card-number-badge {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: var(--radius-full);
  background: #d4a574;
  color: #fff;
  font-size: var(--fs-caption);
  font-weight: var(--fw-bold);
  margin: 0 auto var(--space-md);
  letter-spacing: 1rpx;
}

/* -------- Section card -------- */
.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: var(--space-lg) var(--space-xl);
  margin-bottom: var(--space-lg);
  box-shadow: 0 2rpx 12rpx rgba(160, 130, 100, 0.06);
  border: 1rpx solid rgba(180, 140, 110, 0.06);
}

.section-title {
  font-size: var(--fs-body-small);
  font-weight: var(--fw-semibold);
  color: #b8865a;
  letter-spacing: 2rpx;
  display: block;
  margin-bottom: var(--space-sm);
  text-transform: uppercase;
}

.section-text {
  font-size: var(--fs-body);
  color: var(--color-text-primary);
  line-height: var(--lh-loose);
  display: block;
}

/* -------- Keywords -------- */
.keyword-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
}

.badge-gold {
  background: rgba(180, 140, 110, 0.08);
  color: #7a5c3f;
  border: 1rpx solid rgba(180, 140, 110, 0.12);
  border-radius: 40rpx;
  padding: 6rpx 18rpx;
  font-size: var(--fs-body-small);
  letter-spacing: 1rpx;
}

/* -------- Toggle (upright / reversed) -------- */
.toggle-bar {
  display: flex;
  background: #f8f4f0;
  border-radius: 40rpx;
  padding: 4rpx;
  margin-bottom: var(--space-xl);
  border: 1rpx solid rgba(180, 140, 110, 0.08);
}

.toggle-item {
  flex: 1;
  text-align: center;
  padding: var(--space-sm) 0;
  border-radius: 40rpx;
  font-size: var(--fs-body);
  color: var(--color-text-secondary);
  transition: all var(--duration-normal);
}

.toggle-active {
  background: #ffffff;
  color: #b8865a;
  font-weight: var(--fw-semibold);
  box-shadow: 0 2rpx 8rpx rgba(160, 130, 100, 0.08);
}

/* -------- Skeleton -------- */
.skeleton {
  padding: var(--space-xxl) 0;
}

.skeleton-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-md);
  margin-bottom: var(--space-xxl);
}

.skeleton-badge {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-full);
  background: #f0e8e0;
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-line {
  height: 28rpx;
  border-radius: 8rpx;
  background: #f0e8e0;
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-line.wide  { width: 240rpx; }
.skeleton-line.medium { width: 160rpx; }

.skeleton-body {
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
}

.skeleton-block {
  width: 100%;
  height: 140rpx;
  border-radius: 16rpx;
  background: #f0e8e0;
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

/* -------- Error state -------- */
.error-state {
  text-align: center;
  padding: var(--space-massive) var(--space-xl);
}

.error-icon {
  font-size: 72rpx;
  display: block;
  margin-bottom: var(--space-md);
  opacity: 0.5;
}

.error-text {
  font-size: var(--fs-body);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--space-xs);
}

.error-hint {
  font-size: var(--fs-body-small);
  color: var(--color-text-dim);
  display: block;
  margin-bottom: var(--space-xxl);
}
