/* pages/birthchart/birthchart.wxss — E3 本命星盘页（与神谕主屏同一设计语言） */
page {
  --e3-cream: #FAF6EF;
  --e3-cream-hi: #FFFDF8;
  --e3-paper: #F2ECDF;
  --e3-pink: #E8C4BE;
  --e3-pink-ink: #B08A82;
  --e3-gold: #C9A97C;
  --e3-gold-deep: #B08F52;
  --e3-line-soft: rgba(201, 169, 124, 0.38);
  --e3-ink: #3D3A36;
  --e3-ink-soft: #8A8478;
  --e3-ink-faint: #B0AA9C;
  --e3-shadow: 0 4rpx 20rpx rgba(61, 58, 54, 0.06);
  --e3-hi: inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
  --e3-serif: 'Songti SC', 'STSong', 'SimSun', 'Noto Serif CJK SC', 'Noto Serif SC', serif;
  --e3-sans: -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif;

  background: #FAF6EF;
  color: #3D3A36;
  font-family: var(--e3-serif);
  font-size: 28rpx;
  line-height: 1.6;
}

.page {
  min-height: 100vh;
  padding: 0 36rpx calc(40rpx + env(safe-area-inset-bottom));
  position: relative;
  box-sizing: border-box;
  background: #FAF6EF;
  overflow: hidden;
}

.wash {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
}
.wash-pink {
  top: -170rpx;
  right: -190rpx;
  width: 600rpx;
  height: 600rpx;
  background: radial-gradient(circle, rgba(232, 196, 190, 0.5) 0%, rgba(232, 196, 190, 0) 66%);
}
.wash-gold {
  left: -200rpx;
  top: 760rpx;
  width: 520rpx;
  height: 520rpx;
  background: radial-gradient(circle, rgba(201, 169, 124, 0.26) 0%, rgba(201, 169, 124, 0) 66%);
}

/* ── 标题 ── */
.bc-head {
  position: relative;
  z-index: 3;
  padding: 36rpx 4rpx 12rpx;
}
.oh-en {
  display: block;
  font-family: var(--e3-sans);
  font-size: 19rpx;
  letter-spacing: 8rpx;
  color: var(--e3-gold-deep);
}
.oh-h2 {
  display: block;
  margin-top: 10rpx;
  font-size: 44rpx;
  letter-spacing: 6rpx;
  color: var(--e3-ink);
}
.oh-p {
  display: block;
  margin-top: 14rpx;
  font-family: var(--e3-sans);
  font-size: 23rpx;
  color: var(--e3-ink-faint);
  letter-spacing: 4rpx;
}

/* ── 未填出生日期引导 ── */
.need-birth {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 28rpx;
  padding: 24rpx 26rpx;
  border-radius: 32rpx;
  background: rgba(232, 196, 190, 0.22);
  border: 1rpx dashed rgba(176, 138, 130, 0.55);
}
.need-birth-pressed {
  opacity: 0.7;
}
.need-birth-ic {
  font-size: 26rpx;
  color: var(--e3-pink-ink);
  flex-shrink: 0;
}
.need-birth-tx {
  flex: 1;
  font-family: var(--e3-sans);
  font-size: 22rpx;
  color: var(--e3-pink-ink);
  letter-spacing: 1rpx;
}
.need-birth-go {
  font-family: var(--e3-sans);
  font-size: 19rpx;
  color: var(--e3-ink-faint);
  flex-shrink: 0;
}

/* ── 三要素卡（水彩）── */
.ele-card {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 20rpx 0 0;
  background: var(--e3-cream-hi);
  border: 1rpx solid rgba(201, 169, 124, 0.3);
  border-radius: 36rpx;
  padding: 22rpx 26rpx;
  box-shadow: var(--e3-shadow), var(--e3-hi);
  transition: transform 0.14s ease;
}
.ele-card-sun {
  background: linear-gradient(135deg, rgba(232, 196, 190, 0.16), rgba(255, 253, 248, 0.96) 55%);
}
.ele-card-moon {
  background: linear-gradient(135deg, rgba(175, 194, 209, 0.16), rgba(255, 253, 248, 0.96) 55%);
}
.ele-card-rising {
  background: linear-gradient(135deg, rgba(201, 169, 124, 0.18), rgba(255, 253, 248, 0.96) 55%);
}
.ele-card-locked {
  background: rgba(242, 236, 223, 0.7);
  border-style: dashed;
}
.ele-card-pressed {
  transform: scale(0.98);
}
.ele-ic {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: linear-gradient(145deg, rgba(232, 196, 190, 0.5), rgba(201, 169, 124, 0.3));
  border: 1rpx solid rgba(201, 169, 124, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: var(--e3-pink-ink);
}
.ele-card-moon .ele-ic {
  background: linear-gradient(145deg, rgba(175, 194, 209, 0.5), rgba(126, 151, 171, 0.28));
  border-color: rgba(126, 151, 171, 0.4);
  color: #6F8CA2;
}
.ele-card-rising .ele-ic {
  background: linear-gradient(145deg, rgba(201, 169, 124, 0.55), rgba(176, 143, 82, 0.3));
  border-color: rgba(176, 143, 82, 0.4);
  color: var(--e3-gold-deep);
}
.ele-ic-locked {
  background: rgba(176, 170, 156, 0.18);
  border-color: rgba(176, 170, 156, 0.35);
  color: var(--e3-ink-faint);
}
.ele-tx {
  flex: 1;
  min-width: 0;
}
.ele-n-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.ele-n {
  font-size: 28rpx;
  letter-spacing: 4rpx;
  color: var(--e3-ink);
}
.ele-n-locked {
  color: var(--e3-ink-faint);
}
.ele-chip {
  font-family: var(--e3-sans);
  font-size: 18rpx;
  color: var(--e3-gold-deep);
  background: rgba(201, 169, 124, 0.16);
  border-radius: 999rpx;
  padding: 2rpx 12rpx;
  letter-spacing: 1rpx;
  flex-shrink: 0;
}
.ele-approx {
  font-family: var(--e3-sans);
  font-size: 17rpx;
  color: var(--e3-ink-faint);
  border: 1rpx solid rgba(176, 170, 156, 0.5);
  border-radius: 999rpx;
  padding: 0 10rpx;
  flex-shrink: 0;
}
.ele-l {
  display: block;
  font-family: var(--e3-sans);
  font-size: 22rpx;
  color: var(--e3-ink-soft);
  line-height: 1.55;
  margin-top: 6rpx;
  letter-spacing: 1rpx;
}
.ele-l-locked {
  color: var(--e3-ink-faint);
}
.ele-go {
  color: var(--e3-ink-faint);
  font-size: 30rpx;
  font-family: var(--e3-sans);
  flex-shrink: 0;
}

/* ── 深度报告入口 ── */
.deep-pill {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 28rpx;
  padding: 24rpx 26rpx;
  border-radius: 32rpx;
  background: rgba(201, 169, 124, 0.07);
  border: 1rpx dashed rgba(176, 143, 82, 0.5);
}
.deep-pill-pressed {
  opacity: 0.7;
}
.deep-pill-ic {
  font-size: 26rpx;
  color: var(--e3-gold-deep);
  flex-shrink: 0;
}
.deep-pill-tx {
  flex: 1;
  font-family: var(--e3-sans);
  font-size: 22rpx;
  color: var(--e3-ink-soft);
  letter-spacing: 1rpx;
}
.deep-pill-go {
  font-family: var(--e3-sans);
  font-size: 19rpx;
  color: var(--e3-gold-deep);
  letter-spacing: 2rpx;
  flex-shrink: 0;
}

/* ── 缺失提示 ── */
.bc-note {
  position: relative;
  z-index: 3;
  margin-top: 20rpx;
  text-align: center;
}
.bc-note-tx {
  font-family: var(--e3-sans);
  font-size: 20rpx;
  color: var(--e3-ink-faint);
  letter-spacing: 1rpx;
}
