<!-- pages/moon-card/moon-card.wxml — 月光卡（睡前星语 · 完整版 T4-5） -->
<view class="page">
  <view class="stars-layer"></view>

  <!-- ===== 加载态 ===== -->
  <view wx:if="{{loading}}" class="center-state">
    <text class="loading-text">月光正在为你点亮…</text>
  </view>

  <!-- ===== 错误态 ===== -->
  <view wx:elif="{{pageError}}" class="center-state">
    <text class="error-text">月光暂时迷路了</text>
    <text class="error-hint">{{pageError}}</text>
    <button class="btn-ghost" bindtap="onRetry">重新连接</button>
  </view>

  <!-- ===== 月光卡 ===== -->
  <view wx:else class="card anim-fade-up">
    <!-- 月相 + 日期 -->
    <view class="phase-zone">
      <text class="phase-emoji">{{card.phase.emoji}}</text>
      <text class="phase-label">{{card.phase.label}}</text>
      <text class="card-date">{{card.date}}</text>
    </view>

    <!-- 星语 -->
    <view class="phrase-zone">
      <text class="phrase-title">晚安星语</text>
      <text class="phrase">{{card.phrase}}</text>
    </view>

    <!-- 星光色 + 星光数 -->
    <view class="starlight-zone">
      <view class="color-dot" style="background: {{card.star_color}};"></view>
      <text class="starlight-text">星光色 {{card.star_color}} · 星光数 {{card.star_number}}</text>
    </view>

    <text class="card-note">晚安。月亮替你把今天收尾，星光陪你入睡 ✦</text>

    <!-- ===== 晚安卡分享（T4-5） ===== -->
    <button
      class="btn-share-poster"
      bindtap="onSharePoster"
      disabled="{{sharing}}"
      hover-class="btn-share-poster--active"
    >
      <text class="btn-share-star">✦</text>
      <text>{{sharing ? '晚安卡生成中…' : '分享晚安卡'}}</text>
    </button>

    <!-- ===== 沉淀引导（设计 4.1）：睡前三分钟，给今天记一颗星 ===== -->
    <view class="sink-row" bindtap="goWriteJournal" hover-class="sink-row--active">
      <view class="sink-dot"></view>
      <view class="sink-copy">
        <text class="sink-title">睡前三分钟，给今天记一颗星</text>
        <text class="sink-sub">星光手账 · 写下一日星光</text>
      </view>
      <text class="sink-arrow">›</text>
    </view>
  </view>

  <!-- ===== 晚安卡海报（深空底 · share-poster mode="moon"） ===== -->
  <share-poster
    wx:if="{{posterData}}"
    mode="moon"
    visible="{{showPoster}}"
    moonCardData="{{posterData}}"
    bind:close="onClosePoster"
    bind:share="onShareMoonPosterToFriend"
  />
</view>
