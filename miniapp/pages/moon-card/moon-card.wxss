/* ============================================================
   月光卡（睡前星语 · 最小可用版）— E3 奶油疗愈主题
   ============================================================ */

.page {
  min-height: 100vh;
  background: var(--color-bg);
  background-image: var(--color-bg-gradient);
  padding: 0 var(--spacing-lg, 32rpx) 60rpx;
  position: relative;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* --- 星点底纹（与新月许愿页同款） --- */
.stars-layer {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 0;
}
.stars-layer::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 4rpx;
  height: 4rpx;
  background: transparent;
  border-radius: 50%;
  box-shadow:
    40rpx 80rpx rgba(201,169,124,.16),
    120rpx 180rpx rgba(201,169,124,.12),
    200rpx 50rpx rgba(201,169,124,.18),
    300rpx 250rpx rgba(201,169,124,.10),
    400rpx 120rpx rgba(201,169,124,.14),
    500rpx 80rpx rgba(201,169,124,.12),
    80rpx 400rpx rgba(201,169,124,.14),
    250rpx 500rpx rgba(201,169,124,.10),
    420rpx 380rpx rgba(201,169,124,.14),
    550rpx 600rpx rgba(201,169,124,.10),
    180rpx 700rpx rgba(201,169,124,.12),
    350rpx 800rpx rgba(201,169,124,.10);
}

/* ============================================================
   加载 / 错误态
   ============================================================ */
.center-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 160rpx 40rpx;
}
.loading-text {
  font-size: 26rpx;
  letter-spacing: 4rpx;
  color: var(--color-text-tertiary);
}
.error-text {
  font-size: 32rpx;
  color: var(--color-text-secondary);
  display: block;
}
.error-hint {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  display: block;
  margin: 16rpx 0 32rpx;
  line-height: 1.7;
}
.btn-ghost {
  background: transparent;
  border: 1rpx solid var(--color-card-border);
  color: var(--color-gold-deep-ink);
  border-radius: 999rpx;
  font-size: 26rpx;
  line-height: 76rpx;
  padding: 0 48rpx;
}
.btn-ghost::after { border: none; }

/* ============================================================
   月光卡主体
   ============================================================ */
.card {
  flex: 1;
  margin-top: 48rpx;
  border-radius: 40rpx;
  background: var(--color-surface, #FFFDF8);
  border: 1rpx solid rgba(201, 169, 124, 0.28);
  box-shadow: 0 24rpx 60rpx rgba(61, 58, 54, 0.10);
  padding: 56rpx 40rpx 48rpx;
  text-align: center;
}

.phase-zone {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.phase-emoji {
  font-size: 88rpx;
  line-height: 1.2;
  filter: drop-shadow(0 12rpx 24rpx rgba(201, 169, 124, 0.35));
}
.phase-label {
  margin-top: 16rpx;
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: var(--color-gold-deep-ink);
}
.card-date {
  margin-top: 10rpx;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: var(--color-text-tertiary);
}

.phrase-zone {
  margin-top: 56rpx;
  padding: 0 8rpx;
}
.phrase-title {
  display: block;
  font-size: 24rpx;
  letter-spacing: 6rpx;
  color: var(--color-text-tertiary);
}
.phrase {
  display: block;
  margin-top: 24rpx;
  font-family: var(--font-serif, serif);
  font-size: 40rpx;
  line-height: 1.8;
  letter-spacing: 2rpx;
  color: var(--color-text-primary);
}

.starlight-zone {
  margin-top: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}
.color-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(61, 58, 54, 0.12);
  box-shadow: 0 4rpx 12rpx rgba(201, 169, 124, 0.30);
}
.starlight-text {
  font-size: 24rpx;
  letter-spacing: 1rpx;
  color: var(--color-text-secondary);
}

.card-note {
  display: block;
  margin-top: 48rpx;
  font-size: 22rpx;
  letter-spacing: 3rpx;
  color: var(--color-text-tertiary);
}

/* ============================================================
   晚安卡分享（T4-5）
   ============================================================ */
.btn-share-poster {
  margin-top: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 88rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #F5D48F 0%, #D9AF6B 100%);
  color: #4A3B22;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  box-shadow: 0 12rpx 32rpx rgba(217, 175, 107, 0.35);
}
.btn-share-poster::after { border: none; }
.btn-share-poster--active {
  opacity: 0.85;
  transform: scale(0.98);
}
.btn-share-star {
  font-size: 28rpx;
}

/* ============================================================
   沉淀引导（设计 4.1）：睡前三分钟，给今天记一颗星
   ============================================================ */
.sink-row {
  margin-top: 32rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  background: rgba(250, 246, 239, 0.72);
  border: 1rpx solid rgba(201, 169, 124, 0.30);
}
.sink-row--active {
  background: rgba(250, 246, 239, 0.95);
}
.sink-dot {
  flex: none;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #C9A97C;
  box-shadow: 0 0 12rpx rgba(201, 169, 124, 0.6);
}
.sink-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  text-align: left;
}
.sink-title {
  font-size: 26rpx;
  color: var(--color-text-primary);
  letter-spacing: 1rpx;
}
.sink-sub {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}
.sink-arrow {
  flex: none;
  font-size: 40rpx;
  color: var(--color-gold-deep-ink);
  line-height: 1;
}

/* ============================================================
   入场动画
   ============================================================ */
.anim-fade-up {
  animation: fadeUp 0.5s ease-out both;
}
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}
