/* pages/element-detail/element-detail.wxss — E3 三要素详情（与原型页 06 一致） */
page {
  --e3-cream: #FAF6EF;
  --e3-cream-hi: #FFFDF8;
  --e3-paper: #F2ECDF;
  --e3-pink: #E8C4BE;
  --e3-pink-ink: #B08A82;
  --e3-gold: #C9A97C;
  --e3-gold-deep: #B08F52;
  --e3-line-soft: rgba(201, 169, 124, 0.38);
  --e3-ink: #3D3A36;
  --e3-ink-soft: #8A8478;
  --e3-ink-faint: #B0AA9C;
  --e3-shadow: 0 4rpx 20rpx rgba(61, 58, 54, 0.06);
  --e3-hi: inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
  --e3-serif: 'Songti SC', 'STSong', 'SimSun', 'Noto Serif CJK SC', 'Noto Serif SC', serif;
  --e3-sans: -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif;

  background: #FAF6EF;
  color: #3D3A36;
  font-family: var(--e3-serif);
  font-size: 28rpx;
  line-height: 1.6;
}

.page {
  min-height: 100vh;
  padding: 24rpx 36rpx calc(40rpx + env(safe-area-inset-bottom));
  position: relative;
  box-sizing: border-box;
  background: #FAF6EF;
  overflow: hidden;
}

.wash {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
}
.wash-pink {
  top: -170rpx;
  right: -190rpx;
  width: 560rpx;
  height: 560rpx;
  background: radial-gradient(circle, rgba(232, 196, 190, 0.42) 0%, rgba(232, 196, 190, 0) 66%);
}
.wash-gold {
  left: -200rpx;
  top: 780rpx;
  width: 500rpx;
  height: 500rpx;
  background: radial-gradient(circle, rgba(201, 169, 124, 0.22) 0%, rgba(201, 169, 124, 0) 66%);
}

/* ── 主角：该要素 ── */
.el-hero {
  position: relative;
  z-index: 2;
  text-align: center;
  margin-top: 8rpx;
}
.el-big {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  margin: 0 auto;
  background: radial-gradient(circle at 32% 28%, rgba(232, 196, 190, 0.55), rgba(201, 169, 124, 0.32));
  border: 1rpx solid rgba(201, 169, 124, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  color: var(--e3-pink-ink);
  box-shadow: 0 24rpx 52rpx rgba(176, 138, 130, 0.22), var(--e3-hi);
}
.el-h3 {
  display: block;
  font-size: 38rpx;
  letter-spacing: 8rpx;
  margin-top: 24rpx;
  font-weight: 500;
  color: var(--e3-ink);
}
.el-line {
  display: block;
  font-family: var(--e3-sans);
  font-size: 23rpx;
  color: var(--e3-ink-soft);
  letter-spacing: 2rpx;
  margin-top: 14rpx;
  line-height: 1.7;
}

/* ── 小节标题（天赋 / 阴影 / 今年主题） ── */
.sec-label {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin: 36rpx 0 16rpx;
}
.sec-line {
  width: 40rpx;
  height: 2rpx;
  background: rgba(201, 169, 124, 0.5);
}
.sec-text {
  font-family: var(--e3-sans);
  font-size: 22rpx;
  letter-spacing: 6rpx;
  color: var(--e3-gold-deep);
}
.card-soft {
  position: relative;
  z-index: 2;
  background: var(--e3-cream-hi);
  border: 1rpx solid rgba(201, 169, 124, 0.38);
  border-radius: 32rpx;
  box-shadow: var(--e3-shadow), var(--e3-hi);
  padding: 28rpx 30rpx;
  margin-bottom: 4rpx;
}
.el-para {
  display: block;
  font-family: var(--e3-sans);
  font-size: 24rpx;
  line-height: 1.95;
  letter-spacing: 1rpx;
  color: var(--e3-ink-soft);
}
.el-para-theme {
  color: var(--e3-ink);
  font-family: var(--e3-serif);
  font-size: 25rpx;
}

/* ── 深度报告付费占位（19.9 / 29.9 / 39.9） ── */
.price-card {
  position: relative;
  z-index: 2;
  background: var(--e3-cream-hi);
  border: 1rpx solid rgba(176, 143, 82, 0.4);
  border-radius: 36rpx;
  padding: 8rpx 28rpx 24rpx;
  margin-top: 20rpx;
  box-shadow: var(--e3-shadow);
}
.pc-t {
  display: block;
  font-size: 26rpx;
  letter-spacing: 4rpx;
  color: var(--e3-ink);
  text-align: center;
  margin: 20rpx 0 8rpx;
}
.pc-s {
  display: block;
  font-family: var(--e3-sans);
  font-size: 21rpx;
  color: var(--e3-ink-faint);
  text-align: center;
  letter-spacing: 3rpx;
  margin-bottom: 12rpx;
}
.tier-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 4rpx;
  border-top: 1rpx solid rgba(201, 169, 124, 0.18);
}
.tier-row-pressed {
  opacity: 0.7;
}
.tier-n {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.tier-name {
  font-size: 25rpx;
  letter-spacing: 2rpx;
  color: var(--e3-ink);
  font-weight: 500;
}
.tier-desc {
  font-family: var(--e3-sans);
  font-size: 21rpx;
  color: var(--e3-ink-faint);
  margin-top: 4rpx;
  letter-spacing: 1rpx;
}
.tier-price {
  font-family: var(--e3-serif);
  font-size: 32rpx;
  color: var(--e3-gold-deep);
  font-style: normal;
  flex-shrink: 0;
}
.tier-yuan {
  font-size: 20rpx;
  font-family: var(--e3-sans);
}
.tier-btn {
  width: 112rpx;
  height: 68rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, var(--e3-gold), var(--e3-gold-deep));
  color: #FFFDF8;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* ── CTA / 空态 ── */
.cta {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 999rpx;
  margin-top: 28rpx;
  font-size: 25rpx;
  letter-spacing: 6rpx;
  transition: transform 0.15s ease;
}
.cta-pressed {
  transform: scale(0.975);
}
.cta-ghost {
  background: transparent;
  border: 1rpx solid rgba(201, 169, 124, 0.38);
  color: var(--e3-gold-deep);
  box-shadow: var(--e3-hi);
}
.empty-state {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  margin-top: 120rpx;
}
.empty-text {
  font-size: 30rpx;
  letter-spacing: 4rpx;
  color: var(--e3-ink);
}
.empty-hint {
  font-family: var(--e3-sans);
  font-size: 22rpx;
  color: var(--e3-ink-faint);
  letter-spacing: 2rpx;
}

/* ── 开发 05：真实星盘增强（角色名行 · 近似徽章 · 权益提示 · 引导按钮）── */
.el-name-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  margin-top: 16rpx;
}
.el-chip {
  font-family: var(--e3-sans);
  font-size: 18rpx;
  color: var(--e3-gold-deep);
  background: rgba(201, 169, 124, 0.16);
  border-radius: 999rpx;
  padding: 2rpx 12rpx;
  letter-spacing: 1rpx;
}
.el-approx {
  font-family: var(--e3-sans);
  font-size: 17rpx;
  color: var(--e3-ink-faint);
  border: 1rpx solid rgba(176, 170, 156, 0.5);
  border-radius: 999rpx;
  padding: 0 10rpx;
}
.pc-head {
  text-align: center;
}
.pc-entitle {
  display: block;
  font-family: var(--e3-sans);
  font-size: 20rpx;
  color: var(--e3-pink-ink);
  letter-spacing: 1rpx;
  margin: 4rpx 0 12rpx;
}
.empty-cta {
  margin-top: 28rpx;
}
