/* ============================================================
   满月复盘 — E3 奶油疗愈（原型页 14）
   主角：AI 复盘卡（满月动画 + 愿望回望三态 + 温柔复盘文）
   ============================================================ */

.page {
  min-height: 100vh;
  background: var(--color-bg);
  background-image: var(--color-bg-gradient);
  padding: 0 var(--spacing-lg, 32rpx) 60rpx;
  position: relative;
  box-sizing: border-box;
}

.stars-layer {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 0;
}
.stars-layer::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 4rpx;
  height: 4rpx;
  background: transparent;
  border-radius: 50%;
  box-shadow:
    40rpx 80rpx rgba(201,169,124,.16),
    120rpx 180rpx rgba(201,169,124,.12),
    200rpx 50rpx rgba(201,169,124,.18),
    300rpx 250rpx rgba(201,169,124,.10),
    400rpx 120rpx rgba(201,169,124,.14),
    500rpx 80rpx rgba(201,169,124,.12),
    80rpx 400rpx rgba(201,169,124,.14),
    250rpx 500rpx rgba(201,169,124,.10),
    420rpx 380rpx rgba(201,169,124,.14),
    550rpx 600rpx rgba(201,169,124,.10);
}

/* ============================================================
   加载态
   ============================================================ */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 240rpx;
}
.loading-moon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 32% 30%, #E8C4BE, #C9A97C);
  box-shadow: 0 0 60rpx rgba(201, 169, 124, 0.5);
  animation: moonBreathe 3s ease-in-out infinite;
}
@keyframes moonBreathe {
  0%, 100% { transform: scale(1); opacity: .85; }
  50% { transform: scale(1.08); opacity: 1; }
}
.loading-text {
  margin-top: 32rpx;
  font-size: 24rpx;
  letter-spacing: 3rpx;
  color: var(--color-text-tertiary);
}

/* ============================================================
   错误态
   ============================================================ */
.error-state {
  text-align: center;
  padding: 200rpx 40rpx;
}
.error-text {
  font-size: 32rpx;
  color: var(--color-text-secondary);
  display: block;
}
.error-hint {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  display: block;
  margin: 16rpx 0 32rpx;
}
.btn-ghost {
  background: transparent;
  border: 1rpx solid var(--color-card-border);
  color: var(--color-gold-deep-ink);
  border-radius: 999rpx;
  font-size: 26rpx;
  line-height: 76rpx;
  padding: 0 48rpx;
}

/* ============================================================
   满月仪式头
   ============================================================ */
.moon-head {
  text-align: center;
  padding-top: 48rpx;
}
.full-moon {
  position: relative;
  width: 152rpx;
  height: 152rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: radial-gradient(circle at 38% 34%, #F5E4D2, #E8C4BE 55%, #DCA9A1);
  box-shadow: 0 0 70rpx rgba(201, 169, 124, 0.6);
  animation: moonBreathe 5s ease-in-out infinite;
}
.full-moon-glow {
  position: absolute;
  inset: -44rpx;
  border-radius: 50%;
  background: radial-gradient(closest-side, rgba(201,169,124,.38), rgba(201,169,124,0) 72%);
  pointer-events: none;
}
.moon-phase-line {
  display: block;
  margin-top: 30rpx;
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: var(--color-gold-deep-ink);
}

/* ============================================================
   空态
   ============================================================ */
.review-empty {
  text-align: center;
  margin-top: 80rpx;
  padding: 0 40rpx;
}
.review-empty-title {
  display: block;
  font-size: 30rpx;
  letter-spacing: 3rpx;
  color: var(--color-text-primary);
}
.review-empty-hint {
  display: block;
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.8;
  color: var(--color-text-tertiary);
}
.review-empty .cta-btn {
  margin-top: 48rpx;
}

/* ============================================================
   AI 复盘卡（主角）
   ============================================================ */
.review-card {
  margin-top: 36rpx;
  border-radius: 40rpx;
  padding: 36rpx 32rpx;
  background: linear-gradient(170deg, #FFFDF8, #F2ECDF);
  border: 1rpx solid rgba(201, 169, 124, 0.42);
  box-shadow: 0 32rpx 68rpx rgba(61, 58, 54, 0.1);
  position: relative;
  overflow: hidden;
}
.review-card::before {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -60rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: radial-gradient(closest-side, rgba(232,196,190,.28), rgba(232,196,190,0) 72%);
  pointer-events: none;
}
.review-card-head {
  text-align: center;
}
.review-card-title {
  display: block;
  font-family: var(--font-serif, serif);
  font-size: 34rpx;
  letter-spacing: 6rpx;
  color: var(--color-text-primary);
}
.review-card-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 21rpx;
  letter-spacing: 2rpx;
  color: var(--color-text-tertiary);
}

/* --- 愿望回望三态 --- */
.rv-status {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx dashed rgba(201, 169, 124, 0.35);
}
.rv-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  margin-top: 4rpx;
}
.rv-icon.ok {
  background: rgba(176, 143, 82, 0.18);
  color: var(--color-gold-deep-ink);
  border: 1rpx solid rgba(176, 143, 82, 0.4);
}
.rv-icon.go {
  background: rgba(232, 196, 190, 0.3);
  color: #B08A82;
  border: 1rpx solid rgba(176, 138, 130, 0.35);
}
.rv-icon.no {
  background: rgba(176, 170, 156, 0.18);
  color: var(--color-text-tertiary);
  border: 1rpx solid rgba(176, 170, 156, 0.35);
}
.rv-text {
  flex: 1;
  min-width: 0;
}
.rv-wish {
  display: block;
  font-size: 27rpx;
  letter-spacing: 1rpx;
  color: var(--color-text-primary);
}
.rv-status-label {
  display: inline-block;
  margin-top: 6rpx;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: var(--color-gold-deep-ink);
  opacity: .8;
}
.rv-note {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--color-text-secondary);
}

/* --- AI 复盘文 --- */
.rv-essay {
  margin-top: 32rpx;
  padding-top: 28rpx;
  border-top: 1rpx dashed rgba(201, 169, 124, 0.35);
  font-size: 25rpx;
  line-height: 2;
  letter-spacing: 1rpx;
  color: var(--color-text-secondary);
  text-align: center;
}

/* --- tips --- */
.rv-tips {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx dashed rgba(201, 169, 124, 0.35);
}
.rv-tips-label {
  display: block;
  font-size: 21rpx;
  letter-spacing: 3rpx;
  color: var(--color-gold-deep-ink);
}
.rv-tip {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 14rpx;
}
.rv-tip-dot {
  color: var(--color-gold);
  font-size: 20rpx;
  line-height: 1.9;
  flex-shrink: 0;
}
.rv-tip-text {
  font-size: 23rpx;
  line-height: 1.8;
  color: var(--color-text-secondary);
}

/* ============================================================
   操作区
   ============================================================ */
.review-actions {
  margin-top: 36rpx;
}
.cta-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #C9A97C, #B08F52);
  color: #FFFDF8;
  font-size: 30rpx;
  letter-spacing: 6rpx;
  box-shadow: 0 12rpx 32rpx rgba(176, 143, 82, 0.35);
  border: none;
  font-family: var(--font-serif, serif);
}
.cta-btn::after { border: none; }
.cta-btn--pink {
  background: linear-gradient(135deg, #DCA9A1, #B08A82);
  box-shadow: 0 12rpx 32rpx rgba(176, 138, 130, 0.32);
}
.link-btn {
  background: transparent;
  border: none;
  color: var(--color-gold-deep-ink);
  font-size: 23rpx;
  letter-spacing: 3rpx;
  line-height: 84rpx;
  width: 100%;
  text-align: center;
}
.link-btn::after { border: none; }
.link-btn[disabled] {
  color: var(--color-text-tertiary);
}
