<!-- pages/daily-card/daily-card.wxml -->
<!-- ===== Loading skeleton ===== -->
<view class="page" wx:if="{{pageLoading}}">
  <view class="skeleton-card-area">
    <view class="skeleton skeleton--block" style="width:420rpx;height:590rpx;margin:40rpx auto 0;border-radius:24rpx;"></view>
  </view>
  <view class="skeleton-teaching-area">
    <view class="skeleton skeleton--title" style="width:50%;margin:60rpx auto 24rpx;"></view>
    <view class="skeleton skeleton--text-lg"></view>
    <view class="skeleton skeleton--text"></view>
    <view class="skeleton skeleton--text-sm" style="width:80%;"></view>
    <view class="skeleton skeleton--text" style="margin-top:32rpx;"></view>
    <view class="skeleton skeleton--text"></view>
  </view>
</view>

<!-- ===== Error state ===== -->
<view class="page" wx:elif="{{pageError}}">
  <view class="error-state">
    <view class="error-icon-area">
      <image class="error-icon-img" src="/images/icons/start_reading_64.png" mode="aspectFit" aria-label="连接错误" />
    </view>
    <text class="error-title">星光暂时无法连接</text>
    <text class="error-desc">{{pageError}}</text>
    <button class="btn btn-glow btn--sm" bindtap="onRetry">重新连接</button>
  </view>
</view>

<!-- ===== Main content ===== -->
<view class="page" wx:else>
  <!-- E3 奶油底色氛围光斑（与首页气质统一） -->
  <view class="wash wash-pink"></view>
  <view class="wash wash-gold"></view>

  <!-- ===== Card flip area ===== -->
  <view class="card-flip-section">
    <!-- Bugfix: bindtap 挂在 scene 容器上（背面前 z-index 高于正面，点击正面绑定的
         onCardTap 永远收不到事件 → 翻牌失效/牌面图永远不显示）。翻牌提示也从
         opacity:0 的正面移出，作为 scene 子级盖在牌背上方，保证首屏可见可点。 -->
    <view
      class="card-flip-scene
      {{isAnimating ? 'card-flip-animating' : ''}}
      {{showGlow ? 'card-glow-revealed' : ''}}
    "
      bindtap="onCardTap"
      role="button"
      aria-label="翻开今日塔罗牌"
      hover-class="card-flip-pressed"
    >
      <!-- Card back (face-down) -->
      <view class="card-face card-back {{backHidden ? 'card-face--hidden' : ''}}">
        <view class="card-back-ornament">
          <view class="card-back-ring card-back-ring--outer"></view>
          <view class="card-back-ring card-back-ring--inner"></view>
          <view class="card-back-star">✦</view>
        </view>
      </view>

      <!-- Card front (face-up: actual card image) -->
      <view class="card-face card-front {{frontVisible ? 'card-face--visible' : ''}}">
        <view class="card-img-wrap {{cardImgLoaded ? 'card-img-wrap--loaded' : ''}} {{cardImgError ? 'card-img-wrap--error' : ''}}">
          <image
            wx:if="{{!cardImgError}}"
            class="card-img-inner"
            src="{{dailyCard.imagePath}}"
            mode="widthFix"
            bindload="onCardImgLoad"
            binderror="onCardImgError"
            aria-label="今日塔罗 — {{dailyCard.name_zh}}"
          />
          <view wx:if="{{cardImgError}}" class="card-img-fallback-text">
            <text class="fallback-cardname">{{dailyCard.name_zh}}</text>
            <text class="fallback-hint">图片暂不可用</text>
          </view>
        </view>
      </view>

      <!-- Tap hint (before flip) — scene 子级：牌背/正面之上均可见可点 -->
      <view class="card-tap-hint {{isAnimating || isFlipped ? 'card-tap-hint--hidden' : ''}}" catchtap="onCardTap">
        <view class="card-tap-hint-inner">
          <text class="card-tap-hint-text">轻触翻牌</text>
          <text class="card-tap-hint-sub">今日的启示等待着你</text>
        </view>
      </view>
    </view>

    <!-- Card name below -->
    <view class="card-name-section {{showTeaching ? 'card-name-section--visible' : ''}}">
      <text class="card-name-zh">{{dailyCard.name_zh}}</text>
      <text class="card-name-en">{{dailyCard.name_en}}</text>
      <view class="card-meta-tags">
        <text class="badge badge--gold" wx:if="{{dailyCard.arcana === 'major'}}">大牌</text>
        <text class="badge badge--gold" wx:elif="{{dailyCard.suit}}">{{dailyCard.suit}}</text>
        <text class="badge badge--lavender">{{dailyCard.card_number}}</text>
      </view>
      <!-- v2.1: Zodiac sign badge -->
      <view wx:if="{{zodiacSign}}" class="zodiac-badge">
        <text class="zodiac-badge-text">{{zodiacSign}}今日运势</text>
      </view>
    </view>
  </view>

  <!-- ===== Teaching snippet: compact gold-accented card after flip ===== -->
  <view class="teaching-snippet" wx:if="{{showTeaching && teachingSymbol}}">
    <view class="ts-header">
      <text class="ts-icon">✦</text>
      <text class="ts-title">牌面小知识</text>
    </view>
    <text class="ts-symbol">{{teachingSymbol}}</text>
    <text class="ts-life">{{teachingLife}}</text>
    <!-- UX 修复: 痛点#2 — 个性化关键词胶囊（keywords_upright 渲染为胶囊标签行，详解折叠时也可见） -->
    <view wx:if="{{cardKeywordsList.length > 0}}" class="snippet-keywords">
      <view class="keyword-tag" wx:for="{{cardKeywordsList}}" wx:key="index" wx:for-item="kw">
        <text class="keyword-tag-text">{{kw}}</text>
      </view>
    </view>
  </view>

  <!-- ===== Teaching area (revealed after flip, 详解区紧跟牌面小知识) ===== -->
  <view class="teaching-area {{showTeaching ? 'teaching-area--visible' : ''}}">

    <!-- 折叠头：详解 ▾（点击展开） -->
    <view
      class="teaching-toggle"
      wx:if="{{teaching && !teachingLoading && !teachingError}}"
      bindtap="onToggleTeaching"
      role="button"
      aria-label="{{teachingExpanded ? '收起详解' : '展开详解'}}"
    >
      <text class="teaching-toggle-title">详解</text>
      <text class="teaching-toggle-arrow">{{teachingExpanded ? '▴' : '▾'}}</text>
    </view>

    <view wx:if="{{teachingExpanded}}" class="teaching-toggle-body">

    <!-- Teaching loading -->
    <view wx:if="{{teachingLoading}}" class="teaching-loading">
      <view class="skeleton skeleton--title" style="width:40%;margin:0 auto 24rpx;"></view>
      <view class="skeleton skeleton--text"></view>
      <view class="skeleton skeleton--text"></view>
      <view class="skeleton skeleton--text-sm" style="width:70%;"></view>
    </view>

    <!-- Teaching error -->
    <view wx:elif="{{teachingError}}" class="teaching-error">
      <text class="teaching-error-text">教学加载失败</text>
      <button class="btn btn-ghost btn--sm" bindtap="onRetryTeaching">重试</button>
    </view>

    <!-- Teaching content -->
    <view wx:elif="{{teaching}}" class="teaching-content">

      <!-- Section 1: 符号解读 -->
      <view class="teaching-section anim-fade-up anim-stagger-1">
        <view class="teaching-section-header">
          <image class="teaching-section-icon" src="/images/icons/about_64.png" mode="aspectFit" lazy-load aria-label="符号解读" />
          <text class="teaching-section-title">符号解读</text>
        </view>
        <view class="teaching-section-body">
          <view
            class="symbol-item"
            wx:for="{{teaching.symbols}}"
            wx:key="index"
            wx:for-item="symbol"
          >
            <view class="symbol-dot"></view>
            <view class="symbol-content">
              <text class="symbol-name">{{symbol.name}}</text>
              <text class="symbol-desc">{{symbol.description}}</text>
            </view>
          </view>
          <!-- Keywords tags -->
          <view wx:if="{{teaching.keywords_learning && teaching.keywords_learning.length > 0}}" class="keywords-wrap">
            <view
              class="keyword-tag"
              wx:for="{{teaching.keywords_learning}}"
              wx:key="index"
              wx:for-item="kw"
            >
              <text class="keyword-tag-text">{{kw}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- Section 2: 典故故事 -->
      <view class="teaching-section anim-fade-up anim-stagger-2">
        <view class="teaching-section-header">
          <image class="teaching-section-icon" src="/images/icons/diary_64.png" mode="aspectFit" lazy-load aria-label="典故故事" />
          <text class="teaching-section-title">典故故事</text>
        </view>
        <view class="teaching-section-body">
          <text class="story-text">{{teaching.story}}</text>
        </view>
      </view>

      <!-- Section 3: 生活关联 -->
      <view class="teaching-section anim-fade-up anim-stagger-3">
        <view class="teaching-section-header">
          <image class="teaching-section-icon" src="/images/icons/theme_general_64.png" mode="aspectFit" lazy-load aria-label="生活关联" />
          <text class="teaching-section-title">生活关联</text>
        </view>
        <view class="teaching-section-body">
          <text class="life-connection-text">{{teaching.life_connection}}</text>
          <view wx:if="{{teaching.element_association}}" class="element-badge-wrap">
            <text class="badge badge--lavender">关联元素：{{teaching.element_association}}</text>
          </view>
        </view>
      </view>
    </view>
    </view>
  </view>

  <!-- ===== 今日心情（详解之后，记录此刻感受） ===== -->
  <view class="diary-section {{showTeaching ? 'diary-section--visible' : ''}}">
    <view class="divider"></view>

    <view wx:if="{{diarySaved}}" class="diary-saved-state">
      <text class="diary-saved-text">今日心情已记录</text>
    </view>

    <view wx:else class="diary-entry-area">
      <view class="diary-entry-header">
        <image class="diary-entry-icon" src="/images/icons/diary_64.png" mode="aspectFit" lazy-load aria-label="今日心情" />
        <text class="diary-entry-title">今日心情</text>
      </view>
      <textarea
        class="diary-input"
        placeholder="这张牌让你想到了什么？记录此刻的感受..."
        value="{{diaryText}}"
        bindinput="onDiaryInput"
        maxlength="500"
      />
      <text class="diary-char-count">{{diaryText.length}}/500</text>
      <button bindtap="onDiarySave"
        class="btn btn-primary btn--full btn--sm"
        disabled="{{diarySaving || !diaryText.trim()}}"
      >
        {{diarySaving ? '保存中...' : '保存心情'}}
      </button>
    </view>
  </view>

  <!-- ===== Streak encouragement banner（P2-2：可点击 → 签到页） ===== -->
  <view class="streak-banner" wx:if="{{dailyStreak >= 0}}" bindtap="onGoCheckin" role="button" aria-label="查看签到与连续打卡">
    <view class="streak-progress-track">
      <view class="streak-progress-fill" style="width: {{milestoneProgress}}%"></view>
    </view>
    <text class="streak-text">{{streakEncouragement}}</text>
    <text class="streak-hint" wx:if="{{streakHint}}">{{streakHint}}</text>
    <text class="streak-cta">去签到 →</text>
  </view>

  <!-- ===== 收集进度 — 页尾一行小字（P2-2：移出首屏） ===== -->
  <view class="collect-footer">
    <text class="collect-footer-text">收集 {{collectedCount}}/{{MAJOR_ARCANA_TOTAL}} · 大牌</text>
  </view>

  <!-- Back to Home removed — native nav bar provides back button -->

  <!-- ===== Push subscription prompt (one-time, gentle) ===== -->
  <view class="push-prompt {{showPushPrompt ? 'push-prompt--visible' : ''}}" wx:if="{{showPushPrompt && !pushSubscribed}}">
    <view class="push-prompt-card">
      <view class="push-prompt-header">
        <image class="push-prompt-icon" src="/images/icons/sparkle_64.png" mode="aspectFit" aria-label="每日推送提醒" />
        <text class="push-prompt-title">每日推送提醒</text>
      </view>
      <text class="push-prompt-desc">每天自动推送今日塔罗牌，不错过每一份星光指引</text>
      <view class="push-prompt-actions">
        <button class="push-prompt-btn push-prompt-btn--accept" bindtap="onAcceptPush">开启推送 ✦</button>
        <button class="push-prompt-btn push-prompt-btn--dismiss" bindtap="onDismissPush">暂不需要</button>
      </view>
    </view>
  </view>

  <!-- Bottom spacer for safe area -->
  <view class="safe-bottom"></view>
</view>
