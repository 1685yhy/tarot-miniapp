<!-- pages/index/index.wxml -->
<!-- 星光映照 · E3 奶油疗愈版（真实水彩插画） -->

<!-- 日期格式化（装饰性日期行 · 与原型 date-row 对应） -->
<wxs module="d">
var MONTHS = ['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC'];
var DAYS = ['SUNDAY','MONDAY','TUESDAY','WEDNESDAY','THURSDAY','FRIDAY','SATURDAY'];
function fmtDate() {
  var now = getDate();
  return MONTHS[now.getMonth()] + ' ' + now.getDate() + ' · ' + DAYS[now.getDay()] + ' · ' + now.getFullYear();
}
module.exports = { fmtDate: fmtDate };
</wxs>

<!-- ===== 加载骨架 ===== -->
<view class="page" wx:if="{{pageLoading}}">
  <view class="skeleton skeleton--circle" style="margin:120rpx auto 40rpx"></view>
  <view class="skeleton skeleton--text" style="width:60%;margin:0 auto"></view>
  <view class="skeleton skeleton--text-sm" style="width:40%;margin:12rpx auto 60rpx"></view>
  <view class="skeleton skeleton--block" style="width:480rpx;height:680rpx;margin:0 auto 40rpx;border-radius:32rpx;"></view>
  <view class="skeleton skeleton--text" style="width:30%;margin-bottom:20rpx"></view>
  <view class="skeleton-grid-3">
    <view class="skeleton skeleton--card-sm"></view>
    <view class="skeleton skeleton--card-sm"></view>
    <view class="skeleton skeleton--card-sm"></view>
    <view class="skeleton skeleton--card-sm"></view>
    <view class="skeleton skeleton--card-sm"></view>
    <view class="skeleton skeleton--card-sm"></view>
  </view>
</view>

<!-- ===== 错误状态 ===== -->
<view class="page" wx:elif="{{pageError}}">
  <view class="error-state">
    <text class="error-text">连接中断</text>
    <text class="error-hint">{{pageError}}</text>
    <button class="btn-ghost" bindtap="onRetry">重新连接</button>
  </view>
</view>

<!-- ===== 主内容 ===== -->
<view class="page" wx:else>
  <!-- E3 奶油底色氛围光斑（真实插画之外仅作底色） -->
  <view class="wash wash-pink"></view>
  <view class="wash wash-gold"></view>

  <!-- ===== Zone 1: 首屏 ===== -->
  <view class="hero-zone">
    <!-- 右下角淡粉水彩小花点缀（真实资产 · 50% 透明 · 从CTA后探出） -->
    <view class="hint-flower">
      <image class="hint-flower-img" src="/assets/web/hint-flower.jpg" mode="aspectFill" aria-label="淡粉水彩小花" />
    </view>

    <!-- E3 顶部 — 微字 / 品牌 / 日期 / 问候语 / 每日状态徽章 -->
    <view class="e3-head anim-fade-in-up-1">
      <text class="microlabel">STARLIT · 每日一牌</text>
      <text class="brand">星光映照</text>
      <view class="date-row">
        <view class="gold-dot"></view>
        <text class="date-text">{{d.fmtDate()}}</text>
      </view>

      <!-- v2.1: Time-of-day greeting（保留现有逻辑 · 视觉降级为一行小字） -->
      <text wx:if="{{greetingText}}" class="greeting-text anim-greeting-fade" key="{{greetingAnimKey}}">{{greetingText}}</text>

      <!-- Daily reminder badge（保留现有逻辑 · 提醒徽章改静态，不脉冲） -->
      <view wx:if="{{hasDrawnToday}}" class="daily-updated-badge anim-slide-up">✓ 今日运势已更新</view>
      <view wx:elif="{{showReminder && !dailyCard}}" class="daily-reminder-badge">今日运势待开启</view>
    </view>

    <!-- 中央大牌面 — 真实月亮水彩牌（2:3 竖卡 cover 裁切） -->
    <view class="daily-card-area anim-fade-in-up-2">

      <!-- BEFORE DRAW — 月亮牌静候轻触 -->
      <view class="daily-card-wrap paint-wrap {{!hasDrawnToday && !dailyCard ? 'card-ready' : ''}}" wx:if="{{!dailyCard && !dailyCardRestoring}}" bindtap="drawDailyCard" animation="{{cardAnimData}}" role="button" aria-label="翻开今日之牌">
        <view class="painting art card-featured">
          <!-- Ripple effect container（保留 rippleActive 逻辑） -->
          <view class="ripple-box">
            <view class="ripple-circle {{rippleActive?'ripple-run':''}}"></view>
          </view>
          <!-- 真实月亮水彩大牌面（600×600 原图 cover 裁 2:3） -->
          <image class="paint-img" src="/assets/web/moon-card.jpg" mode="aspectFill" aria-label="月亮与安睡兔子的水彩插画" />
          <!-- 金色微光点缀 -->
          <text class="paint-spark">✦</text>
          <!-- 轻触提示（shaking 逻辑保留 · 卡面即唯一 CTA） -->
          <view class="card-body {{shaking?'card-shake':''}}">
            <text class="card-hint-big">轻触翻开今日牌面</text>
            <text class="card-hint-sm">开启今日指引</text>
          </view>
        </view>
      </view>

      <!-- RESTORING — 重新拉取今日牌面时的骨架 -->
      <view class="daily-card-wrap paint-wrap" wx:elif="{{dailyCardRestoring}}">
        <view class="painting art daily-card-panel">
          <view class="skeleton skeleton--block" style="width:440rpx;height:660rpx;margin:0 auto 24rpx;border-radius:32rpx;"></view>
          <view class="skeleton skeleton--title" style="width:40%;margin:0 auto 12rpx;"></view>
          <view class="skeleton skeleton--text-sm" style="width:55%;margin:0 auto;"></view>
        </view>
      </view>

      <!-- AFTER DRAW — 已抽牌面：真实牌面 + 牌名 + CTA -->
      <view class="daily-card-wrap paint-wrap {{dailyCardFlipped ? 'daily-card--flipped' : ''}}" wx:else bindtap="onDailyCardTap" data-today-flipped="{{dailyCardFlipped}}" role="button" aria-label="查看今日卡牌详解">
        <view class="painting art daily-card-panel">
          <!-- Sparkle particles（仅未学习时） -->
          <view wx:if="{{!dailyCardFlipped}}" class="sparkle-field">
            <view class="sparkle s1"></view>
            <view class="sparkle s2"></view>
            <view class="sparkle s3"></view>
          </view>

          <!-- 牌面缩略（cover 裁 2:3） -->
          <view class="daily-card-thumb-wrap {{dailyCardImgError ? 'daily-card-thumb-error' : ''}}">
            <image wx:if="{{dailyCard.imagePath && !dailyCardImgError}}" class="daily-card-thumb" src="{{dailyCard.imagePath}}" mode="aspectFill" binderror="onDailyCardImgError" aria-label="今日塔罗 — {{dailyCard.name_cn || dailyCard.name_zh || '每日一牌'}}" />
            <view wx:elif="{{dailyCardImgError}}" class="daily-card-thumb-fallback">
              <text class="thumb-fallback-name">{{dailyCard.name_zh}}</text>
            </view>
            <view wx:else class="daily-card-thumb-fallback">
              <!-- no image path yet -->
            </view>
          </view>

          <!-- Flipped badge -->
          <view wx:if="{{dailyCardFlipped}}" class="daily-card-badge">已学习 ✓</view>
        </view>

        <!-- 牌名（衬线） -->
        <text class="title-4 daily-card-name">{{dailyCard.name_zh}}</text>

        <!-- CTA text -->
        <text wx:if="{{!dailyCardFlipped}}" class="body-sm daily-card-cta">点击学习这张牌 ✦</text>
        <text wx:else class="body-xs daily-card-revisit">点击回顾今日学习</text>
      </view>

      <!-- 每日一牌打卡 — 保存今日卡牌（保留现有逻辑） -->
      <view wx:if="{{dailyCard && dailyCardFlipped}}" class="daily-share-link" bindtap="onShareDailyCard" role="button" aria-label="保存今日卡牌">
        <text>保存今日卡牌 ✦</text>
      </view>

      <!-- 明日之牌预告 — 回流钩子（抽牌后显示 · 不展示具体牌面，制造期待） -->
      <view wx:if="{{dailyCard}}" class="tomorrow-hint" bindtap="onTomorrowHintTap" role="button" aria-label="明日之牌预告">
        <text class="tomorrow-hint-text">明日之牌 · 待明日揭晓</text>
      </view>

    </view>

    <!-- 牌下衬线牌语 -->
    <view class="phrase anim-fade-in-up-2" wx:if="{{!dailyCard && !dailyCardRestoring}}">
      <text class="phrase-text">月亮牌 · 今晚允许自己慢下来</text>
    </view>

  </view>

  <!-- ===== Zone 2: 滚动区 ===== -->

  <!-- 牌阵（唯一主 CTA 之后 · 首屏可见 · 标题行右侧带免费次数小字） -->
  <view class="section anim-fade-in-up-3">
    <view class="spread-head-row">
      <view class="section-head">
        <view class="sec-line"></view>
        <view class="sec-dot"></view>
        <text class="section-title">选择牌阵</text>
        <view class="sec-dot"></view>
        <view class="sec-line"></view>
      </view>
      <!-- 免费次数小字（并入标题行右侧 · 保留原数据绑定） -->
      <view wx:if="{{!isMember}}" class="spread-quota">
        <text wx:if="{{freeReadingsUsed < freeReadingsTotal}}" class="quota-text">今日免费 {{freeReadingsUsed}}/{{freeReadingsTotal}}</text>
        <text wx:elif="{{freeReadingsUsed >= freeReadingsTotal}}" class="quota-text quota-text--exhausted">今日次数已用完</text>
      </view>
    </view>
    <view class="spread-grid-2">
      <view class="card-interactive spread-card" bindtap="navigateToReading" data-type="three_card" animation="{{spreadAnimData[0]}}" role="button" aria-label="选择三牌占卜牌阵" hover-class="card-pressed" hover-stay-time="60">
        <view class="spread-tag spread-tag-free">免费</view>
        <image class="spread-icon" src="/images/icons/theme_general_64.png" mode="aspectFit" lazy-load aria-label="三牌占卜" />
        <text class="body-sm">三牌占卜</text>
        <text class="body-xs">过去·现在·未来</text>
      </view>
      <view class="card-interactive spread-card" bindtap="navigateToReading" data-type="triangle" animation="{{spreadAnimData[1]}}" role="button" aria-label="选择恋人三角牌阵" hover-class="card-pressed" hover-stay-time="60">
        <view class="spread-tag spread-tag-premium">会员</view>
        <image class="spread-icon" src="/images/icons/theme_love_64.png" mode="aspectFit" lazy-load aria-label="恋人三角" />
        <text class="body-sm">恋人三角</text>
        <text class="body-xs">感情关系深度解读</text>
        <view class="spread-theme-chip spread-theme-chip--love">爱情</view>
      </view>
      <view class="card-interactive spread-card" bindtap="navigateToReading" data-type="celtic_cross" animation="{{spreadAnimData[2]}}" role="button" aria-label="选择凯尔特十字牌阵" hover-class="card-pressed" hover-stay-time="60">
        <view class="spread-tag spread-tag-premium">会员</view>
        <image class="spread-icon" src="/images/icons/theme_general_64.png" mode="aspectFit" lazy-load aria-label="凯尔特十字" />
        <text class="body-sm">凯尔特十字</text>
        <text class="body-xs">全方位综合解牌</text>
      </view>
      <view class="card-interactive spread-card" bindtap="navigateToReading" data-type="career" animation="{{spreadAnimData[3]}}" role="button" aria-label="选择事业牌阵" hover-class="card-pressed" hover-stay-time="60">
        <view class="spread-tag spread-tag-premium">会员</view>
        <image class="spread-icon" src="/images/icons/theme_career_64.png" mode="aspectFit" lazy-load aria-label="事业牌阵" />
        <text class="body-sm">事业牌阵</text>
        <text class="body-xs">职场方向与机遇</text>
        <view class="spread-theme-chip spread-theme-chip--career">事业</view>
      </view>
    </view>
    <view class="card-interactive more-spreads" bindtap="goToAllSpreads" animation="{{spreadAnimData[4]}}" role="button" aria-label="查看更多牌阵" hover-class="card-pressed" hover-stay-time="60">
      <text class="more-text anim-gentle-pulse">查看更多 · 共10种牌阵</text>
      <text class="more-arrow">→</text>
    </view>

    <!-- 耗尽态：补充解读次数（单入口 · 绑定会员页） -->
    <view wx:if="{{!isMember && freeReadingsUsed >= freeReadingsTotal}}" class="refill-quota-btn" bindtap="onGoMembership" role="button" aria-label="补充解读次数" hover-class="refill-quota-btn--pressed" hover-stay-time="80">
      <text class="refill-quota-text">补充解读次数 ✦</text>
    </view>
  </view>

  <!-- 今日快捷 — 树洞 / 记录今天 / 继续解读（三合一紧凑横排） -->
  <view class="quick-entry-row anim-fade-in-up-3">
    <view class="quick-entry-card" bindtap="onGoCommunity" role="button" aria-label="进入星光树洞" hover-class="card-pressed" hover-stay-time="60">
      <view class="quick-entry-icon">
        <text class="quick-entry-emoji">🕊️</text>
      </view>
      <text class="quick-entry-label">星光树洞</text>
    </view>
    <view class="quick-entry-card" bindtap="onGoDiary" role="button" aria-label="记录今天" hover-class="card-pressed" hover-stay-time="60">
      <view class="quick-entry-icon">
        <image class="quick-entry-img" src="/images/icons/diary_64.png" mode="aspectFit" lazy-load aria-label="记录今天" />
      </view>
      <text class="quick-entry-label">记录今天</text>
    </view>
    <view wx:if="{{pendingReading}}" class="quick-entry-card" bindtap="onContinueReading" role="button" aria-label="继续上次未完成的解读" hover-class="card-pressed" hover-stay-time="60">
      <view class="quick-entry-icon">
        <image class="quick-entry-img" src="/images/icons/star_64.png" mode="aspectFit" lazy-load aria-label="继续解读" />
      </view>
      <text class="quick-entry-label">继续解读</text>
    </view>
  </view>

  <!-- ===== 3-Step Onboarding Overlay (v2.1) — 保留全部逻辑与类名 ===== -->
  <view class="onboarding-overlay {{showOnboarding ? 'onboarding-overlay--visible' : ''}}">
    <view class="onboarding-card">

      <!-- All 3 info steps shown together -->
      <view class="onboarding-all-steps">
        <view class="onboarding-step-mini">
          <view class="onboarding-emoji-wrap"><text class="onboarding-emoji">✨</text></view>
          <view class="onboarding-step-mini-text">
            <text class="onboarding-step-mini-title">每日一牌</text>
            <text class="onboarding-step-mini-desc">轻触卡片，获得今日专属指引</text>
          </view>
        </view>
        <view class="onboarding-step-mini">
          <view class="onboarding-emoji-wrap"><text class="onboarding-emoji">🔮</text></view>
          <view class="onboarding-step-mini-text">
            <text class="onboarding-step-mini-title">牌阵解读</text>
            <text class="onboarding-step-mini-desc">选择牌阵，AI为您深度解读</text>
          </view>
        </view>
        <view class="onboarding-step-mini">
          <view class="onboarding-emoji-wrap"><text class="onboarding-emoji">🌟</text></view>
          <view class="onboarding-step-mini-text">
            <text class="onboarding-step-mini-title">选择你的星座</text>
            <text class="onboarding-step-mini-desc">选填 — 让每日运势更贴合你的星象</text>
          </view>
        </view>
      </view>

      <!-- Zodiac grid -->
      <view class="zodiac-grid">
        <view
          class="zodiac-item"
          wx:for="{{zodiacList}}"
          wx:key="key"
          wx:for-item="z"
          bindtap="onSelectZodiac" role="button" aria-label="选择星座 {{z.name}}"
          data-sign="{{z.name}}"
        >
          <text class="zodiac-item-emoji">{{z.emoji}}</text>
          <text class="zodiac-item-name">{{z.name}}</text>
        </view>
      </view>

      <view class="zodiac-skip" bindtap="onSkipZodiac" role="button" aria-label="跳过星座选择">
        <text class="zodiac-skip-text">跳过，开始使用</text>
      </view>
    </view>
  </view>

  <!-- ===== 塔罗简介 — 沉浸式浮层（保留全部逻辑与类名） ===== -->
  <view class="tarot-overlay {{showTarotOverlay ? 'tarot-overlay--visible' : ''}}" bindtap="closeTarotOverlay" role="button" aria-label="关闭塔罗简介">
    <view class="tarot-overlay-content" catchtap="">
      <!-- Star particles inside the card -->
      <view class="tarot-overlay-stars">
        <view class="to-star s1"></view>
        <view class="to-star s2"></view>
        <view class="to-star s3"></view>
        <view class="to-star s4"></view>
        <view class="to-star s5"></view>
        <view class="to-star s6"></view>
      </view>

      <!-- Central glowing card icon -->
      <view class="tarot-overlay-icon">
        <view class="to-card-icon">
          <text class="to-card-emoji">🔮</text>
        </view>
      </view>

      <!-- Title -->
      <text class="tarot-overlay-title">什么是塔罗？</text>

      <!-- Body text -->
      <text class="tarot-overlay-body">塔罗不是预测命运的工具，而是一面镜子——帮你看见自己内心已经知道、却未说出口的东西。每张牌都是一扇窗，照见你此刻的心境、困惑与可能。星光映照，陪你遇见自己。</text>

      <!-- Button -->
      <view class="tarot-overlay-btn" bindtap="closeTarotOverlay" role="button" aria-label="关闭塔罗简介">
        <text>开始探索 ✦</text>
      </view>
    </view>
  </view>

  <!-- ===== 每日一牌打卡海报（保留） ===== -->
  <share-poster
    wx:if="{{dailyCard}}"
    mode="daily"
    visible="{{showDailySharePoster}}"
    cardImagePath="{{dailyShareCardImage}}"
    cardName="{{dailyShareCardName}}"
    dateText="{{dailyShareCardDate}}"
    streak="{{streak}}"
    bind:close="onCloseDailySharePoster"
    bind:share="onShareDailyPosterToFriend"
  />
</view>
