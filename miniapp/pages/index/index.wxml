<!-- pages/index/index.wxml -->
<!-- ===== 新人引导 (首次打开) ===== -->
<view class="onboarding-overlay" wx:if="{{showOnboarding}}">
  <swiper
    class="onboarding-swiper"
    current="{{onboardingStep}}"
    bindchange="onOnboardingSwipe"
    duration="300"
    easing-function="easeInOutCubic"
  >
    <block wx:for="{{onboardingSteps}}" wx:key="index">
      <swiper-item class="onboarding-slide">
        <view class="onboarding-content">
          <text class="onboarding-emoji">{{item.emoji}}</text>
          <text class="onboarding-title">{{item.title}}</text>
          <text class="onboarding-desc">{{item.desc}}</text>
        </view>
      </swiper-item>
    </block>
  </swiper>

  <!-- Dots indicator -->
  <view class="onboarding-dots">
    <view
      wx:for="{{onboardingSteps}}"
      wx:key="index"
      class="onboarding-dot {{index === onboardingStep ? 'active' : ''}}"
      bindtap="onTapDot"
      data-index="{{index}}"
    ></view>
  </view>

  <!-- Bottom area: button + skip -->
  <view class="onboarding-bottom">
    <view
      wx:if="{{onboardingStep < onboardingSteps.length - 1}}"
      class="onboarding-skip"
      bindtap="onOnboardingDone"
    >跳过</view>
    <view
      wx:if="{{onboardingStep < onboardingSteps.length - 1}}"
      class="onboarding-next"
      bindtap="onOnboardingNext"
    >下一步</view>
    <view
      wx:if="{{onboardingStep === onboardingSteps.length - 1}}"
      class="onboarding-start"
      bindtap="onOnboardingDone"
    >开始使用</view>
  </view>
</view>

<!-- ===== 加载骨架 ===== -->
<view class="page" wx:if="{{pageLoading && !showOnboarding}}">
  <view class="skeleton skeleton-circle" style="margin:100rpx auto 40rpx"></view>
  <view class="skeleton skeleton-text" style="width:60%;margin:0 auto"></view>
  <view class="skeleton skeleton-text-sm" style="width:40%;margin:12rpx auto 60rpx"></view>
  <view class="skeleton skeleton-block" style="margin-bottom:40rpx"></view>
  <view class="skeleton skeleton-text" style="width:30%;margin-bottom:20rpx"></view>
  <view style="display:grid;grid-template-columns:repeat(3,1fr);gap:16rpx">
    <view class="skeleton" style="height:140rpx;border-radius:12rpx"></view>
    <view class="skeleton" style="height:140rpx;border-radius:12rpx"></view>
    <view class="skeleton" style="height:140rpx;border-radius:12rpx"></view>
    <view class="skeleton" style="height:140rpx;border-radius:12rpx"></view>
    <view class="skeleton" style="height:140rpx;border-radius:12rpx"></view>
    <view class="skeleton" style="height:140rpx;border-radius:12rpx"></view>
  </view>
</view>

<!-- ===== 错误状态 ===== -->
<view class="page" wx:elif="{{pageError}}">
  <view class="error-state">
    <text class="error-text">连接中断</text>
    <text class="error-hint">{{pageError}}</text>
    <button class="btn btn-outline" bindtap="onRetry">重新连接</button>
  </view>
</view>

<!-- ===== 主内容 ===== -->
<view class="page" wx:else>
  <!-- Parallax star layers -->
  <view class="stars-layer stars-distant"></view>
  <view class="stars-layer stars-mid"></view>
  <view class="stars-layer stars-close"></view>

  <!-- Nebula glows -->
  <view class="nebula nebula-lavender"></view>
  <view class="nebula nebula-gold"></view>

  <!-- Shooting star (rare easter egg) -->
  <view class="shooting-star"></view>

  <!-- Hero -->
  <view class="hero anim-fade-in-up-1">
    <!-- Concentric glow rings -->
    <view class="hero-glow-rings"></view>
    <text class="title-1" style="text-align:center;display:block">星光映照</text>
    <text class="body-text" style="text-align:center;display:block;margin-top:12rpx">每日一牌，遇见自己</text>

    <!-- Daily reminder badge -->
    <view wx:if="{{hasDrawnToday}}" class="daily-updated-badge anim-slide-up">✓ 今日运势已更新</view>
    <view wx:elif="{{showReminder && !dailyCard}}" class="daily-reminder-badge anim-gentle-pulse">今日运势待开启</view>
  </view>

  <!-- 每日一牌 -->
  <view class="anim-fade-in-up-2" style="margin:60rpx 0">

    <!-- BEFORE DRAW — card awaiting tap with shimmer, sparkles, float -->
    <view class="daily-card-wrap {{!hasDrawnToday && !dailyCard ? 'card-ready' : ''}}" wx:if="{{!dailyCard}}" bindtap="drawDailyCard">
      <view class="card card-warm card-float">
        <!-- Shimmer sweep — light glint across surface -->
        <view class="card-shimmer"></view>
        <!-- Orbiting sparkle dots -->
        <view class="card-sparkles"></view>
        <!-- Ripple effect container (triggers via rippleActive state) -->
        <view class="ripple-box">
          <view class="ripple-circle {{rippleActive?'ripple-run':''}}"></view>
        </view>
        <!-- Card content (shakes on tap via shaking state) -->
        <view class="card-body {{shaking?'card-shake':''}}">
          <text style="font-size:52rpx;display:block;margin-bottom:24rpx">🌟</text>
          <text class="title-4" style="display:block;margin-bottom:8rpx">轻触卡片</text>
          <text class="body-sm">开启今日指引</text>
        </view>
      </view>
    </view>

    <!-- AFTER DRAW — card revealed with rise, particles, and staggered text -->
    <view class="daily-card-wrap" wx:else>
      <view class="card card--revealed card-rise">
        <!-- Floating sparkle particles -->
        <view class="sparkle-field">
          <view class="sparkle s1"></view>
          <view class="sparkle s2"></view>
          <view class="sparkle s3"></view>
          <view class="sparkle s4"></view>
          <view class="sparkle s5"></view>
          <view class="sparkle s6"></view>
        </view>
        <!-- Golden particles burst (8 dots radiating outward) -->
        <view class="particle-field">
          <view class="particle p1"></view>
          <view class="particle p2"></view>
          <view class="particle p3"></view>
          <view class="particle p4"></view>
          <view class="particle p5"></view>
          <view class="particle p6"></view>
          <view class="particle p7"></view>
          <view class="particle p8"></view>
        </view>
        <!-- Reveal text with staggered animation-delay via inline style -->
        <text class="caption accent-text reveal-text" style="display:block;margin-bottom:16rpx">今日指引</text>
        <text class="title-2 reveal-text" style="display:block;margin-bottom:12rpx;animation-delay:0.15s">{{dailyCard.name_zh}}</text>
        <text class="body-text reveal-text" style="animation-delay:0.3s">{{dailyCard.keywords_upright}}</text>

        <!-- Streak badge (only if 2+ consecutive days) -->
        <view wx:if="{{streak >= 2}}" class="streak-badge reveal-text" style="animation-delay:0.45s">
          <text class="streak-icon">✦</text>
          <text class="streak-count">连续 {{streak}} 天</text>
        </view>

        <!-- Daily reflection prompt -->
        <view wx:if="{{showReflectionPrompt}}" class="reflection-prompt reveal-text" style="animation-delay:0.6s">
          <text class="reflection-text">今天的这张牌，让你想到了什么？</text>
          <text class="reflection-link" bindtap="goToDiary">记录此刻感悟 →</text>
        </view>
      </view>
    </view>

  </view>

  <!-- 未完成解读恢复入口 -->
  <view wx:if="{{pendingReading}}" class="anim-fade-in-up-2" style="margin-top:30rpx" bindtap="onContinueReading">
    <view class="card card-press" style="padding:28rpx 24rpx;display:flex;align-items:center;justify-content:space-between;background:linear-gradient(135deg,rgba(244,212,140,0.10) 0%,rgba(180,140,200,0.08) 100%);border-color:rgba(244,212,140,0.20)">
      <view style="display:flex;align-items:center;gap:16rpx">
        <view style="width:48rpx;height:48rpx;background:rgba(244,212,140,0.15);border-radius:50%;display:flex;align-items:center;justify-content:center">
          <text style="font-size:28rpx">✦</text>
        </view>
        <view>
          <text class="body-sm" style="display:block;font-weight:500;color:var(--color-gold)">上次未完成的解读</text>
          <text class="body-xs" style="display:block;margin-top:4rpx">继续 →</text>
        </view>
      </view>
      <text style="font-size:24rpx;color:var(--color-text-tertiary)">→</text>
    </view>
  </view>

  <!-- 今日日记入口 -->
  <view class="anim-fade-in-up-2" style="margin-top:30rpx" bindtap="goToDiary">
    <view class="card card-press" style="padding:28rpx 24rpx;display:flex;align-items:center;justify-content:space-between;background:linear-gradient(135deg,rgba(244,212,140,0.08) 0%,rgba(180,140,200,0.06) 100%);border-color:rgba(244,212,140,0.15)">
      <view style="display:flex;align-items:center;gap:16rpx">
        <text style="font-size:44rpx">📖</text>
        <view>
          <text wx:if="{{hasTodayDiary}}" class="body-sm" style="display:block;font-weight:500;color:var(--color-gold)">今日已记录 ✦</text>
          <text wx:else class="body-sm" style="display:block;font-weight:500;color:var(--color-gold)">记录今日感悟 ✦</text>
          <text class="body-xs" style="display:block;margin-top:4rpx">开启日记 →</text>
        </view>
      </view>
      <text style="font-size:24rpx;color:var(--color-text-tertiary)">→</text>
    </view>
  </view>

  <!-- 免费次数提示 -->
  <view class="free-banner anim-fade-in-up-3">
    <view wx:if="{{!isMember && freeReadingsUsed < freeReadingsTotal}}" class="free-banner-content">
      <text class="free-banner-text">今日剩余 <text class="free-banner-count">{{freeReadingsTotal - freeReadingsUsed}}/{{freeReadingsTotal}}</text> 次免费解读</text>
    </view>
    <view wx:elif="{{!isMember && freeReadingsUsed >= freeReadingsTotal}}" class="free-banner-content free-banner-exhausted">
      <text class="free-banner-text">今日免费 {{freeReadingsTotal}}/{{freeReadingsTotal}} 次已用完 ✦ 开通会员无限解读</text>
    </view>
  </view>

  <!-- 牌阵 -->
  <view class="section anim-fade-in-up-3">
    <text class="section-title">选择牌阵</text>
    <view style="display:grid;grid-template-columns:repeat(2,1fr);gap:16rpx">
      <view class="card card-press spread-card" style="padding:24rpx 16rpx;text-align:center" bindtap="navigateToReading" data-type="three_card">
        <image class="spread-icon" src="/images/icons/theme_general_64.png" mode="aspectFit" />
        <text class="body-sm" style="display:block;font-weight:600">三牌占卜</text>
        <text class="body-xs" style="display:block;margin-top:6rpx">过去·现在·未来</text>
      </view>
      <view class="card card-press spread-card" style="padding:24rpx 16rpx;text-align:center" bindtap="navigateToReading" data-type="triangle">
        <image class="spread-icon" src="/images/icons/theme_love_64.png" mode="aspectFit" />
        <text class="body-sm" style="display:block;font-weight:600">恋人三角</text>
        <text class="body-xs" style="display:block;margin-top:6rpx">感情关系深度解读</text>
      </view>
      <view class="card card-press spread-card" style="padding:24rpx 16rpx;text-align:center" bindtap="navigateToReading" data-type="celtic_cross">
        <image class="spread-icon" src="/images/icons/theme_general_64.png" mode="aspectFit" />
        <text class="body-sm" style="display:block;font-weight:600">凯尔特十字</text>
        <text class="body-xs" style="display:block;margin-top:6rpx">全方位综合解牌</text>
      </view>
      <view class="card card-press spread-card" style="padding:24rpx 16rpx;text-align:center" bindtap="navigateToReading" data-type="career">
        <image class="spread-icon" src="/images/icons/theme_career_64.png" mode="aspectFit" />
        <text class="body-sm" style="display:block;font-weight:600">事业牌阵</text>
        <text class="body-xs" style="display:block;margin-top:6rpx">职场方向与机遇</text>
      </view>
    </view>
    <view class="card card-press more-spreads" bindtap="goToAllSpreads">
      <text class="more-text anim-gentle-pulse">查看更多 · 共10种牌阵</text>
      <text class="more-arrow">→</text>
    </view>
  </view>
</view>
