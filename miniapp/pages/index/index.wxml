<!-- pages/index/index.wxml -->

<!-- ===== 加载骨架 ===== -->
<view class="page" wx:if="{{pageLoading}}">
  <view class="skeleton skeleton--circle" style="margin:100rpx auto 40rpx"></view>
  <view class="skeleton skeleton--text" style="width:60%;margin:0 auto"></view>
  <view class="skeleton skeleton--text-sm" style="width:40%;margin:12rpx auto 60rpx"></view>
  <view class="skeleton skeleton--block" style="margin-bottom:40rpx"></view>
  <view class="skeleton skeleton--text" style="width:30%;margin-bottom:20rpx"></view>
  <view class="skeleton-grid-3">
    <view class="skeleton skeleton--card-sm"></view>
    <view class="skeleton skeleton--card-sm"></view>
    <view class="skeleton skeleton--card-sm"></view>
    <view class="skeleton skeleton--card-sm"></view>
    <view class="skeleton skeleton--card-sm"></view>
    <view class="skeleton skeleton--card-sm"></view>
  </view>
</view>

<!-- ===== 错误状态 ===== -->
<view class="page" wx:elif="{{pageError}}">
  <view class="error-state">
    <text class="error-text">连接中断</text>
    <text class="error-hint">{{pageError}}</text>
    <button class="btn-ghost" bindtap="onRetry">重新连接</button>
  </view>
</view>

<!-- ===== 主内容 ===== -->
<view class="page" wx:else>
  <!-- Parallax star layers -->
  <view class="stars-layer stars-distant"></view>
  <view class="stars-layer stars-mid"></view>
  <view class="stars-layer stars-close"></view>

  <!-- Nebula glows -->
  <view class="nebula nebula-lavender"></view>
  <view class="nebula nebula-gold"></view>

  <!-- Shooting star (rare easter egg) -->
  <view class="shooting-star {{shootingStarActive ? 'shooting-star--active' : ''}}"></view>

  <!-- Hero -->
  <view class="hero anim-fade-in-up-1">
    <!-- Concentric glow rings -->
    <view class="hero-glow-rings"></view>
    <text class="title-1" style="text-align:center;display:block">星光映照</text>
    <text class="body-text" style="text-align:center;display:block;margin-top:12rpx">每日一牌，遇见自己</text>
    <text class="tagline-sub">塔罗是镜子，不是预言。AI是你的陪伴，不是答案。</text>

    <!-- v2.1: Time-of-day greeting -->
    <text wx:if="{{greetingText}}" class="greeting-text anim-greeting-fade" key="{{greetingAnimKey}}">{{greetingText}}</text>

    <!-- Checkin entry -->
    <view class="checkin-entry {{checkedInToday ? 'checkin-entry--done' : ''}}" bindtap="onGoCheckin">
      <view class="checkin-entry-icon">{{checkedInToday ? '🔥' : '✦'}}</view>
      <text class="checkin-entry-text">
        {{checkedInToday ? '已签到 · 连续 ' + checkinStreak + ' 天' : checkinStreak > 0 ? '🔥 连续 ' + checkinStreak + ' 天' : '✦ 今日签到'}}
      </text>
    </view>

    <!-- Daily reminder badge -->
    <view wx:if="{{hasDrawnToday}}" class="daily-updated-badge anim-slide-up">✓ 今日运势已更新</view>
    <view wx:elif="{{showReminder && !dailyCard}}" class="daily-reminder-badge anim-gentle-pulse">今日运势待开启</view>
  </view>

  <!-- ===== 试用到期提醒横幅 ===== -->
  <view wx:if="{{showTrialExpiryBanner}}" class="trial-expiry-banner anim-fade-in-up-2" bindtap="onGoMembership">
    <text class="trial-expiry-icon">✦</text>
    <text class="trial-expiry-text">试用期即将到期 · 开通会员保留你的解读记录 ✦</text>
    <text class="trial-expiry-arrow">→</text>
  </view>

  <!-- ===== 3-Step Onboarding Overlay (v2.1) — simplified, all steps visible at once ===== -->
  <view class="onboarding-overlay {{showOnboarding ? 'onboarding-overlay--visible' : ''}}">
    <view class="onboarding-card">

      <!-- All 3 info steps shown together -->
      <view class="onboarding-all-steps">
        <view class="onboarding-step-mini">
          <view class="onboarding-emoji-wrap"><text class="onboarding-emoji">✨</text></view>
          <view class="onboarding-step-mini-text">
            <text class="onboarding-step-mini-title">每日一牌</text>
            <text class="onboarding-step-mini-desc">轻触卡片，获得今日专属指引</text>
          </view>
        </view>
        <view class="onboarding-step-mini">
          <view class="onboarding-emoji-wrap"><text class="onboarding-emoji">🔮</text></view>
          <view class="onboarding-step-mini-text">
            <text class="onboarding-step-mini-title">牌阵解读</text>
            <text class="onboarding-step-mini-desc">选择牌阵，AI为您深度解读</text>
          </view>
        </view>
        <view class="onboarding-step-mini">
          <view class="onboarding-emoji-wrap"><text class="onboarding-emoji">🌟</text></view>
          <view class="onboarding-step-mini-text">
            <text class="onboarding-step-mini-title">选择你的星座</text>
            <text class="onboarding-step-mini-desc">选填 — 让每日运势更贴合你的星象</text>
          </view>
        </view>
      </view>

      <!-- Zodiac grid -->
      <view class="zodiac-grid">
        <view
          class="zodiac-item"
          wx:for="{{zodiacList}}"
          wx:key="key"
          wx:for-item="z"
          bindtap="onSelectZodiac"
          data-sign="{{z.name}}"
        >
          <text class="zodiac-item-emoji">{{z.emoji}}</text>
          <text class="zodiac-item-name">{{z.name}}</text>
        </view>
      </view>

      <view class="zodiac-skip" bindtap="onSkipZodiac">
        <text class="zodiac-skip-text">跳过，开始使用</text>
      </view>
    </view>
  </view>

  <!-- 每日一牌 — 教学入口 (v2.0) -->
  <view class="anim-fade-in-up-2" style="margin:60rpx 0">

    <!-- BEFORE DRAW — card awaiting tap with shimmer, sparkles, float -->
    <view class="daily-card-wrap {{!hasDrawnToday && !dailyCard ? 'card-ready' : ''}}" wx:if="{{!dailyCard && !dailyCardRestoring}}" bindtap="drawDailyCard" animation="{{cardAnimData}}" role="button">
      <view class="card card-warm card-float">
        <!-- Shimmer sweep — light glint across surface -->
        <view class="card-shimmer"></view>
        <!-- Orbiting sparkle dots -->
        <view class="card-sparkles"></view>
        <!-- Ripple effect container (triggers via rippleActive state) -->
        <view class="ripple-box">
          <view class="ripple-circle {{rippleActive?'ripple-run':''}}"></view>
        </view>
        <!-- Card content (shakes on tap via shaking state) -->
        <view class="card-body {{shaking?'card-shake':''}}">
          <text style="font-size:52rpx;display:block;margin-bottom:24rpx">🌟</text>
          <text class="title-4" style="display:block;margin-bottom:8rpx">轻触卡片</text>
          <text class="body-sm">开启今日指引</text>
        </view>
      </view>
    </view>

    <!-- RESTORING — skeleton while re-fetching today's card -->
    <view class="daily-card-wrap" wx:elif="{{dailyCardRestoring}}">
      <view class="card card--teaching">
        <view class="skeleton skeleton--block" style="width:200rpx;height:280rpx;margin:0 auto 20rpx;border-radius:16rpx;"></view>
        <view class="skeleton skeleton--title" style="width:40%;margin:0 auto 12rpx;"></view>
        <view class="skeleton skeleton--text-sm" style="width:55%;margin:0 auto;"></view>
      </view>
    </view>

    <!-- AFTER DRAW — teaching entry card -->
    <view class="daily-card-wrap daily-card-teaching {{dailyCardFlipped ? 'daily-card--flipped' : ''}}" wx:else bindtap="onDailyCardTap" data-today-flipped="{{dailyCardFlipped}}">
      <view class="card card--teaching card-rise">
        <!-- Breathing glow overlay (only when not flipped) -->
        <view wx:if="{{!dailyCardFlipped}}" class="daily-card-glow-overlay"></view>

        <!-- Sparkle particles (only when not flipped) -->
        <view wx:if="{{!dailyCardFlipped}}" class="sparkle-field">
          <view class="sparkle s1"></view>
          <view class="sparkle s2"></view>
          <view class="sparkle s3"></view>
          <view class="sparkle s4"></view>
          <view class="sparkle s5"></view>
          <view class="sparkle s6"></view>
        </view>

        <!-- Card thumbnail -->
        <view class="daily-card-thumb-wrap {{dailyCardImgError ? 'daily-card-thumb-error' : ''}}">
          <image wx:if="{{dailyCard.imagePath && !dailyCardImgError}}" class="daily-card-thumb" src="{{dailyCard.imagePath}}" mode="aspectFit" binderror="onDailyCardImgError" aria-label="今日塔罗 — {{dailyCard.name_cn || dailyCard.name_zh || '每日一牌'}}" />
          <view wx:elif="{{dailyCardImgError}}" class="daily-card-thumb-fallback">
            <text class="thumb-fallback-name">{{dailyCard.name_zh}}</text>
          </view>
          <view wx:else class="daily-card-thumb-fallback">
            <!-- no image path yet -->
          </view>
        </view>

        <!-- Flipped badge -->
        <view wx:if="{{dailyCardFlipped}}" class="daily-card-badge">已学习 ✓</view>

        <!-- Card name -->
        <text class="title-4 daily-card-name">{{dailyCard.name_zh}}</text>

        <!-- CTA text -->
        <text wx:if="{{!dailyCardFlipped}}" class="body-sm daily-card-cta">点击学习这张牌 ✦</text>
        <text wx:else class="body-xs daily-card-revisit">点击回顾今日学习</text>

        <!-- Streak badge (only if 2+ consecutive days) -->
        <view wx:if="{{streak >= 2}}" class="streak-badge">
          <image class="streak-icon" src="/images/icons/star_64.png" mode="aspectFit" lazy-load aria-label="连续 {{streak}} 天" />
          <text class="streak-count">连续 {{streak}} 天</text>
        </view>

        <!-- Collection progress ring -->
        <view class="collect-progress-wrap" wx:if="{{collectedCount > 0}}">
          <view class="collect-progress-ring">
            <view class="ring-bg"></view>
            <view class="ring-fill" style="--progress: {{collectedCount / 22}}"></view>
            <text class="ring-text">{{collectedCount}}/22</text>
          </view>
          <text class="ring-label">大牌收集</text>
        </view>
      </view>
    </view>

  </view>

  <!-- ===== 今日任务卡片 ===== -->
  <view class="anim-fade-in-up-2" style="margin-top:30rpx">
    <view class="card tasks-card" bindtap="onGoCheckin">
      <view class="tasks-card-header">
        <text class="tasks-card-title">今日任务</text>
        <view class="tasks-card-stats">
          <text class="tasks-card-progress">{{tasksCompleted}}/{{tasksTotal}} 完成</text>
          <view class="tasks-progress-bar">
            <view class="tasks-progress-fill" style="width: {{tasksTotal > 0 ? (tasksCompleted / tasksTotal * 100) : 0}}%"></view>
          </view>
        </view>
      </view>
      <view class="tasks-list">
        <view class="task-item {{tasksDailyCardDrawn ? 'task-item--done' : ''}}">
          <view class="task-check {{tasksDailyCardDrawn ? 'task-check--checked' : ''}}">
            <text wx:if="{{tasksDailyCardDrawn}}" class="task-check-icon">✓</text>
          </view>
          <text class="task-name">抽一张每日牌</text>
        </view>
        <view class="task-item {{tasksReadingDone ? 'task-item--done' : ''}}">
          <view class="task-check {{tasksReadingDone ? 'task-check--checked' : ''}}">
            <text wx:if="{{tasksReadingDone}}" class="task-check-icon">✓</text>
          </view>
          <text class="task-name">完成一次解读</text>
        </view>
        <view class="task-item {{tasksShared ? 'task-item--done' : ''}}">
          <view class="task-check {{tasksShared ? 'task-check--checked' : ''}}">
            <text wx:if="{{tasksShared}}" class="task-check-icon">✓</text>
          </view>
          <text class="task-name">分享你的解读</text>
        </view>
      </view>
      <view class="tasks-card-footer">
        <text class="tasks-card-reward">每完成一项任务 +1 免费解读次数</text>
      </view>
    </view>
  </view>

  <!-- 星光树洞入口 -->
  <view class="anim-fade-in-up-2" style="margin-top:30rpx" bindtap="onGoCommunity">
    <view class="card card-press community-entry-card">
      <view class="diary-entry-left">
        <view class="community-entry-icon">
          <text class="community-entry-emoji">🕊️</text>
        </view>
        <view>
          <text class="body-sm community-entry-label">星光树洞 ✦ 今日话题</text>
          <text wx:if="{{communityTopicTitle}}" class="body-xs community-entry-hint">「{{communityTopicTitle}}」</text>
          <text wx:else class="body-xs community-entry-hint">匿名倾诉，与星光对话</text>
        </view>
      </view>
      <text class="diary-entry-arrow">→</text>
    </view>
  </view>

  <!-- 未完成解读恢复入口 -->
  <view wx:if="{{pendingReading}}" class="anim-fade-in-up-2" style="margin-top:30rpx" bindtap="onContinueReading">
    <view class="card card-press pending-reading-card">
      <view class="pending-reading-left">
        <view class="pending-reading-icon-wrap">
          <image class="pending-reading-icon" src="/images/icons/star_64.png" mode="aspectFit" lazy-load aria-label="上次未完成的解读" />
        </view>
        <view>
          <text class="body-sm pending-reading-label">上次未完成的解读</text>
          <text class="body-xs pending-reading-hint">继续 →</text>
        </view>
      </view>
      <text class="pending-reading-arrow">→</text>
    </view>
  </view>

  <!-- 今日记录入口 -->
  <view class="anim-fade-in-up-2" style="margin-top:30rpx" bindtap="onGoDiary">
    <view class="card card-press diary-entry-card">
      <view class="diary-entry-left">
        <image class="diary-entry-icon" src="/images/icons/diary_64.png" mode="aspectFit" lazy-load aria-label="记录今天" />
        <view>
          <text class="body-sm diary-entry-label">记录今天</text>
          <text wx:if="{{dailyCard}}" class="body-xs diary-entry-hint">和「{{dailyCard.name_zh}}」说说话</text>
        </view>
      </view>
      <text class="diary-entry-arrow">→</text>
    </view>
  </view>

  <!-- 年度报告入口（带季节性横幅） -->
  <view class="anim-fade-in-up-2" style="margin-top:30rpx" bindtap="{{isMember ? 'onGoAnnualReport' : 'onGoMembership'}}" role="button">
    <!-- Seasonal banner (Dec-Jan only) -->
    <view wx:if="{{isAnnualReportSeason}}" class="annual-report-season-banner">
      <view class="season-banner-glow"></view>
      <view class="season-banner-stars">
        <view wx:for="{{[1,2,3]}}" wx:key="*this" class="season-banner-star" style="--i: {{item}}"></view>
      </view>
      <text class="season-banner-label">{{annualReportYear}} 年度报告已上线</text>
      <text class="season-banner-cta">{{isMember ? '查看你的星光旅程 ✦' : '开通会员查看 ✦'}}</text>
    </view>
    <!-- Default card (non-Dec/Jan) -->
    <view wx:else class="card card-press annual-report-card {{isMember ? '' : 'annual-report-card--locked'}}">
      <view class="annual-report-left">
        <image class="annual-report-icon" src="/images/icons/report_64.png" mode="aspectFit" lazy-load aria-label="年度运势报告" />
        <view>
          <text class="body-sm annual-report-label">年度运势报告</text>
          <text class="body-xs annual-report-hint">{{isMember ? '查看你的星 year ahead ✦' : '开通会员解锁 ✦'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 免费次数提示（进度条） — 点击跳转会员页 -->
  <view class="free-quota-bar anim-fade-in-up-3" wx:if="{{!isMember}}" bindtap="onGoMembership" role="button">
    <view class="quota-progress-wrap">
      <view class="quota-progress" style="width: {{(freeReadingsTotal - freeReadingsUsed) / freeReadingsTotal * 100}}%"></view>
    </view>
    <text class="quota-text" wx:if="{{freeReadingsUsed < freeReadingsTotal}}">今日免费解读 {{freeReadingsUsed}}/{{freeReadingsTotal}} · 明日0点重置</text>
    <view class="quota-cta" wx:elif="{{freeReadingsUsed >= freeReadingsTotal}}">
      <text class="quota-text quota-text--exhausted">今日免费 {{freeReadingsTotal}}/{{freeReadingsTotal}} 次已用完</text>
      <text class="quota-cta-btn">升级会员无限解读 →</text>
    </view>
  </view>

  <!-- 会员引导卡片 — 仅在触发条件满足时展示 -->
  <view class="membership-prompt {{showMembershipPrompt ? 'membership-prompt--visible' : ''}}"
    wx:if="{{showMembershipPrompt && !isMember}}">
    <view class="mp-card">
      <view class="mp-stars">
        <view class="mp-star mp-star-1"></view>
        <view class="mp-star mp-star-2"></view>
        <view class="mp-star mp-star-3"></view>
      </view>
      <text class="mp-icon">✨</text>
      <text class="mp-title">{{membershipPromptReason === 'quota_exhausted' ? '今日星光已用完' : '今日星光即将用完'}}</text>
      <text class="mp-desc">开通会员 · 无限解读 · 每日低至 ¥0.46</text>
      <button class="mp-btn" bindtap="onGoMembership">
        <text>解锁无限星光 ✦</text>
      </button>
      <text class="mp-dismiss" bindtap="onDismissMembership">暂不需要</text>
    </view>
  </view>

  <!-- 9.9新人专享CTA -->
  <view class="hero-cta anim-fade-in-up-3" bindtap="onStartFirstReading" wx:if="{{!isMember && freeReadingsUsed === 0}}">
    <view class="hero-cta-glow"></view>
    <text class="hero-cta-title">9.9元 · 首次AI深度解读</text>
    <text class="hero-cta-sub">新人专享 · 三牌占卜 · 行动建议</text>
  </view>

  <!-- 牌阵 -->
  <view class="section anim-fade-in-up-3">
    <text class="section-title">选择牌阵</text>
    <view class="spread-grid-2">
      <view class="card card-press spread-card" bindtap="navigateToReading" data-type="three_card" animation="{{spreadAnimData[0]}}" role="button">
        <view class="spread-tag spread-tag-free">免费</view>
        <image class="spread-icon" src="/images/icons/theme_general_64.png" mode="aspectFit" lazy-load aria-label="三牌占卜" />
        <text class="body-sm">三牌占卜</text>
        <text class="body-xs">过去·现在·未来</text>
      </view>
      <view class="card card-press spread-card" bindtap="navigateToReading" data-type="triangle" animation="{{spreadAnimData[1]}}" role="button">
        <view class="spread-tag spread-tag-premium">会员</view>
        <image class="spread-icon" src="/images/icons/theme_love_64.png" mode="aspectFit" lazy-load aria-label="恋人三角" />
        <text class="body-sm">恋人三角</text>
        <text class="body-xs">感情关系深度解读</text>
        <view class="spread-theme-chip spread-theme-chip--love">爱情</view>
      </view>
      <view class="card card-press spread-card" bindtap="navigateToReading" data-type="celtic_cross" animation="{{spreadAnimData[2]}}" role="button">
        <view class="spread-tag spread-tag-premium">会员</view>
        <image class="spread-icon" src="/images/icons/theme_general_64.png" mode="aspectFit" lazy-load aria-label="凯尔特十字" />
        <text class="body-sm">凯尔特十字</text>
        <text class="body-xs">全方位综合解牌</text>
      </view>
      <view class="card card-press spread-card" bindtap="navigateToReading" data-type="career" animation="{{spreadAnimData[3]}}" role="button">
        <view class="spread-tag spread-tag-premium">会员</view>
        <image class="spread-icon" src="/images/icons/theme_career_64.png" mode="aspectFit" lazy-load aria-label="事业牌阵" />
        <text class="body-sm">事业牌阵</text>
        <text class="body-xs">职场方向与机遇</text>
        <view class="spread-theme-chip spread-theme-chip--career">事业</view>
      </view>
    </view>
    <view class="card card-press more-spreads" bindtap="goToAllSpreads" animation="{{spreadAnimData[4]}}">
      <text class="more-text anim-gentle-pulse">查看更多 · 共10种牌阵</text>
      <text class="more-arrow">→</text>
    </view>

    <!-- 会员解锁全部牌阵入口（仅非会员显示） -->
    <view wx:if="{{!isMember}}" class="card card-press unlock-spreads-card" bindtap="onGoMembership" role="button">
      <view class="unlock-spreads-left">
        <image class="unlock-spreads-icon" src="/images/icons/lock_64.png" mode="aspectFit" lazy-load aria-label="解锁全部牌阵" />
      </view>
      <view class="unlock-spreads-content">
        <text class="unlock-spreads-title">解锁全部牌阵</text>
        <text class="unlock-spreads-sub">会员专享 10 种牌阵 + 无限次解读</text>
      </view>
      <text class="unlock-spreads-arrow">→</text>
    </view>

    <!-- 塔罗简介 -->
    <view class="tarot-explainer-wrap">
      <text class="tarot-explainer-link" bindtap="showTarotExplainer">什么是塔罗？</text>
    </view>

    <!-- DEV: 自动化测试入口 -->
    <view class="dev-test-entry" bindtap="onGoTestRunner">
      <text class="dev-test-text">🔍 页面测试</text>
    </view>
  </view>

  <!-- ===== 塔罗简介 — 沉浸式浮层 ===== -->
  <view class="tarot-overlay {{showTarotOverlay ? 'tarot-overlay--visible' : ''}}" bindtap="closeTarotOverlay">
    <view class="tarot-overlay-content" catchtap="">
      <!-- Star particles inside the card -->
      <view class="tarot-overlay-stars">
        <view class="to-star s1"></view>
        <view class="to-star s2"></view>
        <view class="to-star s3"></view>
        <view class="to-star s4"></view>
        <view class="to-star s5"></view>
        <view class="to-star s6"></view>
      </view>

      <!-- Central glowing card icon -->
      <view class="tarot-overlay-icon">
        <view class="to-card-icon">
          <text class="to-card-emoji">🔮</text>
        </view>
      </view>

      <!-- Title -->
      <text class="tarot-overlay-title">什么是塔罗？</text>

      <!-- Body text -->
      <text class="tarot-overlay-body">塔罗不是预测命运的工具，而是一面镜子——帮你看见自己内心已经知道、却未说出口的东西。每张牌都是一扇窗，照见你此刻的心境、困惑与可能。星光映照，陪你遇见自己。</text>

      <!-- Button -->
      <view class="tarot-overlay-btn" bindtap="closeTarotOverlay">
        <text>开始探索 ✦</text>
      </view>
    </view>
  </view>
</view>
