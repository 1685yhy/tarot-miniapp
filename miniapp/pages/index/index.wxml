<!-- pages/index/index.wxml -->
<!-- ===== 加载骨架 ===== -->
<view class="page" wx:if="{{pageLoading}}">
  <view class="skeleton skeleton-circle" style="margin:100rpx auto 40rpx"></view>
  <view class="skeleton skeleton-text" style="width:60%;margin:0 auto"></view>
  <view class="skeleton skeleton-text-sm" style="width:40%;margin:12rpx auto 60rpx"></view>
  <view class="skeleton skeleton-block" style="margin-bottom:40rpx"></view>
  <view class="skeleton skeleton-text" style="width:30%;margin-bottom:20rpx"></view>
  <view style="display:grid;grid-template-columns:repeat(3,1fr);gap:16rpx">
    <view class="skeleton" style="height:140rpx;border-radius:12rpx"></view>
    <view class="skeleton" style="height:140rpx;border-radius:12rpx"></view>
    <view class="skeleton" style="height:140rpx;border-radius:12rpx"></view>
    <view class="skeleton" style="height:140rpx;border-radius:12rpx"></view>
    <view class="skeleton" style="height:140rpx;border-radius:12rpx"></view>
    <view class="skeleton" style="height:140rpx;border-radius:12rpx"></view>
  </view>
</view>

<!-- ===== 错误状态 ===== -->
<view class="page" wx:elif="{{pageError}}">
  <view class="error-state">
    <text class="error-icon">🔮</text>
    <text class="error-text">连接中断</text>
    <text class="error-hint">{{pageError}}</text>
    <button class="btn btn-outline" bindtap="onRetry">重新连接</button>
  </view>
</view>

<!-- ===== 主内容 ===== -->
<view class="page" wx:else>
  <!-- Hero -->
  <view class="hero anim-fade-in-up-1">
    <text class="title-1" style="text-align:center;display:block">星光映照</text>
    <text class="body-text" style="text-align:center;display:block;margin-top:12rpx">每日一牌，遇见自己</text>
  </view>

  <!-- 每日一牌 -->
  <view class="anim-fade-in-up-2" style="margin:60rpx 0">

    <!-- BEFORE DRAW — card awaiting tap with shimmer, sparkles, float -->
    <view class="daily-card-wrap" wx:if="{{!dailyCard}}" bindtap="drawDailyCard">
      <view class="card card-warm card-float">
        <!-- Shimmer sweep — light glint across surface -->
        <view class="card-shimmer"></view>
        <!-- Orbiting sparkle dots -->
        <view class="card-sparkles"></view>
        <!-- Ripple effect container (triggers via rippleActive state) -->
        <view class="ripple-box">
          <view class="ripple-circle {{rippleActive?'ripple-run':''}}"></view>
        </view>
        <!-- Card content (shakes on tap via shaking state) -->
        <view class="card-body {{shaking?'card-shake':''}}">
          <text style="font-size:52rpx;display:block;margin-bottom:24rpx">🌟</text>
          <text class="title-4" style="display:block;margin-bottom:8rpx">轻触卡片</text>
          <text class="body-sm">开启今日指引</text>
        </view>
      </view>
    </view>

    <!-- AFTER DRAW — card revealed with rise, particles, and staggered text -->
    <view class="daily-card-wrap" wx:else>
      <view class="card card--revealed card-rise">
        <!-- Golden particles burst (8 dots radiating outward) -->
        <view class="particle-field">
          <view class="particle p1"></view>
          <view class="particle p2"></view>
          <view class="particle p3"></view>
          <view class="particle p4"></view>
          <view class="particle p5"></view>
          <view class="particle p6"></view>
          <view class="particle p7"></view>
          <view class="particle p8"></view>
        </view>
        <!-- Reveal text with staggered animation-delay via inline style -->
        <text class="caption accent-text reveal-text" style="display:block;margin-bottom:16rpx">今日指引</text>
        <text class="title-2 reveal-text" style="display:block;margin-bottom:12rpx;animation-delay:0.15s">{{dailyCard.name_zh}}</text>
        <text class="body-text reveal-text" style="animation-delay:0.3s">{{dailyCard.keywords_upright}}</text>
      </view>
    </view>

  </view>

  <!-- 牌阵 -->
  <view class="section anim-fade-in-up-3">
    <text class="section-title">选择牌阵</text>
    <view style="display:grid;grid-template-columns:repeat(2,1fr);gap:16rpx">
      <view class="card card-press" style="padding:24rpx 16rpx;text-align:center" bindtap="navigateToReading" data-type="three_card">
        <text style="font-size:36rpx;display:block;margin-bottom:8rpx">🔮</text>
        <text class="body-sm" style="display:block;font-weight:600">三牌占卜</text>
        <text class="body-xs" style="display:block;margin-top:6rpx">过去·现在·未来</text>
      </view>
      <view class="card card-press" style="padding:24rpx 16rpx;text-align:center" bindtap="navigateToReading" data-type="triangle">
        <text style="font-size:36rpx;display:block;margin-bottom:8rpx">💕</text>
        <text class="body-sm" style="display:block;font-weight:600">恋人三角</text>
        <text class="body-xs" style="display:block;margin-top:6rpx">感情关系深度解读</text>
      </view>
      <view class="card card-press" style="padding:24rpx 16rpx;text-align:center" bindtap="navigateToReading" data-type="celtic_cross">
        <text style="font-size:36rpx;display:block;margin-bottom:8rpx">⭐</text>
        <text class="body-sm" style="display:block;font-weight:600">凯尔特十字</text>
        <text class="body-xs" style="display:block;margin-top:6rpx">全方位综合解牌</text>
      </view>
      <view class="card card-press" style="padding:24rpx 16rpx;text-align:center" bindtap="navigateToReading" data-type="career">
        <text style="font-size:36rpx;display:block;margin-bottom:8rpx">💼</text>
        <text class="body-sm" style="display:block;font-weight:600">事业牌阵</text>
        <text class="body-xs" style="display:block;margin-top:6rpx">职场方向与机遇</text>
      </view>
    </view>
    <view class="card card-press more-spreads" bindtap="goToAllSpreads">
      <text class="more-text">查看更多 · 共10种牌阵</text>
      <text class="more-arrow">→</text>
    </view>
  </view>
</view>
