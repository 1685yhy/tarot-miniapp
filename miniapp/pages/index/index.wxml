<!-- pages/index/index.wxml -->
<!-- ===== 加载骨架 ===== -->
<view class="page" wx:if="{{pageLoading}}">
  <view class="skeleton skeleton-circle" style="margin:100rpx auto 40rpx"></view>
  <view class="skeleton skeleton-text" style="width:60%;margin:0 auto"></view>
  <view class="skeleton skeleton-text-sm" style="width:40%;margin:12rpx auto 60rpx"></view>
  <view class="skeleton skeleton-block" style="margin-bottom:40rpx"></view>
  <view class="skeleton skeleton-text" style="width:30%;margin-bottom:20rpx"></view>
  <view style="display:grid;grid-template-columns:repeat(3,1fr);gap:16rpx">
    <view class="skeleton" style="height:140rpx;border-radius:12rpx"></view>
    <view class="skeleton" style="height:140rpx;border-radius:12rpx"></view>
    <view class="skeleton" style="height:140rpx;border-radius:12rpx"></view>
    <view class="skeleton" style="height:140rpx;border-radius:12rpx"></view>
    <view class="skeleton" style="height:140rpx;border-radius:12rpx"></view>
    <view class="skeleton" style="height:140rpx;border-radius:12rpx"></view>
  </view>
</view>

<!-- ===== 错误状态 ===== -->
<view class="page" wx:elif="{{pageError}}">
  <view class="error-state">
    <text class="error-icon">&#x2726;</text>
    <text class="error-text">连接中断</text>
    <text class="error-hint">{{pageError}}</text>
    <button class="btn btn-outline" bindtap="onRetry">重新连接</button>
  </view>
</view>

<!-- ===== 主内容 ===== -->
<view class="page" wx:else>
  <!-- Hero -->
  <view class="hero anim-fade-in-up-1">
    <text class="title-1" style="text-align:center;display:block">星光映照</text>
    <text class="body-text" style="text-align:center;display:block;margin-top:12rpx">每日一牌，遇见自己</text>
  </view>

  <!-- 每日一牌 -->
  <view class="anim-fade-in-up-2" style="margin:60rpx 0">
    <view class="card card-warm card-press" style="padding:56rpx 32rpx;text-align:center" wx:if="{{!dailyCard}}" bindtap="drawDailyCard">
      <text style="font-size:52rpx;display:block;margin-bottom:24rpx">&#x2726;</text>
      <text class="title-4" style="display:block;margin-bottom:8rpx">轻触卡片</text>
      <text class="body-sm">开启今日指引</text>
    </view>
    <view class="card" style="padding:56rpx 32rpx;text-align:center;border:2rpx solid var(--color-accent-light)" wx:else>
      <text class="caption accent-text" style="display:block;margin-bottom:16rpx">今日指引</text>
      <text class="title-2" style="display:block;margin-bottom:12rpx">{{dailyCard.name_zh}}</text>
      <text class="body-text">{{dailyCard.keywords_upright}}</text>
    </view>
  </view>

  <!-- 牌阵 -->
  <view class="section anim-fade-in-up-3">
    <text class="section-title">选择牌阵</text>
    <view style="display:grid;grid-template-columns:repeat(3,1fr);gap:16rpx">
      <view class="card card-press" style="padding:24rpx 16rpx;text-align:center" wx:for="{{['triangle','celtic_cross','three_card','career','finance','decision']}}" wx:key="*this" bindtap="navigateToReading" data-type="{{item}}">
        <block wx:if="{{item==='triangle'}}"><text style="font-size:36rpx;display:block;margin-bottom:8rpx">&#x2665;</text><text class="body-sm" style="display:block">恋人三角</text></block>
        <block wx:elif="{{item==='celtic_cross'}}"><text style="font-size:36rpx;display:block;margin-bottom:8rpx">&#x272A;</text><text class="body-sm" style="display:block">凯尔特十字</text></block>
        <block wx:elif="{{item==='three_card'}}"><text style="font-size:36rpx;display:block;margin-bottom:8rpx">&#x25C6;</text><text class="body-sm" style="display:block">三牌占卜</text></block>
        <block wx:elif="{{item==='career'}}"><text style="font-size:36rpx;display:block;margin-bottom:8rpx">&#x25A0;</text><text class="body-sm" style="display:block">事业牌阵</text></block>
        <block wx:elif="{{item==='finance'}}"><text style="font-size:36rpx;display:block;margin-bottom:8rpx">&#x25B2;</text><text class="body-sm" style="display:block">财运牌阵</text></block>
        <block wx:elif="{{item==='decision'}}"><text style="font-size:36rpx;display:block;margin-bottom:8rpx">&#x25CF;</text><text class="body-sm" style="display:block">二择一</text></block>
      </view>
    </view>
  </view>
</view>