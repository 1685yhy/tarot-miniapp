<!-- pages/index/index.wxml -->
<!-- 星光映照 · 今日屏（牌为主角）· E3 奶油疗愈版（真实水彩插画） -->

<!-- 日期格式化（装饰性日期行 · 与原型 date-row 对应） -->
<wxs module="d">
var MONTHS = ['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC'];
var DAYS = ['SUNDAY','MONDAY','TUESDAY','WEDNESDAY','THURSDAY','FRIDAY','SATURDAY'];
function fmtDate() {
  var now = getDate();
  return MONTHS[now.getMonth()] + ' ' + now.getDate() + ' · ' + DAYS[now.getDay()] + ' · ' + now.getFullYear();
}
module.exports = { fmtDate: fmtDate };
</wxs>

<!-- ===== 加载骨架 ===== -->
<view class="page" wx:if="{{pageLoading}}">
  <view class="skeleton skeleton--circle" style="margin:120rpx auto 40rpx"></view>
  <view class="skeleton skeleton--text" style="width:60%;margin:0 auto"></view>
  <view class="skeleton skeleton--text-sm" style="width:40%;margin:12rpx auto 60rpx"></view>
  <view class="skeleton skeleton--block" style="width:460rpx;height:660rpx;margin:0 auto 40rpx;border-radius:32rpx;"></view>
  <view class="skeleton skeleton--text" style="width:30%;margin-bottom:20rpx"></view>
</view>

<!-- ===== 错误状态 ===== -->
<view class="page" wx:elif="{{pageError}}">
  <view class="error-state">
    <text class="error-text">连接中断</text>
    <text class="error-hint">{{pageError}}</text>
    <button class="btn-ghost" bindtap="onRetry">重新连接</button>
  </view>
</view>

<!-- ===== 主内容 ===== -->
<view class="page" wx:else>
  <!-- E3 奶油底色氛围光斑（真实插画之外仅作底色） -->
  <view class="wash wash-pink"></view>
  <view class="wash wash-gold"></view>

  <!-- 右下角淡粉水彩小花点缀（真实资产 · 从底部探出） -->
  <view class="hint-flower">
    <image class="hint-flower-img" src="/assets/web/hint-flower.jpg" mode="aspectFill" aria-label="淡粉水彩小花" />
  </view>

  <!-- ===== 顶部：品牌 · 日期（左）｜星座徽章（右，极小不抢戏 · 点击可改星座） ===== -->
  <view class="topbar anim-fade-in-up-1">
    <view class="tb-left">
      <text class="brand">星光映照</text>
      <view class="date-row">
        <view class="gold-dot"></view>
        <text class="date-text">{{d.fmtDate()}}</text>
      </view>
    </view>
    <view class="zodiac-badge" wx:if="{{zodiacBadge}}" bindtap="onGoZodiac" role="button" aria-label="点击修改星座 {{zodiacBadge}}">
      <text class="zodiac-badge-text">{{zodiacBadge}}</text>
    </view>
    <view class="zodiac-badge zodiac-badge--empty" wx:else bindtap="onGoZodiac" role="button" aria-label="选择你的星座">
      <text class="zodiac-badge-text">选择星座 ✦</text>
    </view>
  </view>

  <!-- 天象小字：一行 · 注脚 -->
  <view class="sky-note">
    <text class="sky-moon">☾</text>
    <text class="sky-note-text">{{skyNote}}</text>
  </view>

  <!-- ===== 中央绝对主角：大牌面 ===== -->
  <view class="card-zone anim-fade-in-up-2">

    <!-- BEFORE DRAW — 月亮牌静候轻触（唯一 CTA） -->
    <view class="mat-wrap {{!hasDrawnToday && !dailyCard ? 'card-ready' : ''}}" wx:if="{{!dailyCard && !dailyCardRestoring}}" bindtap="drawDailyCard" animation="{{cardAnimData}}" role="button" aria-label="翻开今日之牌">
      <view class="mat art-main">
        <view class="ripple-box">
          <view class="ripple-circle {{rippleActive?'ripple-run':''}}"></view>
        </view>
        <image class="art-img" src="/assets/web/moon-card.jpg" mode="aspectFill" aria-label="月亮与安睡兔子的水彩插画" />
        <text class="paint-spark">✦</text>
        <view class="card-body {{shaking?'card-shake':''}}">
          <text class="card-hint-big">轻触翻开今日牌面</text>
          <text class="card-hint-sm">开启今日指引</text>
        </view>
      </view>
    </view>

    <!-- RESTORING — 重新拉取今日牌面时的骨架 -->
    <view class="mat-wrap" wx:elif="{{dailyCardRestoring}}">
      <view class="mat art-main">
        <view class="skeleton skeleton--block" style="width:100%;height:100%;border-radius:26rpx;"></view>
      </view>
    </view>

    <!-- AFTER DRAW — 已抽牌面：真实牌面 -->
    <view class="mat-wrap {{dailyCardFlipped ? 'daily-card--flipped' : ''}}" wx:else bindtap="onDailyCardTap" data-today-flipped="{{dailyCardFlipped}}" role="button" aria-label="查看今日卡牌详解">
      <view class="mat art-main">
        <view class="sparkle-field" wx:if="{{!dailyCardFlipped}}">
          <view class="sparkle s1"></view>
          <view class="sparkle s2"></view>
          <view class="sparkle s3"></view>
        </view>
        <view class="art-thumb-wrap {{dailyCardImgError ? 'art-thumb-error' : ''}}">
          <image wx:if="{{dailyCard.imagePath && !dailyCardImgError}}" class="art-img" src="{{dailyCard.imagePath}}" mode="aspectFill" binderror="onDailyCardImgError" aria-label="今日塔罗 — {{dailyCard.name_zh || dailyCard.name_cn || '每日一牌'}}" />
          <view wx:elif="{{dailyCardImgError}}" class="art-thumb-fallback">
            <text class="thumb-fallback-name">{{dailyCard.name_zh}}</text>
          </view>
          <view wx:else class="art-thumb-fallback"></view>
        </view>
        <view wx:if="{{dailyCardFlipped}}" class="flip-badge">已学习 ✓</view>
      </view>
    </view>
  </view>

  <!-- ===== 牌名 + 今日牌语（主角的注脚） ===== -->
  <view class="card-name anim-fade-in-up-2" wx:if="{{dailyCard}}">
    <text class="card-name-cn">{{dailyCard.name_zh}}</text>
    <view class="card-name-dot"></view>
    <text class="card-name-en" wx:if="{{dailyCard.name_en}}">{{dailyCard.name_en}}</text>
  </view>
  <view class="card-name anim-fade-in-up-2" wx:else>
    <text class="card-name-cn">月亮牌</text>
    <view class="card-name-dot"></view>
    <text class="card-name-en">THE MOON</text>
  </view>
  <view class="card-phrase anim-fade-in-up-2">
    <text>{{cardPhrase}}</text>
  </view>

  <!-- ===== 能量注脚：一行 · 极淡细金条（牌的补充，不是并列功能）｜4 项均可点击 → 能量详情 ===== -->
  <view class="energy anim-fade-in-up-2" wx:if="{{energyItems.length > 0}}">
    <text class="eg-label">今日能量</text>
    <view class="eg-sep"></view>
    <view class="eg {{item.hot ? 'eg-hot' : ''}}" wx:for="{{energyItems}}" wx:key="key"
          bindtap="onEnergyTap" data-dim="{{item.key}}" role="button" aria-label="查看{{item.name}}能量详情 {{item.score}}分" hover-class="eg-pressed">
      <text class="eg-name">{{item.name}}</text>
      <text class="eg-score">{{item.score}}</text>
    </view>
  </view>

  <!-- ===== 今日星光卡：星光色【色块】 · 星光数 · 星象宜忌（Task 4 · 数据缺失整行隐藏） ===== -->
  <view class="star-guidance anim-fade-in-up-2" wx:if="{{starInfoVisible}}">
    <text class="sg-label">星光色</text>
    <view class="sg-swatch" style="background: {{starColor}};" aria-label="今日星光色"></view>
    <view class="sg-sep"></view>
    <text class="sg-text">星光数 {{starNumber}}</text>
    <view class="sg-sep"></view>
    <text class="sg-text">星象宜忌
      <text class="sg-advice sg-advice--do">{{adviceDo}}</text>
      <text class="sg-text sg-sep-inline">/</text>
      <text class="sg-advice sg-advice--dont">{{adviceDont}}</text>
    </text>
  </view>

  <!-- ===== 今日天象链接 → 星空时刻表（T3-4 · 星象日历 + 节点活动） ===== -->
  <view class="astral-link anim-fade-in-up-2" wx:if="{{starInfoVisible}}" bindtap="onGoAstralCalendar" role="button" aria-label="查看今日天象 · 打开星空时刻表" hover-class="astral-link--press">
    <text class="astral-link-emoji">☾</text>
    <text class="astral-link-text">今日天象 · 星空时刻表 ›</text>
  </view>

  <!-- ===== 联动解读：牌 × 天象（主角的展开） ===== -->
  <view class="link anim-fade-in-up-2">
    <text class="link-line1">{{linkLine1}}</text>
    <text class="link-line2">{{linkLine2}}</text>
  </view>

  <!-- ===== 明日之牌预告 — 回流钩子（制造期待 · 不展示牌面 · 未抽牌也可见） ===== -->
  <view class="tomorrow" bindtap="onTomorrowHintTap" role="button" aria-label="明日之牌预告" hover-class="trow-pressed">
    <view class="tline"></view>
    <view class="trow">
      <text class="t-lock">✦</text>
      <text class="t-text">明日之牌 · 待明日揭晓</text>
    </view>
  </view>

  <!-- ===== 抽牌后动作：查看详解（主角的展开入口） ===== -->
  <view wx:if="{{dailyCard}}" class="after-row">
    <view class="see-detail" bindtap="onDailyCardTap" role="button" aria-label="查看今日卡牌详解" hover-class="card-pressed">
      <text>查看详解 →</text>
    </view>
    <view class="daily-share-link" bindtap="onShareDailyCard" role="button" aria-label="保存今日卡牌">
      <text>保存今日卡牌 ✦</text>
    </view>
  </view>

  <!-- ===== 底部一行入口（保留功能 · 降权为注脚） ===== -->
  <view class="foot-entry-row anim-fade-in-up-3">
    <view class="foot-entry" bindtap="onGoOracle" role="button" aria-label="进入神谕选择牌阵" hover-class="card-pressed">
      <text class="foot-entry-emoji">🔮</text>
      <text class="foot-entry-label">占卜 · 牌阵</text>
    </view>
    <view class="foot-entry" bindtap="onGoCommunity" role="button" aria-label="进入星光树洞" hover-class="card-pressed">
      <text class="foot-entry-emoji">🕊️</text>
      <text class="foot-entry-label">星光树洞</text>
    </view>
    <view class="foot-entry" bindtap="onGoDiary" role="button" aria-label="进入星光手账" hover-class="card-pressed">
      <text class="foot-entry-emoji">✧</text>
      <text class="foot-entry-label">星光手账</text>
    </view>
    <view class="foot-entry" bindtap="onGoAstralCalendar" role="button" aria-label="进入星空时刻表" hover-class="card-pressed">
      <text class="foot-entry-emoji">☾</text>
      <text class="foot-entry-label">星空时刻表</text>
    </view>
    <view wx:if="{{pendingReading}}" class="foot-entry" bindtap="onContinueReading" role="button" aria-label="继续上次未完成的解读" hover-class="card-pressed">
      <text class="foot-entry-emoji">✦</text>
      <text class="foot-entry-label">继续解读</text>
    </view>
  </view>

  <!-- 免费次数小字（并入注脚 · 保留原数据绑定） -->
  <view wx:if="{{!isMember && dailyCard}}" class="quota-line">
    <text wx:if="{{freeReadingsUsed < freeReadingsTotal}}" class="quota-text">今日免费解读 {{freeReadingsUsed}}/{{freeReadingsTotal}}</text>
    <text wx:elif="{{freeReadingsUsed >= freeReadingsTotal}}" class="quota-text quota-text--exhausted" bindtap="onGoMembership">今日次数已用完 · 补充 →</text>
  </view>

  <!-- ===== 每日一牌打卡海报（保留） ===== -->
  <share-poster
    wx:if="{{dailyCard}}"
    mode="daily"
    visible="{{showDailySharePoster}}"
    cardImagePath="{{dailyShareCardImage}}"
    cardName="{{dailyShareCardName}}"
    dateText="{{dailyShareCardDate}}"
    streak="{{streak}}"
    bind:close="onCloseDailySharePoster"
    bind:share="onShareDailyPosterToFriend"
  />
</view>
