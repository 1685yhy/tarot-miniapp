<!-- pages/index/index.wxml -->

<!-- ===== 加载骨架 ===== -->
<view class="page" wx:if="{{pageLoading}}">
  <view class="skeleton skeleton--circle" style="margin:100rpx auto 40rpx"></view>
  <view class="skeleton skeleton--text" style="width:60%;margin:0 auto"></view>
  <view class="skeleton skeleton--text-sm" style="width:40%;margin:12rpx auto 60rpx"></view>
  <view class="skeleton skeleton--block" style="margin-bottom:40rpx"></view>
  <view class="skeleton skeleton--text" style="width:30%;margin-bottom:20rpx"></view>
  <view class="skeleton-grid-3">
    <view class="skeleton skeleton--card-sm"></view>
    <view class="skeleton skeleton--card-sm"></view>
    <view class="skeleton skeleton--card-sm"></view>
    <view class="skeleton skeleton--card-sm"></view>
    <view class="skeleton skeleton--card-sm"></view>
    <view class="skeleton skeleton--card-sm"></view>
  </view>
</view>

<!-- ===== 错误状态 ===== -->
<view class="page" wx:elif="{{pageError}}">
  <view class="error-state">
    <text class="error-text">连接中断</text>
    <text class="error-hint">{{pageError}}</text>
    <button class="btn-ghost" bindtap="onRetry">重新连接</button>
  </view>
</view>

<!-- ===== 主内容 ===== -->
<view class="page" wx:else>
  <!-- Parallax star layers -->
  <view class="stars-layer stars-distant"></view>
  <view class="stars-layer stars-mid"></view>
  <view class="stars-layer stars-close"></view>

  <!-- Nebula glows -->
  <view class="nebula nebula-lavender"></view>
  <view class="nebula nebula-gold"></view>

  <!-- Shooting star (rare easter egg) -->
  <view class="shooting-star"></view>

  <!-- Hero -->
  <view class="hero anim-fade-in-up-1">
    <!-- Concentric glow rings -->
    <view class="hero-glow-rings"></view>
    <text class="title-1" style="text-align:center;display:block">星光映照</text>
    <text class="body-text" style="text-align:center;display:block;margin-top:12rpx">每日一牌，遇见自己</text>

    <!-- Daily reminder badge -->
    <view wx:if="{{hasDrawnToday}}" class="daily-updated-badge anim-slide-up">✓ 今日运势已更新</view>
    <view wx:elif="{{showReminder && !dailyCard}}" class="daily-reminder-badge anim-gentle-pulse">今日运势待开启</view>
  </view>

  <!-- ===== Step 1 引导气泡（每日卡牌上方） ===== -->
  <view class="onboarding-bubble-wrap {{showOnboarding && onboardingStep === 1 ? 'bubble-visible' : ''}}">
    <view class="onboarding-bubble" bindtap="onNextOnboarding">
      <text class="bubble-text">每天一张牌，学会认识自己的内心 ✦</text>
      <text class="bubble-action">轻触卡牌开始</text>
      <view class="bubble-arrow"></view>
    </view>
  </view>

  <!-- 每日一牌 — 教学入口 (v2.0) -->
  <view class="anim-fade-in-up-2" style="margin:60rpx 0">

    <!-- BEFORE DRAW — card awaiting tap with shimmer, sparkles, float -->
    <view class="daily-card-wrap {{!hasDrawnToday && !dailyCard ? 'card-ready' : ''}}" wx:if="{{!dailyCard && !dailyCardRestoring}}" bindtap="drawDailyCard" animation="{{cardAnimData}}">
      <view class="card card-warm card-float">
        <!-- Shimmer sweep — light glint across surface -->
        <view class="card-shimmer"></view>
        <!-- Orbiting sparkle dots -->
        <view class="card-sparkles"></view>
        <!-- Ripple effect container (triggers via rippleActive state) -->
        <view class="ripple-box">
          <view class="ripple-circle {{rippleActive?'ripple-run':''}}"></view>
        </view>
        <!-- Card content (shakes on tap via shaking state) -->
        <view class="card-body {{shaking?'card-shake':''}}">
          <text style="font-size:52rpx;display:block;margin-bottom:24rpx">🌟</text>
          <text class="title-4" style="display:block;margin-bottom:8rpx">轻触卡片</text>
          <text class="body-sm">开启今日指引</text>
        </view>
      </view>
    </view>

    <!-- RESTORING — skeleton while re-fetching today's card -->
    <view class="daily-card-wrap" wx:elif="{{dailyCardRestoring}}">
      <view class="card card--teaching">
        <view class="skeleton skeleton--block" style="width:200rpx;height:280rpx;margin:0 auto 20rpx;border-radius:16rpx;"></view>
        <view class="skeleton skeleton--title" style="width:40%;margin:0 auto 12rpx;"></view>
        <view class="skeleton skeleton--text-sm" style="width:55%;margin:0 auto;"></view>
      </view>
    </view>

    <!-- AFTER DRAW — teaching entry card -->
    <view class="daily-card-wrap daily-card-teaching {{dailyCardFlipped ? 'daily-card--flipped' : ''}}" wx:else bindtap="onDailyCardTap" data-today-flipped="{{dailyCardFlipped}}">
      <view class="card card--teaching card-rise">
        <!-- Breathing glow overlay (only when not flipped) -->
        <view wx:if="{{!dailyCardFlipped}}" class="daily-card-glow-overlay"></view>

        <!-- Sparkle particles (only when not flipped) -->
        <view wx:if="{{!dailyCardFlipped}}" class="sparkle-field">
          <view class="sparkle s1"></view>
          <view class="sparkle s2"></view>
          <view class="sparkle s3"></view>
          <view class="sparkle s4"></view>
          <view class="sparkle s5"></view>
          <view class="sparkle s6"></view>
        </view>

        <!-- Card thumbnail -->
        <view class="daily-card-thumb-wrap">
          <image wx:if="{{dailyCard.imagePath}}" class="daily-card-thumb" src="{{dailyCard.imagePath}}" mode="aspectFit" />
        </view>

        <!-- Flipped badge -->
        <view wx:if="{{dailyCardFlipped}}" class="daily-card-badge">已学习 ✓</view>

        <!-- Card name -->
        <text class="title-4 daily-card-name">{{dailyCard.name_zh}}</text>

        <!-- CTA text -->
        <text wx:if="{{!dailyCardFlipped}}" class="body-sm daily-card-cta">点击学习这张牌 ✦</text>
        <text wx:else class="body-xs daily-card-revisit">点击回顾今日学习</text>

        <!-- Streak badge (only if 2+ consecutive days) -->
        <view wx:if="{{streak >= 2}}" class="streak-badge">
          <image class="streak-icon" src="/images/icons/star_64.png" mode="aspectFit" />
          <text class="streak-count">连续 {{streak}} 天</text>
        </view>

        <!-- Collection progress ring -->
        <view class="collect-progress-wrap" wx:if="{{collectedCount > 0}}">
          <view class="collect-progress-ring">
            <view class="ring-bg"></view>
            <view class="ring-fill" style="--progress: {{collectedCount / 22}}"></view>
            <text class="ring-text">{{collectedCount}}/22</text>
          </view>
          <text class="ring-label">大牌收集</text>
        </view>
      </view>
    </view>

  </view>

  <!-- 未完成解读恢复入口 -->
  <view wx:if="{{pendingReading}}" class="anim-fade-in-up-2" style="margin-top:30rpx" bindtap="onContinueReading">
    <view class="card card-press pending-reading-card">
      <view class="pending-reading-left">
        <view class="pending-reading-icon-wrap">
          <image class="pending-reading-icon" src="/images/icons/star_64.png" mode="aspectFit" />
        </view>
        <view>
          <text class="body-sm pending-reading-label">上次未完成的解读</text>
          <text class="body-xs pending-reading-hint">继续 →</text>
        </view>
      </view>
      <text class="pending-reading-arrow">→</text>
    </view>
  </view>

  <!-- 今日记录入口 -->
  <view class="anim-fade-in-up-2" style="margin-top:30rpx" bindtap="onGoDiary">
    <view class="card card-press diary-entry-card">
      <view class="diary-entry-left">
        <image class="diary-entry-icon" src="/images/icons/diary_64.png" mode="aspectFit" />
        <view>
          <text class="body-sm diary-entry-label">记录今天</text>
          <text wx:if="{{dailyCard}}" class="body-xs diary-entry-hint">和「{{dailyCard.name_zh}}」说说话</text>
        </view>
      </view>
      <text class="diary-entry-arrow">→</text>
    </view>
  </view>

  <!-- 免费次数提示（进度条） -->
  <view class="free-quota-bar anim-fade-in-up-3">
    <view class="quota-progress-wrap" wx:if="{{!isMember}}">
      <view class="quota-progress" style="width: {{(freeReadingsTotal - freeReadingsUsed) / freeReadingsTotal * 100}}%"></view>
    </view>
    <text class="quota-text" wx:if="{{!isMember && freeReadingsUsed < freeReadingsTotal}}">今日免费解读 {{freeReadingsUsed}}/{{freeReadingsTotal}} · 明日0点重置</text>
    <text class="quota-text quota-text--exhausted" wx:elif="{{!isMember && freeReadingsUsed >= freeReadingsTotal}}">今日免费 {{freeReadingsTotal}}/{{freeReadingsTotal}} 次已用完 · 明日0点重置</text>
  </view>

  <!-- 9.9新人专享CTA -->
  <view class="hero-cta anim-fade-in-up-3" bindtap="onStartFirstReading" wx:if="{{!isMember && freeReadingsUsed === 0}}">
    <view class="hero-cta-glow"></view>
    <text class="hero-cta-title">9.9元 · 首次AI深度解读</text>
    <text class="hero-cta-sub">新人专享 · 三牌占卜 · 行动建议</text>
  </view>

  <!-- 牌阵 -->
  <view class="section anim-fade-in-up-3">
    <text class="section-title">选择牌阵</text>
    <view class="spread-grid-2">
      <view class="card card-press spread-card" bindtap="navigateToReading" data-type="three_card" animation="{{spreadAnimData[0]}}">
        <view class="spread-tag spread-tag-free">免费</view>
        <image class="spread-icon" src="/images/icons/theme_general_64.png" mode="aspectFit" />
        <text class="body-sm">三牌占卜</text>
        <text class="body-xs">过去·现在·未来</text>
      </view>
      <view class="card card-press spread-card" bindtap="navigateToReading" data-type="triangle" animation="{{spreadAnimData[1]}}">
        <view class="spread-tag spread-tag-premium">会员</view>
        <image class="spread-icon" src="/images/icons/theme_love_64.png" mode="aspectFit" />
        <text class="body-sm">恋人三角</text>
        <text class="body-xs">感情关系深度解读</text>
        <view class="spread-theme-chip spread-theme-chip--love">爱情</view>
      </view>
      <view class="card card-press spread-card" bindtap="navigateToReading" data-type="celtic_cross" animation="{{spreadAnimData[2]}}">
        <view class="spread-tag spread-tag-premium">会员</view>
        <image class="spread-icon" src="/images/icons/theme_general_64.png" mode="aspectFit" />
        <text class="body-sm">凯尔特十字</text>
        <text class="body-xs">全方位综合解牌</text>
      </view>
      <view class="card card-press spread-card" bindtap="navigateToReading" data-type="career" animation="{{spreadAnimData[3]}}">
        <view class="spread-tag spread-tag-premium">会员</view>
        <image class="spread-icon" src="/images/icons/theme_career_64.png" mode="aspectFit" />
        <text class="body-sm">事业牌阵</text>
        <text class="body-xs">职场方向与机遇</text>
        <view class="spread-theme-chip spread-theme-chip--career">事业</view>
      </view>
    </view>
    <view class="card card-press more-spreads" bindtap="goToAllSpreads" animation="{{spreadAnimData[4]}}">
      <text class="more-text anim-gentle-pulse">查看更多 · 共10种牌阵</text>
      <text class="more-arrow">→</text>
    </view>

    <!-- 塔罗简介 -->
    <view class="tarot-explainer-wrap">
      <text class="tarot-explainer-link" bindtap="showTarotExplainer">什么是塔罗？</text>
    </view>
  </view>
</view>
