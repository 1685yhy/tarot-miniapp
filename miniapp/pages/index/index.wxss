/* ============================================================
   "Dawn Garden" — 晨光花园 设计系统 v1.0
   ============================================================
   色彩基调：暖奶油 × 柔玫瑰 × 木质暖灰
   设计理念：温柔、亲密、有呼吸感
   ============================================================ */

/* ===== 0. 设计标记变量 ===== */
:root {
  --rose-blush: #E8B4B4;
  --rose-soft: #D4A0A0;
  --rose-deep: #C48888;
  --gold-leaf: #C9A87C;
  --gold-soft: #E0C8A0;
  --cream-bg: #FDF6EC;
  --cream-light: #FFFBF5;
  --cream-card: #FFF8F0;
  --charcoal-warm: #3D2C2E;
  --charcoal-soft: #5A4446;
  --sage-soft: #A8B5A0;
  --rose-glow: rgba(212, 160, 160, 0.25);
  --gold-glow: rgba(201, 168, 124, 0.20);
  --shadow-soft: 0 8rpx 32rpx rgba(61, 44, 46, 0.08);
  --shadow-card: 0 12rpx 48rpx rgba(61, 44, 46, 0.10), 0 4rpx 16rpx rgba(61, 44, 46, 0.06);
  --shadow-rose: 0 4rpx 20rpx rgba(212, 160, 160, 0.15);
}

/* ===== 1. 动画系统 ===== */

/* ——— 温柔脉动（卡牌呼吸） ——— */
@keyframes pulse-glow {
  0%, 100% {
    box-shadow:
      0 0 20rpx rgba(212, 160, 160, 0.08),
      0 0 40rpx rgba(201, 168, 124, 0.04),
      inset 0 0 20rpx rgba(212, 160, 160, 0.02);
  }
  50% {
    box-shadow:
      0 0 40rpx rgba(212, 160, 160, 0.18),
      0 0 80rpx rgba(201, 168, 124, 0.08),
      0 0 120rpx rgba(212, 160, 160, 0.03),
      inset 0 0 40rpx rgba(212, 160, 160, 0.05);
  }
}

/* ——— 花苞绽放（温柔揭示） ——— */
@keyframes card-bloom {
  0% {
    transform: scale(0.90);
    opacity: 0;
    filter: brightness(1.3) saturate(0.5);
  }
  30% {
    opacity: 0.3;
    transform: scale(0.95);
  }
  50% {
    opacity: 0.6;
    transform: scale(1.01);
    filter: brightness(1.1) saturate(0.8);
  }
  70% {
    opacity: 0.85;
    transform: scale(0.99);
  }
  100% {
    transform: scale(1);
    opacity: 1;
    filter: brightness(1) saturate(1);
  }
}

/* ——— 萤火虫漂浮 ——— */
@keyframes firefly-float {
  0%, 100% {
    transform: translate(0, 0) scale(1);
    opacity: 0;
  }
  10% {
    opacity: 0.6;
  }
  30% {
    transform: translate(15rpx, -20rpx) scale(1.2);
    opacity: 0.9;
  }
  50% {
    transform: translate(-10rpx, -40rpx) scale(0.8);
    opacity: 0.5;
  }
  70% {
    transform: translate(8rpx, -55rpx) scale(1.1);
    opacity: 0.7;
  }
  90% {
    opacity: 0.3;
  }
  100% {
    transform: translate(-5rpx, -70rpx) scale(0.5);
    opacity: 0;
  }
}

/* ——— 萤火虫辉光脉冲 ——— */
@keyframes firefly-glow {
  0%, 100% {
    box-shadow: 0 0 4rpx rgba(255, 200, 120, 0.2);
  }
  50% {
    box-shadow: 0 0 12rpx rgba(255, 200, 120, 0.6), 0 0 24rpx rgba(255, 200, 120, 0.2);
  }
}

/* ——— 标题优雅浮现 ——— */
@keyframes title-appear {
  0% {
    opacity: 0;
    transform: translateY(12rpx);
    letter-spacing: 24rpx;
  }
  100% {
    opacity: 1;
    transform: translateY(0);
    letter-spacing: 16rpx;
  }
}

/* ——— 副标题淡入 ——— */
@keyframes subtitle-appear {
  0% { opacity: 0; transform: translateY(8rpx); }
  100% { opacity: 0.85; transform: translateY(0); }
}

/* ——— 辉光分隔线 ——— */
@keyframes line-soft-glow {
  0%, 100% { opacity: 0.3; }
  50% { opacity: 0.8; }
}

/* ——— 柔和背景波动 ——— */
@keyframes bg-wave {
  0%, 100% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
}

/* ——— 抽取中：呼吸脉冲 ——— */
@keyframes draw-pulse {
  0%, 100% {
    box-shadow:
      0 0 20rpx rgba(212, 160, 160, 0.10),
      0 0 40rpx rgba(201, 168, 124, 0.04);
    border-color: rgba(212, 160, 160, 0.25);
  }
  50% {
    box-shadow:
      0 0 50rpx rgba(212, 160, 160, 0.25),
      0 0 100rpx rgba(201, 168, 124, 0.10),
      0 0 150rpx rgba(212, 160, 160, 0.05);
    border-color: rgba(212, 160, 160, 0.45);
  }
}

/* ——— 抽取中：温柔光环 ——— */
@keyframes draw-aura {
  0% { transform: translate(-50%, -50%) rotate(0deg); opacity: 0.2; }
  50% { opacity: 0.6; }
  100% { transform: translate(-50%, -50%) rotate(360deg); opacity: 0.2; }
}

/* ——— 抽取中：粒子升腾 ——— */
@keyframes draw-particle-rise {
  0% { transform: translateY(0) scale(1); opacity: 0; }
  20% { opacity: 0.5; }
  50% { opacity: 0.7; transform: translateY(-50rpx) scale(0.6); }
  100% { transform: translateY(-100rpx) scale(0); opacity: 0; }
}

/* ——— 抽取中：光纹扫过 ——— */
@keyframes draw-sweep {
  0% { background-position: 200% 0; }
  100% { background-position: -100% 0; }
}


/* ===== 2. 萤火虫粒子背景 ===== */

.firefly-particle {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  width: 6rpx;
  height: 6rpx;
  background: radial-gradient(circle at 50% 50%, #FFE4B5, #FFD700);
  animation: firefly-float 8s ease-in-out infinite, firefly-glow 3s ease-in-out infinite;
}

.firefly-particle:nth-child(1) { top: 5%; left: 15%; animation-delay: 0s, 0.5s; }
.firefly-particle:nth-child(2) { top: 12%; left: 75%; width: 5rpx; height: 5rpx; animation-delay: 1.2s, 1.8s; }
.firefly-particle:nth-child(3) { top: 20%; left: 40%; width: 7rpx; height: 7rpx; animation-delay: 2.5s, 0.2s; }
.firefly-particle:nth-child(4) { top: 30%; left: 60%; width: 4rpx; height: 4rpx; animation-delay: 3.8s, 2.2s; }
.firefly-particle:nth-child(5) { top: 8%; left: 50%; width: 6rpx; height: 6rpx; animation-delay: 0.8s, 1.0s; }
.firefly-particle:nth-child(6) { top: 18%; left: 85%; width: 5rpx; height: 5rpx; animation-delay: 4.2s, 0.7s; }
.firefly-particle:nth-child(7) { top: 35%; left: 25%; width: 4rpx; height: 4rpx; animation-delay: 2.0s, 3.0s; }
.firefly-particle:nth-child(8) { top: 45%; left: 70%; width: 6rpx; height: 6rpx; animation-delay: 5.5s, 1.5s; }
.firefly-particle:nth-child(9) { top: 3%; left: 90%; width: 5rpx; height: 5rpx; animation-delay: 1.6s, 2.8s; }
.firefly-particle:nth-child(10) { top: 25%; left: 8%; width: 4rpx; height: 4rpx; animation-delay: 3.0s, 0.9s; }
.firefly-particle:nth-child(11) { top: 40%; left: 45%; width: 5rpx; height: 5rpx; animation-delay: 6.0s, 2.5s; }
.firefly-particle:nth-child(12) { top: 15%; left: 30%; width: 7rpx; height: 7rpx; animation-delay: 4.8s, 1.2s; }


/* ===== 3. 英雄区 — 温柔曙光 ===== */

.hero {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0 80rpx;
  overflow: hidden;
}

/* ——— 曙光渐变圆（替代旋转环） ——— */
.hero-glow-circle {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 460rpx;
  height: 460rpx;
  transform: translate(-50%, -55%);
  border-radius: 50%;
  background: radial-gradient(
    circle at 50% 50%,
    rgba(232, 180, 180, 0.20) 0%,
    rgba(255, 200, 160, 0.12) 25%,
    rgba(255, 220, 190, 0.06) 45%,
    rgba(253, 246, 236, 0.02) 60%,
    transparent 80%
  );
  pointer-events: none;
  z-index: 0;
  animation: bg-wave 8s ease-in-out infinite;
  background-size: 200% 200%;
}

/* ——— 内圈更暖的辉光 ——— */
.hero-glow-circle::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 220rpx;
  height: 220rpx;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: radial-gradient(
    circle at 50% 50%,
    rgba(255, 210, 180, 0.25) 0%,
    rgba(232, 180, 180, 0.10) 35%,
    transparent 70%
  );
  pointer-events: none;
}

/* ——— 日出圆心装饰 ——— */
.hero-icon {
  position: relative;
  z-index: 1;
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: radial-gradient(
    circle at 50% 50%,
    rgba(255, 215, 185, 0.30) 0%,
    rgba(232, 180, 180, 0.12) 40%,
    rgba(201, 168, 124, 0.04) 65%,
    transparent 85%
  );
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  box-shadow:
    0 0 60rpx rgba(255, 200, 160, 0.10),
    0 0 120rpx rgba(232, 180, 180, 0.06);
}

.hero-icon-inner {
  font-size: 64rpx;
  display: block;
  animation: firefly-glow 4s ease-in-out infinite;
}

/* ——— 主标题 ——— */
.hero-title {
  position: relative;
  z-index: 1;
  font-size: 54rpx;
  font-weight: 600;
  color: #3D2C2E;
  letter-spacing: 16rpx;
  line-height: 1.3;
  margin-bottom: 16rpx;
  animation: title-appear 1.2s ease-out forwards;
  /* 优雅衬线风格 — 用系统衬线字体 */
  font-family: "Songti SC", "STSongti", "Noto Serif CJK SC", "Source Han Serif SC", serif;
}

/* ——— 副标题 ——— */
.hero-subtitle {
  position: relative;
  z-index: 1;
  font-size: 26rpx;
  color: #D4A0A0;
  letter-spacing: 8rpx;
  animation: subtitle-appear 1s ease-out 0.4s both;
  font-weight: 400;
  opacity: 0.85;
}


/* ===== 4. 每日一牌 — 温柔纸牌 ===== */

.daily-card-wrapper {
  margin: 48rpx 0 80rpx;
  position: relative;
}

/* ——— 抽取前：优雅纸牌 ——— */
.card-daily-back {
  position: relative;
  overflow: hidden;
  background: linear-gradient(
    150deg,
    #FFFBF5 0%,
    #FFF8F0 40%,
    #FEF5EA 100%
  );
  border: 2rpx solid rgba(201, 168, 124, 0.20);
  border-radius: 24rpx;
  padding: 60rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 240rpx;
  animation: pulse-glow 3.5s ease-in-out infinite;
  transition: all 0.3s ease-out;

  box-shadow:
    0 12rpx 48rpx rgba(61, 44, 46, 0.08),
    0 4rpx 16rpx rgba(61, 44, 46, 0.05),
    0 0 30rpx rgba(212, 160, 160, 0.06),
    inset 0 0 40rpx rgba(201, 168, 124, 0.02);
}

/* ——— 纸牌左上角金/玫瑰装饰 ——— */
.card-daily-back::before {
  content: '';
  position: absolute;
  top: 14rpx;
  left: 14rpx;
  width: 36rpx;
  height: 36rpx;
  border-top: 2rpx solid rgba(201, 168, 124, 0.18);
  border-left: 2rpx solid rgba(201, 168, 124, 0.18);
  border-radius: 12rpx 0 0 0;
  pointer-events: none;
}

/* ——— 右下角玫瑰装饰 ——— */
.card-daily-back::after {
  content: '';
  position: absolute;
  bottom: 14rpx;
  right: 14rpx;
  width: 36rpx;
  height: 36rpx;
  border-bottom: 2rpx solid rgba(212, 160, 160, 0.18);
  border-right: 2rpx solid rgba(212, 160, 160, 0.18);
  border-radius: 0 0 12rpx 0;
  pointer-events: none;
}

.card-daily-back:active {
  transform: scale(0.97);
  border-color: rgba(212, 160, 160, 0.35);
  box-shadow:
    0 6rpx 24rpx rgba(61, 44, 46, 0.12),
    0 2rpx 8rpx rgba(61, 44, 46, 0.08),
    0 0 50rpx rgba(212, 160, 160, 0.20),
    inset 0 0 40rpx rgba(212, 160, 160, 0.03);
}

.card-daily-back .heading-3 {
  position: relative;
  z-index: 1;
  color: #3D2C2E;
  font-weight: 500;
  letter-spacing: 4rpx;
  margin-bottom: 8rpx;
  font-size: 30rpx;
}

.card-daily-free {
  position: relative;
  z-index: 1;
  color: #C9A87C;
  font-size: 22rpx;
  letter-spacing: 6rpx;
  font-weight: 400;
}

/* ——— 抽取后：温柔绽开牌面 ——— */
.card-daily-result {
  position: relative;
  overflow: hidden;
  background: linear-gradient(
    150deg,
    #FFFBF5 0%,
    #FFF8F0 50%,
    #FEF5EA 100%
  );
  border: 2rpx solid rgba(201, 168, 124, 0.22);
  border-radius: 24rpx;
  padding: 60rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 240rpx;
  animation: card-bloom 1s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;

  box-shadow:
    0 12rpx 48rpx rgba(61, 44, 46, 0.08),
    0 4rpx 16rpx rgba(61, 44, 46, 0.05),
    0 0 40rpx rgba(212, 160, 160, 0.12),
    0 0 80rpx rgba(201, 168, 124, 0.04);
}

/* 左上金角 */
.card-daily-result::before {
  content: '';
  position: absolute;
  top: 14rpx;
  left: 14rpx;
  width: 40rpx;
  height: 40rpx;
  border-top: 2.5rpx solid rgba(201, 168, 124, 0.22);
  border-left: 2.5rpx solid rgba(201, 168, 124, 0.22);
  border-radius: 12rpx 0 0 0;
  pointer-events: none;
}

/* 右下玫瑰角 */
.card-daily-result::after {
  content: '';
  position: absolute;
  bottom: 14rpx;
  right: 14rpx;
  width: 40rpx;
  height: 40rpx;
  border-bottom: 2.5rpx solid rgba(212, 160, 160, 0.22);
  border-right: 2.5rpx solid rgba(212, 160, 160, 0.22);
  border-radius: 0 0 12rpx 0;
  pointer-events: none;
}

.card-daily-result .heading-2 {
  position: relative;
  z-index: 1;
  color: #3D2C2E;
}

.card-daily-result .text-secondary {
  position: relative;
  z-index: 1;
  letter-spacing: 2rpx;
  color: #5A4446;
}


/* ===== 5. 抽取中状态 — 温柔仪式 ===== */

.card-daily-back.drawing {
  animation: none;
  border-color: rgba(212, 160, 160, 0.25);
  animation: draw-pulse 2s ease-in-out infinite;
}

/* 温柔光环1（外层） */
.card-daily-back.drawing::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 320rpx;
  height: 320rpx;
  margin: 0;
  border: 1.5rpx solid rgba(212, 160, 160, 0.10);
  border-radius: 50%;
  animation: draw-aura 3s linear infinite;
  pointer-events: none;
  z-index: 2;
  color: transparent;
  font-size: 0;
}

/* 温柔光环2（内层，反转） */
.card-daily-back.drawing::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 260rpx;
  height: 260rpx;
  margin: 0;
  border: 1rpx solid rgba(201, 168, 124, 0.08);
  border-radius: 50%;
  animation: draw-aura 2.5s linear infinite reverse;
  pointer-events: none;
  z-index: 2;
  color: transparent;
  font-size: 0;
}

/* 粒子升腾 */
.card-daily-back.drawing .ritual-particle {
  display: block;
  position: absolute;
  width: 4rpx;
  height: 4rpx;
  background: #FFD700;
  border-radius: 50%;
  box-shadow: 0 0 6rpx rgba(255, 215, 0, 0.3);
  pointer-events: none;
  z-index: 3;
  opacity: 0;
}

.card-daily-back.drawing .ritual-particle:nth-child(1) {
  bottom: 10%; left: 20%;
  animation: draw-particle-rise 2.2s ease-out 0s infinite;
}
.card-daily-back.drawing .ritual-particle:nth-child(2) {
  bottom: 15%; left: 40%;
  width: 3rpx; height: 3rpx;
  background: #E8B4B4;
  animation: draw-particle-rise 2.5s ease-out 0.4s infinite;
}
.card-daily-back.drawing .ritual-particle:nth-child(3) {
  bottom: 8%; left: 60%;
  width: 5rpx; height: 5rpx;
  background: #FFD700;
  animation: draw-particle-rise 2.0s ease-out 0.8s infinite;
}
.card-daily-back.drawing .ritual-particle:nth-child(4) {
  bottom: 12%; left: 75%;
  width: 3rpx; height: 3rpx;
  background: #E8B4B4;
  animation: draw-particle-rise 2.8s ease-out 1.2s infinite;
}
.card-daily-back.drawing .ritual-particle:nth-child(5) {
  bottom: 6%; left: 30%;
  width: 2rpx; height: 2rpx;
  background: rgba(201, 168, 124, 0.8);
  animation: draw-particle-rise 3s ease-out 1.6s infinite;
}
.card-daily-back.drawing .ritual-particle:nth-child(6) {
  bottom: 18%; left: 55%;
  width: 4rpx; height: 4rpx;
  background: #FFD700;
  animation: draw-particle-rise 2.4s ease-out 2.0s infinite;
}

/* 抽取中标题文字扫光 */
.card-daily-back.drawing .heading-3 {
  animation: draw-sweep 2.5s ease-in-out infinite;
  background: linear-gradient(
    90deg,
    #3D2C2E 0%,
    #D4A0A0 30%,
    #C9A87C 50%,
    #D4A0A0 70%,
    #3D2C2E 100%
  );
  background-size: 200% 100%;
  background-clip: text;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}


/* ===== 6. 牌阵入口 — 温柔桌卡 ===== */

.spread-section {
  margin-bottom: 80rpx;
}

.section-title {
  position: relative;
  color: #3D2C2E;
  letter-spacing: 4rpx;
  font-weight: 500;
  margin-bottom: 40rpx;
  padding-left: 24rpx;
  font-size: 28rpx;
}

/* 标题左侧玫瑰线 */
.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 4rpx;
  height: 55%;
  background: linear-gradient(180deg, #D4A0A0, #E8B4B4);
  border-radius: 4rpx;
  animation: line-soft-glow 3s ease-in-out infinite;
}

.spread-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
}

/* ——— 温柔卡牌 ——— */
.spread-grid .card {
  position: relative;
  background: #FFFBF5;
  border: 1rpx solid rgba(212, 160, 160, 0.10);
  border-radius: 20rpx;
  padding: 32rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  text-align: center;
  transition: all 0.3s ease-out;
  overflow: hidden;

  box-shadow:
    0 6rpx 24rpx rgba(61, 44, 46, 0.06),
    0 2rpx 8rpx rgba(61, 44, 46, 0.04);

  /* 左侧玫瑰色条 */
  border-left: 4rpx solid rgba(212, 160, 160, 0.25);
}

/* 装饰性右上角小玫瑰点 */
.spread-grid .card::after {
  content: '';
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(212, 160, 160, 0.12);
  pointer-events: none;
}

/* 图标容器 */
.spread-grid .card > text:first-child {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  font-size: 52rpx;
  background: radial-gradient(circle at 50% 50%, rgba(212, 160, 160, 0.08) 0%, transparent 70%);
  border-radius: 50%;
  margin-bottom: 8rpx;
  transition: all 0.3s ease-out;
  line-height: 1;
}

/* 温柔按下效果 (0.97x) */
.spread-grid .card:active {
  transform: scale(0.97);
  border-color: rgba(212, 160, 160, 0.25);
  box-shadow:
    0 10rpx 36rpx rgba(61, 44, 46, 0.10),
    0 4rpx 16rpx rgba(61, 44, 46, 0.06),
    0 0 30rpx rgba(212, 160, 160, 0.12);
  border-left-color: rgba(212, 160, 160, 0.45);
}

.spread-grid .card:active > text:first-child {
  background: radial-gradient(circle at 50% 50%, rgba(212, 160, 160, 0.18) 0%, transparent 70%);
  transform: scale(1.08);
}

/* 牌阵名称 */
.spread-grid .card .text-body {
  font-size: 24rpx;
  color: #3D2C2E;
  font-weight: 500;
  letter-spacing: 2rpx;
  position: relative;
  z-index: 1;
}

/* 描述文本 */
.spread-grid .card .text-dim {
  font-size: 20rpx;
  color: #8A7A7A;
  letter-spacing: 1rpx;
  position: relative;
  z-index: 1;
}


/* ===== 7. Premium 徽章 ===== */

.badge-gold {
  position: relative;
  z-index: 1;
  font-size: 18rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(201, 168, 124, 0.12), rgba(212, 160, 160, 0.08));
  color: #C9A87C;
  border: 1rpx solid rgba(201, 168, 124, 0.14);
  display: inline-block;
  letter-spacing: 1rpx;
  margin-top: 4rpx;
}


/* ===== 8. 环境氛围增强 ===== */

/* 顶部暖玫瑰辉光 */
.orb-top {
  position: absolute;
  top: -200rpx;
  left: 50%;
  transform: translateX(-50%);
  background: radial-gradient(
    circle at 50% 50%,
    rgba(232, 180, 180, 0.08) 0%,
    rgba(255, 220, 190, 0.05) 25%,
    rgba(253, 246, 236, 0.02) 50%,
    transparent 75%
  );
  width: 700rpx;
  height: 700rpx;
  pointer-events: none;
  z-index: 0;
}

/* 底部暖金光晕 */
.orb-bottom {
  position: absolute;
  bottom: -200rpx;
  left: 50%;
  transform: translateX(-50%);
  background: radial-gradient(
    circle at 50% 50%,
    rgba(201, 168, 124, 0.07) 0%,
    rgba(232, 180, 180, 0.04) 35%,
    transparent 70%
  );
  width: 700rpx;
  height: 700rpx;
  pointer-events: none;
  z-index: 0;
}


/* ===== 9. 加载 / 错误 / 空状态 ===== */

.skeleton {
  padding: 80rpx 0;
}

.skeleton-circle {
  background: linear-gradient(135deg, #FFF0E6, #FFF8F0);
  border: 1rpx solid rgba(212, 160, 160, 0.08);
}

.skeleton-line {
  background: linear-gradient(90deg,
    rgba(232, 180, 180, 0.10),
    rgba(201, 168, 124, 0.06),
    rgba(232, 180, 180, 0.10));
  background-size: 200% 100%;
  animation: draw-sweep 2s ease-in-out infinite;
}

.skeleton-block {
  background: linear-gradient(135deg,
    rgba(232, 180, 180, 0.08),
    rgba(201, 168, 124, 0.05));
  border: 1rpx solid rgba(212, 160, 160, 0.06);
}

.skeleton-grid-item {
  background: linear-gradient(135deg,
    rgba(232, 180, 180, 0.08),
    rgba(201, 168, 124, 0.05));
  border: 1rpx solid rgba(212, 160, 160, 0.06);
}

.error-state {
  text-align: center;
  padding: 80rpx 48rpx;
}

.error-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.error-text {
  font-size: 28rpx;
  color: #5A4446;
  display: block;
  margin-bottom: 8rpx;
}

.error-hint {
  font-size: 24rpx;
  color: #8A7A7A;
  display: block;
  margin-bottom: 48rpx;
}
