/* ============================================================
   今日屏 — 星光映照 · 牌为主角（E3 奶油疗愈版）
   奶油米白 #FAF6EF / 细金 #C9A97C / 雾粉 #E8C4BE / 墨 #3D3A36
   结构：顶部徽章 → 大牌面（主角）→ 牌名+牌语 → 能量注脚（可点）
        → 联动解读 → 明日预告 → 降权入口
   ============================================================ */

page {
  --e3-cream: #FAF6EF;
  --e3-cream-hi: #FFFDF8;
  --e3-paper: #F2ECDF;
  --e3-pink: #E8C4BE;
  --e3-pink-deep: #DCA9A1;
  --e3-pink-ink: #B08A82;
  --e3-gold: #C9A97C;
  --e3-gold-deep: #B08F52;
  --e3-line: rgba(201, 169, 124, 0.28);
  --e3-line-soft: rgba(201, 169, 124, 0.38);
  --e3-ink: #3D3A36;
  --e3-ink-soft: #8A8478;
  --e3-ink-faint: #B0AA9C;
  --e3-shadow: 0 4rpx 20rpx rgba(61, 58, 54, 0.06);
  --e3-hi: inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
  --e3-serif: 'Songti SC', 'STSong', 'SimSun', 'Noto Serif CJK SC', 'Noto Serif SC', serif;
  --e3-sans: -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif;

  background: #FAF6EF;
  color: #3D3A36;
  font-family: var(--e3-serif);
  font-size: 28rpx;
  line-height: 1.6;
}

/* -----------------------------------------------------------
   0. PAGE 容器
   ----------------------------------------------------------- */
.page {
  min-height: 100vh;
  padding: 0 40rpx 60rpx;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
  position: relative;
  box-sizing: border-box;
  background: #FAF6EF;
  overflow: hidden;
  z-index: 1;
}

/* 低饱和水彩底色氛围（真实插画之外仅作底色） */
.wash {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
}
.wash-pink {
  top: -160rpx;
  right: -180rpx;
  width: 560rpx;
  height: 560rpx;
  background: radial-gradient(circle, rgba(232, 196, 190, 0.5) 0%, rgba(232, 196, 190, 0) 66%);
}
.wash-gold {
  left: -200rpx;
  top: 760rpx;
  width: 500rpx;
  height: 500rpx;
  background: radial-gradient(circle, rgba(201, 169, 124, 0.26) 0%, rgba(201, 169, 124, 0) 66%);
}

/* 右下角淡粉水彩小花（真实资产 · 50% 透明 · 从底部探出） */
.hint-flower {
  position: absolute;
  right: -20rpx;
  bottom: 40rpx;
  width: 300rpx;
  height: 240rpx;
  opacity: 0.45;
  z-index: 0;
  pointer-events: none;
}
.hint-flower-img {
  width: 100%;
  height: 100%;
  border-radius: 30rpx;
}

/* -----------------------------------------------------------
   1. 入场动画
   ----------------------------------------------------------- */
.anim-fade-in-up-1 {
  animation: page-fade-up 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
}
.anim-fade-in-up-2 {
  opacity: 0;
  animation: page-fade-up 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.2s forwards;
}
.anim-fade-in-up-3 {
  opacity: 0;
  animation: page-fade-up 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.4s forwards;
}
@keyframes page-fade-up {
  0% { opacity: 0; transform: translateY(30rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

/* -----------------------------------------------------------
   2. 顶部：品牌 · 日期（左）｜星座徽章（右 · 极小不抢戏）
   ----------------------------------------------------------- */
.topbar {
  position: relative;
  z-index: 3;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding-top: 36rpx;
}
.tb-left {
  display: flex;
  flex-direction: column;
}
.brand {
  font-family: var(--e3-serif);
  font-weight: 500;
  font-size: 30rpx;
  color: var(--e3-ink);
  letter-spacing: 8rpx;
}
.date-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 8rpx;
}
.gold-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--e3-gold);
  flex-shrink: 0;
}
.date-text {
  font-family: var(--e3-serif);
  font-size: 20rpx;
  color: var(--e3-ink-faint);
  letter-spacing: 2rpx;
}

/* 星座徽章：极淡细金胶囊 · ≥44rpx 点击区（用 padding 放大热区） */
.zodiac-badge {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 12rpx 22rpx;
  margin: -8rpx -14rpx 0 0;
  border-radius: 999rpx;
  background: var(--e3-cream-hi);
  border: 1rpx solid rgba(201, 169, 124, 0.38);
  box-shadow: var(--e3-hi);
  flex-shrink: 0;
}
.zodiac-badge--empty {
  border: 1rpx dashed rgba(201, 169, 124, 0.5);
}
.zodiac-badge:active {
  opacity: 0.65;
}
.zodiac-badge-text {
  font-family: var(--e3-sans);
  font-size: 20rpx;
  color: var(--e3-gold-deep);
  letter-spacing: 2rpx;
  white-space: nowrap;
}

/* -----------------------------------------------------------
   3. 天象小字：一行 · 注脚
   ----------------------------------------------------------- */
.sky-note {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 14rpx;
}
.sky-moon {
  font-size: 24rpx;
  color: var(--e3-gold);
  transform: rotate(-18deg);
}
.sky-note-text {
  font-family: var(--e3-sans);
  font-size: 22rpx;
  color: var(--e3-ink-faint);
  letter-spacing: 3rpx;
}

/* -----------------------------------------------------------
   4. 中央绝对主角：大牌面（2:3 竖卡）
   ----------------------------------------------------------- */
.card-zone {
  position: relative;
  z-index: 2;
  margin-top: 8rpx;
  display: flex;
  justify-content: center;
}

/* 牌托（奶油描边 + 深影） */
.mat-wrap {
  padding: 12rpx;
  border-radius: 38rpx;
  background: var(--e3-cream-hi);
  border: 1rpx solid rgba(201, 169, 124, 0.34);
  box-shadow: 0 28rpx 64rpx rgba(61, 58, 54, 0.14), 0 0 0 1rpx rgba(201, 169, 124, 0.16), var(--e3-hi);
  transition: transform 0.18s ease;
}
.mat-wrap:active {
  transform: scale(0.965);
}
.card-ready {
  animation: ready-breathe 3.6s ease-in-out infinite;
}
@keyframes ready-breathe {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8rpx); }
}

.mat {
  position: relative;
  width: 380rpx;
  height: 540rpx;
  border-radius: 26rpx;
  overflow: hidden;
  border: 1rpx solid rgba(201, 169, 124, 0.3);
}
.mat::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 34%;
  pointer-events: none;
  z-index: 2;
  background: linear-gradient(180deg, rgba(255, 253, 248, 0.3), rgba(255, 253, 248, 0));
}
.art-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: 50% 42%;
  display: block;
}
.paint-spark {
  position: absolute;
  right: 34rpx;
  top: 40rpx;
  z-index: 3;
  color: rgba(255, 253, 248, 0.85);
  font-size: 30rpx;
  animation: spark-twinkle-soft 4.2s ease-in-out infinite;
}
@keyframes spark-twinkle-soft {
  0%, 100% { opacity: 0.35; transform: scale(0.85) rotate(0); }
  50% { opacity: 0.9; transform: scale(1.15) rotate(14deg); }
}

/* 未抽牌提示（牌面即唯一 CTA） */
.card-body {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 3;
  padding: 44rpx 0 52rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  background: linear-gradient(180deg, rgba(250, 246, 239, 0) 0%, rgba(250, 246, 239, 0.82) 60%);
}
.card-hint-big {
  font-family: var(--e3-serif);
  font-size: 34rpx;
  letter-spacing: 6rpx;
  color: var(--e3-ink);
}
.card-hint-sm {
  font-family: var(--e3-sans);
  font-size: 22rpx;
  color: var(--e3-ink-soft);
  letter-spacing: 3rpx;
}
.card-shake {
  animation: card-shake-fx 0.15s ease-out;
}
@keyframes card-shake-fx {
  0% { transform: translateX(0); }
  30% { transform: translateX(-6rpx); }
  60% { transform: translateX(6rpx); }
  100% { transform: translateX(0); }
}

/* 波纹反馈（保留 rippleActive 逻辑） */
.ripple-box {
  position: absolute;
  inset: 0;
  z-index: 2;
  overflow: hidden;
  pointer-events: none;
}
.ripple-circle {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 0;
  height: 0;
  margin: 0;
  border-radius: 50%;
  background: rgba(255, 253, 248, 0.5);
  opacity: 0;
}
.ripple-run {
  animation: ripple-expand 0.15s ease-out forwards;
}
@keyframes ripple-expand {
  0% { opacity: 0.7; width: 0; height: 0; margin: 0; }
  100% {
    opacity: 0;
    width: 720rpx;
    height: 720rpx;
    margin: -360rpx;
  }
}

/* 抽牌后：已学习徽章 + 星尘 */
.flip-badge {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  z-index: 3;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(250, 246, 239, 0.92);
  border: 1rpx solid rgba(201, 169, 124, 0.4);
  font-family: var(--e3-sans);
  font-size: 18rpx;
  color: var(--e3-gold-deep);
  letter-spacing: 2rpx;
}
.sparkle-field {
  position: absolute;
  inset: 0;
  z-index: 2;
  pointer-events: none;
}
.sparkle {
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: rgba(255, 253, 248, 0.9);
  animation: sparkle-float 2.6s ease-in-out infinite;
}
.sparkle.s1 { left: 30%; top: 22%; }
.sparkle.s2 { left: 68%; top: 30%; animation-delay: 0.9s; }
.sparkle.s3 { left: 46%; top: 12%; animation-delay: 1.6s; }
@keyframes sparkle-float {
  0%, 100% { opacity: 0.25; transform: translateY(0); }
  50% { opacity: 0.95; transform: translateY(-14rpx); }
}

/* 牌图失败兜底 */
.art-thumb-wrap {
  position: absolute;
  inset: 0;
}
.art-thumb-fallback {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(160deg, #F6EFE2, #EFE3CD);
}
.thumb-fallback-name {
  font-family: var(--e3-serif);
  font-size: 40rpx;
  letter-spacing: 8rpx;
  color: var(--e3-ink);
}

/* -----------------------------------------------------------
   5. 牌名 + 今日牌语（主角的注脚）
   ----------------------------------------------------------- */
.card-name {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 18rpx;
  margin-top: 16rpx;
}
.card-name-cn {
  font-family: var(--e3-serif);
  font-weight: 500;
  font-size: 40rpx;
  letter-spacing: 6rpx;
  color: var(--e3-ink);
}
.card-name-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--e3-gold);
}
.card-name-en {
  font-family: var(--e3-serif);
  font-size: 20rpx;
  letter-spacing: 8rpx;
  color: var(--e3-gold-deep);
  text-transform: uppercase;
}
.card-phrase {
  position: relative;
  z-index: 3;
  text-align: center;
  margin-top: 8rpx;
  font-size: 27rpx;
  letter-spacing: 2rpx;
  color: var(--e3-ink-soft);
  line-height: 1.6;
}

/* -----------------------------------------------------------
   6. 能量注脚：一行 · 极淡细金条（4 项均可点击）
   ----------------------------------------------------------- */
.energy {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: 16rpx 10rpx 0;
  height: 52rpx;
  border-radius: 999rpx;
  background: rgba(201, 169, 124, 0.08);
  border: 1rpx solid rgba(201, 169, 124, 0.2);
}
.eg-label {
  font-family: var(--e3-sans);
  font-size: 19rpx;
  color: var(--e3-gold);
  letter-spacing: 4rpx;
}
.eg-sep {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: rgba(201, 169, 124, 0.45);
  flex-shrink: 0;
}
.eg {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  padding: 10rpx 8rpx;
  margin: 0 -4rpx;
  border-radius: 12rpx;
  font-family: var(--e3-sans);
  font-size: 19rpx;
  color: var(--e3-ink-soft);
  letter-spacing: 1rpx;
  white-space: nowrap;
}
.eg-pressed {
  background: rgba(201, 169, 124, 0.32);
}
.eg-hot {
  color: var(--e3-pink-ink);
}
.eg-score {
  font-family: var(--e3-serif);
  font-style: normal;
  font-size: 22rpx;
  color: var(--e3-gold-deep);
}
.eg-hot .eg-score {
  color: var(--e3-pink-ink);
}

/* -----------------------------------------------------------
   6.5 今日星光卡：星光色【色块】 · 星光数 · 星象宜忌（Task 4）
   被动注脚 · 比能量卡更轻 · 色块颜色来自后端 12 色暖金/细金系
   ----------------------------------------------------------- */
.star-guidance {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin: 10rpx 10rpx 0;
  height: 48rpx;
  border-radius: 999rpx;
  background: rgba(201, 169, 124, 0.05);
  border: 1rpx solid rgba(201, 169, 124, 0.14);
}
.sg-label {
  font-family: var(--e3-sans);
  font-size: 19rpx;
  color: var(--e3-gold);
  letter-spacing: 4rpx;
}
.sg-swatch {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(61, 58, 54, 0.14);
  box-shadow: 0 0 8rpx rgba(201, 169, 124, 0.22);
  flex-shrink: 0;
}
.sg-sep {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: rgba(201, 169, 124, 0.4);
  flex-shrink: 0;
}
.sg-text {
  font-family: var(--e3-sans);
  font-size: 19rpx;
  color: var(--e3-ink-soft);
  letter-spacing: 1rpx;
  white-space: nowrap;
}
.sg-sep-inline {
  margin: 0 6rpx;
  color: rgba(176, 170, 156, 0.7);
}
.sg-advice {
  font-family: var(--e3-serif);
  font-size: 21rpx;
  letter-spacing: 1rpx;
}
.sg-advice--do {
  color: var(--e3-gold-deep);
}
.sg-advice--dont {
  color: var(--e3-pink-ink);
}
/* T5-1：今晚的星已点亮角标（手账记录联动 · 金色微胶囊） */
.sg-lit-badge {
  display: flex;
  align-items: center;
  margin-left: 10rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, rgba(201, 169, 124, 0.16), rgba(201, 169, 124, 0.06));
  border: 1rpx solid rgba(201, 169, 124, 0.35);
  flex-shrink: 0;
}
.sg-lit-badge-text {
  font-family: var(--e3-serif);
  font-size: 19rpx;
  color: var(--e3-gold-deep);
  letter-spacing: 1rpx;
  white-space: nowrap;
}

/* -----------------------------------------------------------
   6.6 今日天象链接 → 星空时刻表（T3-4 · 星光卡下瘦胶囊行）
   ----------------------------------------------------------- */
.astral-link {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin: 14rpx 10rpx 0;
  padding: 12rpx 0 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 253, 248, 0.6);
  border: 1rpx solid rgba(201, 169, 124, 0.22);
  transition: background 0.15s ease-out, transform 0.15s ease-out;
}

.astral-link--press {
  background: rgba(201, 169, 124, 0.12);
  transform: scale(0.98);
}

.astral-link-emoji {
  font-size: 24rpx;
  color: var(--e3-gold-deep);
  line-height: 1;
}

.astral-link-text {
  font-family: var(--e3-sans);
  font-size: 19rpx;
  color: var(--e3-gold-deep);
  letter-spacing: 2rpx;
}

/* -----------------------------------------------------------
   7. 联动解读：牌 × 天象（主角的展开）
   ----------------------------------------------------------- */
.link {
  position: relative;
  z-index: 3;
  margin-top: 14rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.link-line1 {
  font-size: 25rpx;
  letter-spacing: 2rpx;
  color: var(--e3-ink);
}
.link-line2 {
  font-family: var(--e3-sans);
  font-size: 24rpx;
  letter-spacing: 1rpx;
  color: var(--e3-ink-soft);
  line-height: 1.6;
}

/* -----------------------------------------------------------
   8. 明日之牌预告（回流钩子）
   ----------------------------------------------------------- */
.tomorrow {
  position: relative;
  z-index: 6;
  margin-top: 10rpx;
}
.tline {
  width: 264rpx;
  border-top: 1rpx dashed rgba(201, 169, 124, 0.4);
  margin: 0 auto;
}
.trow {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 12rpx;
  height: 76rpx;
  border-radius: 16rpx;
}
.trow-pressed {
  opacity: 0.6;
}
.t-lock {
  font-size: 24rpx;
  color: var(--e3-gold);
}
.t-text {
  font-family: var(--e3-serif);
  font-size: 21rpx;
  color: var(--e3-gold);
  letter-spacing: 5rpx;
}

/* -----------------------------------------------------------
   9. 抽牌后动作：查看详解 / 保存今日卡牌
   ----------------------------------------------------------- */
.after-row {
  position: relative;
  z-index: 3;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 8rpx;
}
.see-detail {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--e3-line-soft);
  background: var(--e3-cream-hi);
  font-size: 25rpx;
  letter-spacing: 6rpx;
  color: var(--e3-gold-deep);
  box-shadow: var(--e3-hi);
}
.see-detail:active {
  transform: scale(0.975);
}
.daily-share-link {
  text-align: center;
  font-size: 21rpx;
  color: var(--e3-ink-faint);
  letter-spacing: 4rpx;
  height: 64rpx;
  line-height: 64rpx;
}

/* -----------------------------------------------------------
   10. 底部降权入口（占卜 / 树洞 / 记录今天 · 注脚）
   ----------------------------------------------------------- */
.foot-entry-row {
  position: relative;
  z-index: 3;
  display: flex;
  gap: 18rpx;
  margin-top: 36rpx;
  justify-content: center;
}
.foot-entry {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 0 16rpx;
  border-radius: 22rpx;
  background: var(--e3-cream-hi);
  border: 1rpx solid rgba(201, 169, 124, 0.22);
  box-shadow: var(--e3-shadow), var(--e3-hi);
}
.foot-entry:active {
  transform: scale(0.97);
}
.foot-entry-emoji {
  font-size: 34rpx;
  color: var(--e3-gold-deep);
}
.foot-entry-label {
  font-family: var(--e3-sans);
  font-size: 20rpx;
  color: var(--e3-ink-soft);
  letter-spacing: 2rpx;
}

/* 免费次数小字（注脚） */
.quota-line {
  position: relative;
  z-index: 3;
  text-align: center;
  margin-top: 18rpx;
}
.quota-text {
  font-family: var(--e3-sans);
  font-size: 19rpx;
  color: var(--e3-ink-faint);
  letter-spacing: 2rpx;
}
.quota-text--exhausted {
  color: var(--e3-pink-ink);
  padding: 10rpx 20rpx;
}

/* -----------------------------------------------------------
   11. 加载骨架 / 错误状态（保留原有类名与视觉）
   ----------------------------------------------------------- */
.skeleton {
  background: linear-gradient(90deg, #F2ECDF 25%, #FAF6EF 50%, #F2ECDF 75%);
  background-size: 400% 100%;
  animation: shimmer-sweep 1.4s ease infinite;
}
@keyframes shimmer-sweep {
  0% { background-position: 100% 0; }
  100% { background-position: -100% 0; }
}
.skeleton--circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
}
.skeleton--text {
  height: 32rpx;
  border-radius: 12rpx;
}
.skeleton--text-sm {
  height: 24rpx;
  border-radius: 10rpx;
}
.skeleton--block {
  border-radius: 32rpx;
}

.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
  gap: 24rpx;
}
.error-text {
  font-family: var(--e3-serif);
  font-size: 34rpx;
  color: var(--e3-ink);
  letter-spacing: 4rpx;
}
.error-hint {
  font-family: var(--e3-sans);
  font-size: 24rpx;
  color: var(--e3-ink-faint);
  text-align: center;
  padding: 0 40rpx;
}

/* 按压反馈（hover-class 复用） */
.card-pressed {
  transform: scale(0.97);
  opacity: 0.92;
}
