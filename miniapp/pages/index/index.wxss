/* ============================================================
   首页 — Warm Paper Design System
   Warm ivory page base, deep rose accent, sage subtle
   Serif typography for a tarot reading room feel
   ============================================================ */

/* -----------------------------------------------------------
   1. HERO — Centered, warm, minimal
   ----------------------------------------------------------- */

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: var(--spacing-8) var(--spacing-5) var(--spacing-7);
  min-height: 420rpx;
  position: relative;
  z-index: var(--z-base);
}

.hero__icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: var(--spacing-6);
  opacity: 0.80;
}

.hero__title {
  font-size: var(--font-size-display);
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
  line-height: var(--line-height-heading);
  letter-spacing: var(--letter-spacing-display);
  margin-bottom: var(--spacing-4);
}

.hero__subtitle {
  font-size: var(--font-size-body-large);
  color: var(--color-text-secondary);
  line-height: var(--line-height-body);
  max-width: 600rpx;
}

/* -----------------------------------------------------------
   2. SECTION TITLE
   ----------------------------------------------------------- */

.section-title {
  font-size: var(--font-size-subhead);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  display: block;
  margin-bottom: var(--spacing-5);
  letter-spacing: var(--letter-spacing-none);
  padding-left: 0;
  border-left: none;
}

/* -----------------------------------------------------------
   3. DAILY CARD — Primary card on home
   ----------------------------------------------------------- */

.daily-card {
  background: var(--color-surface);
  border: 1rpx solid rgba(139, 126, 110, 0.12);
  border-radius: var(--radius-medium);
  padding: var(--spacing-6);
  box-shadow: var(--shadow-subtle);
  text-align: center;
  margin-bottom: var(--spacing-7);
  position: relative;
  transition: all var(--duration-navigation) ease;
}

.daily-card:active {
  border-color: rgba(176, 102, 80, 0.20);
  box-shadow: var(--shadow-medium);
  transform: translateY(-2rpx);
}

.daily-card__icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: var(--spacing-5);
  display: block;
  margin-left: auto;
  margin-right: auto;
}

.daily-card__title {
  font-size: var(--font-size-subhead);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  display: block;
  margin-bottom: var(--spacing-3);
}

.daily-card__name {
  font-size: var(--font-size-body-large);
  font-weight: var(--font-weight-medium);
  color: var(--color-accent);
  display: block;
  margin-bottom: var(--spacing-4);
}

.daily-card__desc {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  line-height: var(--line-height-body);
}

/* -----------------------------------------------------------
   4. SPREAD GRID — 2-column layout
   ----------------------------------------------------------- */

.section {
  margin-bottom: var(--spacing-7);
}

.spread-grid {
  display: flex;
  flex-flow: row wrap;
  margin: calc(-1 * var(--spacing-3));
}

.spread-card-wrap {
  width: calc(50% - var(--spacing-3) * 2);
  margin: var(--spacing-3);
}

.spread-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: var(--spacing-5);
  background: var(--color-surface);
  border: 1rpx solid rgba(139, 126, 110, 0.12);
  border-radius: var(--radius-medium);
  box-shadow: var(--shadow-subtle);
  transition: all var(--duration-navigation) ease;
  position: relative;
  overflow: hidden;
}

.spread-card:active {
  border-color: rgba(176, 102, 80, 0.20);
  box-shadow: var(--shadow-medium);
  transform: translateY(-2rpx);
}

.spread-card__icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: var(--spacing-3);
  opacity: 0.70;
}

.spread-card__label {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  display: block;
  line-height: var(--line-height-heading);
}

.spread-card__count {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  display: block;
  margin-top: var(--spacing-2);
}

/* Premium badge */
.spread-card--premium {
  border-color: rgba(176, 102, 80, 0.15);
}

.spread-card--premium .spread-card__label {
  color: var(--color-accent);
}

.spread-card--premium::after {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 0 28rpx 28rpx 0;
  border-color: transparent var(--color-accent) transparent transparent;
  opacity: 0.40;
}

/* -----------------------------------------------------------
   5. MORE SPREADS ENTRY
   ----------------------------------------------------------- */

.more-spreads {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: var(--spacing-5);
  padding: var(--spacing-5);
  background: var(--color-surface);
  border: 1rpx solid rgba(139, 126, 110, 0.12);
  border-radius: var(--radius-medium);
  box-shadow: var(--shadow-subtle);
  transition: all var(--duration-feedback) ease;
}

.more-spreads:active {
  border-color: rgba(176, 102, 80, 0.20);
  box-shadow: var(--shadow-subtle);
  opacity: 0.80;
}

.more-text {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-medium);
  color: var(--color-accent);
}

/* -----------------------------------------------------------
   6. ERROR STATE
   ----------------------------------------------------------- */

.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-8) var(--spacing-5);
  text-align: center;
}

.error-icon {
  width: 72rpx;
  height: 72rpx;
  margin-bottom: var(--spacing-5);
  opacity: 0.30;
}

.error-text {
  font-size: var(--font-size-body-large);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  display: block;
  margin-bottom: var(--spacing-3);
}

.error-hint {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--spacing-6);
  line-height: var(--line-height-body);
}

/* -----------------------------------------------------------
   7. ONBOARDING — Full-screen overlay
   ----------------------------------------------------------- */

.onboarding-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: var(--z-modal);
  background: var(--color-bg);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  animation: fade-in var(--duration-navigation) ease forwards;
}

.onboarding-swiper {
  flex: 1;
  width: 100%;
}

.onboarding-slide {
  display: flex;
  align-items: center;
  justify-content: center;
}

.onboarding-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 var(--spacing-7);
  text-align: center;
  animation: fade-up var(--duration-emphasis) ease forwards;
}

.onboarding-icon {
  width: 100rpx;
  height: 100rpx;
  margin-bottom: var(--spacing-7);
  display: block;
}

.onboarding-title {
  font-size: var(--font-size-display);
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
  display: block;
  margin-bottom: var(--spacing-5);
  letter-spacing: var(--letter-spacing-display);
}

.onboarding-desc {
  font-size: var(--font-size-body-large);
  font-weight: var(--font-weight-normal);
  color: var(--color-text-secondary);
  display: block;
  line-height: var(--line-height-body);
  max-width: 520rpx;
}

/* Dots indicator */
.onboarding-dots {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-4);
  padding: 0 0 var(--spacing-6);
}

.onboarding-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: var(--radius-pill);
  background: rgba(139, 126, 110, 0.20);
  transition: all var(--duration-navigation) ease;
}

.onboarding-dot.active {
  width: 36rpx;
  background: var(--color-accent);
}

/* Bottom buttons */
.onboarding-bottom {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-5);
  padding: 0 var(--spacing-7) var(--spacing-8);
  width: 100%;
  box-sizing: border-box;
}

.onboarding-skip {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  padding: var(--spacing-5);
  transition: color var(--duration-feedback) ease;
}

.onboarding-skip:active {
  color: var(--color-accent);
}

/* -----------------------------------------------------------
   8. ENTRANCE ANIMATIONS — Fade in only
   ----------------------------------------------------------- */

.anim-fade-in-up-1 { opacity: 0; animation: fade-up var(--duration-emphasis) ease 0.05s forwards; }
.anim-fade-in-up-2 { opacity: 0; animation: fade-up var(--duration-emphasis) ease 0.15s forwards; }
.anim-fade-in-up-3 { opacity: 0; animation: fade-up var(--duration-emphasis) ease 0.25s forwards; }
