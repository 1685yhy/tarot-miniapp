/* ============================================================
   首页 — 柔光星辰 (Soft Starlight)
   First impression — warm, magical, like a summer night sky
   ============================================================ */

/* -----------------------------------------------------------
   1. HERO — Warm stargazing at twilight
   Overrides common.wxss .hero
   ----------------------------------------------------------- */

.hero {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: var(--spacing-4xl) var(--spacing-md) var(--spacing-3xl);
  min-height: 420rpx;
  overflow: hidden;
  z-index: var(--z-base);
}

/* --- Main golden radial glow behind the title --- */
.hero::before {
  content: '';
  position: absolute;
  top: 45%;
  left: 50%;
  width: 560rpx;
  height: 560rpx;
  transform: translate(-50%, -50%);
  background: radial-gradient(
    circle at center,
    rgba(244, 212, 140, 0.15) 0%,
    rgba(244, 212, 140, 0.08) 20%,
    rgba(244, 212, 140, 0.03) 40%,
    transparent 65%
  );
  pointer-events: none;
  z-index: 0;
  animation: hero-glow-pulse 4s ease-in-out infinite;
}

@keyframes hero-glow-pulse {
  0%, 100% {
    opacity: 0.8;
    transform: translate(-50%, -50%) scale(1);
  }
  15% {
    opacity: 0.9;
    transform: translate(-50%, -50%) scale(1.08);
  }
  30% {
    opacity: 0.6;
    transform: translate(-50%, -50%) scale(1.02);
  }
  45% {
    opacity: 0.8;
    transform: translate(-50%, -50%) scale(1.04);
  }
  60% {
    opacity: 0.5;
    transform: translate(-50%, -50%) scale(1);
  }
}

/* NOTE: ::before/::after removed from <text> — WXSS does not support on text elements */

/* -----------------------------------------------------------
   2. HERO TITLE & SUBTITLE
   ----------------------------------------------------------- */

.title-1 {
  font-size: var(--font-size-display);
  font-weight: var(--font-weight-bold, 700);
  color: var(--color-text-primary, #F0EDE8);
  line-height: var(--line-height-tight, 1.3);
  letter-spacing: 10rpx;
  text-shadow:
    0 0 40rpx rgba(244, 212, 140, 0.10),
    0 0 80rpx rgba(244, 212, 140, 0.04);
  position: relative;
  z-index: 1;
}

.hero .body-text {
  color: var(--color-lavender, #B8A9E0);
  font-size: var(--font-size-body, 30rpx);
  letter-spacing: 4rpx;
  position: relative;
  z-index: 1;
  text-shadow: 0 0 30rpx rgba(184, 169, 224, 0.08);
}

/* -----------------------------------------------------------
   3. PAGE ANIMATIONS — Staggered entrance
   ----------------------------------------------------------- */

.anim-fade-in-up-1 {
  animation: page-fade-up 0.6s var(--ease-soft, cubic-bezier(0.25, 0.46, 0.45, 0.94)) forwards;
}

.anim-fade-in-up-2 {
  opacity: 0;
  animation: page-fade-up 0.6s var(--ease-soft, cubic-bezier(0.25, 0.46, 0.45, 0.94)) 0.25s forwards;
}

.anim-fade-in-up-3 {
  opacity: 0;
  animation: page-fade-up 0.6s var(--ease-soft, cubic-bezier(0.25, 0.46, 0.45, 0.94)) 0.5s forwards;
}

@keyframes page-fade-up {
  0% {
    opacity: 0;
    transform: translateY(30rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

/* -----------------------------------------------------------
   4. CARD VARIANTS
   ----------------------------------------------------------- */

/* --- Warm variant — dark indigo, golden promise --- */
.card-warm {
  background: linear-gradient(145deg, #25255A 0%, #2A2A5E 40%, #303065 100%);
  border: 1.5rpx solid rgba(244, 212, 140, 0.30);
  box-shadow:
    0 4rpx 24rpx rgba(0, 0, 0, 0.28),
    0 0 50rpx rgba(244, 212, 140, 0.04);
  position: relative;
  overflow: hidden;
  animation: card-warm-breathe 5s ease-in-out infinite;
}

/* Subtle warm gradient overlay */
.card-warm::after {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(
    ellipse at 30% 20%,
    rgba(244, 212, 140, 0.04) 0%,
    transparent 60%
  );
  pointer-events: none;
}

/* NOTE: card-float animation removed — restraint overrides levitation */

/* NOTE: card-shimmer (shimmer-sweep) and card-sparkles (orbit) removed — restraint */

/* --- RIPPLE EFFECT — expanding circle from center on tap --- */
.ripple-box {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  overflow: hidden;
  border-radius: inherit;
  z-index: 2;
}

.ripple-circle {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 16rpx;
  height: 16rpx;
  margin: -8rpx 0 0 -8rpx;
  background: rgba(244, 212, 140, 0.30);
  border-radius: 50%;
  transform: scale(0);
  opacity: 0;
}

.ripple-run {
  animation: ripple-expand 0.15s ease-out forwards;
}

@keyframes ripple-expand {
  0% {
    transform: scale(0);
    opacity: 1;
  }
  100% {
    transform: scale(24);
    opacity: 0;
  }
}

/* --- SHAKE — brief oscillation simulating shuffle --- */
.card-body {
  position: relative;
  z-index: 1;
}

.card-shake {
  animation: card-shake-fx 0.15s ease-out;
}

@keyframes card-shake-fx {
  0%, 100% {
    transform: translateX(0);
  }
  15% {
    transform: translateX(-3rpx);
  }
  30% {
    transform: translateX(3rpx);
  }
  45% {
    transform: translateX(-2rpx);
  }
  60% {
    transform: translateX(2rpx);
  }
  75% {
    transform: translateX(-1rpx);
  }
  90% {
    transform: translateX(1rpx);
  }
}

/* --- Pressable interaction --- */
.card-press {
  transition: all var(--duration-fast) var(--ease-out);
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}

.card-press:active {
  transform: scale(0.97);
  border-color: rgba(244, 212, 140, 0.55) !important;
  box-shadow: var(--shadow-card-press);
}

/* ============================================================
   4c. PENDING READING CARD — resume incomplete reading
   ============================================================ */
.pending-reading-card {
  padding: var(--spacing-md) var(--spacing-md);
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, rgba(244,212,140,0.10) 0%, rgba(180,140,200,0.08) 100%);
  border-color: rgba(244,212,140,0.20);
}

.pending-reading-left {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}

.pending-reading-icon-wrap {
  width: 48rpx;
  height: 48rpx;
  background: rgba(244,212,140,0.15);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pending-reading-icon {
  font-size: var(--font-size-body);
}

.pending-reading-label {
  display: block;
  font-weight: 500;
  color: var(--color-gold);
}

.pending-reading-hint {
  display: block;
  margin-top: 4rpx;
}

.pending-reading-arrow {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
}

/* ============================================================
   4d. DIARY ENTRY CARD — today's journal entry
   ============================================================ */
.diary-entry-card {
  padding: var(--spacing-md) var(--spacing-md);
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, rgba(244,212,140,0.08) 0%, rgba(180,140,200,0.06) 100%);
  border-color: rgba(244,212,140,0.15);
}

.diary-entry-left {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}

.diary-entry-emoji {
  font-size: var(--font-size-title);
}

.diary-entry-icon {
  width: 48rpx;
  height: 48rpx;
}

.diary-entry-label {
  display: block;
  font-weight: 500;
  color: var(--color-gold);
}

.diary-entry-hint {
  display: block;
  margin-top: 4rpx;
}

.diary-entry-arrow {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
}

/* ============================================================
   4f. COMMUNITY ENTRY CARD — home page tree hole entry
   ============================================================ */
.community-entry-card {
  padding: var(--spacing-md) var(--spacing-md);
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, rgba(244,212,140,0.08) 0%, rgba(180,140,200,0.06) 100%);
  border-color: rgba(244,212,140,0.15);
}

.community-entry-icon {
  width: 48rpx;
  height: 48rpx;
  background: rgba(244,212,140,0.15);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.community-entry-emoji {
  font-size: var(--font-size-body);
}

.community-entry-label {
  display: block;
  font-weight: 500;
  color: var(--color-gold);
}

.community-entry-hint {
  display: block;
  margin-top: 4rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  max-width: 380rpx;
}

/* ============================================================
   4e. ANNUAL REPORT ENTRY CARD — home page entry point
   ============================================================ */
.annual-report-card {
  padding: var(--spacing-md) var(--spacing-md);
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, rgba(244,212,140,0.08) 0%, rgba(180,140,200,0.06) 100%);
  border-color: rgba(244,212,140,0.15);
}

.annual-report-card--locked {
  background: linear-gradient(135deg, rgba(100,100,140,0.06) 0%, rgba(80,80,120,0.04) 100%);
  border-color: rgba(160,155,180,0.12);
  opacity: 0.85;
}

.annual-report-left {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}

.annual-report-icon {
  width: 48rpx;
  height: 48rpx;
}

.annual-report-label {
  display: block;
  font-weight: 500;
  color: var(--color-gold);
}

.annual-report-card--locked .annual-report-label {
  color: var(--color-text-tertiary);
}

.annual-report-hint {
  display: block;
  margin-top: 4rpx;
}

/* ============================================================
   4f. SEASONAL ANNUAL REPORT BANNER — Dec-Jan splash
   ============================================================ */
.annual-report-season-banner {
  position: relative;
  padding: 40rpx 32rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(244,212,140,0.10) 0%, rgba(184,169,224,0.06) 100%);
  border: 1rpx solid rgba(244,212,140,0.15);
  overflow: hidden;
  text-align: center;
  cursor: pointer;
  transition: all var(--duration-fast) var(--ease-out);
}

.annual-report-season-banner:active {
  transform: scale(0.97);
  border-color: rgba(244,212,140,0.30);
}

.season-banner-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 400rpx;
  height: 400rpx;
  transform: translate(-50%, -50%);
  background: radial-gradient(circle, rgba(244,212,140,0.08) 0%, transparent 60%);
  pointer-events: none;
  animation: season-glow 3s ease-in-out infinite;
}

@keyframes season-glow {
  0%, 100% { opacity: 0.5; transform: translate(-50%, -50%) scale(1); }
  50% { opacity: 1; transform: translate(-50%, -50%) scale(1.05); }
}

.season-banner-stars {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.season-banner-star {
  position: absolute;
  width: 4rpx;
  height: 4rpx;
  background: #F4D48C;
  border-radius: 50%;
  opacity: 0;
  animation: season-star 2s ease-in-out infinite;
  animation-delay: calc(var(--i) * 0.5s);
}

.season-banner-star:nth-child(1) { top: 15%; left: 20%; }
.season-banner-star:nth-child(2) { top: 25%; right: 15%; }
.season-banner-star:nth-child(3) { bottom: 30%; left: 30%; }

@keyframes season-star {
  0%, 100% { opacity: 0; transform: scale(0.5); }
  50% { opacity: 0.8; transform: scale(1.5); }
}

.season-banner-label {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #F4D48C;
  letter-spacing: 3rpx;
  margin-bottom: 8rpx;
  position: relative;
  z-index: 1;
}

.season-banner-cta {
  display: block;
  font-size: 24rpx;
  color: rgba(176,169,224,0.6);
  letter-spacing: 2rpx;
  position: relative;
  z-index: 1;
}

/* -----------------------------------------------------------
   4b. AFTER-DRAW — Card Reveal & Particles
   ----------------------------------------------------------- */

/* --- Revealed state base --- */
.card.card--revealed {
  position: relative;
  overflow: hidden;
  border-color: var(--color-gold-dark, #D4B06A) !important;
  background: linear-gradient(145deg, #2A2A5E 0%, #2E2E62 100%);
  box-shadow:
    0 4rpx 24rpx rgba(0, 0, 0, 0.28),
    0 0 40rpx rgba(244, 212, 140, 0.06),
    0 0 80rpx rgba(244, 212, 140, 0.03);
}

/* --- Card rise reveal (dramatic entrance) --- */
.card-rise {
  animation:
    card-rise-reveal 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0s both,
    card-glow-breathe 4s ease-in-out 0.5s infinite;
}

@keyframes card-rise-reveal {
  0% {
    opacity: 0;
    transform: scale(0.85);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}

/* NOTE: particle-field burst removed — over-decoration */

/* --- Text reveal — slide up with stagger --- */
.reveal-text {
  animation: slide-up-reveal 0.4s ease-out 0s both;
  position: relative;
  z-index: 1;
}

@keyframes slide-up-reveal {
  0% {
    opacity: 0;
    transform: translateY(20rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

/* -----------------------------------------------------------
   5. TYPOGRAPHY ALIASES (page-specific)
   ----------------------------------------------------------- */

/* Big hero title — handled by .title-1 above */

/* Card title inside daily card */
.title-2 {
  font-size: var(--font-size-title, 48rpx);
  font-weight: var(--font-weight-semibold, 600);
  color: var(--color-gold, #F4D48C);
  line-height: var(--line-height-tight, 1.3);
  text-shadow: 0 0 20rpx rgba(244, 212, 140, 0.08);
}

/* Card subtitle / small label */
.title-4 {
  font-size: var(--font-size-subhead, 36rpx);
  font-weight: var(--font-weight-medium, 500);
  color: var(--color-text-primary, #F0EDE8);
  line-height: var(--line-height-tight, 1.3);
  letter-spacing: 2rpx;
}

/* Small body text */
.body-sm {
  font-size: var(--font-size-caption, 24rpx);
  font-weight: var(--font-weight-normal, 400);
  color: var(--color-lavender, #B8A9E0);
  line-height: var(--line-height-base, 1.6);
  letter-spacing: 1rpx;
}

/* Extra small body text — spread card descriptions */
.body-xs {
  font-size: var(--font-size-xs, 20rpx);
  font-weight: var(--font-weight-normal, 400);
  color: var(--color-text-tertiary, #A098C0);
  line-height: var(--line-height-base, 1.6);
  letter-spacing: 0.5rpx;
}

/* Accent-colored caption */
.accent-text {
  color: var(--color-gold, #F4D48C);
  font-weight: var(--font-weight-medium, 500);
  letter-spacing: 2rpx;
}

/* -----------------------------------------------------------
   6. SECTION TITLE (spread grid header)
   ----------------------------------------------------------- */

.section-title {
  font-size: var(--font-size-subhead, 36rpx);
  font-weight: var(--font-weight-semibold, 600);
  color: var(--color-text-primary, #F0EDE8);
  display: block;
  margin-bottom: var(--spacing-md, 24rpx);
  letter-spacing: 2rpx;
  position: relative;
  padding-left: var(--spacing-md);
}

.section-title {
  padding-left: var(--spacing-md);
  border-left: 3rpx solid var(--color-gold, #F4D48C);
}

/* --- Spread grid cards --- */
.spread-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  padding: var(--spacing-md) var(--spacing-sm);
}

/* --- Free/Premium tags on spread cards --- */
.spread-tag {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  font-size: var(--font-size-xs);
  font-weight: 500;
  padding: 3rpx 12rpx;
  border-radius: var(--radius-sm);
  line-height: 1.5;
  letter-spacing: 0.5rpx;
  z-index: 2;
  pointer-events: none;
}

.spread-tag-free {
  color: #B8A9E0;
  background: rgba(184, 169, 224, 0.18);
}

.spread-tag-premium {
  color: #F4D48C;
  background: rgba(244, 212, 140, 0.18);
}

/* Small theme affinity chip on home page spread cards */
.spread-theme-chip {
  display: inline-block;
  margin-top: 6rpx;
  padding: 2rpx 12rpx;
  font-size: var(--font-size-xs);
  font-weight: 500;
  border-radius: var(--radius-sm);
  line-height: 1.6;
  letter-spacing: 0.5rpx;
}

.spread-theme-chip--love {
  color: #F4A4C8;
  background: rgba(244, 164, 200, 0.15);
}

.spread-theme-chip--career {
  color: #8FC9F0;
  background: rgba(143, 201, 240, 0.15);
}

.body-xs {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary, #9A95B8);
  display: block;
}

/* --- Spread grid cards: constellation map feel --- */
.section .card-press {
  background: linear-gradient(145deg, #25255A 0%, #2A2A5E 100%);
  border: 1.5rpx solid rgba(244, 212, 140, 0.12);
  border-radius: var(--radius-lg, 24rpx);
  padding: var(--spacing-lg) var(--spacing-md);
  position: relative;
  overflow: hidden;
  box-shadow: var(--shadow-card);
  transition: all var(--duration-fast) var(--ease-out);
}

.section .card-press:active {
  transform: scale(0.97);
  border-color: rgba(244, 212, 140, 0.20) !important;
  box-shadow: var(--shadow-card-press);
}

/* Spread card icon — fixed size, centered */
.spread-icon {
  width: 48rpx;
  height: 48rpx;
  display: block;
  margin: 0 auto 16rpx;
  opacity: 0.85;
}

/* Spread card text labels */
.section .card-press .body-sm {
  display: block;
  font-weight: 600;
  color: var(--color-text-primary, #F0EDE8);
  font-size: var(--font-size-caption, 24rpx);
  letter-spacing: 1rpx;
}

.section .card-press .body-xs {
  display: block;
  margin-top: 6rpx;
}

/* -----------------------------------------------------------
   7. ERROR STATE
   ----------------------------------------------------------- */

.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx var(--spacing-lg, 32rpx) 80rpx;
  text-align: center;
  animation: page-fade-up 0.6s var(--ease-soft, cubic-bezier(0.25, 0.46, 0.45, 0.94)) forwards;
}

.error-icon {
  font-size: calc(var(--font-size-display) + 16rpx);
  color: var(--color-gold, #F4D48C);
  opacity: 0.50;
  margin-bottom: var(--spacing-lg, 32rpx);
  display: block;
  text-shadow: 0 0 30rpx rgba(244, 212, 140, 0.10);
}

.error-text {
  font-size: var(--font-size-title, 40rpx);
  font-weight: var(--font-weight-semibold, 600);
  color: var(--color-text-primary, #F0EDE8);
  margin-bottom: var(--spacing-xs, 12rpx);
  display: block;
}

.error-hint {
  font-size: var(--font-size-caption, 24rpx);
  color: var(--color-text-tertiary, #A098C0);
  margin-bottom: var(--spacing-xl, 48rpx);
  display: block;
  line-height: var(--line-height-base, 1.6);
}

/* Buttons via common.wxss: .btn-ghost, .btn-primary */

/* -----------------------------------------------------------
   8. DECORATIVE: Daily card icon (✦) special treatment
   ----------------------------------------------------------- */

.card-body > text:first-child {
  display: block;
  margin-bottom: 24rpx;
  font-size: var(--font-size-title);
  color: var(--color-gold, #F4D48C);
  text-shadow: 0 0 30rpx rgba(244, 212, 140, 0.15);
}

/* ============================================================
   10. SPREAD GRID — Staggered entrance
   Each card rises with scale + opacity, 50ms apart
   ============================================================ */

@keyframes card-staggered {
  0% {
    opacity: 0;
    transform: translateY(24rpx) scale(0.92);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.section > view > .card-press {
  opacity: 0;
  animation: card-staggered 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
}

.section > view > .card-press:nth-child(1) { animation-delay: 0.30s; }
.section > view > .card-press:nth-child(2) { animation-delay: 0.35s; }
.section > view > .card-press:nth-child(3) { animation-delay: 0.40s; }
.section > view > .card-press:nth-child(4) { animation-delay: 0.45s; }

.more-spreads {
  opacity: 0;
  animation: card-staggered 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.50s forwards;
}

/* NOTE: spread-grid shimmer sweep and icon tap pulse removed — restraint */

/* ============================================================
   11. MORE SPREADS — "查看更多" entry card
   ============================================================ */

.more-spreads {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: var(--spacing-lg);
  padding: var(--spacing-md) var(--spacing-md);
  background: linear-gradient(145deg, #25255A 0%, #2A2A5E 100%);
  border: 1.5rpx solid rgba(244, 212, 140, 0.12);
  border-radius: var(--radius-lg, 24rpx);
  box-shadow: var(--shadow-card);
  transition: all var(--duration-fast) var(--ease-out);
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}

.more-spreads:active {
  transform: scale(0.97);
  border-color: rgba(244, 212, 140, 0.20) !important;
  box-shadow: var(--shadow-card-press);
}

.more-text {
  font-size: var(--font-size-caption, 24rpx);
  font-weight: var(--font-weight-medium, 500);
  color: var(--color-gold, #F4D48C);
  letter-spacing: 1rpx;
}

.more-arrow {
  font-size: var(--font-size-body);
  color: var(--color-gold, #F4D48C);
  opacity: 0.6;
  margin-left: 12rpx;
  transition: transform 0.15s var(--ease-soft, cubic-bezier(0.25, 0.46, 0.45, 0.94));
}

.more-spreads:active .more-arrow {
  transform: translateX(6rpx);
  opacity: 1;
}

/* ============================================================
   12. ONBOARDING BUBBLE — Step 1 lightweight hint
   Dark semi-transparent background + gold border + arrow
   ============================================================ */

/* Wrapper: positioned relative to daily card area with margin */
.onboarding-bubble-wrap {
  position: relative;
  margin: 0 auto 20rpx;
  max-width: 520rpx;
  z-index: 100;
  opacity: 0;
  transform: translateY(-10rpx);
  transition: opacity 0.3s ease, transform 0.3s ease;
  pointer-events: none;
}

.onboarding-bubble-wrap.bubble-visible {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

/* Bubble card */
.onboarding-bubble {
  position: relative;
  padding: 24rpx 32rpx 28rpx;
  background: rgba(26, 26, 62, 0.95);
  border: 1.5rpx solid var(--color-gold, #F4D48C);
  border-radius: 16rpx;
  text-align: center;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}

.onboarding-bubble:active {
  opacity: 0.85;
}

/* Bubble text — gold title */
.bubble-text {
  display: block;
  font-size: var(--font-size-caption, 24rpx);
  font-weight: var(--font-weight-medium, 500);
  color: var(--color-gold, #F4D48C);
  line-height: 1.6;
  letter-spacing: 2rpx;
}

/* Bubble action — white secondary text */
.bubble-action {
  display: block;
  font-size: var(--font-size-xs, 20rpx);
  color: #ffffff;
  margin-top: 8rpx;
  opacity: 0.75;
  letter-spacing: 1rpx;
}

/* Downward-pointing arrow */
.bubble-arrow {
  position: absolute;
  bottom: -14rpx;
  left: 50%;
  margin-left: -12rpx;
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-top: 14rpx solid rgba(26, 26, 62, 0.95);
  z-index: 2;
}

/* Gold border triangle behind the arrow */
.bubble-arrow::before {
  content: '';
  position: absolute;
  top: -16rpx;
  left: -14rpx;
  width: 0;
  height: 0;
  border-left: 14rpx solid transparent;
  border-right: 14rpx solid transparent;
  border-top: 16rpx solid var(--color-gold, #F4D48C);
  z-index: -1;
}

/* ============================================================
   13. PARALLAX STARS — Three layers for atmospheric depth
   Using CSS box-shadow technique (WXSS-compatible)
   ============================================================ */

/* Base layer — full-screen fixed overlay */
.stars-layer {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
}

/* --- Layer 1 — Distant: 40+ tiny dots, very dim, slow drift --- */
.stars-distant::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 2rpx;
  height: 2rpx;
  background: transparent;
  border-radius: 50%;
  box-shadow:
    25rpx 40rpx rgba(255,255,255,0.09),
    68rpx 105rpx rgba(255,255,255,0.08),
    120rpx 30rpx rgba(255,255,255,0.10),
    175rpx 180rpx rgba(255,255,255,0.06),
    230rpx 60rpx rgba(255,255,255,0.08),
    290rpx 200rpx rgba(255,255,255,0.07),
    340rpx 85rpx rgba(255,255,255,0.09),
    400rpx 250rpx rgba(255,255,255,0.05),
    455rpx 120rpx rgba(255,255,255,0.08),
    510rpx 35rpx rgba(255,255,255,0.10),
    580rpx 170rpx rgba(255,255,255,0.06),
    630rpx 90rpx rgba(255,255,255,0.08),
    690rpx 210rpx rgba(255,255,255,0.09),
    50rpx 320rpx rgba(255,255,255,0.07),
    130rpx 400rpx rgba(255,255,255,0.06),
    200rpx 350rpx rgba(255,255,255,0.08),
    270rpx 480rpx rgba(255,255,255,0.05),
    350rpx 380rpx rgba(255,255,255,0.09),
    420rpx 520rpx rgba(255,255,255,0.07),
    495rpx 450rpx rgba(255,255,255,0.06),
    560rpx 300rpx rgba(255,255,255,0.08),
    640rpx 500rpx rgba(255,255,255,0.08),
    710rpx 420rpx rgba(255,255,255,0.05),
    30rpx 560rpx rgba(255,255,255,0.09),
    100rpx 630rpx rgba(255,255,255,0.06),
    180rpx 700rpx rgba(255,255,255,0.08),
    260rpx 580rpx rgba(255,255,255,0.07),
    340rpx 650rpx rgba(255,255,255,0.05),
    430rpx 720rpx rgba(255,255,255,0.09),
    510rpx 600rpx rgba(255,255,255,0.06),
    600rpx 680rpx rgba(255,255,255,0.08),
    680rpx 550rpx rgba(255,255,255,0.07),
    45rpx 800rpx rgba(255,255,255,0.05),
    140rpx 880rpx rgba(255,255,255,0.08),
    230rpx 780rpx rgba(255,255,255,0.06),
    320rpx 900rpx rgba(255,255,255,0.09),
    400rpx 840rpx rgba(255,255,255,0.07),
    480rpx 950rpx rgba(255,255,255,0.05),
    570rpx 860rpx rgba(255,255,255,0.08),
    660rpx 920rpx rgba(255,255,255,0.06),
    730rpx 780rpx rgba(255,255,255,0.08);
  animation: stars-drift-slow 60s ease-in-out infinite;
}

/* --- Layer 2 — Mid: 18 gold-tinted dots, medium drift --- */
.stars-mid::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 3rpx;
  height: 3rpx;
  background: transparent;
  border-radius: 50%;
  box-shadow:
    55rpx 130rpx rgba(244,212,140,0.08),
    160rpx 60rpx rgba(244,212,140,0.06),
    250rpx 230rpx rgba(244,212,140,0.09),
    380rpx 150rpx rgba(244,212,140,0.05),
    470rpx 280rpx rgba(244,212,140,0.08),
    590rpx 110rpx rgba(244,212,140,0.06),
    700rpx 240rpx rgba(244,212,140,0.09),
    85rpx 370rpx rgba(244,212,140,0.05),
    200rpx 450rpx rgba(244,212,140,0.08),
    330rpx 350rpx rgba(244,212,140,0.06),
    460rpx 500rpx rgba(244,212,140,0.09),
    560rpx 430rpx rgba(244,212,140,0.05),
    670rpx 560rpx rgba(244,212,140,0.08),
    110rpx 620rpx rgba(244,212,140,0.06),
    250rpx 720rpx rgba(244,212,140,0.09),
    390rpx 660rpx rgba(244,212,140,0.05),
    530rpx 790rpx rgba(244,212,140,0.08),
    650rpx 700rpx rgba(244,212,140,0.06);
  animation: stars-drift-mid 40s ease-in-out infinite;
}

/* --- Layer 3 — Close: 7 bright gold dots, fast drift with glow --- */
.stars-close::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 5rpx;
  height: 5rpx;
  background: transparent;
  border-radius: 50%;
  box-shadow:
    120rpx 160rpx rgba(244,212,140,0.30),
    120rpx 160rpx 8rpx 2rpx rgba(244,212,140,0.06),
    310rpx 380rpx rgba(232,200,120,0.25),
    310rpx 380rpx 8rpx 2rpx rgba(232,200,120,0.05),
    520rpx 220rpx rgba(244,212,140,0.30),
    520rpx 220rpx 8rpx 2rpx rgba(244,212,140,0.06),
    180rpx 530rpx rgba(232,200,120,0.25),
    180rpx 530rpx 8rpx 2rpx rgba(232,200,120,0.05),
    450rpx 600rpx rgba(244,212,140,0.30),
    450rpx 600rpx 8rpx 2rpx rgba(244,212,140,0.06),
    680rpx 350rpx rgba(232,200,120,0.25),
    680rpx 350rpx 8rpx 2rpx rgba(232,200,120,0.05),
    300rpx 800rpx rgba(244,212,140,0.30),
    300rpx 800rpx 8rpx 2rpx rgba(244,212,140,0.06);
  animation: stars-drift-close 24s ease-in-out infinite;
}

@keyframes stars-drift-slow {
  0%   { transform: translate(0, 0); }
  50%  { transform: translate(18rpx, -8rpx); }
  100% { transform: translate(0, 0); }
}

@keyframes stars-drift-mid {
  0%   { transform: translate(0, 0); }
  50%  { transform: translate(-24rpx, 12rpx); }
  100% { transform: translate(0, 0); }
}

@keyframes stars-drift-close {
  0%   { transform: translate(0, 0); }
  33%  { transform: translate(32rpx, -16rpx); }
  66%  { transform: translate(-14rpx, 20rpx); }
  100% { transform: translate(0, 0); }
}

/* ============================================================
   14. NEBULA GLOW — Ultra-subtle colored gradients
   ============================================================ */

.nebula {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 0;
}

.nebula-lavender {
  background: radial-gradient(
    ellipse 65% 50% at 80% 20%,
    rgba(184, 169, 224, 0.04) 0%,
    transparent 70%
  );
  animation: none;
}

.nebula-gold {
  background: radial-gradient(
    ellipse 55% 60% at 20% 80%,
    rgba(244, 212, 140, 0.03) 0%,
    transparent 65%
  );
  animation: none;
}

@keyframes nebula-rotate {
  0%   { transform: rotate(0deg) scale(1); }
  50%  { transform: rotate(4deg) scale(1.06); }
  100% { transform: rotate(0deg) scale(1); }
}

@keyframes nebula-rotate-reverse {
  0%   { transform: rotate(0deg) scale(1); }
  50%  { transform: rotate(-4deg) scale(1.06); }
  100% { transform: rotate(0deg) scale(1); }
}

/* ============================================================
   15. SHOOTING STAR — Rare easter egg (~every 30s)
   ============================================================ */

.shooting-star {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 1;
  overflow: hidden;
}

.shooting-star::after {
  content: '';
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  top: 12%;
  left: 105%;
  background: #F4D48C;
  border-radius: 50%;
  box-shadow:
    0 0 12rpx 4rpx rgba(244,212,140,0.30),
    -30rpx 10rpx 3rpx -1rpx rgba(244,212,140,0.25),
    -60rpx 20rpx 4rpx -2rpx rgba(244,212,140,0.12),
    -90rpx 30rpx 5rpx -3rpx rgba(244,212,140,0.06);
  animation: none;
}

.shooting-star.shooting-star--active::after {
  animation: shooting-star-fly 4.5s ease-in-out 1 both;
}

@keyframes shooting-star-fly {
  0% {
    transform: translate(0, 0);
    opacity: 0;
  }
  1% {
    opacity: 1;
  }
  3.5% {
    transform: translate(-800rpx, 210rpx);
    opacity: 1;
  }
  4.5% {
    opacity: 0;
    transform: translate(-850rpx, 230rpx);
  }
  100% {
    opacity: 0;
    transform: translate(-850rpx, 230rpx);
  }
}

/* ============================================================
   16. HERO GLOW — Concentric rings emanating outward
   ============================================================ */

.hero-glow-rings {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 400rpx;
  height: 400rpx;
  transform: translate(-50%, -50%);
  pointer-events: none;
  z-index: 0;
}

.hero-glow-rings::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 70%;
  height: 70%;
  transform: translate(-50%, -50%);
  border: 1rpx solid rgba(244, 212, 140, 0.10);
  border-radius: 50%;
  animation: ring-expand 6s ease-out infinite;
}

.hero-glow-rings::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 70%;
  height: 70%;
  transform: translate(-50%, -50%);
  border: 1rpx solid rgba(244, 212, 140, 0.06);
  border-radius: 50%;
  animation: ring-expand 6s ease-out infinite 3s;
}

@keyframes ring-expand {
  0% {
    width: 50%;
    height: 50%;
    opacity: 0.7;
    border-color: rgba(244,212,140,0.12);
  }
  50% {
    width: 120%;
    height: 120%;
    opacity: 0.25;
    border-color: rgba(244,212,140,0.04);
  }
  100% {
    width: 180%;
    height: 180%;
    opacity: 0;
    border-color: rgba(244,212,140,0.01);
  }
}

/* ============================================================
   17. CARD GLOW — Breathing golden aura + warm breathe
   ============================================================ */

@keyframes card-warm-breathe {
  0%, 100% {
    box-shadow:
      0 4rpx 24rpx rgba(0,0,0,0.28),
      0 0 50rpx rgba(244,212,140,0.06);
  }
  50% {
    box-shadow:
      0 4rpx 24rpx rgba(0,0,0,0.28),
      0 0 80rpx rgba(244,212,140,0.15),
      0 0 150rpx rgba(244,212,140,0.08),
      0 0 200rpx rgba(244,212,140,0.03);
  }
}

@keyframes card-glow-breathe {
  0%, 100% {
    box-shadow:
      0 4rpx 24rpx rgba(0,0,0,0.28),
      0 0 40rpx rgba(244,212,140,0.06),
      0 0 80rpx rgba(244,212,140,0.03);
  }
  50% {
    box-shadow:
      0 4rpx 24rpx rgba(0,0,0,0.28),
      0 0 50rpx rgba(244,212,140,0.12),
      0 0 100rpx rgba(244,212,140,0.06),
      0 0 160rpx rgba(244,212,140,0.02);
  }
}

/* ============================================================
   18. SPARKLE PARTICLES — Floating near revealed card surface
   ============================================================ */

.sparkle-field {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 2;
  overflow: hidden;
  border-radius: inherit;
}

.sparkle {
  position: absolute;
  width: 4rpx;
  height: 4rpx;
  background: #F4D48C;
  border-radius: 50%;
  opacity: 0;
  box-shadow: 0 0 6rpx 2rpx rgba(244,212,140,0.20);
}

.s1 { top: 15%; left: 8%;  animation: sparkle-float 3.2s ease-in-out 0.3s infinite; }
.s2 { top: 22%; left: 88%; animation: sparkle-float 3.8s ease-in-out 0.9s infinite; }
.s3 { top: 70%; left: 10%; animation: sparkle-float 2.8s ease-in-out 0.1s infinite; }
.s4 { top: 65%; left: 85%; animation: sparkle-float 3.5s ease-in-out 1.6s infinite; }
.s5 { top: 40%; left: 48%; animation: sparkle-float 4.2s ease-in-out 2.2s infinite; }
.s6 { top: 82%; left: 42%; animation: sparkle-float 2.6s ease-in-out 0.7s infinite; }

@keyframes sparkle-float {
  0%, 100% {
    opacity: 0;
    transform: translateY(12rpx) scale(0.4);
  }
  25% {
    opacity: 0.2;
    transform: translateY(-6rpx) scale(1.1);
  }
  50% {
    opacity: 0.12;
    transform: translateY(-12rpx) scale(0.7);
  }
  75% {
    opacity: 0.15;
    transform: translateY(-2rpx) scale(0.9);
  }
}

/* ============================================================
   19. DAILY HABIT LOOP — Streak, Reflection, Reminder
   ============================================================ */

/* --- Reminder badges --- */
.daily-updated-badge {
  display: inline-block;
  margin-top: 16rpx;
  padding: var(--spacing-xxs) var(--spacing-sm);
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-medium);
  color: var(--color-gold);
  background: rgba(244, 212, 140, 0.10);
  border: 1rpx solid rgba(244, 212, 140, 0.20);
  border-radius: var(--radius-pill);
  letter-spacing: 1rpx;
}

.daily-reminder-badge {
  display: inline-block;
  margin-top: 16rpx;
  padding: var(--spacing-xxs) var(--spacing-sm);
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-medium);
  color: rgba(244, 212, 140, 0.55);
  background: rgba(244, 212, 140, 0.06);
  border: 1rpx solid rgba(244, 212, 140, 0.12);
  border-radius: var(--radius-pill);
  letter-spacing: 1rpx;
}

/* --- Collection progress ring --- */
.collect-progress-wrap {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  margin-top: var(--spacing-md);
  position: relative;
  z-index: 1;
}
.collect-progress-ring {
  position: relative;
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
}
.ring-bg {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 4rpx solid rgba(244, 212, 140, 0.12);
}
.ring-fill {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 4rpx solid var(--color-gold);
  /*
     WXSS does not support conic-gradient or CSS mask.
     A full gold ring is shown here; the count text (e.g. "8/22")
     inside the ring communicates the precise progress.
  */
}
.ring-text {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-semibold);
  color: var(--color-gold);
  line-height: 1;
}
.ring-label {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  letter-spacing: 1rpx;
}

/* --- Card ready pulse (FOMO-inducing) --- */
.card-ready .card-warm {
  animation:
    card-warm-breathe 5s ease-in-out infinite,
    card-ready-pulse 2s ease-in-out infinite !important;
}

@keyframes card-ready-pulse {
  0%, 100% {
    border-color: rgba(244, 212, 140, 0.40);
    box-shadow:
      0 4rpx 24rpx rgba(0, 0, 0, 0.28),
      0 0 50rpx rgba(244, 212, 140, 0.12);
  }
  50% {
    border-color: rgba(244, 212, 140, 0.70);
    box-shadow:
      0 4rpx 24rpx rgba(0, 0, 0, 0.28),
      0 0 80rpx rgba(244, 212, 140, 0.25),
      0 0 150rpx rgba(244, 212, 140, 0.10);
  }
}

/* --- Streak badge (gold, inline) --- */
.streak-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-xxs);
  margin-top: var(--spacing-sm);
  padding: var(--spacing-xxs) var(--spacing-md);
  background: rgba(244, 212, 140, 0.08);
  border: 1rpx solid rgba(244, 212, 140, 0.18);
  border-radius: var(--radius-pill);
  position: relative;
  z-index: 1;
}

.streak-icon {
  font-size: var(--font-size-caption);
  color: var(--color-gold);
  text-shadow: 0 0 12rpx rgba(244, 212, 140, 0.30);
}

.streak-count {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-medium);
  color: var(--color-gold);
  letter-spacing: 2rpx;
}

/* --- Reflection prompt --- */
.reflection-prompt {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-xxs);
  margin-top: var(--spacing-sm);
  padding: var(--spacing-sm);
  position: relative;
  z-index: 1;
}

.reflection-text {
  font-size: var(--font-size-caption);
  color: var(--color-lavender);
  line-height: var(--line-height-base);
  letter-spacing: 1rpx;
  opacity: 0.80;
}

.reflection-link {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-medium);
  color: var(--color-gold);
  letter-spacing: 1rpx;
  padding: 6rpx var(--spacing-sm);
  border-bottom: 1rpx dashed rgba(244, 212, 140, 0.25);
  transition: all var(--duration-fast) var(--ease-out);
}

.reflection-link:active {
  opacity: 0.70;
  border-bottom-color: rgba(244, 212, 140, 0.50);
}

/* -----------------------------------------------------------
   11. FREE TIER — Progress bar style
   ----------------------------------------------------------- */
.free-quota-bar {
  margin: var(--spacing-lg) 0 var(--spacing-sm);
  text-align: center;
  padding: var(--spacing-sm) var(--spacing-lg);
}

.quota-progress-wrap {
  width: 240rpx;
  height: 8rpx;
  background: rgba(184, 169, 224, 0.12);
  border-radius: 999rpx;
  margin: 0 auto var(--spacing-xs);
  overflow: hidden;
}

.quota-progress {
  height: 100%;
  background: linear-gradient(90deg, #F4D48C, #D4B06A);
  border-radius: 999rpx;
  transition: width 0.4s ease-out;
}

.quota-text {
  font-size: var(--font-size-xs);
  color: var(--color-lavender, #C8B8E8);
  letter-spacing: 0.04em;
  line-height: 1.6;
}

.quota-text--exhausted {
  color: var(--color-gold, #F4D48C);
  font-weight: 500;
}

/* -----------------------------------------------------------
   11b. 9.9新人专享 CTA
   ----------------------------------------------------------- */
.hero-cta {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-lg) var(--spacing-md);
  margin: var(--spacing-sm) 0 var(--spacing-lg);
  background: linear-gradient(135deg, rgba(244,212,140,0.12) 0%, rgba(180,140,200,0.08) 100%);
  border: 2rpx solid rgba(244,212,140,0.40);
  border-radius: var(--radius-lg, 24rpx);
  overflow: hidden;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
  animation: hero-cta-breathe 2.5s ease-in-out infinite;
}

.hero-cta:active {
  transform: scale(0.97);
  border-color: rgba(244,212,140,0.70);
}

.hero-cta-glow {
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(
    ellipse at center,
    rgba(244, 212, 140, 0.06) 0%,
    transparent 60%
  );
  pointer-events: none;
  animation: hero-cta-glow-pulse 3s ease-in-out infinite;
}

.hero-cta-title {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-bold, 700);
  color: var(--color-gold, #F4D48C);
  letter-spacing: 3rpx;
  position: relative;
  z-index: 1;
  text-shadow: 0 0 20rpx rgba(244,212,140,0.15);
}

.hero-cta-sub {
  font-size: var(--font-size-caption);
  color: var(--color-lavender, #B8A9E0);
  margin-top: 8rpx;
  letter-spacing: 2rpx;
  position: relative;
  z-index: 1;
  opacity: 0.85;
}

@keyframes hero-cta-breathe {
  0%, 100% {
    border-color: rgba(244,212,140,0.35);
    box-shadow: 0 0 20rpx rgba(244,212,140,0.08);
  }
  50% {
    border-color: rgba(244,212,140,0.70);
    box-shadow: 0 0 40rpx rgba(244,212,140,0.20), 0 0 80rpx rgba(244,212,140,0.10);
  }
}

@keyframes hero-cta-glow-pulse {
  0%, 100% { opacity: 0.4; transform: scale(1); }
  50% { opacity: 0.8; transform: scale(1.05); }
}

/* ============================================================
   20. TAROT EXPLAINER — Subtle link at bottom of home
   ============================================================ */
.tarot-explainer-wrap {
  text-align: center;
  margin-top: 32rpx;
  padding-bottom: 40rpx;
}

.tarot-explainer-link {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary, #A098C0);
  opacity: 0.55;
  letter-spacing: 2rpx;
  padding: var(--spacing-xs) var(--spacing-md);
  display: inline-block;
  transition: opacity var(--duration-fast) var(--ease-out);
}

.tarot-explainer-link:active {
  opacity: 0.9;
}

/* ============================================================
   20b. FLEXBOX GRID — WXSS-compatible replacements for CSS Grid
   WXSS does NOT support display:grid
   ============================================================ */

/* 3-column skeleton grid */
.skeleton-grid-3 {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
}

.skeleton-grid-3 > .skeleton--card-sm {
  width: calc((100% - 32rpx) / 3);
}

/* 2-column spread card grid */
.spread-grid-2 {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
}

.spread-grid-2 > .card-press {
  width: calc((100% - 16rpx) / 2);
  box-sizing: border-box;
}

/* ============================================================
   22. DAILY CARD TEACHING ENTRY — v2.0
   ============================================================ */

.daily-card-teaching {
  position: relative;
}

/* Teaching card variant — compact thumbnail + CTA */
.card--teaching {
  position: relative;
  overflow: hidden;
  border-color: var(--color-gold-dark, #D4B06A) !important;
  background: linear-gradient(145deg, #2A2A5E 0%, #2E2E62 100%);
  box-shadow:
    0 4rpx 24rpx rgba(0, 0, 0, 0.28),
    0 0 50rpx rgba(244, 212, 140, 0.15),
    0 0 100rpx rgba(244, 212, 140, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-xl) var(--spacing-lg) var(--spacing-lg);
  text-align: center;
}

/* Card thumbnail */
.daily-card-thumb-wrap {
  width: 200rpx;
  height: 280rpx;
  margin-bottom: 20rpx;
  border-radius: var(--radius-md, 16rpx);
  overflow: hidden;
  box-shadow: 0 0 30rpx rgba(244, 212, 140, 0.20), 0 0 60rpx rgba(244, 212, 140, 0.08);
}

.daily-card-thumb {
  width: 100%;
  height: 100%;
}

/* Fallback for daily card thumbnail when image fails to load */
.daily-card-thumb-wrap.daily-card-thumb-error {
  background: linear-gradient(145deg, #25255A 0%, #2E2E62 100%);
  border: 1rpx solid rgba(212, 168, 83, 0.20);
  display: flex;
  align-items: center;
  justify-content: center;
}

.daily-card-thumb-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.thumb-fallback-name {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-medium);
  color: var(--color-lavender-light);
  text-align: center;
  letter-spacing: 3rpx;
  padding: var(--spacing-xs) var(--spacing-sm);
  background: rgba(26, 16, 53, 0.70);
  border: 1rpx solid rgba(212, 168, 83, 0.20);
  border-radius: var(--radius-sm);
  max-width: 80%;
  line-height: 1.5;
  text-shadow: 0 0 8rpx rgba(212, 168, 83, 0.30);
}

/* Card name */
.daily-card-name {
  display: block;
  margin-bottom: 8rpx;
  color: var(--color-gold, #F4D48C);
}

/* CTA text (unflipped) */
.daily-card-cta {
  display: block;
  color: var(--color-lavender, #B8A9E0);
  letter-spacing: 2rpx;
  opacity: 0.85;
}

/* Revisit text (flipped) */
.daily-card-revisit {
  display: block;
  color: var(--color-text-tertiary, #A098C0);
  opacity: 0.65;
}

/* "已学习 ✓" badge — green, pill-shaped */
.daily-card-badge {
  display: inline-block;
  padding: 6rpx var(--spacing-sm);
  font-size: var(--font-size-caption, 24rpx);
  font-weight: var(--font-weight-medium, 500);
  color: #5EE0A0;
  background: rgba(94, 224, 160, 0.12);
  border: 1rpx solid rgba(94, 224, 160, 0.25);
  border-radius: var(--radius-pill, 999rpx);
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

/* Breathing glow border animation (unflipped state) */
.daily-card-glow-overlay {
  position: absolute;
  top: -4rpx;
  left: -4rpx;
  right: -4rpx;
  bottom: -4rpx;
  border-radius: inherit;
  pointer-events: none;
  border: 2rpx solid rgba(244, 212, 140, 0.40);
  animation: daily-glow-breathe 2s ease-in-out infinite;
}

@keyframes daily-glow-breathe {
  0%, 100% {
    opacity: 0.6;
    border-color: rgba(244, 212, 140, 0.40);
    box-shadow: 0 0 30rpx rgba(244, 212, 140, 0.12);
  }
  50% {
    opacity: 1.0;
    border-color: rgba(244, 212, 140, 0.80);
    box-shadow: 0 0 60rpx rgba(244, 212, 140, 0.25), 0 0 120rpx rgba(244, 212, 140, 0.12), 0 0 180rpx rgba(244, 212, 140, 0.05);
  }
}

/* ============================================================
   24. TASKS CARD — "今日任务" widget on homepage
   ============================================================ */

.tasks-card {
  padding: var(--spacing-md, 24rpx);
  background: linear-gradient(145deg, #25255A 0%, #2A2A5E 100%);
  border: 1.5rpx solid rgba(244, 212, 140, 0.12);
  border-radius: var(--radius-lg, 24rpx);
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
  transition: all var(--duration-fast) var(--ease-out);
}

.tasks-card:active {
  transform: scale(0.97);
  border-color: rgba(244, 212, 140, 0.20) !important;
}

.tasks-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-sm, 16rpx);
}

.tasks-card-title {
  font-size: var(--font-size-subhead, 36rpx);
  font-weight: 600;
  color: var(--color-gold, #F4D48C);
  letter-spacing: 3rpx;
}

.tasks-card-stats {
  display: flex;
  align-items: center;
  gap: var(--spacing-xs, 12rpx);
}

.tasks-card-progress {
  font-size: var(--font-size-xs, 20rpx);
  color: var(--color-lavender, #B8A9E0);
  letter-spacing: 1rpx;
  flex-shrink: 0;
}

.tasks-progress-bar {
  width: 60rpx;
  height: 6rpx;
  background: rgba(184, 169, 224, 0.12);
  border-radius: 999rpx;
  overflow: hidden;
}

.tasks-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #F4D48C, #D4B06A);
  border-radius: 999rpx;
  transition: width 0.4s ease-out;
}

.tasks-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-xs, 12rpx);
  margin-bottom: var(--spacing-sm, 16rpx);
}

.task-item {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm, 16rpx);
  padding: var(--spacing-xs, 12rpx) 0;
  border-bottom: 1rpx solid rgba(244, 212, 140, 0.06);
}

.task-item:last-child {
  border-bottom: none;
}

.task-check {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(244, 212, 140, 0.20);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.task-check--checked {
  background: linear-gradient(135deg, #F4D48C 0%, #D4B06A 100%);
  border-color: #F4D48C;
}

.task-check-icon {
  font-size: 18rpx;
  color: #1A1A3E;
  font-weight: 700;
}

.task-name {
  font-size: var(--font-size-caption, 24rpx);
  color: var(--color-text-primary, #F0EDE8);
  letter-spacing: 1rpx;
}

.task-item--done .task-name {
  color: var(--color-gold, #F4D48C);
  text-decoration: line-through;
  opacity: 0.7;
}

.tasks-card-footer {
  padding-top: var(--spacing-xs, 12rpx);
  border-top: 1rpx solid rgba(244, 212, 140, 0.06);
}

.tasks-card-reward {
  font-size: var(--font-size-xs, 20rpx);
  color: var(--color-text-tertiary, #9A95B8);
  letter-spacing: 1rpx;
  display: block;
  text-align: center;
}

/* ============================================================
   ACCESSIBILITY: Reduced Motion
   ============================================================ */
@media (prefers-reduced-motion: reduce) {
  .hero::before,
  .hero-glow-rings::before,
  .hero-glow-rings::after,
  .stars-layer::after,
  .nebula,
  .shooting-star::after,
  .card-warm,
  .card--teaching,
  .daily-card-glow-overlay,
  .sparkle-field .sparkle,
  .hero-cta,
  .hero-cta-glow {
    animation: none !important;
  }
  .sparkle-field .sparkle { opacity: 0; }
  .daily-card-glow-overlay { opacity: 0.6; border-color: rgba(244,212,140,0.30); }
  .to-star { animation: none !important; opacity: 0.08; }
  .tarot-overlay-content { animation: none; }
}

/* ============================================================
   25. TAROT EXPLAINER OVERLAY — Immersive cosmic overlay
   Full-screen fixed overlay with centered card content,
   golden border, floating stars, and an entrance animation.
   ============================================================ */

/* --- Full-screen backdrop --- */
.tarot-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(26, 26, 62, 0.96);
  z-index: var(--z-modal);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-lg);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.4s var(--ease-soft);
}

.tarot-overlay--visible {
  opacity: 1;
  pointer-events: auto;
}

/* --- Centered content card --- */
.tarot-overlay-content {
  position: relative;
  width: 100%;
  max-width: 580rpx;
  background: linear-gradient(145deg, #25255A 0%, #2A2A5E 100%);
  border: 1.5rpx solid rgba(244, 212, 140, 0.30);
  border-radius: var(--radius-lg);
  padding: var(--spacing-2xl) var(--spacing-lg) var(--spacing-xl);
  text-align: center;
  overflow: hidden;
  box-shadow:
    0 8rpx 40rpx rgba(0, 0, 0, 0.35),
    0 0 60rpx rgba(244, 212, 140, 0.10),
    0 0 120rpx rgba(244, 212, 140, 0.05);
  animation: overlay-enter 0.4s var(--ease-soft) forwards;
  transform-origin: center;
}

@keyframes overlay-enter {
  0% {
    opacity: 0;
    transform: scale(0.92);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}

/* --- Star particles inside the card (reuse sparkle-float) --- */
.tarot-overlay-stars {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  overflow: hidden;
  border-radius: inherit;
}

.to-star {
  position: absolute;
  width: 4rpx;
  height: 4rpx;
  background: #F4D48C;
  border-radius: 50%;
  opacity: 0;
  box-shadow: 0 0 6rpx 2rpx rgba(244, 212, 140, 0.20);
}

.to-star.s1 { top: 12%; left: 10%; animation: sparkle-float 3.2s ease-in-out 0.3s infinite; }
.to-star.s2 { top: 18%; left: 85%; animation: sparkle-float 3.8s ease-in-out 0.9s infinite; }
.to-star.s3 { top: 75%; left: 8%; animation: sparkle-float 2.8s ease-in-out 0.1s infinite; }
.to-star.s4 { top: 70%; left: 88%; animation: sparkle-float 3.5s ease-in-out 1.6s infinite; }
.to-star.s5 { top: 85%; left: 45%; animation: sparkle-float 4.2s ease-in-out 2.2s infinite; }
.to-star.s6 { top: 30%; left: 50%; animation: sparkle-float 2.6s ease-in-out 0.7s infinite; }

/* --- Central glowing card icon --- */
.tarot-overlay-icon {
  position: relative;
  margin-bottom: var(--spacing-lg);
}

.to-card-icon {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(244, 212, 140, 0.08);
  border: 1.5rpx solid rgba(244, 212, 140, 0.25);
  border-radius: var(--radius-lg);
  box-shadow:
    0 0 40rpx rgba(244, 212, 140, 0.12),
    0 0 80rpx rgba(244, 212, 140, 0.05);
  position: relative;
  z-index: 1;
}

.to-card-emoji {
  font-size: 52rpx;
}

/* --- Title in gold --- */
.tarot-overlay-title {
  display: block;
  font-size: var(--font-size-title);
  font-weight: var(--font-weight-semibold);
  color: var(--color-gold);
  line-height: var(--line-height-tight);
  letter-spacing: 4rpx;
  margin-bottom: var(--spacing-md);
  position: relative;
  z-index: 1;
  text-shadow: 0 0 30rpx rgba(244, 212, 140, 0.12);
}

/* --- Body text in lavender --- */
.tarot-overlay-body {
  display: block;
  font-size: var(--font-size-caption);
  color: var(--color-lavender);
  line-height: var(--line-height-loose);
  letter-spacing: 2rpx;
  position: relative;
  z-index: 1;
  opacity: 0.90;
}

/* --- Button — gold gradient matching .btn-primary --- */
.tarot-overlay-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: var(--spacing-lg) auto 0;
  padding: 24rpx 48rpx;
  background: linear-gradient(135deg, #F4D48C 0%, #E8C67A 50%, #D4B06A 100%);
  border-radius: var(--radius-pill);
  color: var(--color-text-inverse);
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-medium);
  letter-spacing: 3rpx;
  box-shadow: var(--shadow-gold-button);
  position: relative;
  z-index: 1;
  transition: all var(--duration-fast) var(--ease-out);
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
  max-width: 320rpx;
}

/* ============================================================
   26. TIME-OF-DAY GREETING — Gentle fade-in on each page visit
   ============================================================ */

.greeting-text {
  display: block;
  font-size: var(--font-size-caption, 24rpx);
  font-weight: var(--font-weight-medium, 500);
  color: var(--color-lavender, #B8A9E0);
  letter-spacing: 3rpx;
  margin-top: 16rpx;
  opacity: 0.85;
  text-shadow: 0 0 20rpx rgba(184, 169, 224, 0.08);
  position: relative;
  z-index: 1;
}

.anim-greeting-fade {
  animation: greeting-fade-in 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
}

@keyframes greeting-fade-in {
  0% {
    opacity: 0;
    transform: translateY(8rpx);
  }
  100% {
    opacity: 0.85;
    transform: translateY(0);
  }
}

/* ============================================================
   27. ONBOARDING OVERLAY (v2.1) — Full-screen 3-step flow
   ============================================================ */

.onboarding-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(26, 26, 62, 0.97);
  z-index: var(--z-modal, 1000);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-lg, 32rpx);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.4s var(--ease-soft);
}

.onboarding-overlay--visible {
  opacity: 1;
  pointer-events: auto;
}

.onboarding-card {
  position: relative;
  width: 100%;
  max-width: 580rpx;
  background: linear-gradient(145deg, #25255A 0%, #2A2A5E 100%);
  border: 1.5rpx solid rgba(244, 212, 140, 0.30);
  border-radius: var(--radius-lg, 24rpx);
  padding: var(--spacing-2xl, 48rpx) var(--spacing-lg, 32rpx) var(--spacing-xl, 32rpx);
  text-align: center;
  box-shadow:
    0 8rpx 40rpx rgba(0, 0, 0, 0.35),
    0 0 60rpx rgba(244, 212, 140, 0.10);
  animation: overlay-enter 0.4s var(--ease-soft) forwards;
}

/* Step dots */
.onboarding-dots {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: var(--spacing-xl, 48rpx);
}

.onboarding-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(244, 212, 140, 0.15);
  transition: all 0.3s ease;
}

.onboarding-dot--active {
  background: var(--color-gold, #F4D48C);
  box-shadow: 0 0 12rpx rgba(244, 212, 140, 0.40);
  width: 24rpx;
  border-radius: 12rpx;
}

/* Step content */
.onboarding-step {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.onboarding-emoji-wrap {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto var(--spacing-lg, 32rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(244, 212, 140, 0.08);
  border: 1.5rpx solid rgba(244, 212, 140, 0.25);
  border-radius: var(--radius-lg, 24rpx);
  box-shadow:
    0 0 40rpx rgba(244, 212, 140, 0.12),
    0 0 80rpx rgba(244, 212, 140, 0.05);
}

.onboarding-emoji {
  font-size: 52rpx;
}

.onboarding-title {
  display: block;
  font-size: var(--font-size-title, 40rpx);
  font-weight: var(--font-weight-semibold, 600);
  color: var(--color-gold, #F4D48C);
  letter-spacing: 4rpx;
  margin-bottom: var(--spacing-sm, 24rpx);
  text-shadow: 0 0 30rpx rgba(244, 212, 140, 0.12);
}

.onboarding-desc {
  display: block;
  font-size: var(--font-size-body, 30rpx);
  color: var(--color-text-primary, #F0EDE8);
  line-height: var(--line-height-base, 1.6);
  letter-spacing: 2rpx;
  margin-bottom: var(--spacing-xs, 12rpx);
}

.onboarding-sub {
  display: block;
  font-size: var(--font-size-caption, 24rpx);
  color: var(--color-lavender, #B8A9E0);
  opacity: 0.80;
  letter-spacing: 2rpx;
  margin-top: var(--spacing-xs, 12rpx);
  line-height: var(--line-height-base, 1.6);
}

/* Navigation button */
.onboarding-nav {
  margin-top: var(--spacing-xl, 48rpx);
}

.onboarding-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 64rpx;
  background: linear-gradient(135deg, #F4D48C 0%, #E8C67A 50%, #D4B06A 100%);
  border-radius: var(--radius-pill, 999rpx);
  box-shadow: var(--shadow-gold-button);
  transition: all var(--duration-fast) var(--ease-out);
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}

.onboarding-btn:active {
  transform: scale(0.97);
  opacity: 0.92;
}

.onboarding-btn-text {
  font-size: var(--font-size-body, 30rpx);
  font-weight: var(--font-weight-medium, 500);
  color: var(--color-text-inverse);
  letter-spacing: 4rpx;
}

/* ============================================================
   28. ZODIAC GRID (onboarding step 3)
   ============================================================ */

.zodiac-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
  margin: var(--spacing-lg, 32rpx) 0 var(--spacing-sm, 24rpx);
  width: 100%;
  max-width: 480rpx;
}

.zodiac-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: calc((100% - 32rpx) / 3);
  padding: 16rpx 8rpx;
  background: rgba(244, 212, 140, 0.06);
  border: 1.5rpx solid rgba(244, 212, 140, 0.15);
  border-radius: var(--radius-md, 16rpx);
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
  transition: all var(--duration-fast) var(--ease-out);
  box-sizing: border-box;
}

.zodiac-item:active {
  background: rgba(244, 212, 140, 0.18);
  border-color: rgba(244, 212, 140, 0.40);
  transform: scale(0.95);
}

.zodiac-item-emoji {
  font-size: 40rpx;
  display: block;
  margin-bottom: 6rpx;
}

.zodiac-item-name {
  font-size: var(--font-size-xs, 20rpx);
  color: var(--color-text-primary, #F0EDE8);
  letter-spacing: 1rpx;
  display: block;
}

/* Skip link */
.zodiac-skip {
  display: inline-block;
  padding: 12rpx 24rpx;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}

.zodiac-skip:active {
  opacity: 0.60;
}

.zodiac-skip-text {
  font-size: var(--font-size-caption, 24rpx);
  color: var(--color-text-tertiary, #A098C0);
  letter-spacing: 2rpx;
  border-bottom: 1rpx dashed rgba(160, 152, 192, 0.25);
}

@keyframes overlay-enter {
  0% {
    opacity: 0;
