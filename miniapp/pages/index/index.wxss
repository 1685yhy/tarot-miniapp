/* ============================================================
   首页 - 至尊神秘主题 v3.0
   Hero area: 神秘几何旋转同心环 + 铭文标题
   Daily card: 装饰牌背花纹 + 魔法翻开动画
   Spread grid: 塔罗牌桌微型画 + 金角边框
   Star field: 30颗星辰 / 3层景深 / 金银紫三色
   ============================================================ */

/* ===== 1. 页面级动画（全部 < 3s 单次 / 无限循环除外） ===== */

/* 金色呼召 - 每日牌背"抽我"暗示 */
@keyframes card-call {
  0%, 100% {
    box-shadow:
      0 0 20rpx rgba(212, 175, 55, 0.08),
      inset 0 0 20rpx rgba(212, 175, 55, 0.02);
  }
  50% {
    box-shadow:
      0 0 40rpx rgba(212, 175, 55, 0.18),
      0 0 80rpx rgba(212, 175, 55, 0.06),
      inset 0 0 30rpx rgba(212, 175, 55, 0.04);
  }
}

/* 魔法翻开 - 每日牌结果 */
@keyframes card-reveal {
  0% {
    transform: perspective(800rpx) rotateY(180deg);
    opacity: 0;
  }
  25% {
    transform: perspective(800rpx) rotateY(100deg);
    opacity: 0.2;
  }
  50% {
    transform: perspective(800rpx) rotateY(20deg);
    opacity: 0.7;
  }
  75% {
    transform: perspective(800rpx) rotateY(-5deg);
    opacity: 0.95;
  }
  100% {
    transform: perspective(800rpx) rotateY(0deg);
    opacity: 1;
  }
}

/* 星辰闪烁 - 金色 */
@keyframes twinkle-gold {
  0%, 100% { opacity: 0.1; transform: scale(0.5); }
  50% { opacity: 1; transform: scale(1.15); }
}

/* 星辰闪烁 - 银色 */
@keyframes twinkle-silver {
  0%, 100% { opacity: 0.06; transform: scale(0.4); }
  50% { opacity: 0.65; transform: scale(1.0); }
}

/* 星辰闪烁 - 紫色 */
@keyframes twinkle-purple {
  0%, 100% { opacity: 0.04; transform: scale(0.3); }
  50% { opacity: 0.5; transform: scale(0.9); }
}

/* 景深漂移 - 远景 (慢) */
@keyframes drift-slow {
  0%, 100% { transform: translate(0, 0); }
  33% { transform: translate(3rpx, -5rpx); }
  66% { transform: translate(-2rpx, -8rpx); }
}

/* 景深漂移 - 中景 (中) */
@keyframes drift-mid {
  0%, 100% { transform: translate(0, 0); }
  33% { transform: translate(5rpx, -7rpx); }
  66% { transform: translate(-3rpx, -12rpx); }
}

/* 景深漂移 - 近景 (快) */
@keyframes drift-close {
  0%, 100% { transform: translate(0, 0); }
  33% { transform: translate(8rpx, -10rpx); }
  66% { transform: translate(-5rpx, -16rpx); }
}

/* 徽章呼吸脉冲 */
@keyframes badge-glow {
  0%, 100% {
    box-shadow: 0 0 4rpx rgba(212, 175, 55, 0.15);
  }
  50% {
    box-shadow:
      0 0 12rpx rgba(212, 175, 55, 0.3),
      0 0 24rpx rgba(212, 175, 55, 0.08);
  }
}

/* 分割标题下的装饰线游走 */
@keyframes title-line-glow {
  0%, 100% { opacity: 0.3; }
  50% { opacity: 0.9; }
}


