/* ===== 首页 - 至尊神秘主题 ===== */

/* 顶部神秘学氛围区 */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-massive) 0 var(--space-xxxl);
}

.mystic-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-full);
  background: radial-gradient(circle, var(--color-purple-glow), transparent);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--space-xl);
}

.hero-title {
  font-size: var(--fs-h1);
  font-weight: var(--fw-bold);
  color: var(--color-gold);
  line-height: var(--lh-tight);
  margin-bottom: var(--space-sm);
}

.hero-subtitle {
  font-size: var(--fs-body);
  color: var(--color-text-secondary);
}

/* 每日一牌卡片 */
.daily-card-wrapper {
  margin: var(--space-lg) 0 var(--space-xxxl);
}

.card-daily-back {
  background: linear-gradient(135deg, var(--color-purple-dark), var(--color-bg-card));
  border: 2rpx solid var(--color-purple);
  border-radius: var(--radius-card);
  padding: var(--space-massive) var(--space-xxl);
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: all var(--duration-normal) var(--ease-out);
}

.card-daily-back:active {
  transform: scale(0.97);
}

.card-daily-result {
  background: linear-gradient(135deg, var(--color-bg-card), var(--color-purple-dark));
  border: 2rpx solid var(--color-gold);
  border-radius: var(--radius-card);
  padding: var(--space-massive) var(--space-xxl);
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: var(--shadow-glow-gold);
}

/* 选择牌阵区块 */
.spread-section {
  margin-bottom: var(--space-massive);
}

.spread-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-md);
}

/* ===== 加载骨架 ===== */
.skeleton {
  padding: var(--space-xxl) 0;
}

.skeleton-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-lg);
  margin-bottom: var(--space-xxxl);
}

.skeleton-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-full);
  background: var(--color-bg-card);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-line {
  height: 32rpx;
  border-radius: var(--radius-sm);
  background: var(--color-bg-card);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-line.wide { width: 300rpx; }
.skeleton-line.medium { width: 200rpx; }

.skeleton-card-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-lg);
  margin-bottom: var(--space-xxxl);
}

.skeleton-block {
  width: 100%;
  height: 200rpx;
  border-radius: var(--radius-card);
  background: var(--color-bg-card);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-md);
}

.skeleton-grid-item {
  height: 180rpx;
  border-radius: var(--radius-lg);
  background: var(--color-bg-card);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

/* ===== 空状态 ===== */

/* ===== 错误状态 ===== */
.error-state {
  text-align: center;
  padding: var(--space-massive) var(--space-xl);
}

.error-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: var(--space-md);
  opacity: 0.6;
}

.error-text {
  font-size: var(--fs-body);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--space-xs);
}

.error-hint {
  font-size: var(--fs-body-small);
  color: var(--color-text-dim);
  display: block;
  margin-bottom: var(--space-xxl);
}
