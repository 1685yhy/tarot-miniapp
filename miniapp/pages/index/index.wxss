/* ============================================================
   "Twilight Sanctuary" — 暮光圣所 设计系统 v1.0
   ============================================================
   色彩基调：暖金 × 暗紫 × 午夜蓝
   设计理念：一切皆有触感 — 光泽、景深、呼吸感
   ============================================================ */

/* ===== 0. 设计标记变量（扩展主题） ===== */
:root {
  --twilight-gold: #C8A84E;
  --twilight-gold-bright: #F0D878;
  --twilight-gold-warm: #E8A844;
  --twilight-gold-dim: rgba(200, 168, 78, 0.35);
  --twilight-purple: #7B6BB0;
  --twilight-purple-deep: #2D1F5E;
  --twilight-bg: #0D0B1A;
  --twilight-bg-card: #120F24;
  --twilight-star-white: #F5F0E8;
  --twilight-shadow-soft: 0 8rpx 32rpx rgba(0, 0, 0, 0.4);
  --twilight-shadow-card: 0 12rpx 48rpx rgba(0, 0, 0, 0.5), 0 4rpx 16rpx rgba(0, 0, 0, 0.3);
}


/* ===== 1. 动画系统 ===== */

/* ——— 金色呼召（增强） ——— */
@keyframes card-call {
  0%, 100% {
    box-shadow:
      0 0 20rpx rgba(200, 168, 78, 0.10),
      0 0 40rpx rgba(200, 168, 78, 0.04),
      inset 0 0 30rpx rgba(200, 168, 78, 0.03),
      inset 0 0 60rpx rgba(200, 168, 78, 0.01);
  }
  50% {
    box-shadow:
      0 0 40rpx rgba(200, 168, 78, 0.20),
      0 0 80rpx rgba(200, 168, 78, 0.08),
      0 0 120rpx rgba(200, 168, 78, 0.04),
      inset 0 0 40rpx rgba(200, 168, 78, 0.06),
      inset 0 0 80rpx rgba(200, 168, 78, 0.02);
  }
}

/* ——— 牌面揭示（更强的透视深度） ——— */
@keyframes card-reveal {
  0% {
    transform: perspective(1000rpx) rotateY(180deg) scale(0.85);
    opacity: 0;
  }
  20% {
    transform: perspective(1000rpx) rotateY(130deg) scale(0.90);
    opacity: 0.15;
  }
  40% {
    transform: perspective(1000rpx) rotateY(80deg) scale(0.96);
    opacity: 0.40;
  }
  60% {
    transform: perspective(1000rpx) rotateY(30deg) scale(1.01);
    opacity: 0.72;
  }
  80% {
    transform: perspective(1000rpx) rotateY(-8deg) scale(1.02);
    opacity: 0.92;
  }
  100% {
    transform: perspective(1000rpx) rotateY(0deg) scale(1);
    opacity: 1;
  }
}

/* ——— 星辰闪烁 ——— */
@keyframes twinkle-gold {
  0%, 100% { opacity: 0.06; transform: scale(0.3); }
  25% { opacity: 0.95; transform: scale(1.25); }
  50% { opacity: 1.0; transform: scale(1.0); }
  75% { opacity: 0.25; transform: scale(0.6); }
}
@keyframes twinkle-silver {
  0%, 100% { opacity: 0.03; transform: scale(0.25); }
  30% { opacity: 0.75; transform: scale(1.1); }
  60% { opacity: 0.15; transform: scale(0.5); }
}
@keyframes twinkle-purple {
  0%, 100% { opacity: 0.02; transform: scale(0.2); }
  35% { opacity: 0.55; transform: scale(0.9); }
  65% { opacity: 0.08; transform: scale(0.35); }
}

/* ——— 微光（极暗星用） ——— */
@keyframes twinkle-dim {
  0%, 100% { opacity: 0.008; transform: scale(0.15); }
  50% { opacity: 0.05; transform: scale(0.45); }
}
/* ——— 中等亮度 ——— */
@keyframes twinkle-mid {
  0%, 100% { opacity: 0.04; transform: scale(0.35); }
  50% { opacity: 0.40; transform: scale(0.8); }
}

/* ——— 景深漂移 ——— */
@keyframes drift-slow {
  0%, 100% { transform: translate(0, 0); }
  33% { transform: translate(4rpx, -6rpx); }
  66% { transform: translate(-3rpx, -10rpx); }
}
@keyframes drift-mid {
  0%, 100% { transform: translate(0, 0); }
  33% { transform: translate(7rpx, -9rpx); }
  66% { transform: translate(-4rpx, -14rpx); }
}
@keyframes drift-close {
  0%, 100% { transform: translate(0, 0); }
  33% { transform: translate(10rpx, -12rpx); }
  66% { transform: translate(-6rpx, -18rpx); }
}

/* ——— 徽章呼吸 ——— */
@keyframes badge-glow {
  0%, 100% {
    box-shadow:
      0 0 6rpx rgba(200, 168, 78, 0.15),
      inset 0 0 6rpx rgba(200, 168, 78, 0.05);
  }
  50% {
    box-shadow:
      0 0 16rpx rgba(200, 168, 78, 0.35),
      0 0 32rpx rgba(200, 168, 78, 0.10),
      inset 0 0 12rpx rgba(200, 168, 78, 0.08);
  }
}

/* ——— 分割线辉光 ——— */
@keyframes title-line-glow {
  0%, 100% { opacity: 0.25; }
  50% { opacity: 0.95; }
}

/* ——— 英雄区环 ——— */
@keyframes ring-cw {
  0% { transform: translate(-50%, -50%) rotate(0deg); }
  100% { transform: translate(-50%, -50%) rotate(360deg); }
}
@keyframes ring-ccw {
  0% { transform: translate(-50%, -50%) rotate(0deg); }
  100% { transform: translate(-50%, -50%) rotate(-360deg); }
}

/* ——— 抽取仪式：辉光脉冲 ——— */
@keyframes ritual-pulse {
  0%, 100% {
    box-shadow:
      0 0 30rpx rgba(200, 168, 78, 0.12),
      0 0 60rpx rgba(200, 168, 78, 0.04),
      inset 0 0 40rpx rgba(200, 168, 78, 0.04);
    border-color: rgba(200, 168, 78, 0.20);
  }
  25% {
    box-shadow:
      0 0 50rpx rgba(200, 168, 78, 0.22),
      0 0 100rpx rgba(200, 168, 78, 0.08),
      0 0 150rpx rgba(240, 216, 120, 0.04),
      inset 0 0 60rpx rgba(200, 168, 78, 0.06);
    border-color: rgba(200, 168, 78, 0.35);
  }
  50% {
    box-shadow:
      0 0 70rpx rgba(240, 216, 120, 0.18),
      0 0 140rpx rgba(200, 168, 78, 0.06),
      0 0 200rpx rgba(240, 216, 120, 0.03),
      inset 0 0 80rpx rgba(200, 168, 78, 0.05);
    border-color: rgba(240, 216, 120, 0.30);
  }
  75% {
    box-shadow:
      0 0 40rpx rgba(200, 168, 78, 0.28),
      0 0 80rpx rgba(200, 168, 78, 0.10),
      inset 0 0 50rpx rgba(200, 168, 78, 0.07);
    border-color: rgba(200, 168, 78, 0.40);
  }
}

/* ——— 抽取仪式：旋转光晕 ——— */
@keyframes ritual-aura {
  0% { transform: translate(-50%, -50%) rotate(0deg); opacity: 0.3; }
  50% { opacity: 0.8; }
  100% { transform: translate(-50%, -50%) rotate(360deg); opacity: 0.3; }
}

/* ——— 抽取仪式：内圈反转光晕 ——— */
@keyframes ritual-aura-reverse {
  0% { transform: translate(-50%, -50%) rotate(360deg); opacity: 0.15; }
  50% { opacity: 0.45; }
  100% { transform: translate(-50%, -50%) rotate(0deg); opacity: 0.15; }
}

/* ——— 抽取仪式：粒子升腾 ——— */
@keyframes ritual-particle-rise {
  0% {
    transform: translateY(0) scale(1);
    opacity: 0;
  }
  15% {
    opacity: 0.6;
  }
  50% {
    opacity: 0.8;
    transform: translateY(-60rpx) scale(0.5);
  }
  100% {
    transform: translateY(-120rpx) scale(0);
    opacity: 0;
  }
}

/* ——— 抽取仪式：光纹扫过 ——— */
@keyframes ritual-sweep {
  0% { background-position: 200% 0, 0 0; }
  100% { background-position: -100% 0, 0 0; }
}

/* ——— 抽取仪式：符文旋转 ——— */
@keyframes ritual-rune-spin {
  0% { transform: translate(-50%, -50%) rotate(0deg) scale(1); opacity: 0.1; }
  25% { opacity: 0.35; }
  50% { transform: translate(-50%, -50%) rotate(180deg) scale(1.05); opacity: 0.15; }
  75% { opacity: 0.35; }
  100% { transform: translate(-50%, -50%) rotate(360deg) scale(1); opacity: 0.1; }
}


/* ===== 2. 星尘粒子背景（30颗星，7级亮度） ===== */

.star-particle {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

/* ——— 第 1 层：极暗星（opacity 0.008-0.05，1-2rpx） ——— */
.star-particle:nth-child(1) {
  top: 3%; left: 22%; width: 1.5rpx; height: 1.5rpx;
  background: #F5F0E8;
  animation: twinkle-dim 7s ease-in-out 0s infinite, drift-slow 10s ease-in-out infinite;
}
.star-particle:nth-child(2) {
  top: 8%; left: 72%; width: 1rpx; height: 1rpx;
  background: #F5F0E8;
  animation: twinkle-dim 8.5s ease-in-out 1.3s infinite, drift-slow 9s ease-in-out infinite;
}
.star-particle:nth-child(3) {
  top: 15%; left: 8%; width: 2rpx; height: 2rpx;
  background: #C8A84E;
  animation: twinkle-dim 6.2s ease-in-out 0.5s infinite, drift-slow 11s ease-in-out infinite;
