/* ============================================================
   首页 — 柔光星辰 (Soft Starlight)
   First impression — warm, magical, like a summer night sky
   ============================================================ */

/* -----------------------------------------------------------
   1. HERO — Warm stargazing at twilight
   Overrides common.wxss .hero
   ----------------------------------------------------------- */

.hero {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 100rpx var(--spacing-md) 80rpx;
  min-height: 420rpx;
  overflow: hidden;
  z-index: var(--z-base);
}

/* --- Main golden radial glow behind the title --- */
.hero::before {
  content: '';
  position: absolute;
  top: 45%;
  left: 50%;
  width: 560rpx;
  height: 560rpx;
  transform: translate(-50%, -50%);
  background: radial-gradient(
    circle at center,
    rgba(244, 212, 140, 0.15) 0%,
    rgba(244, 212, 140, 0.08) 20%,
    rgba(244, 212, 140, 0.03) 40%,
    transparent 65%
  );
  pointer-events: none;
  z-index: 0;
  animation: hero-glow-pulse 4s ease-in-out infinite;
}

@keyframes hero-glow-pulse {
  0%, 100% {
    opacity: 0.5;
    transform: translate(-50%, -50%) scale(1);
  }
  15% {
    opacity: 0.9;
    transform: translate(-50%, -50%) scale(1.08);
  }
  30% {
    opacity: 0.6;
    transform: translate(-50%, -50%) scale(1.02);
  }
  45% {
    opacity: 0.8;
    transform: translate(-50%, -50%) scale(1.04);
  }
  60% {
    opacity: 0.5;
    transform: translate(-50%, -50%) scale(1);
  }
}

/* NOTE: ::before/::after removed from <text> — WXSS does not support on text elements */

/* -----------------------------------------------------------
   2. HERO TITLE & SUBTITLE
   ----------------------------------------------------------- */

.title-1 {
  font-size: 58rpx;
  font-weight: var(--font-weight-bold, 700);
  color: var(--color-text-primary, #F0EDE8);
  line-height: var(--line-height-tight, 1.3);
  letter-spacing: 10rpx;
  text-shadow:
    0 0 40rpx rgba(244, 212, 140, 0.10),
    0 0 80rpx rgba(244, 212, 140, 0.04);
  position: relative;
  z-index: 1;
}

.hero .body-text {
  color: var(--color-lavender, #B8A9E0);
  font-size: var(--font-size-md, 30rpx);
  letter-spacing: 4rpx;
  position: relative;
  z-index: 1;
  text-shadow: 0 0 30rpx rgba(184, 169, 224, 0.08);
}

/* -----------------------------------------------------------
   3. PAGE ANIMATIONS — Staggered entrance
   ----------------------------------------------------------- */

.anim-fade-in-up-1 {
  animation: page-fade-up 0.8s var(--ease-soft, cubic-bezier(0.25, 0.46, 0.45, 0.94)) forwards;
}

.anim-fade-in-up-2 {
  opacity: 0;
  animation: page-fade-up 0.8s var(--ease-soft, cubic-bezier(0.25, 0.46, 0.45, 0.94)) 0.25s forwards;
}

.anim-fade-in-up-3 {
  opacity: 0;
  animation: page-fade-up 0.8s var(--ease-soft, cubic-bezier(0.25, 0.46, 0.45, 0.94)) 0.5s forwards;
}

@keyframes page-fade-up {
  0% {
    opacity: 0;
    transform: translateY(30rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

/* -----------------------------------------------------------
   4. CARD VARIANTS
   ----------------------------------------------------------- */

/* --- Warm variant — dark indigo, golden promise --- */
.card-warm {
  background: linear-gradient(145deg, #25255A 0%, #2A2A5E 40%, #303065 100%);
  border: 1.5rpx solid rgba(244, 212, 140, 0.30);
  box-shadow:
    0 4rpx 24rpx rgba(0, 0, 0, 0.28),
    0 0 50rpx rgba(244, 212, 140, 0.04);
  position: relative;
  overflow: hidden;
  animation: card-warm-breathe 5s ease-in-out infinite;
}

/* Subtle warm gradient overlay */
.card-warm::after {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(
    ellipse at 30% 20%,
    rgba(244, 212, 140, 0.04) 0%,
    transparent 60%
  );
  pointer-events: none;
}

/* NOTE: card-float animation removed — restraint overrides levitation */

/* NOTE: card-shimmer (shimmer-sweep) and card-sparkles (orbit) removed — restraint */

/* --- RIPPLE EFFECT — expanding circle from center on tap --- */
.ripple-box {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  overflow: hidden;
  border-radius: inherit;
  z-index: 2;
}

.ripple-circle {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 16rpx;
  height: 16rpx;
  margin: -8rpx 0 0 -8rpx;
  background: rgba(244, 212, 140, 0.30);
  border-radius: 50%;
  transform: scale(0);
  opacity: 0;
}

.ripple-run {
  animation: ripple-expand 0.6s ease-out forwards;
}

@keyframes ripple-expand {
  0% {
    transform: scale(0);
    opacity: 1;
  }
  100% {
    transform: scale(24);
    opacity: 0;
  }
}

/* --- SHAKE — brief oscillation simulating shuffle --- */
.card-body {
  position: relative;
  z-index: 1;
}

.card-shake {
  animation: card-shake-fx 0.3s ease-out;
}

@keyframes card-shake-fx {
  0%, 100% {
    transform: translateX(0);
  }
  15% {
    transform: translateX(-3rpx);
  }
  30% {
    transform: translateX(3rpx);
  }
  45% {
    transform: translateX(-2rpx);
  }
  60% {
    transform: translateX(2rpx);
  }
  75% {
    transform: translateX(-1rpx);
  }
  90% {
    transform: translateX(1rpx);
  }
}

/* --- Pressable interaction --- */
.card-press {
  transition: all var(--duration-fast) var(--ease-out);
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}

.card-press:active {
  transform: scale(0.97);
  border-color: rgba(244, 212, 140, 0.55) !important;
  box-shadow: var(--shadow-card-press);
}

/* -----------------------------------------------------------
   4b. AFTER-DRAW — Card Reveal & Particles
   ----------------------------------------------------------- */

/* --- Revealed state base --- */
.card.card--revealed {
  position: relative;
  overflow: hidden;
  border-color: var(--color-gold-dark, #D4B06A) !important;
  background: linear-gradient(145deg, #2A2A5E 0%, #2E2E62 100%);
  box-shadow:
    0 4rpx 24rpx rgba(0, 0, 0, 0.28),
    0 0 40rpx rgba(244, 212, 140, 0.06),
    0 0 80rpx rgba(244, 212, 140, 0.03);
}

/* --- Card rise reveal (dramatic entrance) --- */
.card-rise {
  animation:
    card-rise-reveal 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0s both,
    card-glow-breathe 4s ease-in-out 0.5s infinite;
}

@keyframes card-rise-reveal {
  0% {
    opacity: 0;
    transform: scale(0.85);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}

/* NOTE: particle-field burst removed — over-decoration */

/* --- Text reveal — slide up with stagger --- */
.reveal-text {
  animation: slide-up-reveal 0.5s ease-out 0s both;
  position: relative;
  z-index: 1;
}

@keyframes slide-up-reveal {
  0% {
    opacity: 0;
    transform: translateY(20rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

/* -----------------------------------------------------------
   5. TYPOGRAPHY ALIASES (page-specific)
   ----------------------------------------------------------- */

/* Big hero title — handled by .title-1 above */

/* Card title inside daily card */
.title-2 {
  font-size: var(--font-size-2xl, 48rpx);
  font-weight: var(--font-weight-semibold, 600);
  color: var(--color-gold, #F4D48C);
  line-height: var(--line-height-tight, 1.3);
  text-shadow: 0 0 20rpx rgba(244, 212, 140, 0.08);
}

/* Card subtitle / small label */
.title-4 {
  font-size: var(--font-size-lg, 34rpx);
  font-weight: var(--font-weight-medium, 500);
  color: var(--color-text-primary, #F0EDE8);
  line-height: var(--line-height-tight, 1.3);
  letter-spacing: 2rpx;
}

/* Small body text */
.body-sm {
  font-size: var(--font-size-sm, 24rpx);
  font-weight: var(--font-weight-normal, 400);
  color: var(--color-lavender, #B8A9E0);
  line-height: var(--line-height-base, 1.6);
  letter-spacing: 1rpx;
}

/* Extra small body text — spread card descriptions */
.body-xs {
  font-size: var(--font-size-xs, 20rpx);
  font-weight: var(--font-weight-normal, 400);
  color: var(--color-text-tertiary, #A098C0);
  line-height: var(--line-height-base, 1.6);
  letter-spacing: 0.5rpx;
}

/* Accent-colored caption */
.accent-text {
  color: var(--color-gold, #F4D48C);
  font-weight: var(--font-weight-medium, 500);
  letter-spacing: 2rpx;
}

/* -----------------------------------------------------------
   6. SECTION TITLE (spread grid header)
   ----------------------------------------------------------- */

.section-title {
  font-size: var(--font-size-lg, 34rpx);
  font-weight: var(--font-weight-semibold, 600);
  color: var(--color-text-primary, #F0EDE8);
  display: block;
  margin-bottom: var(--spacing-md, 24rpx);
  letter-spacing: 2rpx;
  position: relative;
  padding-left: 24rpx;
}

.section-title {
  padding-left: 24rpx;
  border-left: 3rpx solid var(--color-gold, #F4D48C);
}

/* --- Spread grid cards --- */
.spread-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.body-xs {
  font-size: 22rpx;
  color: var(--color-text-tertiary, #9A95B8);
  display: block;
}

/* --- Spread grid cards: constellation map feel --- */
.section .card-press {
  background: linear-gradient(145deg, #25255A 0%, #2A2A5E 100%);
  border: 1.5rpx solid rgba(244, 212, 140, 0.12);
  border-radius: var(--radius-lg, 24rpx);
  padding: 32rpx 24rpx;
  position: relative;
  overflow: hidden;
  box-shadow: var(--shadow-card);
  transition: all var(--duration-fast) var(--ease-out);
}

.section .card-press:active {
  transform: scale(0.97);
  border-color: rgba(244, 212, 140, 0.20) !important;
  box-shadow: var(--shadow-card-press);
}

/* Spread card icon — fixed size, centered */
.spread-icon {
  width: 48rpx;
  height: 48rpx;
  display: block;
  margin: 0 auto 16rpx;
  opacity: 0.85;
}

/* Spread card text labels */
.section .card-press .body-sm {
  color: var(--color-text-primary, #F0EDE8);
  font-size: var(--font-size-sm, 24rpx);
  letter-spacing: 1rpx;
}

/* -----------------------------------------------------------
   7. ERROR STATE
   ----------------------------------------------------------- */

.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx var(--spacing-lg, 32rpx) 80rpx;
  text-align: center;
  animation: page-fade-up 0.8s var(--ease-soft, cubic-bezier(0.25, 0.46, 0.45, 0.94)) forwards;
}

.error-icon {
  font-size: 72rpx;
  color: var(--color-gold, #F4D48C);
  opacity: 0.50;
  margin-bottom: var(--spacing-lg, 32rpx);
  display: block;
  text-shadow: 0 0 30rpx rgba(244, 212, 140, 0.10);
}

.error-text {
  font-size: var(--font-size-xl, 40rpx);
  font-weight: var(--font-weight-semibold, 600);
  color: var(--color-text-primary, #F0EDE8);
  margin-bottom: var(--spacing-xs, 12rpx);
  display: block;
}

.error-hint {
  font-size: var(--font-size-sm, 24rpx);
  color: var(--color-text-tertiary, #A098C0);
  margin-bottom: var(--spacing-xl, 48rpx);
  display: block;
  line-height: var(--line-height-base, 1.6);
}

.btn-outline {
  background: transparent;
  color: var(--color-gold, #F4D48C);
  border: 1.5rpx solid rgba(244, 212, 140, 0.30);
  border-radius: var(--radius-pill, 999rpx);
  padding: 20rpx 48rpx;
  font-size: var(--font-size-base, 28rpx);
  font-weight: var(--font-weight-medium, 500);
  transition: all var(--duration-fast) var(--ease-out);
}

.btn-outline:active {
  background: rgba(244, 212, 140, 0.08);
  border-color: rgba(244, 212, 140, 0.50);
  transform: scale(0.97);
}

/* -----------------------------------------------------------
   8. SKELETON TWEAKS (page-level)
   ----------------------------------------------------------- */

.page > .skeleton-circle {
  border-radius: var(--radius-full, 100%);
}

.page > .skeleton-text-sm {
  height: 24rpx;
}

/* -----------------------------------------------------------
   9. DECORATIVE: Daily card icon (✦) special treatment
   ----------------------------------------------------------- */

.card-body > text:first-child {
  display: block;
  margin-bottom: 24rpx;
  font-size: 52rpx;
  color: var(--color-gold, #F4D48C);
  text-shadow: 0 0 30rpx rgba(244, 212, 140, 0.15);
}

/* ============================================================
   10. SPREAD GRID — Staggered entrance
   Each card rises with scale + opacity, 50ms apart
   ============================================================ */

@keyframes card-staggered {
  0% {
    opacity: 0;
    transform: translateY(24rpx) scale(0.92);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.section > view > .card-press {
  opacity: 0;
  animation: card-staggered 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
}

.section > view > .card-press:nth-child(1) { animation-delay: 0.70s; }
.section > view > .card-press:nth-child(2) { animation-delay: 0.75s; }
.section > view > .card-press:nth-child(3) { animation-delay: 0.80s; }
.section > view > .card-press:nth-child(4) { animation-delay: 0.85s; }

.more-spreads {
  opacity: 0;
  animation: card-staggered 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.90s forwards;
}

/* NOTE: spread-grid shimmer sweep and icon tap pulse removed — restraint */

/* ============================================================
   11. MORE SPREADS — "查看更多" entry card
   ============================================================ */

.more-spreads {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: var(--spacing-lg);
  padding: 28rpx 24rpx;
  background: linear-gradient(145deg, #25255A 0%, #2A2A5E 100%);
  border: 1.5rpx solid rgba(244, 212, 140, 0.12);
  border-radius: var(--radius-lg, 24rpx);
  box-shadow: var(--shadow-card);
  transition: all var(--duration-fast) var(--ease-out);
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}

.more-spreads:active {
  transform: scale(0.97);
  border-color: rgba(244, 212, 140, 0.20) !important;
  box-shadow: var(--shadow-card-press);
}

.more-text {
  font-size: var(--font-size-sm, 24rpx);
  font-weight: var(--font-weight-medium, 500);
  color: var(--color-gold, #F4D48C);
  letter-spacing: 1rpx;
}

.more-arrow {
  font-size: 28rpx;
  color: var(--color-gold, #F4D48C);
  opacity: 0.6;
  margin-left: 12rpx;
  transition: transform 0.3s var(--ease-soft, cubic-bezier(0.25, 0.46, 0.45, 0.94));
}

.more-spreads:active .more-arrow {
  transform: translateX(6rpx);
  opacity: 1;
}

/* ============================================================
   12. ONBOARDING — First-time guide overlay
   Dark indigo full screen with gold accents
   ============================================================ */

.onboarding-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  background: #1A1A3E;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  animation: page-fade-up 0.6s var(--ease-soft, cubic-bezier(0.25, 0.46, 0.45, 0.94)) forwards;
}

.onboarding-swiper {
  flex: 1;
  width: 100%;
}

.onboarding-slide {
  display: flex;
  align-items: center;
  justify-content: center;
}

.onboarding-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
  text-align: center;
  animation: onboarding-fade-in 0.4s ease-out forwards;
}

@keyframes onboarding-fade-in {
  0% {
    opacity: 0;
    transform: translateY(20rpx) scale(0.96);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.onboarding-emoji {
  font-size: 100rpx;
  display: block;
  margin-bottom: 48rpx;
  filter: drop-shadow(0 0 30rpx rgba(244, 212, 140, 0.20));
}

.onboarding-title {
  font-size: 52rpx;
  font-weight: var(--font-weight-bold, 700);
  color: var(--color-gold, #F4D48C);
  display: block;
  margin-bottom: 20rpx;
  letter-spacing: 6rpx;
  text-shadow: 0 0 40rpx rgba(244, 212, 140, 0.12);
}

.onboarding-desc {
  font-size: 30rpx;
  font-weight: var(--font-weight-normal, 400);
  color: var(--color-lavender, #B8A9E0);
  display: block;
  line-height: 1.8;
  letter-spacing: 2rpx;
  max-width: 520rpx;
}

/* --- Dots indicator --- */

.onboarding-dots {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 0 0 40rpx;
}

.onboarding-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: rgba(184, 169, 224, 0.25);
  transition: all var(--duration-fast) var(--ease-out);
  cursor: pointer;
}

.onboarding-dot.active {
  width: 48rpx;
  border-radius: 12rpx;
  background: var(--color-gold, #F4D48C);
  box-shadow: 0 0 20rpx rgba(244, 212, 140, 0.30);
}

/* --- Bottom buttons --- */

.onboarding-bottom {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 0 60rpx 80rpx;
  width: 100%;
  box-sizing: border-box;
}

.onboarding-next {
  background: rgba(244, 212, 140, 0.12);
  color: var(--color-gold, #F4D48C);
  font-size: 30rpx;
  font-weight: var(--font-weight-medium, 500);
  border: 1.5rpx solid rgba(244, 212, 140, 0.30);
  border-radius: 999rpx;
  padding: 24rpx 60rpx;
  text-align: center;
  transition: all var(--duration-fast) var(--ease-out);
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}

.onboarding-next:active {
  background: rgba(244, 212, 140, 0.20);
  border-color: rgba(244, 212, 140, 0.55);
  transform: scale(0.97);
}

.onboarding-skip {
  font-size: 26rpx;
  color: rgba(184, 169, 224, 0.45);
  padding: 24rpx 20rpx;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
  transition: all var(--duration-fast) var(--ease-out);
}

.onboarding-skip:active {
  color: rgba(184, 169, 224, 0.75);
}

.onboarding-start {
  background: linear-gradient(135deg, #F4D48C 0%, #E6C070 100%);
  color: #1A1A3E;
  font-size: 32rpx;
  font-weight: var(--font-weight-semibold, 600);
  border: none;
  border-radius: 999rpx;
  padding: 26rpx 80rpx;
  text-align: center;
  letter-spacing: 4rpx;
  box-shadow: 0 4rpx 30rpx rgba(244, 212, 140, 0.30);
  transition: all var(--duration-fast) var(--ease-out);
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
  animation: onboarding-start-pulse 2.5s ease-in-out infinite;
}

@keyframes onboarding-start-pulse {
  0%, 100% {
    box-shadow: 0 4rpx 30rpx rgba(244, 212, 140, 0.30);
  }
  50% {
    box-shadow: 0 4rpx 50rpx rgba(244, 212, 140, 0.55);
  }
}

.onboarding-start:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 20rpx rgba(244, 212, 140, 0.40);
}

/* ============================================================
   13. PARALLAX STARS — Three layers for atmospheric depth
   Using CSS box-shadow technique (WXSS-compatible)
   ============================================================ */

/* Base layer — full-screen fixed overlay */
.stars-layer {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
}

/* --- Layer 1 — Distant: 40+ tiny dots, very dim, slow drift --- */
.stars-distant::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 2rpx;
  height: 2rpx;
  background: transparent;
  border-radius: 50%;
  box-shadow:
    25rpx 40rpx rgba(255,255,255,0.18),
    68rpx 105rpx rgba(255,255,255,0.15),
    120rpx 30rpx rgba(255,255,255,0.20),
    175rpx 180rpx rgba(255,255,255,0.12),
    230rpx 60rpx rgba(255,255,255,0.16),
    290rpx 200rpx rgba(255,255,255,0.14),
    340rpx 85rpx rgba(255,255,255,0.18),
    400rpx 250rpx rgba(255,255,255,0.10),
    455rpx 120rpx rgba(255,255,255,0.16),
    510rpx 35rpx rgba(255,255,255,0.20),
    580rpx 170rpx rgba(255,255,255,0.12),
    630rpx 90rpx rgba(255,255,255,0.15),
    690rpx 210rpx rgba(255,255,255,0.18),
    50rpx 320rpx rgba(255,255,255,0.14),
    130rpx 400rpx rgba(255,255,255,0.12),
    200rpx 350rpx rgba(255,255,255,0.16),
    270rpx 480rpx rgba(255,255,255,0.10),
    350rpx 380rpx rgba(255,255,255,0.18),
    420rpx 520rpx rgba(255,255,255,0.14),
    495rpx 450rpx rgba(255,255,255,0.12),
    560rpx 300rpx rgba(255,255,255,0.16),
    640rpx 500rpx rgba(255,255,255,0.15),
    710rpx 420rpx rgba(255,255,255,0.10),
    30rpx 560rpx rgba(255,255,255,0.18),
    100rpx 630rpx rgba(255,255,255,0.12),
    180rpx 700rpx rgba(255,255,255,0.16),
    260rpx 580rpx rgba(255,255,255,0.14),
    340rpx 650rpx rgba(255,255,255,0.10),
    430rpx 720rpx rgba(255,255,255,0.18),
    510rpx 600rpx rgba(255,255,255,0.12),
    600rpx 680rpx rgba(255,255,255,0.15),
    680rpx 550rpx rgba(255,255,255,0.14),
    45rpx 800rpx rgba(255,255,255,0.10),
    140rpx 880rpx rgba(255,255,255,0.16),
    230rpx 780rpx rgba(255,255,255,0.12),
    320rpx 900rpx rgba(255,255,255,0.18),
    400rpx 840rpx rgba(255,255,255,0.14),
    480rpx 950rpx rgba(255,255,255,0.10),
    570rpx 860rpx rgba(255,255,255,0.16),
    660rpx 920rpx rgba(255,255,255,0.12),
    730rpx 780rpx rgba(255,255,255,0.15);
  animation: stars-drift-slow 30s ease-in-out infinite;
}

/* --- Layer 2 — Mid: 18 gold-tinted dots, medium drift --- */
.stars-mid::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 3rpx;
  height: 3rpx;
  background: transparent;
  border-radius: 50%;
  box-shadow:
    55rpx 130rpx rgba(244,212,140,0.15),
    160rpx 60rpx rgba(244,212,140,0.12),
    250rpx 230rpx rgba(244,212,140,0.18),
    380rpx 150rpx rgba(244,212,140,0.10),
    470rpx 280rpx rgba(244,212,140,0.15),
    590rpx 110rpx rgba(244,212,140,0.12),
    700rpx 240rpx rgba(244,212,140,0.18),
    85rpx 370rpx rgba(244,212,140,0.10),
    200rpx 450rpx rgba(244,212,140,0.15),
    330rpx 350rpx rgba(244,212,140,0.12),
    460rpx 500rpx rgba(244,212,140,0.18),
    560rpx 430rpx rgba(244,212,140,0.10),
    670rpx 560rpx rgba(244,212,140,0.15),
    110rpx 620rpx rgba(244,212,140,0.12),
    250rpx 720rpx rgba(244,212,140,0.18),
    390rpx 660rpx rgba(244,212,140,0.10),
    530rpx 790rpx rgba(244,212,140,0.15),
    650rpx 700rpx rgba(244,212,140,0.12);
  animation: stars-drift-mid 20s ease-in-out infinite;
}

/* --- Layer 3 — Close: 7 bright gold dots, fast drift with glow --- */
.stars-close::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 5rpx;
  height: 5rpx;
  background: transparent;
  border-radius: 50%;
  box-shadow:
    120rpx 160rpx #F4D48C,
    120rpx 160rpx 8rpx 2rpx rgba(244,212,140,0.12),
    310rpx 380rpx #E8C878,
    310rpx 380rpx 8rpx 2rpx rgba(232,200,120,0.10),
    520rpx 220rpx #F4D48C,
    520rpx 220rpx 8rpx 2rpx rgba(244,212,140,0.12),
    180rpx 530rpx #E8C878,
    180rpx 530rpx 8rpx 2rpx rgba(232,200,120,0.10),
    450rpx 600rpx #F4D48C,
    450rpx 600rpx 8rpx 2rpx rgba(244,212,140,0.12),
    680rpx 350rpx #E8C878,
    680rpx 350rpx 8rpx 2rpx rgba(232,200,120,0.10),
    300rpx 800rpx #F4D48C,
    300rpx 800rpx 8rpx 2rpx rgba(244,212,140,0.12);
  animation: stars-drift-close 12s ease-in-out infinite;
}

@keyframes stars-drift-slow {
  0%   { transform: translate(0, 0); }
  50%  { transform: translate(18rpx, -8rpx); }
  100% { transform: translate(0, 0); }
}

@keyframes stars-drift-mid {
  0%   { transform: translate(0, 0); }
  50%  { transform: translate(-24rpx, 12rpx); }
  100% { transform: translate(0, 0); }
}

@keyframes stars-drift-close {
  0%   { transform: translate(0, 0); }
  33%  { transform: translate(32rpx, -16rpx); }
  66%  { transform: translate(-14rpx, 20rpx); }
  100% { transform: translate(0, 0); }
}

/* ============================================================
   14. NEBULA GLOW — Ultra-subtle colored gradients
   ============================================================ */

.nebula {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 0;
}

.nebula-lavender {
  background: radial-gradient(
    ellipse 65% 50% at 80% 20%,
    rgba(184, 169, 224, 0.04) 0%,
    transparent 70%
  );
  animation: nebula-rotate 60s ease-in-out infinite;
}

.nebula-gold {
  background: radial-gradient(
    ellipse 55% 60% at 20% 80%,
    rgba(244, 212, 140, 0.03) 0%,
    transparent 65%
  );
  animation: nebula-rotate-reverse 60s ease-in-out infinite;
}

@keyframes nebula-rotate {
  0%   { transform: rotate(0deg) scale(1); }
  50%  { transform: rotate(4deg) scale(1.06); }
  100% { transform: rotate(0deg) scale(1); }
}

@keyframes nebula-rotate-reverse {
  0%   { transform: rotate(0deg) scale(1); }
  50%  { transform: rotate(-4deg) scale(1.06); }
  100% { transform: rotate(0deg) scale(1); }
}

/* ============================================================
   15. SHOOTING STAR — Rare easter egg (~every 30s)
   ============================================================ */

.shooting-star {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 1;
  overflow: hidden;
}

.shooting-star::after {
  content: '';
  position: absolute;
  width: 4rpx;
  height: 4rpx;
  top: 12%;
  left: 105%;
  background: #F4D48C;
  border-radius: 50%;
  box-shadow:
    0 0 8rpx 2rpx rgba(244,212,140,0.20),
    -20rpx 7rpx 2rpx -1rpx rgba(244,212,140,0.22),
    -40rpx 14rpx 3rpx -2rpx rgba(244,212,140,0.10),
    -60rpx 20rpx 4rpx -3rpx rgba(244,212,140,0.05);
  animation: shooting-star-fly 30s linear infinite;
  animation-delay: 8s;
}

@keyframes shooting-star-fly {
  0% {
    transform: translate(0, 0);
    opacity: 0;
  }
  1% {
    opacity: 1;
  }
  3.5% {
    transform: translate(-800rpx, 210rpx);
    opacity: 1;
  }
  4.5% {
    opacity: 0;
    transform: translate(-850rpx, 230rpx);
  }
  100% {
    opacity: 0;
    transform: translate(-850rpx, 230rpx);
  }
}

/* ============================================================
   16. HERO GLOW — Concentric rings emanating outward
   ============================================================ */

.hero-glow-rings {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 400rpx;
  height: 400rpx;
  transform: translate(-50%, -50%);
  pointer-events: none;
  z-index: 0;
}

.hero-glow-rings::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 70%;
  height: 70%;
  transform: translate(-50%, -50%);
  border: 1rpx solid rgba(244, 212, 140, 0.10);
  border-radius: 50%;
  animation: ring-expand 4s ease-out infinite;
}

.hero-glow-rings::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 70%;
  height: 70%;
  transform: translate(-50%, -50%);
  border: 1rpx solid rgba(244, 212, 140, 0.06);
  border-radius: 50%;
  animation: ring-expand 4s ease-out infinite 2s;
}

@keyframes ring-expand {
  0% {
    width: 50%;
    height: 50%;
    opacity: 0.7;
    border-color: rgba(244,212,140,0.12);
  }
  50% {
    width: 120%;
    height: 120%;
    opacity: 0.25;
    border-color: rgba(244,212,140,0.04);
  }
  100% {
    width: 180%;
    height: 180%;
    opacity: 0;
    border-color: rgba(244,212,140,0.01);
  }
}

/* ============================================================
   17. CARD GLOW — Breathing golden aura + warm breathe
   ============================================================ */

@keyframes card-warm-breathe {
  0%, 100% {
    box-shadow:
      0 4rpx 24rpx rgba(0,0,0,0.28),
      0 0 50rpx rgba(244,212,140,0.06);
  }
  50% {
    box-shadow:
      0 4rpx 24rpx rgba(0,0,0,0.28),
      0 0 80rpx rgba(244,212,140,0.15),
      0 0 150rpx rgba(244,212,140,0.08),
      0 0 200rpx rgba(244,212,140,0.03);
  }
}

@keyframes card-glow-breathe {
  0%, 100% {
    box-shadow:
      0 4rpx 24rpx rgba(0,0,0,0.28),
      0 0 40rpx rgba(244,212,140,0.06),
      0 0 80rpx rgba(244,212,140,0.03);
  }
  50% {
    box-shadow:
      0 4rpx 24rpx rgba(0,0,0,0.28),
      0 0 50rpx rgba(244,212,140,0.12),
      0 0 100rpx rgba(244,212,140,0.06),
      0 0 160rpx rgba(244,212,140,0.02);
  }
}

/* ============================================================
   18. SPARKLE PARTICLES — Floating near revealed card surface
   ============================================================ */

.sparkle-field {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 2;
  overflow: hidden;
  border-radius: inherit;
}

.sparkle {
  position: absolute;
  width: 4rpx;
  height: 4rpx;
  background: #F4D48C;
  border-radius: 50%;
  opacity: 0;
  box-shadow: 0 0 6rpx 2rpx rgba(244,212,140,0.20);
}

.s1 { top: 15%; left: 8%;  animation: sparkle-float 3.2s ease-in-out 0.3s infinite; }
.s2 { top: 22%; left: 88%; animation: sparkle-float 3.8s ease-in-out 0.9s infinite; }
.s3 { top: 70%; left: 10%; animation: sparkle-float 2.8s ease-in-out 0.1s infinite; }
.s4 { top: 65%; left: 85%; animation: sparkle-float 3.5s ease-in-out 1.6s infinite; }
.s5 { top: 40%; left: 48%; animation: sparkle-float 4.2s ease-in-out 2.2s infinite; }
.s6 { top: 82%; left: 42%; animation: sparkle-float 2.6s ease-in-out 0.7s infinite; }

@keyframes sparkle-float {
  0%, 100% {
    opacity: 0;
    transform: translateY(12rpx) scale(0.4);
  }
  25% {
    opacity: 0.9;
    transform: translateY(-6rpx) scale(1.1);
  }
  50% {
    opacity: 0.5;
    transform: translateY(-12rpx) scale(0.7);
  }
  75% {
    opacity: 0.7;
    transform: translateY(-2rpx) scale(0.9);
  }
}

/* ============================================================
   19. DAILY HABIT LOOP — Streak, Reflection, Reminder
   ============================================================ */

/* --- Reminder badges --- */
.daily-updated-badge {
  display: inline-block;
  margin-top: 16rpx;
  padding: 8rpx 20rpx;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-medium);
  color: var(--color-gold);
  background: rgba(244, 212, 140, 0.10);
  border: 1rpx solid rgba(244, 212, 140, 0.20);
  border-radius: var(--radius-pill);
  letter-spacing: 1rpx;
}

.daily-reminder-badge {
  display: inline-block;
  margin-top: 16rpx;
  padding: 8rpx 20rpx;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-medium);
  color: rgba(244, 212, 140, 0.55);
  background: rgba(244, 212, 140, 0.06);
  border: 1rpx solid rgba(244, 212, 140, 0.12);
  border-radius: var(--radius-pill);
  letter-spacing: 1rpx;
}

/* --- Card ready pulse (FOMO-inducing) --- */
.card-ready .card-warm {
  animation:
    card-warm-breathe 5s ease-in-out infinite,
    card-ready-pulse 2s ease-in-out infinite !important;
}

@keyframes card-ready-pulse {
  0%, 100% {
    border-color: rgba(244, 212, 140, 0.30);
    box-shadow:
      0 4rpx 24rpx rgba(0, 0, 0, 0.28),
      0 0 50rpx rgba(244, 212, 140, 0.06);
  }
  50% {
    border-color: rgba(244, 212, 140, 0.55);
    box-shadow:
      0 4rpx 24rpx rgba(0, 0, 0, 0.28),
      0 0 60rpx rgba(244, 212, 140, 0.18),
      0 0 120rpx rgba(244, 212, 140, 0.08);
  }
}

/* --- Streak badge (gold, inline) --- */
.streak-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 20rpx;
  padding: 10rpx 24rpx;
  background: rgba(244, 212, 140, 0.08);
  border: 1rpx solid rgba(244, 212, 140, 0.18);
  border-radius: var(--radius-pill);
  position: relative;
  z-index: 1;
}

.streak-icon {
  font-size: 24rpx;
  color: var(--color-gold);
  text-shadow: 0 0 12rpx rgba(244, 212, 140, 0.30);
}

.streak-count {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-medium);
  color: var(--color-gold);
  letter-spacing: 2rpx;
}

/* --- Reflection prompt --- */
.reflection-prompt {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  margin-top: 20rpx;
  padding: 16rpx;
  position: relative;
  z-index: 1;
}

.reflection-text {
  font-size: var(--font-size-caption);
  color: var(--color-lavender);
  line-height: var(--line-height-base);
  letter-spacing: 1rpx;
  opacity: 0.80;
}

.reflection-link {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-medium);
  color: var(--color-gold);
  letter-spacing: 1rpx;
  padding: 6rpx 16rpx;
  border-bottom: 1rpx dashed rgba(244, 212, 140, 0.25);
  transition: all var(--duration-fast) var(--ease-out);
}

.reflection-link:active {
  opacity: 0.70;
  border-bottom-color: rgba(244, 212, 140, 0.50);
}

/* -----------------------------------------------------------
   11. FREE TIER BANNER
   ----------------------------------------------------------- */
.free-banner {
  margin: 48rpx 0 32rpx;
  text-align: center;
}

.free-banner-content {
  display: inline-block;
  padding: 16rpx 36rpx;
  background: rgba(200, 184, 232, 0.08);
  border: 1rpx solid rgba(200, 184, 232, 0.15);
  border-radius: 999rpx;
  backdrop-filter: blur(4rpx);
}

.free-banner-text {
  font-size: 24rpx;
  color: var(--color-lavender, #C8B8E8);
  letter-spacing: 0.04em;
}

.free-banner-count {
  font-weight: 700;
  color: var(--color-gold, #F4D48C);
}

.free-banner-exhausted {
  border-color: rgba(244, 212, 140, 0.25);
  background: rgba(244, 212, 140, 0.10);
}

.free-banner-exhausted .free-banner-text {
  color: var(--color-gold, #F4D48C);
  font-weight: 500;
}
