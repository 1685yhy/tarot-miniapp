/* ——— 第 3 层：中暗星（opacity 0.04-0.40，2-3rpx） ——— */
.star-particle:nth-child(11) {
  top: 7%; left: 58%; width: 3rpx; height: 3rpx;
  background: #C8A84E;
  animation: twinkle-mid 4.5s ease-in-out 0.1s infinite, drift-slow 9s ease-in-out infinite;
