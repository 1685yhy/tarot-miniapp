/* ============================================================
   "Le Jardin Mystique" — 神秘花园 设计系统 v2.0
   Art Nouveau ×  botanical atelier aesthetic
   ============================================================
   色彩基调：暖橄榄 × 铜色 × 暖象牙纸
   设计理念：手工感、水彩晕染、植物学优雅
   ============================================================ */

/* ===== 0. 设计标记变量 ===== */
:root {
  --olive-warm: #7A8B5A;
  --olive-leaf: #8B9A6D;
  --olive-soft: #A8B87E;
  --olive-pale: #C5D0A8;
  --copper-bright: #C5835A;
  --copper-soft: #D4A07A;
  --copper-pale: #E0BC9A;
  --ivory-bg: #F5F0E8;
  --ivory-light: #FBF7F0;
  --ivory-card: #F8F2E8;
  --ivory-deep: #EDE5D8;
  --parchment: #F0E8D8;
  --earth-deep: #3D3834;
  --earth-soft: #5A524A;
  --earth-muted: #7A7268;
  --botanical-gold: #C5A87A;
  --copper-shadow: rgba(197, 131, 90, 0.15);
  --copper-glow: rgba(197, 131, 90, 0.10);
  --olive-shadow: rgba(122, 139, 90, 0.12);
  --shadow-warm: 0 8rpx 32rpx rgba(61, 56, 52, 0.07);
  --shadow-copper: 0 12rpx 48rpx rgba(197, 131, 90, 0.12), 0 4rpx 16rpx rgba(61, 56, 52, 0.06);
  --shadow-card-warm: 0 8rpx 32rpx rgba(61, 56, 52, 0.06), 0 0 20rpx rgba(197, 131, 90, 0.06);
}

/* ===== 1. 动画系统 ===== */

/* ——— 温暖呼吸（卡牌阴影脉动） ——— */
@keyframes shadow-breathe {
  0%, 100% {
    box-shadow:
      0 8rpx 32rpx rgba(61, 56, 52, 0.06),
      0 0 20rpx rgba(197, 131, 90, 0.04),
      inset 0 0 30rpx rgba(197, 131, 90, 0.02);
  }
  50% {
    box-shadow:
      0 12rpx 48rpx rgba(61, 56, 52, 0.09),
      0 0 40rpx rgba(197, 131, 90, 0.10),
      0 0 80rpx rgba(197, 131, 90, 0.04),
      inset 0 0 40rpx rgba(197, 131, 90, 0.03);
  }
}

/* ——— 纸张展开（温柔揭示卡牌） ——— */
@keyframes unfurl {
  0% {
    transform: scaleX(0.3) scaleY(0.6);
    opacity: 0;
  }
  30% {
    opacity: 0.4;
    transform: scaleX(0.6) scaleY(0.85);
  }
  50% {
    opacity: 0.7;
    transform: scaleX(1.02) scaleY(1.01);
  }
  70% {
    opacity: 0.9;
    transform: scaleX(0.99) scaleY(0.99);
  }
  100% {
    transform: scaleX(1) scaleY(1);
    opacity: 1;
  }
}

/* ——— 花粉/光点漂浮 ——— */
@keyframes mote-float {
  0%, 100% {
    transform: translate(0, 0) scale(1) rotate(0deg);
    opacity: 0;
  }
  10% {
    opacity: 0.5;
  }
  30% {
    transform: translate(12rpx, -18rpx) scale(1.3) rotate(12deg);
    opacity: 0.8;
  }
  50% {
    transform: translate(-8rpx, -35rpx) scale(0.7) rotate(-8deg);
    opacity: 0.4;
  }
  70% {
    transform: translate(6rpx, -50rpx) scale(1.1) rotate(5deg);
    opacity: 0.6;
  }
  90% {
    opacity: 0.2;
  }
  100% {
    transform: translate(-3rpx, -65rpx) scale(0.4) rotate(-3deg);
    opacity: 0;
  }
}

/* ——— 花蜜辉光脉冲 ——— */
@keyframes mote-glow {
  0%, 100% {
    box-shadow: 0 0 4rpx rgba(200, 180, 140, 0.15);
    background: rgba(200, 190, 150, 0.5);
  }
  50% {
    box-shadow: 0 0 12rpx rgba(200, 180, 140, 0.5), 0 0 24rpx rgba(200, 180, 140, 0.15);
    background: rgba(230, 210, 170, 0.8);
  }
}

/* ——— 标题优雅浮现 ——— */
@keyframes heading-appear {
  0% {
    opacity: 0;
    transform: translateY(10rpx);
    letter-spacing: 24rpx;
  }
  100% {
    opacity: 1;
    transform: translateY(0);
    letter-spacing: 14rpx;
  }
}

/* ——— 副标题淡入 ——— */
@keyframes copper-appear {
  0% { opacity: 0; transform: translateY(8rpx); letter-spacing: 6rpx; }
  100% { opacity: 0.9; transform: translateY(0); letter-spacing: 8rpx; }
}

/* ——— 饰线柔和脉动 ——— */
@keyframes line-pulse {
  0%, 100% { opacity: 0.25; }
  50% { opacity: 0.7; }
}

/* ——— 水彩背景缓动 ——— */
@keyframes watercolor-shift {
  0%, 100% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
}

/* ——— 抽取中：铜色呼吸 ——— */
@keyframes copper-breath {
  0%, 100% {
    box-shadow:
      0 0 24rpx rgba(197, 131, 90, 0.08),
      0 0 48rpx rgba(122, 139, 90, 0.04);
    border-color: rgba(197, 131, 90, 0.20);
  }
  50% {
    box-shadow:
      0 0 50rpx rgba(197, 131, 90, 0.20),
      0 0 100rpx rgba(197, 131, 90, 0.08),
      0 0 150rpx rgba(122, 139, 90, 0.03);
    border-color: rgba(197, 131, 90, 0.40);
  }
}

/* ——— 抽取中：藤蔓光环旋转 ——— */
@keyframes vine-aura {
  0% { transform: translate(-50%, -50%) rotate(0deg); opacity: 0.15; }
  50% { opacity: 0.5; }
  100% { transform: translate(-50%, -50%) rotate(360deg); opacity: 0.15; }
}

/* ——— 抽取中：花粉升腾 ——— */
@keyframes pollen-rise {
  0% { transform: translateY(0) scale(1) rotate(0deg); opacity: 0; }
  15% { opacity: 0.4; }
  50% { opacity: 0.6; transform: translateY(-50rpx) scale(0.6) rotate(30deg); }
  100% { transform: translateY(-100rpx) scale(0) rotate(60deg); opacity: 0; }
}

/* ——— 抽取中：光纹扫过 ——— */
@keyframes copper-sweep {
  0% { background-position: 200% 0; }
  100% { background-position: -100% 0; }
}

/* ——— 植物卷须轻微摆动 ——— */
@keyframes tendril-sway {
  0%, 100% { transform: rotate(0deg) scale(1); }
  50% { transform: rotate(3deg) scale(1.02); }
}


/* ===== 2. 花粉粒子背景 ===== */

.mote-particle {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  width: 5rpx;
  height: 5rpx;
  background: rgba(210, 195, 160, 0.5);
  animation: mote-float 9s ease-in-out infinite, mote-glow 3.5s ease-in-out infinite;
}

.mote-particle:nth-child(1) { top: 3%; left: 10%; animation-delay: 0s, 0.3s; width: 5rpx; height: 5rpx; }
.mote-particle:nth-child(2) { top: 8%; left: 80%; width: 4rpx; height: 4rpx; animation-delay: 1.5s, 2.0s; }
.mote-particle:nth-child(3) { top: 16%; left: 35%; width: 6rpx; height: 6rpx; animation-delay: 2.8s, 0.1s; }
.mote-particle:nth-child(4) { top: 25%; left: 65%; width: 4rpx; height: 4rpx; animation-delay: 4.0s, 2.5s; }
.mote-particle:nth-child(5) { top: 6%; left: 55%; width: 5rpx; height: 5rpx; animation-delay: 0.6s, 1.2s; }
.mote-particle:nth-child(6) { top: 14%; left: 88%; width: 4rpx; height: 4rpx; animation-delay: 4.5s, 0.8s; }
.mote-particle:nth-child(7) { top: 30%; left: 20%; width: 3rpx; height: 3rpx; animation-delay: 2.2s, 3.2s; }
.mote-particle:nth-child(8) { top: 38%; left: 72%; width: 5rpx; height: 5rpx; animation-delay: 5.8s, 1.6s; }
.mote-particle:nth-child(9) { top: 2%; left: 92%; width: 4rpx; height: 4rpx; animation-delay: 1.8s, 3.0s; }
.mote-particle:nth-child(10) { top: 20%; left: 5%; width: 3rpx; height: 3rpx; animation-delay: 3.2s, 1.0s; }
.mote-particle:nth-child(11) { top: 34%; left: 45%; width: 5rpx; height: 5rpx; animation-delay: 6.5s, 2.8s; }
.mote-particle:nth-child(12) { top: 10%; left: 22%; width: 6rpx; height: 6rpx; animation-delay: 5.0s, 1.4s; }


/* ===== 3. 英雄区 — 植物学水彩 ===== */

.hero {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 110rpx 0 80rpx;
  overflow: hidden;
}

/* ——— 不对称植物学辉光（非正圆） ——— */
.hero-glow-organic {
  position: absolute;
  top: 45%;
  left: 50%;
  width: 520rpx;
  height: 440rpx;
  transform: translate(-50%, -52%);
  border-radius: 45% 55% 50% 50% / 40% 50% 50% 60%;
  background: radial-gradient(
    ellipse at 40% 45%,
    rgba(197, 131, 90, 0.12) 0%,
    rgba(165, 180, 130, 0.08) 20%,
    rgba(200, 190, 160, 0.05) 35%,
    rgba(245, 240, 232, 0.02) 50%,
    transparent 70%
  );
  pointer-events: none;
  z-index: 0;
  animation: watercolor-shift 10s ease-in-out infinite;
  background-size: 180% 180%;
}

/* ——— 内层暖铜光晕（更小的不对称） ——— */
.hero-glow-organic::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 45%;
  width: 260rpx;
  height: 200rpx;
  transform: translate(-50%, -50%);
  border-radius: 50% 40% 55% 45% / 45% 55% 45% 55%;
  background: radial-gradient(
    ellipse at 50% 50%,
    rgba(197, 131, 90, 0.18) 0%,
    rgba(165, 180, 130, 0.07) 30%,
    transparent 65%
  );
  pointer-events: none;
}

/* ——— 水彩斑点装饰 ——— */
.hero-glow-organic::after {
  content: '';
  position: absolute;
  bottom: 10%;
  right: 8%;
  width: 120rpx;
  height: 90rpx;
  border-radius: 60% 40% 55% 45% / 50% 60% 40% 50%;
  background: radial-gradient(
    ellipse at 50% 50%,
    rgba(200, 190, 160, 0.06) 0%,
    transparent 60%
  );
  pointer-events: none;
}

/* ——— 中央植物学装饰（代替图标，更像水彩花卉） ——— */
.hero-emblem {
  position: relative;
  z-index: 1;
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: radial-gradient(
    ellipse at 45% 55%,
    rgba(197, 131, 90, 0.15) 0%,
    rgba(165, 180, 130, 0.06) 35%,
    rgba(200, 190, 160, 0.03) 55%,
    transparent 80%
  );
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 36rpx;
  animation: tendril-sway 6s ease-in-out infinite;
  box-shadow:
    0 0 60rpx rgba(197, 131, 90, 0.08),
    0 0 120rpx rgba(165, 180, 130, 0.04);
}

.hero-emblem-inner {
  font-size: 60rpx;
  display: block;
  opacity: 0.7;
  animation: mote-glow 5s ease-in-out infinite;
}

/* ——— 主标题（暖橄榄色） ——— */
.hero-title {
  position: relative;
  z-index: 1;
  font-size: 54rpx;
  font-weight: 600;
  color: #7A8B5A;
  letter-spacing: 14rpx;
  line-height: 1.3;
  margin-bottom: 16rpx;
  animation: heading-appear 1.3s ease-out forwards;
  font-family: "Songti SC", "STSongti", "Noto Serif CJK SC", "Source Han Serif SC", serif;
  text-shadow: 0 1rpx 2rpx rgba(122, 139, 90, 0.08);
}

/* ——— 副标题（铜色） ——— */
.hero-subtitle {
  position: relative;
  z-index: 1;
  font-size: 26rpx;
  color: #C5835A;
  letter-spacing: 8rpx;
  animation: copper-appear 1s ease-out 0.5s both;
  font-weight: 400;
  opacity: 0.9;
  font-family: "Songti SC", "STSongti", "Noto Serif CJK SC", "Source Han Serif SC", serif;
}


/* ===== 4. 每日一牌 — 植物学纸牌 ===== */

.daily-card-wrapper {
  margin: 48rpx 32rpx 80rpx;
  position: relative;
}

/* ——— 抽取前：暖象牙纸牌 ——— */
.card-daily-back {
  position: relative;
  overflow: hidden;
  background: linear-gradient(
    155deg,
    #FBF7F0 0%,
    #F8F2E8 35%,
    #F5EDE0 100%
  );
  border: 2rpx solid rgba(197, 131, 90, 0.18);
  border-radius: 28rpx;
  padding: 60rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 240rpx;
  animation: shadow-breathe 4s ease-in-out infinite;
  transition: all 0.3s ease-out;

  box-shadow:
    0 8rpx 32rpx rgba(61, 56, 52, 0.06),
    0 0 20rpx rgba(197, 131, 90, 0.04),
    inset 0 0 40rpx rgba(197, 131, 90, 0.01);
}

/* ——— 左上角植物卷须（Art Nouveau 风格） ——— */
.card-daily-back::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 80rpx;
  height: 80rpx;
  border-top: 3rpx solid rgba(197, 131, 90, 0.15);
  border-left: 3rpx solid rgba(197, 131, 90, 0.15);
  border-radius: 28rpx 0 0 0;
  pointer-events: none;
  /* 卷须曲线：非直角，而是优雅弧度 */
  background: radial-gradient(
    circle at 0 0,
    transparent 70%,
    rgba(197, 131, 90, 0.05) 80%,
    transparent 90%
  );
}

.card-daily-back::before {
  content: '';
  position: absolute;
  top: -1rpx;
  left: -1rpx;
  width: 64rpx;
  height: 64rpx;
  border-top: 3rpx solid rgba(197, 131, 90, 0.18);
  border-left: 3rpx solid rgba(197, 131, 90, 0.18);
  border-radius: 0 0 40% 0;
  pointer-events: none;
}

/* ——— 右下角植物卷须 ——— */
.card-daily-back::after {
  content: '';
  position: absolute;
  bottom: -1rpx;
  right: -1rpx;
  width: 64rpx;
  height: 64rpx;
  border-bottom: 3rpx solid rgba(197, 131, 90, 0.18);
  border-right: 3rpx solid rgba(197, 131, 90, 0.18);
  border-radius: 40% 0 0 0;
  pointer-events: none;
}

.card-daily-back:active {
  transform: scale(0.97);
  border-color: rgba(197, 131, 90, 0.30);
  box-shadow:
    0 6rpx 24rpx rgba(61, 56, 52, 0.10),
    0 2rpx 8rpx rgba(61, 56, 52, 0.06),
    0 0 50rpx rgba(197, 131, 90, 0.16),
    inset 0 0 40rpx rgba(197, 131, 90, 0.03);
}

.card-daily-back .heading-3 {
  position: relative;
  z-index: 1;
  color: #7A8B5A;
  font-weight: 500;
  letter-spacing: 4rpx;
  margin-bottom: 8rpx;
  font-size: 30rpx;
}

.card-daily-free {
  position: relative;
  z-index: 1;
  color: #C5835A;
  font-size: 22rpx;
  letter-spacing: 6rpx;
  font-weight: 400;
}

/* ——— 抽取后：温柔纸张展开 ——— */
.card-daily-result {
  position: relative;
  overflow: hidden;
  background: linear-gradient(
    155deg,
    #FBF7F0 0%,
    #F8F2E8 45%,
    #F5EDE0 100%
  );
  border: 2rpx solid rgba(197, 131, 90, 0.20);
  border-radius: 28rpx;
  padding: 60rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 240rpx;
  animation: unfurl 0.9s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;

  box-shadow:
    0 12rpx 48rpx rgba(61, 56, 52, 0.08),
    0 4rpx 16rpx rgba(61, 56, 52, 0.05),
    0 0 40rpx rgba(197, 131, 90, 0.10),
    0 0 80rpx rgba(165, 180, 130, 0.03);
}

/* 左上卷须 */
.card-daily-result::before {
  content: '';
  position: absolute;
  top: -1rpx;
  left: -1rpx;
  width: 68rpx;
  height: 68rpx;
  border-top: 3rpx solid rgba(197, 131, 90, 0.20);
  border-left: 3rpx solid rgba(197, 131, 90, 0.20);
  border-radius: 0 0 40% 0;
  pointer-events: none;
}

/* 右下卷须 */
.card-daily-result::after {
  content: '';
  position: absolute;
  bottom: -1rpx;
  right: -1rpx;
  width: 68rpx;
  height: 68rpx;
  border-bottom: 3rpx solid rgba(197, 131, 90, 0.20);
  border-right: 3rpx solid rgba(197, 131, 90, 0.20);
  border-radius: 40% 0 0 0;
  pointer-events: none;
}

.card-daily-result .heading-2 {
  position: relative;
  z-index: 1;
  font-size: 34rpx;
  font-weight: 600;
  color: #3D3834;
  letter-spacing: 4rpx;
  margin-bottom: 10rpx;
}

.card-daily-result .text-secondary {
  position: relative;
  z-index: 1;
  letter-spacing: 2rpx;
  color: #5A524A;
  font-size: 26rpx;
  text-align: center;
}


/* ===== 5. 抽取中状态 — 植物学仪式 ===== */

.card-daily-back.drawing {
  animation: none;
  border-color: rgba(197, 131, 90, 0.22);
  animation: copper-breath 2.2s ease-in-out infinite;
}

/* 藤蔓光环（外层） */
.card-daily-back.drawing::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 340rpx;
  height: 340rpx;
  margin: 0;
  border: 2rpx solid rgba(197, 131, 90, 0.08);
  border-radius: 40% 60% 45% 55% / 55% 45% 55% 45%;
  animation: vine-aura 4s linear infinite;
  pointer-events: none;
  z-index: 2;
  color: transparent;
  font-size: 0;
}

/* 藤蔓光环（内层，反转） */
.card-daily-back.drawing::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 270rpx;
  height: 270rpx;
  margin: 0;
  border: 1.5rpx solid rgba(165, 180, 130, 0.06);
  border-radius: 55% 45% 50% 50% / 45% 55% 45% 55%;
  animation: vine-aura 3s linear infinite reverse;
  pointer-events: none;
  z-index: 2;
  color: transparent;
  font-size: 0;
}

/* 花粉粒子升腾 */
.card-daily-back.drawing .ritual-particle {
  display: block;
  position: absolute;
  width: 4rpx;
  height: 4rpx;
  background: #C5835A;
  border-radius: 50%;
  box-shadow: 0 0 6rpx rgba(197, 131, 90, 0.25);
  pointer-events: none;
  z-index: 3;
  opacity: 0;
}

.card-daily-back.drawing .ritual-particle:nth-child(1) {
  bottom: 10%; left: 20%;
  animation: pollen-rise 2.4s ease-out 0s infinite;
}
.card-daily-back.drawing .ritual-particle:nth-child(2) {
  bottom: 15%; left: 40%;
  width: 3rpx; height: 3rpx;
  background: #D4A07A;
  animation: pollen-rise 2.7s ease-out 0.5s infinite;
}
.card-daily-back.drawing .ritual-particle:nth-child(3) {
  bottom: 8%; left: 60%;
  width: 5rpx; height: 5rpx;
  background: #C5A87A;
  animation: pollen-rise 2.2s ease-out 1.0s infinite;
}
.card-daily-back.drawing .ritual-particle:nth-child(4) {
  bottom: 12%; left: 75%;
  width: 3rpx; height: 3rpx;
  background: #D4A07A;
  animation: pollen-rise 3.0s ease-out 1.5s infinite;
}
.card-daily-back.drawing .ritual-particle:nth-child(5) {
  bottom: 6%; left: 30%;
  width: 2rpx; height: 2rpx;
  background: rgba(165, 180, 130, 0.7);
  animation: pollen-rise 3.2s ease-out 2.0s infinite;
}
.card-daily-back.drawing .ritual-particle:nth-child(6) {
  bottom: 18%; left: 55%;
  width: 4rpx; height: 4rpx;
  background: #C5A87A;
  animation: pollen-rise 2.6s ease-out 2.5s infinite;
}

/* 抽取中标题文字扫光（铜→橄榄渐变） */
.card-daily-back.drawing .heading-3 {
  animation: copper-sweep 2.5s ease-in-out infinite;
  background: linear-gradient(
    90deg,
    #7A8B5A 0%,
    #C5835A 25%,
    #C5A87A 50%,
    #C5835A 75%,
    #7A8B5A 100%
  );
  background-size: 200% 100%;
  background-clip: text;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}


/* ===== 6. 牌阵入口 — 植物学卡片 ===== */

.spread-section {
  margin: 0 32rpx 80rpx;
}

.section-title {
  position: relative;
  color: #7A8B5A;
  letter-spacing: 4rpx;
  font-weight: 500;
  margin-bottom: 40rpx;
  padding-left: 24rpx;
  font-size: 28rpx;
}

/* 标题左侧铜色饰线 */
.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 4rpx;
  height: 55%;
  background: linear-gradient(180deg, #C5835A, #D4A07A);
  border-radius: 4rpx;
  animation: line-pulse 3s ease-in-out infinite;
}

.spread-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
}

/* ——— 植物学卡片 ——— */
.spread-grid .card {
  position: relative;
  background: #FBF7F0;
  border: 1rpx solid rgba(197, 131, 90, 0.08);
  border-radius: 24rpx;
  padding: 32rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  text-align: center;
  transition: all 0.3s ease-out;
  overflow: hidden;

  box-shadow:
    0 6rpx 24rpx rgba(61, 56, 52, 0.05),
    0 2rpx 8rpx rgba(61, 56, 52, 0.03);

  /* 左侧铜色植物饰条 */
  border-left: 3rpx solid rgba(197, 131, 90, 0.20);
}

/* ——— 右上角植物角装饰 ——— */
.spread-grid .card::before {
  content: '';
  position: absolute;
  top: -1rpx;
  right: -1rpx;
  width: 36rpx;
  height: 36rpx;
  border-top: 2rpx solid rgba(197, 131, 90, 0.10);
  border-right: 2rpx solid rgba(197, 131, 90, 0.10);
  border-radius: 0 0 0 30%;
  pointer-events: none;
}

/* ——— 左下角植物角装饰 ——— */
.spread-grid .card::after {
  content: '';
  position: absolute;
  bottom: -1rpx;
  left: -1rpx;
  width: 36rpx;
  height: 36rpx;
  border-bottom: 2rpx solid rgba(197, 131, 90, 0.10);
  border-left: 2rpx solid rgba(197, 131, 90, 0.10);
  border-radius: 0 30% 0 0;
  pointer-events: none;
}

/* 图标容器 */
.spread-grid .card > text:first-child {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  font-size: 52rpx;
  background: radial-gradient(
    ellipse at 45% 55%,
    rgba(197, 131, 90, 0.06) 0%,
    rgba(165, 180, 130, 0.03) 50%,
    transparent 70%
  );
  border-radius: 50%;
  margin-bottom: 8rpx;
  transition: all 0.3s ease-out;
  line-height: 1;
}

/* 温柔按下效果 */
.spread-grid .card:active {
  transform: scale(0.96);
  border-color: rgba(197, 131, 90, 0.22);
  box-shadow:
    0 12rpx 40rpx rgba(61, 56, 52, 0.08),
    0 4rpx 16rpx rgba(61, 56, 52, 0.05),
    0 0 30rpx rgba(197, 131, 90, 0.10);
  border-left-color: rgba(197, 131, 90, 0.40);
}

.spread-grid .card:active > text:first-child {
  background: radial-gradient(
    ellipse at 45% 55%,
    rgba(197, 131, 90, 0.14) 0%,
    rgba(165, 180, 130, 0.06) 50%,
    transparent 70%
  );
  transform: scale(1.06);
}

/* 牌阵名称 */
.spread-grid .card .text-body {
  font-size: 24rpx;
  color: #3D3834;
  font-weight: 500;
  letter-spacing: 2rpx;
  position: relative;
  z-index: 1;
}

/* 描述文本 */
.spread-grid .card .text-dim {
  font-size: 20rpx;
  color: #7A7268;
  letter-spacing: 1rpx;
  position: relative;
  z-index: 1;
}


/* ===== 7. Premium 指示器：铜色菱形 ===== */

.badge-copper-diamond {
  position: relative;
  z-index: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  font-size: 18rpx;
  padding: 4rpx 12rpx;
  color: #C5835A;
  letter-spacing: 1rpx;
  margin-top: 4rpx;
  font-weight: 400;
}

/* 铜色菱形 */
.badge-copper-diamond::before {
  content: '◆';
  font-size: 14rpx;
  color: #C5835A;
  opacity: 0.5;
  margin-right: 4rpx;
}


/* ===== 8. 环境氛围增强 ===== */

/* 顶部暖铜辉光 */
.atelier-glow-top {
  position: absolute;
  top: -180rpx;
  left: 50%;
  transform: translateX(-50%);
  background: radial-gradient(
    ellipse at 50% 50%,
    rgba(197, 131, 90, 0.06) 0%,
    rgba(165, 180, 130, 0.04) 20%,
    rgba(245, 240, 232, 0.01) 45%,
    transparent 70%
  );
  width: 700rpx;
  height: 650rpx;
  pointer-events: none;
  z-index: 0;
}

/* 底部橄榄光晕 */
.atelier-glow-bottom {
  position: absolute;
  bottom: -180rpx;
  left: 50%;
  transform: translateX(-50%);
  background: radial-gradient(
    ellipse at 50% 50%,
    rgba(165, 180, 130, 0.06) 0%,
    rgba(197, 131, 90, 0.03) 30%,
    transparent 65%
  );
  width: 650rpx;
  height: 600rpx;
  pointer-events: none;
  z-index: 0;
}


/* ===== 9. 加载 / 错误 / 空状态 ===== */

.skeleton {
  padding: 80rpx 0;
}

.skeleton-circle {
  background: linear-gradient(135deg, #F5EDE0, #FBF7F0);
  border: 1rpx solid rgba(197, 131, 90, 0.06);
}

.skeleton-line {
  background: linear-gradient(90deg,
    rgba(197, 131, 90, 0.08),
    rgba(165, 180, 130, 0.05),
    rgba(197, 131, 90, 0.08));
  background-size: 200% 100%;
  animation: copper-sweep 2s ease-in-out infinite;
}

.skeleton-block {
  background: linear-gradient(135deg,
    rgba(197, 131, 90, 0.06),
    rgba(165, 180, 130, 0.04));
  border: 1rpx solid rgba(197, 131, 90, 0.05);
}

.skeleton-grid-item {
  background: linear-gradient(135deg,
    rgba(197, 131, 90, 0.06),
    rgba(165, 180, 130, 0.04));
  border: 1rpx solid rgba(197, 131, 90, 0.05);
  border-radius: 24rpx;
}

.error-state {
  text-align: center;
  padding: 80rpx 48rpx;
}

.error-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.error-text {
  font-size: 28rpx;
  color: #5A524A;
  display: block;
  margin-bottom: 8rpx;
}

.error-hint {
  font-size: 24rpx;
  color: #7A7268;
  display: block;
  margin-bottom: 48rpx;
}


/* ===== 10. 底部安全区域混入羊皮纸背景 ===== */

.page {
  padding-bottom: 40rpx;
  position: relative;
  min-height: 100vh;
  background: #F5F0E8;
}
