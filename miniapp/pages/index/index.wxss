  box-shadow: 0 0 14rpx rgba(240, 216, 120, 0.4);
  animation: twinkle-gold 2s ease-in-out 0s infinite, drift-close 3.5s ease-in-out infinite;
}


/* ===== 3. 英雄区 — 暮光之轮 ===== */

.hero {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: calc(var(--space-massive) + 20rpx) 0 var(--space-xxxl);
  overflow: hidden;
}

/* ——— 第 1 环：最外圈 — 暖金粗线，慢速正转 ——— */
.hero::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 480rpx;
  height: 480rpx;
  transform: translate(-50%, -50%);
  border: 2.5rpx solid rgba(200, 168, 78, 0.15);
  border-radius: 50%;
  animation: ring-cw 28s linear infinite;
  pointer-events: none;
  z-index: 0;
  box-shadow:
    0 0 40rpx rgba(200, 168, 78, 0.04),
    inset 0 0 40rpx rgba(200, 168, 78, 0.02);
}

/* ——— 第 2 环：紫金虚线，中速反转 ——— */
.hero::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 410rpx;
  height: 410rpx;
  transform: translate(-50%, -50%);
  border: 2rpx dashed rgba(123, 107, 176, 0.12);
  border-radius: 50%;
  animation: ring-ccw 20s linear infinite;
  pointer-events: none;
  z-index: 0;
  box-shadow:
    0 0 30rpx rgba(123, 107, 176, 0.04),
    inset 0 0 30rpx rgba(123, 107, 176, 0.02);
}

/* ——— 神秘圆盘容器 ——— */
.mystic-circle {
  position: relative;
  z-index: 1;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: radial-gradient(
    circle at 50% 50%,
    rgba(123, 107, 176, 0.35) 0%,
    rgba(200, 168, 78, 0.10) 40%,
    rgba(200, 168, 78, 0.03) 60%,
    transparent 80%
  );
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--space-xl);
  box-shadow:
    0 0 60rpx rgba(200, 168, 78, 0.06),
    0 0 120rpx rgba(123, 107, 176, 0.04);
}

/* ——— 第 3 环：暖金点线，快转 ——— */
.mystic-circle::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 300rpx;
  height: 300rpx;
  transform: translate(-50%, -50%);
  border: 2rpx dotted rgba(200, 168, 78, 0.14);
  border-radius: 50%;
  animation: ring-cw 14s linear infinite;
  pointer-events: none;
  box-shadow:
    0 0 20rpx rgba(200, 168, 78, 0.04);
}

/* ——— 第 4 环：紫罗兰辉光环，快速反转 ——— */
.mystic-circle::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 240rpx;
  height: 240rpx;
  transform: translate(-50%, -50%);
  border: 1.5rpx solid rgba(123, 107, 176, 0.12);
  border-radius: 50%;
  animation: ring-ccw 10s linear infinite;
  pointer-events: none;
  box-shadow:
    0 0 24rpx rgba(123, 107, 176, 0.05),
    inset 0 0 24rpx rgba(123, 107, 176, 0.03);
}

/* ——— 第 5 环（隐藏）：更暖的金色内环，位于圆盘和 ring4 之间 ——— */
.hero .mystic-circle {
  /* 用伪元素模拟第5环 — 实际上在 circle 内部加一个额外的环层 */
}
/* 额外通过兄弟伪元素无法实现，用 .hero 新增一个第5环感觉 */
/* 我们利用 hero 区域底部留出一个更强的光环: 用位置伪元素实现 */


/* ===== 4. 英雄区标题 — 暮光铭文 ===== */

.hero-title {
  position: relative;
  z-index: 1;
  font-size: 56rpx;
  font-weight: 700;
  background: linear-gradient(
    135deg,
    #C8A84E 0%,
    #E8A844 18%,
    #F0D878 35%,
    #F5F0E8 50%,
    #F0D878 65%,
    #C8A84E 82%,
    #C8A84E 100%
  );
  background-size: 250% auto;
  background-clip: text;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  animation: shimmer 4s ease-in-out infinite;
  letter-spacing: 12rpx;
  line-height: 1.2;
  margin-bottom: var(--space-sm);
  filter: drop-shadow(0 0 30rpx rgba(200, 168, 78, 0.30))
          drop-shadow(0 0 60rpx rgba(200, 168, 78, 0.10))
          drop-shadow(0 0 90rpx rgba(200, 168, 78, 0.04));
  text-shadow: none;
}

.hero-subtitle {
  position: relative;
  z-index: 1;
  font-size: var(--fs-body);
  color: var(--color-text-secondary);
  letter-spacing: 6rpx;
  filter: drop-shadow(0 0 16rpx rgba(123, 107, 176, 0.20));
  opacity: 0.85;
}


/* ===== 5. 每日一牌 — 触感卡牌 ===== */

.daily-card-wrapper {
  margin: var(--space-lg) 0 var(--space-xxxl);
  position: relative;
}

/* ——— 抽取前：触感牌背 ——— */
.card-daily-back {
  position: relative;
  overflow: hidden;
  background:
    /* 菱形细格纹 — 更清晰 */
    repeating-linear-gradient(
      45deg, transparent, transparent 16rpx,
      rgba(200, 168, 78, 0.025) 16rpx, rgba(200, 168, 78, 0.025) 17rpx
    ),
    repeating-linear-gradient(
      -45deg, transparent, transparent 16rpx,
      rgba(200, 168, 78, 0.025) 16rpx, rgba(200, 168, 78, 0.025) 17rpx
    ),
    /* 中央菱形辉光 — 更暖 */
    linear-gradient(135deg, transparent 44%, rgba(200, 168, 78, 0.08) 44%, rgba(200, 168, 78, 0.10) 50%, rgba(200, 168, 78, 0.08) 56%, transparent 56%),
    linear-gradient(225deg, transparent 44%, rgba(200, 168, 78, 0.08) 44%, rgba(200, 168, 78, 0.10) 50%, rgba(200, 168, 78, 0.08) 56%, transparent 56%),
    /* 基底深邃渐变 */
    linear-gradient(145deg, #120F24 0%, #1A1533 50%, #0D0B1A 100%);
  border: 2rpx solid rgba(200, 168, 78, 0.22);
  border-radius: var(--radius-card);
  padding: var(--space-massive) var(--space-xxl);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 240rpx;
  animation: card-call 3.5s ease-in-out infinite;
  transition: all var(--duration-normal) var(--ease-out);

  /* ===== 触感深度：多层阴影 ===== */
  box-shadow:
    /* 底部分离阴影 */
    0 12rpx 48rpx rgba(0, 0, 0, 0.45),
    0 4rpx 16rpx rgba(0, 0, 0, 0.30),
    /* 边缘光 */
    0 0 30rpx rgba(200, 168, 78, 0.06),
    /* 底边高光 — 模拟厚度 */
    0 2rpx 0 rgba(200, 168, 78, 0.08),
    0 4rpx 0 rgba(0, 0, 0, 0.15),
    /* 内阴影 — 边缘暗化增加立体感 */
    inset 0 -2rpx 6rpx rgba(0, 0, 0, 0.3),
    inset 0 2rpx 6rpx rgba(200, 168, 78, 0.02),
    /* 暖内辉光 */
    inset 0 0 40rpx rgba(200, 168, 78, 0.03),
    inset 0 0 80rpx rgba(200, 168, 78, 0.01);
}

/* 牌背左上角装饰星芒 */
.card-daily-back::before {
  content: '✦';
  position: absolute;
  top: 18rpx;
  left: 22rpx;
  font-size: 22rpx;
  color: rgba(200, 168, 78, 0.13);
  pointer-events: none;
  text-shadow: 0 0 8rpx rgba(200, 168, 78, 0.08);
}

/* 牌背右下角装饰星芒 */
.card-daily-back::after {
  content: '✦';
  position: absolute;
  bottom: 18rpx;
  right: 22rpx;
  font-size: 22rpx;
  color: rgba(200, 168, 78, 0.13);
  pointer-events: none;
  text-shadow: 0 0 8rpx rgba(200, 168, 78, 0.08);
}

.card-daily-back:active {
  transform: scale(0.95);
  border-color: rgba(200, 168, 78, 0.50);
  box-shadow:
    0 6rpx 24rpx rgba(0, 0, 0, 0.5),
    0 2rpx 8rpx rgba(0, 0, 0, 0.3),
    0 0 50rpx rgba(200, 168, 78, 0.30),
    0 0 100rpx rgba(200, 168, 78, 0.08),
    inset 0 0 60rpx rgba(200, 168, 78, 0.04);
}

.card-daily-back .heading-3 {
  position: relative;
  z-index: 1;
  color: var(--color-text-primary);
  font-weight: var(--fw-semibold);
  letter-spacing: 4rpx;
  margin-bottom: 8rpx;
  text-shadow: 0 0 12rpx rgba(200, 168, 78, 0.10);
}

.card-daily-free {
  position: relative;
  z-index: 1;
  color: rgba(200, 168, 78, 0.55);
  font-size: 22rpx;
  letter-spacing: 5rpx;
}

/* ——— 抽取后：魔法翻开牌面 ——— */
.card-daily-result {
  position: relative;
  overflow: hidden;
  background:
    /* 光晕扫面（柔和不刺眼） */
    linear-gradient(
      105deg,
      transparent 28%,
      rgba(200, 168, 78, 0.04) 42%,
      rgba(240, 216, 120, 0.07) 48%,
      rgba(200, 168, 78, 0.04) 54%,
      transparent 68%
    ),
    linear-gradient(
      145deg,
      rgba(18, 15, 36, 0.97) 0%,
      rgba(30, 24, 60, 0.88) 50%,
      rgba(13, 11, 26, 0.97) 100%
    );
  background-size: 200% 100%, 100% 100%;
  background-position: 50% 0, 0 0;
  border: 2rpx solid var(--color-gold);
  border-radius: var(--radius-card);
  padding: var(--space-massive) var(--space-xxl);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 240rpx;
  animation: card-reveal 0.9s var(--ease-out) forwards, result-shimmer 4s ease-in-out 1.5s infinite;

  /* 触感阴影 */
  box-shadow:
    0 12rpx 48rpx rgba(0, 0, 0, 0.45),
    0 4rpx 16rpx rgba(0, 0, 0, 0.30),
    0 0 40rpx rgba(200, 168, 78, 0.14),
    0 0 80rpx rgba(200, 168, 78, 0.04),
    0 2rpx 0 rgba(200, 168, 78, 0.10),
    0 4rpx 0 rgba(0, 0, 0, 0.15),
    inset 0 -2rpx 6rpx rgba(0, 0, 0, 0.3);
}

@keyframes result-shimmer {
  0%, 100% { background-position: 200% 0, 0 0; }
  50% { background-position: -50% 0, 0 0; }
}

/* 左上金角 */
.card-daily-result::before {
  content: '';
  position: absolute;
  top: 14rpx;
  left: 14rpx;
  width: 40rpx;
  height: 40rpx;
  border-top: 2.5rpx solid rgba(200, 168, 78, 0.22);
  border-left: 2.5rpx solid rgba(200, 168, 78, 0.22);
  border-radius: 12rpx 0 0 0;
  pointer-events: none;
}

/* 右下金角 */
.card-daily-result::after {
  content: '';
  position: absolute;
  bottom: 14rpx;
  right: 14rpx;
  width: 40rpx;
  height: 40rpx;
  border-bottom: 2.5rpx solid rgba(200, 168, 78, 0.22);
  border-right: 2.5rpx solid rgba(200, 168, 78, 0.22);
  border-radius: 0 0 12rpx 0;
  pointer-events: none;
}

.card-daily-result .heading-2 {
  position: relative;
  z-index: 1;
  text-shadow: 0 0 24rpx rgba(200, 168, 78, 0.25);
}

.card-daily-result .text-secondary {
  position: relative;
  z-index: 1;
  letter-spacing: 2rpx;
}


/* ===== 6. 抽取中状态 — 魔法仪式 ===== */

/* 抽取中：覆盖在牌背之上的仪式场 */
.card-daily-back.drawing {
  animation: none; /* 停止呼吸 */
  border-color: rgba(200, 168, 78, 0.30);
  animation: ritual-pulse 2s ease-in-out infinite;
  /* 保留原有背景，作为仪式基调 */
}

/* 仪式光晕环1（外层） */
.card-daily-back.drawing::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 340rpx;
  height: 340rpx;
  margin: 0;
  border: 1.5rpx solid rgba(200, 168, 78, 0.12);
  border-radius: 50%;
  animation: ritual-aura 3s linear infinite;
  pointer-events: none;
  z-index: 2;
  color: transparent;
  font-size: 0;
  text-shadow: none;
  transform-origin: center;
}

/* 仪式光晕环2（内层，反转） */
.card-daily-back.drawing::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 280rpx;
  height: 280rpx;
  margin: 0;
  border: 1rpx solid rgba(123, 107, 176, 0.10);
  border-radius: 50%;
  animation: ritual-aura-reverse 2.5s linear infinite;
  pointer-events: none;
  z-index: 2;
  color: transparent;
  font-size: 0;
  text-shadow: none;
  transform-origin: center;
}

/* 仪式符文环 */
.card-daily-back.drawing .ritual-runes {
  display: block;
  position: absolute;
  top: 50%;
  left: 50%;
  width: 200rpx;
  height: 200rpx;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  z-index: 2;
  pointer-events: none;
  border: 1rpx dotted rgba(200, 168, 78, 0.08);
  animation: ritual-rune-spin 4s linear infinite;
}
.card-daily-back.drawing .ritual-runes::before {
  content: '☽ ✦ ☾ ✧ ☽ ✦ ☾ ✧';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 18rpx;
  color: rgba(200, 168, 78, 0.12);
  letter-spacing: 12rpx;
  white-space: nowrap;
}

/* 仪式粒子（金色光点上升） */
.card-daily-back.drawing .ritual-particle {
  display: block;
  position: absolute;
  width: 4rpx;
  height: 4rpx;
  background: #F0D878;
  border-radius: 50%;
  box-shadow: 0 0 6rpx rgba(240, 216, 120, 0.4);
  pointer-events: none;
  z-index: 3;
  opacity: 0;
}
.card-daily-back.drawing .ritual-particle:nth-child(1) {
  bottom: 10%; left: 20%;
  animation: ritual-particle-rise 2.2s ease-out 0s infinite;
}
.card-daily-back.drawing .ritual-particle:nth-child(2) {
  bottom: 15%; left: 40%;
  width: 3rpx; height: 3rpx;
  background: #C8A84E;
  animation: ritual-particle-rise 2.5s ease-out 0.4s infinite;
}
.card-daily-back.drawing .ritual-particle:nth-child(3) {
  bottom: 8%; left: 60%;
  width: 5rpx; height: 5rpx;
  background: #F0D878;
  animation: ritual-particle-rise 2.0s ease-out 0.8s infinite;
}
.card-daily-back.drawing .ritual-particle:nth-child(4) {
  bottom: 12%; left: 75%;
  width: 3rpx; height: 3rpx;
  background: #C8A84E;
  box-shadow: 0 0 4rpx rgba(200, 168, 78, 0.3);
  animation: ritual-particle-rise 2.8s ease-out 1.2s infinite;
}
.card-daily-back.drawing .ritual-particle:nth-child(5) {
  bottom: 6%; left: 30%;
  width: 2rpx; height: 2rpx;
  background: #F5F0E8;
  animation: ritual-particle-rise 3s ease-out 1.6s infinite;
}
.card-daily-back.drawing .ritual-particle:nth-child(6) {
  bottom: 18%; left: 55%;
  width: 4rpx; height: 4rpx;
  background: #F0D878;
  box-shadow: 0 0 6rpx rgba(240, 216, 120, 0.4);
  animation: ritual-particle-rise 2.4s ease-out 2.0s infinite;
}

/* 仪式文字 */
.card-daily-back.drawing .heading-3 {
  animation: ritual-sweep 2.5s ease-in-out infinite;
  background: linear-gradient(
    90deg,
    rgba(200, 168, 78, 0.4) 0%,
    rgba(240, 216, 120, 0.8) 30%,
    rgba(240, 216, 120, 1) 50%,
    rgba(240, 216, 120, 0.8) 70%,
    rgba(200, 168, 78, 0.4) 100%
  );
  background-size: 200% 100%;
  background-clip: text;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}


/* ===== 7. 牌阵入口 — 塔罗桌卡 ===== */

.spread-section {
  margin-bottom: var(--space-massive);
}

.section-title {
  position: relative;
  color: var(--color-gold-light);
  letter-spacing: 4rpx;
  font-weight: var(--fw-semibold);
  margin-bottom: var(--space-lg);
  padding-left: var(--space-md);
}

/* 标题左侧金线 */
.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 4rpx;
  height: 55%;
  background: var(--gradient-gold);
  border-radius: 4rpx;
  animation: title-line-glow 3s ease-in-out infinite;
}

.spread-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-lg);
}

/* ——— 塔罗牌桌卡片 ——— */
.spread-grid .card {
  position: relative;
  background: linear-gradient(
    150deg,
    rgba(18, 15, 36, 0.95) 0%,
    rgba(24, 20, 50, 0.98) 50%,
    rgba(14, 12, 28, 0.98) 100%
  );
  border: 1rpx solid rgba(200, 168, 78, 0.10);
  border-radius: var(--radius-card);
  padding: 32rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  text-align: center;
  transition: all 0.3s var(--ease-out);
  overflow: visible;

  /* 卡牌深度 */
  box-shadow:
    0 8rpx 28rpx rgba(0, 0, 0, 0.35),
    0 2rpx 8rpx rgba(0, 0, 0, 0.25),
    0 0 12rpx rgba(200, 168, 78, 0.03);
}

/* 左上金角 */
.spread-grid .card::before {
  content: '';
  position: absolute;
  top: -1rpx;
  left: -1rpx;
  width: 34rpx;
  height: 34rpx;
  border-top: 2rpx solid rgba(200, 168, 78, 0.18);
  border-left: 2rpx solid rgba(200, 168, 78, 0.18);
  border-radius: 12rpx 0 0 0;
  pointer-events: none;
  transition: all var(--duration-normal);
}

/* 右下金角 */
.spread-grid .card::after {
  content: '';
  position: absolute;
  bottom: -1rpx;
  right: -1rpx;
  width: 34rpx;
  height: 34rpx;
  border-bottom: 2rpx solid rgba(200, 168, 78, 0.18);
  border-right: 2rpx solid rgba(200, 168, 78, 0.18);
  border-radius: 0 0 12rpx 0;
  pointer-events: none;
  transition: all var(--duration-normal);
  top: auto;
  left: auto;
  transform: none;
  background: none;
}

/* emoji 辉光盘 */
.spread-grid .card > text:first-child {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  font-size: 44rpx;
  background: radial-gradient(circle at 50% 50%, rgba(200, 168, 78, 0.10) 0%, transparent 70%);
  border-radius: 50%;
  margin-bottom: 8rpx;
  transition: all var(--duration-normal);
  line-height: 1;
}

/* Hover-like 效果（小程序用 active） */
.spread-grid .card:active {
  transform: scale(0.93);
  border-color: rgba(200, 168, 78, 0.35);
  box-shadow:
    0 4rpx 16rpx rgba(0, 0, 0, 0.45),
    0 0 30rpx rgba(200, 168, 78, 0.18),
    0 0 60rpx rgba(200, 168, 78, 0.05),
    inset 0 0 20rpx rgba(200, 168, 78, 0.03);
}

.spread-grid .card:active::before,
.spread-grid .card:active::after {
  border-color: rgba(200, 168, 78, 0.55);
  width: 38rpx;
  height: 38rpx;
}

.spread-grid .card:active > text:first-child {
  background: radial-gradient(circle at 50% 50%, rgba(200, 168, 78, 0.22) 0%, transparent 70%);
  transform: scale(1.10);
}

/* 牌阵名称 */
.spread-grid .card .text-body {
  font-size: var(--fs-body-small);
  color: var(--color-text-primary);
  font-weight: var(--fw-medium);
  letter-spacing: 1rpx;
  position: relative;
  z-index: 1;
}

/* 描述文本 */
.spread-grid .card .text-dim {
  font-size: var(--fs-caption);
  color: var(--color-text-dim);
  letter-spacing: 1rpx;
  position: relative;
  z-index: 1;
}


/* ===== 8. Premium 徽章 ===== */

.badge-gold {
  position: relative;
  z-index: 1;
  font-size: 18rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(200, 168, 78, 0.18), rgba(200, 168, 78, 0.08));
  color: var(--color-gold);
  border: 1rpx solid rgba(200, 168, 78, 0.14);
  animation: badge-glow 2.5s ease-in-out infinite;
  display: inline-block;
  letter-spacing: 1rpx;
  margin-top: 4rpx;
}


/* ===== 9. 环境氛围增强 ===== */

/* 顶部辉光 */
.orb-top {
  background: radial-gradient(
    circle at 50% 50%,
    rgba(123, 107, 176, 0.08) 0%,
    rgba(200, 168, 78, 0.05) 25%,
    rgba(123, 107, 176, 0.02) 50%,
    transparent 75%
  );
  width: 700rpx;
  height: 700rpx;
  animation: mystic-wave 6s ease-in-out infinite;
}

/* 底部辉光 */
.orb-bottom {
  background: radial-gradient(
    circle at 50% 50%,
    rgba(200, 168, 78, 0.07) 0%,
    rgba(123, 107, 176, 0.04) 35%,
    transparent 70%
  );
  width: 700rpx;
  height: 700rpx;
  animation: mystic-wave 8s ease-in-out infinite reverse;
}


/* ===== 10. 加载 / 错误 / 空状态 ===== */

.skeleton {
  padding: var(--space-xxl) 0;
}

.skeleton-circle {
  background: linear-gradient(135deg, rgba(18, 15, 36, 0.8), rgba(30, 24, 60, 0.6));
  border: 1rpx solid rgba(200, 168, 78, 0.06);
}

.skeleton-line {
  background: linear-gradient(90deg,
    rgba(18, 15, 36, 0.6),
    rgba(30, 24, 60, 0.4),
    rgba(18, 15, 36, 0.6));
  background-size: 200% 100%;
  animation: shimmer 2s ease-in-out infinite;
}

.skeleton-block {
  background: linear-gradient(135deg,
    rgba(18, 15, 36, 0.6),
    rgba(30, 24, 60, 0.4));
  border: 1rpx solid rgba(200, 168, 78, 0.05);
}

.skeleton-grid-item {
  background: linear-gradient(135deg,
    rgba(18, 15, 36, 0.6),
    rgba(30, 24, 60, 0.4));
  border: 1rpx solid rgba(200, 168, 78, 0.05);
}

.error-state {
  text-align: center;
  padding: var(--space-massive) var(--space-xl);
}

.error-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: var(--space-md);
  opacity: 0.5;
  filter: drop-shadow(0 0 20rpx rgba(200, 168, 78, 0.15));
}

.error-text {
  font-size: var(--fs-body);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--space-xs);
}

.error-hint {
  font-size: var(--fs-body-small);
  color: var(--color-text-dim);
  display: block;
  margin-bottom: var(--space-xxl);
}
