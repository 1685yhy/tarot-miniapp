.container {
  min-height: 100vh;
  padding: 0 32rpx;
}

/* 顶部神秘学氛围区 */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 40rpx;
}

.mystic-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(123, 104, 238, 0.3), transparent);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.star-field {
  position: relative;
}

.star {
  font-size: 64rpx;
  color: var(--color-gold);
}

.moon {
  font-size: 32rpx;
  color: var(--color-gold-light);
  position: absolute;
  top: -10rpx;
  right: -20rpx;
}

.hero-title {
  font-size: 48rpx;
  font-weight: 600;
  color: var(--color-gold);
  margin-bottom: 12rpx;
}

.hero-subtitle {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

/* 每日一牌 */
.daily-card {
  margin: 20rpx 0 40rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.card-back {
  background: linear-gradient(135deg, var(--color-purple-dark), var(--color-bg-card));
  border: 2rpx solid var(--color-purple);
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  cursor: pointer;
  transition: transform 0.3s;
}

.card-back:active {
  transform: scale(0.98);
}

.card-back-text {
  font-size: 32rpx;
  color: var(--color-text-primary);
  margin-bottom: 16rpx;
}

.card-back-hint {
  font-size: 24rpx;
  color: var(--color-text-dim);
}

.card-result {
  background: linear-gradient(135deg, var(--color-bg-card), var(--color-purple-dark));
  border: 2rpx solid var(--color-gold);
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.card-name {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-gold);
  margin-bottom: 12rpx;
}

.card-keywords {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  text-align: center;
}

/* 牌阵入口 */
.spread-section {
  margin-bottom: 60rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--color-text-primary);
  margin-bottom: 24rpx;
  display: block;
}

.spread-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.spread-item {
  background: var(--color-bg-card);
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  padding: 28rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  cursor: pointer;
  transition: all 0.2s;
}

.spread-item:active {
  background: var(--color-purple-dark);
  transform: scale(0.96);
}

.spread-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.spread-name {
  font-size: 24rpx;
  color: var(--color-text-primary);
  text-align: center;
  margin-bottom: 8rpx;
}

.spread-badge {
  font-size: 20rpx;
  color: var(--color-gold);
  background: rgba(201, 169, 110, 0.15);
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

.spread-desc {
  font-size: 20rpx;
  color: var(--color-text-dim);
  text-align: center;
}
