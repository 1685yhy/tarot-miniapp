/* ============================================================
   新月许愿 — E3 奶油疗愈（原型页 13）
   主角：许愿仪式（月相动画 + 愿望输入 → 成功态「已交给月光」）
   ============================================================ */

.page {
  min-height: 100vh;
  background: var(--color-bg);
  background-image: var(--color-bg-gradient);
  padding: 0 var(--spacing-lg, 32rpx) 60rpx;
  position: relative;
  box-sizing: border-box;
}

/* --- 星点底纹 --- */
.stars-layer {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 0;
}
.stars-layer::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 4rpx;
  height: 4rpx;
  background: transparent;
  border-radius: 50%;
  box-shadow:
    40rpx 80rpx rgba(201,169,124,.16),
    120rpx 180rpx rgba(201,169,124,.12),
    200rpx 50rpx rgba(201,169,124,.18),
    300rpx 250rpx rgba(201,169,124,.10),
    400rpx 120rpx rgba(201,169,124,.14),
    500rpx 80rpx rgba(201,169,124,.12),
    80rpx 400rpx rgba(201,169,124,.14),
    250rpx 500rpx rgba(201,169,124,.10),
    420rpx 380rpx rgba(201,169,124,.14),
    550rpx 600rpx rgba(201,169,124,.10),
    180rpx 700rpx rgba(201,169,124,.12),
    350rpx 800rpx rgba(201,169,124,.10);
}

/* ============================================================
   错误态
   ============================================================ */
.error-state {
  text-align: center;
  padding: 200rpx 40rpx;
}
.error-text {
  font-size: 32rpx;
  color: var(--color-text-secondary);
  display: block;
}
.error-hint {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  display: block;
  margin: 16rpx 0 32rpx;
}
.btn-ghost {
  background: transparent;
  border: 1rpx solid var(--color-card-border);
  color: var(--color-gold-deep-ink);
  border-radius: 999rpx;
  font-size: 26rpx;
  line-height: 76rpx;
  padding: 0 48rpx;
}

/* ============================================================
   月相仪式区（主角）
   ============================================================ */
.wish-stage {
  text-align: center;
  padding-top: 48rpx;
}

/* 新月月牙：金色圆 + 奶油色遮罩偏移，呼吸光晕 + 轻摆 */
.crescent {
  position: relative;
  width: 152rpx;
  height: 152rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: radial-gradient(circle at 32% 30%, #E8C4BE, #C9A97C);
  box-shadow: 0 0 60rpx rgba(201, 169, 124, 0.55);
  animation: cresGlow 4s ease-in-out infinite;
}
.crescent::after {
  content: '';
  position: absolute;
  width: 152rpx;
  height: 152rpx;
  border-radius: 50%;
  background: var(--color-bg);
  left: 92rpx;
  top: -12rpx;
  animation: cresSway 7s ease-in-out infinite;
}
.crescent-glow {
  position: absolute;
  inset: -40rpx;
  border-radius: 50%;
  background: radial-gradient(closest-side, rgba(201,169,124,.35), rgba(201,169,124,0) 72%);
  animation: cresGlow 4s ease-in-out infinite;
  pointer-events: none;
}
@keyframes cresGlow {
  0%, 100% { opacity: .7; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.05); }
}
@keyframes cresSway {
  0%, 100% { transform: rotate(-18deg) translate(0, 0); }
  50% { transform: rotate(-4deg) translate(-4rpx, 4rpx); }
}

.phase-line {
  display: block;
  margin-top: 28rpx;
  font-size: 22rpx;
  letter-spacing: 3rpx;
  color: var(--color-gold-deep-ink);
}
.wish-title {
  display: block;
  margin-top: 16rpx;
  font-family: var(--font-serif, serif);
  font-size: 44rpx;
  letter-spacing: 10rpx;
  color: var(--color-text-primary);
}
.wish-sub {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  letter-spacing: 3rpx;
  color: var(--color-text-tertiary);
}

/* ============================================================
   输入态
   ============================================================ */
.wish-input-zone {
  margin-top: 36rpx;
}

.chip-row {
  display: flex;
  justify-content: center;
  gap: 16rpx;
}
.chip {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: var(--color-card);
  border: 1rpx solid var(--color-card-border);
  font-size: 24rpx;
  color: var(--color-text-secondary);
  box-shadow: var(--shadow, none);
}
.chip--on {
  background: rgba(201, 169, 124, 0.16);
  border-color: rgba(201, 169, 124, 0.5);
  color: var(--color-gold-deep-ink);
}

.wish-textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 176rpx;
  margin-top: 28rpx;
  border-radius: 28rpx;
  background: var(--color-card);
  border: 1rpx solid var(--color-card-border);
  box-shadow: var(--shadow, none);
  padding: 24rpx 28rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--color-text-primary);
}
.wish-placeholder {
  color: var(--color-text-tertiary);
}
.wish-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-top: 10rpx;
}

.cta-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #C9A97C, #B08F52);
  color: #FFFDF8;
  font-size: 30rpx;
  letter-spacing: 6rpx;
  box-shadow: 0 12rpx 32rpx rgba(176, 143, 82, 0.35);
  margin-top: 32rpx;
  border: none;
  font-family: var(--font-serif, serif);
}
.cta-btn::after { border: none; }
.cta-btn[disabled] {
  background: var(--color-card-hover);
  color: var(--color-text-tertiary);
  box-shadow: none;
}
.cta-btn--ghost {
  background: transparent;
  border: 1rpx solid var(--color-card-border);
  color: var(--color-gold-deep-ink);
  box-shadow: none;
  margin-top: 20rpx;
}

.wish-moon-note {
  display: block;
  text-align: center;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: var(--color-text-tertiary);
  margin-top: 24rpx;
}
.wish-moon-note--done {
  margin-top: 20rpx;
}

/* ============================================================
   归档列表
   ============================================================ */
.archive-section {
  margin-top: 48rpx;
}
.archive-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 16rpx;
}
.archive-title {
  font-size: 28rpx;
  letter-spacing: 4rpx;
  color: var(--color-text-primary);
}
.archive-count {
  font-size: 22rpx;
  color: var(--color-gold-deep-ink);
  letter-spacing: 1rpx;
}
.archive-empty {
  text-align: center;
  padding: 40rpx 0;
  border-radius: 24rpx;
  border: 1rpx dashed var(--color-card-border);
}
.archive-empty-text {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}
.archive-empty-hint {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-top: 8rpx;
}

.wish-card {
  background: var(--color-card);
  border: 1rpx solid var(--color-card-border);
  border-radius: 24rpx;
  box-shadow: var(--shadow, none);
  padding: 22rpx 26rpx;
  margin-bottom: 16rpx;
}
.wish-card-top {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.wish-status {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}
.wish-status--active {
  background: rgba(232, 196, 190, 0.3);
  color: #B08A82;
  border: 1rpx solid rgba(176, 138, 130, 0.35);
}
.wish-status--grown {
  background: rgba(201, 169, 124, 0.16);
  color: var(--color-gold-deep-ink);
  border: 1rpx solid rgba(201, 169, 124, 0.4);
}
.wish-status--answered {
  background: rgba(176, 170, 156, 0.18);
  color: var(--color-text-tertiary);
  border: 1rpx solid rgba(176, 170, 156, 0.35);
}
.wish-date {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  letter-spacing: 1rpx;
}
.wish-delete {
  margin-left: auto;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  padding: 0;
}
.wish-card-text {
  display: block;
  margin-top: 10rpx;
  font-size: 27rpx;
  line-height: 1.7;
  color: var(--color-text-primary);
}

/* ============================================================
   成功态
   ============================================================ */
.wish-done-zone {
  text-align: center;
  padding-top: 60rpx;
}
.wish-seal {
  width: 108rpx;
  height: 108rpx;
  line-height: 108rpx;
  border-radius: 50%;
  margin: 0 auto;
  background: linear-gradient(135deg, #C9A97C, #B08F52);
  color: #FFFDF8;
  font-size: 44rpx;
  box-shadow: 0 0 0 14rpx rgba(201, 169, 124, 0.15), 0 20rpx 48rpx rgba(176, 143, 82, 0.35);
  animation: cresGlow 4s ease-in-out infinite;
}
.wish-done-title {
  display: block;
  margin-top: 28rpx;
  font-size: 36rpx;
  letter-spacing: 8rpx;
  color: var(--color-text-primary);
}
.wish-done-sub {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  letter-spacing: 2rpx;
  line-height: 1.7;
  padding: 0 24rpx;
}

.wish-ticket {
  position: relative;
  width: 420rpx;
  margin: 40rpx auto 0;
  border-radius: 32rpx;
  padding: 32rpx 30rpx;
  background: linear-gradient(165deg, #FFFDF8, #F2ECDF);
  border: 1rpx solid rgba(201, 169, 124, 0.45);
  box-shadow: 0 28rpx 60rpx rgba(61, 58, 54, 0.12);
  text-align: left;
}
.wish-ticket-stamp {
  position: absolute;
  top: 22rpx;
  right: 22rpx;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  border: 1rpx solid rgba(176, 143, 82, 0.55);
  color: var(--color-gold-deep-ink);
  font-size: 20rpx;
  transform: rotate(14deg);
}
.wish-ticket-text {
  display: block;
  font-size: 27rpx;
  line-height: 1.9;
  color: var(--color-text-primary);
  letter-spacing: 1rpx;
  padding-right: 56rpx;
}
.wish-ticket-date {
  display: block;
  margin-top: 16rpx;
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  letter-spacing: 2rpx;
}

.link-btn {
  background: transparent;
  border: none;
  color: var(--color-gold-deep-ink);
  font-size: 24rpx;
  letter-spacing: 4rpx;
  line-height: 80rpx;
  margin-top: 8rpx;
}
.link-btn::after { border: none; }
