/* ============================================================
   月度星光复盘页 — E3 奶油疗愈 token（与手账页同款接线模式）
   情绪曲线 + 亮暗星统计 + AI 温柔总结 + 本月星空色带
   ============================================================ */

page {
  --e3-cream: #FAF6EF;
  --e3-cream-hi: #FFFDF8;
  --e3-paper: #F2ECDF;
  --e3-pink: #E8C4BE;
  --e3-pink-ink: #B08A82;
  --e3-gold: #C9A97C;
  --e3-gold-deep: #8A6B3D;
  --e3-line: rgba(201, 169, 124, 0.28);
  --e3-line-soft: rgba(201, 169, 124, 0.38);
  --e3-lav: #D8D2E4;
  --e3-ink: #3D3A36;
  --e3-ink-soft: #8A8478;
  --e3-ink-faint: #6E6A96;
  --e3-shadow: 0 2rpx 8rpx rgba(61, 58, 54, 0.08);
  --e3-hi: inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
  --e3-serif: 'Songti SC', 'STSong', 'SimSun', 'Noto Serif CJK SC', 'Noto Serif SC', serif;
}

.container {
  padding: var(--spacing-xl) var(--spacing-lg);
  padding-bottom: calc(120rpx + var(--safe-area-bottom));
  min-height: 100vh;
  position: relative;
  z-index: 1;
}

/* ============================================================
   氛围光斑
   ============================================================ */
.wash {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
}

.wash-pink {
  top: -170rpx;
  right: -190rpx;
  width: 600rpx;
  height: 600rpx;
  background: radial-gradient(circle, rgba(232, 196, 190, 0.5) 0%, rgba(232, 196, 190, 0) 66%);
}

.wash-gold {
  left: -200rpx;
  top: 760rpx;
  width: 520rpx;
  height: 520rpx;
  background: radial-gradient(circle, rgba(201, 169, 124, 0.26) 0%, rgba(201, 169, 124, 0) 66%);
}

/* ============================================================
   加载骨架
   ============================================================ */
.skeleton-wrap {
  padding-top: var(--spacing-lg);
}

.skeleton-header-area {
  margin-bottom: var(--spacing-xl);
}

.skeleton {
  background: linear-gradient(90deg, rgba(201, 169, 124, 0.10) 25%, rgba(201, 169, 124, 0.22) 50%, rgba(201, 169, 124, 0.10) 75%);
  background-size: 400% 100%;
  animation: skeleton-shimmer 1.6s ease-in-out infinite;
  border-radius: var(--radius-pill);
}

@keyframes skeleton-shimmer {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}

.skeleton-line {
  height: 28rpx;
  margin-bottom: var(--spacing-sm);
}

.skeleton-line.wide { width: 56%; }
.skeleton-line.medium { width: 40%; }

.skeleton-block {
  height: 220rpx;
  border-radius: var(--radius-lg);
  margin-bottom: var(--spacing-lg);
}

.skeleton-block.short {
  height: 140rpx;
}

/* ============================================================
   错误状态
   ============================================================ */
.error-state {
  padding: 120rpx var(--spacing-lg);
  text-align: center;
}

.error-card {
  background: var(--color-surface);
  border: 1rpx solid rgba(232, 122, 138, 0.20);
  border-radius: var(--radius-lg);
  padding: var(--spacing-xl) var(--spacing-lg);
}

.error-title {
  font-family: var(--e3-serif, 'Songti SC', serif);
  font-size: var(--font-size-body);
  color: var(--e3-ink, #3D3A36);
  letter-spacing: 3rpx;
  display: block;
  margin-bottom: 12rpx;
}

.error-desc {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  display: block;
  margin-bottom: 36rpx;
  line-height: 1.6;
}

.btn-retry {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  background: rgba(201, 169, 124, 0.10);
  color: var(--color-gold-dark);
  font-size: var(--font-size-caption);
  font-weight: 500;
  border: 1rpx solid rgba(201, 169, 124, 0.20);
  border-radius: var(--radius-pill);
  padding: var(--spacing-sm) var(--spacing-xl);
}

.btn-retry:active {
  background: rgba(201, 169, 124, 0.18);
}

/* ============================================================
   Page Header
   ============================================================ */
.page-header {
  text-align: center;
  padding: var(--spacing-lg) 0 40rpx;
}

.page-title {
  font-size: var(--font-size-subhead);
  font-weight: 500;
  font-family: var(--e3-serif, 'Songti SC', serif);
  color: var(--e3-ink, #3D3A36);
  letter-spacing: 8rpx;
  display: block;
  margin-bottom: 12rpx;
}

.page-subtitle {
  font-size: var(--font-size-caption);
  color: var(--e3-ink-soft, #8A8478);
  letter-spacing: 3rpx;
  display: block;
}

/* ============================================================
   空月引导
   ============================================================ */
.empty-month {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-2xl) var(--spacing-lg);
  background: linear-gradient(145deg, var(--e3-cream-hi, #FFFDF8) 0%, var(--e3-paper, #F2ECDF) 100%);
  border: 1rpx solid var(--e3-line, rgba(201, 169, 124, 0.28));
  border-radius: var(--radius-lg);
  box-shadow: var(--e3-shadow, 0 2rpx 8rpx rgba(61, 58, 54, 0.08)), var(--e3-hi, inset 0 1rpx 0 rgba(255, 255, 255, 0.6));
  text-align: center;
}

.empty-month-icon {
  font-size: 64rpx;
  color: var(--e3-gold, #C9A97C);
  margin-bottom: var(--spacing-md);
}

.empty-month-title {
  font-family: var(--e3-serif, 'Songti SC', serif);
  font-size: var(--font-size-body);
  font-weight: 500;
  color: var(--e3-ink, #3D3A36);
  letter-spacing: 3rpx;
  margin-bottom: var(--spacing-sm);
  display: block;
}

.empty-month-sub {
  font-size: var(--font-size-caption);
  color: var(--e3-ink-faint, #6E6A96);
  line-height: 1.8;
  letter-spacing: 1rpx;
  display: block;
  margin-bottom: var(--spacing-lg);
}

.empty-month-btn {
  min-width: 320rpx;
}

/* ============================================================
   开场叙事卡（AI 星光寄语）
   ============================================================ */
.narrative-card {
  background: linear-gradient(135deg, rgba(201, 169, 124, 0.08) 0%, rgba(216, 210, 228, 0.10) 100%);
  border: 1.5rpx solid var(--e3-line-soft, rgba(201, 169, 124, 0.38));
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-md);
  position: relative;
  overflow: hidden;
}

.narrative-card::before {
  content: '';
  position: absolute;
  top: -80rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 300rpx;
  height: 160rpx;
  background: radial-gradient(circle, rgba(201, 169, 124, 0.10) 0%, transparent 70%);
  pointer-events: none;
}

.narrative-label {
  font-size: var(--font-size-caption);
  font-weight: 600;
  color: var(--e3-gold-deep, #8A6B3D);
  letter-spacing: 3rpx;
  display: block;
  margin-bottom: 12rpx;
  opacity: 0.85;
}

.narrative-text {
  font-family: var(--e3-serif, 'Songti SC', serif);
  font-size: var(--font-size-body);
  color: var(--e3-ink, #3D3A36);
  line-height: 1.9;
  letter-spacing: 2rpx;
  display: block;
}

/* ============================================================
   亮暗星统计
   ============================================================ */
.stats-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: linear-gradient(145deg, var(--e3-cream-hi, #FFFDF8) 0%, var(--e3-paper, #F2ECDF) 100%);
  border: 1rpx solid var(--e3-line, rgba(201, 169, 124, 0.28));
  border-radius: var(--radius-lg);
  padding: var(--spacing-md) var(--spacing-sm);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--e3-shadow, 0 2rpx 8rpx rgba(61, 58, 54, 0.08)), var(--e3-hi, inset 0 1rpx 0 rgba(255, 255, 255, 0.6));
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-sep {
  width: 1rpx;
  height: 56rpx;
  background: rgba(201, 169, 124, 0.18);
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--e3-ink, #3D3A36);
  line-height: 1;
}

.stat-num--bright {
  color: var(--e3-gold-deep, #8A6B3D);
}

.stat-num--dim {
  color: var(--e3-ink-faint, #6E6A96);
}

.stat-num--streak {
  font-size: 32rpx;
  color: var(--e3-gold-deep, #8A6B3D);
}

.stat-label {
  font-size: var(--font-size-xs);
  color: var(--e3-ink-soft, #8A8478);
  letter-spacing: 2rpx;
}

/* ============================================================
   内容卡片（情绪曲线 / 色带 / 高频之牌 / 洞察 / 指引）
   ============================================================ */
.section-card {
  background: linear-gradient(145deg, var(--e3-cream-hi, #FFFDF8) 0%, var(--e3-paper, #F2ECDF) 100%);
  border: 1rpx solid var(--e3-line, rgba(201, 169, 124, 0.28));
  border-radius: var(--radius-lg);
  padding: var(--spacing-md) var(--spacing-md) var(--spacing-lg);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--e3-shadow, 0 2rpx 8rpx rgba(61, 58, 54, 0.08)), var(--e3-hi, inset 0 1rpx 0 rgba(255, 255, 255, 0.6));
}

.section-label {
  font-size: var(--font-size-caption);
  font-weight: 600;
  color: var(--e3-gold-deep, #8A6B3D);
  letter-spacing: 2rpx;
  display: block;
  margin-bottom: 16rpx;
  opacity: 0.85;
}

/* —— 情绪曲线 —— */
.curve-text {
  display: block;
  text-align: center;
  font-size: 32rpx;
  letter-spacing: 6rpx;
  padding: 8rpx 0;
  color: var(--e3-gold-deep, #8A6B3D);
  opacity: 0.85;
  line-height: 1.8;
}

.curve-caption {
  display: block;
  text-align: center;
  font-size: var(--font-size-xs);
  color: var(--e3-ink-soft, #8A8478);
  letter-spacing: 1rpx;
}

/* —— 本月星空色带 —— */
.star-band {
  display: flex;
  align-items: center;
  gap: 4rpx;
  height: 32rpx;
  padding: 0 8rpx;
  margin-bottom: 20rpx;
}

.star-band-seg {
  height: 24rpx;
  border-radius: var(--radius-pill);
  min-width: 12rpx;
  box-shadow: var(--e3-hi, inset 0 1rpx 0 rgba(255, 255, 255, 0.45));
}

.star-band-counts {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.star-band-count {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
}

.star-band-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  box-shadow: 0 0 8rpx rgba(201, 169, 124, 0.25);
}

.star-band-count-text {
  font-size: var(--font-size-xs);
  color: var(--e3-ink-soft, #8A8478);
}

/* —— 本月高频之牌 —— */
.top-card-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0;
  border-bottom: 1rpx dashed rgba(201, 169, 124, 0.18);
}

.top-card-row:last-child {
  border-bottom: none;
}

.top-card-name {
  font-size: var(--font-size-caption);
  color: var(--e3-ink, #3D3A36);
  letter-spacing: 1rpx;
}

.top-card-count {
  font-size: var(--font-size-xs);
  color: var(--e3-gold-deep, #8A6B3D);
  font-weight: 600;
}

/* —— 星光洞察 / 下月指引 —— */
.insight-text,
.guide-text {
  font-size: var(--font-size-caption);
  color: var(--e3-ink, #3D3A36);
  line-height: 1.8;
  display: block;
  letter-spacing: 1rpx;
}

.insight-card {
  border-color: rgba(216, 210, 228, 0.45);
}

.guide-card {
  border-color: rgba(232, 196, 190, 0.45);
}

/* ============================================================
   操作
   ============================================================ */
.action-row {
  display: flex;
  gap: var(--spacing-sm);
  padding-top: var(--spacing-xs);
}

.action-btn {
  flex: 1;
  margin: 0;
  min-height: 88rpx;
  border-radius: var(--radius-pill);
  font-size: var(--font-size-caption);
  letter-spacing: 1rpx;
}

.action-btn--primary {
  background: linear-gradient(135deg, var(--e3-gold, #C9A97C) 0%, var(--e3-gold-deep, #8A6B3D) 100%);
  color: var(--e3-cream-hi, #FFFDF8);
  font-weight: 700;
}

.action-btn--primary::after {
  border: none;
}

.action-btn--primary:active {
  transform: scale(0.96);
}

/* T5-1 合规统一：页脚「仅供娱乐 · 星光映照」 */
.jr-foot {
  margin-top: 32rpx;
  padding: 20rpx 0 40rpx;
  display: flex;
  justify-content: center;
}
.jr-foot-text {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: rgba(176, 170, 156, 0.85);
}
