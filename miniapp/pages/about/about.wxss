/* ============================================================
   关于星光映照 — "Mirror, not fortune-telling"
   P4-3 重构：E3 奶油疗愈（#FAF6EF / 细金 #C9A97C / 雾粉 #E8C4BE / 墨 #3D3A36）
   三节卡片化 + 承诺式表达 + 协议入口
   ============================================================ */

.about-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FAF6EF 0%, #F7F0E3 50%, #FAF6EF 100%);
  display: flex;
  flex-direction: column;
  position: relative;
}

/* Subtle cosmic background — 浅色化（E3） */
.cosmic-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 0;
  background:
    radial-gradient(ellipse 60% 50% at 80% 20%, rgba(232, 196, 190, 0.10) 0%, transparent 70%),
    radial-gradient(ellipse 50% 60% at 20% 80%, rgba(201, 169, 124, 0.07) 0%, transparent 65%);
}

.about-content {
  position: relative;
  z-index: 1;
  padding: var(--spacing-2xl, 48rpx) var(--spacing-lg, 32rpx) var(--spacing-3xl, 64rpx);
  max-width: 600rpx;
  margin: 0 auto;
  width: 100%;
  box-sizing: border-box;
}

.about-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: var(--spacing-2xl, 48rpx);
}

.about-icon-wrap {
  width: 100rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(232, 196, 190, 0.30);
  border: 1.5rpx solid rgba(201, 169, 124, 0.30);
  border-radius: 50%;
  margin-bottom: var(--spacing-md, 24rpx);
  box-shadow: 0 2rpx 8rpx rgba(61, 58, 54, 0.08);
}

.about-icon {
  font-size: 48rpx;
  color: #B08F52;
}

.about-title {
  display: block;
  font-size: var(--font-size-title, 40rpx);
  font-family: 'Songti SC', 'STSong', 'SimSun', 'Noto Serif CJK SC', 'Noto Serif SC', serif;
  font-weight: 500;
  color: #B08F52;
  letter-spacing: 6rpx;
}

/* ── 卡片基座：奶油底 + 细金描边 + 浅阴影（E3） ── */
.about-section {
  background: linear-gradient(145deg, #FFFDF8 0%, #F2ECDF 100%);
  border: 1rpx solid rgba(201, 169, 124, 0.28);
  border-radius: 24rpx;
  padding: var(--spacing-lg, 32rpx);
  margin-bottom: var(--spacing-md, 24rpx);
  box-shadow: 0 2rpx 8rpx rgba(61, 58, 54, 0.08),
              inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
}

/* ── 「我们相信」品牌观卡：衬线标题 + 正文 ── */
.about-heading {
  display: block;
  font-size: var(--font-size-subhead, 34rpx);
  font-family: 'Songti SC', 'STSong', 'SimSun', 'Noto Serif CJK SC', 'Noto Serif SC', serif;
  font-weight: 500;
  color: #B08F52;
  letter-spacing: 4rpx;
  margin-bottom: var(--spacing-sm, 16rpx);
}

.about-text {
  display: block;
  font-size: var(--font-size-caption, 26rpx);
  color: #8A8478;
  line-height: 1.9;
  letter-spacing: 1rpx;
  margin-bottom: 8rpx;
}

.about-text:last-child {
  margin-bottom: 0;
}

/* ── 「我们恪守」承诺式列表 ── */
.promise-item {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: var(--spacing-sm, 16rpx);
  padding: var(--spacing-sm, 16rpx) 0;
}

.promise-item:not(:last-child) {
  border-bottom: 1rpx solid rgba(201, 169, 124, 0.16);
}

.promise-mark {
  flex-shrink: 0;
  margin-top: 6rpx;
  font-size: 26rpx;
  color: #C9A97C;
  line-height: 1.4;
}

.promise-body {
  flex: 1;
  min-width: 0;
}

.promise-title {
  display: block;
  font-size: 28rpx;
  font-family: 'Songti SC', 'STSong', 'SimSun', 'Noto Serif CJK SC', 'Noto Serif SC', serif;
  font-weight: 500;
  color: #3D3A36;
  letter-spacing: 2rpx;
  line-height: 1.5;
  margin-bottom: 4rpx;
}

.promise-desc {
  display: block;
  font-size: 24rpx;
  color: #8A8478;
  line-height: 1.6;
  letter-spacing: 1rpx;
}

/* ── 「AI 说明」细金描边卡 ── */
.about-section--ai {
  background: #FFFDF8;
  border: 1.5rpx solid rgba(201, 169, 124, 0.45);
  border-radius: 20rpx;
}

/* ── 协议入口 ── */
.about-legal {
  background: linear-gradient(145deg, #FFFDF8 0%, #F2ECDF 100%);
  border: 1rpx solid rgba(201, 169, 124, 0.28);
  border-radius: 24rpx;
  margin-top: var(--spacing-lg, 32rpx);
  box-shadow: 0 2rpx 8rpx rgba(61, 58, 54, 0.08),
              inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
  overflow: hidden;
}

.about-legal-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-md, 24rpx) var(--spacing-lg, 32rpx);
  min-height: 88rpx;
  transition: background 0.15s ease-out;
}

.about-legal-item:active {
  background: rgba(232, 196, 190, 0.28);
}

.about-legal-text {
  font-size: var(--font-size-caption, 26rpx);
  font-family: 'Songti SC', 'STSong', 'SimSun', 'Noto Serif CJK SC', 'Noto Serif SC', serif;
  color: #8A8478;
  letter-spacing: 2rpx;
}

.about-legal-arrow {
  font-size: 32rpx;
  color: #C9A97C;
  line-height: 1;
}

.about-legal-divider {
  height: 1rpx;
  background: rgba(201, 169, 124, 0.16);
  margin: 0 var(--spacing-lg, 32rpx);
}

/* ── 页尾版本号 ── */
.about-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: var(--spacing-xl, 48rpx);
  padding-top: var(--spacing-lg, 32rpx);
}

.about-footer-line {
  width: 60rpx;
  height: 1rpx;
  background: rgba(201, 169, 124, 0.30);
  margin-bottom: var(--spacing-sm, 16rpx);
}

.about-footer-text {
  font-size: var(--font-size-xs, 20rpx);
  color: #B0AA9C;
  letter-spacing: 2rpx;
  font-family: 'Songti SC', 'STSong', 'SimSun', 'Noto Serif CJK SC', 'Noto Serif SC', serif;
}
