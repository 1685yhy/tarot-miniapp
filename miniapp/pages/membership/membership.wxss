/* ============================================================
   Membership Page — Starlight Design System
   Dark indigo surfaces · Gold highlights · Premium offering
   ============================================================ */

page {
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

/* ================================================================
   Page wrapper
   ================================================================ */
.page {
  padding: var(--spacing-lg);
  padding-bottom: calc(var(--spacing-lg) + var(--safe-area-bottom, 0));
  min-height: 100vh;
}

/* ================================================================
   Typography helpers
   ================================================================ */
.heading-1 {
  font-size: var(--font-size-title);
  font-weight: 700;
  color: var(--color-text-primary);
  text-align: center;
}

.heading-3 {
  font-size: var(--font-size-body);
  font-weight: 600;
  color: var(--color-text-primary);
}

.text-body {
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  line-height: 1.6;
}

.text-secondary {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
}

.text-dim {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  display: block;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-col {
  flex-direction: column;
}

.gap-xs {
  gap: 6rpx;
}

.mt-sm { margin-top: 12rpx; }
.mt-xs { margin-top: 6rpx; }

/* ================================================================
   Hero section
   ================================================================ */
.anim-float {
  animation: float 3s ease-in-out infinite;
  display: block;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}

/* ================================================================
   Error State
   ================================================================ */
.error-state {
  text-align: center;
  padding: var(--spacing-4xl) var(--spacing-lg);
}

.error-icon {
  font-size: calc(var(--font-size-display) + 24rpx);
  display: block;
  margin-bottom: var(--spacing-sm);
  opacity: 0.40;
}

.error-text {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--spacing-xxs);
}

.error-hint {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  display: block;
  margin-bottom: var(--spacing-xl);
}

/* Buttons via common.wxss: .btn-primary, .btn--sm */

/* ================================================================
   Benefits — golden checkmark list
   ================================================================ */
.benefits {
  position: relative;
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-xl);
  background: var(--color-card);
  border: 1rpx solid var(--color-gold-glow);
  box-shadow: 0 2rpx 20rpx rgba(212, 175, 55, 0.05);
  overflow: hidden;
}

.benefits::before {
  content: '';
  position: absolute;
  top: var(--spacing-md);
  left: 0;
  width: 4rpx;
  height: calc(100% - var(--spacing-xl));
  background: var(--color-gold);
  border-radius: 0 2rpx 2rpx 0;
  box-shadow: 0 0 10rpx rgba(244, 212, 140, 0.35);
}

.benefit-item {
  padding: var(--spacing-sm) 0;
  padding-left: var(--spacing-xl);
  padding-right: var(--spacing-sm);
  border-bottom: 1rpx solid rgba(244, 212, 140, 0.08);
  position: relative;
}

.benefit-item:last-child {
  border-bottom: none;
}

.benefit-item::before {
  content: '✓';
  position: absolute;
  left: var(--spacing-sm);
  top: 50%;
  transform: translateY(-50%);
  color: var(--color-gold);
  font-size: var(--font-size-body);
  font-weight: 700;
  text-shadow: 0 0 8rpx rgba(244, 212, 140, 0.35);
}

.benefit-item .text-body {
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  line-height: 1.5;
}

/* ================================================================
   Product cards — dark indigo, gold accents
   ================================================================ */
.products {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-lg);
}

.product-card {
  position: relative;
  border-radius: var(--radius-lg);
  padding: var(--spacing-xl) var(--spacing-xl) var(--spacing-2xl);
  text-align: center;
  background: var(--color-card);
  border: 1rpx solid rgba(255, 255, 255, 0.04);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.2);
  transition: all 0.15s ease-out;
  overflow: hidden;
}

.product-card:active {
  transform: scale(0.97);
  border-color: var(--color-gold-glow);
  box-shadow: 0 0 24rpx rgba(244, 212, 140, 0.35);
}

/* Golden top accent line */
.product-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(
    90deg,
    transparent 0%,
    var(--color-gold-glow) 30%,
    rgba(212, 175, 55, 0.3) 50%,
    var(--color-gold-glow) 70%,
    transparent 100%
  );
  pointer-events: none;
}

/* ---- Recommended card — extra golden glow ---- */
.product-card.recommended {
  border-color: var(--color-gold-glow);
  box-shadow: 0 4rpx 32rpx rgba(212, 175, 55, 0.08), 0 2rpx 12rpx rgba(0, 0, 0, 0.2);
}

.product-card.recommended::before {
  background: linear-gradient(
    90deg,
    transparent 0%,
    var(--color-gold-light) 30%,
    var(--color-gold) 50%,
    var(--color-gold-light) 70%,
    transparent 100%
  );
  height: 4rpx;
  opacity: 0.6;
}

/* ---- Recommended badge ---- */
.recommended-badge {
  position: absolute;
  top: -14rpx;
  right: var(--spacing-lg);
  background: linear-gradient(135deg, var(--color-gold-light), var(--color-gold));
  color: var(--color-text-inverse);
  font-size: var(--font-size-caption);
  font-weight: 600;
  letter-spacing: 1rpx;
  padding: 6rpx var(--spacing-sm);
  border-radius: var(--radius-sm);
  z-index: 2;
  box-shadow: 0 2rpx 12rpx rgba(244, 212, 140, 0.35);
}

/* ================================================================
   Price display — gold for price, lavender for original
   ================================================================ */
.product-price {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-xxs);
  margin: var(--spacing-sm) 0 var(--spacing-xxs);
}

.price-symbol {
  font-size: var(--font-size-body);
  color: var(--color-gold);
  vertical-align: super;
  font-weight: 500;
}

.price-value {
  font-size: var(--font-size-display);
  font-weight: 700;
  color: var(--color-gold);
  line-height: 1;
  text-shadow: 0 0 20rpx rgba(244, 212, 140, 0.12);
}

/* Original/Strikethrough price — lavender */
.price-original {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  text-decoration: line-through;
  margin-left: var(--spacing-xs);
  vertical-align: baseline;
  opacity: 0.6;
}

/* ================================================================
   Purchase button — golden pill with warm glow
   ================================================================ */
.btn-purchase {
  display: block;
  width: 70%;
  margin: var(--spacing-md) auto 0;
  padding: var(--spacing-md) 0;
  border: none;
  border-radius: var(--radius-pill);
  font-size: var(--font-size-body);
  font-weight: 700;
  color: var(--color-text-inverse);
  background: linear-gradient(135deg, var(--color-gold-light), var(--color-gold));
  box-shadow: 0 4rpx 28rpx rgba(244, 212, 140, 0.35), inset 0 1rpx 0 rgba(255, 255, 255, 0.3);
  transition: all 0.15s ease-out;
  letter-spacing: 2rpx;
}

.btn-purchase::after {
  border: none;
}

.btn-purchase:active {
  transform: scale(0.96);
  box-shadow: 0 2rpx 12rpx rgba(244, 212, 140, 0.35);
}

/* ================================================================
   Guarantee
   ================================================================ */
.guarantee {
  text-align: center;
  padding: var(--spacing-2xl) 0;
  position: relative;
}

.guarantee::before {
  content: '';
  display: block;
  width: 80rpx;
  height: 1rpx;
  background: linear-gradient(
    90deg,
    transparent 0%,
    var(--color-gold-glow) 50%,
    transparent 100%
  );
  margin: 0 auto var(--spacing-xl);
}

.guarantee-text {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  line-height: 1.6;
}

/* ================================================================
   Skeleton — Shapes only (shimmer from common.wxss)
   ================================================================ */
.skeleton-mem-wrap {
  padding: var(--spacing-xl) 0;
}

.skeleton-hero-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-2xl);
}

.skeleton-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 100%;
}

.skeleton-line {
  height: 32rpx;
  border-radius: var(--radius-sm);
}

.skeleton-line.wide { width: 300rpx; }
.skeleton-line.medium { width: 200rpx; }

.skeleton-benefits,
.skeleton-product {
  width: 100%;
  border-radius: var(--radius-lg);
}

.skeleton-benefits { height: 280rpx; margin-bottom: var(--spacing-xl); }
.skeleton-product { height: 380rpx; margin-bottom: var(--spacing-md); }

/* ================================================================
   Staggered entrance
   ================================================================ */
.anim-fade-in-up-1 { opacity: 0; animation: fade-up 0.4s ease-out 0.05s forwards; }
.anim-fade-in-up-2 { opacity: 0; animation: fade-up 0.4s ease-out 0.10s forwards; }
.anim-fade-in-up-3 { opacity: 0; animation: fade-up 0.4s ease-out 0.15s forwards; }
.anim-fade-in-up-4 { opacity: 0; animation: fade-up 0.4s ease-out 0.20s forwards; }
.anim-fade-in-up-5 { opacity: 0; animation: fade-up 0.4s ease-out 0.25s forwards; }

/* ================================================================
   New Tier Card Design
   ================================================================ */
.mem-hero {
  text-align: center;
  padding: var(--spacing-3xl) 0 var(--spacing-xl);
}
.mem-hero-icon {
  font-size: 64rpx;
  color: var(--color-gold);
  display: block;
  margin-bottom: 16rpx;
}
.mem-hero-title {
  font-size: var(--font-size-display);
  font-weight: 700;
  color: var(--color-gold);
  display: block;
  letter-spacing: 4rpx;
}
.mem-hero-sub {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  margin-top: 12rpx;
  display: block;
}

.mem-tiers {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
  padding: 0 32rpx;
}

.mem-tier {
  background: var(--color-surface-gradient);
  border: 1.5rpx solid rgba(244,212,140,0.12);
  border-radius: 24rpx;
  padding: var(--spacing-xl) var(--spacing-lg);
  position: relative;
  transition: all 0.2s;
}
.mem-tier--rec {
  border-color: rgba(244,212,140,0.35);
  background: linear-gradient(145deg, #2A2A5A 0%, #313165 100%);
  box-shadow: 0 4rpx 30rpx rgba(244,212,140,0.1);
}

.mem-tier-badge {
  position: absolute;
  top: -16rpx;
  right: 32rpx;
  background: linear-gradient(135deg, #F4D48C, #E8C67A);
  color: #1A1A3E;
  font-size: 20rpx;
  font-weight: 700;
  padding: 6rpx var(--spacing-sm);
  border-radius: 20rpx;
  letter-spacing: 1rpx;
}

.mem-tier-name {
  font-size: var(--font-size-subhead);
  font-weight: 700;
  color: var(--color-text-primary);
  display: block;
}

.mem-tier-price {
  margin: var(--spacing-sm) 0 4rpx;
  display: flex;
  align-items: baseline;
}
.mem-tier-currency {
  font-size: var(--font-size-body);
  color: var(--color-gold);
  font-weight: 600;
}
.mem-tier-amount {
  font-size: 56rpx;
  font-weight: 800;
  color: var(--color-gold);
  line-height: 1;
}
.mem-tier-period {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  margin-left: 4rpx;
}
.mem-tier-daily {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  display: block;
  margin-bottom: 20rpx;
}

.mem-tier-features {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-xs);
  margin: var(--spacing-md) 0;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(244,212,140,0.08);
}
.mem-feat {
  display: flex;
  align-items: center;
  gap: var(--spacing-xs);
}
.mem-feat-icon {
  font-size: 28rpx;
  width: 40rpx;
  text-align: center;
}
.mem-feat-text {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
}

.mem-tier-cta {
  text-align: center;
  background: linear-gradient(135deg, #F4D48C, #E8C67A);
  color: #1A1A3E;
  font-size: var(--font-size-body);
  font-weight: 700;
  padding: var(--spacing-sm) 0;
  border-radius: var(--radius-pill);
  letter-spacing: 2rpx;
  margin-top: 8rpx;
}

.mem-single {
  padding: 0 32rpx;
  margin-top: 24rpx;
}
.mem-single-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-lg);
  background: var(--color-surface);
  border: 1rpx solid rgba(244,212,140,0.08);
  border-radius: 16rpx;
}
.mem-single-name {
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
}
.mem-single-price {
  font-size: var(--font-size-subhead);
  font-weight: 700;
  color: var(--color-gold);
}

.mem-footer {
  text-align: center;
  padding: var(--spacing-xl) var(--spacing-lg);
}
.mem-footer-text {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  opacity: 0.5;
}
