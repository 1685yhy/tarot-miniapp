/* ===== 会员 - 至尊神秘主题 ===== */

/* Benefits section */
.benefits {
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  padding: var(--space-xl);
  margin-bottom: var(--space-xl);
  border: 1rpx solid var(--color-border-light);
}

.benefit-item {
  padding: var(--space-sm) 0;
  border-bottom: 1rpx solid var(--color-divider);
}

.benefit-item:last-child {
  border-bottom: none;
}

/* Products */
.products {
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
}

.product-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  padding: var(--space-xxl);
  text-align: center;
  border: 2rpx solid var(--color-border-light);
  position: relative;
  transition: all var(--duration-normal) var(--ease-out);
}

.product-card:active {
  border-color: var(--color-gold);
  transform: scale(0.98);
  box-shadow: var(--shadow-glow-gold);
}

.product-card.recommended {
  border-color: var(--color-gold);
  background: linear-gradient(135deg, rgba(212, 175, 55, 0.06), var(--color-bg-card));
  box-shadow: var(--shadow-glow);
}

.recommended-badge {
  position: absolute;
  top: -14rpx;
  right: var(--space-xl);
  background: var(--gradient-gold);
  color: var(--color-text-on-gold);
  font-size: var(--fs-caption);
  padding: 6rpx 20rpx;
  border-radius: var(--radius-round);
  font-weight: var(--fw-semibold);
}

/* Price */
.price-symbol {
  font-size: var(--fs-h4);
  color: var(--color-gold);
}

.price-value {
  font-size: var(--fs-display);
  font-weight: var(--fw-bold);
  color: var(--color-gold);
}

/* Guarantee */
.guarantee {
  text-align: center;
  padding: var(--space-xxl) 0;
}

.guarantee-text {
  font-size: var(--fs-body-small);
  color: var(--color-text-dim);
}

/* ===== 加载骨架 ===== */
.skeleton {
  padding: var(--space-xxl) 0;
}

.skeleton-hero-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-md);
  margin-bottom: var(--space-xxxl);
}

.skeleton-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-full);
  background: var(--color-bg-card);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-line {
  height: 32rpx;
  border-radius: var(--radius-sm);
  background: var(--color-bg-card);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-line.wide { width: 300rpx; }
.skeleton-line.medium { width: 200rpx; }

.skeleton-benefits {
  width: 100%;
  height: 280rpx;
  border-radius: var(--radius-card);
  background: var(--color-bg-card);
  margin-bottom: var(--space-xxl);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-product {
  width: 100%;
  height: 260rpx;
  border-radius: var(--radius-card);
  background: var(--color-bg-card);
  margin-bottom: var(--space-lg);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

/* ===== 空状态 ===== */

/* ===== 错误状态 ===== */
.error-state {
  text-align: center;
  padding: var(--space-massive) var(--space-xl);
}

.error-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: var(--space-md);
  opacity: 0.6;
}

.error-text {
  font-size: var(--fs-body);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--space-xs);
}

.error-hint {
  font-size: var(--fs-body-small);
  color: var(--color-text-dim);
  display: block;
  margin-bottom: var(--space-xxl);
}
