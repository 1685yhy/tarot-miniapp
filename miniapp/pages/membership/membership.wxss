/* ============================================================
   Membership Page — Starlight Design System
   Dark indigo surfaces · Gold highlights · Premium offering
   ============================================================ */

/* ---- Design Tokens ---- */
page {
  --gold: #d4af37;
  --gold-light: #f0d68a;
  --gold-glow: rgba(212, 175, 55, 0.35);
  --gold-dim: rgba(212, 175, 55, 0.15);
  --gold-subtle: rgba(244, 212, 140, 0.08);
  --lavender: #b8b0d0;
  --lavender-dim: #7b7299;
  --bg-deep: #0d0b1a;
  --bg-card: #161329;
  --bg-elevated: #1e1a38;
  --text-primary: #e8e4f0;
  --text-secondary: #c8c0d8;
  --text-tertiary: #7b7299;
  --radius-sm: 12rpx;
  --radius-md: 18rpx;
  --radius-lg: 24rpx;
  --radius-round: 999rpx;
  --space-xs: 6rpx;
  --space-sm: 12rpx;
  --space-md: 20rpx;
  --space-lg: 28rpx;
  --space-xl: 36rpx;
  --space-2xl: 48rpx;
  --space-3xl: 64rpx;
  --space-4xl: 80rpx;
  --space-5xl: 100rpx;
  font-family: system-ui, -apple-system, 'PingFang SC', 'Noto Sans SC', sans-serif;
  background: var(--bg-deep);
  color: var(--text-primary);
}

/* ================================================================
   Page wrapper
   ================================================================ */
.page {
  padding: var(--space-xl);
  padding-bottom: calc(var(--space-xl) + var(--safe-area-bottom, 0));
  min-height: 100vh;
}

/* ================================================================
   Typography helpers
   ================================================================ */
.heading-1 {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-primary);
  text-align: center;
}

.heading-3 {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.text-body {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.6;
}

.text-secondary {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.text-dim {
  font-size: 24rpx;
  color: var(--text-tertiary);
  display: block;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-col {
  flex-direction: column;
}

.gap-xs {
  gap: 6rpx;
}

.mt-sm { margin-top: 12rpx; }
.mt-xs { margin-top: 6rpx; }

/* ================================================================
   Hero section
   ================================================================ */
.anim-float {
  animation: float 3s ease-in-out infinite;
  display: block;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}

/* ================================================================
   Error State
   ================================================================ */
.error-state {
  text-align: center;
  padding: var(--space-5xl) var(--space-xl);
}

.error-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: var(--space-md);
  opacity: 0.40;
}

.error-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: var(--space-xs);
}

.error-hint {
  font-size: 24rpx;
  color: var(--text-tertiary);
  display: block;
  margin-bottom: var(--space-2xl);
}

.btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-sm);
  padding: 20rpx 48rpx;
  border: none;
  border-radius: var(--radius-round);
  font-size: 28rpx;
  font-weight: 600;
  color: var(--bg-deep);
  background: linear-gradient(135deg, var(--gold-light), var(--gold));
  box-shadow: 0 4rpx 24rpx var(--gold-glow);
  transition: all 0.25s;
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  transform: scale(0.96);
}

.btn-small {
  padding: 16rpx 36rpx;
  font-size: 24rpx;
}

/* ================================================================
   Benefits — golden checkmark list
   ================================================================ */
.benefits {
  position: relative;
  border-radius: var(--radius-lg);
  padding: var(--space-xl);
  margin-bottom: var(--space-2xl);
  background: var(--bg-card);
  border: 1rpx solid var(--gold-dim);
  box-shadow: 0 2rpx 20rpx rgba(212, 175, 55, 0.05);
  overflow: hidden;
}

.benefits::before {
  content: '';
  position: absolute;
  top: var(--space-lg);
  left: 0;
  width: 4rpx;
  height: calc(100% - var(--space-2xl));
  background: var(--gold);
  border-radius: 0 2rpx 2rpx 0;
  box-shadow: 0 0 10rpx var(--gold-glow);
}

.benefit-item {
  padding: var(--space-md) 0;
  padding-left: var(--space-2xl);
  padding-right: var(--space-md);
  border-bottom: 1rpx solid var(--gold-subtle);
  position: relative;
}

.benefit-item:last-child {
  border-bottom: none;
}

.benefit-item::before {
  content: '✓';
  position: absolute;
  left: var(--space-md);
  top: 50%;
  transform: translateY(-50%);
  color: var(--gold);
  font-size: 28rpx;
  font-weight: 700;
  text-shadow: 0 0 8rpx var(--gold-glow);
}

.benefit-item .text-body {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.5;
}

/* ================================================================
   Product cards — dark indigo, gold accents
   ================================================================ */
.products {
  display: flex;
  flex-direction: column;
  gap: var(--space-xl);
}

.product-card {
  position: relative;
  border-radius: var(--radius-lg);
  padding: var(--space-2xl) var(--space-2xl) var(--space-3xl);
  text-align: center;
  background: var(--bg-card);
  border: 1rpx solid rgba(255, 255, 255, 0.04);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.2);
  transition: all 0.3s ease;
  overflow: hidden;
}

.product-card:active {
  transform: scale(0.97);
  border-color: var(--gold-dim);
  box-shadow: 0 0 24rpx var(--gold-glow);
}

/* Golden top accent line */
.product-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(
    90deg,
    transparent 0%,
    var(--gold-dim) 30%,
    rgba(212, 175, 55, 0.3) 50%,
    var(--gold-dim) 70%,
    transparent 100%
  );
  pointer-events: none;
}

/* ---- Recommended card — extra golden glow ---- */
.product-card.recommended {
  border-color: var(--gold-dim);
  box-shadow: 0 4rpx 32rpx rgba(212, 175, 55, 0.08), 0 2rpx 12rpx rgba(0, 0, 0, 0.2);
}

.product-card.recommended::before {
  background: linear-gradient(
    90deg,
    transparent 0%,
    var(--gold-light) 30%,
    var(--gold) 50%,
    var(--gold-light) 70%,
    transparent 100%
  );
  height: 4rpx;
  opacity: 0.6;
}

/* ---- Recommended badge ---- */
.recommended-badge {
  position: absolute;
  top: -14rpx;
  right: var(--space-xl);
  background: linear-gradient(135deg, var(--gold-light), var(--gold));
  color: var(--bg-deep);
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  padding: 6rpx 20rpx;
  border-radius: var(--radius-sm);
  z-index: 2;
  box-shadow: 0 2rpx 12rpx var(--gold-glow);
}

/* ================================================================
   Price display — gold for price, lavender for original
   ================================================================ */
.product-price {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-xs);
  margin: var(--space-md) 0 var(--space-xs);
}

.price-symbol {
  font-size: 28rpx;
  color: var(--gold);
  vertical-align: super;
  font-weight: 500;
}

.price-value {
  font-size: 64rpx;
  font-weight: 700;
  color: var(--gold);
  line-height: 1;
  text-shadow: 0 0 20rpx rgba(244, 212, 140, 0.12);
}

/* Original/Strikethrough price — lavender */
.price-original {
  font-size: 24rpx;
  color: var(--lavender-dim);
  text-decoration: line-through;
  margin-left: var(--space-sm);
  vertical-align: baseline;
  opacity: 0.6;
}

/* ================================================================
   Purchase button — golden pill with warm glow
   ================================================================ */
.btn-purchase {
  display: block;
  width: 70%;
  margin: var(--space-lg) auto 0;
  padding: 22rpx 0;
  border: none;
  border-radius: var(--radius-round);
  font-size: 28rpx;
  font-weight: 700;
  color: var(--bg-deep);
  background: linear-gradient(135deg, var(--gold-light), var(--gold));
  box-shadow: 0 4rpx 28rpx var(--gold-glow), inset 0 1rpx 0 rgba(255, 255, 255, 0.3);
  transition: all 0.25s ease;
  letter-spacing: 2rpx;
}

.btn-purchase::after {
  border: none;
}

.btn-purchase:active {
  transform: scale(0.96);
  box-shadow: 0 2rpx 12rpx var(--gold-glow);
}

/* ================================================================
   Guarantee
   ================================================================ */
.guarantee {
  text-align: center;
  padding: var(--space-3xl) 0;
  position: relative;
}

.guarantee::before {
  content: '';
  display: block;
  width: 80rpx;
  height: 1rpx;
  background: linear-gradient(
    90deg,
    transparent 0%,
    var(--gold-dim) 50%,
    transparent 100%
  );
  margin: 0 auto var(--space-2xl);
}

.guarantee-text {
  font-size: 24rpx;
  color: var(--text-tertiary);
  line-height: 1.6;
}

/* ================================================================
   Skeleton — dark shimmer
   ================================================================ */
.skeleton {
  padding: var(--space-2xl) 0;
}

.skeleton-hero-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-md);
  margin-bottom: var(--space-3xl);
}

.skeleton-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 100%;
  background: var(--bg-card);
  animation: pulse-scale 1.5s ease-in-out infinite;
}

.skeleton-line {
  height: 32rpx;
  border-radius: var(--radius-sm);
  background: var(--bg-card);
  animation: pulse-scale 1.5s ease-in-out infinite;
}

.skeleton-line.wide { width: 300rpx; }
.skeleton-line.medium { width: 200rpx; }

.skeleton-benefits,
.skeleton-product {
  width: 100%;
  border-radius: var(--radius-lg);
  background: var(--bg-card);
  animation: pulse-scale 1.5s ease-in-out infinite;
}

.skeleton-benefits { height: 280rpx; margin-bottom: var(--space-2xl); }
.skeleton-product { height: 380rpx; margin-bottom: var(--space-lg); }

@keyframes pulse-scale {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(0.98); }
}

/* ================================================================
   Staggered entrance
   ================================================================ */
.anim-fade-in-up-1 { opacity: 0; animation: fade-up 0.6s ease 0.05s forwards; }
.anim-fade-in-up-2 { opacity: 0; animation: fade-up 0.6s ease 0.10s forwards; }
.anim-fade-in-up-3 { opacity: 0; animation: fade-up 0.6s ease 0.15s forwards; }
.anim-fade-in-up-4 { opacity: 0; animation: fade-up 0.6s ease 0.20s forwards; }
.anim-fade-in-up-5 { opacity: 0; animation: fade-up 0.6s ease 0.25s forwards; }

@keyframes fade-up {
  0% { opacity: 0; transform: translateY(24rpx); }
  100% { opacity: 1; transform: translateY(0); }
}
