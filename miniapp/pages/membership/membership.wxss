/* ============================================================
   Membership Page — 柔光星辰
   Premium offerings · Gold-highlighted recommended · Dark indigo surface
   ============================================================ */

/* ---- Old variable aliases (WXML inline style compat) ---- */
page {
  --space-massive: var(--spacing-5xl);
  --space-xxxl: var(--spacing-3xl);
  --space-xxl: var(--spacing-2xl);
  --space-xl: var(--spacing-xl);
  --space-lg: var(--spacing-lg);
  --space-md: var(--spacing-md);
  --space-sm: var(--spacing-sm);
  --space-xs: var(--spacing-xs);
  --fs-h3: var(--font-size-xl);
  --fs-h4: var(--font-size-lg);
  --fs-body: var(--font-size-base);
  --fs-body-small: var(--font-size-sm);
  --fs-caption: var(--font-size-xs);
  --lh-loose: var(--line-height-loose);
  --lh-normal: var(--line-height-base);
  --fw-semibold: var(--font-weight-semibold);
  --fw-bold: var(--font-weight-bold);
  --fw-medium: var(--font-weight-medium);
  --duration-normal: var(--duration-base);
  --duration-fast: var(--duration-fast);
  --ease-out: var(--ease-out);
  --ease-in-out: var(--ease-in-out);
  --color-star-subtle: rgba(244, 212, 140, 0.12);
  --color-text-secondary: var(--color-text-secondary);
  --color-text-primary: var(--color-text-primary);
}

/* ---- Variables missing from common - define locally ---- */
:host,
page {
  --fs-display: 64rpx;
  --radius-full: 100%;
}

/* ---------------------------------------------------------------
   Page — dark indigo surface
   --------------------------------------------------------------- */
.page {
  padding: var(--spacing-lg);
  padding-bottom: calc(var(--spacing-lg) + var(--safe-area-bottom));
}

/* ---------------------------------------------------------------
   text-secondary / text-dim — class aliases for old WXML
   --------------------------------------------------------------- */
.text-secondary {
  color: var(--color-text-secondary);
  font-size: var(--font-size-base);
}

.text-dim {
  color: var(--color-text-secondary);
  font-size: var(--font-size-sm);
}

.text-body {
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  line-height: var(--line-height-base);
}

/* ---- Hero section ---- */
.flex-center.flex-col {
  display: flex;
  align-items: center;
  flex-direction: column;
}

.heading-1 {
  font-size: var(--font-size-3xl);
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
  text-align: center;
}

.anim-float {
  animation: float 3s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}

/* ---------------------------------------------------------------
   Error State
   --------------------------------------------------------------- */
.error-state {
  text-align: center;
  padding: var(--spacing-5xl) var(--spacing-xl);
}

.error-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: var(--spacing-md);
  opacity: 0.40;
}

.error-text {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--spacing-xs);
}

.error-hint {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
  display: block;
  margin-bottom: var(--spacing-2xl);
}

.btn-small {
  font-size: var(--font-size-sm);
  padding: 16rpx 36rpx;
}

/* ---------------------------------------------------------------
   Benefits — Dark indigo cards with golden left accent
   --------------------------------------------------------------- */
.benefits {
  position: relative;
  border-radius: var(--radius-lg);
  padding: var(--spacing-xl);
  margin-bottom: var(--spacing-2xl);
  background: var(--color-card);
  border: 1rpx solid var(--color-card-border);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

/* Golden left border accent */
.benefits::before {
  content: '';
  position: absolute;
  top: var(--spacing-lg);
  left: 0;
  width: 4rpx;
  height: calc(100% - var(--spacing-2xl));
  background: var(--color-gold);
  border-radius: 0 2rpx 2rpx 0;
  box-shadow: 0 0 10rpx rgba(244, 212, 140, 0.20);
  opacity: 0.60;
}

.benefit-item {
  padding: var(--spacing-md) 0;
  padding-left: var(--spacing-lg);
  border-bottom: 1rpx solid rgba(244, 212, 140, 0.06);
}

.benefit-item:last-child {
  border-bottom: none;
}

.benefit-item .text-body {
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  line-height: var(--line-height-normal);
}

/* ---------------------------------------------------------------
   Products — Premium card offerings
   --------------------------------------------------------------- */
.products {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-xl);
}

.product-card {
  position: relative;
  border-radius: var(--radius-lg);
  padding: var(--spacing-2xl);
  text-align: center;
  background: var(--color-card);
  border: 1rpx solid var(--color-card-border);
  box-shadow: var(--shadow-card);
  transition: all var(--duration-base) var(--ease-soft);
  overflow: hidden;
}

/* Golden top accent line */
.product-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(244, 212, 140, 0.15) 30%,
    rgba(244, 212, 140, 0.30) 50%,
    rgba(244, 212, 140, 0.15) 70%,
    transparent 100%
  );
  pointer-events: none;
}

.product-card:active {
  transform: scale(0.97);
  border-color: var(--color-card-border-hover);
  box-shadow: var(--shadow-elevated);
}

/* ---- Recommended card — extra golden glow ---- */
.product-card.recommended {
  border-color: rgba(244, 212, 140, 0.35);
  box-shadow: 0 4rpx 32rpx rgba(244, 212, 140, 0.08), var(--shadow-card);
}

.product-card.recommended::before {
  background: linear-gradient(
    90deg,
    transparent 0%,
    var(--color-gold-light) 30%,
    var(--color-gold) 50%,
    var(--color-gold-light) 70%,
    transparent 100%
  );
  opacity: 0.60;
  height: 4rpx;
}

/* Recommended badge */
.recommended-badge {
  position: absolute;
  top: -14rpx;
  right: var(--spacing-xl);
  background: linear-gradient(135deg, var(--color-gold-light) 0%, var(--color-gold) 100%);
  color: var(--color-text-inverse);
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-medium);
  letter-spacing: 1rpx;
  padding: 6rpx 20rpx;
  border-radius: var(--radius-sm);
  z-index: 2;
  box-shadow: 0 2rpx 12rpx rgba(244, 212, 140, 0.25);
}

/* ---- Price display — golden numbers ---- */
.product-price {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-xs);
  margin: var(--spacing-md) 0 var(--spacing-xs);
}

.price-symbol {
  font-size: var(--font-size-lg);
  color: var(--color-gold);
  vertical-align: super;
  font-weight: var(--font-weight-medium);
}

.price-value {
  font-size: 64rpx;
  font-weight: var(--font-weight-bold);
  color: var(--color-gold);
  line-height: 1;
  text-shadow: 0 0 20rpx rgba(244, 212, 140, 0.12);
}

/* ---------------------------------------------------------------
   Guarantee — Subtle bottom text
   --------------------------------------------------------------- */
.guarantee {
  text-align: center;
  padding: var(--spacing-3xl) 0;
  position: relative;
}

.guarantee::before {
  content: '';
  display: block;
  width: 80rpx;
  height: 1rpx;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(244, 212, 140, 0.25) 50%,
    transparent 100%
  );
  margin: 0 auto var(--spacing-2xl);
}

.guarantee-text {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
  line-height: var(--line-height-normal);
}

/* ---------------------------------------------------------------
   Skeleton — Dark shimmer for premium page
   --------------------------------------------------------------- */
.skeleton {
  padding: var(--spacing-2xl) 0;
}

.skeleton-hero-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-md);
  margin-bottom: var(--spacing-3xl);
}

.skeleton-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-full);
  background: var(--color-surface);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-line {
  height: 32rpx;
  border-radius: var(--radius-sm);
  background: var(--color-surface);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-line.wide { width: 300rpx; }
.skeleton-line.medium { width: 200rpx; }

.skeleton-benefits {
  width: 100%;
  height: 280rpx;
  border-radius: var(--radius-lg);
  background: var(--color-surface);
  margin-bottom: var(--spacing-2xl);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-product {
  width: 100%;
  height: 380rpx;
  border-radius: var(--radius-lg);
  background: var(--color-surface);
  margin-bottom: var(--spacing-lg);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

@keyframes pulse-scale {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.50; transform: scale(0.98); }
}

/* ---------------------------------------------------------------
   Staggered entrance animations
   --------------------------------------------------------------- */
.anim-fade-in-up-1 { opacity: 0; animation: fade-up 0.6s var(--ease-soft) 0.05s forwards; }
.anim-fade-in-up-2 { opacity: 0; animation: fade-up 0.6s var(--ease-soft) 0.10s forwards; }
.anim-fade-in-up-3 { opacity: 0; animation: fade-up 0.6s var(--ease-soft) 0.15s forwards; }
.anim-fade-in-up-4 { opacity: 0; animation: fade-up 0.6s var(--ease-soft) 0.20s forwards; }
.anim-fade-in-up-5 { opacity: 0; animation: fade-up 0.6s var(--ease-soft) 0.25s forwards; }

@keyframes fade-up {
  0% { opacity: 0; transform: translateY(24rpx); }
  100% { opacity: 1; transform: translateY(0); }
}
