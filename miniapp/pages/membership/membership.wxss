/* ========================================================
   会员页 · Editorial Minimal
   精品文具质感 · 纯白背景 · 干净排版
   ======================================================== */

/* ---------------------------------------------------------------
   Benefits — 会员权益，轻量卡片
   --------------------------------------------------------------- */
.benefits {
  position: relative;
  border-radius: 12rpx;
  padding: var(--space-xl);
  margin-bottom: var(--space-xxl);
  background: #ffffff;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.02);
}

.benefit-item {
  padding: var(--space-md) 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
}

.benefit-item:last-child {
  border-bottom: none;
}

.benefit-item .text-body {
  font-size: var(--fs-body);
  color: #2c2c2c;
  line-height: var(--lh-normal);
}

/* ---------------------------------------------------------------
   Products — 精品陈列，文具质感卡片
   --------------------------------------------------------------- */
.products {
  display: flex;
  flex-direction: column;
  gap: var(--space-xl);
}

.product-card {
  position: relative;
  border-radius: 12rpx;
  padding: var(--space-xxl);
  text-align: center;
  background: #ffffff;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.03);
  transition: all 0.25s ease;
  overflow: hidden;
}

/* —— 顶部细线 —— */
.product-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: #2c2c2c;
  opacity: 0.08;
  pointer-events: none;
}

.product-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

/* ---------- 推荐卡片 ---------- */
.product-card.recommended {
  border-color: rgba(0, 0, 0, 0.12);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.product-card.recommended::before {
  opacity: 0.2;
  background: #b89a7a;
}

/* 推荐徽章 */
.recommended-badge {
  position: absolute;
  top: -14rpx;
  right: var(--space-xl);
  background: #b89a7a;
  color: #ffffff;
  font-size: var(--fs-caption);
  font-weight: 500;
  letter-spacing: 0.5rpx;
  padding: 6rpx 20rpx;
  border-radius: 6rpx;
  z-index: 2;
}

/* ---------- Price display — 干净价签 ---------- */
.price-symbol {
  font-size: var(--fs-h4);
  color: #b89a7a;
  vertical-align: super;
}

.price-value {
  font-size: var(--fs-display);
  font-weight: 600;
  color: #2c2c2c;
  line-height: 1;
}

/* ---------------------------------------------------------------
   Guarantee — 底部保障文字
   --------------------------------------------------------------- */
.guarantee {
  text-align: center;
  padding: var(--space-xxxl) 0;
}

.guarantee::before {
  content: '';
  display: block;
  width: 80rpx;
  height: 1rpx;
  background: rgba(0, 0, 0, 0.12);
  margin: 0 auto var(--space-xxl);
}

.guarantee-text {
  font-size: var(--fs-body-small);
  color: rgba(0, 0, 0, 0.35);
  line-height: var(--lh-normal);
}

/* ---------------------------------------------------------------
   Load / Skeleton — 干净骨架屏
   --------------------------------------------------------------- */
.skeleton {
  padding: var(--space-xxl) 0;
}

.skeleton-hero-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-md);
  margin-bottom: var(--space-xxxl);
}

.skeleton-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(90deg, rgba(0, 0, 0, 0.05), rgba(0, 0, 0, 0.02));
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-line {
  height: 32rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, rgba(0, 0, 0, 0.05), rgba(0, 0, 0, 0.02));
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-line.wide { width: 300rpx; }
.skeleton-line.medium { width: 200rpx; }

.skeleton-benefits {
  width: 100%;
  height: 280rpx;
  border-radius: 12rpx;
  background: linear-gradient(90deg, rgba(0, 0, 0, 0.04), rgba(0, 0, 0, 0.015));
  margin-bottom: var(--space-xxl);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

.skeleton-product {
  width: 100%;
  height: 380rpx;
  border-radius: 12rpx;
  background: linear-gradient(90deg, rgba(0, 0, 0, 0.04), rgba(0, 0, 0, 0.015));
  margin-bottom: var(--space-lg);
  animation: pulse-scale 1.5s var(--ease-in-out) infinite;
}

/* ---------------------------------------------------------------
   Error
   --------------------------------------------------------------- */
.error-state {
  text-align: center;
  padding: var(--space-massive) var(--space-xl);
}

.error-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: var(--space-lg);
  opacity: 0.25;
}

.error-text {
  font-size: var(--fs-body);
  color: rgba(0, 0, 0, 0.45);
  display: block;
  margin-bottom: var(--space-xs);
}

.error-hint {
  font-size: var(--fs-body-small);
  color: rgba(0, 0, 0, 0.25);
  display: block;
  margin-bottom: var(--space-xxl);
}
