/* ============================================================
   Membership Page — Redesigned v2
   Dark indigo surfaces · Gold highlights · Premium offering
   Free trial · Comparison table · Simplified pricing
   ============================================================ */

page {
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

/* ================================================================
   Page wrapper
   ================================================================ */
.page {
  padding: var(--spacing-lg);
  padding-bottom: calc(var(--spacing-lg) + var(--safe-area-bottom, 0));
  min-height: 100vh;
}

/* ================================================================
   Typography helpers (page-specific — scoped to avoid overriding common.wxss)
   ================================================================ */

/* ================================================================
   Hero section
   ================================================================ */
.anim-float {
  animation: float 3s ease-in-out infinite;
  display: block;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}

/* ================================================================
   Error State
   ================================================================ */
.error-state {
  text-align: center;
  padding: var(--spacing-4xl) var(--spacing-lg);
}

.error-text {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--spacing-xxs);
}

.error-hint {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  display: block;
  margin-bottom: var(--spacing-xl);
}

/* ================================================================
   Hero Section
   ================================================================ */
.mem-hero {
  text-align: center;
  padding: var(--spacing-xl) 0 var(--spacing-lg);
}
.mem-hero-icon {
  width: 64rpx;
  height: 64rpx;
  display: block;
  margin: 0 auto var(--spacing-sm);
  opacity: 0.9;
}
.mem-hero-title {
  font-size: var(--font-size-display);
  font-weight: 700;
  color: var(--color-gold);
  display: block;
  letter-spacing: 4rpx;
}
.mem-hero-sub {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  margin-top: 12rpx;
  display: block;
}

/* ================================================================
   Free Trial Banner
   ================================================================ */
.free-trial-banner {
  background: linear-gradient(145deg, #2A2A5A 0%, #353570 100%);
  border: 1.5rpx solid rgba(244, 212, 140, 0.25);
  border-radius: 28rpx;
  padding: var(--spacing-lg) var(--spacing-lg) var(--spacing-md);
  text-align: center;
  margin-bottom: var(--spacing-xl);
  position: relative;
  overflow: hidden;
}

.free-trial-banner::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(
    90deg,
    transparent 0%,
    var(--color-gold-glow-strong) 30%,
    var(--color-gold) 50%,
    var(--color-gold-glow-strong) 70%,
    transparent 100%
  );
  pointer-events: none;
}

.trial-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(244, 212, 140, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto var(--spacing-sm);
}

.trial-icon {
  font-size: 36rpx;
}

.trial-title {
  font-size: var(--font-size-subhead);
  font-weight: 700;
  color: var(--color-gold);
  display: block;
  margin-bottom: 6rpx;
}

.trial-sub {
  font-size: var(--font-size-caption);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--spacing-md);
  line-height: 1.5;
}

.trial-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 400rpx;
  padding: var(--spacing-sm) 0;
  background: linear-gradient(135deg, #F4D48C 0%, #E8C67A 50%, #D4B06A 100%);
  color: #1A1A3E;
  font-size: var(--font-size-body);
  font-weight: 700;
  border: none;
  border-radius: var(--radius-pill);
  letter-spacing: 2rpx;
  box-shadow: 0 4rpx 28rpx rgba(244, 212, 140, 0.35), inset 0 1rpx 0 rgba(255, 255, 255, 0.3);
  transition: transform 0.15s ease-out, box-shadow 0.15s ease-out;
}

.trial-btn::after {
  border: none;
}

.trial-btn:active {
  transform: scale(0.96);
  box-shadow: 0 2rpx 12rpx rgba(244, 212, 140, 0.25);
}

.trial-guarantee {
  margin-top: var(--spacing-sm);
  padding-bottom: var(--spacing-xs);
}

.trial-guarantee-text {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  opacity: 0.7;
}

/* ================================================================
   Comparison Table
   ================================================================ */
.cmp-section {
  margin-bottom: var(--spacing-xl);
}

.cmp-section-title {
  font-size: var(--font-size-subhead);
  font-weight: 700;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: var(--spacing-md);
  text-align: center;
  letter-spacing: 2rpx;
}

.cmp-table {
  background: var(--color-surface-gradient);
  border: 1.5rpx solid rgba(244, 212, 140, 0.12);
  border-radius: 24rpx;
  overflow: hidden;
}

.cmp-row {
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid rgba(244, 212, 140, 0.06);
}

.cmp-row:last-child {
  border-bottom: none;
}

.cmp-row--header {
  background: rgba(244, 212, 140, 0.06);
}

.cmp-cell {
  flex: 1;
  padding: var(--spacing-sm) var(--spacing-xs);
  font-size: var(--font-size-caption);
  text-align: center;
  line-height: 1.4;
}

.cmp-cell--label {
  flex: 1.4;
  text-align: left;
  padding-left: var(--spacing-md);
  color: var(--color-text-primary);
  font-weight: 500;
}

.cmp-cell--free {
  color: var(--color-text-tertiary);
}

.cmp-cell--pro {
  color: var(--color-gold);
  font-weight: 600;
}

.cmp-cell--no {
  opacity: 0.4;
}

.cmp-row--header .cmp-cell--label {
  color: var(--color-text-tertiary);
  font-weight: 400;
  font-size: 22rpx;
}

.cmp-row--header .cmp-cell--free,
.cmp-row--header .cmp-cell--pro {
  font-weight: 700;
  font-size: var(--font-size-caption);
}

.cmp-row--header .cmp-cell--free {
  color: var(--color-text-tertiary);
}

.cmp-row--header .cmp-cell--pro {
  color: var(--color-gold);
}

/* ---- Savings Row ---- */
.cmp-row--savings {
  background: linear-gradient(90deg, rgba(244, 212, 140, 0.08) 0%, rgba(244, 212, 140, 0.03) 100%);
  border-top: 1.5rpx solid rgba(244, 212, 140, 0.15);
  position: relative;
}

.cmp-row--savings .cmp-cell--label {
  color: var(--color-gold);
  font-weight: 700;
  font-size: var(--font-size-caption);
}

.cmp-cell--savings,
.cmp-cell--savings-pro {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: var(--spacing-xs) var(--spacing-xxs);
}

.savings-item {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  line-height: 1.4;
}

.savings-item-s {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  line-height: 1.4;
}

.savings-highlight {
  color: var(--color-gold);
  font-weight: 700;
}

.cmp-cell--savings-pro .savings-item {
  color: var(--color-gold);
  font-weight: 600;
}

/* ================================================================
   Pricing Section
   ================================================================ */
.pricing-section {
  margin-bottom: var(--spacing-xl);
}

.pricing-section-title {
  font-size: var(--font-size-subhead);
  font-weight: 700;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: var(--spacing-md);
  text-align: center;
  letter-spacing: 2rpx;
}

/* ---- Base Card ---- */
.pricing-card {
  position: relative;
  background: var(--color-surface-gradient);
  border: 1.5rpx solid rgba(244, 212, 140, 0.12);
  border-radius: 24rpx;
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-md);
  text-align: center;
  transition: transform 0.2s, border-color 0.2s;
  overflow: hidden;
}

.pricing-card:active {
  transform: scale(0.97);
  border-color: var(--color-gold-glow-strong);
}

/* Golden top accent */
.pricing-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(
    90deg,
    transparent 0%,
    var(--color-gold-glow) 30%,
    rgba(212, 175, 55, 0.3) 50%,
    var(--color-gold-glow) 70%,
    transparent 100%
  );
  pointer-events: none;
}

/* ---- Recommended Card ---- */
.pricing-card--rec {
  border-color: rgba(244, 212, 140, 0.35);
  background: linear-gradient(145deg, #2A2A5A 0%, #353570 100%);
  box-shadow: 0 4rpx 30rpx rgba(244, 212, 140, 0.12);
}

.pricing-card--rec::before {
  background: linear-gradient(
    90deg,
    transparent 0%,
    var(--color-gold-light) 30%,
    var(--color-gold) 50%,
    var(--color-gold-light) 70%,
    transparent 100%
  );
  height: 4rpx;
}

.pricing-card-badge {
  position: absolute;
  top: -14rpx;
  right: 32rpx;
  background: linear-gradient(135deg, #F4D48C, #E8C67A);
  color: #1A1A3E;
  font-size: 20rpx;
  font-weight: 700;
  padding: 6rpx var(--spacing-sm);
  border-radius: 20rpx;
  letter-spacing: 1rpx;
  box-shadow: 0 2rpx 12rpx rgba(244, 212, 140, 0.35);
}

/* ---- Student Card ---- */
.pricing-card--student {
  border-color: rgba(184, 169, 224, 0.2);
  background: linear-gradient(145deg, #252548 0%, #2A2A55 100%);
}

.pricing-card--student::before {
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(184, 169, 224, 0.3) 30%,
    var(--color-lavender) 50%,
    rgba(184, 169, 224, 0.3) 70%,
    transparent 100%
  );
}

.pricing-card-student-badge {
  font-size: var(--font-size-xs);
  color: var(--color-lavender);
  font-weight: 600;
  padding: 4rpx var(--spacing-xs);
  background: rgba(184, 169, 224, 0.1);
  border-radius: var(--radius-pill);
  display: inline-block;
  margin-bottom: var(--spacing-xs);
}

.pricing-card-student-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-xs);
  margin-bottom: 4rpx;
}

.pricing-card-student-sub {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}

/* ---- Card Content ---- */
.pricing-card-name {
  font-size: var(--font-size-subhead);
  font-weight: 700;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: var(--spacing-xs);
}

.pricing-card-price-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 2rpx;
  margin-bottom: 4rpx;
}

.pricing-card-currency {
  font-size: var(--font-size-body);
  color: var(--color-gold);
  font-weight: 600;
}

.pricing-card-amount {
  font-size: 56rpx;
  font-weight: 800;
  color: var(--color-gold);
  line-height: 1;
}

.pricing-card-period {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  margin-left: 4rpx;
}

.pricing-card-daily {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  display: block;
  margin-bottom: 4rpx;
}

.pricing-card-save {
  font-size: var(--font-size-xs);
  color: var(--color-success);
  font-weight: 500;
  display: inline-block;
  margin-bottom: var(--spacing-md);
  background: rgba(123, 198, 160, 0.1);
  padding: 4rpx var(--spacing-xs);
  border-radius: var(--radius-pill);
}

.pricing-card-original {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  text-decoration: line-through;
  margin-right: var(--spacing-xs);
  opacity: 0.6;
}

/* ---- CTA Button ---- */
.pricing-card-btn {
  display: block;
  width: 80%;
  margin: var(--spacing-sm) auto 0;
  padding: var(--spacing-sm) 0;
  border: none;
  border-radius: var(--radius-pill);
  font-size: var(--font-size-body);
  font-weight: 700;
  color: var(--color-text-inverse);
  background: linear-gradient(135deg, #F4D48C, #E8C67A);
  box-shadow: 0 4rpx 28rpx rgba(244, 212, 140, 0.35), inset 0 1rpx 0 rgba(255, 255, 255, 0.3);
  transition: transform 0.15s ease-out, box-shadow 0.15s ease-out;
  letter-spacing: 2rpx;
}

.pricing-card-btn::after {
  border: none;
}

.pricing-card-btn:active {
  transform: scale(0.96);
  box-shadow: 0 2rpx 12rpx rgba(244, 212, 140, 0.25);
}

.pricing-card-btn--secondary {
  background: transparent;
  color: var(--color-gold);
  border: 1.5rpx solid rgba(244, 212, 140, 0.3);
  box-shadow: none;
}

.pricing-card-btn--secondary:active {
  background: rgba(244, 212, 140, 0.08);
}

.pricing-card-btn--student {
  background: transparent;
  color: var(--color-lavender);
  border: 1.5rpx solid rgba(184, 169, 224, 0.3);
  box-shadow: none;
}

.pricing-card-btn--student:active {
  background: rgba(184, 169, 224, 0.08);
}

/* ================================================================
   补充包 — Reading Pack Cards
   ================================================================ */
.pack-section {
  margin-bottom: var(--spacing-xl);
}

.pack-section-sub {
  display: block;
  text-align: center;
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  margin-bottom: var(--spacing-md);
  letter-spacing: 2rpx;
}

.pack-card {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  position: relative;
  background: var(--color-surface-gradient);
  border: 1.5rpx solid rgba(244, 212, 140, 0.10);
  border-radius: 24rpx;
  padding: var(--spacing-md);
  margin-bottom: var(--spacing-sm);
  transition: transform 0.2s, border-color 0.2s;
  overflow: hidden;
}

.pack-card:active {
  transform: scale(0.97);
  border-color: var(--color-gold-glow-strong);
}

.pack-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(244, 212, 140, 0.15), transparent);
  pointer-events: none;
}

.pack-card--best {
  border-color: rgba(244, 212, 140, 0.25);
  background: linear-gradient(145deg, #2A2A5A 0%, #353570 100%);
}

.pack-card--best::before {
  height: 3rpx;
  background: linear-gradient(90deg, transparent, var(--color-gold-glow-strong) 30%, var(--color-gold) 50%, var(--color-gold-glow-strong) 70%, transparent);
}

.pack-card-badge {
  position: absolute;
  top: -12rpx;
  right: 24rpx;
  background: linear-gradient(135deg, #F4D48C, #E8C67A);
  color: #1A1A3E;
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx var(--spacing-xs);
  border-radius: 20rpx;
  letter-spacing: 1rpx;
  box-shadow: 0 2rpx 12rpx rgba(244, 212, 140, 0.35);
}

.pack-card-left {
  flex: 1;
  min-width: 0;
}

.pack-card-name {
  font-size: var(--font-size-body);
  font-weight: 700;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: 4rpx;
}

.pack-card-tag {
  display: inline-block;
  font-size: 20rpx;
  color: var(--color-gold);
  background: rgba(244, 212, 140, 0.10);
  padding: 2rpx 12rpx;
  border-radius: var(--radius-pill);
  letter-spacing: 1rpx;
}

.pack-card-right {
  text-align: right;
  margin-right: var(--spacing-sm);
  flex-shrink: 0;
}

.pack-card-price-row {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  gap: 2rpx;
}

.pack-card-currency {
  font-size: var(--font-size-caption);
  color: var(--color-gold);
  font-weight: 600;
}

.pack-card-amount {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--color-gold);
  line-height: 1;
}

.pack-card-unit {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  display: block;
  margin-top: 2rpx;
}

.pack-card-btn {
  width: 100%;
  margin-top: var(--spacing-sm);
  padding: var(--spacing-xs) 0;
  border: 1.5rpx solid rgba(244, 212, 140, 0.25);
  border-radius: var(--radius-pill);
  font-size: var(--font-size-caption);
  font-weight: 600;
  color: var(--color-gold);
  background: transparent;
  letter-spacing: 2rpx;
  transition: transform 0.15s, background 0.15s;
}

.pack-card-btn::after {
  border: none;
}

.pack-card-btn:active {
  background: rgba(244, 212, 140, 0.08);
  transform: scale(0.96);
}

.pack-card-btn--primary {
  background: linear-gradient(135deg, #F4D48C, #E8C67A);
  color: var(--color-text-inverse);
  border: none;
  box-shadow: 0 4rpx 20rpx rgba(244, 212, 140, 0.25);
}

.pack-card-btn--primary:active {
  background: linear-gradient(135deg, #E8C67A, #D4B06A);
}

.pack-detail-link {
  text-align: center;
  padding: var(--spacing-sm) 0;
}

.pack-detail-link:active {
  opacity: 0.7;
}

.pack-detail-text {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  letter-spacing: 2rpx;
}

/* ================================================================
   星光好物 — Shop / E-commerce Section
   ================================================================ */
.shop-section {
  margin-bottom: var(--spacing-xl);
}

.shop-section-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-xs);
  margin-bottom: var(--spacing-xxs);
}

.shop-section-badge {
  font-size: var(--font-size-xs);
  color: var(--color-success);
  background: var(--color-success-bg);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-pill);
  letter-spacing: 1rpx;
}

.shop-section-sub {
  display: block;
  text-align: center;
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  margin-bottom: var(--spacing-md);
  letter-spacing: 2rpx;
}

.shop-grid {
  display: flex;
  gap: var(--spacing-sm);
}

.shop-card {
  flex: 1;
  background: var(--color-surface-gradient);
  border: 1.5rpx solid rgba(244, 212, 140, 0.10);
  border-radius: 20rpx;
  padding: var(--spacing-sm);
  text-align: center;
  transition: transform 0.2s, border-color 0.2s;
  overflow: hidden;
}

.shop-card:active {
  transform: scale(0.96);
  border-color: rgba(244, 212, 140, 0.25);
}

.shop-card-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 16rpx;
  background: rgba(244, 212, 140, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto var(--spacing-xs);
}

.shop-card-img-icon {
  font-size: 48rpx;
}

.shop-card-name {
  font-size: var(--font-size-caption);
  font-weight: 700;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: 4rpx;
  letter-spacing: 1rpx;
}

.shop-card-desc {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  display: block;
  margin-bottom: var(--spacing-xs);
  line-height: 1.4;
}

.shop-card-bottom {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-xxs);
  flex-wrap: wrap;
}

.shop-card-price {
  font-size: var(--font-size-caption);
  font-weight: 700;
  color: var(--color-gold);
}

.shop-card-badge-item {
  font-size: var(--font-size-xs);
  color: var(--color-success);
  background: var(--color-success-bg);
  padding: 2rpx 8rpx;
  border-radius: var(--radius-pill);
}

.shop-reserve-area {
  text-align: center;
  margin-top: var(--spacing-lg);
  padding: var(--spacing-md);
  background: rgba(244, 212, 140, 0.04);
  border: 1rpx solid rgba(244, 212, 140, 0.10);
  border-radius: 20rpx;
}

.shop-reserve-text {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  display: block;
  margin-bottom: var(--spacing-sm);
  letter-spacing: 2rpx;
}

.shop-reserve-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 300rpx;
  padding: var(--spacing-sm) var(--spacing-lg);
  background: linear-gradient(135deg, #F4D48C 0%, #E8C67A 50%, #D4B06A 100%);
  color: #1A1A3E;
  font-size: var(--font-size-caption);
  font-weight: 700;
  border: none;
  border-radius: var(--radius-pill);
  letter-spacing: 2rpx;
  box-shadow: 0 4rpx 20rpx rgba(244, 212, 140, 0.25);
}

.shop-reserve-btn::after {
  border: none;
}

.shop-reserve-btn:active {
  transform: scale(0.96);
  box-shadow: 0 2rpx 12rpx rgba(244, 212, 140, 0.15);
}

/* ================================================================
   Footer Guarantee
   ================================================================ */
.mem-footer {
  text-align: center;
  padding: var(--spacing-lg) var(--spacing-lg) var(--spacing-2xl);
}
.mem-footer-text {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  opacity: 0.5;
}

/* ================================================================
   Skeleton — Shapes only (shimmer from common.wxss)
   ================================================================ */
.skeleton-mem-wrap {
  padding: var(--spacing-xl) 0;
}

.skeleton-hero-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-2xl);
}

.skeleton-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 100%;
}

.skeleton-line {
  height: 32rpx;
  border-radius: var(--radius-sm);
}

.skeleton-line.wide { width: 300rpx; }
.skeleton-line.medium { width: 200rpx; }

.skeleton-benefits,
.skeleton-product {
  width: 100%;
  border-radius: var(--radius-lg);
}

.skeleton-benefits { height: 280rpx; margin-bottom: var(--spacing-xl); }
.skeleton-product { height: 380rpx; margin-bottom: var(--spacing-md); }

/* ================================================================
   Staggered entrance
   ================================================================ */
.anim-fade-in-up-1 { opacity: 0; animation: fade-up 0.4s ease-out 0.05s forwards; }
.anim-fade-in-up-2 { opacity: 0; animation: fade-up 0.4s ease-out 0.10s forwards; }
.anim-fade-in-up-3 { opacity: 0; animation: fade-up 0.4s ease-out 0.15s forwards; }
.anim-fade-in-up-4 { opacity: 0; animation: fade-up 0.4s ease-out 0.20s forwards; }
.anim-fade-in-up-5 { opacity: 0; animation: fade-up 0.4s ease-out 0.25s forwards; }

@keyframes fade-up {
  0% {
    opacity: 0;
    transform: translateY(24rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ============================================================
   Payment Success Celebration Overlay
   ============================================================ */
.celebration-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(10, 10, 30, 0.92);
  z-index: var(--z-modal);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-lg);
  animation: fade-in 0.3s ease-out;
}

.celebration-card {
  position: relative;
  width: 100%;
  max-width: 540rpx;
  background: linear-gradient(145deg, #2A2A5A 0%, #353570 100%);
  border: 2rpx solid rgba(244, 212, 140, 0.30);
  border-radius: 32rpx;
  padding: var(--spacing-2xl) var(--spacing-lg) var(--spacing-xl);
  text-align: center;
  overflow: hidden;
  animation: celebration-enter 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
}

@keyframes celebration-enter {
  0% { opacity: 0; transform: scale(0.85) translateY(30rpx); }
  100% { opacity: 1; transform: scale(1) translateY(0); }
}

.celebration-stars {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  pointer-events: none;
}

.celebration-star {
  position: absolute;
  font-size: 36rpx;
  color: var(--color-gold);
  text-shadow: 0 0 20rpx rgba(244, 212, 140, 0.6);
  animation: star-burst 0.8s ease-out forwards;
}

.celebration-star-1 { top: 20rpx; left: 20%; animation-delay: 0.1s; }
.celebration-star-2 { top: 10rpx; left: 50%; animation-delay: 0.2s; }
.celebration-star-3 { top: 20rpx; right: 20%; animation-delay: 0.3s; }

@keyframes star-burst {
  0% { opacity: 0; transform: scale(0.05) rotate(-30deg); }
  50% { opacity: 1; transform: scale(1.3) rotate(10deg); }
  100% { opacity: 0.8; transform: scale(1) rotate(0deg); }
}

.celebration-icon {
  font-size: 72rpx;
  display: block;
  margin-bottom: var(--spacing-sm);
  animation: celebration-icon-bounce 0.6s ease-out 0.2s both;
}

@keyframes celebration-icon-bounce {
  0% { transform: scale(0.05); }
  50% { transform: scale(1.2); }
  100% { transform: scale(1); }
}

.celebration-title {
  font-size: var(--font-size-title);
  font-weight: 700;
  color: var(--color-gold);
  display: block;
  letter-spacing: 4rpx;
  margin-bottom: var(--spacing-xxs);
}

.celebration-sub {
  font-size: var(--font-size-caption);
  color: var(--color-lavender);
  display: block;
  margin-bottom: var(--spacing-lg);
  letter-spacing: 2rpx;
}

.celebration-benefits {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-lg);
  padding: var(--spacing-md);
  background: rgba(244, 212, 140, 0.06);
  border: 1rpx solid rgba(244, 212, 140, 0.12);
  border-radius: 20rpx;
}

.celebration-benefit {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  animation: benefit-slide-in 0.4s ease-out forwards;
  opacity: 0;
}
.celebration-benefit:nth-child(1) { animation-delay: 0.4s; }
.celebration-benefit:nth-child(2) { animation-delay: 0.5s; }
.celebration-benefit:nth-child(3) { animation-delay: 0.6s; }
.celebration-benefit:nth-child(4) { animation-delay: 0.7s; }

@keyframes benefit-slide-in {
  0% { opacity: 0; transform: translateX(-20rpx); }
  100% { opacity: 1; transform: translateX(0); }
}

.celebration-benefit-icon {
  font-size: 32rpx;
  width: 48rpx;
  text-align: center;
}

.celebration-benefit-text {
  font-size: var(--font-size-caption);
  color: var(--color-text-primary);
  font-weight: 500;
}

.celebration-hint {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  display: block;
  letter-spacing: 1rpx;
  animation: hint-pulse 1.5s ease-in-out infinite;
}

@keyframes hint-pulse {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 0.8; }
}

@keyframes fade-in {
  0% { opacity: 0; }
  100% { opacity: 1; }
}
