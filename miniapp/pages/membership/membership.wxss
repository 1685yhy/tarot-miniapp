/* ============================================================
   Membership — Warm Paper Design System
   Warm ivory base, deep rose accent, sage subtle
   Benefits list, product cards, pricing display
   ============================================================ */

/* -----------------------------------------------------------
   1. PAGE WRAPPER
   ----------------------------------------------------------- */

.page {
  padding: var(--page-padding);
  padding-bottom: calc(var(--page-padding) + var(--safe-area-bottom));
  min-height: 100vh;
}

/* -----------------------------------------------------------
   2. TYPOGRAPHY HELPERS
   ----------------------------------------------------------- */

.heading-1 {
  font-size: var(--font-size-display);
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
  text-align: center;
  line-height: var(--line-height-heading);
}

.heading-3 {
  font-size: var(--font-size-body-large);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  line-height: var(--line-height-heading);
}

.text-body {
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  line-height: var(--line-height-body);
}

.text-secondary {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
}

.text-dim {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  opacity: 0.70;
  display: block;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-col {
  flex-direction: column;
}

.gap-xs {
  gap: var(--spacing-2);
}

.mt-sm { margin-top: var(--spacing-4); }
.mt-xs { margin-top: var(--spacing-3); }

/* -----------------------------------------------------------
   3. ERROR STATE
   ----------------------------------------------------------- */

.error-state {
  text-align: center;
  padding: var(--spacing-8) var(--spacing-6);
}

.error-icon {
  width: 80rpx;
  height: 80rpx;
  display: block;
  margin: 0 auto var(--spacing-5);
  opacity: 0.30;
}

.error-text {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--spacing-3);
}

.error-hint {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--spacing-6);
  opacity: 0.70;
}

.btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-3);
  padding: var(--spacing-5) var(--spacing-7);
  border: none;
  border-radius: var(--radius-pill);
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-semibold);
  color: var(--color-surface);
  background: var(--color-accent);
  box-shadow: var(--shadow-subtle);
  transition: all var(--duration-feedback) ease;
}

.btn-primary:active {
  transform: scale(0.97);
  opacity: 0.90;
}

.btn-small {
  padding: var(--spacing-4) var(--spacing-6);
  font-size: var(--font-size-body);
}

/* -----------------------------------------------------------
   4. BENEFITS LIST
   ----------------------------------------------------------- */

.benefits {
  position: relative;
  border-radius: var(--radius-medium);
  padding: var(--spacing-6);
  margin-bottom: var(--spacing-6);
  background: var(--color-surface);
  border: 1rpx solid rgba(139, 126, 110, 0.12);
  box-shadow: var(--shadow-subtle);
  overflow: hidden;
}

.benefits::before {
  content: '';
  position: absolute;
  top: var(--spacing-5);
  left: 0;
  width: 3rpx;
  height: calc(100% - var(--spacing-7));
  background: var(--color-accent);
  border-radius: 0 2rpx 2rpx 0;
  opacity: 0.40;
}

.benefit-item {
  padding: var(--spacing-4) 0;
  padding-left: var(--spacing-7);
  padding-right: var(--spacing-4);
  border-bottom: 1rpx solid rgba(139, 126, 110, 0.08);
  position: relative;
}

.benefit-item:last-child {
  border-bottom: none;
}

.benefit-item::before {
  content: '';
  position: absolute;
  left: var(--spacing-4);
  top: 50%;
  transform: translateY(-50%);
  width: 12rpx;
  height: 12rpx;
  background: var(--color-accent);
  border-radius: var(--radius-pill);
  opacity: 0.50;
}

.benefit-item .text-body {
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  line-height: var(--line-height-body);
}

/* -----------------------------------------------------------
   5. PRODUCT CARDS
   ----------------------------------------------------------- */

.products {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-6);
}

.product-card {
  position: relative;
  border-radius: var(--radius-medium);
  padding: var(--spacing-6) var(--spacing-6) var(--spacing-7);
  text-align: center;
  background: var(--color-surface);
  border: 1rpx solid rgba(139, 126, 110, 0.12);
  box-shadow: var(--shadow-subtle);
  transition: all var(--duration-navigation) ease;
  overflow: hidden;
}

.product-card:active {
  border-color: rgba(176, 102, 80, 0.20);
  box-shadow: var(--shadow-medium);
  transform: translateY(-2rpx);
}

/* Top accent line */
.product-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: rgba(139, 126, 110, 0.15);
  pointer-events: none;
}

/* Recommended card */
.product-card.recommended {
  border-color: rgba(176, 102, 80, 0.15);
  box-shadow: var(--shadow-medium);
}

.product-card.recommended::before {
  background: var(--color-accent);
  height: 3rpx;
}

.recommended-badge {
  position: absolute;
  top: -14rpx;
  right: var(--spacing-6);
  background: var(--color-accent);
  color: var(--color-surface);
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-medium);
  letter-spacing: var(--letter-spacing-none);
  padding: 6rpx var(--spacing-5);
  border-radius: var(--radius-small);
  z-index: var(--z-card);
  box-shadow: var(--shadow-subtle);
}

/* -----------------------------------------------------------
   6. PRICE DISPLAY
   ----------------------------------------------------------- */

.product-price {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-3);
  margin: var(--spacing-4) 0 var(--spacing-3);
}

.price-symbol {
  font-size: var(--font-size-body-large);
  color: var(--color-accent);
  vertical-align: super;
  font-weight: var(--font-weight-medium);
}

.price-value {
  font-size: 64rpx;
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
  line-height: 1;
}

.price-original {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  text-decoration: line-through;
  margin-left: var(--spacing-3);
  vertical-align: baseline;
  opacity: 0.50;
}

/* -----------------------------------------------------------
   7. PURCHASE BUTTON
   ----------------------------------------------------------- */

.btn-purchase {
  display: block;
  width: 70%;
  margin: var(--spacing-5) auto 0;
  padding: var(--spacing-5) 0;
  border: none;
  border-radius: var(--radius-pill);
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-semibold);
  color: var(--color-surface);
  background: var(--color-accent);
  box-shadow: var(--shadow-subtle);
  transition: all var(--duration-feedback) ease;
  letter-spacing: var(--letter-spacing-none);
}

.btn-purchase:active {
  transform: scale(0.97);
  opacity: 0.90;
}

/* -----------------------------------------------------------
   8. GUARANTEE
   ----------------------------------------------------------- */

.guarantee {
  text-align: center;
  padding: var(--spacing-7) 0;
  position: relative;
}

.guarantee::before {
  content: '';
  display: block;
  width: 80rpx;
  height: 1rpx;
  background: rgba(139, 126, 110, 0.15);
  margin: 0 auto var(--spacing-6);
}

.guarantee-text {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  line-height: var(--line-height-body);
}

/* -----------------------------------------------------------
   9. SKELETON
   ----------------------------------------------------------- */

.skeleton {
  padding: var(--spacing-6) 0;
}

.skeleton-hero-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-4);
  margin-bottom: var(--spacing-7);
}

.skeleton-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-pill);
  background: rgba(139, 126, 110, 0.08);
  animation: pulse-soft 1500ms ease-in-out infinite;
}

.skeleton-line {
  height: 32rpx;
  border-radius: var(--radius-small);
  background: rgba(139, 126, 110, 0.08);
  animation: pulse-soft 1500ms ease-in-out infinite;
}

.skeleton-line.wide { width: 300rpx; }
.skeleton-line.medium { width: 200rpx; }

.skeleton-benefits,
.skeleton-product {
  width: 100%;
  border-radius: var(--radius-medium);
  background: rgba(139, 126, 110, 0.08);
  animation: pulse-soft 1500ms ease-in-out infinite;
}

.skeleton-benefits { height: 280rpx; margin-bottom: var(--spacing-6); }
.skeleton-product { height: 380rpx; margin-bottom: var(--spacing-5); }

/* -----------------------------------------------------------
   10. ENTRANCE ANIMATIONS
   ----------------------------------------------------------- */

.anim-fade-in-up-1 { opacity: 0; animation: fade-up var(--duration-emphasis) ease 0.05s forwards; }
.anim-fade-in-up-2 { opacity: 0; animation: fade-up var(--duration-emphasis) ease 0.10s forwards; }
.anim-fade-in-up-3 { opacity: 0; animation: fade-up var(--duration-emphasis) ease 0.15s forwards; }
.anim-fade-in-up-4 { opacity: 0; animation: fade-up var(--duration-emphasis) ease 0.20s forwards; }
.anim-fade-in-up-5 { opacity: 0; animation: fade-up var(--duration-emphasis) ease 0.25s forwards; }
