<!-- pages/membership/membership.wxml -->
<view class="page">
  <!-- ===== 加载骨架 ===== -->
  <view wx:if="{{pageLoading}}">
    <view class="skeleton">
      <view class="skeleton-hero-area">
        <view class="skeleton-icon"></view>
        <view class="skeleton-line wide"></view>
        <view class="skeleton-line medium"></view>
      </view>
      <view class="skeleton-benefits"></view>
      <view class="skeleton-product"></view>
      <view class="skeleton-product"></view>
    </view>
  </view>

  <!-- ===== 错误状态 ===== -->
  <view wx:elif="{{pageError}}" class="error-state">
    <view class="error-icon" style="width:64rpx;height:64rpx;border-radius:50%;background:linear-gradient(135deg,var(--color-purple),var(--color-gold));margin:0 auto 24rpx"></view>
    <text class="error-text">会员信息暂时无法获取</text>
    <text class="error-hint">{{pageError}}</text>
    <button class="btn-primary btn-small" bindtap="onRetry"><image class="btn-icon" src="/images/icons/refresh.png" mode="aspectFit" /><text>重新加载</text></button>
  </view>

  <!-- ===== 主内容 ===== -->
  <view wx:else>
    <!-- Hero -->
    <view class="flex-center flex-col" style="padding:var(--space-xxxl) 0 var(--space-lg)">
      <view style="width:72rpx;height:72rpx;border-radius:50%;background:linear-gradient(135deg,var(--color-purple),var(--color-gold));margin:0 auto" class="anim-float"></view>
      <text class="heading-1 mt-sm">开通会员</text>
      <text class="text-secondary mt-xs">解锁无限卡牌解读</text>
    </view>

    <!-- Benefits -->
    <view class="benefits anim-fade-in-up-1">
      <view class="benefit-item" wx:for="{{['全部牌阵无限使用','AI追问不限次数','年度运势报告','每日多次抽牌','专属运势卡片']}}" wx:key="*this">
        <text class="text-body">{{item}}</text>
      </view>
    </view>

    <!-- Product cards -->
    <view class="products" wx:if="{{products.length > 0}}">
      <view
        class="product-card {{item.id === 'membership_yearly' ? 'recommended' : ''}} anim-fade-in-up-{{index + 2}}"
        wx:for="{{products}}"
        wx:key="id"
        wx:for-index="index"
        data-product="{{item}}"
        bindtap="onPurchase"
      >
        <view class="recommended-badge" wx:if="{{item.id === 'membership_yearly'}}">
          <text>最受欢迎</text>
        </view>
        <text class="heading-3" style="color:var(--color-text-primary)">{{item.name}}</text>
        <view class="product-price flex-center gap-xs" style="margin:var(--space-md) 0 var(--space-xs)">
          <text class="price-symbol">¥</text>
          <text class="price-value">{{item.price}}</text>
        </view>
        <text class="text-dim" style="font-size:var(--fs-body-small);display:block" wx:if="{{item.id === 'membership_monthly'}}">/月</text>
        <text class="text-dim" style="font-size:var(--fs-body-small);display:block" wx:elif="{{item.id === 'membership_yearly'}}">/年 每天仅{{item.pricePerDay}}元</text>
        <text class="text-dim" style="font-size:var(--fs-body-small);display:block" wx:elif="{{item.id === 'membership_lifetime'}}">永久有效</text>
        <text class="text-dim" style="font-size:var(--fs-body-small);display:block" wx:elif="{{item.id === 'annual_report'}}">年度报告</text>
      </view>
    </view>

    <!-- Guarantee -->
    <view class="guarantee">
      <text class="guarantee-text">支付安全 · 随时可查 · 会员期内无限使用</text>
    </view>
  </view>
</view>
