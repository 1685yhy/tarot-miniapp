<!-- pages/membership/membership.wxml -->
<view class="page">
  <!-- ===== 加载 ===== -->
  <view wx:if="{{pageLoading}}" class="skeleton-mem-wrap">
    <view class="skeleton-hero-area">
      <view class="skeleton skeleton-icon"></view>
      <view class="skeleton skeleton-line wide"></view>
    </view>
    <view class="skeleton skeleton-product"></view>
    <view class="skeleton skeleton-product"></view>
  </view>

  <!-- ===== 错误 ===== -->
  <view wx:elif="{{pageError}}" class="error-state">
    <text class="error-text">会员信息暂时无法获取</text>
    <text class="error-hint">{{pageError}}</text>
    <button class="btn-primary btn-small" bindtap="onRetry">重新加载</button>
  </view>

  <!-- ===== 主内容 ===== -->
  <view wx:else>
    <!-- Hero -->
    <view class="mem-hero">
      <image class="mem-hero-icon" src="/images/icons/star_64.png" mode="aspectFit" />
      <text class="mem-hero-title">星光会员</text>
      <text class="mem-hero-sub">解锁全部牌阵 · AI 无限解读</text>
    </view>

    <!-- 三级会员卡片 -->
    <view class="mem-tiers">
      <view
        class="mem-tier {{item.recommended ? 'mem-tier--rec' : ''}}"
        wx:for="{{products}}" wx:key="id"
        wx:if="{{item.type === 'membership'}}"
        data-product="{{item}}"
        bindtap="onPurchase"
      >
        <view class="mem-tier-badge" wx:if="{{item.recommended}}">最受欢迎</view>

        <text class="mem-tier-name">{{item.name}}</text>

        <view class="mem-tier-price">
          <text class="mem-tier-currency">¥</text>
          <text class="mem-tier-amount">{{item.price}}</text>
          <text class="mem-tier-period" wx:if="{{item.id === 'membership_monthly'}}">/月</text>
          <text class="mem-tier-period" wx:elif="{{item.id === 'membership_yearly'}}">/年</text>
          <text class="mem-tier-period" wx:elif="{{item.id === 'membership_lifetime'}}">永久</text>
        </view>

        <text class="mem-tier-daily" wx:if="{{item.id === 'membership_yearly'}}">日均 ¥{{item.pricePerDay}}</text>

        <!-- 权益 -->
        <view class="mem-tier-features">
          <view class="mem-feat">
            <text class="mem-feat-icon">🔮</text>
            <text class="mem-feat-text">{{item.daily_readings === -1 ? '无限' : item.daily_readings + '次/天'}} 解读</text>
          </view>
          <view class="mem-feat">
            <text class="mem-feat-icon">💬</text>
            <text class="mem-feat-text">AI追问 {{item.unlimited_chat ? '无限' : '3次/天'}}</text>
          </view>
          <view class="mem-feat">
            <text class="mem-feat-icon">🃏</text>
            <text class="mem-feat-text">全部牌阵</text>
          </view>
          <view class="mem-feat" wx:if="{{item.annual_report}}">
            <text class="mem-feat-icon">📊</text>
            <text class="mem-feat-text">年度报告</text>
          </view>
        </view>

        <view class="mem-tier-cta">立即开通</view>
      </view>
    </view>

    <!-- 单次购买 -->
    <view class="mem-single" wx:for="{{products}}" wx:key="id" wx:if="{{item.type === 'single_purchase'}}">
      <view class="mem-single-card" data-product="{{item}}" bindtap="onPurchase">
        <text class="mem-single-name">{{item.name}}</text>
        <text class="mem-single-price">¥{{item.price}}</text>
      </view>
    </view>

    <!-- 底部保证 -->
    <view class="mem-footer">
      <text class="mem-footer-text">🔒 支付安全 · 随时可查 · 自动续费可关</text>
    </view>
  </view>
</view>
