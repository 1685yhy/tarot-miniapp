<!-- pages/membership/membership.wxml -->
<view class="page">
  <!-- ===== 加载 ===== -->
  <view wx:if="{{pageLoading}}" class="skeleton-mem-wrap">
    <view class="skeleton-hero-area">
      <view class="skeleton skeleton-icon"></view>
      <view class="skeleton skeleton-line wide"></view>
    </view>
    <view class="skeleton skeleton-product"></view>
    <view class="skeleton skeleton-product"></view>
  </view>

  <!-- ===== 错误 ===== -->
  <view wx:elif="{{pageError}}" class="error-state">
    <text class="error-text">会员信息暂时无法获取</text>
    <text class="error-hint">{{pageError}}</text>
    <button class="btn-primary btn-small" bindtap="onRetry">重新加载</button>
  </view>

  <!-- ===== 主内容 ===== -->
  <view wx:else>
    <!-- Hero -->
    <view class="mem-hero">
      <image class="mem-hero-icon" src="/images/icons/star_64.png" mode="aspectFit" aria-label="星光会员" />
      <text class="mem-hero-title">星光会员</text>
      <text class="mem-hero-sub">解锁全部牌阵 · AI 无限解读</text>
    </view>

    <!-- ===== 免费试用横幅 ===== -->
    <view class="free-trial-banner">
      <view class="trial-icon-wrap">
        <text class="trial-icon">✨</text>
      </view>
      <text class="trial-title">先体验，再决定</text>
      <text class="trial-sub">7天免费试用 · 无需付费 · 随时取消</text>
      <button class="trial-btn" bindtap="onStartTrial">免费试用 7 天</button>
      <view class="trial-guarantee">
        <text class="trial-guarantee-text">试用期结束前不会扣费，无需绑定支付方式</text>
      </view>
    </view>

    <!-- ===== 对比表: 免费 vs 会员 ===== -->
    <view class="cmp-section">
      <text class="cmp-section-title">免费 vs 会员</text>
      <view class="cmp-table">
        <!-- 表头 -->
        <view class="cmp-row cmp-row--header">
          <text class="cmp-cell cmp-cell--label"></text>
          <text class="cmp-cell cmp-cell--free">免费用户</text>
          <text class="cmp-cell cmp-cell--pro">会员</text>
        </view>
        <!-- 行: 每日解读 -->
        <view class="cmp-row" wx:for="{{comparisonRows}}" wx:key="label">
          <text class="cmp-cell cmp-cell--label">{{item.label}}</text>
          <text class="cmp-cell cmp-cell--free {{item.free === '✗' ? 'cmp-cell--no' : ''}}">{{item.free}}</text>
          <text class="cmp-cell cmp-cell--pro {{item.pro === '✗' ? 'cmp-cell--no' : ''}}">{{item.pro}}</text>
        </view>
        <!-- 已为你节省 -->
        <view class="cmp-row cmp-row--savings">
          <text class="cmp-cell cmp-cell--label">已为你节省</text>
          <view class="cmp-cell cmp-cell--savings">
            <text class="savings-item">月度：价值 {{comparisonSavings.monthly.value}}<text class="savings-highlight"> 省 {{comparisonSavings.monthly.save}}</text></text>
            <text class="savings-item">年度：价值 {{comparisonSavings.yearly.value}}<text class="savings-highlight"> 省 {{comparisonSavings.yearly.save}}</text></text>
          </view>
          <view class="cmp-cell cmp-cell--savings-pro">
            <text class="savings-item">无限次</text>
            <text class="savings-item-s">{{pricingYearly.displayDaily}}起</text>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== 定价方案 ===== -->
    <view class="pricing-section">
      <text class="pricing-section-title">选择方案</text>

      <!-- 年度 (推荐) -->
      <view class="pricing-card pricing-card--rec" data-product="{{pricingYearly}}" bindtap="onPurchase" role="button" aria-label="购买年度会员">
        <view class="pricing-card-badge">最受欢迎</view>
        <text class="pricing-card-name">年度会员</text>
        <view class="pricing-card-price-row">
          <text class="pricing-card-currency">¥</text>
          <text class="pricing-card-amount">{{pricingYearly.displayPrice}}</text>
          <text class="pricing-card-period">/年</text>
        </view>
        <text class="pricing-card-daily">日均{{pricingYearly.displayDaily}}</text>
        <text class="pricing-card-save">{{pricingYearly.displaySavingText}}</text>
        <button class="pricing-card-btn">开通年度</button>
      </view>

      <!-- 月度 -->
      <view class="pricing-card" data-product="{{pricingMonthly}}" bindtap="onPurchase" role="button" aria-label="购买月度会员">
        <text class="pricing-card-name">月度会员</text>
        <view class="pricing-card-price-row">
          <text class="pricing-card-currency">¥</text>
          <text class="pricing-card-amount">{{pricingMonthly.displayPrice}}</text>
          <text class="pricing-card-period">/月</text>
        </view>
        <button class="pricing-card-btn pricing-card-btn--secondary">开通月度</button>
      </view>

      <!-- 学生价 -->
      <view class="pricing-card pricing-card--student" data-product="{{pricingStudent}}" bindtap="onPurchase" role="button" aria-label="购买学生会员">
        <view class="pricing-card-student-badge">🎓 学生专享</view>
        <view class="pricing-card-student-header">
          <text class="pricing-card-name">学生会员</text>
          <text class="pricing-card-student-sub">需学生认证</text>
        </view>
        <view class="pricing-card-price-row">
          <text class="pricing-card-original">¥{{pricingStudent.displayOriginalPrice}}</text>
          <text class="pricing-card-currency">¥</text>
          <text class="pricing-card-amount">{{pricingStudent.displayPrice}}</text>
          <text class="pricing-card-period">/月</text>
        </view>
        <button class="pricing-card-btn pricing-card-btn--student">认证开通</button>
      </view>
    </view>

    <!-- ===== 补充包：一次性购买 ===== -->
    <view class="pack-section">
      <text class="pricing-section-title">深度解读包</text>
      <text class="pack-section-sub">一次性购买 · 永不过期 · 不限牌阵</text>

      <!-- 3次包 -->
      <view class="pack-card" data-product="{{pricingPack3}}" bindtap="onPurchasePack" role="button" aria-label="购买3次深度解读包">
        <view class="pack-card-left">
          <text class="pack-card-name">3次深度解读</text>
          <view class="pack-card-tag">一次性</view>
        </view>
        <view class="pack-card-right">
          <view class="pack-card-price-row">
            <text class="pack-card-currency">¥</text>
            <text class="pack-card-amount">{{pricingPack3.displayPrice}}</text>
          </view>
          <text class="pack-card-unit">{{pricingPack3.displayUnitPrice}}</text>
        </view>
        <button class="pack-card-btn" catchtap="onPurchasePack" data-product="{{pricingPack3}}">立即购买</button>
      </view>

      <!-- 10次包（超值） -->
      <view class="pack-card pack-card--best" data-product="{{pricingPack10}}" bindtap="onPurchasePack" role="button" aria-label="购买10次深度解读包">
        <view class="pack-card-badge">超值</view>
        <view class="pack-card-left">
          <text class="pack-card-name">10次深度解读</text>
          <view class="pack-card-tag">永久有效</view>
        </view>
        <view class="pack-card-right">
          <view class="pack-card-price-row">
            <text class="pack-card-currency">¥</text>
            <text class="pack-card-amount">{{pricingPack10.displayPrice}}</text>
          </view>
          <text class="pack-card-unit">{{pricingPack10.displayUnitPrice}}</text>
        </view>
        <button class="pack-card-btn pack-card-btn--primary" catchtap="onPurchasePack" data-product="{{pricingPack10}}">立即购买</button>
      </view>

      <view class="pack-detail-link" bindtap="onPackDetail" role="button" aria-label="了解深度解读包详情">
        <text class="pack-detail-text">了解深度解读包 ›</text>
      </view>
    </view>

    <!-- ===== 星光好物（电商引流） ===== -->
    <view class="shop-section">
      <view class="shop-section-header">
        <text class="pricing-section-title">星光好物</text>
        <text class="shop-section-badge">即将上线</text>
      </view>
      <text class="shop-section-sub">把星光带回家 ✦ 实体周边陆续上架</text>

      <view class="shop-grid">
        <!-- 塔罗牌 -->
        <view class="shop-card" bindtap="onShopComingSoon" role="button" aria-label="查看实体塔罗牌，即将上线">
          <view class="shop-card-img">
            <text class="shop-card-img-icon">🃏</text>
          </view>
          <text class="shop-card-name">实体塔罗牌</text>
          <text class="shop-card-desc">78张AI原创限量版</text>
          <view class="shop-card-bottom">
            <text class="shop-card-price">¥88-168</text>
            <text class="shop-card-badge-item">即将上线</text>
          </view>
        </view>

        <!-- 水晶手串 -->
        <view class="shop-card" bindtap="onShopComingSoon" role="button" aria-label="查看星座水晶手串，即将上线">
          <view class="shop-card-img">
            <text class="shop-card-img-icon">📿</text>
          </view>
          <text class="shop-card-name">星座水晶手串</text>
          <text class="shop-card-desc">专属能量 · 十二星座</text>
          <view class="shop-card-bottom">
            <text class="shop-card-price">¥68-128</text>
            <text class="shop-card-badge-item">即将上线</text>
          </view>
        </view>

        <!-- 香薰蜡烛 -->
        <view class="shop-card" bindtap="onShopComingSoon" role="button" aria-label="查看塔罗香薰蜡烛，即将上线">
          <view class="shop-card-img">
            <text class="shop-card-img-icon">🕯️</text>
          </view>
          <text class="shop-card-name">塔罗香薰蜡烛</text>
          <text class="shop-card-desc">四元素系列 · 占卜仪式感</text>
          <view class="shop-card-bottom">
            <text class="shop-card-price">¥48-88</text>
            <text class="shop-card-badge-item">即将上线</text>
          </view>
        </view>
      </view>

      <view class="shop-reserve-area">
        <text class="shop-reserve-text">关注公众号「星光映照」获取上线通知</text>
        <button class="shop-reserve-btn" bindtap="onShopComingSoon">立即预约</button>
      </view>
    </view>

    <!-- 底部保证 -->
    <view class="mem-footer">
      <text class="mem-footer-text">🔒 支付安全 · 随时可查 · 自动续费可关</text>
    </view>

    <!-- ===== 支付成功庆祝浮层 ===== -->
    <view wx:if="{{showCelebration}}" class="celebration-overlay">
      <view class="celebration-card">
        <view class="celebration-stars">
          <view class="celebration-star celebration-star-1">✦</view>
          <view class="celebration-star celebration-star-2">✦</view>
          <view class="celebration-star celebration-star-3">✦</view>
        </view>
        <text class="celebration-icon">✨</text>
        <text class="celebration-title">支付成功！</text>
        <text class="celebration-sub">欢迎加入星光会员</text>
        <view class="celebration-benefits">
          <view class="celebration-benefit" wx:for="{{unlockedBenefits}}" wx:key="index">
            <text class="celebration-benefit-icon">{{item.icon}}</text>
            <text class="celebration-benefit-text">{{item.text}}</text>
          </view>
        </view>
        <text class="celebration-hint">正在跳转解读页面...</text>
      </view>
    </view>
  </view>
</view>
