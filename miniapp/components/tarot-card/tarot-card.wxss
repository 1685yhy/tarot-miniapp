/* ============================================================
   Tarot Card — Craft stylesheet
   Principle: the image is the content. The frame is silent.
   ============================================================ */

/* ---- Card Wrapper ---- */

.tarot-card-wrapper {
  position: relative;
  width: 280rpx;
  height: 460rpx;
  flex-shrink: 0;
}

/* ---- Card Body ---- */

.tarot-card {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  overflow: hidden;
  background: #1a1a1a;

  /* Frame: 1rpx solid warm taupe, no glow */
  border: 1rpx solid #e0d8cf;

  /* Single-level warm brown shadow */
  box-shadow: 0 4rpx 16rpx rgba(120, 100, 80, 0.18);
}

/* ---- Card Image — fills the card ---- */

.card-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  pointer-events: none;
}

/* ---- Text Overlay — dark strip at bottom ---- */

.card-text-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 10;
  pointer-events: none;
  padding: 16rpx 20rpx 18rpx;
  background: linear-gradient(
    to top,
    rgba(0, 0, 0, 0.72) 0%,
    rgba(0, 0, 0, 0.72) 60%,
    rgba(0, 0, 0, 0) 100%
  );
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.card-name-en {
  font-size: 20rpx;
  font-weight: 600;
  font-family: 'Georgia', 'Times New Roman', serif;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
  color: #fffdfa;
  line-height: 1.4;
}

.card-name-zh {
  font-size: 16rpx;
  font-weight: 400;
  letter-spacing: 3rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
  color: rgba(255, 253, 250, 0.7);
  line-height: 1.4;
}

/* ---- Position Badge ---- */

.position-badge {
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 10;
  pointer-events: none;
  padding: 3rpx 14rpx;
  border-radius: 20rpx;
  font-size: 14rpx;
  line-height: 1.4;
  white-space: nowrap;
}

.badge-upright {
  background: rgba(224, 216, 207, 0.12);
  border: 0.5rpx solid rgba(224, 216, 207, 0.25);
  color: #e0d8cf;
}

.badge-reversed {
  background: rgba(232, 160, 160, 0.12);
  border: 0.5rpx solid rgba(232, 160, 160, 0.25);
  color: #e8a0a0;
}

.position-icon {
  font-size: 14rpx;
}

.position-text {
  font-size: 14rpx;
  letter-spacing: 1rpx;
}

/* ---- Suit Indicator — 4rpx dot at top-right ---- */

.tarot-card.card-wands::before,
.tarot-card.card-cups::before,
.tarot-card.card-swords::before,
.tarot-card.card-pentacles::before,
.tarot-card.card-major::before {
  content: '';
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  z-index: 10;
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  pointer-events: none;
}

/* Wands — amber */
.tarot-card.card-wands::before {
  background: #d4a853;
}

/* Cups — rose */
.tarot-card.card-cups::before {
  background: #e8a0a0;
}

/* Swords — sage */
.tarot-card.card-swords::before {
  background: #a0b894;
}

/* Pentacles — gold */
.tarot-card.card-pentacles::before {
  background: #c9a04a;
}

/* Major Arcana — gold */
.tarot-card.card-major::before {
  background: #c9a04a;
}

/* ---- Reversed: rotate card + subtle rose border at bottom edge ---- */

.tarot-card-wrapper.reversed .tarot-card {
  transform: rotate(180deg);
  /* Subtle 2rpx rose border at bottom edge */
  border-bottom: 2rpx solid rgba(232, 160, 160, 0.5);
}

/* Keep suit indicator at visual top-right when reversed */
.tarot-card-wrapper.reversed .tarot-card::before {
  transform: rotate(180deg);
}

/* ---- FLIP ANIMATION ---- */

.tarot-card-wrapper.flipping .tarot-card {
  animation: card-flip 0.8s cubic-bezier(0.23, 1, 0.32, 1) forwards;
}

@keyframes card-flip {
  0%   { transform: scaleX(0); }
  50%  { transform: scaleX(0.08); }
  100% { transform: scaleX(1); }
}

.tarot-card-wrapper.flipping.reversed .tarot-card {
  animation: card-flip-reversed 0.8s cubic-bezier(0.23, 1, 0.32, 1) forwards;
}

@keyframes card-flip-reversed {
  0%   { transform: scaleX(0); }
  50%  { transform: scaleX(0.08); }
  100% { transform: scaleX(1) rotate(180deg); }
}

/* ---- Accessibility: reduced motion ---- */

@media (prefers-reduced-motion: reduce) {
  .tarot-card-wrapper.flipping .tarot-card {
    animation: none;
  }
}
