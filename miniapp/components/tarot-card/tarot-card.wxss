/* ==============================================================
   Tarot Card Component — Art Nouveau Gallery Frame
   The image is the artwork, the frame is the gallery.
   Asymmetrical copper filigree | Handmade-paper shadow
   ============================================================== */

/* ============================================================
   1. Base Container
   ============================================================ */

.tarot-card-wrapper {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  padding: 8rpx;
}

/* ============================================================
   2. Card — Art Nouveau Frame
   Organic asymmetrical corners, thin copper border
   ============================================================ */

.tarot-card {
  position: relative;
  width: 280rpx;
  height: 460rpx;
  /* Asymmetrical rounded corners — organic, hand-wrought feel */
  border-radius: 4rpx 18rpx 4rpx 18rpx;
  /* Thin copper border */
  border: 1.5rpx solid #BF7733;
  /* Warm brown shadow — card resting on handmade paper */
  box-shadow:
    0 2rpx 8rpx rgba(90, 60, 30, 0.10),
    0 8rpx 24rpx rgba(80, 55, 25, 0.07),
    0 20rpx 56rpx rgba(70, 45, 20, 0.04);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #1a1512;
  animation: card-appear 0.7s ease-out forwards;
  transition: transform 0.6s cubic-bezier(0.23, 1, 0.32, 1);
}

.tarot-card.card-reversed {
  transform: rotate(180deg);
}

/* ============================================================
   3. Botanical Corner Curls (Pseudo-elements)
   Tiny copper tendrils at top-right and bottom-left.
   A single quarter-circle arc suggests a curling vine.
   ============================================================ */

/* Top-right — curl spiralling inward */
.tarot-card::before {
  content: '';
  position: absolute;
  top: 2rpx;
  right: 2rpx;
  width: 20rpx;
  height: 20rpx;
  border: 1.5rpx solid rgba(191, 119, 51, 0.45);
  border-radius: 50%;
  border-bottom-color: transparent;
  border-left-color: transparent;
  transform: rotate(45deg);
  z-index: 5;
  pointer-events: none;
}

/* Bottom-left — mirror curl */
.tarot-card::after {
  content: '';
  position: absolute;
  bottom: 2rpx;
  left: 2rpx;
  width: 20rpx;
  height: 20rpx;
  border: 1.5rpx solid rgba(191, 119, 51, 0.45);
  border-radius: 50%;
  border-top-color: transparent;
  border-right-color: transparent;
  transform: rotate(45deg);
  z-index: 5;
  pointer-events: none;
}

/* ============================================================
   4. Card Image — Hero
   Fills inside the frame, behind the corner curls
   ============================================================ */

.card-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  border-radius: 3rpx 17rpx 3rpx 17rpx;
  pointer-events: none;
}

/* ============================================================
   5. Suit Gem — Tiny Colored Gem at Top-Left Corner
   Faceted shape, suit-specific hue
   ============================================================ */

.card-art::before {
  content: '';
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  width: 8rpx;
  height: 11rpx;
  border-radius: 2rpx 5rpx 5rpx 2rpx;
  z-index: 6;
  pointer-events: none;
  opacity: 0.8;
  /* Faceted shine */
  box-shadow: inset 0 1rpx 2rpx rgba(255, 255, 255, 0.25);
}

/* Wands: copper */
.tarot-card[class*="wands"] .card-art::before {
  background: #CD7F32;
}

/* Cups: soft lavender */
.tarot-card[class*="cups"] .card-art::before {
  background: #C9B8E8;
}

/* Swords: jade */
.tarot-card[class*="swords"] .card-art::before {
  background: #5B9E7A;
}

/* Pentacles: gold */
.tarot-card[class*="pentacles"] .card-art::before {
  background: #D4A843;
}

/* ============================================================
   6. Typography — Warm Olive, Text-Shadow for Elegance
   Colour evokes aged botanical plates.
   Shadow is a soft glow, not a readability crutch.
   ============================================================ */

.card-number {
  position: absolute;
  top: 14rpx;
  left: 28rpx;
  z-index: 5;
  font-size: 16rpx;
  color: #95956A;
  font-family: 'Georgia', serif;
  letter-spacing: 1rpx;
  line-height: 1.3;
  pointer-events: none;
  text-shadow: 0 0 6rpx rgba(80, 50, 20, 0.35);
}

.card-name-en {
  position: absolute;
  bottom: 34rpx;
  left: 0;
  right: 0;
  text-align: center;
  z-index: 5;
  font-size: 14rpx;
  color: #95956A;
  font-family: 'Georgia', serif;
  letter-spacing: 3rpx;
  text-transform: uppercase;
  pointer-events: none;
  text-shadow: 0 0 6rpx rgba(80, 50, 20, 0.35);
}

.card-name-zh {
  position: absolute;
  bottom: 14rpx;
  left: 0;
  right: 0;
  text-align: center;
  z-index: 5;
  font-size: 18rpx;
  color: #A0926B;
  font-family: 'STKaiti', 'KaiTi', serif;
  letter-spacing: 5rpx;
  font-weight: 400;
  pointer-events: none;
  text-shadow: 0 0 6rpx rgba(80, 50, 20, 0.35);
}

/* ============================================================
   7. Position Badge
   ============================================================ */

.position-badge {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 3rpx 12rpx;
  border-radius: 16rpx;
  font-size: 15rpx;
  position: absolute;
  bottom: 64rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 5;
  white-space: nowrap;
  pointer-events: none;
}

.badge-upright {
  background: rgba(40, 42, 38, 0.55);
  color: rgba(149, 149, 106, 0.65);
}

.badge-reversed {
  background: rgba(50, 35, 30, 0.55);
  color: rgba(205, 127, 50, 0.65);
}

.position-icon { font-size: 13rpx; }
.position-text { letter-spacing: 1rpx; }

/* ============================================================
   8. Reversed State — Copper Inner Glow at Bottom Edge
   A warm bloom rising from the lower edge, like lamplight
   through vellum. Uses .card-art::after to layer over the
   image without adding DOM elements.
   ============================================================ */

.card-reversed {
  border-color: rgba(191, 119, 51, 0.5);
}

/* Overlay gradient — copper glow concentrated at the base */
.card-reversed .card-art::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 90rpx;
  background: linear-gradient(to top, rgba(191, 119, 51, 0.09), transparent);
  z-index: 3;
  pointer-events: none;
  border-radius: 0 0 4rpx 18rpx;
}

/* ============================================================
   9. Major Arcana — Slightly Elevated Treatment
   ============================================================ */

.card-major {
  border-width: 2rpx;
  border-color: #BF7733;
}

.card-major .card-art::before {
  width: 11rpx;
  height: 14rpx;
  opacity: 0.9;
  background: #BF7733;
  box-shadow:
    0 0 6rpx rgba(191, 119, 51, 0.5),
    inset 0 1rpx 2rpx rgba(255, 255, 255, 0.25);
}

/* ============================================================
   10. Card Art Container / Fallback Zone
   Visible only when no image covers the card.
   ============================================================ */

.card-art {
  position: relative;
  width: 100%;
  height: 100%;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  background: radial-gradient(ellipse at 50% 50%, rgba(191, 119, 51, 0.04), transparent 70%);
}

/* Minimal fallback — suit icon centred */
.card-symbol {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 1;
  text-align: center;
  opacity: 0.3;
}

.card-symbol .minor-suit {
  font-size: 60rpx;
  font-weight: 200;
  display: block;
}

.card-symbol .minor-rank {
  font-size: 36rpx;
  font-weight: 300;
  display: block;
  margin-top: 8rpx;
}

.card-symbol .art-shape,
.card-symbol .art-accent,
.card-symbol .art-detail {
  display: none;
}

.star-field {
  display: none;
}

/* ============================================================
   11. Superseded Elements — Removed for Art Nouveau
   Kept to silence any template references.
   ============================================================ */

.reversed-label,
.card-aura,
.card-ornament-top,
.card-ornament-bottom {
  display: none;
}

/* ============================================================
   12. Keyframe Animations
   Soft fade-up with subtle scale
   ============================================================ */

@keyframes card-appear {
  0% {
    opacity: 0;
    transform: translateY(16rpx) scale(0.96);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}
