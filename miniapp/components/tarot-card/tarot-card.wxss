/* ==============================================================
   塔罗卡牌组件 v2.0 — 全78张CSS艺术系统
   神秘学高级感 · 深紫+金色 · 纯CSS插画
   ============================================================== */

/* ========== 1. 基础结构 ========== */

.tarot-card-wrapper {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  padding: 8rpx;
  transition: transform 0.6s cubic-bezier(0.23, 1, 0.32, 1);
}
.tarot-card-wrapper.reversed {
  animation: glow-pulse 3s ease-in-out infinite;
}

.tarot-card {
  position: relative;
  width: 280rpx;
  height: 460rpx;
  background: linear-gradient(160deg, #0a0a1a 0%, #16163a 40%, #1a1a3e 70%, #0d0d22 100%);
  border-radius: 16rpx;
  border: 3rpx solid;
  border-image: linear-gradient(135deg, #d4af37, #f5d680, #b8860b, #f5d680, #d4af37) 1;
  box-shadow: 0 0 20rpx rgba(212,175,55,0.25), 0 0 60rpx rgba(212,175,55,0.08), inset 0 0 30rpx rgba(212,175,55,0.05);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.8s cubic-bezier(0.23,1,0.32,1);
  animation: card-appear 0.8s ease-out forwards;
}
.tarot-card.card-reversed { transform: rotate(180deg); }

@keyframes card-appear {
  0% { opacity:0; transform:translateY(30rpx) scale(0.92); filter:brightness(0.6); }
  100% { opacity:1; transform:translateY(0) scale(1); filter:brightness(1); }
}
@keyframes glow-pulse {
  0%,100% { filter:drop-shadow(0 0 8rpx rgba(212,175,55,0.3)); }
  50% { filter:drop-shadow(0 0 20rpx rgba(212,175,55,0.6)); }
}
@keyframes twinkle {
  0%,100% { opacity:0.3; transform:scale(1); }
  50% { opacity:1; transform:scale(1.5); }
}
@keyframes float {
  0%,100% { transform:translateY(0); }
  50% { transform:translateY(-6rpx); }
}
@keyframes pulse-glow {
  0%,100% { opacity:0.5; transform:scale(1); }
  50% { opacity:0.9; transform:scale(1.08); }
}
@keyframes rotate-slow {
  from { transform:rotate(0deg); }
  to { transform:rotate(360deg); }
}
@keyframes drip {
  0%,100% { opacity:0.2; transform:translateY(0); }
  50% { opacity:0.6; transform:translateY(6rpx); }
}
@keyframes spark {
  0%,100% { opacity:0; transform:scale(0); }
  50% { opacity:0.8; transform:scale(1); }
}

/* ========== 2. 装饰元素 ========== */

.card-ornament-top, .card-ornament-bottom {
  position: absolute; left:0; right:0; height:6rpx; z-index:5;
  background: linear-gradient(90deg, transparent, #d4af37, #f5d680, #d4af37, transparent);
  opacity:0.8;
}
.card-ornament-top { top:0; }
.card-ornament-bottom { bottom:0; }

.card-number {
  position: absolute; top:18rpx; left:20rpx; z-index:5;
  font-size:20rpx; color:#d4af37; font-family:'Georgia',serif;
  letter-spacing:2rpx; opacity:0.7;
}

.card-art {
  flex:1; width:100%; display:flex; align-items:center; justify-content:center;
  position:relative; margin-top:36rpx; margin-bottom:8rpx; min-height:0;
}

/* 星空背景 */
.star-field {
  position:absolute; width:100%; height:100%; overflow:hidden;
  pointer-events:none;
}
.star {
  position:absolute; width:4rpx; height:4rpx; background:#fff;
  border-radius:50%; animation:twinkle 2.5s ease-in-out infinite;
}
.star.s1 { top:15%; left:20%; animation-delay:0s; }
.star.s2 { top:30%; left:70%; animation-delay:0.4s; width:3rpx; height:3rpx; }
.star.s3 { top:55%; left:30%; animation-delay:0.8s; }
.star.s4 { top:70%; left:65%; animation-delay:1.2s; width:5rpx; height:5rpx; opacity:0.8; }
.star.s5 { top:40%; left:45%; animation-delay:0.2s; width:3rpx; height:3rpx; }
.star.s6 { top:80%; left:25%; animation-delay:1.6s; }
.star.s7 { top:20%; left:55%; animation-delay:0.6s; width:5rpx; height:5rpx; opacity:0.6; }
.star.s8 { top:60%; left:80%; animation-delay:1.0s; width:3rpx; height:3rpx; }

/* 插画核心容器 */
.card-symbol {
  position:relative; width:160rpx; height:200rpx; z-index:2;
  display:flex; align-items:center; justify-content:center;
}
.card-symbol .art-shape,
.card-symbol .art-accent,
.card-symbol .art-detail {
  position:absolute; width:100%; height:100%; top:0; left:0;
  pointer-events:none;
}

/* 卡牌名称 */
.card-name-en {
  font-size:20rpx; color:#c8b060; font-family:'Georgia',serif;
  letter-spacing:3rpx; text-transform:uppercase; text-align:center;
  margin-bottom:2rpx; z-index:2;
  text-shadow:0 0 10rpx rgba(200,176,96,0.3);
}
.card-name-zh {
  font-size:26rpx; color:#f5e6b8; font-family:'STKaiti','KaiTi',serif;
  letter-spacing:4rpx; text-align:center; margin-bottom:10rpx;
  font-weight:500; z-index:2;
  text-shadow:0 0 12rpx rgba(245,230,184,0.2);
}

/* 位置徽章 */
.position-badge {
  display:flex; align-items:center; gap:6rpx;
  padding:4rpx 16rpx; border-radius:20rpx; font-size:20rpx;
  margin-bottom:26rpx; white-space:nowrap; z-index:2;
}
.badge-upright {
  background:linear-gradient(135deg,rgba(44,62,80,0.85),rgba(52,73,94,0.85));
  border:1rpx solid rgba(212,175,55,0.4); color:#d4af37;
}
.badge-reversed {
  background:linear-gradient(135deg,rgba(80,44,55,0.85),rgba(94,52,66,0.85));
  border:1rpx solid rgba(200,120,140,0.4); color:#e8a0b0;
}
.position-icon { font-size:16rpx; }
.position-text { letter-spacing:1rpx; }

.reversed-label {
  position:absolute; bottom:76rpx; right:-6rpx;
  font-size:16rpx; color:rgba(232,160,176,0.6);
  letter-spacing:2rpx; writing-mode:vertical-rl; z-index:2;
}

.tarot-card::before {
  content:''; position:absolute; top:6rpx; left:6rpx; right:6rpx; bottom:6rpx;
  border:1rpx solid rgba(212,175,55,0.15); border-radius:10rpx; pointer-events:none; z-index:3;
}

.card-aura {
  position:absolute; inset:0; border-radius:14rpx;
  background:radial-gradient(circle at 50% 40%, rgba(212,175,55,0.06) 0%, transparent 70%);
  pointer-events:none; z-index:1;
}

/* 逆位时的全局翻转修正 */
.card-reversed .card-symbol { transform:rotate(180deg); }
.card-reversed .card-name-en,
.card-reversed .card-name-zh { transform:rotate(180deg); }
.card-reversed .position-badge { transform:rotate(180deg); }
.card-reversed .reversed-label { transform:rotate(180deg); }


/* ================================================================
   3. 大阿尔卡纳 — 22张独特CSS插画
   ================================================================ */

/* ----- 0 愚者 · 太阳+悬崖 ----- */
.card-fool .card-symbol .art-shape {
  width:80rpx; height:80rpx; top:10rpx; left:40rpx;
  background:radial-gradient(circle at 40% 40%, #ffd700, #b8860b);
  border-radius:50%;
  box-shadow:0 0 50rpx rgba(255,215,0,0.5), 0 0 100rpx rgba(255,215,0,0.2);
  animation:pulse-glow 3s ease-in-out infinite;
}
.card-fool .card-symbol .art-shape::after {
  content:''; position:absolute; inset:-12rpx; border-radius:50%;
  border:2rpx solid rgba(255,215,0,0.25);
  animation:pulse-glow 3s ease-in-out infinite 0.5s;
}
.card-fool .card-symbol .art-accent {
  top:90rpx; left:20rpx; width:120rpx; height:60rpx;
  border-top:4rpx dotted rgba(212,175,55,0.3);
  box-shadow:0 10rpx 0 -4rpx rgba(212,175,55,0.08), 0 20rpx 0 -4rpx rgba(212,175,55,0.05);
  clip-path:polygon(20% 100%, 35% 30%, 50% 100%, 65% 20%, 80% 100%);
}
.card-fool .card-symbol .art-detail {
  border-bottom:6rpx solid #2a1a4a;
  bottom:0; top:auto; height:20rpx;
  box-shadow:0 -4rpx 0 rgba(212,175,55,0.15);
  clip-path:polygon(10% 0, 25% 100%, 40% 20%, 55% 100%, 70% 10%, 85% 100%, 95% 0);
}

/* ----- I 魔术师 · 无限符号+四元素 ----- */
.card-magician .card-symbol .art-shape {
  top:20rpx; left:10rpx; width:140rpx; height:100rpx;
  border:3rpx solid #d4af37; border-radius:50% 0 50% 0;
  background:radial-gradient(circle at 50% 50%, rgba(212,175,55,0.1), transparent);
  transform:rotate(45deg);
}
.card-magician .card-symbol .art-shape::after {
  content:''; position:absolute; top:20rpx; left:20rpx; width:100rpx; height:60rpx;
  border:2rpx solid rgba(212,175,55,0.3);
  border-radius:50% 0 50% 0; transform:rotate(-90deg);
}
.card-magician .card-symbol .art-accent {
  top:90rpx; height:2rpx; width:100rpx; left:30rpx;
  background:linear-gradient(90deg, transparent, #d4af37, transparent);
}
.card-magician .card-symbol .art-detail::before {
  content:''; position:absolute;
  box-shadow:
    30rpx 20rpx 0 0 #ff6b6b, 60rpx 20rpx 0 0 #4ecdc4,
    30rpx 40rpx 0 0 #ffe66d, 60rpx 40rpx 0 0 #a8e6cf;
  width:8rpx; height:8rpx; border-radius:50%;
  top:80rpx; left:20rpx; opacity:0.7;
}

/* ----- II 女祭司 · 月+卷轴 ----- */
.card-high-priestess .card-symbol .art-shape {
  width:70rpx; height:70rpx; top:10rpx; left:45rpx;
  border-radius:50%;
  background:radial-gradient(circle at 55% 45%, #e8e0f0, transparent 60%);
  box-shadow:
    10rpx 0 0 -4rpx #c8b8e8, 20rpx 0 0 -8rpx rgba(200,184,232,0.3);
  clip-path:polygon(50% 0%, 100% 0, 100% 100%, 50% 100%, 0 100%, 0 0);
  border:2rpx solid rgba(200,184,232,0.3);
}
.card-high-priestess .card-symbol .art-shape::after {
  content:''; position:absolute; top:10rpx; left:10rpx; width:30rpx; height:30rpx;
  border-radius:50%; box-shadow:20rpx 0 0 2rpx rgba(212,175,55,0.2);
}
.card-high-priestess .card-symbol .art-accent {
  top:90rpx; left:40rpx; width:80rpx; height:60rpx;
  border:2rpx solid rgba(200,184,232,0.3);
  border-radius:0 0 20rpx 20rpx;
  background:linear-gradient(180deg, transparent, rgba(200,184,232,0.05));
}
.card-high-priestess .card-symbol .art-detail {
  top:95rpx; left:45rpx; width:70rpx; height:50rpx;
  border:1rpx solid rgba(212,175,55,0.15);
  border-radius:4rpx;
  background:linear-gradient(180deg, transparent 30%, rgba(212,175,55,0.05) 30%, rgba(212,175,55,0.05) 32%, transparent 32%);
}

/* ----- III 女皇 · 皇冠+麦穗 ----- */
.card-empress .card-symbol .art-shape {
  top:10rpx; left:40rpx; width:80rpx; height:50rpx;
  clip-path:polygon(10% 100%, 25% 20%, 35% 50%, 50% 0%, 65% 50%, 75% 20%, 90% 100%);
  background:linear-gradient(180deg, #d4af37, #b8860b);
  box-shadow:0 10rpx 30rpx rgba(212,175,55,0.2);
}
.card-empress .card-symbol .art-shape::after {
  content:''; position:absolute; bottom:-10rpx; left:20rpx; width:40rpx; height:30rpx;
  background:radial-gradient(ellipse at 50% 0%, #d4af37 0%, transparent 70%);
  border-radius:50%;
}
.card-empress .card-symbol .art-accent::before {
  content:''; position:absolute; top:60rpx; left:10rpx; width:140rpx; height:30rpx;
  box-shadow:
    10rpx 0 0 0 rgba(144,238,144,0.2), 20rpx 2rpx 0 0 rgba(144,238,144,0.15),
    30rpx 0 0 0 rgba(144,238,144,0.25), 40rpx 3rpx 0 0 rgba(144,238,144,0.1),
    50rpx 0 0 0 rgba(144,238,144,0.2), 60rpx 2rpx 0 0 rgba(144,238,144,0.15),
    70rpx 0 0 0 rgba(144,238,144,0.2), 80rpx 1rpx 0 0 rgba(144,238,144,0.1),
    90rpx 0 0 0 rgba(144,238,144,0.2), 100rpx 3rpx 0 0 rgba(144,238,144,0.15),
    110rpx 0 0 0 rgba(144,238,144,0.2), 120rpx 2rpx 0 0 rgba(144,238,144,0.1);
  width:6rpx; height:6rpx; border-radius:50%;
}

/* ----- IV 皇帝 · 王座+公羊 ----- */
.card-emperor .card-symbol .art-shape {
  top:20rpx; left:30rpx; width:100rpx; height:90rpx;
  border:3rpx solid rgba(212,175,55,0.4);
  border-radius:20rpx 20rpx 6rpx 6rpx;
  background:linear-gradient(180deg, rgba(180,60,60,0.2), transparent);
}
.card-emperor .card-symbol .art-shape::after {
  content:''; position:absolute; top:-10rpx; left:-6rpx; width:30rpx; height:30rpx;
  border-radius:50% 50% 0 0;
  box-shadow:
    52rpx 0 0 0 rgba(212,175,55,0.2);
  border:2rpx solid rgba(212,175,55,0.2); border-bottom:none;
  background:radial-gradient(circle at 50% 100%, rgba(212,175,55,0.1), transparent);
}
.card-emperor .card-symbol .art-accent {
  top:10rpx; left:10rpx; width:140rpx; height:40rpx;
  border-bottom:2rpx solid rgba(212,175,55,0.15);
  clip-path:polygon(0% 0%, 20% 80%, 30% 10%, 40% 80%, 50% 0%, 60% 80%, 70% 10%, 80% 80%, 100% 0%);
}

/* ----- V 教皇 · 十字+钥匙 ----- */
.card-hierophant .card-symbol .art-shape {
  top:10rpx; left:60rpx; width:40rpx; height:100rpx;
  border:2rpx solid rgba(212,175,55,0.4);
  border-radius:4rpx;
  background:linear-gradient(180deg, rgba(212,175,55,0.1), transparent);
}
.card-hierophant .card-symbol .art-shape::after {
  content:''; position:absolute; top:20rpx; left:-24rpx; width:84rpx; height:50rpx;
  border:2rpx solid rgba(212,175,55,0.25);
  border-radius:40rpx 40rpx 0 0;
  background:transparent; border-bottom:none;
}
.card-hierophant .card-symbol .art-accent::before {
  content:''; position:absolute; top:110rpx; left:30rpx; width:100rpx; height:40rpx;
  border-radius:0 0 20rpx 20rpx;
  border:2rpx solid rgba(212,175,55,0.15); border-top:none;
}
.card-hierophant .card-symbol .art-detail::before {
  content:''; position:absolute; top:120rpx; left:30rpx;
  box-shadow:
    20rpx 0 0 0 rgba(212,175,55,0.2), 80rpx 0 0 0 rgba(212,175,55,0.2);
  width:10rpx; height:20rpx; border-radius:50% 50% 0 0; background:rgba(212,175,55,0.1);
}

/* ----- VI 恋人 · 心+天使 ----- */
.card-lovers .card-symbol .art-shape {
  top:30rpx; left:45rpx; width:70rpx; height:64rpx;
  background:radial-gradient(ellipse at 30% 40%, #ff6b8a, #c03968);
  clip-path:path('M35,0 C17,0 0,17 0,35 C0,52 35,62 35,62 C35,62 70,52 70,35 C70,17 53,0 35,0 Z');
  box-shadow:0 0 30rpx rgba(255,107,138,0.4);
  animation:float 3s ease-in-out infinite;
}
.card-lovers .card-symbol .art-accent {
  top:90rpx; left:50rpx; width:60rpx; height:40rpx;
  border:2rpx solid rgba(212,175,55,0.3); border-bottom:none;
  border-radius:30rpx 30rpx 0 0;
}
.card-lovers .card-symbol .art-accent::after {
  content:''; position:absolute; bottom:-2rpx; left:8rpx; width:40rpx; height:20rpx;
  border-radius:0 0 20rpx 20rpx;
  border:2rpx solid rgba(212,175,55,0.15); border-top:none;
  background:radial-gradient(ellipse at 50% 0%, rgba(255,215,0,0.15), transparent);
}

/* ----- VII 战车 · 轮+斯芬克斯 ----- */
.card-chariot .card-symbol .art-shape {
  top:40rpx; left:40rpx; width:80rpx; height:80rpx;
  border:3rpx solid #d4af37;
  border-radius:50%;
  background:radial-gradient(circle, rgba(212,175,55,0.1) 40%, transparent);
}
.card-chariot .card-symbol .art-shape::after {
  content:''; position:absolute; top:50%; left:50%;
  width:20rpx; height:20rpx;
  margin:-10rpx 0 0 -10rpx;
  border:2rpx solid rgba(212,175,55,0.5);
  border-radius:50%;
  background:radial-gradient(circle, #d4af37, transparent);
}
.card-chariot .card-symbol .art-accent::before {
  content:''; position:absolute;
  top:10rpx; left:5rpx; width:70rpx; height:50rpx;
  clip-path:polygon(50% 0%, 100% 50%, 80% 100%, 20% 100%, 0% 50%);
  background:linear-gradient(135deg, rgba(212,175,55,0.05), rgba(212,175,55,0.15));
  border:1rpx solid rgba(212,175,55,0.2);
}
.card-chariot .card-symbol .art-accent::after {
  content:''; position:absolute; top:10rpx; right:5rpx;
  width:70rpx; height:50rpx;
  clip-path:polygon(50% 0%, 100% 50%, 80% 100%, 20% 100%, 0% 50%);
  background:linear-gradient(225deg, rgba(212,175,55,0.05), rgba(212,175,55,0.15));
  border:1rpx solid rgba(212,175,55,0.2);
}

/* ----- VIII 力量 · 狮首+无限 ----- */
.card-strength .card-symbol .art-shape {
  top:20rpx; left:40rpx; width:80rpx; height:80rpx;
  background:radial-gradient(circle at 40% 40%, #ffa500, #cc7700);
  border-radius:50%;
  box-shadow:0 0 40rpx rgba(255,165,0,0.3);
}
.card-strength .card-symbol .art-shape::after {
  content:''; position:absolute; top:-6rpx; left:-6rpx; right:-6rpx; bottom:-6rpx;
  border-radius:50%;
  border:6rpx solid transparent;
  box-shadow:
    0 0 0 2rpx rgba(255,165,0,0.2),
    inset 0 0 0 2rpx rgba(255,165,0,0.1);
}
.card-strength .card-symbol .art-accent {
  top:90rpx; left:30rpx; width:100rpx; height:40rpx;
}
.card-strength .card-symbol .art-accent::before {
  content:'∞'; position:absolute;
  font-size:60rpx; color:rgba(212,175,55,0.25);
  left:20rpx; top:-10rpx;
}

/* ----- IX 隐士 · 提灯+手杖 ----- */
.card-hermit .card-symbol .art-shape {
  top:20rpx; left:55rpx; width:50rpx; height:80rpx;
  border:2rpx solid rgba(212,175,55,0.3);
  border-radius:0 0 20rpx 20rpx;
  background:linear-gradient(180deg, transparent, rgba(255,215,0,0.08));
}
.card-hermit .card-symbol .art-shape::after {
  content:''; position:absolute; top:-10rpx; left:-6rpx;
  width:56rpx; height:20rpx;
  border:2rpx solid #d4af37;
  border-radius:30rpx 30rpx 0 0;
  background:radial-gradient(ellipse at 50% 100%, rgba(255,215,0,0.3), transparent);
  box-shadow:0 0 30rpx rgba(255,215,0,0.2);
}
.card-hermit .card-symbol .art-accent {
  top:10rpx; left:20rpx; width:4rpx; height:120rpx;
  background:linear-gradient(180deg, #d4af37, rgba(212,175,55,0.1));
  border-radius:2rpx;
}
.card-hermit .card-symbol .art-detail {
  top:55rpx; left:10rpx; width:140rpx; height:60rpx;
  background:radial-gradient(ellipse at 50% 0%, rgba(255,215,0,0.08), transparent 70%);
  border-radius:50%;
}

/* ----- X 命运之轮 · 轮盘+四符号 ----- */
.card-wheel-of-fortune .card-symbol .art-shape {
  top:30rpx; left:35rpx; width:90rpx; height:90rpx;
  border:3rpx solid #d4af37;
  border-radius:50%;
  background:radial-gradient(circle, rgba(212,175,55,0.08) 30%, transparent);
  animation:rotate-slow 12s linear infinite;
}
.card-wheel-of-fortune .card-symbol .art-shape::after {
  content:''; position:absolute; top:50%; left:50%;
  width:50rpx; height:50rpx; margin:-25rpx 0 0 -25rpx;
  border:2rpx solid rgba(212,175,55,0.3);
  border-radius:50%;
  background:radial-gradient(circle, #d4af37 10%, transparent);
}
.card-wheel-of-fortune .card-symbol .art-accent::before {
  content:''; position:absolute;
  box-shadow:
    65rpx 15rpx 0 0 rgba(255,100,100,0.3),
    15rpx 65rpx 0 0 rgba(100,200,255,0.3),
    -15rpx 45rpx 0 0 rgba(100,255,150,0.3),
    100rpx 45rpx 0 0 rgba(255,215,0,0.3);
  width:10rpx; height:10rpx; border-radius:50%;
  top:10rpx; left:8rpx;
}

/* ----- XI 正义 · 天平+剑 ----- */
.card-justice .card-symbol .art-shape {
  top:20rpx; left:40rpx; width:80rpx; height:60rpx;
  border-bottom:3rpx solid #d4af37;
  border-left:2rpx solid rgba(212,175,55,0.2);
  border-right:2rpx solid rgba(212,175,55,0.2);
  background:transparent;
}
.card-justice .card-symbol .art-shape::before {
  content:''; position:absolute; top:-20rpx; left:50%; margin-left:-2rpx;
  width:4rpx; height:80rpx;
  background:linear-gradient(180deg, rgba(212,175,55,0.5), #d4af37);
  border-radius:2rpx;
}
.card-justice .card-symbol .art-shape::after {
  content:''; position:absolute; top:-20rpx; left:-20rpx; width:30rpx; height:30rpx;
  border-radius:0 50% 50% 50%;
  border:2rpx solid rgba(212,175,55,0.3);
  background:rgba(212,175,55,0.05);
  transform:rotate(45deg);
