/* ============================================================
   11. 逆位状态 | Reversed State
   ============================================================ */

/* Red/ purple edge glow for reversed cards */
.card-reversed {
  box-shadow:
    0 0 15rpx rgba(200,60,80,0.15),
    0 0 35rpx rgba(150,40,80,0.08),
    inset 0 0 40rpx rgba(200,60,80,0.04);
  border-image: linear-gradient(135deg,
    #c85070, #d4af37, #b8860b, #d4af37, #c85070
  ) 1;
}

.card-reversed::before {
  border-color: rgba(200,60,80,0.15);
}

.card-reversed .card-aura {
  background:
    radial-gradient(circle at 50% 30%, rgba(200,60,80,0.04) 0%, transparent 50%),
    radial-gradient(circle at 50% 70%, rgba(147,80,120,0.03) 0%, transparent 45%);
}

/* Reversed card ornaments shift */
.card-reversed .card-symbol {
  transform: rotate(180deg);
}
.card-reversed .card-name-en,
.card-reversed .card-name-zh {
  transform: rotate(180deg);
}
.card-reversed .position-badge {
  transform: rotate(180deg);
}
.card-reversed .reversed-label {
  transform: rotate(180deg);
}


/* ============================================================
   12. 动画关键帧 | Keyframe Animations
   ============================================================ */

@keyframes card-appear {
  0% { opacity: 0; transform: translateY(30rpx) scale(0.92); filter: brightness(0.6); }
  100% { opacity: 1; transform: translateY(0) scale(1); filter: brightness(1); }
}

@keyframes glow-pulse {
  0%, 100% { filter: drop-shadow(0 0 8rpx rgba(212,175,55,0.3)); }
  50% { filter: drop-shadow(0 0 20rpx rgba(212,175,55,0.6)); }
}

@keyframes glow-pulse-reversed {
  0%, 100% { filter: drop-shadow(0 0 8rpx rgba(200,60,80,0.25)); }
  50% { filter: drop-shadow(0 0 20rpx rgba(200,60,80,0.5)); }
}

@keyframes twinkle {
  0%, 100% { opacity: 0.3; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.5); }
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-6rpx); }
}

@keyframes pulse-glow {
  0%, 100% { opacity: 0.5; transform: scale(1); }
  50% { opacity: 0.9; transform: scale(1.08); }
}

@keyframes rotate-slow {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@keyframes drip {
  0%, 100% { opacity: 0.2; transform: translateY(0); }
  50% { opacity: 0.6; transform: translateY(6rpx); }
}

@keyframes spark {
  0%, 100% { opacity: 0; transform: scale(0); }
  50% { opacity: 0.8; transform: scale(1); }
}
