/* ==============================================================
   塔罗卡牌组件 v3.0 — 至尊神秘视觉系统
   Premium Tarot Card CSS Art System
   78 Cards | 4 Suits + Major Arcana | Pure CSS Art
   ============================================================== */

/* ============================================================
   1. 基础容器 | Base Card Container
   ============================================================ */

.tarot-card-wrapper {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  padding: 8rpx;
  transition: transform 0.6s cubic-bezier(0.23, 1, 0.32, 1);
}
.tarot-card-wrapper.reversed {
  animation: glow-pulse-reversed 3s ease-in-out infinite;
}

.tarot-card {
  position: relative;
  width: 280rpx;
  height: 460rpx;
  border-radius: 16rpx;
  border: 2rpx solid;
  border-image: linear-gradient(135deg,
    #d4af37, #e8c97a, #b8860b, #f5d680, #d4af37
  ) 1;
  box-shadow:
    0 0 20rpx rgba(212,175,55,0.2),
    0 0 60rpx rgba(212,175,55,0.06),
    inset 0 0 40rpx rgba(0,0,0,0.25),
    inset 0 0 80rpx rgba(147,112,219,0.04);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.8s cubic-bezier(0.23,1,0.32,1);
  animation: card-appear 0.8s ease-out forwards;
  /* Simulated card stock texture with subtle grain */
  background:
    radial-gradient(circle at 15% 25%, rgba(255,255,255,0.018) 0%, transparent 2%),
    radial-gradient(circle at 85% 35%, rgba(255,255,255,0.015) 0%, transparent 2%),
    radial-gradient(circle at 45% 75%, rgba(255,255,255,0.016) 0%, transparent 2%),
    radial-gradient(circle at 70% 15%, rgba(212,175,55,0.008) 0%, transparent 3%),
    radial-gradient(circle at 25% 85%, rgba(147,112,219,0.008) 0%, transparent 3%),
    radial-gradient(ellipse at 50% 0%, rgba(147,112,219,0.07) 0%, transparent 50%),
    radial-gradient(ellipse at 50% 100%, rgba(212,175,55,0.04) 0%, transparent 40%),
    linear-gradient(160deg, #0a0a1a 0%, #16163a 40%, #1a1a3e 70%, #0d0d22 100%);
}
.tarot-card.card-reversed {
  transform: rotate(180deg);
}

/* ============================================================
   2. 装饰层 | Decorative System
   ============================================================ */

/* --- 2.1 内边框 (Inner Frame) --- */
.tarot-card::before {
  content: '';
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  right: 8rpx;
  bottom: 8rpx;
  border: 1rpx solid rgba(212,175,55,0.18);
  border-radius: 10rpx;
  pointer-events: none;
  z-index: 3;
  background:
    radial-gradient(ellipse at 50% 40%, rgba(212,175,55,0.03) 0%, transparent 60%);
}

/* --- 2.2 四角金钻 (Corner Diamond Ornaments) --- */
.tarot-card::after {
  content: '';
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  top: 14rpx;
  left: 14rpx;
  border: 1.5rpx solid rgba(212,175,55,0.45);
  border-radius: 2rpx;
  background: rgba(212,175,55,0.04);
  transform: rotate(45deg);
  z-index: 6;
  pointer-events: none;
  box-shadow:
    238rpx 0 0 0 rgba(212,175,55,0.35),
    0 418rpx 0 0 rgba(212,175,55,0.35),
    238rpx 418rpx 0 0 rgba(212,175,55,0.35);
}

/* --- 2.3 顶部/底部装饰带 (Ornamental Bands) --- */
.card-ornament-top,
.card-ornament-bottom {
  position: absolute;
  left: 0;
  right: 0;
  z-index: 5;
  pointer-events: none;
}
.card-ornament-top {
  top: 0;
  height: 28rpx;
  background: linear-gradient(90deg,
    transparent 5%,
    rgba(212,175,55,0.08) 15%,
    rgba(212,175,55,0.3) 30%,
    rgba(248,224,128,0.5) 50%,
    rgba(212,175,55,0.3) 70%,
    rgba(212,175,55,0.08) 85%,
    transparent 95%
  );
  /* Subtle shimmer line */
  box-shadow:
    inset 0 1rpx 0 rgba(212,175,55,0.15),
    inset 0 -1rpx 0 rgba(0,0,0,0.2);
}
.card-ornament-bottom {
  bottom: 0;
  height: 28rpx;
  background: linear-gradient(90deg,
    transparent 5%,
    rgba(212,175,55,0.08) 15%,
    rgba(212,175,55,0.25) 30%,
    rgba(248,224,128,0.4) 50%,
    rgba(212,175,55,0.25) 70%,
    rgba(212,175,55,0.08) 85%,
    transparent 95%
  );
  box-shadow:
    inset 0 -1rpx 0 rgba(212,175,55,0.12),
    inset 0 1rpx 0 rgba(0,0,0,0.2);
}

/* Corner L-brackets */
.card-ornament-top::before,
.card-ornament-bottom::before {
  content: '';
  position: absolute;
  width: 24rpx;
  height: 20rpx;
  border-style: solid;
  border-color: rgba(212,175,55,0.4);
  z-index: 6;
  pointer-events: none;
}
.card-ornament-top::before {
  top: 2rpx;
  left: 10rpx;
  border-width: 2rpx 0 0 2rpx;
  border-radius: 4rpx 0 0 0;
}
.card-ornament-bottom::before {
  bottom: 2rpx;
  left: 10rpx;
  border-width: 0 0 2rpx 2rpx;
  border-radius: 0 0 0 4rpx;
}

.card-ornament-top::after,
.card-ornament-bottom::after {
  content: '';
  position: absolute;
  width: 24rpx;
  height: 20rpx;
  border-style: solid;
  border-color: rgba(212,175,55,0.4);
  z-index: 6;
  pointer-events: none;
}
.card-ornament-top::after {
  top: 2rpx;
  right: 10rpx;
  border-width: 2rpx 2rpx 0 0;
  border-radius: 0 4rpx 0 0;
}
.card-ornament-bottom::after {
  bottom: 2rpx;
  right: 10rpx;
  border-width: 0 2rpx 2rpx 0;
  border-radius: 0 0 4rpx 0;
}

/* Secondary inner corner dots */
.card-ornament-top::before,
.card-ornament-top::after {
  box-shadow: 0 0 6rpx rgba(212,175,55,0.15);
}
.card-ornament-bottom::before,
.card-ornament-bottom::after {
  box-shadow: 0 0 6rpx rgba(212,175,55,0.15);
}

/* --- 2.3b 卡牌图像 (ComfyUI真实PNG) --- */
.card-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  border-radius: 14rpx;
  pointer-events: none;
}

/* --- 2.4 星尘背景 (Stardust Background) --- */
.star-field {
  position: absolute;
  width: 100%;
  height: 100%;
  overflow: hidden;
  pointer-events: none;
}
.star {
  position: absolute;
  width: 4rpx;
  height: 4rpx;
  background: #fff;
  border-radius: 50%;
  animation: twinkle 2.5s ease-in-out infinite;
}
/* Individual star positions + expanded constellation via box-shadow */
.star.s1 {
  top: 15%; left: 20%;
  box-shadow:
    60rpx 80rpx 0 0 rgba(255,255,255,0.5),
    140rpx 160rpx 0 0 rgba(255,255,255,0.3),
    30rpx 200rpx 0 0 rgba(255,255,255,0.4),
    180rpx 40rpx 0 0 rgba(255,255,255,0.25);
}
.star.s2 {
  top: 30%; left: 70%;
  animation-delay: 0.4s;
  width: 3rpx;
  height: 3rpx;
  box-shadow:
    -40rpx 100rpx 0 0 rgba(255,255,255,0.35),
    50rpx 180rpx 0 0 rgba(255,255,255,0.25),
    -80rpx 50rpx 0 0 rgba(212,175,55,0.3);
}
.star.s3 {
  top: 55%; left: 30%;
  animation-delay: 0.8s;
  box-shadow:
    100rpx -30rpx 0 0 rgba(255,255,255,0.3),
    120rpx 120rpx 0 0 rgba(255,255,255,0.2),
    30rpx 160rpx 0 0 rgba(212,175,55,0.25);
}
.star.s4 {
  top: 70%; left: 65%;
  animation-delay: 1.2s;
  width: 5rpx;
  height: 5rpx;
  opacity: 0.8;
  box-shadow:
    -80rpx -60rpx 0 0 rgba(255,255,255,0.25),
    60rpx -120rpx 0 0 rgba(255,255,255,0.2),
    -30rpx 100rpx 0 0 rgba(212,175,55,0.2);
}
.star.s5 {
  top: 40%; left: 45%;
  animation-delay: 0.2s;
  width: 3rpx;
  height: 3rpx;
  box-shadow:
    90rpx 60rpx 0 0 rgba(255,255,255,0.4),
    -50rpx 140rpx 0 0 rgba(255,255,255,0.2),
    150rpx -50rpx 0 0 rgba(255,255,255,0.15);
}
.star.s6 {
  top: 80%; left: 25%;
  animation-delay: 1.6s;
  box-shadow:
    70rpx -80rpx 0 0 rgba(255,255,255,0.3),
    150rpx 40rpx 0 0 rgba(212,175,55,0.2),
    30rpx 120rpx 0 0 rgba(255,255,255,0.15);
}
.star.s7 {
  top: 20%; left: 55%;
  animation-delay: 0.6s;
  width: 5rpx;
  height: 5rpx;
  opacity: 0.6;
  box-shadow:
    -40rpx 140rpx 0 0 rgba(255,255,255,0.2),
    80rpx 200rpx 0 0 rgba(255,255,255,0.15),
    -70rpx 60rpx 0 0 rgba(212,175,55,0.2);
}
.star.s8 {
  top: 60%; left: 80%;
  animation-delay: 1.0s;
  width: 3rpx;
  height: 3rpx;
  box-shadow:
    -140rpx -40rpx 0 0 rgba(255,255,255,0.25),
    -80rpx 100rpx 0 0 rgba(255,255,255,0.15),
    20rpx 160rpx 0 0 rgba(212,175,55,0.2);
}

/* --- 2.5 卡牌辉光 (Card Aura) --- */
.card-aura {
  position: absolute;
  inset: 0;
  border-radius: 14rpx;
  pointer-events: none;
  z-index: 1;
  background:
    radial-gradient(circle at 50% 30%, rgba(212,175,55,0.05) 0%, transparent 60%),
    radial-gradient(circle at 50% 70%, rgba(147,112,219,0.03) 0%, transparent 50%);
}


/* ============================================================
   3. 文字排版 | Typography
   ============================================================ */

/* --- 3.1 卡牌编号 (Card Number) --- */
.card-number {
  position: absolute;
  top: 36rpx;
  left: 22rpx;
  z-index: 5;
  font-size: 18rpx;
  color: #d4af37;
  font-family: 'Georgia', serif;
  letter-spacing: 2rpx;
  opacity: 0.85;
  background: rgba(0,0,0,0.3);
  border: 1rpx solid rgba(212,175,55,0.15);
  border-radius: 4rpx;
  padding: 2rpx 10rpx;
  line-height: 1.4;
  text-shadow: 0 0 8rpx rgba(212,175,55,0.15);
}

/* --- 3.2 卡牌名称 (Card Name) --- */
.card-name-en {
  font-size: 20rpx;
  color: #c8b060;
  font-family: 'Georgia', serif;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  text-align: center;
  margin-bottom: 2rpx;
  position: relative;
  z-index: 2;
  text-shadow:
    0 0 10rpx rgba(200,176,96,0.3),
    0 2rpx 4rpx rgba(0,0,0,0.5);
}
.card-name-zh {
  font-size: 26rpx;
  color: #f5e6b8;
  font-family: 'STKaiti', 'KaiTi', serif;
  letter-spacing: 5rpx;
  text-align: center;
  margin-bottom: 10rpx;
  font-weight: 500;
  position: relative;
  z-index: 2;
  text-shadow:
    0 0 12rpx rgba(245,230,184,0.2),
    0 2rpx 4rpx rgba(0,0,0,0.5);
}

/* --- 3.3 位置徽章 (Position Badge) --- */
.position-badge {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  margin-bottom: 36rpx;
  white-space: nowrap;
  position: relative;
  z-index: 2;
}
.badge-upright {
  background: linear-gradient(135deg, rgba(44,62,80,0.85), rgba(52,73,94,0.85));
  border: 1rpx solid rgba(212,175,55,0.4);
  color: #d4af37;
}
.badge-reversed {
  background: linear-gradient(135deg, rgba(80,44,55,0.85), rgba(94,52,66,0.85));
  border: 1rpx solid rgba(200,120,140,0.4);
  color: #e8a0b0;
}
.position-icon { font-size: 16rpx; }
.position-text { letter-spacing: 1rpx; }

.reversed-label {
  position: absolute;
  bottom: 84rpx;
  right: -4rpx;
  font-size: 16rpx;
  color: rgba(232,160,176,0.6);
  letter-spacing: 2rpx;
  writing-mode: vertical-rl;
  z-index: 2;
  text-shadow: 0 1rpx 3rpx rgba(0,0,0,0.7);
}


/* ============================================================
   4. 大阿尔卡纳共通 | Major Arcana Common
   ============================================================ */

/* Enhanced golden border for major arcana */
.card-major {
  border-width: 3rpx;
  box-shadow:
    0 0 25rpx rgba(212,175,55,0.25),
    0 0 70rpx rgba(212,175,55,0.08),
    inset 0 0 40rpx rgba(0,0,0,0.25),
    inset 0 0 80rpx rgba(147,112,219,0.05);
}

.card-major::before {
  top: 10rpx;
  left: 10rpx;
  right: 10rpx;
  bottom: 10rpx;
  border-width: 1.5rpx;
  border-color: rgba(212,175,55,0.25);
  background:
    radial-gradient(ellipse at 50% 40%, rgba(212,175,55,0.04) 0%, transparent 60%);
}

.card-major::after {
  width: 18rpx;
  height: 18rpx;
  top: 16rpx;
  left: 16rpx;
  border-color: rgba(212,175,55,0.55);
  background: rgba(212,175,55,0.06);
  box-shadow:
    230rpx 0 0 0 rgba(212,175,55,0.45),
    0 410rpx 0 0 rgba(212,175,55,0.45),
    230rpx 410rpx 0 0 rgba(212,175,55,0.45);
}

/* Major arcana: enhanced ornament bands */
.card-major .card-ornament-top {
  height: 32rpx;
  background: linear-gradient(90deg,
    transparent 3%,
    rgba(212,175,55,0.1) 12%,
    rgba(212,175,55,0.35) 25%,
    #d4af37 50%,
    rgba(212,175,55,0.35) 75%,
    rgba(212,175,55,0.1) 88%,
    transparent 97%
  );
}
.card-major .card-ornament-bottom {
  height: 32rpx;
  background: linear-gradient(90deg,
    transparent 3%,
    rgba(212,175,55,0.1) 12%,
    rgba(212,175,55,0.3) 25%,
    #d4af37 50%,
    rgba(212,175,55,0.3) 75%,
    rgba(212,175,55,0.1) 88%,
    transparent 97%
  );
}

.card-major .card-ornament-top::before,
.card-major .card-ornament-bottom::before {
  width: 28rpx;
  height: 24rpx;
  border-color: rgba(212,175,55,0.5);
}
.card-major .card-ornament-top::after,
.card-major .card-ornament-bottom::after {
  width: 28rpx;
  height: 24rpx;
  border-color: rgba(212,175,55,0.5);
}

/* Major arcana: Roman numeral display enhancement */
.card-major .card-number {
  top: 38rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #e8c97a;
  background: rgba(0,0,0,0.35);
  border-color: rgba(212,175,55,0.25);
  padding: 4rpx 12rpx;
  letter-spacing: 3rpx;
}

/* Major arcana: central mandala pattern */
.card-major .card-art::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 24rpx;
  height: 24rpx;
  margin: -12rpx 0 0 -12rpx;
  background: rgba(212,175,55,0.04);
  border-radius: 50%;
  z-index: 0;
  pointer-events: none;
  box-shadow:
    0 0 0 28rpx rgba(212,175,55,0.025),
    0 0 0 58rpx rgba(212,175,55,0.018),
    0 0 0 90rpx rgba(212,175,55,0.012),
    0 0 0 124rpx rgba(212,175,55,0.008);
}

/* Major arcana: golden name enhancement */
.card-major .card-name-en {
  color: #d4af37;
  text-shadow:
    0 0 15rpx rgba(212,175,55,0.35),
    0 2rpx 4rpx rgba(0,0,0,0.5);
}
.card-major .card-name-zh {
  color: #f5e6b8;
  text-shadow:
    0 0 15rpx rgba(245,230,184,0.25),
    0 2rpx 4rpx rgba(0,0,0,0.5);
}

/* Major arcana: enhanced aura */
.card-major .card-aura {
  background:
    radial-gradient(circle at 50% 30%, rgba(212,175,55,0.07) 0%, transparent 50%),
    radial-gradient(circle at 50% 70%, rgba(147,112,219,0.05) 0%, transparent 45%);
}

/* Major arcana: corner bracket shimmer */
.card-major .card-ornament-top::before,
.card-major .card-ornament-top::after {
  box-shadow: 0 0 8rpx rgba(212,175,55,0.2);
}
.card-major .card-ornament-bottom::before,
.card-major .card-ornament-bottom::after {
  box-shadow: 0 0 8rpx rgba(212,175,55,0.2);
}


/* ============================================================
   5. 大阿尔卡纳个体艺术 | Major Arcana Individual Art
   22张卡牌独立CSS插画
   ============================================================ */

/* 插画核心容器 */
.card-symbol {
  position: relative;
  width: 160rpx;
  height: 200rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
}
.card-symbol .art-shape,
.card-symbol .art-accent,
.card-symbol .art-detail {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  pointer-events: none;
}

/* ----- 0 愚者 · 太阳+悬崖 ----- */
.card-fool .card-symbol .art-shape {
  width: 80rpx; height: 80rpx; top: 10rpx; left: 40rpx;
  background: radial-gradient(circle at 40% 40%, #ffd700, #b8860b);
  border-radius: 50%;
  box-shadow: 0 0 50rpx rgba(255,215,0,0.5), 0 0 100rpx rgba(255,215,0,0.2);
  animation: pulse-glow 3s ease-in-out infinite;
}
.card-fool .card-symbol .art-shape::after {
  content: ''; position: absolute; inset: -12rpx; border-radius: 50%;
  border: 2rpx solid rgba(255,215,0,0.25);
  animation: pulse-glow 3s ease-in-out infinite 0.5s;
}
.card-fool .card-symbol .art-accent {
  top: 90rpx; left: 20rpx; width: 120rpx; height: 60rpx;
  border-top: 4rpx dotted rgba(212,175,55,0.3);
  box-shadow: 0 10rpx 0 -4rpx rgba(212,175,55,0.08), 0 20rpx 0 -4rpx rgba(212,175,55,0.05);
  clip-path: polygon(20% 100%, 35% 30%, 50% 100%, 65% 20%, 80% 100%);
}
.card-fool .card-symbol .art-detail {
  border-bottom: 6rpx solid #2a1a4a;
  bottom: 0; top: auto; height: 20rpx;
  box-shadow: 0 -4rpx 0 rgba(212,175,55,0.15);
  clip-path: polygon(10% 0, 25% 100%, 40% 20%, 55% 100%, 70% 10%, 85% 100%, 95% 0);
}

/* ----- I 魔术师 · 无限符号+四元素 ----- */
.card-magician .card-symbol .art-shape {
  top: 20rpx; left: 10rpx; width: 140rpx; height: 100rpx;
  border: 3rpx solid #d4af37; border-radius: 50% 0 50% 0;
  background: radial-gradient(circle at 50% 50%, rgba(212,175,55,0.1), transparent);
  transform: rotate(45deg);
}
.card-magician .card-symbol .art-shape::after {
  content: ''; position: absolute; top: 20rpx; left: 20rpx; width: 100rpx; height: 60rpx;
  border: 2rpx solid rgba(212,175,55,0.3);
  border-radius: 50% 0 50% 0; transform: rotate(-90deg);
}
.card-magician .card-symbol .art-accent {
  top: 90rpx; height: 2rpx; width: 100rpx; left: 30rpx;
  background: linear-gradient(90deg, transparent, #d4af37, transparent);
}
.card-magician .card-symbol .art-detail::before {
  content: ''; position: absolute;
  box-shadow:
    30rpx 20rpx 0 0 #ff6b6b, 60rpx 20rpx 0 0 #4ecdc4,
    30rpx 40rpx 0 0 #ffe66d, 60rpx 40rpx 0 0 #a8e6cf;
  width: 8rpx; height: 8rpx; border-radius: 50%;
  top: 80rpx; left: 20rpx; opacity: 0.7;
}

/* ----- II 女祭司 · 月+卷轴 ----- */
.card-high-priestess .card-symbol .art-shape {
  width: 70rpx; height: 70rpx; top: 10rpx; left: 45rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 55% 45%, #e8e0f0, transparent 60%);
  box-shadow:
    10rpx 0 0 -4rpx #c8b8e8, 20rpx 0 0 -8rpx rgba(200,184,232,0.3);
  clip-path: polygon(50% 0%, 100% 0, 100% 100%, 50% 100%, 0 100%, 0 0);
  border: 2rpx solid rgba(200,184,232,0.3);
}
.card-high-priestess .card-symbol .art-shape::after {
  content: ''; position: absolute; top: 10rpx; left: 10rpx; width: 30rpx; height: 30rpx;
  border-radius: 50%; box-shadow: 20rpx 0 0 2rpx rgba(212,175,55,0.2);
}
.card-high-priestess .card-symbol .art-accent {
  top: 90rpx; left: 40rpx; width: 80rpx; height: 60rpx;
  border: 2rpx solid rgba(200,184,232,0.3);
  border-radius: 0 0 20rpx 20rpx;
  background: linear-gradient(180deg, transparent, rgba(200,184,232,0.05));
}
.card-high-priestess .card-symbol .art-detail {
  top: 95rpx; left: 45rpx; width: 70rpx; height: 50rpx;
  border: 1rpx solid rgba(212,175,55,0.15);
  border-radius: 4rpx;
  background: linear-gradient(180deg, transparent 30%, rgba(212,175,55,0.05) 30%, rgba(212,175,55,0.05) 32%, transparent 32%);
}

/* ----- III 女皇 · 皇冠+麦穗 ----- */
.card-empress .card-symbol .art-shape {
