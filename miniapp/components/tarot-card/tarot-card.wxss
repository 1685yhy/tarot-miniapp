/* ============================================================
   Tarot Card Component — Clean Minimal Frame
   The CDN image is the hero. The component just frames it.
   ============================================================ */

/* 1. Base Container
   -------------------------- */
.tarot-card-wrapper {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  padding: 8rpx;
}

/* 2. Card Frame
   Thin warm brown border, soft shadow, uniform rounded corners.
   -------------------------- */
.tarot-card {
  position: relative;
  width: 280rpx;
  height: 460rpx;
  border-radius: 16rpx;
  border: 1.5rpx solid #BF7733;
  box-shadow:
    0 2rpx 8rpx rgba(90, 60, 30, 0.10),
    0 8rpx 24rpx rgba(80, 55, 25, 0.07),
    0 20rpx 56rpx rgba(70, 45, 20, 0.04);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #1a1512;
  animation: card-appear 0.7s ease-out forwards;
  transition: transform 0.6s cubic-bezier(0.23, 1, 0.32, 1);
}

.tarot-card.card-reversed {
  transform: rotate(180deg);
}

/* 3. Card Image — Hero
   Fills the frame edge-to-edge.
   -------------------------- */
.card-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  border-radius: 16rpx;
  pointer-events: none;
}

/* 4. Suit Indicator — Tiny Colored Dot
   Positioned at the top-right corner of the card.
   -------------------------- */
.card-art::before {
  content: '';
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  z-index: 6;
  pointer-events: none;
}

/* Wands  → warm brown */
.tarot-card[class*="wands"] .card-art::before {
  background: #BF7733;
}

/* Cups   → dusty rose */
.tarot-card[class*="cups"] .card-art::before {
  background: #C9A0A0;
}

/* Swords → sage */
.tarot-card[class*="swords"] .card-art::before {
  background: #8FBC8F;
}

/* Pentacles → warm gold */
.tarot-card[class*="pentacles"] .card-art::before {
  background: #D4A843;
}

/* 5. Typography — Small, Clean, Warm Brown
   No text-shadow — the card image beneath may be dark or light.
   -------------------------- */
.card-number {
  position: absolute;
  top: 14rpx;
  left: 28rpx;
  z-index: 5;
  font-size: 16rpx;
  color: #BF7733;
  font-family: 'Georgia', serif;
  letter-spacing: 1rpx;
  line-height: 1.3;
  pointer-events: none;
}

.card-name-en {
  position: absolute;
  bottom: 34rpx;
  left: 0;
  right: 0;
  text-align: center;
  z-index: 5;
  font-size: 14rpx;
  color: #BF7733;
  font-family: 'Georgia', serif;
  letter-spacing: 3rpx;
  text-transform: uppercase;
  pointer-events: none;
}

.card-name-zh {
  position: absolute;
  bottom: 14rpx;
  left: 0;
  right: 0;
  text-align: center;
  z-index: 5;
  font-size: 18rpx;
  color: #A08050;
  font-family: 'STKaiti', 'KaiTi', serif;
  letter-spacing: 5rpx;
  font-weight: 400;
  pointer-events: none;
}

/* 6. Position Badge
   -------------------------- */
.position-badge {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 3rpx 12rpx;
  border-radius: 16rpx;
  font-size: 15rpx;
  position: absolute;
  bottom: 64rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 5;
  white-space: nowrap;
  pointer-events: none;
}

.badge-upright {
  background: rgba(40, 42, 38, 0.55);
  color: rgba(191, 119, 51, 0.75);
}

.badge-reversed {
  background: rgba(50, 35, 30, 0.55);
  color: rgba(205, 127, 50, 0.75);
}

.position-icon { font-size: 13rpx; }
.position-text { letter-spacing: 1rpx; }

/* 7. Reversed — Subtle Warm Edge Glow
   A warm box-shadow bloom replaces the old gradient overlay.
   -------------------------- */
.card-reversed {
  border-color: rgba(191, 119, 51, 0.6);
  box-shadow:
    0 0 16rpx rgba(191, 119, 51, 0.12),
    0 2rpx 8rpx rgba(90, 60, 30, 0.10),
    0 8rpx 24rpx rgba(80, 55, 25, 0.07);
}

/* 8. Major Arcana — Slightly Elevated
   Thicker border, slightly larger suit dot.
   -------------------------- */
.card-major {
  border-width: 2rpx;
  border-color: #BF7733;
}

.card-major .card-art::before {
  width: 12rpx;
  height: 12rpx;
  background: #BF7733;
}

/* 9. Art Container
   Solely needed as the positioning anchor for the suit dot.
   No background tint — the image is the hero.
   -------------------------- */
.card-art {
  position: relative;
  width: 100%;
  height: 100%;
  z-index: 2;
  pointer-events: none;
  background: transparent;
}

/* 10. Hidden Elements
     No CSS art, no star fields, no decorative ornament bars.
     -------------------------- */
.star-field,
.card-symbol,
.card-ornament-top,
.card-ornament-bottom,
.card-aura,
.reversed-label,
.card-symbol .art-shape,
.card-symbol .art-accent,
.card-symbol .art-detail {
  display: none;
}

/* 11. Keyframe Animation
      Soft fade-up with subtle scale.
      -------------------------- */
@keyframes card-appear {
  0% {
    opacity: 0;
    transform: translateY(16rpx) scale(0.96);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}
