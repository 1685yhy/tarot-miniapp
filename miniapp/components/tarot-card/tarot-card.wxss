/* ==============================================================
   Tarot Card Component v5.0 — Minimalist Gallery Frame
   Art-first: the ComfyUI image is the hero.
   Thin rose-gold border | Soft cream-paper shadow
   ============================================================== */

/* ============================================================
   1. Base Container
   ============================================================ */

.tarot-card-wrapper {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  padding: 6rpx;
}

/* ============================================================
   2. Card — Minimalist Frame
   ============================================================ */

.tarot-card {
  position: relative;
  width: 280rpx;
  height: 460rpx;
  border-radius: 18rpx;
  /* Thin rose-gold border */
  border: 1.5rpx solid #C9A96E;
  /* Soft warm shadow — like a card on cream paper */
  box-shadow:
    0 2rpx 6rpx rgba(80, 60, 40, 0.08),
    0 6rpx 20rpx rgba(80, 60, 40, 0.06),
    0 16rpx 48rpx rgba(80, 60, 40, 0.04);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  /* Warm dark fallback background */
  background: #1a1512;
  animation: card-appear 0.7s ease-out forwards;
  transition: transform 0.6s cubic-bezier(0.23, 1, 0.32, 1);
}

.tarot-card.card-reversed {
  transform: rotate(180deg);
}

/* ============================================================
   3. Card Image — Hero
   ============================================================ */

.card-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  border-radius: 17rpx;
  pointer-events: none;
}

/* ============================================================
   4. Suit Corner Dot
   Tiny colored dot at the top-right — suit-specific hue
   ============================================================ */

.card-art::before {
  content: '';
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  z-index: 5;
  pointer-events: none;
  opacity: 0.7;
}

/* Wands: warm amber/rose */
.tarot-card[class*="wands"] .card-art::before {
  background: #E8A87C;
  color: rgba(232, 168, 124, 0.5);
}

/* Cups: soft lavender */
.tarot-card[class*="cups"] .card-art::before {
  background: #C9B8E8;
  color: rgba(201, 184, 232, 0.5);
}

/* Swords: pale sage */
.tarot-card[class*="swords"] .card-art::before {
  background: #B8C9A8;
  color: rgba(184, 201, 168, 0.5);
}

/* Pentacles: warm gold */
.tarot-card[class*="pentacles"] .card-art::before {
  background: #D4B86A;
  color: rgba(212, 184, 106, 0.5);
}

/* ============================================================
   5. Typography — Elegant, Minimal Overlays
   ============================================================ */

/* Card number (Roman numerals / index) */
.card-number {
  position: absolute;
  top: 14rpx;
  left: 14rpx;
  z-index: 5;
  font-size: 16rpx;
  color: rgba(240, 230, 211, 0.7);
  font-family: 'Georgia', serif;
  letter-spacing: 1rpx;
  opacity: 0.85;
  line-height: 1.3;
  pointer-events: none;
  text-shadow: 0 1rpx 4rpx rgba(20, 15, 10, 0.5);
}

/* English name — bottom of card */
.card-name-en {
  position: absolute;
  bottom: 34rpx;
  left: 0;
  right: 0;
  text-align: center;
  z-index: 5;
  font-size: 14rpx;
  color: rgba(240, 230, 211, 0.7);
  font-family: 'Georgia', serif;
  letter-spacing: 3rpx;
  text-transform: uppercase;
  pointer-events: none;
  text-shadow: 0 1rpx 4rpx rgba(20, 15, 10, 0.5);
}

/* Chinese name — bottom of card */
.card-name-zh {
  position: absolute;
  bottom: 14rpx;
  left: 0;
  right: 0;
  text-align: center;
  z-index: 5;
  font-size: 18rpx;
  color: rgba(240, 230, 211, 0.8);
  font-family: 'STKaiti', 'KaiTi', serif;
  letter-spacing: 5rpx;
  font-weight: 400;
  pointer-events: none;
  text-shadow: 0 1rpx 4rpx rgba(20, 15, 10, 0.5);
}

/* ============================================================
   6. Position Badge
   Small, semi-transparent chip near bottom
   ============================================================ */

.position-badge {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 3rpx 12rpx;
  border-radius: 16rpx;
  font-size: 15rpx;
  position: absolute;
  bottom: 64rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 5;
  white-space: nowrap;
  pointer-events: none;
}

.badge-upright {
  background: rgba(44, 50, 55, 0.5);
  color: rgba(240, 230, 211, 0.65);
}

.badge-reversed {
  background: rgba(60, 40, 45, 0.5);
  color: rgba(232, 168, 176, 0.65);
}

.position-icon { font-size: 13rpx; }
.position-text { letter-spacing: 1rpx; }

/* ============================================================
   7. Reversed State — Delicate Rose-Tinted Glow
   A soft warmth hugging the card edge, like gentle light
   ============================================================ */

.card-reversed {
  border-color: rgba(201, 169, 110, 0.5);
}

/* Soft rose edge glow via aura layer */
.card-reversed .card-aura {
  position: absolute;
  inset: -6rpx;
  z-index: -1;
  border-radius: 24rpx;
  pointer-events: none;
  background: transparent;
  box-shadow:
    0 0 12rpx rgba(201, 169, 110, 0.12),
    0 0 30rpx rgba(180, 120, 130, 0.08),
    0 0 60rpx rgba(180, 120, 130, 0.04);
}

/* Upright aura is invisible */
.card-aura {
  display: none;
}

/* Reversed label — minimal; card rotation + glow is the primary indicator */
.reversed-label {
  position: absolute;
  bottom: 84rpx;
  right: 8rpx;
  font-size: 14rpx;
  color: rgba(232, 168, 176, 0.35);
  letter-spacing: 2rpx;
  writing-mode: vertical-rl;
  z-index: 2;
  pointer-events: none;
}

/* ============================================================
   8. Major Arcana — Slightly Elevated
   ============================================================ */

.card-major {
  border-width: 2rpx;
  border-color: #C9A96E;
}

.card-major .card-art::before {
  width: 10rpx;
  height: 10rpx;
  opacity: 0.85;
  background: #C9A96E;
  box-shadow: 0 0 8rpx rgba(201, 169, 110, 0.6);
}

/* ============================================================
   9. Image-Fallback Zone (no image loaded)
   Clean minimalist placeholder — no CSS art
   ============================================================ */

.card-art {
  position: relative;
  width: 100%;
  height: 100%;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  /* Subtle warm gradient fallback — visible only when no image covers it */
  background: radial-gradient(ellipse at 50% 50%, rgba(201, 169, 110, 0.04), transparent 70%);
}

/* Minimal fallback symbol — just the suit icon centered */
.card-symbol {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 1;
  text-align: center;
  opacity: 0.3;
}

.card-symbol .minor-suit {
  font-size: 60rpx;
  font-weight: 200;
  display: block;
}

.card-symbol .minor-rank {
  font-size: 36rpx;
  font-weight: 300;
  display: block;
  margin-top: 8rpx;
}

/* Legacy art elements — hidden, image is the hero now */
.card-symbol .art-shape,
.card-symbol .art-accent,
.card-symbol .art-detail {
  display: none;
}

/* Star field — hidden by default, shown only as fallback */
.star-field {
  display: none;
}

/* ============================================================
   10. Hidden Decorative Elements
   Ornaments removed — let the image breathe
   ============================================================ */

.card-ornament-top,
.card-ornament-bottom {
  display: none;
}

/* Remove old ::before inner frame from base card */
.tarot-card::before {
  display: none;
}

/* Remove old ::after corner filigree from base card */
.tarot-card::after {
  display: none;
}

/* ============================================================
   11. Keyframe Animations
   Soft fade-up with subtle scale
   ============================================================ */

@keyframes card-appear {
  0% {
    opacity: 0;
    transform: translateY(16rpx) scale(0.96);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}
