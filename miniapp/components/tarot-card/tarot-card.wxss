/* ============================================================
   柔光星辰 — Tarot Card Component
   "A window into another world — mysterious, beautiful, inviting"
   ============================================================ */

/* ============================================================
   CARD HOVER LIFT — Premium micro-interaction
   Slight scale up + deeper shadow on touch
   ============================================================ */

.tarot-card-wrapper:active .tarot-card {
  transform: scale(1.03);
  box-shadow:
    0 0 50rpx 12rpx rgba(212, 168, 83, 0.35),
    inset 0 0 50rpx 8rpx rgba(212, 168, 83, 0.05);
  transition:
    transform 0.15s cubic-bezier(0.23, 1, 0.32, 1),
    box-shadow 0.15s ease-out;
}

.tarot-card-wrapper:active {
  transition: transform 0.15s ease-out;
}

/* ---- Card Wrapper ---- */

.tarot-card-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-sm);
  width: 100%;
  box-sizing: border-box;
  /* perspective not supported in WXSS — flip uses scaleX */
}

/* ---- Card Body ---- */

.tarot-card {
  position: relative;
  width: 380rpx;
  height: 600rpx;
  border-radius: var(--radius-md);
  overflow: hidden;

  /* Dark indigo card surface */
  background: linear-gradient(
    150deg,
    var(--color-bg) 0%,
    #20174a 30%,
    #1b1340 65%,
    #140d30 100%
  );

  /* Golden border */
  border: 1.5rpx solid var(--color-gold-dark);

  /* Warm golden glow shadow (resting state) */
  box-shadow:
    0 0 30rpx 6rpx rgba(212, 168, 83, 0.22),
    inset 0 0 50rpx 8rpx rgba(212, 168, 83, 0.03);

  /* Mount animations: rise + border glow play concurrently.
     Opacity and transform are separate keyframes so the
     reversed selector can override one without losing the other. */
  animation:
    rise-opacity var(--duration-base) cubic-bezier(0.23, 1, 0.32, 1) forwards,
    rise-transform var(--duration-base) cubic-bezier(0.23, 1, 0.32, 1) forwards,
    card-border-glow 1s ease-out forwards;

  transition:
    transform var(--duration-fast) cubic-bezier(0.23, 1, 0.32, 1),
    box-shadow var(--duration-fast) ease-out;
}

/* ============================================================
   MOUNT ANIMATION 1a — Card Rise (opacity)
   Fades in on mount
   ============================================================ */

@keyframes rise-opacity {
  0%   { opacity: 0; }
  100% { opacity: 1; }
}

/* ============================================================
   MOUNT ANIMATION 1b — Card Rise (transform)
   Slides up 40rpx on mount
   ============================================================ */

@keyframes rise-transform {
  0%   { transform: translateY(40rpx) scale(0.96); }
  100% { transform: translateY(0) scale(1); }
}

/* ============================================================
   MOUNT ANIMATION 2 — Golden Border Glow Flash
   Brief intense golden glow on first appearance
   ============================================================ */

@keyframes card-border-glow {
  0% {
    box-shadow:
      0 0 10rpx 2rpx rgba(212, 168, 83, 0.08),
      inset 0 0 20rpx 4rpx rgba(212, 168, 83, 0.01);
  }
  30% {
    box-shadow:
      0 0 60rpx 20rpx rgba(212, 168, 83, 0.35),
      inset 0 0 70rpx 14rpx rgba(212, 168, 83, 0.07);
  }
  60% {
    box-shadow:
      0 0 40rpx 10rpx rgba(212, 168, 83, 0.25),
      inset 0 0 60rpx 10rpx rgba(212, 168, 83, 0.05);
  }
  100% {
    box-shadow:
      0 0 30rpx 6rpx rgba(212, 168, 83, 0.22),
      inset 0 0 50rpx 8rpx rgba(212, 168, 83, 0.03);
  }
}

/* ============================================================
   MOUNT ANIMATION 3 — Shimmer Sweep (0.5s delay)
   A subtle light sheen glides diagonally across the card face
   ============================================================ */

.tarot-card::after {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 4;
  border-radius: inherit;
  pointer-events: none;
  background: linear-gradient(
    105deg,
    transparent 0%,
    transparent 35%,
    rgba(242, 230, 201, 0.10) 45%,
    rgba(242, 230, 201, 0.18) 50%,
    rgba(242, 230, 201, 0.10) 55%,
    transparent 65%,
    transparent 100%
  );
  transform: translateX(-100%);
  animation: sheen-sweep 0.4s ease-out 0.5s forwards;
}

@keyframes sheen-sweep {
  0%   { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}

/* ============================================================
   SUIT-SPECIFIC SPARKLE on mount
   The suit-indicator dot (::before) briefly flashes with
   a colored pulse at mount time.
   ============================================================ */

.tarot-card.card-wands::before,
.tarot-card.card-cups::before,
.tarot-card.card-swords::before,
.tarot-card.card-pentacles::before {
  animation: suit-sparkle 1s ease-out 0.3s;
}

.tarot-card.card-major::before {
  animation: suit-sparkle-major 1s ease-out 0.3s;
}

@keyframes suit-sparkle {
  0%   { opacity: 0; transform: scale(0.05); }
  12%  { opacity: 1; transform: scale(2); }
  28%  { opacity: 0.9; transform: scale(1); }
  100% { opacity: 0.9; transform: scale(1); }
}

@keyframes suit-sparkle-major {
  0%   { opacity: 0; transform: scale(0.05) rotate(45deg); }
  12%  { opacity: 1; transform: scale(2) rotate(45deg); }
  28%  { opacity: 0.9; transform: scale(1) rotate(45deg); }
  100% { opacity: 0.9; transform: scale(1) rotate(45deg); }
}

/* ---- Reversed: rotate card + enhanced blood-rose inner glow ---- */

.tarot-card-wrapper.reversed .tarot-card {
  transform: rotate(180deg);

  /* Combine mount animations (fade-in + border glow only — no rise transform)
     with the continuous blood-rose glow pulse that starts after mount. */
  animation:
    rise-opacity var(--duration-base) cubic-bezier(0.23, 1, 0.32, 1) forwards,
    card-border-glow 1s ease-out forwards,
    reversed-glow 4s ease-in-out 1.5s infinite alternate;
}

@keyframes reversed-glow {
  0% {
    box-shadow:
      0 0 30rpx 6rpx rgba(212, 168, 83, 0.20),
      inset 0 -60rpx 90rpx -10rpx rgba(225, 150, 140, 0.30);
  }
  100% {
    box-shadow:
      0 0 30rpx 6rpx rgba(212, 168, 83, 0.20),
      inset 0 -60rpx 90rpx -10rpx rgba(225, 150, 140, 0.40);
  }
}

/* ============================================================
   FLIP ANIMATION — Card Reveal Flip
   Flipping occurs when .flipping class is set on wrapper.
   Uses scaleX trick since 3D transforms are limited in WXSS.
   Must appear AFTER the reversed rule in the CSS so it
   wins the cascade when both .flipping and .reversed match.
   ============================================================ */

.tarot-card-wrapper.flipping .tarot-card {
  animation: card-flip var(--duration-base) cubic-bezier(0.23, 1, 0.32, 1) forwards;
}

.tarot-card-wrapper.flipping {
  --flip-glow: 0 0 80rpx 30rpx rgba(212, 168, 83, 0.45);
}

@keyframes card-flip {
  0%   { transform: scaleX(0.05); }
  50%  { transform: scaleX(0.08); }
  100% { transform: scaleX(1); }
}

/* ---- Card Image (ComfyUI-generated) ---- */

.card-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  pointer-events: none;
}

/* ---- Ornament Bars (golden decorative strips) ---- */

.card-ornament-top,
.card-ornament-bottom {
  position: absolute;
  left: 0;
  right: 0;
  height: 4rpx;
  z-index: 5;
  pointer-events: none;
}

.card-ornament-top {
  top: 0;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(242, 214, 138, 0.15) 8%,
    var(--color-gold-dark) 25%,
    var(--color-gold-light) 50%,
    var(--color-gold-dark) 75%,
    rgba(242, 214, 138, 0.15) 92%,
    transparent 100%
  );
}

.card-ornament-bottom {
  bottom: 0;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(242, 214, 138, 0.15) 8%,
    var(--color-gold-dark) 25%,
    var(--color-gold-light) 50%,
    var(--color-gold-dark) 75%,
    rgba(242, 214, 138, 0.15) 92%,
    transparent 100%
  );
}

/* ---- Card Number ---- */

.card-number {
  position: absolute;
  top: 20rpx;
  left: 24rpx;
  z-index: 10;

  font-size: var(--font-size-xs);
  font-weight: 500;
  font-family: 'Georgia', 'Times New Roman', serif;
  letter-spacing: 2rpx;

  color: var(--color-text-primary);
  text-shadow:
    0 0 6rpx rgba(212, 168, 83, 0.50),
    0 0 12rpx rgba(212, 168, 83, 0.20),
    0 1rpx 2rpx rgba(0, 0, 0, 0.50);
  pointer-events: none;
}

/* ---- Card Art Area ---- */

.card-art {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 2;
  pointer-events: none;
}

/* ---- Star Field (fallback when no CDN image) ---- */

.star-field {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: radial-gradient(
    ellipse at 50% 40%,
    rgba(50, 30, 100, 0.35) 0%,
    transparent 70%
  );
}

.star {
  position: absolute;
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: var(--color-text-primary);
  animation: twinkle var(--dur, 3s) ease-in-out infinite alternate;
  box-shadow: 0 0 6rpx 2rpx rgba(242, 230, 201, 0.30);
}

.s1 { top: 10%; left: 18%; --dur: 2.4s; }
.s2 { top: 6%;  left: 62%; --dur: 3.8s; width: 3rpx; height: 3rpx; opacity: 0.7; }
.s3 { top: 22%; left: 38%; --dur: 2.0s; width: 5rpx; height: 5rpx; }
.s4 { top: 42%; left: 72%; --dur: 4.2s; width: 3rpx; height: 3rpx; opacity: 0.6; }
.s5 { top: 18%; left: 78%; --dur: 2.8s; }
.s6 { top: 36%; left: 14%; --dur: 3.4s; width: 3rpx; height: 3rpx; opacity: 0.5; }
.s7 { top: 52%; left: 48%; --dur: 2.2s; width: 5rpx; height: 5rpx; opacity: 0.8; }
.s8 { top: 64%; left: 28%; --dur: 4.0s; width: 3rpx; height: 3rpx; }

@keyframes twinkle {
  0%   { opacity: 0.25; transform: scale(0.6); }
  100% { opacity: 1;    transform: scale(1.1); }
}

/* ---- Fallback Symbol (when no CDN image) ---- */

.card-symbol {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-sm);
}

.art-shape {
  width: 120rpx;
  height: 170rpx;
  border: 1.5rpx solid rgba(212, 168, 83, 0.30);
  border-radius: 12rpx;
  background: radial-gradient(
    ellipse at 50% 35%,
    rgba(60, 35, 130, 0.40) 0%,
    rgba(26, 16, 53, 0.60) 100%
  );
  box-shadow:
    inset 0 0 30rpx rgba(212, 168, 83, 0.10),
    0 0 20rpx rgba(212, 168, 83, 0.06);
}

.art-accent {
  position: absolute;
  top: 38%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  background: radial-gradient(
    circle,
    rgba(242, 230, 201, 0.12) 0%,
    transparent 70%
  );
  box-shadow: 0 0 30rpx 15rpx rgba(212, 168, 83, 0.05);
}

.art-detail {
  position: absolute;
  bottom: 30%;
  left: 50%;
  transform: translateX(-50%);
  width: 50rpx;
  height: 1.5rpx;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(212, 168, 83, 0.25),
    transparent
  );
}

/* Image load failure fallback — card name inside the art area */
.fallback-name {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 5;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-medium);
  color: var(--color-lavender-light);
  text-align: center;
  letter-spacing: 3rpx;
  padding: var(--spacing-sm) var(--spacing-md);
  background: rgba(26, 16, 53, 0.70);
  border: 1rpx solid rgba(212, 168, 83, 0.20);
  border-radius: var(--radius-sm);
  max-width: 80%;
  line-height: 1.5;
  text-shadow: 0 0 8rpx rgba(212, 168, 83, 0.30);
}

/* ---- Card Name (English) ---- */

.card-name-en {
  position: absolute;
  bottom: 64rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 10;

  font-size: var(--font-size-caption);
  font-weight: 600;
  font-family: 'Georgia', 'Times New Roman', serif;
  letter-spacing: 3rpx;
  text-transform: uppercase;
  white-space: nowrap;
  max-width: 80%;
  overflow: hidden;
  text-overflow: ellipsis;

  color: var(--color-text-primary);
  text-shadow:
    0 0 8rpx rgba(212, 168, 83, 0.50),
    0 0 16rpx rgba(212, 168, 83, 0.20),
    0 2rpx 4rpx rgba(0, 0, 0, 0.50);
  pointer-events: none;
}

/* ---- Card Name (Chinese) ---- */

.card-name-zh {
  position: absolute;
  bottom: 32rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 10;

  font-size: var(--font-size-xs);
  font-weight: 400;
  letter-spacing: 4rpx;
  white-space: nowrap;
  max-width: 80%;
  overflow: hidden;
  text-overflow: ellipsis;

  color: var(--color-gold-light);
  text-shadow:
    0 0 6rpx rgba(212, 168, 83, 0.30),
    0 1rpx 3rpx rgba(0, 0, 0, 0.40);
  pointer-events: none;
}

/* ---- Position Badge ---- */

.position-badge {
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 10;

  display: flex;
  align-items: center;
  gap: 6rpx;

  padding: 4rpx var(--spacing-sm);
  border-radius: 20rpx;

  font-size: var(--font-size-xs);
  line-height: 1.4;
  white-space: nowrap;
  pointer-events: none;
}

.badge-upright {
  background: rgba(212, 168, 83, 0.12);
  border: 0.5rpx solid rgba(212, 168, 83, 0.25);
  color: var(--color-gold-light);
}

.badge-reversed {
  background: rgba(225, 150, 140, 0.12);
  border: 0.5rpx solid rgba(225, 150, 140, 0.25);
  color: var(--color-error);
}

.position-icon {
  font-size: var(--font-size-xs);
}

.position-text {
  font-size: var(--font-size-xs);
  letter-spacing: 1rpx;
}

/* ---- Reversed Label (vertical text on right side) ---- */

.reversed-label {
  position: absolute;
  bottom: 104rpx;
  right: 16rpx;
  z-index: 10;

  font-size: var(--font-size-xs);
  font-weight: 300;
  letter-spacing: 4rpx;
  writing-mode: vertical-rl;

  color: rgba(225, 150, 140, 0.40);
  text-shadow: 0 0 8rpx rgba(225, 150, 140, 0.20);
  pointer-events: none;
}

/* ---- Dark Aura (deep backing glow) ---- */

.card-aura {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;

  background: radial-gradient(
    ellipse at 50% 50%,
    rgba(20, 8, 50, 0.30) 0%,
    transparent 75%
  );
}

/* ============================================================
   SUIT INDICATORS — tiny colored dot at top-right corner
   Applied via .card-{{cardType}} class on .tarot-card
   ============================================================ */

.tarot-card.card-wands::before,
.tarot-card.card-cups::before,
.tarot-card.card-swords::before,
.tarot-card.card-pentacles::before {
  content: '';
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  z-index: 10;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  pointer-events: none;
  box-shadow: 0 0 8rpx 4rpx currentColor;
  opacity: 0.90;
}

/* Wands — warm gold sparkle */
.tarot-card.card-wands::before {
  color: rgba(212, 168, 83, 0.55);
  background: radial-gradient(
    circle at 35% 30%,
    var(--color-gold-light),
    var(--color-gold-dark) 55%,
    #8a6a30
  );
}

/* Cups — soft lavender sparkle */
.tarot-card.card-cups::before {
  color: rgba(180, 155, 220, 0.50);
  background: radial-gradient(
    circle at 35% 30%,
    var(--color-lavender-light),
    var(--color-lavender) 55%,
    var(--color-lavender-dark)
  );
}

/* Swords — icy silver sparkle */
.tarot-card.card-swords::before {
  color: rgba(200, 215, 235, 0.50);
  background: radial-gradient(
    circle at 35% 30%,
    #eaf0fa,
    #c0d0e4 55%,
    #8098b8
  );
}

/* Pentacles — warm amber sparkle */
.tarot-card.card-pentacles::before {
  color: rgba(220, 175, 85, 0.50);
  background: radial-gradient(
    circle at 35% 30%,
    var(--color-gold-light),
    var(--color-gold-dark) 55%,
    #a07830
  );
}

/* Major Arcana — tiny golden diamond instead of dot */
.tarot-card.card-major::before {
  content: '';
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  z-index: 10;
  width: 10rpx;
  height: 10rpx;
  border-radius: 2rpx;
  transform: rotate(45deg);
  pointer-events: none;
  color: rgba(212, 168, 83, 0.50);
  background: radial-gradient(
    circle at 35% 30%,
    var(--color-gold-light),
    var(--color-gold-dark) 55%,
    #8a6a30
  );
  box-shadow: 0 0 8rpx 4rpx currentColor;
  opacity: 0.90;
}

/* ---- Reversed: keep suit dot at visual top-right ---- */
.tarot-card-wrapper.reversed .tarot-card.card-wands::before,
.tarot-card-wrapper.reversed .tarot-card.card-cups::before,
.tarot-card-wrapper.reversed .tarot-card.card-swords::before,
.tarot-card-wrapper.reversed .tarot-card.card-pentacles::before,
.tarot-card-wrapper.reversed .tarot-card.card-major::before {
  transform: rotate(180deg);
}

/* ---- Reversed Major: compensate for diamond rotation ---- */
.tarot-card-wrapper.reversed .tarot-card.card-major::before {
  transform: rotate(180deg) rotate(45deg);
}

/* ============================================================
   RESPONSIVE SIZING
   ============================================================ */

@media screen and (max-width: 480rpx) {
  .tarot-card {
    width: 300rpx;
    height: 490rpx;
    border-radius: var(--radius-md);
  }

  .card-number {
    font-size: var(--font-size-xs);
    top: 16rpx;
    left: 18rpx;
  }

  .card-name-en {
    font-size: var(--font-size-xs);
    bottom: 52rpx;
    letter-spacing: 2rpx;
  }

  .card-name-zh {
    font-size: var(--font-size-xs);
    bottom: 26rpx;
    letter-spacing: 3rpx;
  }

  .position-badge {
    font-size: var(--font-size-xs);
    padding: 3rpx var(--spacing-xs);
    bottom: 8rpx;
  }

  .position-icon { font-size: var(--font-size-xs); }
  .position-text { font-size: var(--font-size-xs); }

  .reversed-label {
    font-size: var(--font-size-xs);
    bottom: 86rpx;
    right: 12rpx;
  }

  .tarot-card.card-wands::before,
  .tarot-card.card-cups::before,
  .tarot-card.card-swords::before,
  .tarot-card.card-pentacles::before {
    width: 10rpx;
    height: 10rpx;
    top: 12rpx;
    right: 12rpx;
  }

  .tarot-card.card-major::before {
    width: 8rpx;
    height: 8rpx;
    top: 12rpx;
    right: 12rpx;
  }
}

@media screen and (min-width: 750rpx) {
  .tarot-card {
    width: 420rpx;
    height: 640rpx;
    border-radius: 18rpx;
  }

  .card-name-en {
    font-size: var(--font-size-body);
    letter-spacing: 4rpx;
  }
}

/* ============================================================
   ACCESSIBILITY: reduced motion
   ============================================================ */

@media (prefers-reduced-motion: reduce) {
  .star {
    animation: none;
    opacity: 0.6;
  }

  .tarot-card {
    animation: none;
    opacity: 1;
    transform: none;
  }

  .tarot-card::after {
    animation: none;
    transform: none;
    display: none;
  }

  .tarot-card.card-wands::before,
  .tarot-card.card-cups::before,
  .tarot-card.card-swords::before,
  .tarot-card.card-pentacles::before,
  .tarot-card.card-major::before {
    animation: none;
  }

  .tarot-card-wrapper.flipping .tarot-card {
    animation: none;
  }

  .tarot-card-wrapper.reversed .tarot-card {
    animation: none;
  }
}
