<view class="tarot-card-wrapper {{isReversed ? 'reversed' : ''}} {{flipping ? 'flipping' : ''}}">
  <view class="tarot-card {{isReversed ? 'card-reversed' : ''}} card-{{cardType}} {{isMajor ? 'card-major' : ''}}">
    <!-- 卡牌图像 (ComfyUI生成的PNG) -->
    <image wx:if="{{imagePath}}" class="card-image" src="{{imagePath}}" mode="aspectFill" lazy-load></image>

    <!-- 顶部金色装饰条 -->
    <view class="card-ornament-top"></view>

    <!-- 卡牌编号 -->
    <text class="card-number">{{cardNumberDisplay}}</text>

    <!-- 卡面主区域 -->
    <view class="card-art">
      <!-- 星空微光背景 (无真实图像时显示) -->
      <view wx:if="{{!imagePath}}" class="star-field">
        <view class="star s1"></view><view class="star s2"></view>
        <view class="star s3"></view><view class="star s4"></view>
        <view class="star s5"></view><view class="star s6"></view>
        <view class="star s7"></view><view class="star s8"></view>
      </view>

      <!-- 卡牌插画核心区：纯CSS艺术 (无真实图像时显示) -->
      <view wx:if="{{!imagePath}}" class="card-symbol">
        <view class="art-shape"></view>
        <view class="art-accent"></view>
        <view class="art-detail"></view>
      </view>
    </view>

    <!-- 卡牌名称 -->
    <text class="card-name-en">{{displayNameEn}}</text>
    <text class="card-name-zh">{{nameZh}}</text>

    <!-- 位置徽章 -->
    <view class="position-badge {{isReversed ? 'badge-reversed' : 'badge-upright'}}">
      <text class="position-icon">{{isReversed ? '▼' : '▲'}}</text>
      <text class="position-text">{{positionName}}</text>
    </view>

    <!-- 逆位标签 -->
    <block wx:if="{{isReversed}}">
      <view class="reversed-label">逆位</view>
    </block>

    <!-- 底部装饰条 -->
    <view class="card-ornament-bottom"></view>

    <!-- 暗光晕托底 -->
    <view class="card-aura"></view>
  </view>
</view>
