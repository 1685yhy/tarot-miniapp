/* ================================================================
   Action Cards — Actionable suggestions after a tarot reading
   Design tokens from common.wxss only. No hardcoded colors.
   ================================================================ */

/* ===== Container ===== */
.ac-container {
  margin: var(--spacing-lg) 0;
  padding: var(--spacing-md) var(--spacing-md) var(--spacing-lg);
  background: var(--color-surface);
  border-radius: var(--radius-md);
  border-left: 4rpx solid var(--color-gold);
  position: relative;
  overflow: hidden;
}

/* Subtle glow at top-left corner */
.ac-container::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(
    circle at top left,
    rgba(244, 212, 140, 0.06) 0%,
    transparent 70%
  );
  pointer-events: none;
}

/* ===== Header ===== */
.ac-header {
  display: flex;
  align-items: center;
  margin-bottom: var(--spacing-md);
  gap: var(--spacing-xxs);
}

.ac-header-icon {
  width: 28rpx;
  height: 28rpx;
  display: block;
  opacity: 0.8;
}

.ac-header-title {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-semibold);
  color: var(--color-gold);
  letter-spacing: 3rpx;
}

/* ===== Action Item List ===== */
.ac-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-xs);
}

/* ---- Individual Item ---- */
.ac-item {
  display: flex;
  align-items: flex-start;
  padding: var(--spacing-sm) var(--spacing-xs);
  border-radius: var(--radius-sm);
  transition: opacity var(--duration-fast) var(--ease-out),
              background var(--duration-fast) var(--ease-out);
  cursor: pointer;
  gap: var(--spacing-xs);
}

.ac-item:active {
  background: var(--color-card-hover);
}

/* ---- Checked State ---- */
.ac-item--checked {
  opacity: 0.5;
}

.ac-item--checked .ac-item-text {
  text-decoration: line-through;
}

/* ---- Checkbox ---- */
.ac-checkbox {
  width: 32rpx;
  height: 32rpx;
  min-width: 32rpx;
  border-radius: var(--radius-sm);
  border: 2rpx solid rgba(244, 212, 140, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 2rpx;
  transition: border-color var(--duration-fast) var(--ease-out),
              background var(--duration-fast) var(--ease-out);
  box-sizing: border-box;
}

.ac-checkbox:active {
  border-color: var(--color-gold);
}

.ac-checkbox--checked {
  background: var(--color-success);
  border-color: var(--color-success);
  animation: ac-check-pop 0.3s ease-out;
}

@keyframes ac-check-pop {
  0% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.25);
  }
  100% {
    transform: scale(1);
  }
}

.ac-checkbox-inner {
  display: flex;
  align-items: center;
  justify-content: center;
}

.ac-checkmark {
  font-size: 20rpx;
  color: #1A1A3E;
  font-weight: var(--font-weight-bold);
  line-height: 1;
}

/* ---- Category Icon ---- */
.ac-category-icon {
  width: 32rpx;
  flex-shrink: 0;
  text-align: center;
  opacity: 0.7;
  margin-top: 2rpx;
  line-height: 1;
}

.ac-category-icon-img {
  width: 24rpx;
  height: 24rpx;
  display: block;
}

.ac-item--checked .ac-category-icon {
  color: var(--color-success);
  opacity: 0.7;
}

/* ---- Item Text ---- */
.ac-item-text {
  font-size: var(--font-size-caption);
  color: var(--color-text-primary);
  line-height: 1.6;
  letter-spacing: 1rpx;
  flex: 1;
  word-break: break-word;
}

/* ===== Progress ===== */
.ac-progress-wrap {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  margin-top: var(--spacing-md);
  padding-top: var(--spacing-sm);
  border-top: 1rpx solid rgba(244, 212, 140, 0.08);
}

.ac-progress-bar {
  flex: 1;
  height: 4rpx;
  background: rgba(244, 212, 140, 0.12);
  border-radius: var(--radius-pill);
  overflow: hidden;
}

.ac-progress-fill {
  height: 100%;
  background: linear-gradient(
    to right,
    var(--color-gold-dark) 0%,
    var(--color-gold) 50%,
    var(--color-gold-light) 100%
  );
  border-radius: var(--radius-pill);
  transition: width var(--duration-slow) var(--ease-out);
  box-shadow: 0 0 8rpx rgba(244, 212, 140, 0.2);
}

.ac-progress-text {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  letter-spacing: 1rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

/* ===== Celebration ===== */
.ac-celebration {
  margin-top: var(--spacing-md);
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow: hidden;
  max-height: 0;
  opacity: 0;
  transition: max-height var(--duration-slow) var(--ease-out),
              opacity var(--duration-slow) var(--ease-out),
              margin-top var(--duration-slow) var(--ease-out);
}

.ac-celebration--visible {
  max-height: 200rpx;
  opacity: 1;
  margin-top: var(--spacing-md);
}

/* ---- Stars Row ---- */
.ac-stars-row {
  display: flex;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-sm);
}

.ac-star {
  font-size: 48rpx;
  color: var(--color-gold);
  text-shadow: 0 0 16rpx rgba(244, 212, 140, 0.4);
  opacity: 0;
  transform: scale(0.05);
}

/* Staggered star entrance animation */
.ac-star--1 {
  animation: ac-star-enter 0.5s ease-out 0s forwards;
}

.ac-star--2 {
  animation: ac-star-enter 0.5s ease-out 0.2s forwards;
}

.ac-star--3 {
  animation: ac-star-enter 0.5s ease-out 0.4s forwards;
}

@keyframes ac-star-enter {
  0% {
    opacity: 0;
    transform: scale(0.05);
  }
  60% {
    opacity: 1;
    transform: scale(1.2);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}

/* ---- Celebration Text ---- */
.ac-celebration-text {
  font-size: var(--font-size-caption);
  color: var(--color-gold);
  letter-spacing: 2rpx;
  font-weight: var(--font-weight-medium);
  opacity: 0;
  animation: ac-celebration-fade-in 0.4s ease-out 0.4s forwards;
}

@keyframes ac-celebration-fade-in {
  0% {
    opacity: 0;
    transform: translateY(8rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ================================================================
   Skeleton Loading
   ================================================================ */
.ac-item--skeleton {
  cursor: default;
  pointer-events: none;
}

.ac-skeleton-title {
  height: 28rpx;
  width: 160rpx;
  margin-bottom: 0;
}

.ac-check-skeleton {
  width: 32rpx;
  height: 32rpx;
  min-width: 32rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
  margin-top: 2rpx;
}

.ac-text-skeleton {
  height: 28rpx;
  flex: 1;
  margin-bottom: 0;
}

.ac-progress-skeleton {
  height: 4rpx;
  width: 100%;
  margin-top: var(--spacing-md);
  margin-bottom: 0;
  border-radius: var(--radius-pill);
}
