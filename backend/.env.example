# =============================================================================
# 塔罗占卜小程序 —— 后端环境变量配置示例
# =============================================================================
# 使用方式：复制本文件为 .env，填入真实值后再启动服务。
#
#   cp .env.example .env
#
# 注意：.env 包含敏感信息，不要提交到版本控制中！
# =============================================================================


# ================================ 数据库 ======================================

# 生产数据库推荐 MySQL
#   格式: mysql+asyncmy://用户名:密码@主机:端口/库名
#   开发时可使用 SQLite: sqlite+aiosqlite:///./tarot_dev.db
DATABASE_URL=mysql+asyncmy://tarot:tarot123@mysql:3306/tarot_db

# Redis 缓存地址（用于会话、限流等）
REDIS_URL=redis://redis:6379/0


# ============================== DeepSeek AI ===================================

# ★ 必须配置 ★ 从 https://platform.deepseek.com 获取
#   格式：sk- 开头的一串字符
DEEPSEEK_API_KEY=sk-your-key-here

# 模型名称
DEEPSEEK_MODEL=deepseek-v4-pro

# API 端点（一般无需修改）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1


# ================================ 微信登录 ====================================

# ★ 必须配置 ★ 小程序的 AppID（微信公众平台 -> 开发 -> 开发设置）
WECHAT_APP_ID=wx_your_appid

# ★ 必须配置 ★ 小程序 AppSecret（与 AppID 配对）
WECHAT_APP_SECRET=your_secret_here


# ================================ 微信支付 ====================================

# ★ 支付必须配置 ★ 微信支付商户号
WECHAT_MCH_ID=your_mch_id

# ★ 支付必须配置 ★ APIv3 密钥（32 字节，在商户平台设置）
WECHAT_API_KEY_V3=your_api_v3_key

# ★ 支付必须配置 ★ 商户证书序列号（微信支付商户平台 -> 账户中心 -> API安全）
WECHAT_MCH_CERT_SERIAL=your_cert_serial

# ★ 支付必须配置 ★ 平台证书序列号（用于验证支付回调签名）
WECHAT_PLATFORM_CERT_SERIAL=your_platform_cert_serial

# 商户私钥文件路径（PEM格式）
WECHAT_PRIVATE_KEY_PATH=/opt/tarot/backend/certs/apiclient_key.pem

# 平台证书内容（PEM格式，用于回调签名验证）
WECHAT_PLATFORM_CERT=

# ================================ 订阅消息推送 =================================
# 真实模板 ID（在微信公众平台申请通过后填写）。留空 = 推送服务未开通
# （/notify/subscribe 返回 400，send_subscribe_message 仅记错误日志）。
WX_TEMPLATE_DAILY_CARD=
WX_TEMPLATE_MEMBER_EXPIRE=
WX_TEMPLATE_ANNUAL_REPORT=


# ================================ 认证安全 ====================================

# ★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★
# ★ 上线前必须修改 — 这是整个应用最关键的安全配置              ★
# ★                                                            ★
# ★  JWT_SECRET 用于签发和验证用户登录 token。如果使用默认值     ★
# ★  或弱密钥，任何人都可以伪造任意用户的 token，窃取数据。      ★
# ★                                                            ★
# ★  要求：至少 32 位随机字符，不要用 "change-me-in-production"！ ★
# ★  生成方法（任选其一）：                                      ★
# ★    $ openssl rand -base64 32                                ★
# ★    $ python3 -c "import secrets; print(secrets.token_hex(32))"★
# ★                                                            ★
# ★  重要：config.py 中 JWT_SECRET 已改为"必须配置"，无默认值；    ★
# ★  如果缺少该配置项，应用将在启动时直接报错。                   ★
# ★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★
JWT_SECRET=generate-a-strong-random-secret-here

# JWT 签名算法（一般无需修改）
JWT_ALGORITHM=HS256

# JWT 过期时间（单位：分钟，默认 30 天 = 43200 分钟）
JWT_EXPIRE_MINUTES=43200


# ================================ 业务限制 ====================================

# 免费用户每日占卜次数
FREE_DAILY_READINGS=3

# 免费用户每日 AI 对话消息条数
FREE_CHAT_MESSAGES=3

# 开发登录开关 — 生产环境必须设为 false（后端返回 404，伪装成路由不存在）
ENABLE_DEV_LOGIN=false

# Sentry DSN（可选，留空则不启用 Sentry 错误追踪）
SENTRY_DSN=


# =============================================================================
# 重要提醒
# =============================================================================
# 1. 正式上线前请逐一核对上方所有标 ★ 的配置
# 2. 不要将含真实密钥的 .env 文件提交至 Git
# 3. 生产环境建议通过系统环境变量注入，而非 .env 文件
# 4. 线上发现安全漏洞或异常时立即轮换密钥
# =============================================================================
