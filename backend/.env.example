# =============================================================================
# 塔罗占卜小程序 —— 后端环境变量配置示例
# =============================================================================
# 使用方式：复制本文件为 .env，填入真实值后再启动服务。
#
#   cp .env.example .env
#
# 注意：.env 包含敏感信息，不要提交到版本控制中！
# =============================================================================


# ================================ 数据库 ======================================

# 生产数据库推荐 MySQL
#   格式: mysql+asyncmy://用户名:密码@主机:端口/库名
#   开发时可使用 SQLite: sqlite+aiosqlite:///./tarot_dev.db
DATABASE_URL=mysql+asyncmy://tarot:tarot123@mysql:3306/tarot_db

# Redis 缓存地址（用于会话、限流等）
REDIS_URL=redis://redis:6379/0


# ============================== DeepSeek AI ===================================

# ★ 必须配置 ★ 从 https://platform.deepseek.com 获取
#   格式：sk- 开头的一串字符
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# 模型名称（默认 deepseek-chat，也可用 deepseek-reasoner）
DEEPSEEK_MODEL=deepseek-chat

# API 端点（一般无需修改）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1


# ================================ 微信支付 ====================================

# ★ 必须配置 ★ 小程序的 AppID（微信公众平台 -> 开发 -> 开发设置）
WECHAT_APP_ID=your-wechat-app-id

# ★ 必须配置 ★ 小程序 AppSecret（与 AppID 配对）
WECHAT_APP_SECRET=your-wechat-app-secret

# ★ 支付必须配置 ★ 微信支付商户号（微信支付商户平台）
WECHAT_MCH_ID=your-wechat-mch-id

# ★ 支付必须配置 ★ APIv3 密钥（32 字节，在商户平台设置）
WECHAT_API_KEY_V3=your-wechat-api-key-v3


# ================================ 认证安全 ====================================

# ★ 上线前必须修改 ★ JWT 签名密钥
#   要求：至少 32 位随机字符，不要用 "change-me-in-production"！
#   生成方法：终端执行  openssl rand -hex 32
JWT_SECRET=change-me-in-production

# JWT 签名算法（一般无需修改）
JWT_ALGORITHM=HS256

# JWT 过期时间（单位：分钟，默认 30 天 = 43200 分钟）
JWT_EXPIRE_MINUTES=43200


# ================================ 业务限制 ====================================

# 免费用户每日占卜次数
FREE_DAILY_READINGS=1

# 免费用户每日 AI 对话消息条数
FREE_CHAT_MESSAGES=3


# =============================================================================
# 重要提醒
# =============================================================================
# 1. 正式上线前请逐一核对上方所有标 ★ 的配置
# 2. 不要将含真实密钥的 .env 文件提交至 Git
# 3. 生产环境建议通过环境变量注入，而非 .env 文件
# 4. 如使用第三方平台（微信开放平台），extConfig 中的 BASE_URL 会覆盖 api.js 中的配置
# =============================================================================
